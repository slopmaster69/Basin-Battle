@@ -402,6 +497,69 @@ mod tests {
     use benilla_assets::BillboardInfo;
     use benilla_formats::{BillboardKind, ModelBlend};
 
+    /// A camera walking outdoors walks the parts a slice a frame, in turn; the first still frame
+    /// after catches every part up, and the frames after skip.
+    #[test]
+    fn a_walking_camera_walks_the_parts_a_slice_a_frame() {
+        let mut s = VisSlices::default();
+        let at = |x: f32| Some(Vec3::new(x, 0.0, 0.0));
+        // Nothing moved, nothing pending.
+        assert_eq!(s.pick(true, false, true, at(0.0), true), Walk::Still);
+        // The first move has no anchor: a whole walk, which sets one.
+        assert_eq!(s.pick(false, true, true, at(0.0), true), Walk::Whole);
+        let walks: Vec<Walk> = (1..=5)
+            .map(|i| s.pick(false, true, true, at(i as f32 * 0.1), true))
+            .collect();
+        assert_eq!(
+            walks,
+            [
+                Walk::Slice(0),
+                Walk::Slice(1),
+                Walk::Slice(2),
+                Walk::Slice(3),
+                Walk::Slice(0)
+            ]
+        );
+        // The camera stops: one whole walk, then nothing.
+        assert_eq!(s.pick(true, false, true, at(0.5), true), Walk::Whole);
+        assert_eq!(s.pick(true, false, true, at(0.5), true), Walk::Still);
+    }
+
+    /// A camera past the reach from the last whole walk, indoors, or with something else moving
+    /// walks every part; so does every frame under `WOW_VIS_EVERY_FRAME`.
+    #[test]
+    fn a_far_step_a_room_or_another_change_walks_every_part() {
+        let at = |x: f32| Some(Vec3::new(x, 0.0, 0.0));
+        let anchored = || {
+            let mut s = VisSlices::default();
+            assert_eq!(s.pick(false, true, true, at(0.0), true), Walk::Whole);
+            s
+        };
+        let mut s = anchored();
+        assert_eq!(
+            s.pick(false, true, true, at(SLICE_REACH + 0.5), true),
+            Walk::Whole
+        );
+        // The new anchor is where that walk stood.
+        assert_eq!(
+            s.pick(false, true, true, at(SLICE_REACH + 1.0), true),
+            Walk::Slice(0)
+        );
+        assert_eq!(
+            anchored().pick(false, true, false, at(0.1), true),
+            Walk::Whole
+        );
+        assert_eq!(
+            anchored().pick(false, false, true, at(0.1), true),
+            Walk::Whole
+        );
+        assert_eq!(
+            anchored().pick(false, true, true, at(0.1), false),
+            Walk::Whole
+        );
+        assert_eq!(anchored().pick(false, true, true, None, true), Walk::Whole);
+    }
+
     #[test]
     fn a_card_follows_its_owners_verdict() {
