 1 file changed, 161 insertions(+), 3 deletions(-)

diff --git a/crates/benilla-world/src/model_render/visibility.rs b/crates/benilla-world/src/model_render/visibility.rs
index 594a15a6..8cd82262 100644
--- a/crates/benilla-world/src/model_render/visibility.rs
+++ b/crates/benilla-world/src/model_render/visibility.rs
@@ -14,6 +14,80 @@ use crate::view::WorldCamera;
 use crate::wmo_portal::{WmoGroupVis, WmoPortalInstance};
 use benilla_assets::materials::WowModelMaterial;
 
+/// While only the camera moves, outdoors, a part whose own row is still is walked one frame in
+/// [`SLICES`], in turn by its entity index: its verdicts (the far wall, the distance fade) move
+/// with the camera by a fraction of a yard a frame, so a part a few frames late reads the same,
+/// and the walk costs a [`SLICES`]th. Anything else that moves (a part, a portal, a setting, the
+/// camera's room) walks every part that frame, as does a camera [`SLICE_REACH`] yards from where
+/// the last whole walk stood (a teleport, a gallop's every half second), and the first still frame
+/// after a sliced one, so no part keeps a late verdict once the camera stops. Indoors the window
+/// gate turns with the camera, so every part is walked every frame. `WOW_VIS_EVERY_FRAME=1` walks
+/// every part every frame, as before.
+pub const SLICES: u32 = 4;
+
+/// How far the camera may move (yd) between two whole walks.
+pub const SLICE_REACH: f32 = 4.0;
+
+/// Where the last whole walk stood, which slice walks next, and whether a slice walked since.
+#[derive(Default)]
+pub(super) struct VisSlices {
+    anchor: Option<Vec3>,
+    phase: u32,
+    pending: bool,
+}
+
+/// Which parts this frame walks, besides any whose own row moved.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Walk {
+    /// None: nothing but a part's own row moved.
+    Still,
+    /// Those whose entity index is this modulo [`SLICES`].
+    Slice(u32),
+    /// Every part.
+    Whole,
+}
+
+/// `WOW_VIS_EVERY_FRAME=1`: no slicing.
+fn slicing_disabled() -> bool {
+    static OFF: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *OFF.get_or_init(|| {
+        std::env::var("WOW_VIS_EVERY_FRAME").is_ok_and(|v| !v.is_empty() && v != "0")
+    })
+}
+
+impl VisSlices {
+    /// This frame's walk: `still` is a frame where nothing moved, `camera_only` one whose one
+    /// moving input is the camera, `outdoors` one whose exterior gate is open and whose camera
+    /// claims no room, `cam` the camera's position; `enabled` is false under
+    /// `WOW_VIS_EVERY_FRAME`.
+    fn pick(
+        &mut self,
+        still: bool,
+        camera_only: bool,
+        outdoors: bool,
+        cam: Option<Vec3>,
+        enabled: bool,
+    ) -> Walk {
+        if still && !self.pending {
+            return Walk::Still;
+        }
+        let near_anchor = match (self.anchor, cam) {
+            (Some(a), Some(c)) => a.distance(c) <= SLICE_REACH,
+            _ => false,
+        };
+        if !still && camera_only && outdoors && near_anchor && enabled {
+            let phase = self.phase;
+            self.phase = (self.phase + 1) % SLICES;
+            self.pending = true;
+            Walk::Slice(phase)
+        } else {
+            self.anchor = cam;
+            self.pending = false;
+            Walk::Whole
+        }
+    }
+}
+
 /// Shows or hides each model submesh. A doodad or WMO part is culled once its bound lies wholly
