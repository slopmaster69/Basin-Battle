+fn shafts(uv: vec2<f32>, dims: vec2<f32>) -> f32 {
+    let delta = (look.sun.xy - uv) * (RAY_REACH / f32(RAY_SAMPLES));
+    let top = vec2<i32>(dims) - vec2<i32>(1);
+    var coord = uv;
+    var illum = 1.0;
+    var sum = 0.0;
+    for (var i = 0; i < RAY_SAMPLES; i++) {
+        coord += delta;
+        if any(coord < vec2<f32>(0.0)) || any(coord > vec2<f32>(1.0)) {
