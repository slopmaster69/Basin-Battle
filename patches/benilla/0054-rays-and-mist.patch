+/// The rays and the mist read the depth buffer, which Bevy allocates for rendering only: under the
+/// new look the look camera's is made sampleable too, and under the classic look it goes back.
+fn sync_depth_binding(look: Res<WorldLook>, mut cams: Query<&mut Camera3d, With<LookView>>) {
+    for mut cam in &mut cams {
+        let usages = TextureUsages::from(cam.depth_texture_usages);
+        let want = if look.on {
+            usages | TextureUsages::TEXTURE_BINDING
+        } else {
+            usages - TextureUsages::TEXTURE_BINDING
+        };
+        if want != usages {
+            cam.depth_texture_usages = want.into();
+        }
+    }
+}
