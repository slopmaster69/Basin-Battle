diff --git a/crates/benilla-world/src/look/mist.rs b/crates/benilla-world/src/look/mist.rs
new file mode 100644
index 0000000..4ed3eb1
--- /dev/null
+++ b/crates/benilla-world/src/look/mist.rs
@@ -0,0 +1,622 @@
+//! How thick the new look's mist is today, benilla's own (no reference behaviour): a multiple of
+//! the hour's own mist (the grade's `height_fog`) that changes with the day, the weather and the
+//! game's events, the same for every hero in the world.
+//!
+//! - Each game day rolls a strength from 0 to [`DAY_MAX`] times the hour's, and about one day in
+//!   [`FOG_DAY_ONE_IN`] is a fog day, [`FOG_DAY_MIN`] to [`FOG_DAY_MAX`] times. The roll is a fixed
+//!   hash of the server's day number ([`server_day`]), never a local random, so every client rolls
+//!   the same day, and it turns over at midnight, when the night's own mist is thin anyway. The
+//!   film clock (`worldclock`) moves the light only, not the day.
+//! - The server's weather lifts it: a full overcast to [`OVERCAST_SCALE`], heavy rain on top of it
+//!   to [`OVERCAST_SCALE`] + [`RAIN_SCALE`]. The day and the weather take the higher of the two.
+//! - An event (the add-on's `SetWorldMist`, called for by the server) wins over both, eased in and
+//!   out over its own time ([`WorldMist`]).
+//! - A held tune (`lookmist <scale>`, for film) wins over everything, at once.
+//!
+//! A change of the day or the weather eases in over about [`MIST_EASE_SECS`] of real time (two
+//! chained exponential follows, so it starts and lands gently and never pops).
+
+use bevy::prelude::*;
+
+use super::LookMistTune;
+use crate::lighting::WorldTime;
+use crate::weather::{WeatherKind, WeatherState};
+
+/// The most an ordinary day's roll gives, times the hour's mist.
+pub const DAY_MAX: f32 = 2.0;
+/// About one day in this many is a fog day.
+pub const FOG_DAY_ONE_IN: u32 = 7;
+/// A fog day's strength, from this...
+pub const FOG_DAY_MIN: f32 = 3.0;
+/// ...to this.
+pub const FOG_DAY_MAX: f32 = 4.0;
+/// A full overcast (`WeatherState::sky_density` at its 0.25 top) lifts the mist to this.
+pub const OVERCAST_SCALE: f32 = 3.0;
+/// Rain at its full density adds this over the overcast's.
+pub const RAIN_SCALE: f32 = 1.0;
+/// About how long a new strength takes to ease in, seconds of real time (to within 5%).
+pub const MIST_EASE_SECS: f32 = 20.0;
+/// The two follows' time constant: a two-pole follow is within 4% of a step after five of them.
+const EASE_TAU: f32 = MIST_EASE_SECS / 5.0;
+/// The thickest any call or tune can ask for (the film's `lookmist` range).
+pub const SCALE_MAX: f32 = 6.0;
+
+/// The server's game day: its clock's date as a calendar day number ([`WorldTime::date`]), the
+/// same on every client and untouched by the film clock. Before a server clock lands it is day 0.
+pub fn server_day(time: &WorldTime) -> i64 {
+    time.date
+}
+
+/// One day's roll.
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub struct DayRoll {
+    /// Times the hour's mist.
+    pub scale: f32,
+    /// A fog day ([`FOG_DAY_MIN`] to [`FOG_DAY_MAX`]).
+    pub fog_day: bool,
+}
+
+/// SplitMix64's finaliser: a fixed, well-mixed hash, the same on every machine.
+fn mix(x: u64) -> u64 {
+    let mut z = x.wrapping_add(0x9E37_79B9_7F4A_7C15);
+    z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
+    z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
+    z ^ (z >> 31)
+}
+
+/// The top 24 bits of a hash as 0..1 (exact in an `f32`).
+fn unit(h: u64) -> f32 {
+    (h >> 40) as f32 / (1u64 << 24) as f32
+}
+
+/// Mixed into the day so the mist's dice are its own (a later per-day roll takes another).
+const DAY_SALT: u64 = 0x6D69_7374_6461_7973; // "mistdays"
+
+/// The day's roll: deterministic in `day` alone.
+pub fn day_roll(day: i64) -> DayRoll {
+    let h = mix(day as u64 ^ DAY_SALT);
+    let fog_day = unit(h) < 1.0 / FOG_DAY_ONE_IN as f32;
+    let u = unit(mix(h));
+    DayRoll {
+        scale: if fog_day {
+            FOG_DAY_MIN + (FOG_DAY_MAX - FOG_DAY_MIN) * u
+        } else {
+            DAY_MAX * u
+        },
+        fog_day,
+    }
+}
+
+/// What the weather lifts the mist to: the overcast's share of its full 0.25 times
+/// [`OVERCAST_SCALE`], plus rain's density times [`RAIN_SCALE`]. Snow and sand count only for
+/// their overcast.
+pub fn weather_scale(weather: &WeatherState) -> f32 {
+    let overcast = crate::weather::storm_blend(weather.sky_density);
+    let rain = if weather.effect_kind == WeatherKind::Rain {
+        weather.effect_density.clamp(0.0, 1.0)
+    } else {
+        0.0
+    };
+    OVERCAST_SCALE * overcast + RAIN_SCALE * rain
+}
+
+/// An event's mist asked for, or let go (the add-on's `SetWorldMist`, `ClearWorldMist`); `secs`
+/// is the ease, [`MIST_EASE_SECS`] when not given.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum MistEvent {
+    Set { scale: f32, secs: Option<f32> },
+    Clear { secs: Option<f32> },
+}
+
+/// An event's ease: from the strength shown when it was called to its own, or (a clear) back to
+/// the day's and the weather's as they are while it eases.
+#[derive(Clone, Copy, Debug, PartialEq)]
+struct EventEase {
+    from: f32,
+    /// `None` eases back out.
+    to: Option<f32>,
+    started: f64,
+    secs: f32,
+}
+
+impl EventEase {
+    fn t(&self, now: f64) -> f32 {
+        if self.secs <= 0.0 {
+            return 1.0;
+        }
+        let t = (((now - self.started) as f32) / self.secs).clamp(0.0, 1.0);
+        t * t * (3.0 - 2.0 * t)
+    }
+
+    fn value(&self, ambient: f32, now: f64) -> f32 {
+        let to = self.to.unwrap_or(ambient);
+        self.from + (to - self.from) * self.t(now)
+    }
+}
+
+/// The game's call for mist: the add-on's requests, and the event easing in or out.
+#[derive(Resource, Clone, Debug, Default, PartialEq)]
+pub struct WorldMist {
+    pending: Vec<MistEvent>,
+    ease: Option<EventEase>,
+}
+
+impl WorldMist {
+    /// Queue an event's call; the next resolve eases from the strength it is showing then.
+    pub fn request(&mut self, call: MistEvent) {
+        // Only the last few matter: each eases from where the one before left it.
+        if self.pending.len() >= 16 {
+            self.pending.remove(0);
+        }
+        self.pending.push(call);
+    }
+
+    /// Whether an event's mist is showing (easing in, held, or easing back out).
+    pub fn active(&self) -> bool {
+        self.ease.is_some()
+    }
+
+    /// Let go at once (leaving the world).
+    pub fn reset(&mut self) {
+        *self = Self::default();
+    }
+
+    fn apply_pending(&mut self, shown: f32, ambient: f32, now: f64) {
+        for call in std::mem::take(&mut self.pending) {
+            let from = self.ease.map_or(shown, |e| e.value(ambient, now));
+            match call {
+                MistEvent::Set { scale, secs } => {
+                    self.ease = Some(EventEase {
+                        from,
+                        to: Some(scale.clamp(0.0, SCALE_MAX)),
+                        started: now,
+                        secs: secs.unwrap_or(MIST_EASE_SECS).max(0.0),
+                    });
+                }
+                MistEvent::Clear { secs } => {
+                    if self.ease.is_some() {
+                        self.ease = Some(EventEase {
+                            from,
+                            to: None,
+                            started: now,
+                            secs: secs.unwrap_or(MIST_EASE_SECS).max(0.0),
+                        });
+                    }
+                }
+            }
+        }
+    }
+
+    /// The event's strength at `now`, `None` with none; a clear that has eased all the way out
+    /// ends here.
+    fn value(&mut self, ambient: f32, now: f64) -> Option<f32> {
+        let e = self.ease?;
+        if e.to.is_none() && e.t(now) >= 1.0 {
+            self.ease = None;
+            return None;
+        }
+        Some(e.value(ambient, now))
+    }
+}
+
+/// What decided the mist this frame, for `lookmist why`.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum MistSource {
+    #[default]
+    DayRoll,
+    FogDay,
+    Weather,
+    Event,
+    Held,
+}
+
+impl MistSource {
+    pub fn describe(self) -> &'static str {
+        match self {
+            MistSource::DayRoll => "the day's roll",
+            MistSource::FogDay => "a fog day",
+            MistSource::Weather => "the weather",
+            MistSource::Event => "an event",
+            MistSource::Held => "the held tune",
+        }
+    }
+}
+
+/// One frame's inputs to [`LookMist::step`].
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub struct MistInputs {
+    /// The day the roll is for: the server's, or the one `lookmist day` holds.
+    pub day: i64,
+    /// What the weather lifts it to ([`weather_scale`]).
+    pub weather: f32,
+    /// `lookmist <scale>`.
+    pub held: Option<f32>,
+    /// Whether the clock is the server's yet ([`WorldTime::live`]).
+    pub live: bool,
+    /// Whether the day is one `lookmist day` holds.
+    pub forced: bool,
+}
+
+/// The mist as resolved this frame: the multiple of the hour's own that the look's pass applies,
+/// and why.
+#[derive(Resource, Clone, Copy, Debug, PartialEq)]
+pub struct LookMist {
+    /// Times the hour's mist, this frame.
+    pub scale: f32,
+    pub source: MistSource,
+    /// The day rolled, and its roll.
+    pub day: i64,
+    pub roll: DayRoll,
+    /// What the weather lifts it to.
+    pub weather: f32,
+    /// The day's and the weather's together, eased: what shows with no event or tune.
+    pub ambient: f32,
+    /// The event's strength, while one shows.
+    pub event: Option<f32>,
+    /// The two follows behind [`Self::ambient`].
+    follow: [f32; 2],
+    /// The strength with no tune held, which an event eases from.
+    unheld: f32,
+    /// The clock's and the held day's state the follow last snapped on; `None` before the first.
+    seeded: Option<(bool, bool, i64)>,
+}
+
+impl Default for LookMist {
+    fn default() -> Self {
+        Self {
+            scale: 1.0,
+            source: MistSource::DayRoll,
+            day: 0,
+            roll: DayRoll::default(),
+            weather: 0.0,
+            ambient: 1.0,
+            event: None,
+            follow: [1.0; 2],
+            unheld: 1.0,
+            seeded: None,
+        }
+    }
+}
+
+impl LookMist {
+    /// One frame of `dt` real seconds, at real time `now`.
+    pub fn step(&mut self, input: MistInputs, event: &mut WorldMist, dt: f32, now: f64) {
+        let roll = day_roll(input.day);
+        let target = roll.scale.max(input.weather);
+        // Snap, not ease, on the first frame, when the server's clock lands (the first real day
+        // replaces the fallback's) and when the film holds a day or lets it go; the day turning
+        // over at midnight eases.
+        let key = (
+            input.live,
+            input.forced,
+            if input.forced { input.day } else { 0 },
+        );
+        if self.seeded != Some(key) {
+            self.seeded = Some(key);
+            self.follow = [target; 2];
+        } else {
+            let k = 1.0 - (-dt.max(0.0) / EASE_TAU).exp();
+            self.follow[0] += (target - self.follow[0]) * k;
+            self.follow[1] += (self.follow[0] - self.follow[1]) * k;
+        }
+        let ambient = self.follow[1];
+        event.apply_pending(self.unheld, ambient, now);
+        let ev = event.value(ambient, now);
+        let unheld = ev.unwrap_or(ambient);
+        let source = if input.held.is_some() {
+            MistSource::Held
+        } else if ev.is_some() {
+            MistSource::Event
+        } else if input.weather > roll.scale {
+            MistSource::Weather
+        } else if roll.fog_day {
+            MistSource::FogDay
+        } else {
+            MistSource::DayRoll
+        };
+        *self = Self {
+            scale: input.held.unwrap_or(unheld).clamp(0.0, SCALE_MAX),
+            source,
+            day: input.day,
+            roll,
+            weather: input.weather,
+            ambient,
+            event: ev,
+            follow: self.follow,
+            unheld,
+            seeded: self.seeded,
+        };
+    }
+}
+
+/// The frame's mist, before the look's frame copy reads it.
+pub(super) fn resolve_mist(
+    time: Res<Time<Real>>,
+    clock: Option<Res<WorldTime>>,
+    weather: Option<Res<WeatherState>>,
+    tune: Res<LookMistTune>,
+    mut event: ResMut<WorldMist>,
+    mut mist: ResMut<LookMist>,
+) {
+    let clock = clock.map(|c| *c).unwrap_or_default();
+    let input = MistInputs {
+        day: tune.day.unwrap_or_else(|| server_day(&clock)),
+        weather: weather.map_or(0.0, |w| weather_scale(&w)),
+        held: tune.scale,
+        live: clock.live,
+        forced: tune.day.is_some(),
+    };
+    mist.step(
+        input,
+        &mut event,
+        time.delta_secs(),
+        time.elapsed_secs_f64(),
+    );
+}
+
+pub(super) fn init_resources(app: &mut App) {
+    app.init_resource::<LookMist>().init_resource::<WorldMist>();
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn input(day: i64) -> MistInputs {
+        MistInputs {
+            day,
+            live: true,
+            ..default()
+        }
+    }
+
+    /// Runs `secs` of 60 fps frames from `t0`, returning the time it ends at.
+    fn run(mist: &mut LookMist, ev: &mut WorldMist, inp: MistInputs, t0: f64, secs: f32) -> f64 {
+        let dt = 1.0 / 60.0;
+        let mut t = t0;
+        for _ in 0..(secs / dt).round() as u32 {
+            t += f64::from(dt);
+            mist.step(inp, ev, dt, t);
+        }
+        t
+    }
+
+    #[test]
+    fn the_day_roll_is_fixed_and_in_range() {
+        for day in (-50..5000).chain([20_763, 739_000, i64::MAX, i64::MIN]) {
+            let r = day_roll(day);
+            assert_eq!(r, day_roll(day), "day {day}");
+            if r.fog_day {
+                assert!(
+                    (FOG_DAY_MIN..=FOG_DAY_MAX).contains(&r.scale),
+                    "{day}: {r:?}"
+                );
+            } else {
+                assert!((0.0..=DAY_MAX).contains(&r.scale), "{day}: {r:?}");
+            }
+        }
+        // Pinned, so a change to the hash (which would re-roll every hero's day) is seen.
+        let pinned: Vec<(bool, u32)> = [20_763i64, 20_764, 20_765]
+            .iter()
+            .map(|&d| {
+                let r = day_roll(d);
+                (r.fog_day, (r.scale * 1000.0).round() as u32)
+            })
+            .collect();
+        assert_eq!(pinned, PINNED_ROLLS);
+        // The days spread over the whole range, not bunched.
+        let plain: Vec<f32> = (0..2000)
+            .map(day_roll)
+            .filter(|r| !r.fog_day)
+            .map(|r| r.scale)
+            .collect();
+        let low = plain.iter().filter(|s| **s < 0.5).count() as f32 / plain.len() as f32;
+        let high = plain.iter().filter(|s| **s > 1.5).count() as f32 / plain.len() as f32;
+        assert!(
+            (0.2..0.3).contains(&low) && (0.2..0.3).contains(&high),
+            "{low} {high}"
+        );
+    }
+
+    /// 2026-11-06, -07 and -08.
+    const PINNED_ROLLS: [(bool, u32); 3] = [(false, 1344), (false, 834), (true, 3352)];
+
+    /// Ten years of days from 2026-01-01 (the calendar day numbers the server's date gives):
+    /// about one in seven is a fog day, and they do not bunch.
+    #[test]
+    fn about_one_day_in_seven_is_a_fog_day() {
+        let days: Vec<i64> = (20_454..20_454 + 3652).collect();
+        let fog: Vec<bool> = days.iter().map(|&d| day_roll(d).fog_day).collect();
+        let share = fog.iter().filter(|f| **f).count() as f32 / fog.len() as f32;
+        assert!(
+            (share - 1.0 / 7.0).abs() < 0.015,
+            "{share} over {} days",
+            fog.len()
+        );
+        let longest = fog.split(|f| !*f).map(<[bool]>::len).max().unwrap_or(0);
+        assert!(longest <= 4, "{longest} fog days running");
+        // A thousand-day stretch anywhere is near the share too.
+        for chunk in fog.chunks(1000).filter(|c| c.len() == 1000) {
+            let n = chunk.iter().filter(|f| **f).count();
+            assert!((110..=180).contains(&n), "{n} in a thousand");
+        }
+    }
+
+    #[test]
+    fn the_weather_lifts_it() {
+        let mut w = WeatherState::default();
+        assert_eq!(weather_scale(&w), 0.0);
+        w.sky_density = 0.125;
+        assert!((weather_scale(&w) - OVERCAST_SCALE / 2.0).abs() < 1e-5);
+        w.sky_density = 0.25;
+        assert!((weather_scale(&w) - OVERCAST_SCALE).abs() < 1e-5);
+        w.effect_kind = WeatherKind::Rain;
+        w.effect_density = 1.0;
+        assert!((weather_scale(&w) - OVERCAST_SCALE - RAIN_SCALE).abs() < 1e-5);
+        w.effect_kind = WeatherKind::Snow;
+        assert!(
+            (weather_scale(&w) - OVERCAST_SCALE).abs() < 1e-5,
+            "snow: its overcast only"
+        );
+
+        // The higher of the day's and the weather's: a thin day under a full overcast mists to
+        // the overcast's, a fog day's stronger roll stays its own.
+        let thin = (0..).find(|&d| day_roll(d).scale < 0.5).unwrap();
+        let fog = (0..).find(|&d| day_roll(d).scale > OVERCAST_SCALE).unwrap();
+        let mut mist = LookMist::default();
+        let mut ev = WorldMist::default();
+        let overcast = MistInputs {
+            weather: OVERCAST_SCALE,
+            ..input(thin)
+        };
+        mist.step(overcast, &mut ev, 0.0, 0.0);
+        assert_eq!(mist.scale, OVERCAST_SCALE);
+        assert_eq!(mist.source, MistSource::Weather);
+        let fog_held = MistInputs {
+            day: fog,
+            forced: true,
+            ..overcast
+        };
+        mist.step(fog_held, &mut ev, 0.0, 0.0);
+        assert_eq!(mist.scale, day_roll(fog).scale);
+        assert_eq!(mist.source, MistSource::FogDay);
+    }
+
+    /// A new strength eases in over about twenty seconds: no step between frames, little in the
+    /// first seconds, within 5% at twenty, there at forty.
+    #[test]
+    fn a_change_eases_in() {
+        let mut mist = LookMist::default();
+        let mut ev = WorldMist::default();
+        let thin = (0..).find(|&d| day_roll(d).scale < 0.3).unwrap();
+        let from = day_roll(thin).scale;
+        mist.step(input(thin), &mut ev, 0.0, 0.0);
+        assert_eq!(mist.scale, from, "the first frame snaps");
+        // The rain comes: four times the hour's.
+        let rain = MistInputs {
+            weather: 4.0,
+            ..input(thin)
+        };
+        let dt = 1.0 / 60.0;
+        let (mut t, mut last) = (0.0, mist.scale);
+        let mut at = |secs: f32, mist: &mut LookMist, ev: &mut WorldMist| {
+            while t < f64::from(secs) - 1e-6 {
+                t += f64::from(dt);
+                mist.step(rain, ev, dt, t);
+                assert!((mist.scale - last).abs() < 0.01, "a pop at {t}");
+                assert!(mist.scale >= last - 1e-6, "monotonic");
+                last = mist.scale;
+            }
+            (mist.scale - from) / (4.0 - from)
+        };
+        assert!(at(2.0, &mut mist, &mut ev) < 0.1, "a gentle start");
+        let half = at(8.0, &mut mist, &mut ev);
+        assert!((0.3..0.8).contains(&half), "{half}");
+        assert!(at(20.0, &mut mist, &mut ev) > 0.95);
+        assert!(at(40.0, &mut mist, &mut ev) > 0.999);
+        // Holding a day for film snaps to it, as does letting it go.
+        let other = (0..).find(|&d| day_roll(d).scale > 1.5).unwrap();
+        mist.step(
+            MistInputs {
+                day: other,
+                forced: true,
+                ..input(thin)
+            },
+            &mut ev,
+            dt,
+            t,
+        );
+        assert_eq!(mist.scale, day_roll(other).scale);
+    }
+
+    /// An event wins over the day and the weather, eased in and out over its own time; a held
+    /// tune wins over all, at once, and lets go to what was under it.
+    #[test]
+    fn an_event_wins_and_a_held_tune_wins_over_all() {
+        let mut mist = LookMist::default();
+        let mut ev = WorldMist::default();
+        let day = (0..)
+            .find(|&d| (0.5..1.5).contains(&day_roll(d).scale))
+            .unwrap();
+        let base = day_roll(day).scale;
+        let stormy = MistInputs {
+            weather: 2.0,
+            ..input(day)
+        };
+        let t = run(&mut mist, &mut ev, stormy, 0.0, 60.0);
+        assert!((mist.scale - 2.0).abs() < 1e-3);
+        ev.request(MistEvent::Set {
+            scale: 3.5,
+            secs: Some(2.0),
+        });
+        let t = run(&mut mist, &mut ev, stormy, t, 1.0);
+        assert!(mist.scale > 2.0 && mist.scale < 3.5, "{}", mist.scale);
+        assert_eq!(mist.source, MistSource::Event);
+        let t = run(&mut mist, &mut ev, stormy, t, 1.5);
+        assert!((mist.scale - 3.5).abs() < 1e-4);
+        // An event's thin mist wins over a heavy day too.
+        ev.request(MistEvent::Set {
+            scale: 0.0,
+            secs: Some(0.0),
+        });
+        let t = run(&mut mist, &mut ev, stormy, t, 0.1);
+        assert_eq!(mist.scale, 0.0);
+        ev.request(MistEvent::Set {
+            scale: 9.0,
+            secs: None,
+        });
+        let t = run(&mut mist, &mut ev, stormy, t, 0.1);
+        assert!(mist.scale < 0.2, "no time given: the twenty-second ease");
+        let t = run(&mut mist, &mut ev, stormy, t, MIST_EASE_SECS);
+        assert_eq!(mist.scale, SCALE_MAX, "held to the most");
+
+        // A tune held wins at once, and lets go to the event under it.
+        let held = MistInputs {
+            held: Some(0.5),
+            ..stormy
+        };
+        let t = run(&mut mist, &mut ev, held, t, 0.1);
+        assert_eq!((mist.scale, mist.source), (0.5, MistSource::Held));
+        ev.request(MistEvent::Clear { secs: Some(2.0) });
+        let t = run(&mut mist, &mut ev, held, t, 1.0);
+        assert_eq!(mist.scale, 0.5, "held over a clearing event");
+        let t = run(&mut mist, &mut ev, stormy, t, 0.1);
+        assert!(mist.scale > 2.0 && mist.scale < SCALE_MAX, "{}", mist.scale);
+        let t = run(&mut mist, &mut ev, stormy, t, 2.0);
+        assert!(!ev.active());
+        assert!((mist.scale - 2.0).abs() < 1e-3, "back to the weather's");
+        // The weather passes; the day's own eases back.
+        run(&mut mist, &mut ev, input(day), t, 60.0);
+        assert!((mist.scale - base).abs() < 1e-3);
+        assert_eq!(mist.source, MistSource::DayRoll);
+        // A clear with no event is nothing.
+        ev.request(MistEvent::Clear { secs: None });
+        run(&mut mist, &mut ev, input(day), t + 60.0, 0.1);
+        assert!(!ev.active());
+    }
+
+    /// The system reads the server's day (not the film clock), the weather and the tune.
+    #[test]
+    fn the_system_follows_the_servers_day() {
+        let mut app = App::new();
+        app.init_resource::<Time<Real>>()
+            .init_resource::<LookMistTune>()
+            .insert_resource(WorldTime {
+                minute: 330,
+                minute_f: 330.0,
+                day: 10_002.0 + 330.0 / 1440.0,
+                date: 20_763,
+                live: true,
+            })
+            .add_systems(Update, resolve_mist);
+        init_resources(&mut app);
+        app.update();
+        let mist = *app.world().resource::<LookMist>();
+        assert_eq!(mist.day, 20_763, "the date, not the moon's day count");
+        assert_eq!(mist.scale, day_roll(20_763).scale);
+        app.world_mut().resource_mut::<LookMistTune>().day = Some(5);
+        app.update();
+        assert_eq!(app.world().resource::<LookMist>().day, 5);
+        assert_eq!(app.world().resource::<LookMist>().scale, day_roll(5).scale);
+    }
+}
