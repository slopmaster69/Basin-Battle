diff --git a/crates/benilla-ui/src/world_mist.rs b/crates/benilla-ui/src/world_mist.rs
new file mode 100644
index 0000000..7ebc862
--- /dev/null
+++ b/crates/benilla-ui/src/world_mist.rs
@@ -0,0 +1,141 @@
+//! Basin Battle's call for mist, benilla's own (1.12 has none): the new look's mist (`worldLook 1`)
+//! is thickest on fog days and in bad weather, and a server event (a boss arriving, a raid on the
+//! camp) can call for it through the add-on:
+//!
+//! - `SetWorldMist(scale[, seconds])`: the mist at `scale` times the hour's own (0 to 6; 3 to 4 is
+//!   a fog day's), winning over the day's and the weather's until cleared, eased in over `seconds`
+//!   (0 to 600; about 20 with none given). Called again, it eases from where it is to the new one.
+//! - `ClearWorldMist([seconds])`: ease back to the day's and the weather's mist (about 20 seconds
+//!   with none given, at once with 0). Leaving the world clears it at once.
+//!
+//! Every hero must see the same mist, so call them for everyone at once (from a server line), not
+//! from one hero's own doing. A client without them has neither global: test `SetWorldMist` before
+//! calling it. The classic look has no mist, and ignores both.
+
+use mlua::{Lua, MultiValue, Value};
+
+/// A mist call, as the add-on made it: `secs` is `None` when no time was given.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum WorldMistCall {
+    Set { scale: f32, secs: Option<f32> },
+    Clear { secs: Option<f32> },
+}
+
+/// The thickest a call can ask for, times the hour's (the film's `lookmist` range).
+const SCALE_MAX: f32 = 6.0;
+/// The longest ease a call can ask for, seconds.
+const SECS_MAX: f32 = 600.0;
+
+static WORLD_MIST: std::sync::Mutex<Vec<WorldMistCall>> = std::sync::Mutex::new(Vec::new());
+
+/// The mist calls since the last call, oldest first.
+pub fn take_world_mist() -> Vec<WorldMistCall> {
+    WORLD_MIST
+        .lock()
+        .map(|mut v| std::mem::take(&mut *v))
+        .unwrap_or_default()
+}
+
+fn push(call: WorldMistCall) {
+    if let Ok(mut v) = WORLD_MIST.lock() {
+        // Only the last few matter: each eases from where the one before left it.
+        if v.len() >= 16 {
+            v.remove(0);
+        }
+        v.push(call);
+    }
+}
+
+/// A number argument held to `0..=hi`, `None` when missing or not a number.
+fn number(v: Option<&Value>, hi: f32) -> Option<f32> {
+    let n = match v? {
+        Value::Integer(i) => *i as f32,
+        Value::Number(n) => *n as f32,
+        Value::String(s) => s.to_str().ok()?.trim().parse::<f32>().ok()?,
+        _ => return None,
+    };
+    n.is_finite().then(|| n.clamp(0.0, hi))
+}
+
+pub(crate) fn install(lua: &Lua) -> mlua::Result<()> {
+    let g = lua.globals();
+    g.set(
+        "SetWorldMist",
+        lua.create_function(|_, args: MultiValue| {
+            let v: Vec<Value> = args.into_iter().collect();
+            // No strength, no call.
+            if let Some(scale) = number(v.first(), SCALE_MAX) {
+                push(WorldMistCall::Set {
+                    scale,
+                    secs: number(v.get(1), SECS_MAX),
+                });
+            }
+            Ok(())
+        })?,
+    )?;
+    g.set(
+        "ClearWorldMist",
+        lua.create_function(|_, args: MultiValue| {
+            push(WorldMistCall::Clear {
+                secs: number(args.front(), SECS_MAX),
+            });
+            Ok(())
+        })?,
+    )?;
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn world_mist_calls_queue_clamped_and_in_order() {
+        let lua = Lua::new();
+        install(&lua).unwrap();
+        take_world_mist();
+        lua.load(
+            r#"SetWorldMist(3.5, 2) SetWorldMist(9) SetWorldMist() SetWorldMist("x", 4)
+               SetWorldMist("1.5", -3) ClearWorldMist(2) ClearWorldMist() ClearWorldMist(9999)"#,
+        )
+        .exec()
+        .unwrap();
+        assert_eq!(
+            take_world_mist(),
+            vec![
+                WorldMistCall::Set {
+                    scale: 3.5,
+                    secs: Some(2.0)
+                },
+                WorldMistCall::Set {
+                    scale: 6.0,
+                    secs: None
+                },
+                WorldMistCall::Set {
+                    scale: 1.5,
+                    secs: Some(0.0)
+                },
+                WorldMistCall::Clear { secs: Some(2.0) },
+                WorldMistCall::Clear { secs: None },
+                WorldMistCall::Clear { secs: Some(600.0) },
+            ],
+            "a call with no strength is dropped; the strength is held to 6, the time to 0..600"
+        );
+        assert!(take_world_mist().is_empty(), "taken once");
+        // Only the last sixteen are kept.
+        for i in 0..20 {
+            lua.load(format!("SetWorldMist({}, 1)", i % 6))
+                .exec()
+                .unwrap();
+        }
+        let calls = take_world_mist();
+        assert_eq!(calls.len(), 16);
+        assert_eq!(
+            calls[0],
+            WorldMistCall::Set {
+                scale: 4.0,
+                secs: Some(1.0)
+            }
+        );
+    }
+}
