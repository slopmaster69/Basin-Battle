+//! The god rays' and the morning mist's CPU half, benilla's own (no reference behaviour): where
+//! the sun is on screen and how visible its rays are, and the mist's exponential height fog
+//! integrated along a view ray in closed form. `world_look.wgsl` runs the same integral per pixel;
+//! these are its inputs and its reference.
+
+use bevy::math::{Mat4, Vec2, Vec3, Vec4Swizzles};
+
+/// How far out the sun is placed to project it: well inside the 3000 yd far plane, and so far that
+/// the camera's own offset does not move it on screen.
+const SUN_DISTANCE: f32 = 1000.0;
+
+/// The sun's screen position (UV, origin top-left, as the fullscreen pass's `uv`) and how visible
+/// its rays are, 0..1: faded with the sun near or under the horizon, as it leaves the screen, and
+/// as it goes behind the camera, each a ramp and never a cut. `sun_dir` is camera to sun (unit,
+/// Bevy space, +Y up); `cam_fwd` the camera's look direction (unit).
+pub fn sun_screen(
+    clip_from_world: Mat4,
+    cam_pos: Vec3,
+    cam_fwd: Vec3,
+    sun_dir: Vec3,
+) -> (Vec2, f32) {
+    let clip = clip_from_world * (cam_pos + sun_dir * SUN_DISTANCE).extend(1.0);
+    // Behind the camera the projection flips; the facing fade below is already 0 there.
+    if clip.w <= 1e-4 {
+        return (Vec2::splat(0.5), 0.0);
+    }
+    let ndc = clip.xy() / clip.w;
+    let uv = Vec2::new(ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5);
+    (
+        uv,
+        horizon_fade(sun_dir) * facing_fade(cam_fwd, sun_dir) * screen_fade(uv),
+    )
+}
+
+fn smoothstep(e0: f32, e1: f32, x: f32) -> f32 {
+    let t = ((x - e0) / (e1 - e0)).clamp(0.0, 1.0);
+    t * t * (3.0 - 2.0 * t)
+}
+
+/// 0 with the sun a little under the horizon, 1 once it is about 7° up (sine 0.12).
+pub fn horizon_fade(sun_dir: Vec3) -> f32 {
+    smoothstep(-0.03, 0.12, sun_dir.y)
+}
+
+/// 0 with the sun square to the view or behind it, 1 within about 75° of straight ahead.
+pub fn facing_fade(cam_fwd: Vec3, sun_dir: Vec3) -> f32 {
+    smoothstep(0.0, 0.25, cam_fwd.dot(sun_dir))
+}
+
+/// 1 on screen, down to 0 by half a screen past its edge.
+pub fn screen_fade(uv: Vec2) -> f32 {
+    let out = (-uv).max(uv - Vec2::ONE).max(Vec2::ZERO);
+    1.0 - smoothstep(0.0, 0.5, out.x.max(out.y))
+}
+
+/// The mist's density at its base, per yard, at `height_fog` 1: one e-fold over about 170 yd at
+/// the base, so the level ground round the player is lightly veiled (about 30% at 100 yd at dawn,
+/// 12% at night) while a hollow ten yards below fills white. A first pass, to tune on video.
+pub const MIST_DENSITY: f32 = 0.006;
+/// The mist thins by e every this many yards up: thick in low ground, thin on the hills.
+pub const MIST_FALLOFF: f32 = 6.0;
+/// The mist's base above the ground under the player.
+pub const MIST_BASE_ABOVE_GROUND: f32 = 2.0;
+/// With no player (a detached camera), the base sits this far under the camera instead.
+pub const MIST_BASE_BELOW_CAMERA: f32 = 6.0;
+/// The most the mist ever covers a pixel, so a deep valley is veiled, never erased.
+pub const MIST_MAX: f32 = 0.85;
+/// The density exponent's clamp: a valley far under the base saturates instead of overflowing.
+const MIST_EXP_LIMIT: f32 = 30.0;
+
+/// The mist's base height (Bevy +Y): [`MIST_BASE_ABOVE_GROUND`] over the player's feet, or with
+/// no player [`MIST_BASE_BELOW_CAMERA`] under the camera.
+pub fn mist_base(feet_y: Option<f32>, cam_y: f32) -> f32 {
+    feet_y.map_or(cam_y - MIST_BASE_BELOW_CAMERA, |y| {
+        y + MIST_BASE_ABOVE_GROUND
+    })
+}
+
+/// The exponential height fog's optical depth along a straight ray of length `dist` from height
+/// `y0` to `y1`, for a density `density · exp(−(y − base) / falloff)`: the closed form
+/// `k · dist · (1 − e^(−a)) / a`, `k` the density at `y0`, `a = (y1 − y0) / falloff`, and
+/// `k · dist` for a level ray. `world_look.wgsl`'s `mist_depth` is the same; keep them in step.
+pub fn mist_optical_depth(
+    density: f32,
+    base: f32,
+    falloff: f32,
+    y0: f32,
+    y1: f32,
+    dist: f32,
+) -> f32 {
+    let k = density * (-(y0 - base) / falloff).min(MIST_EXP_LIMIT).exp();
+    let a = (y1 - y0) / falloff;
+    if a.abs() < 1e-4 {
+        k * dist
+    } else {
+        // Clamped like `k`: a ray plunging far under the base saturates rather than overflowing.
+        k * dist * (1.0 - (-a).min(MIST_EXP_LIMIT).exp()) / a
+    }
+}
+
+/// How much of a pixel the mist covers: Beer–Lambert on the optical depth, capped at [`MIST_MAX`].
+pub fn mist_amount(optical_depth: f32) -> f32 {
+    (1.0 - (-optical_depth).exp()).min(MIST_MAX)
+}
