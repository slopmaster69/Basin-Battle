diff --git a/crates/benilla-app/src/target/world_mist.rs b/crates/benilla-app/src/target/world_mist.rs
new file mode 100644
index 0000000..44bc1d5
--- /dev/null
+++ b/crates/benilla-app/src/target/world_mist.rs
@@ -0,0 +1,76 @@
+//! Basin Battle's call for mist: the add-on's `SetWorldMist` and `ClearWorldMist`
+//! (`benilla_ui::world_mist`) onto the world's [`WorldMist`], which the new look's mist resolve
+//! eases in over the day's and the weather's (`benilla_world::look::mist`).
+
+use benilla_ui::world_mist::{self, WorldMistCall};
+use benilla_world::look::{MistEvent, WorldMist};
+use bevy::prelude::*;
+
+/// Hand the frame's mist calls to the world in the order they came.
+pub(super) fn apply_world_mist(mut mist: ResMut<WorldMist>) {
+    apply_calls(&mut mist, world_mist::take_world_mist());
+}
+
+fn apply_calls(mist: &mut WorldMist, calls: Vec<WorldMistCall>) {
+    for call in calls {
+        mist.request(match call {
+            WorldMistCall::Set { scale, secs } => MistEvent::Set { scale, secs },
+            WorldMistCall::Clear { secs } => MistEvent::Clear { secs },
+        });
+    }
+}
+
+/// Leaving the world: an event's mist goes at once (and any call still queued with it), so it
+/// never carries into the next world.
+pub(super) fn reset_world_mist(mut mist: ResMut<WorldMist>) {
+    world_mist::take_world_mist();
+    mist.reset();
+}
+
+/// A new UI VM (a `ReloadUI`, an add-on turned off): nothing is left to clear the old add-on's
+/// event, so it eases out; an add-on that wants it again asks again.
+pub(super) fn release_world_mist_on_new_vm(
+    script: Option<NonSend<benilla_ui::script::UiScript>>,
+    mut seen: Local<u64>,
+    mut mist: ResMut<WorldMist>,
+) {
+    let Some(script) = script else { return };
+    let now = script.session();
+    if *seen != 0 && now != *seen && mist.active() {
+        mist.request(MistEvent::Clear { secs: None });
+    }
+    *seen = now;
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_calls_reach_the_world_in_order_and_leaving_drops_them() {
+        let mut mist = WorldMist::default();
+        apply_calls(
+            &mut mist,
+            vec![
+                WorldMistCall::Set {
+                    scale: 3.5,
+                    secs: Some(2.0),
+                },
+                WorldMistCall::Clear { secs: None },
+            ],
+        );
+        let mut want = WorldMist::default();
+        want.request(MistEvent::Set {
+            scale: 3.5,
+            secs: Some(2.0),
+        });
+        want.request(MistEvent::Clear { secs: None });
+        assert_eq!(mist, want);
+
+        let mut app = App::new();
+        app.insert_resource(mist)
+            .add_systems(Update, reset_world_mist);
+        app.update();
+        assert_eq!(*app.world().resource::<WorldMist>(), WorldMist::default());
+    }
+}
