+/// size (Elwynn Survival's camp buildings: Elwynn's own guard tower at two fifths, its four wall
+/// torches with it) casts pools shrunk the same, in reach and in strength: a miniature's torch is a
+/// candle, not four full torches a stride apart on one pale wall. Nothing grows past a full
+/// torch's pool, however big its host.
+pub fn torch_light(pl: &WorldPointLight, host_scale: f32) -> Option<LookLight> {
     // `intensity` is `4π ×` the authored scale (the `PointLight` convention).
     let s = pl.intensity / (4.0 * std::f32::consts::PI);
     let rgb = pl.color.map(|c| (c * s).max(0.0));
