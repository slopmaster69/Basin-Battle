@@ -0,0 +1,80 @@
+//! Basin Battle's map variant signal, not a stock 1.12 behavior. A map-wide, model-less GO
+//! exists for the lifetime of the ruined state; deriving from the snapshot covers late joins,
+//! destroy packets, reconnects and leaving the map without a second protocol.
+use benilla_protocol::EntityKind;
+use benilla_world::schedule::{WorldLive, WorldStage};
+use benilla_world::terrain_stream::DeadminesAftermath;
+use benilla_world::world_map::CurrentMap;
+use bevy::prelude::*;
+
+use crate::net::{Guid, NetEntity, ObjectStore};
+
+const MARKER_ENTRY: u32 = 500100;
+const MARKER_GUID: u64 = 0xF110_07A1_84FF_FFFF;
+
+pub(crate) fn plugin(app: &mut App) {
+    app.init_resource::<DeadminesAftermath>().add_systems(
+        Update,
+        sync.after(WorldStage::Input).before(WorldStage::Stream),
+    );
+}
+
+fn sync(
+    live: Res<WorldLive>,
+    map: Option<Res<CurrentMap>>,
+    objects: Query<(&Guid, &NetEntity, &ObjectStore)>,
+    mut after: ResMut<DeadminesAftermath>,
+) {
+    let enabled = live.0
+        && map.is_some_and(|m| m.0 == 36)
+        && objects.iter().any(|(guid, net, fields)| {
+            guid.0 == MARKER_GUID
+                && net.kind == EntityKind::GameObject
+                && net.display_id.unwrap_or(0) == 0
+                && fields.0.object_entry() == Some(MARKER_ENTRY)
+        });
+    if after.0 != enabled {
+        after.0 = enabled;
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use benilla_protocol::ObjectFields;
+
+    #[test]
+    fn late_join_marker_removal_and_map_exit_restore_the_original_world() {
+        let mut app = App::new();
+        app.insert_resource(WorldLive(true))
+            .insert_resource(CurrentMap(36));
+        plugin(&mut app);
+        let marker = app
+            .world_mut()
+            .spawn((
+                Guid(MARKER_GUID),
+                NetEntity {
+                    kind: EntityKind::GameObject,
+                    display_id: Some(0),
+                    scale: 1.0,
+                },
+                ObjectStore(ObjectFields::from_pairs(&[(3, MARKER_ENTRY)])),
+            ))
+            .id();
+        app.update();
+        assert!(app.world().resource::<DeadminesAftermath>().0);
+        app.world_mut().resource_mut::<CurrentMap>().0 = 0;
+        app.update();
+        assert!(!app.world().resource::<DeadminesAftermath>().0);
+        app.world_mut().resource_mut::<CurrentMap>().0 = 36;
+        app.update();
+        assert!(app.world().resource::<DeadminesAftermath>().0);
+        app.world_mut().resource_mut::<WorldLive>().0 = false;
+        app.update();
+        assert!(!app.world().resource::<DeadminesAftermath>().0);
+        app.world_mut().resource_mut::<WorldLive>().0 = true;
+        app.world_mut().despawn(marker);
+        app.update();
+        assert!(!app.world().resource::<DeadminesAftermath>().0);
+    }
+}
