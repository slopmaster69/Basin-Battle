+++ b/crates/benilla/src/main.rs
@@ -3,6 +3,22 @@
 
 use benilla_app::BuildId;
 
+/// NVIDIA's switchable-graphics hint: a laptop's driver reads this export from the executable at
+/// launch and puts the process on the discrete GPU rather than the integrated one, whatever its
+/// own guess. `build.rs` exports it (an executable exports nothing on its own).
+#[cfg(windows)]
+#[allow(non_upper_case_globals)]
+#[unsafe(no_mangle)]
+#[used]
+pub static NvOptimusEnablement: u32 = 1;
+
+/// AMD's twin of [`NvOptimusEnablement`], for a laptop with AMD switchable graphics.
+#[cfg(windows)]
+#[allow(non_upper_case_globals)]
+#[unsafe(no_mangle)]
+#[used]
+pub static AmdPowerXpressRequestHighPerformance: i32 = 1;
