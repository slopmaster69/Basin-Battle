+++ b/crates/benilla-world/src/boot.rs
@@ -13,6 +13,21 @@ pub fn tuned_default_plugins(primary_window: Window) -> PluginGroupBuilder {
             primary_window: Some(primary_window),
             ..default()
         })
+        // The fast GPU, said outright: on a laptop with an integrated GPU and a discrete one, wgpu
+        // ranks the discrete one first only under `HighPerformance`. Bevy's default is the same
+        // today (`WGPU_POWER_PREF` still overrides it); spelled here so a change of default
+        // upstream cannot move a player onto the slow GPU. The binary also exports NVIDIA's and
+        // AMD's switchable-graphics hints (`benilla/src/main.rs`), and `perf::perf_log` writes the
+        // adapter chosen to `benilla-config/perf.log`.
+        .set(bevy::render::RenderPlugin {
+            render_creation: bevy::render::settings::WgpuSettings {
+                power_preference: bevy::render::settings::PowerPreference::from_env()
+                    .unwrap_or(bevy::render::settings::PowerPreference::HighPerformance),
+                ..default()
+            }
+            .into(),
+            ..default()
+        })
         // Deliberately no `AssetPlugin::file_path`: a baked source path resolves only on the build
         // machine. Every shader is embedded (`embedded://<crate>/shaders/…`), so no root is read.
         // Quiet wgpu/naga; the ring keeps the last stderr lines for the crash report (`log_ring`).
