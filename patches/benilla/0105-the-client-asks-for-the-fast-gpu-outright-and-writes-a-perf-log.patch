-//! Stamps the commit this binary was built from.
+//! Stamps the commit this binary was built from, and on Windows exports the switchable-graphics
+//! hints `main.rs` defines.
 
 fn main() {
     benilla_buildstamp::emit();
+    // An executable exports no symbol on its own, and NVIDIA's and AMD's laptop drivers look the
+    // two hints up in the export table. MSVC's linker exports by name; the GNU toolchain (a local
+    // build, never a player's) goes without, as it did before.
+    let windows = std::env::var("CARGO_CFG_TARGET_OS").as_deref() == Ok("windows");
+    let msvc = std::env::var("CARGO_CFG_TARGET_ENV").as_deref() == Ok("msvc");
+    if windows && msvc {
+        println!("cargo:rustc-link-arg-bins=/EXPORT:NvOptimusEnablement");
+        println!("cargo:rustc-link-arg-bins=/EXPORT:AmdPowerXpressRequestHighPerformance");
+    }
 }
