+//! Basin Battle's ground bursts, not part of 1.12.1: an ability's shape flashed on the ground as
+//! it lands, for the Elwynn Survival add-on (`PlayGroundBurst`). A shock front runs from the spot
+//! out to the reach over the burst's time and fades behind itself, with a flash of the whole
+//! shape under it that goes out first. An effect, like a weapon trail, not a floor marker: it
+//! draws whatever the marker settings say, for the caster too (Shockwave's cone, where the spell
+//! look is a ring). The shapes are the telegraphs' (`super::telegraph`), the textures made here.
+
+use std::collections::HashMap;
+
+use bevy::asset::RenderAssetUsages;
+use bevy::prelude::*;
+use bevy::render::render_resource::{Extent3d, TextureDimension, TextureFormat};
+
+use benilla_assets::coords::wow_to_bevy;
+use benilla_ui::action_combat::{self, TeleShape};
+use benilla_world::decal::WorldDecal;
+use benilla_world::view::WorldCamera;
+
+use super::telegraph::{self, Layer};
+
+/// The most bursts alive at once; the oldest goes when another comes.
+const MAX_BURSTS: usize = 16;
+/// The front starts this share of the reach out (a band, not a point).
+const FRONT_FROM: f32 = 0.12;
+/// The front's run is over by this share of the burst's time; the rest is its fade.
+const RUN_SHARE: f32 = 0.7;
+/// The flash of the whole shape is gone by this share of the burst's time.
+const FLASH_SHARE: f32 = 0.55;
+/// The textures' size (px) and the share of their half-width the shape's edge sits at.
+const TEX: u32 = 128;
+const EDGE: f32 = 0.97;
+/// The front band's thickness, as a share of the radius (the strip's length).
+const BAND: f32 = 0.16;
+
+/// One burst under way.
+struct Burst {
+    start: f32,
+    secs: f32,
+    rgb: [f32; 3],
+    at: Vec3,
+    yaw: f32,
+    shape: TeleShape,
+    reach: f32,
+    arc: f32,
+    width: f32,
+    /// The shock front, placed afresh each frame as it runs out.
+    front: Layer,
+    /// The whole shape, placed once.
+    flash: Layer,
+}
+
+#[derive(Resource, Default)]
+pub(super) struct GroundBursts {
+    list: Vec<Burst>,
+    /// The textures by (shape code, arc in whole degrees, front or flash).
+    textures: HashMap<(u8, u16, bool), Handle<Image>>,
+}
+
+impl GroundBursts {
+    fn texture(&mut self, images: &mut Assets<Image>, shape: TeleShape, arc: f32, front: bool) -> Handle<Image> {
+        let (code, arc_key) = match shape {
+            TeleShape::Ring => (1u8, 360),
+            TeleShape::Line => (2u8, 0),
+            TeleShape::Wedge => (0u8, arc.round() as u16),
+        };
+        self.textures
+            .entry((code, arc_key, front))
+            .or_insert_with(|| {
+                images.add(match (shape, front) {
+                    (TeleShape::Line, true) => line_front_image(),
+                    (TeleShape::Line, false) => telegraph::line_image(true),
+                    (_, true) => shape_front_image(shape == TeleShape::Ring, arc),
+                    (_, false) => telegraph::shape_image(shape == TeleShape::Ring, arc, true),
+                })
+            })
+            .clone()
+    }
+}
+
+fn image(data: Vec<u8>) -> Image {
+    Image::new(
+        Extent3d {
+            width: TEX,
+            height: TEX,
+            depth_or_array_layers: 1,
+        },
+        TextureDimension::D2,
+        data,
+        TextureFormat::Rgba8UnormSrgb,
+        RenderAssetUsages::default(),
+    )
+}
+
+/// The front's band across a shape's radius: bright at the edge, gone a little way behind it.
+fn band(r: f32) -> f32 {
+    let back = (1.0 - r) / BAND;
+    if !(0.0..=1.0).contains(&back) {
+        return 0.0;
+    }
+    // Sharp at the front, trailing off behind.
+    (1.0 - back).powf(1.5)
+}
+
+/// A wedge's (or a ring's) front: the band at the rim, pointing along +u from the centre.
+fn shape_front_image(ring: bool, arc_deg: f32) -> Image {
+    let half = (arc_deg.clamp(5.0, 360.0) / 2.0).to_radians();
+    let mut data = vec![0u8; (TEX * TEX * 4) as usize];
+    let c = TEX as f32 / 2.0;
+    for j in 0..TEX {
+        for i in 0..TEX {
+            let dx = (i as f32 + 0.5 - c) / (c * EDGE);
+            let dy = (j as f32 + 0.5 - c) / (c * EDGE);
+            let r = (dx * dx + dy * dy).sqrt();
+            if r > 1.0 {
+                continue;
+            }
+            let ang = dy.atan2(dx).abs();
+            if !ring && ang > half {
+                continue;
+            }
+            // The wedge's two sides soften a little; the rim is the front itself.
+            let side = if ring { 1.0 } else { ((half - ang) * r / 0.05).clamp(0.0, 1.0) };
+            let a = 255.0 * band(r) * side;
+            if a < 1.0 {
+                continue;
+            }
+            let k = ((j * TEX + i) * 4) as usize;
+            data[k..k + 4].copy_from_slice(&[255, 255, 255, a as u8]);
+        }
+    }
+    image(data)
+}
+
+/// A strip's front: the band at its far end (+u), its sides softened.
+fn line_front_image() -> Image {
+    let mut data = vec![0u8; (TEX * TEX * 4) as usize];
+    for j in 0..TEX {
+        for i in 0..TEX {
+            let u = (i as f32 + 0.5) / TEX as f32;
+            let v = (j as f32 + 0.5) / TEX as f32;
+            let edge = (v.min(1.0 - v) / 0.1).clamp(0.0, 1.0);
+            let a = 255.0 * band(u / EDGE) * edge;
+            if a < 1.0 {
+                continue;
+            }
+            let k = ((j * TEX + i) * 4) as usize;
+            data[k..k + 4].copy_from_slice(&[255, 255, 255, a as u8]);
+        }
+    }
+    image(data)
+}
+
+/// Take the script's bursts, drop the finished, and run each front out over the ground.
+pub(super) fn update_ground_bursts(time: Res<Time>, decals: WorldDecal, mut state: ResMut<GroundBursts>) {
+    let now = time.elapsed_secs();
+    for c in action_combat::take_ground_bursts() {
+        if state.list.len() >= MAX_BURSTS {
+            state.list.remove(0);
+        }
+        state.list.push(Burst {
+            start: now,
+            secs: c.secs,
+            rgb: [f32::from(c.rgb[0]) / 255.0, f32::from(c.rgb[1]) / 255.0, f32::from(c.rgb[2]) / 255.0],
+            at: wow_to_bevy(c.at),
+            yaw: c.yaw,
+            shape: c.shape,
+            reach: c.reach,
+            arc: c.arc,
+            width: c.width,
+            front: Layer::default(),
+            flash: Layer::default(),
+        });
+    }
+    state.list.retain(|b| now < b.start + b.secs);
+    for b in &mut state.list {
+        // The run: quick off the mark, slowing to the edge.
+        let k = ((now - b.start) / (b.secs * RUN_SHARE)).clamp(0.0, 1.0);
+        let k = 1.0 - (1.0 - k) * (1.0 - k);
+        let run = b.reach * (FRONT_FROM + (1.0 - FRONT_FROM) * k);
+        telegraph::place_shape(&mut b.front, &decals, b.shape, b.at, b.yaw, run.max(0.3), b.width.max(0.3));
+        if b.flash.verts.is_empty() {
+            telegraph::place_shape(&mut b.flash, &decals, b.shape, b.at, b.yaw, b.reach.max(0.3), b.width.max(0.3));
+        }
+    }
+}
+
+/// Draw them: the flash of the whole shape going out, the front at full strength through its
+/// run and fading after.
+pub(super) fn push_ground_bursts(
+    time: Res<Time>,
+    mut images: ResMut<Assets<Image>>,
+    state: Option<ResMut<GroundBursts>>,
+    cam: Query<Entity, With<WorldCamera>>,
+    mut draw: benilla_world::particles::buffer::WorldEffectDraw,
+) {
+    let (Some(mut state), Ok(cam)) = (state, cam.single()) else {
+        return;
+    };
+    let now = time.elapsed_secs();
+    let mut jobs = Vec::new();
+    for k in 0..state.list.len() {
+        let (shape, arc) = (state.list[k].shape, state.list[k].arc);
+        let front = state.texture(&mut images, shape, arc, true);
+        let flash = state.texture(&mut images, shape, arc, false);
+        jobs.push((k, front, flash));
+    }
+    for (k, front, flash) in jobs {
+        let b = &state.list[k];
+        let t = ((now - b.start) / b.secs.max(1.0e-3)).clamp(0.0, 1.0);
+        let flash_alpha = 0.6 * (1.0 - t / FLASH_SHARE).max(0.0);
+        let front_alpha = if t < RUN_SHARE { 1.0 } else { 1.0 - (t - RUN_SHARE) / (1.0 - RUN_SHARE) };
+        telegraph::push_layer(&mut draw, cam, flash.id(), &b.flash, b.rgb, flash_alpha);
+        telegraph::push_layer(&mut draw, cam, front.id(), &b.front, b.rgb, front_alpha);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_front_is_brightest_at_the_edge_and_gone_behind_it() {
+        assert!(band(1.0) > 0.99);
+        assert!(band(1.0 - BAND * 0.5) > 0.0 && band(1.0 - BAND * 0.5) < band(1.0));
+        assert_eq!(band(1.0 - BAND * 1.5), 0.0);
+        assert_eq!(band(0.2), 0.0);
+    }
+}
