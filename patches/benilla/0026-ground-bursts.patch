+/// An ability's shape flashed on the ground as it lands (`PlayGroundBurst`): at a spot facing a
+/// way (WoW coordinates and facing), the shape's reach and arc (a strip's width), how long the
+/// front takes to run out and fade, and its colour.
+#[derive(Clone, Debug, PartialEq)]
+pub struct GroundBurst {
+    pub at: [f32; 3],
+    pub yaw: f32,
+    pub shape: TeleShape,
+    pub reach: f32,
+    pub arc: f32,
+    pub width: f32,
+    pub secs: f32,
+    pub rgb: [u8; 3],
+}
+
+static BURSTS: std::sync::Mutex<Vec<GroundBurst>> = std::sync::Mutex::new(Vec::new());
+
+/// The ground bursts asked for since the last call.
+pub fn take_ground_bursts() -> Vec<GroundBurst> {
+    BURSTS
+        .lock()
+        .map(|mut v| std::mem::take(&mut *v))
+        .unwrap_or_default()
+}
+
+fn push_burst(b: GroundBurst) {
+    if let Ok(mut v) = BURSTS.lock() {
+        if v.len() < 64 {
+            v.push(b);
+        }
+    }
+}
