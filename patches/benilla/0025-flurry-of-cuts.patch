+/// Clips and takes written `"88/0,87/0,18/1"` (a bare `"88"` is take 0); what won't parse is left
+/// out.
+fn clip_takes(s: &str) -> Vec<(u16, usize)> {
+    s.split(',')
+        .filter_map(|part| {
+            let part = part.trim();
+            if part.is_empty() {
+                return None;
+            }
+            let (clip, take) = part.split_once('/').unwrap_or((part, "0"));
+            Some((clip.trim().parse().ok()?, take.trim().parse().unwrap_or(0)))
+        })
+        .collect()
+}
