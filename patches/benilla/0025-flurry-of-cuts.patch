index 0000000..a03030d
--- /dev/null
+++ b/crates/benilla-app/src/creature_anim/action/flurry.rs
@@ -0,0 +1,239 @@
+//! Basin Battle: a flurry of cuts in turning directions (Bladestorm's Blademaster storm).
+//!
+//! `PlayUnitFlurry` starts one on a unit. The first cut's wind-up is the anticipation: its
+//! draw-back compacted into `windup` seconds. Then cut after cut from the list, each `cut` seconds
+//! long, the body snapping round to face a new way for each (`turn` a step: ahead, right, left,
+//! further right, further left, and round again), each trailing the weapons it holds. When its
+//! time is up, or the unit's clip is stopped (`StopUnitAnimation`: the spin ended early), one
+//! wider finishing sweep (`finish`, over `finish_secs`, its trail hanging longer) as the body
+//! comes back to face ahead. Every cut goes through `PlayUnitAnimation`'s own path (another
+//! model's take, the weapon trail, the body owned against the spell look's own animation), so a
+//! cut is a blow like any of the add-on's.
+
+use benilla_ui::action_combat::{self, ActionBody, ActionCall};
+use bevy::prelude::*;
+
+use super::{ActionTilt, TiltKind};
+
+/// The share of a cut before its blow lands; the rest is its recovery, into the next cut.
+const CUT_LANDS_AT: f32 = 0.45;
+/// The finishing sweep's trail, as a share of a cut's: it hangs in the air as the body settles.
+const FINISH_TRAIL: f32 = 1.8;
+/// A turn snaps round in this long (seconds): the cut starts already facing its way.
+const TURN_SNAP: f32 = 0.07;
+/// The turns, in `turn`s, cut by cut and round again: ahead, right, left, further right, further
+/// left, back left, back right, nearly behind each way, ahead.
+const TURNS: [f32; 10] = [0.0, 1.0, -1.0, 2.0, -2.0, -1.0, 1.0, 2.5, -2.5, 0.0];
+
+enum Phase {
+    Cuts,
+    Finish,
+    /// Over at this time (seconds): the component goes.
+    Done(f32),
+}
+
+/// A flurry under way on a unit.
+#[derive(Component)]
+pub(crate) struct Flurry {
+    /// The unit as the script named it (`"player"`, a guid), for the cuts' own calls.
+    unit: String,
+    from: Option<String>,
+    cuts: Vec<(u16, usize)>,
+    cut: f32,
+    windup: f32,
+    finish: (u16, usize),
+    finish_secs: f32,
+    /// Radians a step.
+    turn: f32,
+    trail: Option<(u32, u32)>,
+    until: f32,
+    /// The next cut is due then.
+    next: f32,
+    i: usize,
+    phase: Phase,
+    /// Told to end: the finish on the next step.
+    ending: bool,
+}
+
+impl Flurry {
+    #[allow(clippy::too_many_arguments)]
+    pub(super) fn new(
+        unit: String,
+        secs: f32,
+        from: Option<String>,
+        cuts: Vec<(u16, usize)>,
+        cut: f32,
+        windup: f32,
+        finish: (u16, usize),
+        finish_secs: f32,
+        turn_degrees: f32,
+        trail: Option<(u32, u32)>,
+        now: f32,
+    ) -> Self {
+        Self {
+            unit,
+            from,
+            cuts,
+            cut: cut.max(0.06),
+            windup: windup.max(0.03),
+            finish,
+            finish_secs: finish_secs.max(0.1),
+            turn: turn_degrees.to_radians(),
+            trail,
+            until: now + secs.max(0.0),
+            next: now,
+            i: 0,
+            phase: Phase::Cuts,
+            ending: false,
+        }
+    }
+
+    /// The spin ended (the clip stopped): the finishing sweep next.
+    pub(super) fn end(&mut self) {
+        self.ending = true;
+    }
+
+    /// One cut (or the finish) through the add-on's own animation path.
+    fn play(&self, (anim, take): (u16, usize), impact: f32, recovery: f32, trail_share: f32) {
+        let trail = self
+            .trail
+            .map(|(c, ms)| (c, ((ms as f32) * trail_share).round().max(50.0) as u32));
+        action_combat::push(ActionCall::Anim {
+            unit: self.unit.clone(),
+            anim,
+            impact,
+            trail,
+            variation: Some(take),
+            recovery,
+            body: ActionBody::Full,
+            from: self.from.clone(),
+        });
+    }
+}
+
+/// The cuts as they fall due, each facing its own way; the finish when the time is up or the
+/// spin was ended; then the component goes.
+pub(super) fn step_flurries(
+    mut commands: Commands,
+    time: Res<Time>,
+    mut units: Query<(Entity, &mut Flurry, &Transform)>,
+    mut tilts: Query<&mut ActionTilt>,
+) {
+    let now = time.elapsed_secs();
+    for (entity, mut f, t) in &mut units {
+        let f = &mut *f;
+        match f.phase {
+            Phase::Done(at) => {
+                if now >= at {
+                    commands.entity(entity).try_remove::<Flurry>();
+                }
+                continue;
+            }
+            Phase::Cuts if now < f.next => continue,
+            Phase::Cuts => {
+                // Room for one more whole cut before the time is up, else the finish now.
+                if !f.ending && now + f.cut <= f.until && !f.cuts.is_empty() {
+                    let cut = f.cuts[f.i % f.cuts.len()];
+                    // The first cut's wind-up is the anticipation: the draw-back, compact.
+                    let impact = if f.i == 0 { f.windup } else { f.cut * CUT_LANDS_AT };
+                    let recovery = f.cut * (1.0 - CUT_LANDS_AT);
+                    f.play(cut, impact, recovery, 1.0);
+                    let yaw = f.turn * TURNS[f.i % TURNS.len()];
+                    let hold = (f.until - now).max(0.0) + f.finish_secs + 1.0;
+                    turn(&mut commands, &mut tilts, entity, t, yaw, TURN_SNAP, hold, now);
+                    f.next = now + impact + recovery;
+                    f.i += 1;
+                    continue;
+                }
+                f.phase = Phase::Finish;
+            }
+            Phase::Finish => {}
+        }
+        // The finish: one wider sweep, facing ahead again as it goes.
+        let impact = f.finish_secs * CUT_LANDS_AT;
+        f.play(f.finish, impact, f.finish_secs - impact, FINISH_TRAIL);
+        turn(
+            &mut commands,
+            &mut tilts,
+            entity,
+            t,
+            0.0,
+            f.finish_secs,
+            f.finish_secs + 0.1,
+            now,
+        );
+        f.phase = Phase::Done(now + f.finish_secs + 0.1);
+    }
+}
+
+/// Face `to` radians off the unit's own facing, from wherever the body is turned now, over
+/// `over` seconds, held for `secs` (then the animated pose comes back).
+#[allow(clippy::too_many_arguments)]
+fn turn(
+    commands: &mut Commands,
+    tilts: &mut Query<&mut ActionTilt>,
+    entity: Entity,
+    t: &Transform,
+    to: f32,
+    over: f32,
+    secs: f32,
+    now: f32,
+) {
+    let from = tilts
+        .get(entity)
+        .ok()
+        .and_then(|cur| cur.turn_now(now))
+        .unwrap_or(0.0);
+    let tilt = ActionTilt {
+        kind: TiltKind::Turn { from, to, over },
+        asked: now,
+        start: Some(now),
+        secs,
+        from: t.translation,
+        axis: Some(Vec3::Y),
+        bones: Vec::new(),
+    };
+    match tilts.get_mut(entity) {
+        // A tumble under way keeps itself.
+        Ok(cur) if matches!(cur.kind, TiltKind::Roll { .. }) => {}
+        Ok(mut cur) => {
+            let bones = std::mem::take(&mut cur.bones);
+            *cur = ActionTilt { bones, ..tilt };
+        }
+        Err(_) => {
+            commands.entity(entity).try_insert(tilt);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_turns_go_both_ways_and_come_back_ahead() {
+        assert_eq!(TURNS[0], 0.0);
+        assert!(TURNS.iter().any(|t| *t > 0.0) && TURNS.iter().any(|t| *t < 0.0));
+        assert_eq!(TURNS[TURNS.len() - 1], 0.0);
+    }
+
+    #[test]
+    fn a_flurry_fits_its_cuts_into_its_time_then_finishes() {
+        let f = Flurry::new(
+            "player".into(),
+            1.0,
+            None,
+            vec![(17, 0), (18, 1)],
+            0.14,
+            0.15,
+            (88, 0),
+            0.25,
+            70.0,
+            Some((0xC8E8F0FF, 220)),
+            10.0,
+        );
+        assert_eq!(f.until, 11.0);
+        assert!(matches!(f.phase, Phase::Cuts));
+        assert!((f.turn - 70.0f32.to_radians()).abs() < 1.0e-6);
+    }
+}
