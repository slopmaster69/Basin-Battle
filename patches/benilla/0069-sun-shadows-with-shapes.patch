+/// `lookshadow map`'s pipeline, one a target format, its layout, shader and uniform
+/// (`look_shadow_map.wgsl`'s `MapView`: `[inset x, y, side, slice]`, `[texels a side, yards a unit
+/// of depth, the camera's texel]`).
+#[derive(Resource)]
+struct MapViewPipelines {
+    layout: BindGroupLayoutDescriptor,
+    shader: Handle<Shader>,
+    uniform: Buffer,
+    by_format: HashMap<TextureFormat, CachedRenderPipelineId>,
+}
+
+const MAP_VIEW_BYTES: u64 = 32;
+
+fn init_map_view(mut commands: Commands, device: Res<RenderDevice>, assets: Res<AssetServer>) {
+    commands.insert_resource(MapViewPipelines {
+        layout: BindGroupLayoutDescriptor::new(
+            "look_shadow_map_view",
+            &BindGroupLayoutEntries::sequential(
+                ShaderStages::FRAGMENT,
+                (
+                    texture_2d_array(TextureSampleType::Depth),
+                    uniform_buffer_sized(false, std::num::NonZero::new(MAP_VIEW_BYTES)),
+                ),
+            ),
+        ),
+        shader: assets.load("embedded://benilla_world/shaders/look_shadow_map.wgsl"),
+        uniform: device.create_buffer(&BufferDescriptor {
+            label: Some("look_shadow_map_view"),
+            size: MAP_VIEW_BYTES,
+            usage: BufferUsages::UNIFORM | BufferUsages::COPY_DST,
+            mapped_at_creation: false,
+        }),
+        by_format: HashMap::default(),
+    });
+}
+
+/// Queues the inset's pipeline for each look view's target format, once, when it is asked for.
+fn prepare_map_view(
+    frame: Res<ShadowFrame>,
+    mut pipes: ResMut<MapViewPipelines>,
+    cache: Res<PipelineCache>,
+    views: Query<&bevy::render::view::ViewTarget, With<LookView>>,
+) {
+    if frame.map.is_none() {
+        return;
+    }
+    let pipes = &mut *pipes;
+    for target in &views {
+        let format = target.main_texture_format();
+        if pipes.by_format.contains_key(&format) {
+            continue;
+        }
+        let id = cache.queue_render_pipeline(RenderPipelineDescriptor {
+            label: Some("look_shadow_map_view".into()),
+            layout: vec![pipes.layout.clone()],
+            vertex: VertexState {
+                shader: pipes.shader.clone(),
+                shader_defs: vec![],
+                entry_point: Some("vs_main".into()),
+                buffers: vec![],
+            },
+            fragment: Some(FragmentState {
+                shader: pipes.shader.clone(),
+                shader_defs: vec![],
+                entry_point: Some("fs_main".into()),
+                targets: vec![Some(ColorTargetState {
+                    format,
+                    blend: None,
+                    write_mask: ColorWrites::ALL,
+                })],
+            }),
+            ..default()
+        });
+        pipes.by_format.insert(format, id);
+    }
+}
+
+/// The inset's place in a `width` × `height` frame: `[x, y, side]`, top right, a margin in.
+fn map_view_rect(width: f32, height: f32) -> [f32; 3] {
+    let side = (tune::MAP_INSET * height)
+        .min(width * 0.5)
+        .floor()
+        .max(16.0);
+    let margin = (0.02 * height).floor();
+    [(width - side - margin).max(0.0), margin, side]
+}
