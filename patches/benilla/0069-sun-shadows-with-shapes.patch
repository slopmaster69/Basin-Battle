+            ("the hero's torso", feet, 1.2, 0.2),
+            ("the hero's head", feet, 1.72, 0.35),
+            ("the hero's leg", feet + Vec3::X * 0.1, 0.45, 0.35),
+            ("the pumpkin", pumpkin + Vec3::new(0.2, 0.0, 0.2), 0.3, 0.2),
+        ] {
+            let under = receive(&rows, 0, shade_of(p, h), Vec3::Y, &map, true);
+            assert!(
+                (0.0..=most).contains(&under),
+                "{name}'s shadow, {level}, sun {deg}°: reads {under} lit"
+            );
+        }
+        // Beside each, clear of it and its shadow along the light's level axis.
+        for (name, p, h) in [("the hero", feet, 1.2), ("the pumpkin", pumpkin, 0.3)] {
+            let beside = shade_of(p, h) - f.right * 0.9;
+            let lit = receive(&rows, 0, beside, Vec3::Y, &map, true);
+            assert!(
+                lit > 0.9,
+                "beside {name}'s shadow, {level}, sun {deg}°: reads {lit} lit"
+            );
+        }
+    }
