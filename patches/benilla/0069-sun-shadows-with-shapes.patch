+                    uniform_buffer_sized(false, std::num::NonZero::new(MAP_VIEW_BYTES)),
+                ),
+            ),
+        ),
+        shader: assets.load("embedded://benilla_world/shaders/look_shadow_map.wgsl"),
+        uniform: device.create_buffer(&BufferDescriptor {
+            label: Some("look_shadow_map_view"),
+            size: MAP_VIEW_BYTES,
+            usage: BufferUsages::UNIFORM | BufferUsages::COPY_DST,
+            mapped_at_creation: false,
+        }),
+        by_format: HashMap::default(),
+    });
+}
+
+/// Queues the inset's pipeline for each look view's target format, once, when it is asked for.
+fn prepare_map_view(
+    frame: Res<ShadowFrame>,
+    mut pipes: ResMut<MapViewPipelines>,
+    cache: Res<PipelineCache>,
+    views: Query<&bevy::render::view::ViewTarget, With<LookView>>,
+) {
+    if frame.map.is_none() {
+        return;
+    }
+    let pipes = &mut *pipes;
+    for target in &views {
+        let format = target.main_texture_format();
+        if pipes.by_format.contains_key(&format) {
+            continue;
+        }
+        let id = cache.queue_render_pipeline(RenderPipelineDescriptor {
+            label: Some("look_shadow_map_view".into()),
+            layout: vec![pipes.layout.clone()],
+            vertex: VertexState {
+                shader: pipes.shader.clone(),
+                shader_defs: vec![],
+                entry_point: Some("vs_main".into()),
+                buffers: vec![],
+            },
+            fragment: Some(FragmentState {
+                shader: pipes.shader.clone(),
+                shader_defs: vec![],
+                entry_point: Some("fs_main".into()),
+                targets: vec![Some(ColorTargetState {
+                    format,
+                    blend: None,
+                    write_mask: ColorWrites::ALL,
+                })],
+            }),
+            ..default()
+        });
+        pipes.by_format.insert(format, id);
+    }
+}
