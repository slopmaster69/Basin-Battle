+/// Why a model material casts no shadow, `None` when it casts (whatever its cut): the reasons
+/// [`caster_law`] refuses, in the words `WOW_SHADOW_STATS` prints for a mesh left out.
+fn no_cast_reason(
+    alpha_mode: AlphaMode,
+    texture: Option<AssetId<Image>>,
+    clutter_fade: Vec4,
+    model_flags: Vec4,
+    sun_scale: Vec4,
+) -> Option<&'static str> {
+    let markers = clutter_fade.z as u32;
+    let blended = matches!(alpha_mode, AlphaMode::Blend);
+    Some(if clutter_fade.w > 0.5 {
+        "ground clutter"
+    } else if markers & NO_CAST_MARKERS != 0 {
+        if markers & 2 != 0 {
+            "no depth test"
+        } else if markers & 4 != 0 {
+            "additive"
+        } else if markers & (0x80 | 0x100) != 0 {
+            "multiply (Mod/Mod2x)"
+        } else if markers & 0x200 != 0 {
+            "depth-prime twin"
+        } else if markers & 0x800 != 0 {
+            "far side of water (the near copy casts)"
+        } else {
+            "sky"
+        }
+    // A fade twin is blended for its fade alone: it casts as its source would.
+    } else if markers & NO_DEPTH_WRITE_MARKER != 0 && (!blended || model_flags.y > 0.5) {
+        "no depth write"
+    // `model_flags.x` a WMO surface, `.z` an interior group or a prop inside one (an entity on
+    // the interior-bake lane: its light law says it stands in a room).
+    } else if model_flags.z > 0.5 && model_flags.x <= 0.5 {
+        "indoors (interior-prop lane)"
+    } else if sun_scale.x >= 1.5 {
+        "authored light rig (a booth)"
+    } else if blended && model_flags.y <= 0.5 && texture.is_none() {
+        "blended, untextured"
+    } else if !matches!(
+        alpha_mode,
+        AlphaMode::Opaque | AlphaMode::Mask(_) | AlphaMode::Blend
+    ) {
+        "alpha mode"
+    } else {
+        return None;
+    })
+}
