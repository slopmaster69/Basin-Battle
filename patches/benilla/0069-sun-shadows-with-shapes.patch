+fn map_view_rect(width: f32, height: f32) -> [f32; 3] {
+    let side = (tune::MAP_INSET * height)
+        .min(width * 0.5)
+        .floor()
+        .max(16.0);
+    let margin = (0.02 * height).floor();
+    [(width - side - margin).max(0.0), margin, side]
+}
