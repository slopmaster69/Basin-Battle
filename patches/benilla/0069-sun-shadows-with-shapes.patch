+    /// `world_shadow.wgsl`'s `slice_clip` and the viewport, read from the pass's own uniform
+    /// ([`slice_rows`]) as the vertex stage reads it: a caster point's texel and stored depth in
+    /// slice `c`.
+    fn cast(rows: &[f32], c: usize, res: f32, p: Vec3) -> (Vec2, f32) {
+        let r = &rows[c * (SLICE_STRIDE / 4) as usize..];
+        let v = |i: usize| Vec3::new(r[i], r[i + 1], r[i + 2]);
+        let d = p - v(0);
+        let x = d.dot(v(8)) * r[3];
+        let y = d.dot(v(12)) * r[3];
+        let z = ((d.dot(v(16)) - r[4]) * r[5]).max(0.0);
+        (Vec2::new((x + 1.0) * 0.5 * res, (1.0 - y) * 0.5 * res), z)
+    }
+
+    /// The receivers' `shadow_slice` (`terrain.wgsl`, mirrored in `wow_model.wgsl` and
+    /// `static_gx.wgsl`), read from the light buffer's packed rows ([`pack_rows`]) as the fragment
+    /// stage reads them, over a map given texel by texel; `fixed` off reads as 0065 shipped (no
+    /// centre tap in the blocker search). Disk turn 0. -1 outside the slice.
+    fn receive(
+        rows: &[[f32; 4]; SHADOW_ROWS],
+        c: usize,
+        p: Vec3,
+        n: Vec3,
+        map: &dyn Fn(IVec2) -> f32,
+        fixed: bool,
+    ) -> f32 {
+        let v = |row: usize| Vec3::new(rows[row][0], rows[row][1], rows[row][2]);
+        let (centre, depth) = (rows[6 + 2 * c], rows[7 + 2 * c]);
+        let res = rows[2][3];
+        let travel = v(4);
+        let facing = n.dot(-travel).clamp(0.0, 1.0);
+        let push = depth[2] * rows[4][3] * (1.0 - 0.5 * facing);
+        let d = (p + n * push) - Vec3::new(centre[0], centre[1], centre[2]);
+        let uv = Vec2::new(d.dot(v(2)), -d.dot(v(3))) * (0.5 * centre[3]) + Vec2::splat(0.5);
+        if uv.min_element() < 0.0 || uv.max_element() > 1.0 {
+            return -1.0;
+        }
+        let z = (d.dot(travel) - depth[0]) * depth[1] - depth[2] * rows[5][3] * depth[1];
+        let t = uv * res;
+        let lim = res as i32 - 1;
+        let at = |q: IVec2| map(q.clamp(IVec2::ZERO, IVec2::splat(lim)));
+        let disk = |i: u32, n: u32| {
+            let r = ((i as f32 + 0.5) / n as f32).sqrt();
+            let a = i as f32 * 2.399_963_2;
+            Vec2::new(a.cos(), a.sin()) * r
+        };
+        let tap = |q: Vec2, z: f32| {
+            let f = q - Vec2::splat(0.5);
+            let i = f.floor();
+            let w = f - i;
+            let c = i.as_ivec2();
+            let s = |o: IVec2| if z <= at(c + o) { 1.0 } else { 0.0 };
+            let top = s(IVec2::ZERO) * (1.0 - w.x) + s(IVec2::X) * w.x;
+            let bottom = s(IVec2::Y) * (1.0 - w.x) + s(IVec2::ONE) * w.x;
+            top * (1.0 - w.y) + bottom * w.y
+        };
+        let (mut radius, mut taps) = (tune::PCF_LOW_TEXELS, 6u32);
+        if rows[3][3] > 0.5 {
+            let search = (tune::BLOCKER_SEARCH / depth[2]).max(1.0);
+            let (mut sum, mut n) = (0.0, 0.0);
+            let s0 = at(t.as_ivec2());
+            if fixed && s0 < z {
+                sum += s0;
+                n += 1.0;
+            }
+            for i in 0..6 {
+                let o = disk(i, 6) * search;
+                let s = at((t + o).as_ivec2());
+                if s < z {
+                    sum += s;
+                    n += 1.0;
+                }
+            }
+            if n < 0.5 {
+                return 1.0;
+            }
+            let gap = (z - sum / n) / depth[1];
+            radius =
+                (gap * tune::PENUMBRA / depth[2]).clamp(tune::PCF_MIN_TEXELS, tune::PCF_MAX_TEXELS);
+            taps = 10;
+        }
+        let mut lit = 0.0;
+        for i in 0..taps {
+            lit += tap(t + disk(i, taps) * radius, z);
+        }
+        lit / taps as f32
+    }
