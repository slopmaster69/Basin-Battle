+/// A model caster's bounding sphere. A plain mesh: its box under its transform. A skinned part
+/// (`rig_origin`, its slot's origin, the point its palette draws it from): the palette replaces
+/// its world matrix, so its sphere sits on the rig, as wide as its bind-pose box plus
+/// [`tune::SKINNED_MARGIN`] for a swing; a part with no box at all (gear and riders carry
+/// `NoFrustumCulling`, so Bevy gives them none) is held to [`tune::SKINNED_LOOSE_RADIUS`].
+/// `None` for a plain mesh with no box yet (still loading).
+fn caster_bound(
+    gt: &GlobalTransform,
+    aabb: Option<&Aabb>,
+    rig_origin: Option<Vec3>,
+) -> Option<(Vec3, f32)> {
+    match (rig_origin, aabb) {
+        (None, aabb) => Some(bounding_sphere(gt, aabb?)),
+        (Some(o), Some(aabb)) => {
+            let (center, radius) = bounding_sphere(gt, aabb);
+            // The box's centre as far off the part's own origin as it is in the bind pose.
+            let lift = center - gt.translation();
+            Some((o + lift, radius + tune::SKINNED_MARGIN))
+        }
+        (Some(o), None) => Some((o, tune::SKINNED_LOOSE_RADIUS + tune::SKINNED_MARGIN)),
+    }
+}
