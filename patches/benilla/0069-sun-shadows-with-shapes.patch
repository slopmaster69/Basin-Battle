+    /// The test the first films asked for: a caster point drawn through the pass's uniform and a
+    /// receiver on the ground under it read through the light buffer's rows land on the same
+    /// texel, and the receiver reads shadowed while a point well beside it reads lit, in every
+    /// slice, on low and on high, the sun high and low. A transpose, a flipped row, a slice off by
+    /// one, a texel-snap mismatch or a flipped depth between the two packings fails here.
+    #[test]
+    fn a_caster_shades_the_ground_under_it_and_not_beside_it() {
+        for (cascades, res) in [(2, 1024), (4, 2048)] {
+            for deg in [57.0, 30.0, 12.0] {
+                let f = field_frame(deg, cascades, res);
+                let (cast_rows, rows) = (slice_rows(&f), pack_rows(&f));
+                for c in 0..cascades {
+                    // A point 1.5 yd up near the middle of the slice, and where its shadow falls on
+                    // the ground (y 60) along the light.
+                    let mid = f.slices[c].center;
+                    let caster = Vec3::new(mid.x, 61.5, mid.z);
+                    let ground = caster + f.travel * (1.5 / -f.travel.y);
+                    let (texel, z) = cast(&cast_rows, c, f.res as f32, caster);
+                    // The receiver's own reading of the same texel.
+                    let want = super::super::shadows::caster_texel(&f, c, caster).unwrap();
+                    assert!((want.0 - texel).length() < 1e-2 && (want.1 - z).abs() < 1e-5);
+                    // The map: the caster (a blob 25 texels square, a quarter yard on high's
+                    // first slice: a post's top), cleared elsewhere.
+                    let blob = texel.as_ivec2();
+                    let map = |q: IVec2| {
+                        if (q - blob).abs().max_element() <= 12 {
+                            z
+                        } else {
+                            1.0
+                        }
+                    };
+                    let what = format!("slice {c} of {cascades}, sun {deg}°");
+                    let under = receive(&rows, c, ground, Vec3::Y, &map, true);
+                    assert!(
+                        under >= 0.0 && under < 0.05,
+                        "{what}: the shadow reads {under}"
+                    );
+                    if cascades > 2 && c == 0 {
+                        // 0065's high: the blocker search's ring of taps, the nearest 0.17 yd
+                        // out, fell beside a caster this small, and the shadow read lit.
+                        let shipped = receive(&rows, c, ground, Vec3::Y, &map, false);
+                        assert!(shipped > 0.95, "{what}: 0065 read {shipped}");
+                    }
+                    // Clear of the blob and the widest filter (10 texels).
+                    let beside = ground + f.right * (40.0 * f.slices[c].texel).max(1.0);
+                    let lit = receive(&rows, c, beside, Vec3::Y, &map, true);
+                    assert!(lit > 0.95, "{what}: beside the shadow reads {lit}");
+                }
+                if deg >= 30.0 {
+                    a_hero_and_a_pumpkin_cast(&f, deg);
+                }
+            }
+        }
