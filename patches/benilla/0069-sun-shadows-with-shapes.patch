+
+    fn run<'w>(
+        &self,
+        _graph: &mut RenderGraphContext,
+        render_context: &mut RenderContext<'w>,
+        (target, _): QueryItem<'w, '_, Self::ViewQuery>,
+        world: &'w World,
+    ) -> Result<(), NodeRunError> {
+        let frame = world.resource::<ShadowFrame>();
+        let Some(slice) = frame.map.map(usize::from) else {
+            return Ok(());
+        };
+        if slice >= frame.cascades {
+            return Ok(());
+        }
+        let pipes = world.resource::<MapViewPipelines>();
+        let cache = world.resource::<PipelineCache>();
+        let images = world.resource::<RenderAssets<GpuImage>>();
+        let (Some(pipeline), Some(map)) = (
+            pipes
+                .by_format
+                .get(&target.main_texture_format())
+                .and_then(|id| cache.get_render_pipeline(*id)),
+            images.get(SHADOW_MAP.id()),
+        ) else {
+            return Ok(());
+        };
+        let size = target.main_texture().size();
+        let [x, y, side] = map_view_rect(size.width as f32, size.height as f32);
+        let cam = super::shadows::caster_texel(frame, slice, frame.cam)
+            .map_or(Vec2::splat(-1.0e6), |(t, _)| t);
+        let row: [f32; 8] = [
+            x,
+            y,
+            side,
+            slice as f32,
+            frame.res as f32,
+            frame.slices[slice].range,
+            cam.x,
+            cam.y,
+        ];
+        world
+            .resource::<RenderQueue>()
+            .write_buffer(&pipes.uniform, 0, bytemuck::cast_slice(&row));
+        let bind = render_context.render_device().create_bind_group(
+            "look_shadow_map_view",
+            &cache.get_bind_group_layout(&pipes.layout),
+            &BindGroupEntries::sequential((&map.texture_view, pipes.uniform.as_entire_binding())),
+        );
+        let mut pass = render_context.begin_tracked_render_pass(RenderPassDescriptor {
+            label: Some("look_shadow_map_view"),
+            color_attachments: &[Some(RenderPassColorAttachment {
+                view: target.main_texture_view(),
+                depth_slice: None,
+                resolve_target: None,
+                ops: Operations {
+                    load: LoadOp::Load,
+                    store: StoreOp::Store,
+                },
+            })],
+            depth_stencil_attachment: None,
+            timestamp_writes: None,
+            occlusion_query_set: None,
+        });
+        pass.set_viewport(x, y, side, side, 0.0, 1.0);
+        pass.set_render_pipeline(pipeline);
+        pass.set_bind_group(0, &bind, &[]);
+        pass.draw(0..3, 0..1);
+        Ok(())
+    }
