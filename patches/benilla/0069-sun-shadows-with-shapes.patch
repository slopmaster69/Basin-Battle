+                let bias = (tune::RASTER_CONSTANT_BIAS as f32) / 65536.0
+                    + tune::RASTER_SLOPE_BIAS * slope * s.texel / s.range;
+                let map = |q: IVec2| {
+                    let x = (q.x as f32 + 0.5) / f.res as f32 * 2.0 - 1.0;
+                    let y = 1.0 - (q.y as f32 + 0.5) / f.res as f32 * 2.0;
+                    let o = s.center + (f.right * x + f.up * y) * s.half;
+                    let along = (ground_y - o.y) / f.travel.y;
+                    let at = (o + f.travel * along - s.center).dot(f.travel);
+                    ((at - s.near) / s.range + bias).clamp(0.0, 1.0)
