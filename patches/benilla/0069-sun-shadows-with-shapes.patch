+    /// The second films' two: a 2 yd hero in full sun read faint and very soft on high, and the
+    /// Brackwell pumpkins cast nothing (an alpha-blended batch; [`which_batches_cast`] holds the
+    /// law). Here both stand on flat ground in the first slice, the map holding them and the
+    /// ground as the pass draws them (each texel's ray along the light to the first surface, the
+    /// raster's slope bias on it), read through the receivers' own filter: under the hero's
+    /// torso, head and a leg, and under the pumpkin, the ground reads shadowed (at most a fifth to
+    /// a third lit), and beside them lit. With 0065's penumbra (0.035) the head's and the leg's
+    /// shadows were all penumbra on high and read about half lit.
+    fn a_hero_and_a_pumpkin_cast(f: &ShadowFrame, deg: f32) {
+        let s = f.slices[0];
+        let rows = pack_rows(f);
+        let ground_y = 60.0;
+        // The hero 5 yd in front of the camera, the pumpkin 2.5 yd to their right.
+        let feet = Vec3::new(f.cam.x, ground_y, f.cam.z - 5.0);
+        let pumpkin = feet + Vec3::new(2.5, 0.0, 0.0);
+        let at = |o: Vec3, lo: [f32; 3], hi: [f32; 3]| (o + Vec3::from(lo), o + Vec3::from(hi));
+        let boxes = [
+            // Legs, torso, head, arms (x across, y up, z through).
+            at(feet, [-0.17, 0.0, -0.07], [-0.03, 0.9, 0.07]),
+            at(feet, [0.03, 0.0, -0.07], [0.17, 0.9, 0.07]),
+            at(feet, [-0.22, 0.9, -0.12], [0.22, 1.55, 0.12]),
+            at(feet, [-0.11, 1.6, -0.1], [0.11, 1.85, 0.1]),
+            at(feet, [-0.32, 0.85, -0.05], [-0.23, 1.5, 0.05]),
+            at(feet, [0.23, 0.85, -0.05], [0.32, 1.5, 0.05]),
+            at(pumpkin, [-0.3, 0.0, -0.3], [0.3, 0.45, 0.3]),
+        ];
+        let e = (-f.travel.y).asin();
+        let slope = e.tan().recip().max(e.tan());
+        let bias = (tune::RASTER_CONSTANT_BIAS as f32) / 65536.0
+            + tune::RASTER_SLOPE_BIAS * slope * s.texel / s.range;
+        let map = |q: IVec2| {
+            let x = (q.x as f32 + 0.5) / f.res as f32 * 2.0 - 1.0;
+            let y = 1.0 - (q.y as f32 + 0.5) / f.res as f32 * 2.0;
+            // The texel's ray along the light, from the slice's centre plane.
+            let o = s.center + (f.right * x + f.up * y) * s.half;
+            let mut hit = (ground_y - o.y) / f.travel.y;
+            for (lo, hi) in &boxes {
+                let (mut enter, mut leave) = (f32::MIN, f32::MAX);
+                for k in 0..3 {
+                    let (d, p) = (f.travel[k], o[k]);
+                    if d.abs() < 1e-6 {
+                        if p < lo[k] || p > hi[k] {
+                            leave = f32::MIN;
+                        }
+                        continue;
+                    }
+                    let (a, b) = ((lo[k] - p) / d, (hi[k] - p) / d);
+                    enter = enter.max(a.min(b));
+                    leave = leave.min(a.max(b));
+                }
+                if enter <= leave {
+                    hit = hit.min(enter);
+                }
+            }
