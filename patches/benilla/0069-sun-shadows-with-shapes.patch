+    fn the_ground_does_not_shade_itself_under_a_low_sun() {
+        for (cascades, res) in [(2, 1024), (4, 2048)] {
+            let f = field_frame(3.0, cascades, res);
+            let rows = pack_rows(&f);
+            for c in 0..cascades {
+                let s = f.slices[c];
+                let ground_y = 60.0;
+                // The map holds the ground: each texel's depth where its ray meets y = 60, plus
+                // the raster's slope bias (the ground climbs cot(e) texels of depth a texel).
+                let slope = (-f.travel.y).asin().tan().recip();
+                let bias = (tune::RASTER_CONSTANT_BIAS as f32) / 65536.0
+                    + tune::RASTER_SLOPE_BIAS * slope * s.texel / s.range;
+                let map = |q: IVec2| {
+                    let x = (q.x as f32 + 0.5) / f.res as f32 * 2.0 - 1.0;
+                    let y = 1.0 - (q.y as f32 + 0.5) / f.res as f32 * 2.0;
+                    let o = s.center + (f.right * x + f.up * y) * s.half;
+                    let along = (ground_y - o.y) / f.travel.y;
+                    let at = (o + f.travel * along - s.center).dot(f.travel);
+                    ((at - s.near) / s.range + bias).clamp(0.0, 1.0)
+                };
+                let p = Vec3::new(s.center.x, ground_y, s.center.z);
