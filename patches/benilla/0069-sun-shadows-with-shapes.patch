new file mode 100644
index 0000000..d0bd179
--- /dev/null
+++ b/crates/benilla-world/src/shaders/look_shadow_map.wgsl
@@ -0,0 +1,59 @@
+// `lookshadow map <slice>` (`look::shadow_pass::LookShadowMapNode`), benilla's own debug view: one
+// slice of the new look's sun-shadow map drawn into a square in the top-right corner of the frame,
+// so a film shows what the casters left in it. The world as the light sees it: the terrain in grey
+// bands every 8 yd of depth along the light, a caster outlined bright where the depth jumps (its
+// silhouette), dark blue where nothing was drawn, the camera a red dot. Never under any setting a
+// player uses.
+
+struct MapView {
+    // xy the inset's top-left pixel, z its side in pixels, w the slice (the map's layer).
+    rect: vec4<f32>,
+    // x the slice's texels a side, y its yards per unit of depth, zw the camera's texel.
+    info: vec4<f32>,
+}
+@group(0) @binding(0) var shadow_map: texture_depth_2d_array;
+@group(0) @binding(1) var<uniform> view: MapView;
+
+// One triangle over the viewport, which the node sets to the inset.
+@vertex
+fn vs_main(@builtin(vertex_index) i: u32) -> @builtin(position) vec4<f32> {
+    let uv = vec2<f32>(f32((i << 1u) & 2u), f32(i & 2u));
+    return vec4<f32>(uv * 2.0 - 1.0, 0.0, 1.0);
+}
+
+fn map_depth(c: vec2<i32>, layer: i32, lim: i32) -> f32 {
+    return textureLoad(shadow_map, clamp(c, vec2<i32>(0), vec2<i32>(lim)), layer, 0);
+}
+
+@fragment
+fn fs_main(@builtin(position) pos: vec4<f32>) -> @location(0) vec4<f32> {
+    let local = (pos.xy - view.rect.xy) / view.rect.z;
+    let px = 2.0 / view.rect.z;
+    if (any(local < vec2<f32>(px)) || any(local > vec2<f32>(1.0 - px))) {
+        return vec4<f32>(1.0, 0.85, 0.3, 1.0); // the frame
+    }
+    let res = view.info.x;
+    let t = local * res;
+    if (distance(t, view.info.zw) < res * 0.012) {
+        return vec4<f32>(1.0, 0.1, 0.1, 1.0); // the camera
+    }
+    let lim = i32(res) - 1;
+    let layer = i32(view.rect.w);
+    let c = vec2<i32>(t);
+    let d = map_depth(c, layer, lim);
+    if (d >= 0.99998) {
+        return vec4<f32>(0.04, 0.07, 0.22, 1.0); // cleared: no caster here
+    }
+    // A screen pixel spans several texels: measure the jumps across its footprint. The second
+    // difference is zero on any plane, sloped or not, so the ground stays quiet and only a
+    // caster's edge (a step in depth) lights.
+    let s = max(i32(res / view.rect.z), 1);
+    let sx = vec2<i32>(s, 0);
+    let sy = vec2<i32>(0, s);
+    let jx = map_depth(c + sx, layer, lim) - 2.0 * d + map_depth(c - sx, layer, lim);
+    let jy = map_depth(c + sy, layer, lim) - 2.0 * d + map_depth(c - sy, layer, lim);
+    let jump = max(abs(jx), abs(jy)) * view.info.y;
+    let edge = smoothstep(0.3, 1.0, jump);
+    let band = 0.28 + 0.32 * fract(d * view.info.y / 8.0);
+    return vec4<f32>(mix(vec3<f32>(band), vec3<f32>(1.0, 0.95, 0.65), edge), 1.0);
+}
