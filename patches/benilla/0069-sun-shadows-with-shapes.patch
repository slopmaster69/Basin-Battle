+
+/// One mesh of `WOW_SHADOW_STATS`' near list: its distance, the verdict, what spawned it and its
+/// 1.12 blend, the material's alpha mode, marker word and flags (WMO, fade twin, interior lane,
+/// unlit), its shade selector, and its texture's path, which names the model's own folder.
+fn near_line(
+    d: f32,
+    verdict: &str,
+    part: Option<&crate::model_render::ModelPart>,
+    material: Option<&WowModelMaterial>,
+    assets: Option<&AssetServer>,
+) -> String {
+    let what = part.map_or("?".to_string(), |p| format!("{:?} {:?}", p.kind, p.blend));
+    let Some(m) = material else {
+        return format!("{d:5.1} yd  {verdict}  [{what}]");
+    };
+    let e = &m.extension;
+    let mode = match m.base.alpha_mode {
+        AlphaMode::Opaque => "opaque",
+        AlphaMode::Mask(_) => "mask",
+        AlphaMode::Blend => "blend",
+        _ => "other",
+    };
+    let tex = m
+        .base
+        .base_color_texture
+        .as_ref()
+        .and_then(|h| assets.and_then(|a| a.get_path(h.id())))
+        .map_or_else(|| "untextured".to_string(), |p| p.to_string());
+    format!(
+        "{d:5.1} yd  {verdict}  [{what}, {mode}, markers {:#x}, flags {:.0}{:.0}{:.0}{:.0}, \
+         shade {:.1}]  {tex}",
+        e.clutter_fade.z as u32,
+        e.model_flags.x,
+        e.model_flags.y,
+        e.model_flags.z,
+        e.model_flags.w,
+        e.sun_scale.x
+    )
+}
