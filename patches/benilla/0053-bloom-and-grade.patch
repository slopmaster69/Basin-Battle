+++ b/crates/benilla-world/src/look/pass.rs
@@ -0,0 +1,475 @@
+//! The new look's full-screen pass and bloom, benilla's own (no reference behaviour): a colour
+//! grade in linear light (white balance, contrast, saturation) from the zone grade's current
+//! values ([`super::LookGrade`]), and Bevy's own `Bloom` on the world camera, all on the camera
+//! marked [`LookView`] and only under the new look.
+//!
+//! The pass runs between `StartMainPassPostProcessing` and the FFXGlow node. The world camera's
+//! main texture still holds the gamma bytes there (its combine, the frame's one decode, is the
+//! player-UI camera's ground draw: `crate::ffx_glow::FfxBackdrop`), so the pass decodes, grades in
+//! linear and encodes back; the 1.12 glow then blurs the graded frame, and every combine path reads
+//! it. Bloom (Bevy's node, after the glow) adds into the same gamma frame.
+
+use bevy::core_pipeline::core_3d::graph::{Core3d, Node3d};
+use bevy::core_pipeline::FullscreenShader;
+use bevy::ecs::query::QueryItem;
+use bevy::post_process::bloom::{Bloom, BloomCompositeMode, BloomPrefilter};
+use bevy::prelude::*;
+use bevy::render::diagnostic::RecordDiagnostics;
+use bevy::render::extract_component::{ExtractComponent, ExtractComponentPlugin};
+use bevy::render::extract_resource::{ExtractResource, ExtractResourcePlugin};
+use bevy::render::render_graph::{
+    NodeRunError, RenderGraphContext, RenderGraphExt, RenderLabel, ViewNode, ViewNodeRunner,
+};
+use bevy::render::render_resource::binding_types::{texture_2d, uniform_buffer_sized};
+use bevy::render::render_resource::*;
+use bevy::render::renderer::{RenderContext, RenderDevice, RenderQueue};
+use bevy::render::view::ViewTarget;
+use bevy::render::{Render, RenderApp, RenderStartup, RenderSystems};
+
+use super::{LookGrade, PostLook, WorldLook};
+
+/// The camera the new look's pass and bloom run on: the game's world camera.
+#[derive(Component, Clone, Copy, Default, ExtractComponent)]
+pub struct LookView;
+
+/// What the render world needs of the look this frame, copied from the lighting resolve's grade
+/// (never a second clock).
+#[derive(Resource, Clone, Copy, Default, Debug, PartialEq, ExtractResource)]
+pub struct LookFrame {
+    /// The new look is on (`worldLook 1`).
+    pub on: bool,
+    /// The grade's post values at the zone weight; neutral outside a graded zone.
+    pub post: PostLook,
+}
+
+impl LookFrame {
+    /// Whether the pass has anything to do: off, or neutral, it does not run at all.
+    pub fn grades(&self) -> bool {
+        self.on && !self.post.is_neutral()
+    }
+}
+
+fn publish_frame(look: Res<WorldLook>, grade: Res<LookGrade>, mut frame: ResMut<LookFrame>) {
+    let next = LookFrame {
+        on: look.on,
+        post: if look.on {
+            grade.post
+        } else {
+            PostLook::NEUTRAL
+        },
+    };
+    if *frame != next {
+        *frame = next;
+    }
+}
+
+/// The bloom prefilter: the frame is still 0..1 gamma here, so only the brightest parts (the sun,
+/// spells, lit windows) pass it.
+const BLOOM_THRESHOLD: f32 = 0.8;
+const BLOOM_SOFTNESS: f32 = 0.3;
+
+/// The new look's bloom at `intensity`: additive, with the prefilter above.
+pub fn look_bloom(intensity: f32) -> Bloom {
+    Bloom {
+        intensity,
+        composite_mode: BloomCompositeMode::Additive,
+        prefilter: BloomPrefilter {
+            threshold: BLOOM_THRESHOLD,
+            threshold_softness: BLOOM_SOFTNESS,
+        },
+        ..Bloom::NATURAL
+    }
+}
+
+/// Puts Bevy's `Bloom` on the look camera while the grade asks for some, at its intensity, and
+/// takes it off otherwise, so the classic look renders no bloom textures at all.
+fn sync_bloom(
+    mut commands: Commands,
+    frame: Res<LookFrame>,
+    mut cams: Query<(Entity, Option<&mut Bloom>), With<LookView>>,
+) {
+    let want = frame.on && frame.post.bloom > 0.0;
+    for (entity, bloom) in &mut cams {
+        match (want, bloom) {
+            (true, Some(mut b)) => {
+                if b.intensity != frame.post.bloom {
+                    b.intensity = frame.post.bloom;
+                }
+            }
+            (true, None) => {
+                commands.entity(entity).insert(look_bloom(frame.post.bloom));
+            }
+            (false, Some(_)) => {
+                commands.entity(entity).remove::<Bloom>();
+            }
+            (false, None) => {}
+        }
+    }
+}
+
+// ---------------------------------------------------------------- the grade, on the CPU
+
+/// Rec. 709 luminance weights, the shader's `LUMA`.
+const LUMA: [f32; 3] = [0.2126, 0.7152, 0.0722];
+/// Mid-grey: contrast pivots on it, and the white balance splits shadows from highlights at it.
+const MID_GREY: f32 = 0.18;
+/// The highlights' and the shadows' white-balance targets at full `warmth`.
+const WARM: [f32; 3] = [1.0, 0.92, 0.82];
+const COOL: [f32; 3] = [0.88, 0.94, 1.0];
+
+fn luma(c: [f32; 3]) -> f32 {
+    c[0] * LUMA[0] + c[1] * LUMA[1] + c[2] * LUMA[2]
+}
+
+/// The grade `world_look.wgsl`'s `grade` runs, on one linear colour (keep the two in step):
+/// white balance (highlights toward [`WARM`], shadows toward [`COOL`], each normalised to keep
+/// its luminance, split at mid-grey by `lum / (lum + 0.18)`, scaled by `warmth`), then contrast
+/// around mid-grey in log space, then saturation around luminance.
+pub fn grade_linear(c: [f32; 3], post: &PostLook) -> [f32; 3] {
+    let lum = luma(c);
+    let s = lum / (lum + MID_GREY);
+    let (lw, lc) = (luma(WARM), luma(COOL));
+    let wb: [f32; 3] = std::array::from_fn(|i| {
+        let tint = COOL[i] / lc + (WARM[i] / lw - COOL[i] / lc) * s;
+        c[i] * (1.0 + (tint - 1.0) * post.warmth)
+    });
+    let con: [f32; 3] =
+        std::array::from_fn(|i| MID_GREY * (wb[i].max(1e-6) / MID_GREY).powf(post.contrast));
+    let l2 = luma(con);
+    std::array::from_fn(|i| (l2 + (con[i] - l2) * post.saturation).max(0.0))
+}
+
+/// The combine's sRGB decode, the transfer the pass reverses at its exit.
+pub fn srgb_to_linear(c: f32) -> f32 {
+    if c <= 0.04045 {
+        c / 12.92
+    } else {
+        ((c + 0.055) / 1.055).powf(2.4)
+    }
+}
+
+// ---------------------------------------------------------------- render world
+
+/// The pass's uniform, `world_look.wgsl`'s `Look`: `grade = (saturation, contrast, warmth, 0)`.
+#[repr(C)]
+#[derive(Clone, Copy, Debug, Default, PartialEq, bytemuck::Pod, bytemuck::Zeroable)]
+pub struct LookUniform {
+    pub grade: [f32; 4],
+}
+
+impl LookUniform {
+    pub fn new(frame: &LookFrame) -> Self {
+        let p = frame.post;
+        Self {
+            grade: [p.saturation, p.contrast, p.warmth, 0.0],
+        }
+    }
+}
+
+const UNIFORM_BYTES: u64 = std::mem::size_of::<LookUniform>() as u64;
+
+#[derive(Debug, Hash, PartialEq, Eq, Clone, RenderLabel)]
+pub(crate) struct LookLabel;
+
+/// The pass's shader defs for one specialisation; one variant so far.
+fn shader_defs(_key: LookKey) -> Vec<bevy::shader::ShaderDefVal> {
+    vec![]
+}
+
+/// Every def set [`LookPipeline`] specialises `world_look.wgsl` on, for the app's shader
+/// translation test (naga validates each).
+pub fn shader_def_sets() -> Vec<Vec<bevy::shader::ShaderDefVal>> {
+    vec![shader_defs(LookKey {
+        format: ViewTarget::TEXTURE_FORMAT_HDR,
+    })]
+}
+
+#[derive(Resource)]
+struct LookPipeline {
+    layout: BindGroupLayoutDescriptor,
+    shader: Handle<Shader>,
+    fullscreen: FullscreenShader,
+}
+
+/// Specialised on the main texture's format, which the pass reads and writes.
+#[derive(Clone, Copy, PartialEq, Eq, Hash)]
+struct LookKey {
+    format: TextureFormat,
+}
+
+impl SpecializedRenderPipeline for LookPipeline {
+    type Key = LookKey;
+
+    fn specialize(&self, key: Self::Key) -> RenderPipelineDescriptor {
+        RenderPipelineDescriptor {
+            label: Some("world_look".into()),
+            layout: vec![self.layout.clone()],
+            vertex: self.fullscreen.to_vertex_state(),
+            fragment: Some(FragmentState {
+                shader: self.shader.clone(),
+                shader_defs: shader_defs(key),
+                entry_point: Some("fs_look".into()),
+                targets: vec![Some(ColorTargetState {
+                    format: key.format,
+                    blend: None,
+                    write_mask: ColorWrites::ALL,
+                })],
+            }),
+            ..default()
+        }
+    }
+}
+
+fn init_pipeline(
+    mut commands: Commands,
+    fullscreen: Res<FullscreenShader>,
+    asset_server: Res<AssetServer>,
+) {
+    let layout = BindGroupLayoutDescriptor::new(
+        "world_look_layout",
+        &BindGroupLayoutEntries::sequential(
+            ShaderStages::FRAGMENT,
+            (
+                // Read with `textureLoad` at the fragment's own pixel: no filtering, no sampler.
+                texture_2d(TextureSampleType::Float { filterable: false }),
+                uniform_buffer_sized(false, std::num::NonZero::new(UNIFORM_BYTES)),
+            ),
+        ),
+    );
+    commands.insert_resource(LookPipeline {
+        layout,
+        shader: asset_server.load("embedded://benilla_world/shaders/world_look.wgsl"),
+        fullscreen: fullscreen.clone(),
+    });
+}
+
+/// One look view's pipeline and uniform buffer, kept across frames.
+#[derive(Component)]
+struct LookViewGpu {
+    pipeline: CachedRenderPipelineId,
+    format: TextureFormat,
+    uniform: Buffer,
+}
+
+fn prepare_look_views(
+    mut commands: Commands,
+    device: Res<RenderDevice>,
+    cache: Res<PipelineCache>,
+    pipeline: Res<LookPipeline>,
+    mut pipelines: ResMut<SpecializedRenderPipelines<LookPipeline>>,
+    views: Query<(Entity, &ViewTarget, Option<&LookViewGpu>), With<LookView>>,
+) {
+    for (entity, target, existing) in &views {
+        let format = target.main_texture_format();
+        if existing.is_some_and(|g| g.format == format) {
+            continue;
+        }
+        let id = pipelines.specialize(&cache, &pipeline, LookKey { format });
+        let uniform = device.create_buffer(&BufferDescriptor {
+            label: Some("world_look_uniform"),
+            size: UNIFORM_BYTES,
+            usage: BufferUsages::UNIFORM | BufferUsages::COPY_DST,
+            mapped_at_creation: false,
+        });
+        commands.entity(entity).insert(LookViewGpu {
+            pipeline: id,
+            format,
+            uniform,
+        });
+    }
+}
+
+#[derive(Default)]
+struct LookNode;
+
+impl ViewNode for LookNode {
+    type ViewQuery = (&'static ViewTarget, &'static LookViewGpu);
+
+    fn run<'w>(
+        &self,
+        _graph: &mut RenderGraphContext,
+        render_context: &mut RenderContext<'w>,
+        (view_target, gpu): QueryItem<'w, '_, Self::ViewQuery>,
+        world: &'w World,
+    ) -> Result<(), NodeRunError> {
+        let frame = *world.resource::<LookFrame>();
+        // The classic look, or a neutral grade: no pass, no flip, the frame untouched.
+        if !frame.grades() {
+            return Ok(());
+        }
+        let cache = world.resource::<PipelineCache>();
+        let Some(pipeline) = cache.get_render_pipeline(gpu.pipeline) else {
+            return Ok(()); // still compiling: this frame is ungraded
+        };
+        let layout = cache.get_bind_group_layout(&world.resource::<LookPipeline>().layout);
+        world.resource::<RenderQueue>().write_buffer(
+            &gpu.uniform,
+            0,
+            bytemuck::bytes_of(&LookUniform::new(&frame)),
+        );
+        let post = view_target.post_process_write();
+        let bind = render_context.render_device().create_bind_group(
+            "world_look",
+            &layout,
+            &BindGroupEntries::sequential((post.source, gpu.uniform.as_entire_binding())),
+        );
+        let diagnostics = render_context.diagnostic_recorder();
+        let mut pass = render_context
+            .command_encoder()
+            .begin_render_pass(&RenderPassDescriptor {
+                label: Some("world_look"),
+                color_attachments: &[Some(RenderPassColorAttachment {
+                    view: post.destination,
+                    depth_slice: None,
+                    resolve_target: None,
+                    ops: Operations::default(),
+                })],
+                depth_stencil_attachment: None,
+                timestamp_writes: None,
+                occlusion_query_set: None,
+            });
+        let span = diagnostics.pass_span(&mut pass, "world_look");
+        pass.set_pipeline(pipeline);
+        pass.set_bind_group(0, &bind, &[]);
+        pass.draw(0..3, 0..1);
+        span.end(&mut pass);
+        Ok(())
+    }
+}
+
+/// The main-world half: the frame copy and the bloom; the render half in [`finish`], after the
+/// FFXGlow plugin has added the node this one is ordered against.
+pub(super) fn build(app: &mut App) {
+    app.init_resource::<LookFrame>()
+        .add_plugins((
+            ExtractComponentPlugin::<LookView>::default(),
+            ExtractResourcePlugin::<LookFrame>::default(),
+        ))
+        .add_systems(
+            Update,
+            (publish_frame, sync_bloom)
+                .chain()
+                .in_set(crate::lighting::LightingConsumeSet),
+        );
+}
+
+pub(super) fn finish(app: &mut App) {
+    let Some(render_app) = app.get_sub_app_mut(RenderApp) else {
+        return;
+    };
+    render_app
+        .init_resource::<SpecializedRenderPipelines<LookPipeline>>()
+        .add_systems(RenderStartup, init_pipeline)
+        .add_systems(
+            Render,
+            prepare_look_views.in_set(RenderSystems::PrepareResources),
+        )
+        .add_render_graph_node::<ViewNodeRunner<LookNode>>(Core3d, LookLabel)
+        .add_render_graph_edges(
+            Core3d,
+            (
+                Node3d::StartMainPassPostProcessing,
+                LookLabel,
+                crate::ffx_glow::FfxGlowLabel,
+            ),
+        );
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn post(saturation: f32, contrast: f32, warmth: f32) -> PostLook {
+        PostLook {
+            saturation,
+            contrast,
+            warmth,
+            ..PostLook::NEUTRAL
+        }
+    }
+
+    #[test]
+    fn neutral_values_are_the_identity() {
+        for c in [
+            [0.0, 0.0, 0.0],
+            [0.18, 0.18, 0.18],
+            [0.9, 0.4, 0.1],
+            [0.02, 0.3, 0.8],
+            [1.0, 1.0, 1.0],
+        ] {
+            let g = grade_linear(c, &PostLook::NEUTRAL);
+            for i in 0..3 {
+                assert!((g[i] - c[i]).abs() < 1e-5, "{c:?} → {g:?}");
+            }
+        }
+        assert!(!LookFrame {
+            on: true,
+            post: PostLook::NEUTRAL
+        }
+        .grades());
+        assert!(!LookFrame {
+            on: false,
+            post: post(1.2, 1.0, 0.0)
+        }
+        .grades());
+    }
+
+    /// Warmth tints a highlight warm (red up, blue down) and a shadow cool, keeping luminance
+    /// close.
+    #[test]
+    fn warmth_warms_highlights_and_cools_shadows() {
+        let warm = post(1.0, 1.0, 0.5);
+        let hi = grade_linear([0.8, 0.8, 0.8], &warm);
+        assert!(hi[0] > 0.8 && hi[2] < 0.8, "{hi:?}");
+        let lo = grade_linear([0.02, 0.02, 0.02], &warm);
+        assert!(lo[2] > 0.02 && lo[0] < 0.02, "{lo:?}");
+        assert!((luma(hi) - 0.8).abs() < 0.01);
+        // Negative warmth turns it round.
+        let cool = grade_linear([0.8, 0.8, 0.8], &post(1.0, 1.0, -0.5));
+        assert!(cool[2] > cool[0]);
+    }
+
+    #[test]
+    fn saturation_zero_is_grey() {
+        let g = grade_linear([0.9, 0.3, 0.05], &post(0.0, 1.0, 0.0));
+        assert!((g[0] - g[1]).abs() < 1e-6 && (g[1] - g[2]).abs() < 1e-6);
+        assert!((g[0] - luma([0.9, 0.3, 0.05])).abs() < 1e-5);
+    }
+
+    /// Contrast pivots on mid-grey: it stays, a brighter value rises and a darker one falls.
+    #[test]
+    fn contrast_pivots_on_mid_grey() {
+        let c = post(1.0, 1.2, 0.0);
+        assert!((grade_linear([0.18; 3], &c)[0] - 0.18).abs() < 1e-5);
+        assert!(grade_linear([0.6; 3], &c)[0] > 0.6);
+        assert!(grade_linear([0.05; 3], &c)[0] < 0.05);
+    }
+
+    /// `world_look.wgsl`'s `Look` is one `vec4<f32>`: 16 bytes, 16-aligned.
+    #[test]
+    fn the_uniform_layout_matches_the_shader() {
+        assert_eq!(UNIFORM_BYTES, 16);
+        assert_eq!(UNIFORM_BYTES % 16, 0);
+        let u = LookUniform::new(&LookFrame {
+            on: true,
+            post: post(1.1, 1.05, 0.2),
+        });
+        assert_eq!(u.grade, [1.1, 1.05, 0.2, 0.0]);
+    }
+
+    #[test]
+    fn the_bloom_is_additive_with_the_prefilter() {
+        let b = look_bloom(0.12);
+        assert_eq!(b.intensity, 0.12);
+        assert!(matches!(b.composite_mode, BloomCompositeMode::Additive));
+        assert_eq!(b.prefilter.threshold, 0.8);
+        assert_eq!(b.prefilter.threshold_softness, 0.3);
+    }
+
+    #[test]
+    fn the_decode_is_the_srgb_curve() {
+        assert_eq!(srgb_to_linear(0.0), 0.0);
+        assert!((srgb_to_linear(1.0) - 1.0).abs() < 1e-6);
+        assert!((srgb_to_linear(0.5) - 0.214_041).abs() < 1e-5);
+    }
+}
