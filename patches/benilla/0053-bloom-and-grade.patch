+// The new look's full-screen pass, benilla's own (`look::pass`): the world camera's frame, still
+// the gamma bytes here (its decode is the FFXGlow combine, after this), decoded to linear, graded
+// and encoded back. Off under the classic look: the node does not run at all.
+//   grade = white balance (warm highlights, cool shadows) → contrast around mid-grey in log space
+//           → saturation around luminance
+// `grade` mirrors `look::pass::grade_linear`; keep the two in step.
+
+#import bevy_core_pipeline::fullscreen_vertex_shader::FullscreenVertexOutput
+
+@group(0) @binding(0) var scene_tex: texture_2d<f32>;
+struct Look {
+    // x = saturation, y = contrast, z = warmth, w unused.
+    grade: vec4<f32>,
+}
+@group(0) @binding(1) var<uniform> look: Look;
+
+const LUMA: vec3<f32> = vec3<f32>(0.2126, 0.7152, 0.0722);
+const MID_GREY: f32 = 0.18;
+const WARM: vec3<f32> = vec3<f32>(1.0, 0.92, 0.82);
+const COOL: vec3<f32> = vec3<f32>(0.88, 0.94, 1.0);
+
+fn srgb_to_linear(c: vec3<f32>) -> vec3<f32> {
+    let lo = c / 12.92;
+    let hi = pow((c + vec3<f32>(0.055)) / 1.055, vec3<f32>(2.4));
+    return select(hi, lo, c <= vec3<f32>(0.04045));
+}
+
+fn linear_to_srgb(c: vec3<f32>) -> vec3<f32> {
+    let lo = c * 12.92;
+    let hi = 1.055 * pow(c, vec3<f32>(1.0 / 2.4)) - vec3<f32>(0.055);
+    return select(hi, lo, c <= vec3<f32>(0.0031308));
+}
+
+fn grade(c: vec3<f32>, saturation: f32, contrast: f32, warmth: f32) -> vec3<f32> {
+    // White balance: the tint runs from the cool shadow target to the warm highlight one, split at
+    // mid-grey; each target is divided by its own luminance, so the shift keeps brightness.
+    let lum = dot(c, LUMA);
+    let s = lum / (lum + MID_GREY);
+    let tint = mix(COOL / dot(COOL, LUMA), WARM / dot(WARM, LUMA), s);
+    let wb = c * mix(vec3<f32>(1.0), tint, warmth);
+    let con = MID_GREY * pow(max(wb, vec3<f32>(1e-6)) / MID_GREY, vec3<f32>(contrast));
+    let l2 = dot(con, LUMA);
+    return max(mix(vec3<f32>(l2), con, saturation), vec3<f32>(0.0));
+}
+
+@fragment
+fn fs_look(in: FullscreenVertexOutput) -> @location(0) vec4<f32> {
+    let px = vec2<i32>(in.position.xy);
+    let scene = textureLoad(scene_tex, px, 0);
+    // Clamped as every FFX read is: the float target does not saturate, the 1.12 frame does.
+    let lin = srgb_to_linear(clamp(scene.rgb, vec3<f32>(0.0), vec3<f32>(1.0)));
+    let graded = grade(lin, look.grade.x, look.grade.y, look.grade.z);
+    return vec4<f32>(linear_to_srgb(clamp(graded, vec3<f32>(0.0), vec3<f32>(1.0))), scene.a);
+}
