diff --git a/crates/benilla-app/src/aura_visual.rs b/crates/benilla-app/src/aura_visual.rs
index 7ae57ab1..1e02d23d 100644
--- a/crates/benilla-app/src/aura_visual.rs
+++ b/crates/benilla-app/src/aura_visual.rs
@@ -140,14 +140,53 @@ pub(crate) fn apply_aura_tint(
     )>,
     mut tints: ResMut<benilla_world::instance_tint::InstanceTints>,
     mut probe_logged: Local<bool>,
+    (glows, time): (
+        Query<(
+            Entity,
+            &crate::creature_anim::WeaponGlow,
+            Option<&crate::entities::HeldAttached>,
+        )>,
+        Option<Res<Time>>,
+    ),
 ) {
     let probe = tint_probe();
+    // Basin Battle's weapon glow: the hand slots' models (none held: the body), pulsing.
+    let now = time.map_or(0.0, |t| t.elapsed_secs());
+    let mut glowing: Vec<(Entity, [u8; 3])> = Vec::new();
+    for (unit, glow, held) in &glows {
+        if glow.until <= now {
+            continue;
+        }
+        let beat = 0.8 + 0.2 * (now * 12.0).sin();
+        let rgb = glow.rgb.map(|c| (f32::from(c) * beat).round() as u8);
+        let hands: Vec<Entity> = held
+            .map(|h| {
+                h.spawned_slots()[..2]
+                    .iter()
+                    .flatten()
+                    .copied()
+                    .filter(|e| rigs.get(*e).is_ok())
+                    .collect()
+            })
+            .unwrap_or_default();
+        if hands.is_empty() {
+            glowing.push((unit, rgb));
+        }
+        glowing.extend(hands.into_iter().map(|e| (e, rgb)));
+    }
     let mut painted = 0usize;
     for (root, rig) in &rigs {
-        let word = probe.or_else(|| chained_tint(&chain, root)).map_or(
-            benilla_world::instance_tint::IDENTITY,
-            benilla_world::instance_tint::pack,
-        );
+        let glow = glowing
+            .iter()
+            .find(|(e, _)| *e == root)
+            .map(|(_, rgb)| *rgb);
+        let word = probe
+            .or(glow)
+            .or_else(|| chained_tint(&chain, root))
+            .map_or(
+                benilla_world::instance_tint::IDENTITY,
+                benilla_world::instance_tint::pack,
+            );
         tints.set(rig.slot, word);
         painted += 1;
     }
