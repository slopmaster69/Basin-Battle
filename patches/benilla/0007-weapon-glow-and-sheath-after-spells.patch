+    fn coil_spans(&self) -> (f32, f32) {
+        let (a, b, snap) = self.coil_marks();
+        let extra = (self.windup - b - snap).max(0.0);
+        (
+            a + COIL_APPROACH * extra,
+            (b - a) + (1.0 - COIL_APPROACH) * extra,
+        )
+    }
