+static ANIM_LAYER: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(true);
+/// The spine's floor share held by `animlayer` (f32 bits; NaN: [`SPINE_FLOOR`]).
+static ANIM_LAYER_FLOOR: std::sync::atomic::AtomicU32 =
