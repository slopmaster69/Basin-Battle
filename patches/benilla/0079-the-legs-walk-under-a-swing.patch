+/// Basin Battle: [`fold`] for a ramped rotation, which takes only `share` of the step toward its
+/// sample (all of it at 1, exactly [`fold`]); a first contribution still lands whole, as nothing is
+/// under it to share with.
+#[inline]
+fn fold_ramped(register: &mut Option<(Quat, f32)>, sample: Option<Quat>, weight: f32, share: f32) {
+    let Some(v) = sample else { return };
+    *register = Some(match register.take() {
+        None => (v, weight),
+        Some((acc, total)) => {
+            let total = total + weight;
+            (Quat::interpolate(&acc, &v, share * weight / total), total)
+        }
+    });
+}
