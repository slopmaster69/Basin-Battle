+/// `animlayer <share>`, benilla's own (1.12 has no such command): holds the swing's share of
+/// SpineLow's turn under walking legs, 0 to 1 (1 cuts the swing at the waist as 1.12 does), for
+/// tuning on film; `animlayer tuned`, or no argument, puts back the tuned share. `animLayer 0`
+/// plays every swing on the whole body either way.
+fn anim_layer_console(_world: &mut World, args: &str) -> Vec<String> {
+    let arg = args.trim();
+    let held = if arg.is_empty() || arg.eq_ignore_ascii_case("tuned") {
+        None
+    } else {
+        match arg.parse::<f32>() {
+            Ok(v) if (0.0..=1.0).contains(&v) => Some(v),
+            _ => return vec!["Usage: animlayer <spine share 0-1> | tuned".to_string()],
+        }
+    };
+    ANIM_LAYER_FLOOR.store(
+        held.map_or(u32::MAX, f32::to_bits),
+        std::sync::atomic::Ordering::Relaxed,
+    );
+    let mut lines = vec![match held {
+        None => format!("Swing on the spine at its tuned share ({SPINE_FLOOR})."),
+        Some(v) => format!("Swing on the spine held at {v} at SpineLow."),
+    }];
+    if !anim_layer_on() {
+        lines.push("animLayer is 0: every swing plays on the whole body.".to_string());
+    }
+    lines
