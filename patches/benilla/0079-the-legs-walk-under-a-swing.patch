+/// The swing's share of SpineLow's turn under walking legs now.
+fn spine_floor() -> f32 {
+    let held = f32::from_bits(ANIM_LAYER_FLOOR.load(std::sync::atomic::Ordering::Relaxed));
+    if held.is_finite() {
