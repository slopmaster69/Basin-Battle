+/// A unit's legs, for the walk under a swing: how long they have been moving (positive, seconds)
+/// or still (negative), by the unit's movement flags and speed (our own hero's animation flags,
+/// another's relayed ones, a creature's path), and whether it rides. Kept on the unit's
+/// [`super::AnimDriver`], so a new clip doesn't count again from nothing; a knockback or a pull,
+/// with no direction flag, never counts as walking.
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub(crate) struct LegsMotion {
+    pub(crate) moving_for: f32,
+    pub(crate) mounted: bool,
+}
+
+impl LegsMotion {
+    /// One frame of the legs: `flags` the animation's movement flags, `speed` the unit's (yd/s).
+    pub(super) fn step(&mut self, flags: u32, speed: f32, mounted: bool, dt: f32) {
+        use super::select::move_flags;
+        self.mounted = mounted;
+        if dt <= 0.0 {
+            return;
+        }
+        let walking = flags & (move_flags::ANY_MOVE | move_flags::SWIMMING) != 0;
+        if walking && speed > MOVING_ABOVE {
+            self.moving_for = self.moving_for.max(0.0) + dt;
+        } else if !walking || speed < STILL_BELOW {
+            self.moving_for = self.moving_for.min(0.0) - dt;
+        }
+    }
+}
