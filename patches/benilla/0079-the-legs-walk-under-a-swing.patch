+    /// Last frame's choice, and whether the legs had been handed to the walk ([`ActionClip`]'s
+    /// latch).
+    on_upper: bool,
+    layered: bool,
+    /// The clip's own measure of the body's motion (the twenty-eighth round's), and the unit's legs.
+    clip_moving_for: f32,
+    legs: LegsMotion,
+}
+
+/// Whether the clip plays on the upper body this frame. With the layer on, a clip on the whole body
+/// standing (`Auto`, `"auto"`) goes on the torso whenever the legs are walking or riding, from its
+/// first frame, and stays there to its end (stopping, the torso finishes the swing over the legs'
+/// stand), on a model that splits at SpineLow, unless its legs are the move. With it off, the
+/// twenty-eighth round's rule exactly, `"auto"` playing on the whole body.
+fn on_upper_now(ask: BodyAsk, layer_on: bool) -> bool {
+    match (ask.body, layer_on) {
+        (ActionBody::Full | ActionBody::Lower, _) | (ActionBody::Layer, false) => false,
+        (ActionBody::Upper, _) => ask.has_upper,
+        (ActionBody::Auto, false) => {
+            ask.has_upper
+                && if ask.on_upper {
+                    ask.clip_moving_for > -0.15
+                } else {
+                    // Longer than a lunge's step: a blow stepping in keeps its own legs.
+                    ask.clip_moving_for > LEGS_AFTER
+                }
+        }
+        (ActionBody::Auto | ActionBody::Layer, true) => {
+            ask.has_upper
+                && ask.spine_split
+                && !LEGS_ARE_THE_MOVE.contains(&ask.id)
+                && (ask.layered || ask.legs.mounted || ask.legs.moving_for > LEGS_AFTER)
+        }
+    }
+}
