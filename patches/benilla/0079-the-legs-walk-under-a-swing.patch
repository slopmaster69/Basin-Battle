+/// A swing's lunge (a `"legs"` dash) run while strafing left: the body runs the dash's way
+/// (forward, on the wire), the pose keeps the strafe; with no key held the pose has no way at all
+/// (a planted lunge); a dash without `"legs"`, or the layer off, poses as the dash goes.
+#[test]
+fn a_lunge_keeps_the_legs_walking_the_way_the_keys_go() {
+    let still = || input::MoveAxes {
+        fwd: 0,
+        side: 0,
+        mouselook: false,
+        turning: false,
+        translating: false,
+        strafe_left: false,
+        strafe_right: false,
+        turn_left: false,
+        turn_right: false,
+    };
+    let lunge = |keep_legs| super::super::state::ActionDash {
+        fwd: 1,
+        side: 0,
+        speed: 6.0,
+        until: 0.0,
+        secs: 0.18,
+        keys_now: false,
+        keep_legs,
+        legs: (0, 0),
+        under: (0, 0),
+        legs_from_keys: false,
+        under_speed: 0.0,
+    };
+    let mut player = Player::default();
+    player.pending_dashes.push((1.0, lunge(true)));
+    let mut axes = still();
+    axes.side = -1;
+    axes.strafe_left = true;
+    action_dash(&mut player, &mut axes, 1.0, true);
+    assert_eq!((axes.fwd, axes.side), (1, 0), "the body runs the dash's way");
+    let dash = player.action_dash.expect("running");
+    assert_eq!(dash.legs, (0, -1), "the legs keep the strafe");
+    let wire = move_flags::FORWARD;
+    assert_eq!(
+        pose_with_legs(wire, Some(&dash), true),
+        move_flags::STRAFE_LEFT
+    );
+    assert_eq!(pose_with_legs(wire, Some(&dash), false), wire, "the layer off");
+    assert_eq!(
+        pose_with_legs(wire, Some(&lunge(false)), true),
+        wire,
+        "a dash not asked to keep the legs"
+    );
+    // No key held: planted.
+    let mut player = Player::default();
+    player.pending_dashes.push((1.0, lunge(true)));
+    let mut axes = still();
+    action_dash(&mut player, &mut axes, 1.0, true);
+    let dash = player.action_dash.expect("running");
+    assert_eq!(pose_with_legs(wire, Some(&dash), true), 0);
+    // Over a scripted walk backwards (a dash of its own, no key held): the walk's way.
+    let mut player = Player {
+        action_dash: Some(super::super::state::ActionDash {
+            fwd: -1,
+            until: 3.0,
+            ..lunge(false)
+        }),
+        ..Default::default()
+    };
+    player.pending_dashes.push((1.0, lunge(true)));
+    let mut axes = still();
+    action_dash(&mut player, &mut axes, 1.0, true);
+    assert_eq!(player.action_dash.expect("running").legs, (-1, 0));
+}
+
+/// The legs' pace under a lunge: the keys held walk at the speed the server gives those keys (a
+/// swing's 3 yd/s, so Walk, whatever the lunge's burst); no key held, at the pace of the scripted
+/// walk the lunge replaced; none of either, standing; a dash not asked to keep the legs, or the
+/// layer off, leaves the body's own speed.
+#[test]
+fn a_lunge_never_hands_its_burst_to_the_legs() {
+    let still = || input::MoveAxes {
+        fwd: 0,
+        side: 0,
+        mouselook: false,
+        turning: false,
+        translating: false,
+        strafe_left: false,
+        strafe_right: false,
+        turn_left: false,
+        turn_right: false,
+    };
+    let dash = |keep_legs, speed| super::super::state::ActionDash {
+        fwd: 1,
+        side: 0,
+        speed,
+        until: 0.0,
+        secs: 0.18,
+        keys_now: false,
+        keep_legs,
+        legs: (0, 0),
+        under: (0, 0),
+        legs_from_keys: false,
+        under_speed: 0.0,
+    };
+    let keys = |dir: u32| {
+        assert_eq!(dir, move_flags::FORWARD, "the keys' own way");
+        3.0
+    };
+    // Holding forward while the third blow lunges at 5.6 yd/s: the legs walk at the keys' 3.
+    let mut player = Player::default();
+    player.pending_dashes.push((1.0, dash(true, 1.0 / 0.18)));
+    let mut axes = still();
+    axes.fwd = 1;
+    action_dash(&mut player, &mut axes, 1.0, true);
+    let d = player.action_dash.expect("running");
+    assert_eq!(legs_pose_speed(Some(&d), true, keys), Some(3.0));
+    assert_eq!(legs_pose_speed(Some(&d), false, keys), None, "the layer off");
+    assert_eq!(
+        legs_pose_speed(Some(&dash(false, 5.6)), true, keys),
+        None,
+        "a dash not asked to keep the legs"
+    );
+    // Over a scripted walk at 7 yd/s, no key held: the walk's pace, not the lunge's 3.9.
+    let mut player = Player {
+        action_dash: Some(super::super::state::ActionDash {
+            until: 3.0,
+            ..dash(false, 7.0)
+        }),
+        ..Default::default()
+    };
+    player.pending_dashes.push((1.0, dash(true, 0.7 / 0.18)));
+    let mut axes = still();
+    action_dash(&mut player, &mut axes, 1.0, true);
+    let d = player.action_dash.expect("running");
+    assert_eq!(legs_pose_speed(Some(&d), true, |_| unreachable!()), Some(7.0));
+    // A lunge after a lunge over that walk keeps the walk's pace.
+    player.pending_dashes.push((1.1, dash(true, 1.0 / 0.18)));
+    action_dash(&mut player, &mut still(), 1.1, true);
+    let d = player.action_dash.expect("running");
+    assert_eq!(legs_pose_speed(Some(&d), true, |_| unreachable!()), Some(7.0));
+    // From standing, no key held: the legs stand.
+    let mut player = Player::default();
+    player.pending_dashes.push((1.0, dash(true, 4.0)));
+    action_dash(&mut player, &mut still(), 1.0, true);
+    let d = player.action_dash.expect("running");
+    assert_eq!(legs_pose_speed(Some(&d), true, |_| unreachable!()), Some(0.0));
+}
