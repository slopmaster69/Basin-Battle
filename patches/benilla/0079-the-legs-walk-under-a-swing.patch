+    /// A clip holding each listed bone's turn (and bone 1's place) still.
+    fn still(bones: &[(u16, Quat)], at: Vec3) -> ClipSpec {
+        ClipSpec {
+            bones: bones
+                .iter()
+                .map(|&(b, q)| {
+                    (
+                        b,
+                        BoneSpec {
+                            t: if b == 1 { vec![(0.0, at), (1.0, at)] } else { vec![] },
+                            r: vec![(0.0, q), (1.0, q)],
+                            s: vec![],
+                        },
+                    )
+                })
+                .collect(),
+            mask: 0,
+        }
+    }
+
+    fn set_ramp(app: &mut App, rig: Entity, nodes: &[AnimationNodeIndex], floor: f32) {
+        let mut e = app.world_mut().entity_mut(rig);
+        let mut pose = e.get_mut::<RigPose>().unwrap();
+        pose.ramped = nodes.iter().map(|n| n.index()).collect();
+        pose.ramp_floor = floor;
+    }
+
+    fn rot(app: &App, rig: Entity, bone: usize) -> Quat {
+        app.world().entity(rig).get::<RigPose>().unwrap().locals[bone].rotation
+    }
+
+    /// Two turns the same, either sign (component-wise: `angle_between`'s `acos` is too coarse in
+    /// f32 for turns this close).
+    fn same_turn(q: Quat, want: Quat) -> bool {
+        let d = if q.dot(want) < 0.0 { q + want } else { q - want };
+        d.length() < 1e-4
+    }
+
+    /// Basin Battle's walk-while-swinging: a swing on the upper body over the walk's gait. Bone 0
+    /// (the legs, outside the upper body) keeps the gait; SpineLow (bone 1) takes the floor's
+    /// share of the swing's turn and the chest (bone 2) all of it, at the swing's blend; bone 1's
+    /// place takes the plain blend, not the ramp. The list is taken each frame.
+    #[test]
+    fn a_ramped_swing_shares_its_turn_up_the_spine_over_the_gait() {
+        let mut app = app();
+        let (a, b) = (Quat::from_rotation_y(0.2), Quat::from_rotation_x(1.1));
+        let (ta, tb) = (Vec3::X, Vec3::Y);
+        let gait = still(&[(0, a), (1, a), (2, a)], ta);
+        let mut swing = still(&[(0, b), (1, b), (2, b)], tb);
+        swing.mask = 1 << 2;
+        let (graph, nodes, mut pose) = build(&mut app, &[gait, swing], vec![1 << 2, 1 << 5, 1 << 5]);
+        pose.spine_rank = vec![0.0, 0.0, 1.0];
+        let (_, _, ours) = twin_rigs(&mut app, 3, &graph, &pose);
+        app.update(); // warm-up: see single_clip_matches_animate_targets
+        drive(&mut app, &[ours], |p, _| {
+            p.play(nodes[0]).repeat();
+            p.play(nodes[1]).repeat().set_weight(999.0);
+        });
+        set_ramp(&mut app, ours, &[nodes[1]], 0.5);
+        step(&mut app, 0.02);
+        let w = 999.0 / 1000.0;
+        assert!(same_turn(rot(&app, ours, 0), a), "the legs keep the gait");
+        let spine_low = Quat::interpolate(&a, &b, 0.5 * w);
+        assert!(same_turn(rot(&app, ours, 1), spine_low), "SpineLow takes half");
+        let chest = Quat::interpolate(&a, &b, w);
+        assert!(same_turn(rot(&app, ours, 2), chest), "the chest takes it whole");
+        let t1 = app.world().entity(ours).get::<RigPose>().unwrap().locals[1].translation;
+        assert!(t1.distance(ta.lerp(tb, w)) < 1e-4, "a place takes the plain blend: {t1}");
+        assert!(
+            app.world().entity(ours).get::<RigPose>().unwrap().ramped.is_empty(),
+            "taken each frame"
+        );
+        // Not named again: the plain blend, the chest and SpineLow alike.
+        step(&mut app, 0.02);
+        assert!(same_turn(rot(&app, ours, 1), chest), "no stale ramp");
+    }
+
+    /// A ramped node folds over the gait even when its node index comes first, and a model with
+    /// no SpineLow split ignores the list (exactly Bevy's blend).
+    #[test]
+    fn a_ramped_node_folds_last_and_a_model_with_no_spine_split_ignores_it() {
+        let mut app = app();
+        let (a, b) = (Quat::from_rotation_z(-0.4), Quat::from_rotation_x(0.9));
+        let mut swing = still(&[(1, b), (2, b)], Vec3::Y);
+        swing.mask = 1 << 2;
+        let gait = still(&[(1, a), (2, a)], Vec3::X);
+        let (graph, nodes, mut pose) = build(&mut app, &[swing, gait], vec![1 << 2, 1 << 5, 1 << 5]);
+        let plain = pose.clone();
+        pose.spine_rank = vec![0.0, 0.0, 1.0];
+        let (oracle, oj, ours) = twin_rigs(&mut app, 3, &graph, &pose);
+        let (_, _, beast) = twin_rigs(&mut app, 3, &graph, &plain);
+        app.update(); // warm-up: see single_clip_matches_animate_targets
+        drive(&mut app, &[oracle, ours, beast], |p, _| {
+            p.play(nodes[1]).repeat();
+            p.play(nodes[0]).repeat().set_weight(999.0);
+        });
+        set_ramp(&mut app, ours, &[nodes[0]], 0.5);
+        set_ramp(&mut app, beast, &[nodes[0]], 0.5);
+        step(&mut app, 0.02);
+        let w = 999.0 / 1000.0;
+        assert!(same_turn(rot(&app, ours, 1), Quat::interpolate(&a, &b, 0.5 * w)));
+        assert!(same_turn(rot(&app, ours, 2), Quat::interpolate(&a, &b, w)));
+        assert_twins_equal(&mut app, &oj, beast);
+    }
