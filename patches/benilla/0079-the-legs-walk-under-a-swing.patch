+/// Basin Battle: how far up the spine each bone sits, for a swing played on the upper body over
+/// walking legs (the action layer's walk-while-swinging). The chain runs from `root`, the
+/// upper-body split, up to the shoulders' (key bones 2 and 3) lowest common ancestor, the chest;
+/// its bones read 0 at the split rising evenly to 1 at the chest, and every other bone inside the
+/// split reads 1 (the shoulders, the arms, the neck and the head take the swing whole). Bones
+/// outside the split (the pelvis, the legs) read 0, though their mask keeps the swing off them
+/// anyway. Empty unless the split is SpineLow (key bone 4): a Head-only split (most beasts) has
+/// no torso to share a swing with, and plays it on the whole body.
+pub(crate) fn spine_rank(skel: &Skeleton, root: usize) -> Vec<f32> {
+    if skel.bones.get(root).map(|b| b.key_bone) != Some(4) {
+        return Vec::new();
+    }
+    let n = skel.bones.len();
+    let parent = |b: usize| {
+        skel.bones
+            .get(b)
+            .and_then(|x| usize::try_from(x.parent).ok())
+            .filter(|&p| p < n)
+    };
+    // A bone and every bone above it, capped against a malformed parent loop.
+    let up = |from: usize| {
+        let mut chain = vec![from];
+        let mut cur = from;
+        while let Some(p) = parent(cur) {
+            if chain.len() > n {
+                break;
+            }
+            chain.push(p);
+            cur = p;
+        }
+        chain
+    };
+    let shoulder = |k: i16| skel.bones.iter().position(|b| b.key_bone == k);
+    let chest = match (shoulder(2), shoulder(3)) {
+        (Some(l), Some(r)) => {
+            let above_l = up(l);
+            up(r).into_iter().find(|b| above_l.contains(b))
+        }
+        _ => None,
+    };
+    // From the split up to the chest; none when the chest isn't above the split.
+    let chain: Vec<usize> = chest
+        .map(up)
+        .and_then(|above| {
+            let at = above.iter().position(|&b| b == root)?;
+            let mut chain = above[..=at].to_vec();
+            chain.reverse();
+            Some(chain)
+        })
+        .unwrap_or_default();
+    let mut rank: Vec<f32> = (0..n)
+        .map(|i| if in_subtree(skel, i, root) { 1.0 } else { 0.0 })
+        .collect();
+    if chain.len() > 1 {
+        let last = (chain.len() - 1) as f32;
+        for (i, &b) in chain.iter().enumerate() {
+            rank[b] = i as f32 / last;
+        }
+    }
+    rank
+}
