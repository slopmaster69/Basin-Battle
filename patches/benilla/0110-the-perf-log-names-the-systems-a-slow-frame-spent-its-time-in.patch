+    log.gc_at = gc_now;
+    let mut scratch = std::mem::take(&mut log.scratch);
+    if system_times::enabled() {
+        system_times::mark_main_thread();
+        system_times::take_frame(&mut scratch);
+    }
+    log.sys.add_frame(now, frame_ms, &scratch, gc);
+    log.scratch = scratch;
