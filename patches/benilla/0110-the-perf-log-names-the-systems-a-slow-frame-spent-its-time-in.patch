 /// How many of the costliest GPU passes a summary names.
 const TOP_PASSES: usize = 6;
 
+/// How many systems the window's list and the worst frame's name.
+const TOP_SYSTEMS: usize = 8;
+
+/// A frame longer than this (ms) is a spike: its top systems are tallied.
+const SPIKE_MS: f32 = 33.3;
+
+/// How many of a spike frame's costliest systems are tallied, and how many tallies are printed.
+const SPIKE_TOP: usize = 3;
+const SPIKE_LIST: usize = 6;
