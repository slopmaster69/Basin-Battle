+//! Each ECS system's wall time, per frame, for `benilla-config/perf.log`: which systems a slow
+//! frame spent its time in, with no profiler attached.
+//!
+//! `bevy_ecs`'s `trace` feature opens a `system` span around every system run (and a
+//! `system_commands` span around applying its commands), each made once when the system is built.
+//! [`SystemTimes`] is a [`Layer`] beside [`crate::log_ring::LogRing`] that times those spans: on
+//! enter it pushes the clock onto the thread's stack, on exit it adds the elapsed nanoseconds to
+//! the system's slot, a relaxed atomic add. A system that runs a whole schedule inside itself
+//! (`Main::run_main`, the fixed-step runner) is a *runner*: its time is its schedules', so it is
+//! left out of every list.
+//!
+//! The reader, once a frame on the main thread, takes the frame's slots ([`take_frame`]) and
+//! clears them. Nothing is timed until [`enable`]; `WOW_SYSTEM_TIMES=0` keeps it off, the layer
+//! returning at once on every enter and exit (`bevy_ecs` still makes and enters its spans).
+
+use std::cell::{Cell, RefCell};
+use std::collections::HashMap;
+use std::sync::atomic::{AtomicBool, AtomicU64, AtomicUsize, Ordering::Relaxed};
+use std::sync::{Mutex, OnceLock};
+use std::time::Instant;
+
+use bevy::log::tracing::field::{Field, Visit};
+use bevy::log::tracing::span::{Attributes, Id};
+use bevy::log::tracing::Subscriber;
+use bevy::log::tracing_subscriber::layer::Context;
+use bevy::log::tracing_subscriber::registry::LookupSpan;
+use bevy::log::tracing_subscriber::Layer;
+
+/// The most systems timed; a system past it goes untimed. The client builds about 2,000.
+pub const SLOTS: usize = 8192;
+
+/// This frame's nanoseconds per slot, on any thread.
+static FRAME_NS: [AtomicU64; SLOTS] = [const { AtomicU64::new(0) }; SLOTS];
+/// This frame's nanoseconds per slot on the main thread.
+static MAIN_NS: [AtomicU64; SLOTS] = [const { AtomicU64::new(0) }; SLOTS];
+/// Slots that ran a schedule inside themselves.
+static RUNNER: [AtomicBool; SLOTS] = [const { AtomicBool::new(false) }; SLOTS];
+/// Slots handed out so far.
+static USED: AtomicUsize = AtomicUsize::new(0);
+/// Timing is on.
+static ENABLED: AtomicBool = AtomicBool::new(false);
+
+/// Slot names, and the slot of each name.
+#[derive(Default)]
+struct Names {
+    by_slot: Vec<String>,
+    by_name: HashMap<String, u32>,
+}
+
+fn names() -> &'static Mutex<Names> {
+    static N: OnceLock<Mutex<Names>> = OnceLock::new();
+    N.get_or_init(Mutex::default)
+}
+
+thread_local! {
+    /// The systems open on this thread, innermost last, with the clock at their entry.
+    static STACK: RefCell<Vec<(u32, Instant)>> = const { RefCell::new(Vec::new()) };
+    /// This is the main thread ([`mark_main_thread`]).
+    static IS_MAIN: Cell<bool> = const { Cell::new(false) };
+}
+
+/// Starts timing, unless `WOW_SYSTEM_TIMES=0`. Returns whether it is on.
+pub fn enable() -> bool {
+    let off = std::env::var("WOW_SYSTEM_TIMES").is_ok_and(|v| v.trim() == "0");
+    ENABLED.store(!off, Relaxed);
+    !off
+}
+
+/// Whether timing is on.
+pub fn enabled() -> bool {
+    ENABLED.load(Relaxed)
+}
+
+/// Marks the calling thread as the main thread; called from a main-thread system each frame.
+pub fn mark_main_thread() {
+    IS_MAIN.with(|m| m.set(true));
+}
+
+/// What a span is to the layer, kept in its extensions.
+#[derive(Clone, Copy)]
+enum Kind {
+    /// A system's run or its commands, timed in this slot.
+    Timed(u32),
+    /// A schedule's run: whatever system encloses it on this thread is a runner.
+    Schedule,
+}
+
+/// The slot for `name`, made on first sight; `None` once [`SLOTS`] are taken.
+fn slot_of(name: String) -> Option<u32> {
+    let mut n = names().lock().unwrap_or_else(|p| p.into_inner());
+    if let Some(&s) = n.by_name.get(&name) {
+        return Some(s);
+    }
+    let s = n.by_slot.len();
+    if s >= SLOTS {
+        return None;
+    }
+    n.by_slot.push(name.clone());
+    n.by_name.insert(name, s as u32);
+    USED.store(s + 1, Relaxed);
+    Some(s as u32)
+}
+
+/// A slot's system name, as bevy gives it (the full path).
+pub fn name(slot: u32) -> String {
+    names()
+        .lock()
+        .unwrap_or_else(|p| p.into_inner())
+        .by_slot
+        .get(slot as usize)
+        .cloned()
+        .unwrap_or_default()
+}
+
+/// A slot ran a schedule inside itself.
+pub fn is_runner(slot: u32) -> bool {
+    RUNNER.get(slot as usize).is_some_and(|r| r.load(Relaxed))
+}
+
+/// One system's share of a frame.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct SlotTime {
+    pub slot: u32,
+    /// Nanoseconds on any thread.
+    pub ns: u64,
+    /// Of those, nanoseconds on the main thread.
+    pub main_ns: u64,
+}
+
+/// Moves every slot's time since the last call into `out` (cleared first), runners left out, and
+/// zeroes the slots.
+pub fn take_frame(out: &mut Vec<SlotTime>) {
+    out.clear();
+    let used = USED.load(Relaxed).min(SLOTS);
+    for slot in 0..used {
+        if FRAME_NS[slot].load(Relaxed) == 0 {
+            continue;
+        }
+        let ns = FRAME_NS[slot].swap(0, Relaxed);
+        let main_ns = MAIN_NS[slot].swap(0, Relaxed);
+        if ns == 0 || RUNNER[slot].load(Relaxed) {
+            continue;
+        }
+        out.push(SlotTime {
+            slot: slot as u32,
+            ns,
+            main_ns,
+        });
+    }
+}
+
+/// `full::path::to::system` as `to::system`, a generic argument as its last segment, and a
+/// closure with its function: short enough for a log line, still unique in practice.
+pub fn short_name(name: &str) -> String {
+    let (head, generic) = match name.find('<') {
+        Some(i) => (&name[..i], Some(&name[i + 1..])),
+        None => (name, None),
+    };
+    let segs: Vec<&str> = head.split("::").collect();
+    let keep = if segs.last().is_some_and(|s| s.starts_with('{')) {
+        3
+    } else {
+        2
+    };
+    let base = segs[segs.len().saturating_sub(keep)..].join("::");
+    match generic {
+        Some(g) => {
+            let first = g.split([',', '<', '>']).next().unwrap_or("").trim();
+            let last = first.rsplit("::").next().unwrap_or(first);
+            format!("{base}<{last}>")
+        }
+        None => base,
+    }
+}
+
+/// Reads a span's `name` field.
+struct NameVisitor<'a>(&'a mut String);
+
+impl Visit for NameVisitor<'_> {
+    fn record_str(&mut self, field: &Field, value: &str) {
+        if field.name() == "name" {
+            self.0.push_str(value);
+        }
+    }
+
+    fn record_debug(&mut self, field: &Field, value: &dyn std::fmt::Debug) {
+        if field.name() == "name" && self.0.is_empty() {
+            use std::fmt::Write as _;
+            let _ = write!(self.0, "{value:?}");
+        }
+    }
+}
+
+/// The timing layer; see the module docs.
+pub struct SystemTimes;
+
+impl<S> Layer<S> for SystemTimes
+where
+    S: Subscriber + for<'a> LookupSpan<'a>,
+{
+    fn on_new_span(&self, attrs: &Attributes<'_>, id: &Id, ctx: Context<'_, S>) {
+        let kind = match attrs.metadata().name() {
+            "schedule" => Kind::Schedule,
+            span @ ("system" | "system_commands") => {
+                let mut name = String::new();
+                attrs.record(&mut NameVisitor(&mut name));
+                if span == "system_commands" {
+                    name.push_str(" (commands)");
+                }
+                match slot_of(name) {
+                    Some(slot) => Kind::Timed(slot),
+                    None => return,
+                }
+            }
+            _ => return,
+        };
+        if let Some(span) = ctx.span(id) {
+            span.extensions_mut().insert(kind);
+        }
+    }
+
+    fn on_enter(&self, id: &Id, ctx: Context<'_, S>) {
+        if !ENABLED.load(Relaxed) {
+            return;
+        }
+        let Some(kind) = ctx
+            .span(id)
+            .and_then(|s| s.extensions().get::<Kind>().copied())
+        else {
+            return;
+        };
+        STACK.with(|stack| {
+            let Ok(mut stack) = stack.try_borrow_mut() else {
+                return;
+            };
+            match kind {
+                Kind::Timed(slot) => stack.push((slot, Instant::now())),
+                Kind::Schedule => {
+                    if let Some(&(outer, _)) = stack.last() {
+                        RUNNER[outer as usize].store(true, Relaxed);
+                    }
+                }
+            }
+        });
+    }
+
+    fn on_exit(&self, id: &Id, ctx: Context<'_, S>) {
+        if !ENABLED.load(Relaxed) {
+            return;
+        }
+        let Some(Kind::Timed(slot)) = ctx
+            .span(id)
+            .and_then(|s| s.extensions().get::<Kind>().copied())
+        else {
+            return;
+        };
+        STACK.with(|stack| {
+            let Ok(mut stack) = stack.try_borrow_mut() else {
+                return;
+            };
+            // Unwind to this span: an enter seen before timing was on has no entry.
+            let Some(at) = stack.iter().rposition(|&(s, _)| s == slot) else {
+                return;
+            };
+            let (_, t0) = stack[at];
+            stack.truncate(at);
+            let ns = t0.elapsed().as_nanos().min(u128::from(u64::MAX)) as u64;
+            FRAME_NS[slot as usize].fetch_add(ns, Relaxed);
+            if IS_MAIN.with(Cell::get) {
+                MAIN_NS[slot as usize].fetch_add(ns, Relaxed);
+            }
+        });
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use bevy::log::tracing_subscriber::layer::SubscriberExt;
+
+    #[test]
+    fn names_shorten_to_their_last_two_segments() {
+        assert_eq!(
+            short_name("benilla_world::model_render::visibility::apply_model_visibility"),
+            "visibility::apply_model_visibility"
+        );
+        assert_eq!(
+            short_name("bevy_render::extract_component::extract_components<bevy_pbr::Foo>"),
+            "extract_component::extract_components<Foo>"
+        );
+        assert_eq!(
+            short_name("benilla_app::look::plugin::{{closure}}"),
+            "look::plugin::{{closure}}"
+        );
+        assert_eq!(short_name("plain"), "plain");
+    }
+
+    /// One test for the whole contract, as the slots are process-wide statics: a system's span is
+    /// timed into its slot, its commands into their own, and a system that runs a schedule inside
+    /// itself is a runner, left out.
+    #[test]
+    fn the_layer_times_system_spans_and_leaves_runners_out() {
+        use bevy::log::tracing::info_span;
+        let subscriber = bevy::log::tracing_subscriber::registry().with(SystemTimes);
+        ENABLED.store(true, Relaxed);
+        mark_main_thread();
+        bevy::log::tracing::subscriber::with_default(subscriber, || {
+            let sys = info_span!("system", name = "test::slow_system");
+            let cmds = info_span!("system_commands", name = "test::slow_system");
+            let runner = info_span!("system", name = "test::runner");
+            {
+                let _g = sys.enter();
+                std::thread::sleep(std::time::Duration::from_millis(3));
+            }
+            {
+                let _g = cmds.enter();
+            }
+            {
+                let _r = runner.enter();
+                let _s = info_span!("schedule", name = "Inner").entered();
+            }
+        });
+        let mut out = Vec::new();
+        take_frame(&mut out);
+        let by_name = |n: &str| out.iter().find(|t| name(t.slot) == n).copied();
+        let slow = by_name("test::slow_system").expect("the system is timed");
+        assert!(slow.ns >= 3_000_000, "{slow:?}");
+        assert_eq!(slow.ns, slow.main_ns, "it ran on the marked thread");
+        assert!(by_name("test::slow_system (commands)").is_some());
+        assert!(by_name("test::runner").is_none(), "a runner is left out");
+        // The slots were cleared.
+        take_frame(&mut out);
+        assert!(out.iter().all(|t| !name(t.slot).starts_with("test::")));
+    }
+}
