@@ -72,6 +93,186 @@ struct PerfLog {
     main_at: Option<f64>,
     /// The last settings line written; a new one goes in only when it differs.
     settings: String,
+    /// This window's per-system times.
+    sys: SysWindow,
+    /// One frame's slots, reused.
+    scratch: Vec<SlotTime>,
+    /// When this system last ran: one frame of the main schedule, `Last` to `Last`.
+    last_frame_at: Option<Instant>,
+    /// The Lua collections and their nanoseconds counted at the last frame.
+    gc_at: Option<(u64, u64)>,
+}
+
+/// One window's systems: per slot `[ns, main-thread ns, most ns in one frame]`, the worst frame,
+/// and the spike frames' tallies.
+#[derive(Default)]
+struct SysWindow {
+    slots: Vec<[u64; 3]>,
+    worst: Option<WorstFrame>,
+    spikes: u32,
+    spikes_with_gc: u32,
+    /// The Lua collections' ns in the spike frames.
+    spike_gc_ns: u64,
+    /// Per slot in a spike frame's top [`SPIKE_TOP`]: `(frames, ns)`.
+    spike_top: std::collections::HashMap<u32, (u32, u64)>,
+    gc: u64,
+    /// The Lua collections' ns, all told and the most in one frame.
+    gc_ns: u64,
+    gc_ns_max: u64,
+    timed_frames: u32,
+}
+
+/// One frame's Lua collections: how many, and their wall ns.
+#[derive(Clone, Copy, Default)]
+struct FrameGc {
+    runs: u64,
+    ns: u64,
+}
+
+struct WorstFrame {
+    ms: f32,
+    at: f32,
+    gc: FrameGc,
+    /// The main thread's ns inside systems that frame.
+    main_ns: u64,
+    top: Vec<SlotTime>,
+}
+
+impl SysWindow {
+    /// Folds one frame of `ms` (wall, `Last` to `Last`) at `at` s, with `gc` Lua collections in it.
+    fn add_frame(&mut self, at: f32, ms: f32, frame: &[SlotTime], gc: FrameGc) {
+        self.gc += gc.runs;
+        self.gc_ns += gc.ns;
+        self.gc_ns_max = self.gc_ns_max.max(gc.ns);
+        let spike = ms > SPIKE_MS;
+        if spike {
+            self.spikes += 1;
+            if gc.runs > 0 {
+                self.spikes_with_gc += 1;
+                self.spike_gc_ns += gc.ns;
+            }
+        }
+        if frame.is_empty() {
+            return;
+        }
+        self.timed_frames += 1;
+        for t in frame {
+            let i = t.slot as usize;
+            if self.slots.len() <= i {
+                self.slots.resize(i + 1, [0; 3]);
+            }
+            let s = &mut self.slots[i];
+            s[0] += t.ns;
+            s[1] += t.main_ns;
+            s[2] = s[2].max(t.ns);
+        }
+        let worse = self.worst.as_ref().is_none_or(|w| ms > w.ms);
+        if !(spike || worse) {
+            return;
+        }
+        let mut top = frame.to_vec();
+        top.sort_by(|a, b| b.ns.cmp(&a.ns));
+        if spike {
+            for t in top.iter().take(SPIKE_TOP) {
+                let e = self.spike_top.entry(t.slot).or_default();
+                e.0 += 1;
+                e.1 += t.ns;
+            }
+        }
+        if worse {
+            top.truncate(TOP_SYSTEMS);
+            self.worst = Some(WorstFrame {
+                ms,
+                at,
+                gc,
+                main_ns: frame.iter().map(|t| t.main_ns).sum(),
+                top,
+            });
+        }
+    }
+
+    /// The window's lines, each starting with two spaces; `frames` is the window's frame count
+    /// and `name` a slot's printed name.
+    fn lines(
+        &self,
+        frames: usize,
+        lua: Option<(f64, u64)>,
+        name: impl Fn(u32) -> String,
+    ) -> String {
+        let ms = |ns: u64| ns as f64 / 1e6;
+        let per = |ns: u64| ms(ns) / frames.max(1) as f64;
+        let mut out = String::new();
+        if self.timed_frames > 0 {
+            let mut order: Vec<usize> = (0..self.slots.len())
+                .filter(|&i| self.slots[i][0] > 0)
+                .collect();
+            order.sort_by(|&a, &b| self.slots[b][0].cmp(&self.slots[a][0]));
+            let list: Vec<String> = order
+                .iter()
+                .take(TOP_SYSTEMS)
+                .map(|&i| {
+                    let [ns, main, max] = self.slots[i];
+                    format!(
+                        "{} {:.2} ({:.2}) max {:.1}",
+                        name(i as u32),
+                        per(ns),
+                        per(main),
+                        ms(max)
+                    )
+                })
+                .collect();
+            out.push_str(&format!(
+                "  systems, wall ms a frame (main thread's share) and most in one frame: {}\n",
+                list.join(" | ")
+            ));
+        }
+        if let Some(w) = &self.worst {
+            let list: Vec<String> = w
+                .top
+                .iter()
+                .map(|t| format!("{} {:.1}", name(t.slot), ms(t.ns)))
+                .collect();
+            out.push_str(&format!(
+                "  worst frame {:.1} ms at t={:.1}, lua gc {} ({:.1} ms), main thread in systems {:.1} \
+                 ms: {}\n",
+                w.ms,
+                w.at,
+                w.gc.runs,
+                ms(w.gc.ns),
+                ms(w.main_ns),
+                list.join(", ")
+            ));
+        }
+        if self.spikes > 0 {
+            let mut tally: Vec<(&u32, &(u32, u64))> = self.spike_top.iter().collect();
+            tally.sort_by(|a, b| b.1 .0.cmp(&a.1 .0).then(b.1 .1.cmp(&a.1 .1)));
+            let list: Vec<String> = tally
+                .iter()
+                .take(SPIKE_LIST)
+                .map(|(&slot, &(n, ns))| {
+                    format!("{} x{n} avg {:.1}", name(slot), ms(ns) / f64::from(n))
+                })
+                .collect();
+            out.push_str(&format!(
+                "  spikes over {SPIKE_MS:.0} ms: {}, {} with a lua gc ({:.1} ms in all); in their top \
+                 {SPIKE_TOP}: {}\n",
+                self.spikes,
+                self.spikes_with_gc,
+                ms(self.spike_gc_ns),
+                list.join(", ")
+            ));
+        }
+        if let Some((mb, total)) = lua {
+            out.push_str(&format!(
+                "  lua: heap {mb:.1} MB, {} collections this window taking {:.1} ms (most in a frame \
+                 {:.1}), {total} in all\n",
+                self.gc,
+                ms(self.gc_ns),
+                ms(self.gc_ns_max)
+            ));
+        }
+        out
+    }
 }
 
