+    /// The window lists systems by total, names the worst frame's, and tallies the spikes' tops.
+    #[test]
+    fn the_systems_window_names_the_costly_and_the_spikes() {
+        let t = |slot, ms: u64, main_ms: u64| SlotTime {
+            slot,
+            ns: ms * 1_000_000,
+            main_ns: main_ms * 1_000_000,
+        };
+        let mut w = SysWindow::default();
+        let none = FrameGc::default();
+        let one = FrameGc {
+            runs: 1,
+            ns: 50_000_000,
+        };
+        w.add_frame(1.0, 10.0, &[t(0, 2, 2), t(1, 1, 0)], none);
+        w.add_frame(1.1, 80.0, &[t(0, 2, 2), t(1, 60, 60), t(2, 5, 0)], one);
+        w.add_frame(1.2, 12.0, &[t(0, 2, 2)], none);
+        let names = ["a::steady", "b::spiky", "c::other"];
+        let text = w.lines(3, Some((12.5, 40)), |s| names[s as usize].to_string());
+        let lines: Vec<&str> = text.lines().collect();
+        assert_eq!(lines.len(), 4, "{text}");
+        // b: 61 ms over 3 frames.
+        assert!(
+            lines[0].contains("b::spiky 20.33 (20.00) max 60.0 | a::steady 2.00 (2.00) max 2.0"),
+            "{}",
+            lines[0]
+        );
+        assert!(lines[1].starts_with("  worst frame 80.0 ms at t=1.1, lua gc 1 (50.0 ms), main thread in systems 62.0 ms: b::spiky 60.0, c::other 5.0, a::steady 2.0"), "{}", lines[1]);
+        assert!(lines[2].contains("spikes over 33 ms: 1, 1 with a lua gc (50.0 ms in all); in their top 3: b::spiky x1 avg 60.0"), "{}", lines[2]);
+        assert!(lines[3].contains("heap 12.5 MB, 1 collections this window taking 50.0 ms (most in a frame 50.0), 40 in all"), "{}", lines[3]);
+    }
+
     #[test]
     fn no_adapter_says_so() {
         assert!(adapter_lines(None).starts_with("gpu: unknown"));
