+/// The strike last logged while the world's sound was off, so each is logged once.
+#[derive(Resource, Default)]
+pub(super) struct SilentStrikes(Option<(u64, i64)>);
+
+/// The storm's strike: Blasted Lands' ambient lightning bolt, the one environmental strike in
+/// 1.12's sound table. Classic has no weather thunder kit: its weather kits are rain, snow and
+/// sandstorm loops, and every kit named for thunder is Thunder Bluff, a thunder lizard, Thunderaan
+/// or Thunder Clap (Wowhead's Classic sound database, whose kit ids match 1.12's SoundEntries).
+/// Take 273's storm was silent: the second round looked only for a kit named for thunder.
+pub(super) const STRIKE_KIT: u32 = 4936;
+pub(super) const STRIKE_KIT_NAME: &str = "BlastedLandsLightningbolt01Stan";
+
+/// The strike's kit, looked up once ([`strike_kit`]) and what it resolves to logged; nothing (a
+/// silent storm) if 1.12's data has no such kit.
+fn find_thunder(catalog: &benilla_formats::SoundKitCatalog) -> Option<u32> {
+    let found = strike_kit(
+        catalog
+            .iter()
+            .map(|k| (k.id, k.name.as_str(), k.files.len())),
+    );
+    match found {
+        Some(id) => {
+            let kit = catalog.get(id);
+            let name = kit.map_or("", |k| k.name.as_str());
+            let files: Vec<&str> = kit
+                .map(|k| k.files.iter().map(|(f, _)| f.as_str()).collect())
+                .unwrap_or_default();
+            info!(
+                "weather: lightning plays kit {id} ({name}): {} file(s): {}",
+                files.len(),
+                files.join(", ")
+            );
+            Some(id)
+        }
+        None => {
+            info!(
+                "weather: no kit {STRIKE_KIT} ({STRIKE_KIT_NAME}) with a file in SoundEntries; \
+                 lightning is silent"
+            );
+            None
+        }
+    }
+}
+
+/// The strike among `(id, name, file count)` kits: [`STRIKE_KIT`] by its id, else a kit named
+/// [`STRIKE_KIT_NAME`] (ignoring case), and only with a file to play; `None` for a silent storm.
+fn strike_kit<'a>(kits: impl Iterator<Item = (u32, &'a str, usize)>) -> Option<u32> {
+    let mut by_name = None;
+    for (id, name, files) in kits {
+        if files == 0 {
+            continue;
+        }
+        if id == STRIKE_KIT {
+            return Some(id);
+        }
+        if name.eq_ignore_ascii_case(STRIKE_KIT_NAME) {
+            by_name = Some(by_name.map_or(id, |b: u32| b.min(id)));
+        }
+    }
+    by_name
+}
+
+/// Queues each new strike's thunder after its delay and plays what is due, 2D on the ambience.
+#[allow(clippy::too_many_arguments)]
+fn thunder(
+    real: Res<Time<bevy::time::Real>>,
+    look: Option<Res<WeatherLook>>,
+    kits: Option<ResMut<SoundKits>>,
+    assets: Option<Res<WorldAssets>>,
+    mut out: NonSendMut<SoundOutput>,
+    config: Res<SoundConfig>,
+    listener: Res<AudioListener>,
+    mut st: ResMut<Thunder>,
+) {
+    use benilla_world::look::weather::tune;
+    let now = real.elapsed_secs_f64();
+    if let Some(k) = look.as_ref().filter(|l| l.on).and_then(|l| l.strike) {
+        let key = (k.seed, k.id);
+        if st.heard != Some(key) {
+            st.heard = Some(key);
+            let since = look.as_ref().map_or(0.0, |l| l.since_cue);
+            let wait = k.at + f64::from(k.thunder_after) - since;
+            // A strike long past (a hero arriving mid-storm) has had its thunder.
+            if wait > -1.0 {
+                let far = (k.thunder_after - tune::THUNDER_AFTER_MIN_S)
+                    / (tune::THUNDER_AFTER_MAX_S - tune::THUNDER_AFTER_MIN_S);
+                let (loud, pitch) = strike_variation(k.seed, k.id);
+                st.due.push((
+                    now + wait.max(0.0),
+                    k.power * (1.0 - 0.4 * far) * loud,
+                    pitch,
+                ));
+            }
+        }
+    }
+    if st.due.iter().all(|(at, _, _)| *at > now) {
+        return;
+    }
+    let (Some(mut kits), Some(assets)) = (kits, assets) else {
+        return;
+    };
+    let kit = *st.kit.get_or_insert_with(|| find_thunder(kits.catalog()));
+    let due: Vec<(f32, f32)> = st
+        .due
+        .iter()
+        .filter(|(at, _, _)| *at <= now)
+        .map(|(_, loud, pitch)| (*loud, *pitch))
+        .collect();
+    st.due.retain(|(at, _, _)| *at > now);
+    let Some(id) = kit else {
+        // Take 280 could not tell whether the storm thundered: say so in client.log.
+        if !due.is_empty() && !st.told_silent {
+            st.told_silent = true;
+            info!("weather: a strike's thunder is silent: no kit to play (see the kit line above)");
+        }
+        return;
+    };
+    for (loud, pitch) in due {
+        // One line a clap, so the rig can match each flash to its thunder without audio.
+        info!("weather: a strike's thunder plays kit {id} (volume {loud:.2}, pitch {pitch:.2})");
+        if let Err(e) = play_kit_ext(
+            &mut kits,
+            &assets,
+            &mut out,
+            &config,
+            listener.pos,
+            KitRef::Id(id),
+            None,
+            SoundCategory::Ambience,
+            PlayExtras {
+                volume_mult: Volume(loud),
+                pitch: Pitch(pitch),
+                // Two flashes of a pair land close: each strike is heard.
+                dedupe_exempt: true,
+                ..Default::default()
+            },
+        ) {
+            warn!("weather: thunder kit {id} — {e:#}");
         }
     }
 }
 
+/// While the world's sound is off (no output device), the thunder system does not run: each strike
+/// that flashes says so in client.log instead, so a silent film is not taken for a silent storm.
+fn note_silent_thunder(look: Option<Res<WeatherLook>>, mut last: ResMut<SilentStrikes>) {
+    let Some(k) = look.as_ref().filter(|l| l.on).and_then(|l| l.strike) else {
+        return;
+    };
+    let key = (k.seed, k.id);
+    if last.0 != Some(key) {
+        last.0 = Some(key);
+        info!("weather: a strike flashed, but the world's sound is off, so no thunder");
+    }
+}
+
+/// A strike's own volume (a share) and pitch (a playback rate), so the one kit never repeats the
+/// same: within [`STRIKE_VOLUME_JITTER`] under full and [`STRIKE_PITCH_JITTER`] either way,
+/// fixed by the strike (its cue's seed and slot), the same for every hero who sees it.
+fn strike_variation(seed: u64, slot: i64) -> (f32, f32) {
+    let mut h = seed ^ (slot as u64).wrapping_mul(0x9E37_79B9_7F4A_7C15);
+    let mut roll = || {
+        h = h.wrapping_add(0x9E37_79B9_7F4A_7C15);
+        let mut z = h;
+        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
+        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
+        ((z ^ (z >> 31)) >> 40) as f32 / (1u64 << 24) as f32
+    };
+    let loud = 1.0 - STRIKE_VOLUME_JITTER * roll();
+    let pitch = 1.0 + STRIKE_PITCH_JITTER * (2.0 * roll() - 1.0);
+    (loud, pitch)
+}
+
+/// How much quieter a strike may play than the kit (a share).
+const STRIKE_VOLUME_JITTER: f32 = 0.25;
+/// How far a strike's playback rate may stray from the kit's (a share, either way).
+const STRIKE_PITCH_JITTER: f32 = 0.06;
+
 /// Registration hook for [`super::SoundPlugin`].
 pub(super) fn plugin(app: &mut App) {
     app.init_resource::<WeatherAmbience>()
