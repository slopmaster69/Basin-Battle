+/// The thunder: the kit it plays (looked up once), the strike last heard, and the claps waiting
+/// for their delay (real seconds, loudness).
+#[derive(Resource, Default)]
+pub(super) struct Thunder {
+    kit: Option<Option<u32>>,
+    heard: Option<(u64, i64)>,
+    /// The strikes waiting for their delay: when (real seconds), how loud, at what pitch.
+    due: Vec<(f64, f32, f32)>,
+    /// Whether a strike with no kit to play was logged (once).
+    told_silent: bool,
+}
