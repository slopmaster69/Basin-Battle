+//! Visible weather, the new look's own (no reference behaviour): Elwynn in a summer shower. The
+//! server sends 1.12's own `SMSG_WEATHER` (rain at a grade, [`crate::weather::WeatherState`]); 1.12
+//! clouds its sky by the grade's first quarter and drops rain past it, and this reads the same
+//! state and dresses it:
+//! 1. **overcast** (the sky density, `storm_blend`): the painted clouds (`look::sky`), the mist
+//!    (`look::mist`) and the wind (`look::wind`) already follow it; here the sun's light dims and
+//!    cools ([`apply_atmosphere`]), the god rays dim and the grade's warmth fades
+//!    ([`apply_post`]), and the sun shadows fade toward the soft light of a grey day
+//!    ([`shadow_scale`]);
+//! 2. **rain** (the rain's effect density): 1.12's own drops, drawn as streaks lit by the hour's
+//!    light and the torches near them and leaning in the wind (`weather::precip`, [`StreakLight`]);
+//!    rings on the water (`liquid.wgsl`, the water block's row 9 `.w`); the ground, stone and roofs
+//!    darkening with a soft wet sheen that catches the sun, the sky and the torches while it rains
+//!    and dries slowly after ([`wet_step`], `terrain.wgsl` and `static_gx.wgsl`'s `look_wet`);
+//! 3. **a storm** (rain near its top grade, [`storminess`]): gustier wind, and now and then
+//!    lightning, a brief cool flash that lights the world and the bloom picks up, with thunder a
+//!    few seconds after ([`flash_at`]). The strikes run from the weather packet now showing (its
+//!    arrival, seeded by the server's day and the packet's grade), so every hero who heard it
+//!    sees the same flashes, and the server's storm cue (a packet every so often, its grade a
+//!    hair apart each time) keeps the pattern from repeating and brings a hero who came in
+//!    mid-storm into step. Not the server's game clock: Elwynn's is pinned at 23:30 and set back
+//!    every five minutes.
+//!
+//! Every tunable is in [`tune`]. `worldWeather 0` ([`LookWeather::on`]) turns all of it off on its
+//! own, leaving 1.12's weather under the rest of the new look; `lookweather <clear|overcast|rain|
+//! storm> [0-1]` holds a weather locally for film through the wire's own path (so 1.12's own rain
+//! and `worldLook 0` show it too), `lookweather server` (or `grade`) follows the server's again.
+//! `worldLook 0` is 1.12's weather exactly.
+
+use benilla_formats::Atmosphere;
+use bevy::prelude::*;
+
+use super::{PostLook, WorldLook};
+use crate::lighting::WorldTime;
+use crate::weather::{storm_blend, WeatherKind, WeatherState};
+
+/// Every tunable of the visible weather, in one place. A first pass, to tune on film with
+/// `lookweather`. Shares are of the light or the colour they act on, times in seconds.
+pub mod tune {
+    // ---- the wire: what a weather is in 1.12's `SMSG_WEATHER` (the server's `[weather]` in
+    // `content/survival.toml` writes the same) ----
+    /// Overcast is rain at a grade up to this: 1.12 clouds the sky over the grade's first quarter
+    /// and drops nothing below it.
+    pub const OVERCAST_TOP: f32 = 0.25;
+    /// Rain from this grade to [`RAIN_TO`] as its intensity goes 0 to 1; a storm from
+    /// [`STORM_FROM`] to 1.
+    pub const RAIN_FROM: f32 = 0.3;
+    pub const RAIN_TO: f32 = 0.8;
+    pub const STORM_FROM: f32 = 0.85;
+    /// `lookweather <kind>` with no intensity.
+    pub const DEFAULT_INTENSITY: f32 = 0.7;
+    /// A rain's sound loop by grade, vmangos' `Weather::GetSound`: light below 0.4, medium below
+    /// 0.7, heavy above; none while it only clouds over.
+    pub const SOUND_LIGHT: u32 = 8533;
+    pub const SOUND_MEDIUM: u32 = 8534;
+    pub const SOUND_HEAVY: u32 = 8535;
+
+    // ---- overcast ----
+    /// The share of the sun's light a full overcast takes, and the cool it leaves on the rest.
+    pub const SUN_DIM: f32 = 0.5;
+    /// By night ([`super::night_share`]) the overcast takes this share of the moon's light
+    /// instead: Goldshire in rain at 23:30 filmed near-black and murky at [`SUN_DIM`], darker and
+    /// flatter than the dry frame from the same spot, where the night is already dark.
+    pub const NIGHT_SUN_DIM: f32 = 0.15;
+    /// The share of the weather's lift of the mist (`look::mist::weather_scale`) kept by night:
+    /// the night's mist is the night's dark fog colour, and three to four times of it flattened
+    /// the night-rain film into a murk.
+    pub const NIGHT_MIST: f32 = 0.4;
+    /// By night the overcast takes over 1.12's storm fog (its `LightParams`: a negative start, a
+    /// grey veil about a third thick at the eye, and a short end that whites out the middle
+    /// distance): take 273's night rain at Goldshire sat in a 20-level grey band (90% of pixels
+    /// between 26 and 46 of 255), the dark woods lifted to a veil, and `worldWeather 0` just as
+    /// flat, so the murk was 1.12's rain fog under the night grade. At full overcast by night the
+    /// fog starts at least this share of its end out, its end goes this many times further, and its
+    /// colour and the sky's keep these shares: darker, and the contrast kept.
+    pub const NIGHT_FOG_START: f32 = 0.1;
+    pub const NIGHT_FOG_END: f32 = 1.8;
+    pub const NIGHT_FOG_DIM: f32 = 0.45;
+    pub const NIGHT_SKY_DIM: f32 = 0.6;
+    pub const SUN_COOL: [f32; 3] = [0.84, 0.9, 1.0];
+    /// The ambient (the sky's light in the shade) under a full overcast: a touch cooler.
+    pub const AMBIENT_COOL: [f32; 3] = [0.94, 0.98, 1.04];
+    /// What a full overcast takes of the god rays, the grade's warmth and its saturation.
+    pub const RAYS_DIM: f32 = 0.9;
+    pub const WARMTH_DIM: f32 = 0.7;
+    pub const SATURATION_DIM: f32 = 0.12;
+    /// The share of the sun shadows' strength a full overcast takes: a grey day's soft shade.
+    pub const SHADOW_FADE: f32 = 0.6;
+
+    // ---- rain ----
+    /// The rain density that soaks the ground fully; lighter rain wets it to its share.
+    pub const WET_FULL_AT: f32 = 0.5;
+    /// Seconds of rain to soak dry ground, and seconds to dry soaked ground once it stops.
+    pub const WET_RISE_S: f32 = 45.0;
+    pub const DRY_S: f32 = 300.0;
+    /// Soaked ground: how much darker (a share of its light), how strong its sheen, and how sharp.
+    pub const WET_DARKEN: f32 = 0.3;
+    /// How much darker soaked ground is by night: the night's ground is dark already, and the
+    /// night-rain film's cobbles went near-black at [`WET_DARKEN`].
+    pub const NIGHT_WET_DARKEN: f32 = 0.1;
+    pub const WET_SHEEN: f32 = 0.5;
+    pub const WET_SHININESS: f32 = 40.0;
+    /// The wet block's shape (`look_wet` in `terrain.wgsl` and `static_gx.wgsl`, mirrored there as
+    /// WGSL constants; the tests compare them): how wet a wall gets beside the ground, the sky's
+    /// sheen at a grazing angle, a torch's reflection, and how patchy the soak is.
+    pub const WET_WALL: f32 = 0.45;
+    pub const WET_SKY: f32 = 0.35;
+    /// 1.2, was 0.8 on a Blinn lobe inside the torch's own radius: the night-rain film's cobbles
+    /// showed no sheen and the lamp pools barely reached the ground. A lamp (or a window's light,
+    /// a building's MOLT light) now lies on the wet ground as its reflection: a streak running
+    /// from under it toward the camera, [`WET_LANE_ACROSS`] radians wide and [`WET_LANE_ALONG`]
+    /// long in the mirrored ray's angle off the light, out to [`WET_TORCH_REACH`] times the light's
+    /// radius, brightest in the puddles ([`WET_PUDDLE`]).
+    pub const WET_TORCH: f32 = 1.2;
+    /// 4.0, was 2.5: take 280's road lay 27 to 41 yd from the lamps (a 10 yd pool each), and a
+    /// lamp's streak toward the camera, which lies about halfway between, was down to an eighth
+    /// at 20 yd out; it now keeps half there.
+    pub const WET_TORCH_REACH: f32 = 4.0;
+    pub const WET_LANE_ACROSS: f32 = 0.06;
+    pub const WET_LANE_ALONG: f32 = 0.45;
+    /// The share of the ground that holds a puddle (where the soak's noise runs high), which
+    /// mirrors a light fully; the rest of the wet ground this share less.
+    pub const WET_PUDDLE: f32 = 0.6;
+    pub const WET_PATCH: f32 = 0.35;
+    /// The streaks: how much of the hour's light (ambient plus half the sun) and of a torch's they
+    /// catch, how opaque at their head (the tail fades out), how far a torch's light reaches them
+    /// (yd, at most its own range), and how many of the torches nearest the camera.
+    /// 2.0, was 0.8, and the reach 1.6 times a torch's own range (was its range, at most 12 yd):
+    /// on the night-rain film the streaks hardly caught the lamps.
+    pub const STREAK_LIGHT: f32 = 0.4;
+    pub const STREAK_TORCH: f32 = 2.0;
+    pub const STREAK_ALPHA: f32 = 0.55;
+    pub const STREAK_TORCH_RANGE: f32 = 1.6;
+    pub const TORCH_REACH: f32 = 16.0;
+    pub const MAX_TORCHES: usize = 8;
+    /// The streaks lean downwind: yards of lean on a 2 yd streak per unit of the wind's strength.
+    pub const STREAK_LEAN: f32 = 0.3;
+    /// The rings on the water at full rain (`liquid.wgsl`'s `rain_rings` strength).
+    pub const RINGS: f32 = 1.0;
+
+    // ---- a storm ----
+    /// A storm is rain whose density climbs from the first to the second (grade 0.85 and up).
+    pub const STORM_DENSITY_FROM: f32 = 0.75;
+    pub const STORM_DENSITY_TO: f32 = 0.95;
+    /// What a full storm adds to the wind's gusts (a share of them).
+    pub const STORM_GUST: f32 = 0.8;
+    /// Lightning: the time since the weather's cue is cut into slots this long, and in a full storm
+    /// a slot holds a strike at this chance, so one about every 30 s; a strike's power rolls
+    /// between these.
+    pub const STRIKE_SLOT_S: f64 = 3.0;
+    pub const STRIKE_CHANCE: f32 = 0.1;
+    pub const POWER_MIN: f32 = 0.55;
+    pub const POWER_MAX: f32 = 1.0;
+    /// The flash: a sharp first flare fading over this, a flicker after it at this delay and
+    /// share, and nothing after this long.
+    pub const FLASH_FADE_S: f32 = 0.07;
+    /// The flash rises over this long (two or three frames) to this peak, where it was one frame's
+    /// white-out at full: take 273 caught a frame mean of 140 to 160 out of 255, the hero all but
+    /// gone into the fog. Softer, more Wind Waker than camera flash. 0.09 s, was 0.035, which is
+    /// one frame at the rig's 30 fps: take 280 saw each flash jump in a single frame (a frame mean
+    /// of 67 to 100) and fade over four or five. Now it climbs over three frames at 30 fps (five
+    /// at 60), and the flicker comes later (0.24 s, was 0.17) so it stays apart from the flare.
+    pub const FLASH_RISE_S: f32 = 0.09;
+    pub const FLASH_PEAK: f32 = 0.7;
+    pub const FLICKER_AT_S: f32 = 0.24;
+    pub const FLICKER: f32 = 0.6;
+    pub const FLASH_LEN_S: f32 = 0.6;
+    /// What a full flash adds to the ambient (sRGB, cool), to the sky's stops and the fog, and to
+    /// the bloom.
+    pub const FLASH_AMBIENT: [f32; 3] = [0.5, 0.56, 0.72];
+    pub const FLASH_SKY: [f32; 3] = [0.35, 0.4, 0.55];
+    pub const FLASH_BLOOM: f32 = 0.25;
+    /// The thunder comes this long after its flash (the strike's distance), louder the nearer.
+    /// 0.3 to 1.5 s, were 1.2 to 6.0: the strike is Blasted Lands' lightning bolt (kit 4936), a
+    /// close crack, heard a moment after its flash.
+    pub const THUNDER_AFTER_MIN_S: f32 = 0.3;
+    pub const THUNDER_AFTER_MAX_S: f32 = 1.5;
+}
+
+/// A weather `lookweather` holds, or the server sends.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Sky {
+    Clear,
+    Overcast,
+    Rain,
+    Storm,
+}
+
+impl Sky {
+    fn parse(w: &str) -> Option<Self> {
+        Some(match w.to_ascii_lowercase().as_str() {
+            "clear" | "fine" => Sky::Clear,
+            "overcast" | "cloudy" => Sky::Overcast,
+            "rain" => Sky::Rain,
+            "storm" => Sky::Storm,
+            _ => return None,
+        })
+    }
+
+    pub fn name(self) -> &'static str {
+        match self {
+            Sky::Clear => "clear",
+            Sky::Overcast => "overcast",
+            Sky::Rain => "rain",
+            Sky::Storm => "storm",
+        }
+    }
+
+    /// The weather at `intensity` (0 to 1) as 1.12's wire: (type, grade). Clear is type 0; the rest
+    /// are rain (type 1) at a grade in its band.
+    pub fn wire(self, intensity: f32) -> (u32, f32) {
+        let i = intensity.clamp(0.0, 1.0);
+        match self {
+            Sky::Clear => (0, 0.0),
+            Sky::Overcast => (1, tune::OVERCAST_TOP * i),
+            Sky::Rain => (1, tune::RAIN_FROM + (tune::RAIN_TO - tune::RAIN_FROM) * i),
+            Sky::Storm => (1, tune::STORM_FROM + (1.0 - tune::STORM_FROM) * i),
+        }
+    }
+}
+
+/// The rain sound loop for a wire weather (type, grade): vmangos' thresholds, none while the rain
+/// only clouds the sky.
+pub fn wire_sound(kind: u32, grade: f32) -> u32 {
+    if kind != 1 || grade <= tune::OVERCAST_TOP {
+        0
+    } else if grade < 0.4 {
+        tune::SOUND_LIGHT
+    } else if grade < 0.7 {
+        tune::SOUND_MEDIUM
+    } else {
+        tune::SOUND_HEAVY
+    }
+}
+
+/// `worldWeather` and the film's hold: `on` (on by default, inert under the classic look);
+/// `force` holds a weather at an intensity, whatever the server says (`lookweather`).
+#[derive(Resource, Clone, Copy, Debug, PartialEq)]
+pub struct LookWeather {
+    pub on: bool,
+    pub force: Option<(Sky, f32)>,
+}
+
+impl Default for LookWeather {
+    /// On, the `worldWeather` CVar's registered "1", following the server.
+    fn default() -> Self {
+        Self {
+            on: true,
+            force: None,
+        }
+    }
+}
+
+/// What `lookweather`'s arguments ask.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum WeatherCommand {
+    /// Hold this weather at this intensity.
+    Hold(Sky, f32),
+    /// Follow the server's (`server` or `grade`).
+    Follow,
+    /// Say what is on (no argument).
+    Show,
+}
+
+impl LookWeather {
+    /// `lookweather`'s arguments: `<clear|overcast|rain|storm> [0-1]`, `server` or `grade`, or
+    /// nothing; `None` for anything else, which changes nothing.
+    pub fn parse(args: &str) -> Option<WeatherCommand> {
+        let mut words = args.split_whitespace();
+        let cmd = match words.next() {
+            None => WeatherCommand::Show,
+            Some(w) if w.eq_ignore_ascii_case("server") || w.eq_ignore_ascii_case("grade") => {
+                WeatherCommand::Follow
+            }
+            Some(w) => {
+                let sky = Sky::parse(w)?;
+                let i = match words.next() {
+                    None => tune::DEFAULT_INTENSITY,
+                    Some(v) => v.parse::<f32>().ok().filter(|i| (0.0..=1.0).contains(i))?,
+                };
+                WeatherCommand::Hold(sky, i)
+            }
+        };
+        words.next().is_none().then_some(cmd)
+    }
+}
+
+/// A lightning strike: its slot and seed (the same on every client that heard the cue), when it
+/// flashes (seconds after the cue), how bright, and how long until its thunder.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Strike {
+    pub id: i64,
+    pub seed: u64,
+    pub at: f64,
+    pub power: f32,
+    pub thunder_after: f32,
+}
+
+/// This frame's weather look, published before the light is resolved: the lighting resolve, the
+/// post pass, the shadows, the water, the rain streaks, the ground's wetness and the thunder read
+/// it. All zero (and `on` false) under the classic look or `worldWeather 0`.
+#[derive(Resource, Clone, Copy, Debug, PartialEq, Default)]
+pub struct WeatherLook {
+    pub on: bool,
+    /// The overcast, 0 clear to 1 (1.12's storm blend of the sky density).
+    pub overcast: f32,
+    /// The rain's density, 0 to 1 (none for snow or sand).
+    pub rain: f32,
+    /// How much of a storm it is, 0 to 1 ([`storminess`]).
+    pub storm: f32,
+    /// How wet the ground is, 0 dry to 1 soaked ([`wet_step`]).
+    pub wet: f32,
+    /// How much it is night, 0 by day to 1 ([`night_share`]): an overcast dims the night less, wet
+    /// ground darkens less and the weather's mist lifts less.
+    pub night: f32,
+    /// The lightning's flash this frame, 0 to about 1.
+    pub flash: f32,
+    /// The latest strike that has flashed, for its thunder.
+    pub strike: Option<Strike>,
+    /// Seconds since the weather's cue (the packet now showing), which the strikes run on.
+    pub since_cue: f64,
+    /// The rain loop a held weather plays (`lookweather`), `None` to follow the server's.
+    pub sound_kit: Option<u32>,
+}
+
+impl WeatherLook {
+    /// The shared light's weather lanes (`global_light`): row 19 `.z` how much darker wet ground
+    /// is, row 20 `.z` its sheen and `.w` the sheen's sharpness; all zero when dry or off.
+    pub fn lanes(&self) -> [f32; 3] {
+        if !self.on || self.wet <= 0.0 {
+            return [0.0; 3];
+        }
+        let darken = tune::WET_DARKEN + (tune::NIGHT_WET_DARKEN - tune::WET_DARKEN) * self.night;
+        [
+            darken * self.wet,
+            tune::WET_SHEEN * self.wet,
+            tune::WET_SHININESS,
+        ]
+    }
+
+    /// The rings on the water: the water block's row 9 `.w`.
+    pub fn rings(&self) -> f32 {
+        if self.on {
+            tune::RINGS * self.rain
+        } else {
+            0.0
+        }
+    }
+}
+
+/// How much it is night at `minute` of the game day, 0 by day to 1: the torches' own night
+/// (`look::lights::night_weight`) without its day floor.
+pub fn night_share(minute: f32) -> f32 {
+    let floor = super::lights::tune::DAY_FLOOR;
+    ((super::lights::night_weight(minute) - floor) / (1.0 - floor)).clamp(0.0, 1.0)
+}
+
+/// The weather's lift of the mist (`look::mist::weather_scale`) at `night` ([`night_share`]):
+/// [`tune::NIGHT_MIST`] of it by night.
+pub fn mist_lift(lift: f32, night: f32) -> f32 {
+    lift * (1.0 + (tune::NIGHT_MIST - 1.0) * night.clamp(0.0, 1.0))
+}
+
+fn smoothstep(e0: f32, e1: f32, x: f32) -> f32 {
+    let t = ((x - e0) / (e1 - e0)).clamp(0.0, 1.0);
+    t * t * (3.0 - 2.0 * t)
+}
+
+/// How much of a storm the rain's density is: none below [`tune::STORM_DENSITY_FROM`], full at
+/// [`tune::STORM_DENSITY_TO`].
+pub fn storminess(rain: f32) -> f32 {
+    smoothstep(tune::STORM_DENSITY_FROM, tune::STORM_DENSITY_TO, rain)
+}
+
+/// One step of the ground's wetness: toward the rain's soak ([`tune::WET_FULL_AT`]), rising over
+/// [`tune::WET_RISE_S`] and drying over [`tune::DRY_S`].
+pub fn wet_step(wet: f32, rain: f32, dt: f32) -> f32 {
+    let target = (rain / tune::WET_FULL_AT).clamp(0.0, 1.0);
+    let dt = dt.max(0.0);
+    if target > wet {
+        (wet + dt / tune::WET_RISE_S).min(target)
+    } else {
+        (wet - dt / tune::DRY_S).max(target)
+    }
+}
+
+fn mix64(x: u64) -> u64 {
+    let mut z = x.wrapping_add(0x9E37_79B9_7F4A_7C15);
+    z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
+    z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
+    z ^ (z >> 31)
+}
+
+fn unit64(h: u64) -> f32 {
+    (h >> 40) as f32 / (1u64 << 24) as f32
+}
+
+/// Mixed into the slot so the lightning's dice are its own.
+const STRIKE_SALT: u64 = 0x6C69_6768_746E_696E; // "lightnin"
+
+/// The cue's seed: the server's day and the packet's grade bits.
+pub fn cue_seed(day: i64, grade_bits: u32) -> u64 {
+    mix64((day as u64).rotate_left(32) ^ u64::from(grade_bits) ^ STRIKE_SALT)
+}
+
+/// The strike in slot `slot` after a cue of `seed` at `storm`, if it holds one.
+pub fn strike_in(seed: u64, slot: i64, storm: f32) -> Option<Strike> {
+    let h = mix64(slot as u64 ^ seed);
+    if storm <= 0.0 || unit64(h) >= tune::STRIKE_CHANCE * storm {
+        return None;
+    }
+    let roll = |k: u64| unit64(mix64(h ^ k));
+    let slot_s = tune::STRIKE_SLOT_S;
+    let room = (slot_s - f64::from(tune::FLASH_LEN_S)).max(0.0);
+    Some(Strike {
+        id: slot,
+        seed,
+        at: slot as f64 * slot_s + room * f64::from(roll(1)),
+        power: tune::POWER_MIN + (tune::POWER_MAX - tune::POWER_MIN) * roll(2),
+        thunder_after: tune::THUNDER_AFTER_MIN_S
+            + (tune::THUNDER_AFTER_MAX_S - tune::THUNDER_AFTER_MIN_S) * roll(3),
+    })
+}
+
+/// A flash `t` seconds after its strike, at power 1: a quick rise to a flare, its fade, and a
+/// flicker, at most [`tune::FLASH_PEAK`].
+pub fn flash_shape(t: f32) -> f32 {
+    if !(0.0..tune::FLASH_LEN_S).contains(&t) {
+        return 0.0;
+    }
+    let rise = smoothstep(0.0, tune::FLASH_RISE_S, t);
+    let first = rise * (-(t - tune::FLASH_RISE_S).max(0.0) / tune::FLASH_FADE_S).exp();
+    let dt = t - tune::FLICKER_AT_S;
+    // The flicker climbs too, over half the flare's rise, so it never jumps in one frame.
+    let flicker = if dt >= 0.0 {
+        let climb = 0.5 * tune::FLASH_RISE_S;
+        tune::FLICKER
+            * smoothstep(0.0, climb, dt)
+            * (-(dt - climb).max(0.0) / tune::FLASH_FADE_S).exp()
+    } else {
+        0.0
+    };
+    // Faded to nothing at the end, so the flash never cuts off.
+    let tail = 1.0 - smoothstep(0.7 * tune::FLASH_LEN_S, tune::FLASH_LEN_S, t);
+    tune::FLASH_PEAK * (first + flicker).min(1.0) * tail
+}
+
+/// The lightning `secs` after a cue of `seed` in a storm of `storm`: this frame's flash, and the
+/// latest strike that has flashed in this slot or the last.
+pub fn flash_at(seed: u64, secs: f64, storm: f32) -> (f32, Option<Strike>) {
+    let slot = (secs / tune::STRIKE_SLOT_S).floor() as i64;
+    let mut flash = 0.0f32;
+    let mut latest = None;
+    for s in [slot - 1, slot] {
+        if let Some(k) = strike_in(seed, s, storm) {
+            let t = (secs - k.at) as f32;
+            if t >= 0.0 {
+                flash = flash.max(k.power * flash_shape(t));
+                latest = Some(k);
+            }
+        }
+    }
+    (flash, latest)
+}
+
+fn mul3(a: [f32; 3], b: [f32; 3]) -> [f32; 3] {
+    std::array::from_fn(|i| a[i] * b[i])
+}
+
+fn lerp3(a: [f32; 3], b: [f32; 3], t: f32) -> [f32; 3] {
+    std::array::from_fn(|i| a[i] + (b[i] - a[i]) * t)
+}
+
+fn add3(a: [f32; 3], b: [f32; 3], k: f32) -> [f32; 3] {
+    std::array::from_fn(|i| (a[i] + b[i] * k).clamp(0.0, 1.0))
+}
+
+/// The weather over the graded light: an overcast dims and cools the sun (the moon's light by
+/// night, less) and cools the shade a touch; a flash lights the ambient, the sky and the fog.
+/// `suppressed` (under water, a ghost) and off pass `atmo` through.
+pub fn apply_atmosphere(atmo: Atmosphere, w: &WeatherLook, suppressed: bool) -> Atmosphere {
+    if !w.on || suppressed {
+        return atmo;
+    }
+    let o = w.overcast.clamp(0.0, 1.0);
+    let mut out = atmo;
+    let dim = tune::SUN_DIM + (tune::NIGHT_SUN_DIM - tune::SUN_DIM) * w.night.clamp(0.0, 1.0);
+    let sun_k = lerp3([1.0; 3], tune::SUN_COOL, o).map(|c| c * (1.0 - dim * o));
+    out.sun_diffuse = mul3(atmo.sun_diffuse, sun_k);
+    out.ambient = mul3(atmo.ambient, lerp3([1.0; 3], tune::AMBIENT_COOL, o)).map(|c| c.min(1.0));
+    // By night, 1.12's storm fog taken over: the overcast is its storm blend, so `o · night` is
+    // how much of the night's fog is the storm's.
+    let veil = o * w.night.clamp(0.0, 1.0);
+    if veil > 0.0 {
+        let start = atmo.fog_start_frac.max(tune::NIGHT_FOG_START);
+        out.fog_start_frac = atmo.fog_start_frac + (start - atmo.fog_start_frac) * veil;
+        out.fog_end = atmo.fog_end * (1.0 + (tune::NIGHT_FOG_END - 1.0) * veil);
+        out.fog_color = atmo.fog_color.map(|c| c * (1.0 - (1.0 - tune::NIGHT_FOG_DIM) * veil));
+        for stop in &mut out.sky {
+            *stop = stop.map(|c| c * (1.0 - (1.0 - tune::NIGHT_SKY_DIM) * veil));
+        }
+    }
+    if w.flash > 0.0 {
+        out.ambient = add3(out.ambient, tune::FLASH_AMBIENT, w.flash);
+        out.fog_color = add3(out.fog_color, tune::FLASH_SKY, w.flash);
+        for stop in &mut out.sky {
+            *stop = add3(*stop, tune::FLASH_SKY, w.flash);
+        }
+    }
+    out
+}
+
+/// The weather over the grade's post values: an overcast takes the god rays, the warmth and a
+/// little saturation; a flash blooms. A neutral grade (outside a graded zone) stays neutral.
+pub fn apply_post(post: PostLook, w: &WeatherLook) -> PostLook {
+    if !w.on || post.is_neutral() {
+        return post;
+    }
+    let o = w.overcast.clamp(0.0, 1.0);
+    PostLook {
+        rays: post.rays * (1.0 - tune::RAYS_DIM * o),
+        warmth: post.warmth * (1.0 - tune::WARMTH_DIM * o),
+        saturation: post.saturation * (1.0 - tune::SATURATION_DIM * o),
+        bloom: post.bloom + tune::FLASH_BLOOM * w.flash,
+        ..post
+    }
+}
+
+/// What the weather leaves of the sun shadows' strength.
+pub fn shadow_scale(w: Option<&WeatherLook>) -> f32 {
+    match w {
+        Some(w) if w.on => 1.0 - tune::SHADOW_FADE * w.overcast.clamp(0.0, 1.0),
+        _ => 1.0,
+    }
+}
+
+/// What the rain streaks catch: the hour's light and the torches nearest the camera.
+pub struct StreakLight {
+    /// The hour's light on a streak (sRGB), already times [`tune::STREAK_LIGHT`].
+    pub base: [f32; 3],
+    /// The torches: position, reach (yd) and colour times [`tune::STREAK_TORCH`].
+    pub torches: Vec<(Vec3, f32, [f32; 3])>,
+    /// The lean of a streak's tail (yd, Bevy space), downwind.
+    pub lean: Vec3,
+}
+
+impl StreakLight {
+    /// The streaks' light from the resolved `ambient` and `diffuse`, the torches near `cam`
+    /// (position, range, colour), and the wind (downwind x, z and strength).
+    pub fn new(
+        ambient: [f32; 3],
+        diffuse: [f32; 3],
+        cam: Vec3,
+        lights: impl Iterator<Item = (Vec3, f32, [f32; 3])>,
+        wind: [f32; 3],
+    ) -> Self {
+        let base = std::array::from_fn(|i| {
+            ((ambient[i] + 0.5 * diffuse[i]) * tune::STREAK_LIGHT).clamp(0.0, 1.0)
+        });
+        let mut torches: Vec<(f32, Vec3, f32, [f32; 3])> = lights
+            .filter_map(|(p, range, rgb)| {
+                let reach = (range * tune::STREAK_TORCH_RANGE).min(tune::TORCH_REACH);
+                let d2 = p.distance_squared(cam);
+                let near = tune::TORCH_REACH + 70.0;
+                (reach > 0.0 && d2 < near * near).then_some((d2, p, reach, rgb))
+            })
+            .collect();
+        torches.sort_by(|a, b| a.0.total_cmp(&b.0));
+        torches.truncate(tune::MAX_TORCHES);
+        Self {
+            base,
+            torches: torches
+                .into_iter()
+                .map(|(_, p, r, rgb)| (p, r, rgb.map(|c| c * tune::STREAK_TORCH)))
+                .collect(),
+            lean: Vec3::new(wind[0], 0.0, wind[1]) * (wind[2] * tune::STREAK_LEAN),
+        }
+    }
+
+    /// A streak's colour at `p` (sRGB, clamped).
+    pub fn at(&self, p: Vec3) -> [f32; 3] {
+        let mut c = self.base;
+        for (q, reach, rgb) in &self.torches {
+            let d2 = p.distance_squared(*q);
+            let r2 = reach * reach;
+            if d2 < r2 {
+                let x = 1.0 - d2 / r2;
+                for i in 0..3 {
+                    c[i] += rgb[i] * x * x;
+                }
+            }
+        }
+        c.map(|v| v.clamp(0.0, 1.0))
+    }
+}
+
+/// Turns the film's hold into the wire's override (`DebugState::weather`), on a change only, so
+/// the debug panel's own override still works: a hold drives 1.12's own path, so its rain, its
+/// sky and `worldLook 0` all show it.
+pub(crate) fn drive_hold(
+    tune: Res<LookWeather>,
+    debug: Option<ResMut<crate::dev_state::DebugState>>,
+    mut last: Local<Option<(Sky, f32)>>,
+) {
+    let Some(mut debug) = debug else { return };
+    if tune.force == *last {
+        return;
+    }
+    *last = tune.force;
+    let w = &mut debug.weather;
+    match tune.force {
+        Some((sky, i)) => {
+            let (kind, grade) = sky.wire(i);
+            w.force = true;
+            w.dirty = true;
+            w.kind = kind;
+            w.grade = grade;
+            w.instant = false;
+        }
+        None => w.force = false,
+    }
+}
+
+/// Publishes this frame's [`WeatherLook`] from the switch, the hold, the weather state and the
+/// server's clock; the ground's wetness steps here.
+pub(crate) fn publish_weather(
+    look: Res<WorldLook>,
+    tune: Res<LookWeather>,
+    state: Option<Res<WeatherState>>,
+    world_time: Res<WorldTime>,
+    clock: Option<Res<crate::lighting::GameClock>>,
+    time: Res<Time<Real>>,
+    mut frame: ResMut<WeatherLook>,
+) {
+    let on = look.on && tune.on && state.is_some();
+    let since_cue = state
+        .as_ref()
+        .map_or(0.0, |s| (time.elapsed_secs_f64() - s.cue.0).max(0.0));
+    let sound_kit = tune.force.map(|(sky, i)| {
+        let (kind, grade) = sky.wire(i);
+        wire_sound(kind, grade)
+    });
+    if !on {
+        let next = WeatherLook {
+            since_cue,
+            sound_kit,
+            ..default()
+        };
+        if *frame != next {
+            *frame = next;
+        }
+        return;
+    }
+    let Some(state) = state else { return };
+    let rain = if state.effect_kind == WeatherKind::Rain {
+        state.effect_density.clamp(0.0, 1.0)
+    } else {
+        0.0
+    };
+    let storm = storminess(rain);
+    let seed = cue_seed(world_time.date, state.cue.1);
+    let (flash, strike) = flash_at(seed, since_cue, storm);
+    *frame = WeatherLook {
+        on,
+        overcast: storm_blend(state.sky_density),
+        rain,
+        storm,
+        wet: wet_step(frame.wet, rain, time.delta_secs()),
+        night: clock.map_or(0.0, |c| night_share(c.minute as f32)),
+        flash,
+        strike,
+        since_cue,
+        sound_kit,
+    };
+}
+
+pub(crate) fn init_resources(app: &mut App) {
+    app.init_resource::<LookWeather>()
+        .init_resource::<WeatherLook>();
+}
