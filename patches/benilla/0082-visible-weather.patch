+            let window = (1.0 - x2) * (1.0 - x2);
+            let l_flat = Vec2::new(to.x, to.z);
+            let l_len = l_flat.length().max(1e-4);
+            let across = (r_flat.x * l_flat.y - r_flat.y * l_flat.x)
+                / (r_len * l_len * tune::WET_LANE_ACROSS);
+            let along = (r_el - to.y.atan2(l_len)) / tune::WET_LANE_ALONG;
+            let ahead = if r_flat.dot(l_flat) > 0.0 { 1.0 } else { 0.0 };
+            window * tune::WET_TORCH * ahead * (-(across * across) - along * along).exp()
+        };
+        let cam = Vec3::new(0.0, 3.0, 10.0);
+        let lamp = Vec3::new(0.0, 3.0, 0.0);
+        // The mirror point: halfway along, where the light's image meets the eye's ray.
+        let on = term(Vec3::new(0.0, 0.0, 5.0), cam, lamp, 10.0);
+        let near_lamp = term(Vec3::new(0.0, 0.0, 2.0), cam, lamp, 10.0);
+        let side = term(Vec3::new(2.0, 0.0, 5.0), cam, lamp, 10.0);
+        let behind = term(Vec3::new(0.0, 0.0, -3.0), cam, lamp, 10.0);
+        assert!(on > 0.5, "on the line: {on}");
+        assert!(near_lamp > 0.05, "a streak, not a spot: {near_lamp}");
+        assert!(side < 0.01 * on, "2 yd aside: {side}");
+        assert!(behind < 0.01 * on, "past the lamp: {behind}");
+    }
+
+    /// Take 273's night rain was a flat grey murk, 1.12's storm fog (Elwynn's: start −0.5 of an end
+    /// of 278 yd, a veil at the eye) under the night grade. By night in rain the overcast takes it
+    /// over: no veil at the eye, the end further out, the fog and the sky darker. By day, and under
+    /// the classic look's weather (`worldWeather 0`), 1.12's storm fog stands.
+    #[test]
+    fn a_rainy_night_takes_over_the_storm_fog() {
+        let storm = Atmosphere {
+            fog_start_frac: -0.5,
+            fog_end: 278.0,
+            fog_color: [0.3, 0.32, 0.36],
+            ..Atmosphere::DEFAULT
+        };
+        let night = WeatherLook {
+            night: 1.0,
+            ..look(1.0, 0.0)
+        };
+        let out = apply_atmosphere(storm, &night, false);
+        assert!((out.fog_start_frac - tune::NIGHT_FOG_START).abs() < 1e-6);
+        assert!((out.fog_end - 278.0 * tune::NIGHT_FOG_END).abs() < 1e-3);
+        assert!(out.fog_color[0] < 0.5 * storm.fog_color[0]);
+        assert!(out.sky[0][2] < storm.sky[0][2] || storm.sky[0][2] == 0.0);
+        // The fog's share at 15 yd, as the scene fog stage spans it: a third grey, now a few hundredths.
+        let at = |a: &Atmosphere, d: f32| {
+            let (s, e) = (a.fog_start_frac * a.fog_end, a.fog_end);
+            ((d - s) / (e - s)).clamp(0.0, 1.0)
+        };
+        assert!(at(&storm, 15.0) > 0.35 && at(&out, 15.0) < 0.05);
+        let day = WeatherLook {
+            night: 0.0,
+            ..night
+        };
+        let by_day = apply_atmosphere(storm, &day, false);
+        assert_eq!(
+            (by_day.fog_start_frac, by_day.fog_end, by_day.fog_color),
+            (storm.fog_start_frac, storm.fog_end, storm.fog_color)
+        );
+        let clear = apply_atmosphere(storm, &WeatherLook { overcast: 0.0, ..night }, false);
+        assert_eq!(clear.fog_end, storm.fog_end, "no overcast, no storm fog to take");
+    }
+
+    /// Heavy rain covers the revised sky to its grey overcast: the rain's sky density is the
+    /// storm blend the sky's cover takes (`look::sky::cover`).
+    #[test]
+    fn rain_greys_the_sky() {
+        let mut state = WeatherState::default();
+        for sky in [Sky::Overcast, Sky::Rain, Sky::Storm] {
+            let (kind, grade) = sky.wire(1.0);
+            assert_eq!(kind, 1);
+            // `SetWeather` caps the sky's target at the grade's first quarter.
+            state.sky_density = grade.min(0.25);
+            assert_eq!(storm_blend(state.sky_density), 1.0, "{sky:?}");
+        }
+    }
+
+    #[test]
+    fn the_film_commands_parse() {
+        assert_eq!(LookWeather::parse(""), Some(WeatherCommand::Show));
+        assert_eq!(LookWeather::parse("server"), Some(WeatherCommand::Follow));
+        assert_eq!(LookWeather::parse("grade"), Some(WeatherCommand::Follow));
+        assert_eq!(
+            LookWeather::parse("rain"),
+            Some(WeatherCommand::Hold(Sky::Rain, tune::DEFAULT_INTENSITY))
+        );
+        assert_eq!(
+            LookWeather::parse("Storm 1"),
+            Some(WeatherCommand::Hold(Sky::Storm, 1.0))
+        );
+        assert_eq!(
+            LookWeather::parse("overcast 0.5"),
+            Some(WeatherCommand::Hold(Sky::Overcast, 0.5))
+        );
+        assert_eq!(LookWeather::parse("rain 2"), None);
+        assert_eq!(LookWeather::parse("snow"), None);
+        assert_eq!(LookWeather::parse("rain 0.5 x"), None);
+    }
+
+    /// Each kind lands in its own band of 1.12's wire, so the client tells them apart: overcast
+    /// drops nothing, rain is no storm, a storm's top grade is a full one.
+    #[test]
+    fn the_kinds_map_to_their_wire_bands() {
+        assert_eq!(Sky::Clear.wire(1.0), (0, 0.0));
+        let (k, g) = Sky::Overcast.wire(1.0);
+        assert_eq!((k, g), (1, tune::OVERCAST_TOP));
+        // 1.12's effect density: `max((grade − 0.25)·4/3, 0)`.
+        let density = |g: f32| ((g - 0.25) * (4.0 / 3.0)).max(0.0);
+        assert_eq!(density(g), 0.0, "overcast drops no rain");
+        assert!(
+            density(Sky::Rain.wire(0.0).1) > 0.0,
+            "the lightest rain falls"
+        );
+        assert_eq!(
+            storminess(density(Sky::Rain.wire(1.0).1)),
+            0.0,
+            "rain is no storm"
+        );
+        assert!(storminess(density(Sky::Storm.wire(0.0).1)) > 0.0);
+        assert_eq!(storminess(density(Sky::Storm.wire(1.0).1)), 1.0);
+        assert_eq!(wire_sound(1, 0.2), 0);
+        assert_eq!(wire_sound(1, 0.35), tune::SOUND_LIGHT);
+        assert_eq!(wire_sound(1, 0.6), tune::SOUND_MEDIUM);
+        assert_eq!(wire_sound(1, 1.0), tune::SOUND_HEAVY);
+        assert_eq!(wire_sound(0, 1.0), 0);
+    }
+
+    /// The ground soaks in under a minute of rain and dries over minutes after.
+    #[test]
+    fn the_ground_soaks_and_dries_slowly() {
+        let mut wet = 0.0;
+        for _ in 0..30 {
+            wet = wet_step(wet, 1.0, 1.0);
+        }
+        assert!(wet > 0.6 && wet < 0.7, "{wet}");
+        for _ in 0..30 {
+            wet = wet_step(wet, 1.0, 1.0);
+        }
+        assert_eq!(wet, 1.0);
+        // Light rain wets it to its share and no further.
+        assert_eq!(wet_step(0.2, 0.2 * tune::WET_FULL_AT, 100.0), 0.2);
+        let after_minute = (0..60).fold(1.0, |w, _| wet_step(w, 0.0, 1.0));
+        assert!(after_minute > 0.75, "still wet a minute on: {after_minute}");
+        let dry = (0..400).fold(1.0, |w, _| wet_step(w, 0.0, 1.0));
+        assert_eq!(dry, 0.0);
+    }
+
+    /// The same strikes for every client that heard the cue, none without a storm, about one
+    /// every 30 s in a full one, each a short flash; another cue (a hair's other grade, another
+    /// day) strikes otherwise.
+    #[test]
+    fn lightning_runs_from_the_cue() {
+        let seed = cue_seed(20_400, 1.0f32.to_bits());
+        assert!((0..2000).all(|s| strike_in(seed, s, 0.0).is_none()));
+        let strikes = (0..2000)
+            .filter(|s| strike_in(seed, *s, 1.0).is_some())
+            .count();
+        let secs = 2000.0 * tune::STRIKE_SLOT_S;
+        let every = secs / strikes as f64;
+        assert!((18.0..50.0).contains(&every), "one every {every:.0} s");
+        let k = (0..2000)
+            .find_map(|s| strike_in(seed, s, 1.0))
+            .expect("a strike");
+        assert_eq!(strike_in(seed, k.id, 1.0), Some(k), "the same every time");
+        let (peak, latest) = flash_at(seed, k.at + f64::from(tune::FLASH_RISE_S), 1.0);
+        assert!(peak > 0.5 * k.power, "{peak}");
+        assert!(peak <= tune::FLASH_PEAK * k.power + 1e-6, "{peak}");
+        // It rises over a few frames, never a one-frame white-out: at the rig's 30 fps the
+        // first frame in is under half the peak, the second still short of it.
+        let (first, _) = flash_at(seed, k.at + 1.0 / 30.0, 1.0);
+        assert!(first < 0.5 * peak, "{first} of {peak} a frame in");
+        let (second, _) = flash_at(seed, k.at + 2.0 / 30.0, 1.0);
+        assert!(second > first && second < 0.95 * peak, "{second} of {peak} two frames in");
+        assert_eq!(latest.map(|s| s.id), Some(k.id));
+        let before = flash_at(seed, k.at - 0.01, 1.0);
+        assert!(before.0 < 1e-3 || before.1 != Some(k));
+        assert_eq!(
+            flash_at(seed, k.at + 0.7, 1.0).0,
+            0.0,
+            "over in well under a second"
+        );
+        let pattern = |seed| {
+            (0..40)
+                .map(|s| strike_in(seed, s, 1.0).is_some())
+                .collect::<Vec<_>>()
+        };
+        let next = cue_seed(20_400, 0.9995f32.to_bits());
+        assert_ne!(
+            pattern(seed),
+            pattern(next),
+            "the next cue strikes otherwise"
+        );
+        assert_ne!(pattern(seed), pattern(cue_seed(20_401, 1.0f32.to_bits())));
+        assert!((tune::THUNDER_AFTER_MIN_S..=tune::THUNDER_AFTER_MAX_S).contains(&k.thunder_after));
+        // The flicker: a second rise after the first flare.
+        let crest = tune::FLICKER_AT_S + 0.5 * tune::FLASH_RISE_S;
+        assert!(flash_shape(crest) > flash_shape(tune::FLICKER_AT_S - 0.01));
+        // And it climbs: a frame after it starts it is not yet at its crest.
+        assert!(flash_shape(tune::FLICKER_AT_S + 0.01) < flash_shape(crest));
+    }
+
+    #[test]
+    fn an_overcast_dims_and_cools_the_sun_and_a_flash_lights_the_world() {
+        let atmo = Atmosphere::DEFAULT;
+        let same = apply_atmosphere(atmo, &look(1.0, 1.0), true);
+        assert_eq!(same.sun_diffuse, atmo.sun_diffuse, "none under water");
+        let off = WeatherLook {
+            on: false,
+            ..look(1.0, 1.0)
+        };
+        assert_eq!(apply_atmosphere(atmo, &off, false).ambient, atmo.ambient);
+        let grey = apply_atmosphere(atmo, &look(1.0, 0.0), false);
+        assert!(grey.sun_diffuse[0] < 0.6 * atmo.sun_diffuse[0] + 1e-6);
+        assert!(
+            grey.sun_diffuse[0] / grey.sun_diffuse[2].max(1e-6)
+                < atmo.sun_diffuse[0] / atmo.sun_diffuse[2].max(1e-6) + 1e-6,
+            "cooler"
+        );
+        let lit = apply_atmosphere(atmo, &look(0.0, 1.0), false);
+        assert!(lit
+            .ambient
+            .iter()
+            .zip(atmo.ambient)
+            .all(|(a, b)| *a > b || *a == 1.0));
+        assert!(lit.sky[0][2] > atmo.sky[0][2] && lit.fog_color[0] > atmo.fog_color[0]);
+        // A cool flash: more blue than red added.
+        let night = Atmosphere {
+            ambient: [0.1; 3],
+            ..atmo
+        };
+        let flashed = apply_atmosphere(night, &look(0.0, 1.0), false).ambient;
+        assert!(flashed[2] - 0.1 > flashed[0] - 0.1, "{flashed:?}");
+    }
+
+    #[test]
+    fn an_overcast_takes_the_rays_and_the_warmth() {
+        let post = PostLook {
+            rays: 0.5,
+            warmth: 0.2,
+            bloom: 0.1,
+            ..PostLook::NEUTRAL
+        };
+        let grey = apply_post(post, &look(1.0, 0.0));
+        assert!(grey.rays < 0.1 * post.rays + 1e-6 && grey.warmth < post.warmth);
+        assert_eq!(
+            apply_post(post, &look(0.0, 0.0)),
+            post,
+            "clear is the grade's"
+        );
+        assert!(apply_post(post, &look(0.0, 1.0)).bloom > post.bloom);
+        assert!(apply_post(PostLook::NEUTRAL, &look(1.0, 1.0)).is_neutral());
+        assert_eq!(shadow_scale(Some(&look(1.0, 0.0))), 1.0 - tune::SHADOW_FADE);
+        assert_eq!(shadow_scale(None), 1.0);
+    }
+
+    /// Dry ground or the look off packs all-zero lanes, which every shader reads as 1.12's.
+    #[test]
+    fn dry_ground_packs_nothing() {
+        assert_eq!(look(1.0, 0.0).lanes(), [0.0; 3]);
+        let wet = WeatherLook {
