@@ -0,0 +1,241 @@
+//! Street lamps that light under the new look (benilla's own). A prop casts light only through an
+//! M2 point light in its file (`terrain_stream::spawn::fx`), and Goldshire's lamp posts have none
+//! that casts: take 291 found `lamppost.m2` #12341 19 yd from the camera with no light in the
+//! table nearer than 26.9 yd, so its lamp made no pool on the road, no streak on the wet stone
+//! (#271) and no glow in the mist (#273). Under [`WorldLook::NEW`] each lamp-like prop (its model's
+//! file named for a lamp or a lantern, [`is_lamp`]) that has no authored light within
+//! [`tune::NEAR_LIGHT`] of its lamp gets one: a stock torch's light ([`tune::COLOR`],
+//! [`tune::SCALE`]) a little under the top of the prop. It is an ordinary authored light from
+//! there on (the hour, the flicker, the ranking, the wet streaks, the fog's glow), and it goes with
+//! its prop or with the new look, so `worldLook 0` is 1.12's exactly. Each lamp lit is logged once
+//! (`[look lamps]`) with its place.
+
+use std::collections::HashMap;
+
+use bevy::camera::primitives::Aabb;
+use bevy::prelude::*;
+
+use super::WorldLook;
+use crate::interact::WorldObject;
+use crate::lighting::WorldPointLight;
+use crate::model_render::ModelKind;
+
+pub mod tune {
+    /// The light's colour and scale, the stock torch's (`look::lights`' test light), so a lamp
+    /// casts a torch's warm, flickering pool.
+    pub const COLOR: [f32; 3] = [0.466_666_7, 0.290_196_1, 0.133_333_34];
+    pub const SCALE: f32 = 3.0;
+    /// How far under the top of the prop the lamp sits (yd): a lamp post's lantern hangs at its
+    /// head.
+    pub const BELOW_TOP: f32 = 0.5;
+    /// An authored light this near the lamp (yd) is its own: the prop then gets no second one.
+    pub const NEAR_LIGHT: f32 = 2.5;
+}
+
+/// Whether a model path names a lamp: its file, not its folder, has "lamp" or "lantern" in it.
+pub fn is_lamp(path: &str) -> bool {
+    let name = path
+        .rsplit(['/', '\\'])
+        .next()
+        .unwrap_or(path)
+        .to_ascii_lowercase();
+    (name.contains("lamp") || name.contains("lantern"))
+        && (name.ends_with(".m2") || name.ends_with(".mdx"))
+}
+
+/// A light the new look added to a lamp prop: the prop's placement id and one of its meshes, so
+/// the light goes when the prop does.
+#[derive(Component, Clone, Copy, Debug)]
+pub struct LampLight {
+    pub id: u32,
+    pub mesh: Entity,
+}
+
+/// Where a lamp's light sits: under the top of its meshes' boxes, over their middle.
+pub fn lamp_point(boxes: &[(Vec3, Vec3)]) -> Option<Vec3> {
+    let (mut lo, mut hi) = (Vec3::splat(f32::MAX), Vec3::splat(f32::MIN));
+    for (a, b) in boxes {
+        lo = lo.min(*a);
+        hi = hi.max(*b);
+    }
+    (lo.x <= hi.x).then(|| {
+        let mid = (lo + hi) * 0.5;
+        Vec3::new(mid.x, (hi.y - tune::BELOW_TOP).max(lo.y), mid.z)
+    })
+}
+
+/// A lamp prop being lit: one of its meshes, its model's path and its meshes' world boxes.
+type LampProp = (Entity, String, Vec<(Vec3, Vec3)>);
+
+type LampMesh = (
+    Entity,
+    &'static WorldObject,
+    &'static GlobalTransform,
+    Option<&'static Aabb>,
+);
+
+/// Light the lamp props that came in this frame, drop the lights whose prop went, and all of them
+/// under the classic look.
+pub(crate) fn light_lamps(
+    mut commands: Commands,
+    look: Res<WorldLook>,
+    fresh: Query<LampMesh, Added<WorldObject>>,
+    all: Query<LampMesh>,
+    authored: Query<&GlobalTransform, (With<WorldPointLight>, Without<LampLight>)>,
+    lit: Query<(Entity, &LampLight)>,
+    meshes: Query<(), With<WorldObject>>,
+    mut was_on: Local<bool>,
+) {
+    if !look.on {
+        if *was_on {
+            for (e, _) in &lit {
+                commands.entity(e).despawn();
+            }
+            *was_on = false;
+        }
+        return;
+    }
+    // Turned on: every prop is new to the look.
+    let rescan = !*was_on;
+    *was_on = true;
+    for (e, lamp) in &lit {
+        if meshes.get(lamp.mesh).is_err() {
+            commands.entity(e).despawn();
+        }
+    }
+    // The lamp props to light: each new lamp mesh's prop, with all its meshes' world boxes.
+    let mut props: HashMap<u32, LampProp> = HashMap::new();
+    let wanted = |o: &WorldObject| {
+        o.id != 0 && matches!(o.kind, ModelKind::Doodad | ModelKind::GameObject) && is_lamp(&o.label)
+    };
+    let mut want_ids: Vec<u32> = Vec::new();
+    let mut want = |o: &WorldObject| {
+        if wanted(o) && !want_ids.contains(&o.id) {
+            want_ids.push(o.id);
+        }
+    };
+    if rescan {
+        all.iter().for_each(|(_, o, _, _)| want(o));
+    } else {
+        fresh.iter().for_each(|(_, o, _, _)| want(o));
+    }
+    if want_ids.is_empty() {
+        return;
+    }
+    let lit_ids: Vec<u32> = lit.iter().map(|(_, l)| l.id).collect();
+    want_ids.retain(|id| !lit_ids.contains(id));
+    for (e, o, gt, aabb) in &all {
+        if !want_ids.contains(&o.id) || !wanted(o) {
+            continue;
+        }
+        let entry = props
+            .entry(o.id)
+            .or_insert_with(|| (e, o.label.clone(), Vec::new()));
+        if let Some(aabb) = aabb {
+            let c = gt.transform_point(Vec3::from(aabb.center));
+            let h = Vec3::from(aabb.half_extents) * gt.scale().abs();
+            entry.2.push((c - h, c + h));
+        }
+    }
+    for (id, (mesh, label, boxes)) in props {
+        let Some(at) = lamp_point(&boxes) else {
+            continue;
+        };
+        if authored
+            .iter()
+            .any(|gt| gt.translation().distance(at) < tune::NEAR_LIGHT)
+        {
+            continue;
+        }
+        let w = benilla_assets::coords::bevy_to_wow(at);
+        info!(
+            "[look lamps] {label} #{id} gets a lamp's light at ({:.1}, {:.1}, {:.1})",
+            w[0], w[1], w[2]
+        );
+        commands.spawn((
+            crate::terrain_stream::point_light(tune::COLOR, tune::SCALE),
+            LampLight { id, mesh },
+            Transform::from_translation(at),
+        ));
+    }
+}
+
+pub(crate) fn build(app: &mut App) {
+    app.add_systems(Update, light_lamps);
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// A lamp post's or a lantern's file is a lamp; its folder alone, a torch or a tree is not.
+    #[test]
+    fn a_lamp_is_named_for_one() {
+        assert!(is_lamp(
+            r"World\Generic\Human\Passive Doodads\Lampposts\LampPost.m2"
+        ));
+        assert!(is_lamp("world/generic/human/passive doodads/lanterns/lantern01.mdx"));
+        assert!(is_lamp(r"World\Azeroth\Elwynn\PassiveDoodads\StreetLamp\StreetLamp01.m2"));
+        assert!(!is_lamp(r"World\Generic\Human\Lampposts\Bench.m2"));
+        assert!(!is_lamp(r"World\Generic\Human\Passive Doodads\Torches\GeneralTorch01.m2"));
+        assert!(!is_lamp("Elwynn Oak"));
+    }
+
+    /// The lamp hangs half a yard under the top of the prop, over its middle.
+    #[test]
+    fn the_lamp_sits_under_the_top() {
+        let p = lamp_point(&[
+            (Vec3::new(-0.2, 0.0, -0.2), Vec3::new(0.2, 3.0, 0.2)),
+            (Vec3::new(-0.5, 2.6, -0.1), Vec3::new(0.3, 3.4, 0.1)),
+        ])
+        .unwrap();
+        assert!((p.y - (3.4 - tune::BELOW_TOP)).abs() < 1e-5);
+        assert!((p.x + 0.1).abs() < 1e-5 && p.z.abs() < 1e-5);
+        assert!(lamp_point(&[]).is_none());
+    }
+
+    /// Under the new look a lamp prop gets one light, kept on later frames; with no authored
+    /// light near, not twice; the classic look takes it away.
+    #[test]
+    fn a_lamp_lights_under_the_new_look_only() {
+        let mut app = App::new();
+        app.insert_resource(WorldLook::NEW);
+        app.add_systems(Update, light_lamps);
+        let lamp = WorldObject {
+            kind: ModelKind::Doodad,
+            label: r"World\Generic\Human\Passive Doodads\Lampposts\LampPost.m2".to_string(),
+            id: 12341,
+            detail: String::new(),
+        };
+        let aabb = Aabb::from_min_max(Vec3::new(-0.2, 0.0, -0.2), Vec3::new(0.2, 3.0, 0.2));
+        let mesh = app
+            .world_mut()
+            .spawn((lamp, GlobalTransform::from_xyz(10.0, 0.0, 5.0), aabb))
+            .id();
+        let lights = |app: &mut App| {
+            app.world_mut()
+                .query::<(&LampLight, &Transform)>()
+                .iter(app.world())
+                .map(|(l, t)| (l.id, t.translation))
+                .collect::<Vec<_>>()
+        };
+        app.update();
+        app.update();
+        let lit = lights(&mut app);
+        assert_eq!(lit.len(), 1, "{lit:?}");
+        assert_eq!(lit[0].0, 12341);
+        assert!((lit[0].1 - Vec3::new(10.0, 2.5, 5.0)).length() < 1e-4);
+        app.update();
+        assert_eq!(lights(&mut app).len(), 1, "once");
+        app.insert_resource(WorldLook::CLASSIC);
+        app.update();
+        assert!(lights(&mut app).is_empty(), "the classic look has none");
+        app.insert_resource(WorldLook::NEW);
+        app.update();
+        assert_eq!(lights(&mut app).len(), 1, "back with the new look");
+        app.world_mut().entity_mut(mesh).despawn();
+        app.update();
+        app.update();
+        assert!(lights(&mut app).is_empty(), "gone with its prop");
+    }
+}
