+// The rain's rings on the water (`look::weather`, benilla's own): in cells of about two-thirds of a
+// yard, three offset layers, a drop lands in a share of the cells (`amount`, the rain) and its ring
+// spreads and fades over about two-thirds of a second, each cell on its own beat. Returns the
+// slope (x, z) the rings add to the surface; zero far off, where a ring is under a pixel.
+fn rain_hash3(c: vec2<f32>) -> vec3<f32> {
+    let q = vec3<f32>(dot(c, vec2<f32>(127.1, 311.7)), dot(c, vec2<f32>(269.5, 183.3)), dot(c, vec2<f32>(419.2, 371.9)));
+    return fract(sin(q) * 43758.5453);
+}
+
+fn rain_rings(p: vec2<f32>, t: f32, amount: f32, fp: f32) -> vec2<f32> {
+    let fade = 1.0 - smoothstep(0.01, 0.035, fp);
+    if (amount <= 0.0 || fade <= 0.0) {
+        return vec2<f32>(0.0);
+    }
+    var slope = vec2<f32>(0.0);
+    for (var k = 0u; k < 3u; k = k + 1u) {
+        let kf = f32(k);
+        let q = p * 1.5 + vec2<f32>(kf * 0.37, kf * 0.71);
+        let c = floor(q);
+        let h = rain_hash3(c + vec2<f32>(kf * 17.0, kf * 29.0));
+        // How many cells see a drop: up to most of them in a downpour.
+        if (h.z > 0.25 + 0.6 * amount) {
+            continue;
+        }
+        let centre = c + vec2<f32>(0.3) + 0.4 * h.xy;
+        let d = q - centre;
+        let r = length(d);
+        let age = fract(t * 1.5 + h.z * 13.0 + h.x * 7.0);
+        let x = (r - age * 0.3) / 0.045;
+        if (abs(x) >= 1.0 || r < 1e-4) {
+            continue;
+        }
+        let wave = -sin(x * 3.14159265) * (1.0 - age) * (1.0 - age);
+        slope += (d / r) * wave;
+    }
+    return slope * (0.9 * amount * fade);
+}
