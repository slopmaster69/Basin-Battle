+
+    #[test]
+    fn a_streak_catches_the_hour_and_a_torch() {
+        let light = StreakLight::new(
+            [0.2; 3],
+            [0.4; 3],
+            Vec3::ZERO,
+            [
+                (Vec3::new(3.0, 0.0, 0.0), 20.0, [1.0, 0.6, 0.2]),
+                (Vec3::new(500.0, 0.0, 0.0), 20.0, [1.0, 1.0, 1.0]),
+            ]
+            .into_iter(),
+            [1.0, 0.0, 2.0],
+        );
+        assert_eq!(light.torches.len(), 1, "a far torch is left out");
+        assert_eq!(light.torches[0].1, tune::TORCH_REACH, "held to the reach");
+        let far = light.at(Vec3::new(-40.0, 0.0, 0.0));
