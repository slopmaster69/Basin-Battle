+/// The new look's streaks (`look::weather`): the same triangle per drop, its head lit by the
+/// hour's light and the torches near it and its tail fading out, leaning `lean` downwind, for an
+/// additive draw. 1.12's [`push_streaks`] stays the classic look's.
+pub(super) fn push_lit_streaks(
+    out: &mut Vec<EffectVertex>,
+    drops: &[Drop],
+    tilt: Quat,
+    cam: Vec3,
+    light: &crate::look::weather::StreakLight,
+) {
+    let alpha = crate::look::weather::tune::STREAK_ALPHA;
+    for d in drops.iter().take(POOL) {
+        // 1.12's grey fade (`EffectFog::Rain`) would add grey here: fade to nothing by the same
+        // window instead, and skip what is past it.
+        let dist = d.pos.distance(cam);
+        if dist >= RAIN_FOG_END {
+            continue;
+        }
+        let fade = ((RAIN_FOG_END - dist) / (RAIN_FOG_END - RAIN_FOG_START + 15.0)).clamp(0.0, 1.0);
+        let alpha = alpha * fade;
+        let anti_vel = -d.vel.normalize_or(Vec3::NEG_Y);
+        let to_cam = (cam - d.pos).normalize_or(Vec3::X);
+        let right = to_cam.cross(anti_vel).normalize_or(Vec3::X) * STREAK_HALF_W;
+        // The tail trails upwind: a drop blown downwind falls from upwind of its head.
+        let apex = d.pos + tilt * (anti_vel * STREAK_TAIL) - light.lean;
+        let [r, g, b] = light.at(d.pos);
+        for (pos, uv, a) in [
+            (d.pos - right, [0.0, 1.0], alpha),
+            (d.pos + right, [1.0, 1.0], alpha),
+            (apex, [0.5, 0.0], 0.0),
+        ] {
+            out.push(EffectVertex {
+                pos: pos.to_array(),
+                uv,
+                color: [r, g, b, a],
+            });
+        }
+    }
+}
