+            let (at, blocked) = reticle_point(&spatial, &occluders, &doodads, feet, line);
+            action_combat::set_reticle_point(Some((bevy_to_wow(at), blocked)));
+        }
+        _ => action_combat::set_reticle_point(None),
+    }
     // The strip, cone and ring shapes lie under the hero (`super::telegraph`); this is the circle.
     let circle = action_combat::aim_marker().filter(|m| m.shape == action_combat::AimShape::Circle);
     match (circle, feet) {
         (Some(m), Some(feet)) => {
-            let at = aim_point(&spatial, &occluders, feet, m.range);
+            let line = crosshair.unwrap_or_else(|| eye_line(feet));
+            let at = aim_point(&spatial, &occluders, feet, m.range, line);
             state.circle.place(&decals, at, m.radius.max(0.3));
             state.shown = !state.circle.verts.is_empty();
             action_combat::set_aim_point(Some(bevy_to_wow(at)));
