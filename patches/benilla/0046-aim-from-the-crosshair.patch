+pub fn set_reticle_point(p: Option<([f32; 3], bool)>) {
+    if let Ok(mut a) = RETICLE_POINT.lock() {
+        *a = p;
+    }
+}
+
+pub fn reticle_point() -> Option<([f32; 3], bool)> {
+    RETICLE_POINT.lock().ok().and_then(|a| *a)
