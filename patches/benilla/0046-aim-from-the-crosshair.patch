+fn eye_line(feet: Vec3) -> (Vec3, Vec3) {
     let (yaw, pitch) = (
         action_combat::view_facing(),
         action_combat::view_elevation(),
@@ -160,6 +170,73 @@ pub(crate) fn aim_point(
