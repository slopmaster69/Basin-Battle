+/// The reticle's line: the camera's own line through the middle of the screen, from where it
+/// passes the hero's eye (so nothing between the camera and the hero is aimed at).
+fn crosshair_line(camera: &Camera, cam_tf: &GlobalTransform, feet: Vec3) -> Option<(Vec3, Vec3)> {
+    let size = camera.logical_viewport_size()?;
+    let ray = camera.viewport_to_world(cam_tf, size * 0.5).ok()?;
+    let dir = *ray.direction;
+    let eye = feet + Vec3::Y * EYE;
+    let from = ray.origin + dir * (eye - ray.origin).dot(dir).max(0.0);
+    Some((from, dir))
+}
+
+/// The nearest ground, wall or doodad along `dir` from `from` within `max`, as a distance.
+fn first_solid(
+    spatial: &avian3d::prelude::SpatialQuery,
+    occluders: &Query<(), With<PickOccluder>>,
+    doodads: &DoodadOccluders,
+    from: Vec3,
+    dir: Vec3,
+    max: f32,
+) -> Option<f32> {
+    let terrain = first_hit(spatial, occluders, from, dir, max);
+    let doodad = Dir3::new(dir)
+        .ok()
+        .and_then(|d| doodads.nearest(Ray3d::new(from, d)))
+        .filter(|t| *t <= max);
+    match (terrain, doodad) {
+        (Some(a), Some(b)) => Some(a.min(b)),
+        (a, b) => a.or(b),
+    }
+}
+
+/// Where the reticle is on the world (Bevy space), and whether something stands between the hero's
+/// hands and there.
+fn reticle_point(
+    spatial: &avian3d::prelude::SpatialQuery,
+    occluders: &Query<(), With<PickOccluder>>,
+    doodads: &DoodadOccluders,
+    feet: Vec3,
+    (from, dir): (Vec3, Vec3),
+) -> (Vec3, bool) {
+    let at = from + dir * first_solid(spatial, occluders, doodads, from, dir, RETICLE_REACH).unwrap_or(RETICLE_REACH);
+    let yaw = action_combat::view_facing();
+    let w = bevy_to_wow(feet);
+    let hands = wow_to_bevy([
+        w[0] + yaw.cos() * HAND_AHEAD + yaw.sin() * HAND_RIGHT,
+        w[1] + yaw.sin() * HAND_AHEAD - yaw.cos() * HAND_RIGHT,
+        w[2] + HAND_UP,
+    ]);
+    let to = at - hands;
+    let len = to.length();
+    let blocked = len > BLOCK_SLACK
+        && first_solid(spatial, occluders, doodads, hands, to / len, len)
+            .is_some_and(|d| d < len - BLOCK_SLACK);
+    (at, blocked)
+}
+
+/// Where the reticle's line lands for an aim of `range` yards, in Bevy space.
+pub(crate) fn aim_point(
+    spatial: &avian3d::prelude::SpatialQuery,
+    occluders: &Query<(), With<PickOccluder>>,
+    feet: Vec3,
+    range: f32,
+    (origin, dir): (Vec3, Vec3),
+) -> Vec3 {
     let reach = range + OVERSHOOT;
     let mut at = origin + dir * first_hit(spatial, occluders, origin, dir, reach).unwrap_or(reach);
     // No farther than the range on the map.
@@ -181,6 +258,8 @@ pub(crate) fn aim_point(
