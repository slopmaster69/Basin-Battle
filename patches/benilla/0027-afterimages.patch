+    /// Basin Battle: a copy of `src`'s rig frozen as it is this instant, a slot of its own with
+    /// the same bones and inverse bindposes and `src`'s rows and origin copied in. Nothing writes
+    /// it afterwards (no pose, no rider), so it holds the pose; an afterimage draws from it.
+    pub fn frozen_copy(palettes: &mut RigPalettes, src: &RigSkin) -> Option<Self> {
