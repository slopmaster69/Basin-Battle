diff --git a/crates/benilla-app/src/creature_anim/action/afterimage.rs b/crates/benilla-app/src/creature_anim/action/afterimage.rs
new file mode 100644
index 00000000..e80f6363
--- /dev/null
+++ b/crates/benilla-app/src/creature_anim/action/afterimage.rs
@@ -0,0 +1,243 @@
+//! Basin Battle: afterimages, frozen translucent copies of a unit's body and what it holds, left
+//! where a blow landed and gone again in a moment (Bladestorm's storm of cuts).
+//!
+//! A copy is no model of its own. Its parts draw the unit's own meshes from a fresh palette slot
+//! holding the rows the unit's rig had at that instant (`RigSkin::frozen_copy`, one for the body
+//! and one for each held item), on their blend twins under the engine's teardown ramp
+//! (`RenderFade`), so the picture is exactly the pose at the cut, weapons and all, and the depth
+//! twin (`zfill`) keeps the overlapping limbs one layer, lit as a highlighted target so it reads
+//! as light rather than shadow. Nothing writes the slot afterwards (no
+//! pose, no rider), so the copy stays where it was made while the body moves on. It costs a slot
+//! a rig for its moment, and goes with its root.
+
+use std::collections::HashMap;
+
+use benilla_world::instance_tint::{self, InstanceTints};
+use benilla_world::interior::InteriorLit;
+use benilla_world::mesh_tag::{spawn_tag, HIGHLIGHT_BIT};
+use benilla_world::model_fade::{FadeCurve, FadeMaterials, RenderFade};
+use benilla_world::rig_palette::{RigPalettes, RigPart, RigSkin};
+use bevy::camera::visibility::NoFrustumCulling;
+use bevy::mesh::MeshTag;
+use bevy::prelude::*;
+
+/// The most copies alive at once, over every unit; the oldest goes when another comes.
+const MAX_IMAGES: usize = 24;
+
+/// A copy of the unit is due at `at` (seconds): a flurry asks for one as each cut's blow lands.
+#[derive(Component, Clone, Copy)]
+pub(crate) struct AfterimageDue {
+    pub(crate) at: f32,
+    /// How long the copy stays, fading the whole way.
+    pub(crate) secs: f32,
+    /// Its alpha as it appears.
+    pub(crate) alpha: f32,
+    /// A colour over it, the trail's; `None` leaves the body's own.
+    pub(crate) tint: Option<[u8; 3]>,
+}
+
+/// A copy's root: its parts and its rigs are its children, and all go together at `until`.
+#[derive(Component)]
+pub(crate) struct Afterimage {
+    started: f32,
+    until: f32,
+}
+
+/// Holds one of a copy's palette slots (`RigSkin` frees it with the entity).
+#[derive(Component)]
+struct ImageRig;
+
+/// Make the copies that fell due: the unit's drawn parts (the body's and its held items') again
+/// under a root of their own, each rig's rows frozen into a slot of the copy's.
+#[allow(clippy::type_complexity)]
+pub(crate) fn spawn_afterimages(
+    mut commands: Commands,
+    time: Res<Time>,
+    due: Query<(Entity, &AfterimageDue)>,
+    children: Query<&Children>,
+    parts: Query<(
+        &Mesh3d,
+        &MeshTag,
+        &FadeMaterials,
+        &RigPart,
+        Option<&InteriorLit>,
+    )>,
+    skins: Query<&RigSkin>,
+    images: Query<(Entity, &Afterimage)>,
+    mut palettes: ResMut<RigPalettes>,
+    mut tints: ResMut<InstanceTints>,
+) {
+    let now = time.elapsed_secs();
+    let mut alive: Vec<(f32, Entity)> = images.iter().map(|(e, a)| (a.started, e)).collect();
+    alive.sort_by(|a, b| a.0.total_cmp(&b.0));
+    let mut oldest = 0;
+    for (unit, d) in &due {
+        if now < d.at {
+            continue;
+        }
+        commands.entity(unit).try_remove::<AfterimageDue>();
+        // Room for one more: the oldest goes early.
+        if alive.len() - oldest >= MAX_IMAGES {
+            if let Some(&(_, e)) = alive.get(oldest) {
+                commands.entity(e).try_despawn();
+                oldest += 1;
+            }
+        }
+        let root = commands
+            .spawn((
+                Afterimage {
+                    started: now,
+                    until: now + d.secs,
+                },
+                Transform::IDENTITY,
+                Visibility::default(),
+            ))
+            .id();
+        // The copy's slot for each rig the unit draws from, made as the first part of it comes.
+        let mut copies: HashMap<Entity, u16> = HashMap::new();
+        let mut any = false;
+        for e in children.iter_descendants(unit) {
+            let Ok((mesh, tag, fm, rig, lit)) = parts.get(e) else {
+                continue;
+            };
+            // A part the unit is not drawing now (its alpha down at the floor) is not copied.
+            if benilla_world::mesh_tag::alpha_of(tag.0) <= 0.02 {
+                continue;
+            }
+            let slot = match copies.get(&rig.0) {
+                Some(&slot) => slot,
+                None => {
+                    let Ok(src) = skins.get(rig.0) else {
+                        continue;
+                    };
+                    let Some(copy) = RigSkin::frozen_copy(&mut palettes, src) else {
+                        continue;
+                    };
+                    let slot = copy.slot;
+                    if let Some(t) = d.tint {
+                        tints.set(slot, instance_tint::pack(t));
+                    }
+                    commands.spawn((copy, ImageRig, ChildOf(root)));
+                    copies.insert(rig.0, slot);
+                    slot
+                }
+            };
+            commands.spawn((
+                Mesh3d(mesh.0.clone()),
+                MeshMaterial3d(fm.material_for(lit, true).clone()),
+                // Lit up as a hovered target is (the highlight bit): a ghost of light, not a
+                // shadow of the body.
+                MeshTag(spawn_tag(slot, d.alpha) | HIGHLIGHT_BIT),
+                fm.clone(),
+                RenderFade {
+                    started: now,
+                    duration: d.secs,
+                    from: d.alpha,
+                    to: 0.0,
+                    curve: FadeCurve::Smoothstep,
+                },
+                Transform::IDENTITY,
+                NoFrustumCulling,
+                ChildOf(root),
+            ));
+            any = true;
+        }
+        if any {
+            alive.push((now, root));
+        } else {
+            commands.entity(root).despawn();
+        }
+    }
+}
+
+/// A copy whose time is up goes, parts, rigs (their slots) and all.
+pub(crate) fn expire_afterimages(
+    mut commands: Commands,
+    time: Res<Time>,
+    images: Query<(Entity, &Afterimage)>,
+) {
+    let now = time.elapsed_secs();
+    for (e, a) in &images {
+        if now >= a.until {
+            commands.entity(e).try_despawn();
+        }
+    }
+}
+
+/// Leaving the world: every copy goes.
+pub(crate) fn clear_afterimages(mut commands: Commands, images: Query<Entity, With<Afterimage>>) {
+    for e in &images {
+        commands.entity(e).try_despawn();
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// The flow without a renderer: a flurry asks for a copy as its first cut lands, and the ask
+    /// is taken up (and, the unit having no parts here, leaves nothing behind).
+    #[test]
+    fn a_flurry_asks_for_a_copy_as_a_cut_lands_and_the_ask_is_taken_up() {
+        use std::time::Duration;
+        let mut app = App::new();
+        app.insert_resource(Time::<()>::default());
+        app.init_resource::<RigPalettes>();
+        app.init_resource::<InstanceTints>();
+        app.add_systems(
+            Update,
+            (super::super::flurry::step_flurries, spawn_afterimages).chain(),
+        );
+        let unit = app
+            .world_mut()
+            .spawn((
+                Transform::IDENTITY,
+                super::super::flurry::Flurry::new(
+                    "player".into(),
+                    1.0,
+                    None,
+                    vec![(17, 0), (18, 1)],
+                    0.14,
+                    0.15,
+                    (88, 0),
+                    0.25,
+                    70.0,
+                    Some((0xC8E8F0FF, 220)),
+                    0.0,
+                ),
+            ))
+            .id();
+        app.update();
+        let due = app
+            .world()
+            .get::<AfterimageDue>(unit)
+            .copied()
+            .expect("the first cut asks for a copy");
+        assert!((due.at - 0.15).abs() < 1.0e-3, "as the wind-up lands: {}", due.at);
+        assert_eq!(due.tint, Some([0xC8, 0xE8, 0xF0]));
+        // Not yet: the ask waits for its time.
+        app.world_mut().resource_mut::<Time<()>>().advance_by(Duration::from_millis(100));
+        app.update();
+        assert!(app.world().get::<AfterimageDue>(unit).is_some(), "too soon");
+        app.world_mut().resource_mut::<Time<()>>().advance_by(Duration::from_millis(100));
+        app.update();
+        assert!(app.world().get::<AfterimageDue>(unit).is_none(), "taken up at its time");
+        let world = app.world_mut();
+        assert_eq!(world.query::<&Afterimage>().iter(world).count(), 0, "nothing to copy here");
+    }
+
+    #[test]
+    fn a_copy_fades_the_whole_way_and_is_gone_at_its_end() {
+        let fade = RenderFade {
+            started: 10.0,
+            duration: 0.4,
+            from: 0.6,
+            to: 0.0,
+            curve: FadeCurve::Smoothstep,
+        };
+        let at = |t: f32| fade.alpha_at((t - 10.0) / 0.4);
+        assert!(at(10.0) > 0.5, "near its start alpha as it appears: {}", at(10.0));
+        assert!(at(10.2) < at(10.0) && at(10.2) > 0.0);
+        assert!(at(10.4) <= 1.0e-3, "gone at the end: {}", at(10.4));
+    }
+}
