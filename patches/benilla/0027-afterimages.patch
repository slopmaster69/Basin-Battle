+    /// Basin Battle: `to` takes `from`'s rows and origin as they stand ([`RigSkin::frozen_copy`]).
+    pub(crate) fn copy_rows(&mut self, from: &RigSkin, to: &RigSkin) {
+        let n = from.len.min(to.len);
+        if n == 0 {
+            return;
+        }
+        if let Some(o) = self.origins.get(from.slot as usize).copied() {
+            self.set_origin(to.slot, Vec3::new(o[0], o[1], o[2]));
+        }
+        self.cost_rows += n;
+        let wm = self.bone_watermark();
+        let rows = rows_make_mut(
+            &mut self.rows,
+            &mut self.spare,
+            wm,
+            &mut self.cost_copies,
+            &mut self.cost_copy_us,
+        );
+        let (r0, r1) = (3 * from.base as usize, 3 * (from.base + n) as usize);
+        let t0 = 3 * to.base as usize;
+        if r1 <= rows.len() && t0 + (r1 - r0) <= rows.len() {
+            rows.copy_within(r0..r1, t0);
+        }
+        let mirrored = self.mirrored.get(to.slot as usize).copied().unwrap_or(false);
+        self.dirty.push((to.base, n, mirrored));
+    }
