@@ -0,0 +1,99 @@
+//! Basin Battle's action-combat extension, not part of 1.12.1: a soulslike mouse and an aiming
+//! camera for the Elwynn Survival add-on. Everything here is off until an add-on switches it on,
+//! so the stock client behaves exactly as before.
+//!
+//! - `SetActionMouse(on)`: the left button belongs to the add-on (its `BUTTON1` binding: a swing
+//!   or a shot) and never to the camera, so it neither drags the view nor selects. The middle
+//!   button takes over the left button's world role: drag to orbit the camera, click to select
+//!   or use. Holding left and right together still runs forward, except while the aiming camera
+//!   is up.
+//! - `SetAimCamera(on[, distance[, right[, up]]])`: ease the camera in close over the right
+//!   shoulder (yards back, to the right, and up from the framing pivot), slow the look a little
+//!   for precision, and keep a left click from running while it's up.
+//! - `HasActionCombat()`: 1, so an add-on can tell this client from a stock one.
+
+use std::sync::atomic::{AtomicBool, AtomicU32, Ordering};
+
+use mlua::{Lua, MultiValue, Value};
+
+static ACTION_MOUSE: AtomicBool = AtomicBool::new(false);
+static AIM_CAMERA: AtomicBool = AtomicBool::new(false);
+static AIM_DISTANCE: AtomicU32 = AtomicU32::new(2.4f32.to_bits());
+static AIM_RIGHT: AtomicU32 = AtomicU32::new(0.75f32.to_bits());
+static AIM_UP: AtomicU32 = AtomicU32::new(0.25f32.to_bits());
+
+/// The left button is the add-on's and the middle button plays the stock left button's part.
+pub fn action_mouse() -> bool {
+    ACTION_MOUSE.load(Ordering::Relaxed)
+}
+
+/// The over-the-shoulder aiming camera is wanted.
+pub fn aim_camera() -> bool {
+    AIM_CAMERA.load(Ordering::Relaxed)
+}
+
+/// The aiming camera's seat: yards behind the pivot, to its right, and above it.
+pub fn aim_shape() -> (f32, f32, f32) {
+    let f = |a: &AtomicU32| f32::from_bits(a.load(Ordering::Relaxed));
+    (f(&AIM_DISTANCE), f(&AIM_RIGHT), f(&AIM_UP))
+}
+
+/// Switch both off (leaving the world, a new session).
+pub fn reset() {
+    ACTION_MOUSE.store(false, Ordering::Relaxed);
+    AIM_CAMERA.store(false, Ordering::Relaxed);
+}
+
+/// A Lua truth as the 1.12 API reads flags: nil, false and 0 are off.
+fn truthy(v: Option<&Value>) -> bool {
+    match v {
+        None | Some(Value::Nil) => false,
+        Some(Value::Boolean(b)) => *b,
+        Some(Value::Integer(i)) => *i != 0,
+        Some(Value::Number(n)) => *n != 0.0,
+        Some(_) => true,
+    }
+}
+
+fn number(v: Option<&Value>, lo: f32, hi: f32) -> Option<f32> {
+    let n = match v? {
+        Value::Integer(i) => *i as f32,
+        Value::Number(n) => *n as f32,
+        Value::String(s) => s.to_str().ok()?.trim().parse::<f32>().ok()?,
+        _ => return None,
+    };
+    n.is_finite().then(|| n.clamp(lo, hi))
+}
+
+pub(crate) fn install(lua: &Lua) -> mlua::Result<()> {
+    let g = lua.globals();
+    g.set(
+        "SetActionMouse",
+        lua.create_function(|_, args: MultiValue| {
+            ACTION_MOUSE.store(truthy(args.front()), Ordering::Relaxed);
+            Ok(())
+        })?,
+    )?;
+    g.set(
+        "SetAimCamera",
+        lua.create_function(|_, args: MultiValue| {
+            let v: Vec<Value> = args.into_iter().collect();
+            if let Some(d) = number(v.get(1), 0.5, 15.0) {
+                AIM_DISTANCE.store(d.to_bits(), Ordering::Relaxed);
+            }
+            if let Some(r) = number(v.get(2), -3.0, 3.0) {
+                AIM_RIGHT.store(r.to_bits(), Ordering::Relaxed);
+            }
+            if let Some(u) = number(v.get(3), -2.0, 3.0) {
+                AIM_UP.store(u.to_bits(), Ordering::Relaxed);
+            }
+            AIM_CAMERA.store(truthy(v.first()), Ordering::Relaxed);
+            Ok(())
+        })?,
+    )?;
+    g.set(
+        "HasActionCombat",
+        lua.create_function(|_, _: MultiValue| Ok(1))?,
+    )?;
+    Ok(())
+}
