+    pub fn projection() -> Projection {
+        Projection::from(PerspectiveProjection {
+            far: CAM_FAR,
+            near: NEARCLIP_DEFAULT,
+            fov: CAM_FOVY,
+            ..default()
+        })
+    }
+
+    /// The vertical field of view at `zoom` times the normal one (a spyglass narrows it).
+    pub fn zoomed_fovy(zoom: f32) -> f32 {
+        CAM_FOVY * zoom
+    }
+}
