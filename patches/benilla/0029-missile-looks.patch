@@ -154,6 +154,19 @@
 //! the factor its `GAMEOBJECT_LEVEL` holds as a float's bits (`benilla-app`'s
 //! `entities::stretch`), and displays from 60000 name doodads the data has no row for
 //! (`benilla-formats`'s `EXTRA_DISPLAYS`): a rope from one point to another.
+//!
+//! The twentieth (`HasActionCombat() >= 20`), a spell's missiles made to read:
+//!
+//! - `SetMissileLook(spellId, colour, width, seconds[, scale[, spin]])`: from now on every missile
+//!   of that spell trails a glowing ribbon of `colour` (`"RRGGBB"`, or nil for none) `width`
+//!   yards wide, each stretch of it fading over `seconds`; its model is drawn `scale` times its
+//!   size (1 when absent) and turns `spin` times a second about its up axis, flat, as a boomerang
+//!   does (0 when absent). A missile reads its spell's look as it flies and for a quarter second
+//!   after, so a look set in the same moment as the cast (a ricochet's new colour) still takes.
+//! - `SetMissileLook(spellId, colour, width, seconds, scale, spin, caster)`: with a unit's guid
+//!   (`"0x..."`) last, the look is for that caster's next missile of the spell alone, within half a
+//!   second (a ricochet's new colour), and the spell's own look stays for the rest.
+//! - `SetMissileLook(spellId)` takes the look away; `SetMissileLook()` takes every one away.
 
 use std::sync::atomic::{AtomicBool, AtomicU32, Ordering};
 
@@ -534,6 +547,69 @@ pub enum GroundMarkerCall {
 
 static GROUND_MARKERS: std::sync::Mutex<Vec<GroundMarkerCall>> = std::sync::Mutex::new(Vec::new());
 
+/// How a spell's missiles look (`SetMissileLook`): a ribbon behind them, their size and a spin.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct MissileLook {
+    /// The ribbon's colour, 0 to 1 a channel; `None` draws none.
+    pub trail: Option<[f32; 3]>,
+    /// The ribbon's width in yards.
+    pub width: f32,
+    /// How long a stretch of it takes to fade, in seconds.
+    pub secs: f32,
+    /// The model's size against its own.
+    pub scale: f32,
+    /// Turns a second about the missile's up axis.
+    pub spin: f32,
