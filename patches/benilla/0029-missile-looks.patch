@@ -0,0 +1,364 @@
+//! Basin Battle's missile looks, not part of 1.12.1 (`SetMissileLook`, `HasActionCombat() >= 20`):
+//! a chosen spell's missiles trail a glowing ribbon, are drawn larger, and spin flat as they fly,
+//! so an arrow or a thrown axe reads at night and a ricochet's new colour shows where it bounced.
+//!
+//! A missile is dressed from its spell's look as it flies, and for [`LATCH_SECS`] after, so a look
+//! set in the same moment as the cast still takes: the add-on's line and the cast's packet arrive
+//! together but run in either order. Its ribbon is its own entity, following the missile while it
+//! flies and fading out where it ended once it lands.
+//!
+//! The ribbon faces the camera: each stretch between two samples of the missile's path is a strip
+//! `width` wide across the view, soft at its edges (a bright core, nothing at the rim) and fading
+//! from the head back over `secs`, drawn additively so it glows against a dark scene, depth-tested
+//! so a wall still hides it.
+
+use std::collections::VecDeque;
+
+use benilla_ui::action_combat::{self, MissileLook};
+use benilla_world::particles::buffer::{EffectVertex, WorldEffectDraw};
+use benilla_world::view::WorldCamera;
+use bevy::prelude::*;
+
+use crate::entities::{MissileSpell, MissileSpin};
+
+/// How long after it flies a missile still takes a look set late, or a new colour.
+const LATCH_SECS: f32 = 0.25;
+
+/// The shortest step between two samples of the path, yards: a slow missile adds none in place.
+const MIN_STEP: f32 = 0.05;
+
+/// The most samples a ribbon keeps (a long, slow flight trims its tail).
+const MOST_SAMPLES: usize = 256;
+
+/// Narrowest the tail gets against the head's width.
+const TAIL_WIDTH: f32 = 0.35;
+
+/// A missile its look has dressed, or that had none to take in time.
+#[derive(Component)]
+struct Dressed;
+
+/// A missile's ribbon: the path it flew, each point with when, in the world (Bevy's axes).
+#[derive(Component)]
+pub(crate) struct MissileTrail {
+    /// The missile it follows while it flies; `None` once it's gone, and the rest fades.
+    follow: Option<Entity>,
+    spell: u32,
+    /// The caster's guid, for a colour meant for its next missile alone.
+    caster: u64,
+    born: f32,
+    rgb: [f32; 3],
+    width: f32,
+    secs: f32,
+    samples: VecDeque<(Vec3, f32)>,
+}
+
+impl MissileTrail {
+    fn new(
+        follow: Entity,
+        spell: u32,
+        caster: u64,
+        born: f32,
+        rgb: [f32; 3],
+        look: &MissileLook,
+    ) -> Self {
+        Self {
+            follow: Some(follow),
+            spell,
+            caster,
+            born,
+            rgb,
+            width: look.width,
+            secs: look.secs.max(0.05),
+            samples: VecDeque::new(),
+        }
+    }
+
+    /// The point the missile is at now, if it has moved far enough since the last.
+    fn sample(&mut self, at: Vec3, now: f32) {
+        if self
+            .samples
+            .back()
+            .is_some_and(|(p, _)| p.distance(at) < MIN_STEP)
+        {
+            return;
+        }
+        self.samples.push_back((at, now));
+        while self.samples.len() > MOST_SAMPLES {
+            self.samples.pop_front();
+        }
+    }
+
+    /// Drop what has faded; true while anything is left (or the missile still flies).
+    fn age(&mut self, now: f32) -> bool {
+        while self
+            .samples
+            .front()
+            .is_some_and(|(_, t)| now - *t > self.secs)
+        {
+            self.samples.pop_front();
+        }
+        self.follow.is_some() || self.samples.len() >= 2
+    }
+}
+
+/// The strip across the view for a ribbon: for each stretch, two quads (rim to core, core to rim)
+/// in `[a0, a1, b1, b0]` order, the lane's quad winding. Empty under two samples.
+fn ribbon(
+    samples: &VecDeque<(Vec3, f32)>,
+    now: f32,
+    secs: f32,
+    width: f32,
+    rgb: [f32; 3],
+    eye: Vec3,
+) -> Vec<EffectVertex> {
+    let pts: Vec<(Vec3, f32)> = samples.iter().copied().collect();
+    let mut out = Vec::new();
+    if pts.len() < 2 {
+        return out;
+    }
+    // Each point's half-width across the view, and its strength: 1 at the head, 0 as it fades.
+    let across = |i: usize| -> (Vec3, f32) {
+        let (p, t) = pts[i];
+        let along = if i + 1 < pts.len() {
+            pts[i + 1].0 - p
+        } else {
+            p - pts[i - 1].0
+        };
+        let side = along.cross(eye - p).normalize_or_zero();
+        let fade = (1.0 - (now - t) / secs).clamp(0.0, 1.0);
+        let half = 0.5 * width * (TAIL_WIDTH + (1.0 - TAIL_WIDTH) * fade);
+        (side * half, fade)
+    };
+    let vert = |pos: Vec3, a: f32| EffectVertex {
+        pos: pos.to_array(),
+        uv: [0.0, 0.0],
+        // Additive: the colour carries its own strength.
+        color: [rgb[0] * a, rgb[1] * a, rgb[2] * a, a],
+    };
+    for i in 0..pts.len() - 1 {
+        let (p0, p1) = (pts[i].0, pts[i + 1].0);
+        let ((s0, f0), (s1, f1)) = (across(i), across(i + 1));
+        let (a0, a1) = (f0 * f0, f1 * f1);
+        // Rim to core, then core to rim.
+        out.extend([
+            vert(p0 + s0, 0.0),
+            vert(p1 + s1, 0.0),
+            vert(p1, a1),
+            vert(p0, a0),
+        ]);
+        out.extend([
+            vert(p0, a0),
+            vert(p1, a1),
+            vert(p1 - s1, 0.0),
+            vert(p0 - s0, 0.0),
+        ]);
+    }
+    out
+}
+
+/// A missile in flight takes its look: one set for this caster's next missile of the spell, else
+/// the spell's own: its size, its spin and a ribbon behind it.
+fn dress_missiles(
+    mut commands: Commands,
+    time: Res<Time>,
+    guids: Query<&crate::net::Guid>,
+    mut new: Query<(Entity, &MissileSpell, &mut Transform), Without<Dressed>>,
+) {
+    let now = time.elapsed_secs();
+    for (entity, spell, mut transform) in &mut new {
+        let caster = guids.get(spell.caster).map_or(0, |g| g.0);
+        let once = action_combat::take_missile_look_once(spell.spell, caster);
+        let Some(look) = once.or_else(|| action_combat::missile_look(spell.spell)) else {
+            if now - spell.born > LATCH_SECS {
+                commands.entity(entity).insert(Dressed);
+            }
+            continue;
+        };
+        commands.entity(entity).insert(Dressed);
+        if (look.scale - 1.0).abs() > 1.0e-3 {
+            transform.scale = Vec3::splat(look.scale);
+        }
+        if look.spin != 0.0 {
+            commands.entity(entity).insert(MissileSpin {
+                turns: look.spin,
+                angle: 0.0,
+            });
+        }
+        if let Some(rgb) = look.trail.filter(|_| look.width > 0.0 && look.secs > 0.0) {
+            commands.spawn(MissileTrail::new(
+                entity,
+                spell.spell,
+                caster,
+                spell.born,
+                rgb,
+                &look,
+            ));
+        }
+    }
+}
+
+/// Every ribbon follows its missile, takes a colour changed in its first moment, fades, and is
+/// drawn; one whose missile has landed and whose last stretch has faded goes.
+fn draw_missile_trails(
+    mut commands: Commands,
+    time: Res<Time>,
+    mut draw: WorldEffectDraw,
+    white: Res<MissileTrailWhite>,
+    world_cam: Query<(Entity, &GlobalTransform), With<WorldCamera>>,
+    missiles: Query<&GlobalTransform, With<MissileSpell>>,
+    mut trails: Query<(Entity, &mut MissileTrail)>,
+) {
+    let now = time.elapsed_secs();
+    let cam = world_cam.single().ok();
+    for (entity, mut trail) in &mut trails {
+        if let Some(m) = trail.follow {
+            match missiles.get(m) {
+                Ok(at) => trail.sample(at.translation(), now),
+                Err(_) => trail.follow = None,
+            }
+        }
+        // A colour set a moment late (a ricochet's, for this missile alone) still takes.
+        if now - trail.born < LATCH_SECS {
+            if let Some(rgb) = action_combat::take_missile_look_once(trail.spell, trail.caster)
+                .and_then(|l| l.trail)
+            {
+                trail.rgb = rgb;
+            }
+        }
+        if !trail.age(now) {
+            commands.entity(entity).despawn();
+            continue;
+        }
+        let Some((cam, eye)) = cam.map(|(e, g)| (e, g.translation())) else {
+            continue;
+        };
+        let verts = ribbon(&trail.samples, now, trail.secs, trail.width, trail.rgb, eye);
+        if verts.is_empty() {
+            continue;
+        }
+        let anchor = trail.samples.back().map_or(Vec3::ZERO, |(p, _)| *p);
+        let mut batch = draw
+            .batch(cam, white.0.id())
+            .additive()
+            .anchored(anchor)
+            .owner(entity);
+        batch.extend(verts);
+        batch.quads();
+    }
+}
+
+/// The 1×1 white texel the ribbon samples: pure vertex colour.
+#[derive(Resource)]
+struct MissileTrailWhite(Handle<Image>);
+
+fn init_trail_white(mut commands: Commands, mut images: ResMut<Assets<Image>>) {
+    commands.insert_resource(MissileTrailWhite(images.add(Image::default())));
+}
+
+/// Registers the missile looks.
+pub(crate) struct MissileLookPlugin;
+
+impl Plugin for MissileLookPlugin {
+    fn build(&self, app: &mut App) {
+        app.add_systems(Startup, init_trail_white)
+            .add_systems(Update, dress_missiles)
+            .add_systems(
+                PostUpdate,
+                draw_missile_trails
+                    .in_set(benilla_world::billboard::BillboardPlace)
+                    .after(bevy::transform::TransformSystems::Propagate)
+                    // A lane that writes before the frame's clear loses everything it pushed.
+                    .after(benilla_world::particles::buffer::begin_effect_frame),
+            );
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn samples(n: usize, step: f32, dt: f32) -> VecDeque<(Vec3, f32)> {
+        (0..n)
+            .map(|i| (Vec3::new(i as f32 * step, 0.0, 0.0), i as f32 * dt))
+            .collect()
+    }
+
+    #[test]
+    fn a_ribbon_is_two_soft_quads_a_stretch_bright_at_the_head_and_gone_at_the_faded_tail() {
+        let s = samples(5, 1.0, 0.1);
+        let now = 0.4;
+        let v = ribbon(
+            &s,
+            now,
+            0.4,
+            0.5,
+            [1.0, 0.5, 0.0],
+            Vec3::new(2.0, 0.0, 10.0),
+        );
+        assert_eq!(
+            v.len(),
+            4 * 2 * 4,
+            "two quads of four for each of the 4 stretches"
+        );
+        // The rim carries nothing; the core at the head is full, at the faded tail nothing.
+        assert!(v
+            .iter()
+            .filter(|x| x.color[3] > 0.0)
+            .all(|x| x.color[3] <= 1.0));
+        let head = v
+            .iter()
+            .filter(|x| (x.pos[0] - 4.0).abs() < 1.0e-4 && x.pos[1].abs() < 1.0e-4)
+            .map(|x| x.color[3])
+            .fold(0.0, f32::max);
+        let tail = v
+            .iter()
+            .filter(|x| x.pos[0].abs() < 1.0e-4 && x.pos[1].abs() < 1.0e-4)
+            .map(|x| x.color[3])
+            .fold(0.0, f32::max);
+        assert!((head - 1.0).abs() < 1.0e-4, "head {head}");
+        assert!(tail < 1.0e-4, "tail {tail}");
+        // Across the view: the eye looks down Z, so the strip spreads along Y.
+        let spread = v.iter().map(|x| x.pos[1].abs()).fold(0.0, f32::max);
+        assert!(
+            (spread - 0.25).abs() < 1.0e-3,
+            "half the width at the head: {spread}"
+        );
+    }
+
+    #[test]
+    fn under_two_samples_there_is_nothing_to_draw() {
+        assert!(ribbon(&samples(1, 1.0, 0.1), 0.0, 0.4, 0.5, [1.0; 3], Vec3::Z).is_empty());
+    }
+
+    #[test]
+    fn a_trail_keeps_only_what_has_not_faded_and_goes_once_its_missile_has() {
+        let mut t = MissileTrail::new(
+            Entity::PLACEHOLDER,
+            75,
+            0,
+            0.0,
+            [1.0; 3],
+            &MissileLook {
+                trail: Some([1.0; 3]),
+                width: 0.3,
+                secs: 0.3,
+                scale: 1.0,
+                spin: 0.0,
+            },
+        );
+        for i in 0..10 {
+            t.sample(Vec3::new(i as f32, 0.0, 0.0), i as f32 * 0.1);
+        }
+        // A step too small adds nothing.
+        t.sample(Vec3::new(9.01, 0.0, 0.0), 0.95);
+        assert_eq!(t.samples.len(), 10);
+        assert!(t.age(0.95));
+        assert!(
+            t.samples.len() <= 4,
+            "only the last 0.3 s: {}",
+            t.samples.len()
+        );
+        t.follow = None;
+        assert!(!t.age(5.0), "all faded, the missile gone");
+    }
+}
diff --git a/crates/benilla-ui/src/action_combat.rs b/crates/benilla-ui/src/action_combat.rs
