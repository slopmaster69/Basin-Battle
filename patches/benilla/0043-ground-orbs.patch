diff --git a/crates/benilla-app/src/entities/ground_orb.rs b/crates/benilla-app/src/entities/ground_orb.rs
new file mode 100644
index 00000000..c14344be
--- /dev/null
+++ b/crates/benilla-app/src/entities/ground_orb.rs
@@ -0,0 +1,165 @@
+//! Basin Battle: an orb rolled along the ground (`PlayGroundOrb`, `StopGroundOrb`), Frozen Orb's
+//! look: a spell model carried from one spot to another at the orb's own pace, a little over the
+//! ground, spinning flat as it goes (retail's Orb of Frost), and shrinking away when it's stopped
+//! or spent. The model is any spell effect's (`Spells\Ice_Missile_Uber.mdx`), loaded and dressed
+//! as a missile's is.
+
+use std::collections::HashMap;
+
+use bevy::prelude::*;
+
+use benilla_assets::coords::wow_to_bevy;
+use benilla_ui::action_combat::{self, GroundOrbCall};
+
+use super::spell_fx::{attach_effect_visuals, ensure_model, EffectHost, FxMaterials, SpellFx};
+
+/// How far over the ground the orb's centre rides (yards).
+const HEIGHT: f32 = 0.9;
+/// How long it takes to shrink away once stopped or spent.
+const GONE_SECS: f32 = 0.25;
+/// The model's flight clip (a missile's in-flight sequence).
+const INFLIGHT_ANIM: u16 = 144;
+
+#[derive(Component)]
+pub(crate) struct GroundOrb {
+    from: Vec3,
+    to: Vec3,
+    start: f32,
+    secs: f32,
+    /// Radians a second it spins about the up axis.
+    spin: f32,
+    scale: f32,
+    path: String,
+    parts_spawned: bool,
+    /// Stopped (or spent) at: it shrinks away from here.
+    gone_at: Option<f32>,
+}
+
+#[derive(Resource, Default)]
+pub(crate) struct GroundOrbs(HashMap<String, Entity>);
+
+/// Take the add-on's calls: start an orb rolling, or stop one where it is.
+pub(super) fn drive_ground_orbs(
+    mut commands: Commands,
+    time: Res<Time>,
+    mut list: ResMut<GroundOrbs>,
+    mut orbs: Query<(Entity, &mut GroundOrb, &mut Transform)>,
+) {
+    let now = time.elapsed_secs();
+    for call in action_combat::take_ground_orbs() {
+        match call {
+            GroundOrbCall::Play { key, model, from, to, secs, scale, spin } => {
+                if let Some(old) = list.0.remove(&key) {
+                    commands.entity(old).try_despawn();
+                }
+                let from = wow_to_bevy(from) + Vec3::Y * HEIGHT;
+                let to = wow_to_bevy(to) + Vec3::Y * HEIGHT;
+                let e = commands
+                    .spawn((
+                        Transform::from_translation(from).with_scale(Vec3::splat(scale)),
+                        Visibility::default(),
+                        GroundOrb {
+                            from,
+                            to,
+                            start: now,
+                            secs: secs.max(0.05),
+                            spin: spin.to_radians(),
+                            scale,
+                            path: model,
+                            parts_spawned: false,
+                            gone_at: None,
+                        },
+                    ))
+                    .id();
+                list.0.insert(key, e);
+            }
+            GroundOrbCall::Stop { key } => {
+                if let Some(&e) = list.0.get(&key) {
+                    if let Ok((_, mut o, _)) = orbs.get_mut(e) {
+                        if o.gone_at.is_none() {
+                            o.gone_at = Some(now);
+                        }
+                    }
+                }
+            }
+        }
+    }
+    // Roll, spin, and shrink away when stopped or spent.
+    let mut done = Vec::new();
+    for (e, mut o, mut tf) in &mut orbs {
+        let age = now - o.start;
+        let t = (age / o.secs).clamp(0.0, 1.0);
+        if t >= 1.0 && o.gone_at.is_none() {
+            o.gone_at = Some(now);
+        }
+        let held = o.gone_at.map_or(t, |g| ((g - o.start) / o.secs).clamp(0.0, 1.0));
+        tf.translation = o.from.lerp(o.to, held);
+        tf.rotation = Quat::from_rotation_y(o.spin * age);
+        let shrink = o.gone_at.map_or(1.0, |g| 1.0 - ((now - g) / GONE_SECS).clamp(0.0, 1.0));
+        tf.scale = Vec3::splat((o.scale * shrink).max(0.001));
+        if o.gone_at.is_some_and(|g| now - g >= GONE_SECS) {
+            done.push(e);
+        }
+    }
+    for e in done {
+        commands.entity(e).try_despawn();
+        list.0.retain(|_, v| *v != e);
+    }
+}
+
+/// Dress each orb in its model once it has loaded, as a missile's is.
+#[allow(clippy::too_many_arguments)]
+pub(super) fn attach_ground_orb_models(
+    mut commands: Commands,
+    mut orbs: Query<(Entity, &mut GroundOrb)>,
+    fx: Option<ResMut<SpellFx>>,
+    asset_server: Res<AssetServer>,
+    time: Res<Time>,
+    mut wow_materials: ResMut<Assets<benilla_assets::materials::WowModelMaterial>>,
+    mut tint_reg: ResMut<super::spell_fx::FxTintAnims>,
+    mut uv_reg: ResMut<benilla_world::doodad_anim::UvAnimMaterials>,
+    mut anim_table: ResMut<benilla_world::mat_anim_table::MatAnimTable>,
+    ibps: Res<Assets<bevy::mesh::skinning::SkinnedMeshInverseBindposes>>,
+    mut palettes: ResMut<benilla_world::rig_palette::RigPalettes>,
+) {
+    let Some(mut fx) = fx else {
+        return;
+    };
+    for (entity, mut orb) in &mut orbs {
+        if orb.parts_spawned {
+            continue;
+        }
+        let key = orb.path.clone();
+        ensure_model(&mut fx, &asset_server, &key);
+        let Some(dm) = fx.models.get(&key) else {
+            continue;
+        };
+        if let Some(c) = action_combat::effect_tint(&key) {
+            commands.entity(entity).insert(benilla_world::model_fade::EffectTint([
+                f32::from(c[0]) / 255.0,
+                f32::from(c[1]) / 255.0,
+                f32::from(c[2]) / 255.0,
+            ]));
+        }
+        if attach_effect_visuals(
+            &mut commands,
+            entity,
+            dm,
+            time.elapsed_secs(),
+            false,
+            EffectHost::default(),
+            None,
+            &mut FxMaterials {
+                store: &mut wow_materials,
+                tint: &mut tint_reg,
+                uv: &mut uv_reg,
+                table: &mut anim_table,
+            },
+            &ibps,
+            &mut palettes,
+            Some(INFLIGHT_ANIM),
+        ) {
+            orb.parts_spawned = true;
+        }
+    }
+}
