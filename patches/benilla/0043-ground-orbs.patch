@@ -796,6 +804,28 @@ pub enum GroundRingCall {
 
 static RINGS: std::sync::Mutex<Vec<GroundRingCall>> = std::sync::Mutex::new(Vec::new());
 
+/// An orb rolled on the ground (`PlayGroundOrb`, `StopGroundOrb`).
+#[derive(Clone, Debug, PartialEq)]
+pub enum GroundOrbCall {
+    Play { key: String, model: String, from: [f32; 3], to: [f32; 3], secs: f32, scale: f32, spin: f32 },
+    Stop { key: String },
+}
+
+static ORBS: std::sync::Mutex<Vec<GroundOrbCall>> = std::sync::Mutex::new(Vec::new());
+
+/// The orb calls since the last.
+pub fn take_ground_orbs() -> Vec<GroundOrbCall> {
+    ORBS.lock().map(|mut v| std::mem::take(&mut *v)).unwrap_or_default()
+}
+
+fn push_orb(c: GroundOrbCall) {
+    if let Ok(mut v) = ORBS.lock() {
+        if v.len() < 64 {
+            v.push(c);
+        }
+    }
+}
+
 static EFFECT_TINTS: std::sync::Mutex<Option<std::collections::HashMap<String, [u8; 3]>>> = std::sync::Mutex::new(None);
 
 /// An effect model's path as the tints key it: lower case, back slashes, no extension.
@@ -1401,6 +1431,37 @@ pub(crate) fn install(lua: &Lua) -> mlua::Result<()> {
             Ok(())
         })?,
     )?;
