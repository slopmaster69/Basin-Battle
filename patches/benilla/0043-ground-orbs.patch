+        "PlayGroundOrb",
+        lua.create_function(|_, args: MultiValue| {
+            let v: Vec<Value> = args.into_iter().collect();
+            let n = |i: usize| number(v.get(i), -1.0e6, 1.0e6);
+            if let (Some(key), Some(model), Some(x), Some(y), Some(z), Some(x2), Some(y2), Some(z2), Some(secs)) =
+                (text(v.first()), text(v.get(1)), n(2), n(3), n(4), n(5), n(6), n(7), number(v.get(8), 0.05, 60.0))
+            {
+                push_orb(GroundOrbCall::Play {
+                    key,
+                    model,
+                    from: [x, y, z],
+                    to: [x2, y2, z2],
+                    secs,
+                    scale: number(v.get(9), 0.05, 20.0).unwrap_or(1.0),
+                    spin: number(v.get(10), -5000.0, 5000.0).unwrap_or(540.0),
+                });
+            }
+            Ok(())
+        })?,
+    )?;
+    g.set(
+        "StopGroundOrb",
+        lua.create_function(|_, args: MultiValue| {
+            let v: Vec<Value> = args.into_iter().collect();
+            if let Some(key) = text(v.first()) {
+                push_orb(GroundOrbCall::Stop { key });
+            }
+            Ok(())
+        })?,
+    )?;
