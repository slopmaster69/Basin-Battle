From c336f753e23ae014756cd3028c31ecae918f36e2 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 5 Nov 2026 21:05:14 -0600
Subject: [PATCH] The aim's lean bows toward the aim, not about the turned
 shoulders

The upper body leans with the aiming camera's pitch about its right. It took
the shoulders' right after the bow draw's turn, which lies 0.7 rad off the
aim: a steep aim then rolled the bow sideways and pointed it right. The lean
now turns about the aim's own right (the spine's share of the gap), so the
bow stays upright on the aim and only tips toward it.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 crates/benilla-app/src/creature_anim/twist.rs | 51 +++++++++++++++----
 1 file changed, 42 insertions(+), 9 deletions(-)

diff --git a/crates/benilla-app/src/creature_anim/twist.rs b/crates/benilla-app/src/creature_anim/twist.rs
index eafa2d83..56ac1bca 100644
--- a/crates/benilla-app/src/creature_anim/twist.rs
+++ b/crates/benilla-app/src/creature_anim/twist.rs
@@ -130,6 +130,9 @@ pub(super) fn apply_body_twist(
             armed_shares(twist.yaw_gap, mounted)
         };
         let pitch = if mounted { 0.0 } else { twist.pitch };
+        // The lean bows toward the aim: about the aim's right, which is the spine's share of the
+        // gap, not the shoulders' turn below.
+        let lean_yaw = spine;
         // The turn right is a negative yaw about up (forward is −Z); the head undoes it.
         let turn = if mounted { 0.0 } else { twist.turn };
         let (spine, head) = (spine - turn, head + turn);
@@ -186,14 +189,7 @@ pub(super) fn apply_body_twist(
                             };
                             e = p;
                         }
-                        let inv = g.inverse();
-                        let yawed = base * Quat::from_axis_angle(inv * Vec3::Y, angle);
-                        // The lean about the body's right (+X with the body facing −Z).
-                        if lean == 0.0 {
-                            yawed.normalize()
-                        } else {
-                            (yawed * Quat::from_axis_angle(inv * Vec3::X, lean)).normalize()
-                        }
+                        twisted_local(base, g.inverse(), angle, lean, lean_yaw)
                     };
                     Some((cur, base, out))
                 })
@@ -214,6 +210,20 @@ pub(super) fn apply_body_twist(
     }
 }
 
+/// A channel's new local rotation: the bone yawed `yaw` about the unit's up, then leaned `lean`
+/// about the aim's right (the unit's +X yawed by `lean_yaw`), both through the bone's pivot, so
+/// the bone's rotation up to the unit becomes `R(right, lean) · R(up, yaw) · g` (`inv` = `g⁻¹`).
+/// Leaning about the aim's right, not the turned shoulders' own, bows the upper body toward the
+/// aim: a squared side-on bow draw leaning about its own shoulders rolled the bow sideways.
+fn twisted_local(base: Quat, inv: Quat, yaw: f32, lean: f32, lean_yaw: f32) -> Quat {
+    let yawed = Quat::from_axis_angle(inv * Vec3::Y, yaw);
+    if lean == 0.0 {
+        return (base * yawed).normalize();
+    }
+    let right = Quat::from_rotation_y(lean_yaw) * Vec3::X;
+    (base * Quat::from_axis_angle(inv * right, lean) * yawed).normalize()
+}
+
 /// Register [`apply_body_twist`] in the pose post-pass window.
 pub(super) fn plugin(app: &mut App) {
     app.add_systems(
@@ -230,9 +240,32 @@ fn twist_off() -> bool {
 
 #[cfg(test)]
 mod tests {
-    use super::{aim_locked_shares, armed_shares, twist_shares};
+    use super::{aim_locked_shares, armed_shares, twist_shares, twisted_local};
+    use bevy::prelude::{Quat, Vec3};
     use std::f32::consts::{FRAC_PI_2, FRAC_PI_4, PI};
 
+    /// A shoulder turn and a lean down together: the bone's world rotation is the lean about the
+    /// aim's right after the turn, whatever the bone's own frame, so a bow held up the bone's Y
+    /// stays upright in the aim's plane (no roll) and only tips toward the aim.
+    #[test]
+    fn a_turned_lean_bows_toward_the_aim_without_rolling() {
+        // A bone frame that is neither the unit's nor simple, its parent the unit itself.
+        let g = Quat::from_euler(bevy::math::EulerRot::YXZ, 0.9, -0.3, 0.2);
+        let (turn, lean) = (-0.7, -0.6);
+        let local = twisted_local(g, g.inverse(), turn, lean, 0.0);
+        let want = Quat::from_axis_angle(Vec3::X, lean) * Quat::from_axis_angle(Vec3::Y, turn) * g;
+        assert!(local.angle_between(want) < 1e-4, "{local:?} vs {want:?}");
+        // The base pose's bow, upright and 0.7 left of forward, ends upright and on the aim.
+        let flat = twisted_local(Quat::IDENTITY, Quat::IDENTITY, turn, lean, 0.0);
+        let up = flat * Vec3::Y;
+        let along = flat * (Quat::from_rotation_y(-turn) * Vec3::NEG_Z);
+        assert!(up.x.abs() < 1e-5, "the bow rolls sideways: {up:?}");
+        assert!(
+            along.x.abs() < 1e-5 && along.y < 0.0,
+            "the bow points off the aim: {along:?}"
+        );
+    }
+
     /// The mount gate disarms SpineLow alone; the head keeps its share, off the aim.
     #[test]
     fn mounted_disarms_the_spine_and_leaves_the_head_share_alone() {
