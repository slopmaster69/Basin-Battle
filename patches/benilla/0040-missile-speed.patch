+const OWN_SPEED_MOST: f32 = 400.0;
+
 /// One projectile in flight.
 #[derive(Component)]
-pub(super) struct Missile {
+pub(crate) struct Missile {
     spell_id: u32,
     /// A ground arrival plays on the caster (`0x61d870`), a unit arrival on the target.
     caster: Entity,
@@ -184,6 +188,22 @@ pub(super) struct Missile {
     weapon_visual: Option<u32>,
 }
 
+impl Missile {
+    /// Basin Battle: fly the rest of the way at `speed` yards a second (`SetMissileLook`'s tenth
+    /// number), over the speed the launch fitted and its [`DUE_SPEED`] cap, up to
+    /// [`OWN_SPEED_MOST`]. The yards left are what the fitted flight had left; a flight already due
+    /// (nothing left) stays due. Nothing happens for a speed of 0 or less.
+    pub(crate) fn fly_at(&mut self, speed: f32) {
+        if speed.is_nan() || speed <= 0.0 {
+            return;
+        }
+        let speed = speed.min(OWN_SPEED_MOST);
+        let left = (self.arrive_in * self.speed).max(0.0);
+        self.speed = speed;
+        self.arrive_in = left / speed;
+    }
+}
