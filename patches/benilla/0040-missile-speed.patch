+    /// Basin Battle: a look's own speed refits the yards left, past the launch's 100 yd/s cap.
+    #[test]
+    fn a_missiles_own_speed_refits_the_rest_of_its_flight_past_the_launch_cap() {
+        let mut app = app();
+        let caster = caster(&mut app, Vec3::ZERO);
+        let target = app
+            .world_mut()
+            .spawn(GlobalTransform::from_xyz(24.0, 0.0, 0.0))
+            .id();
+        app.world_mut().write_message(go(caster, target, false));
+        step(&mut app, 0.0);
+        let entity = app
+            .world_mut()
+            .query_filtered::<Entity, With<Missile>>()
+            .single(app.world())
+            .unwrap();
+        let mut m = app.world_mut().get_mut::<Missile>(entity).unwrap();
+        // 24 yd at 24 yd/s: a second left.
+        assert!((m.arrive_in - 1.0).abs() < 1e-4);
+        m.fly_at(160.0);
+        assert!((m.arrive_in - 24.0 / 160.0).abs() < 1e-5, "{}", m.arrive_in);
+        assert_eq!(m.speed, 160.0);
+        // Capped at its most; 0 does nothing.
+        m.fly_at(1.0e6);
+        assert_eq!(m.speed, 400.0);
+        assert!((m.arrive_in - 24.0 / 400.0).abs() < 1e-5);
+        m.fly_at(0.0);
+        assert_eq!(m.speed, 400.0);
+    }
