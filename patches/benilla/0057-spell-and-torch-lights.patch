+// The new look's light from torches and spells, benilla's own (no reference behaviour): every
+// live entry of the look's table, per pixel. Mirrored from terrain.wgsl (keep in sync).
+const LOOK_WRAP: f32 = 0.5;
+// The darkest a surface counts as under a look light, per channel, so a near-black night texel
+// still takes the light's hue (`look::lights::tune::ALBEDO_FLOOR`, `lit_albedo`).
+const LOOK_FLOOR: f32 = 0.15;
+
+fn look_light_sum(P: vec3<f32>, N: vec3<f32>) -> vec3<f32> {
+    let count = u32(wow_light.point_count.y);
+    var sum = vec3<f32>(0.0);
+    for (var i = 0u; i < count; i = i + 1u) {
+        let pos_radius = wow_light.look_lights[2u * i];
+        let to_light = pos_radius.xyz - P;
+        let d2 = dot(to_light, to_light);
+        let r2 = pos_radius.w * pos_radius.w;
+        if (d2 >= r2) {
+            continue;
+        }
+        let x2 = d2 / r2;
+        let window = (1.0 - x2) * (1.0 - x2);
+        let l = to_light * inverseSqrt(max(d2, 1e-6));
+        let wrapped = clamp((dot(N, l) + LOOK_WRAP) / (1.0 + LOOK_WRAP), 0.0, 1.0);
+        sum += wow_light.look_lights[2u * i + 1u].rgb * (window * wrapped);
+    }
+    return sum;
+}
