+//! Light from torches and spells, the new look's own (no reference behaviour): WoW Forever's
+//! secondary lights in a Classic style. A Fireball lights the ground and the walls as it flies and
+//! where it bursts, a torch casts a warm pool on the ground at night, and a heal glows on the hero.
+//!
+//! The reference lights every surface with at most three point lights, chosen per draw and summed
+//! per vertex (`lighting::global_light`), which benilla keeps exactly. On top of that, under
+//! [`WorldLook::NEW`] only, the light packer (`build_light_data`) ranks the look's candidates near
+//! the camera and writes up to [`MAX_LOOK_LIGHTS`] of them after the reference's point table, and
+//! the terrain, model and static-world shaders add them per pixel (`look_light_sum` in
+//! `terrain.wgsl`, `wow_model.wgsl` and `static_gx.wgsl`, which mirror [`light_at`]). The
+//! candidates are:
+//! - every authored point light ([`WorldPointLight`]: a prop's M2 light, a WMO's MOLT omni, a
+//!   carried torch, a glowing object), as a warm pool scaled by the hour ([`night_weight`]), with a
+//!   slow, small flicker for a flame ([`torch_light`]);
+//! - every [`LookLight`] entity: the spells' lights, which the game hangs on missiles, impacts,
+//!   casts, auras and ground areas, shaped in time by a [`LookPulse`].
+//!
+//! The ranking ([`LookLightSlots`]) keeps the [`ACTIVE_LOOK_LIGHTS`] that matter most to the
+//! camera, brightness against distance ([`score`]), and fades a light in and out as it enters or
+//! leaves that set, so nothing pops; the rest of the table holds the ones fading out. A light whose
+//! entity goes (a missile that lands) fades out from where it last was. Every tunable is in
+//! [`tune`]; `looklights <scale>` ([`LookLightTune`]) scales them all live, for tuning on film.
+
+use bevy::ecs::system::SystemParam;
+use bevy::prelude::*;
+
+use super::WorldLook;
+use crate::lighting::{GameClock, WmoCrossfade, WorldPointLight};
+
+/// Capacity of the look's light table, fixed in the WGSL mirror structs as
+/// `array<vec4<f32>, 48>` (two rows a light): keep in sync.
+pub const MAX_LOOK_LIGHTS: usize = 24;
+
+/// Rows the table takes in the shared light buffer: `[pos.xyz, radius]` and `[rgb, 0]` a light.
+pub const LOOK_LIGHT_ROWS: usize = 2 * MAX_LOOK_LIGHTS;
+
+/// How many lights the ranking keeps lit at once; the other table slots hold lights fading out, so
+/// a light leaving the set never has to vanish to make room. This is also the per-pixel cost's
+/// ceiling: a pixel loops over at most [`MAX_LOOK_LIGHTS`] entries and lights only those in range.
+pub const ACTIVE_LOOK_LIGHTS: usize = 16;
+
+/// Every tunable of the look's lights, in one place. The first values are a guess, to be tuned on
+/// film with `looklights <scale>`. Colours are the gamma frame's own 0..1 values (the world is lit
+/// in gamma, as the reference's), intensities how much of that colour a surface right at the light
+/// takes on top of its own light, radii in yards.
+pub mod tune {
+    /// A torch or lamp's strength at night, for the stock torch's committed colour. Filmed at
+    /// 0.7 in Goldshire at 23:00, a lamp post cast no pool you could see and even `looklights 3`
+    /// moved the frame's mean by under a level in 255: Elwynn's night ground is dark, so a pool
+    /// has to be about three times that to read from 15 to 20 yd.
+    pub const TORCH_INTENSITY: f32 = 2.1;
+    /// The stock torch's committed peak, `(0.467, 0.290, 0.133) × 3` (red 1.4): an authored
+    /// light this bright gets [`TORCH_INTENSITY`], a dimmer or brighter one in proportion.
+    pub const TORCH_REF_PEAK: f32 = 1.4;
+    /// The proportion's floor and ceiling, so a dim candle still reads and a bonfire doesn't
+    /// blind.
+    pub const TORCH_PEAK_MIN: f32 = 0.6;
+    pub const TORCH_PEAK_MAX: f32 = 1.5;
+    /// An authored light dimmer than this (peak) casts no pool.
+    pub const TORCH_PEAK_CUTOFF: f32 = 0.05;
+    /// A torch's pool: every authored light (a lamp post's, a lantern's, a brazier's, a WMO's
+    /// MOLT) casts one this size, whatever its authored reach. From a lamp's head about 4 yd up
+    /// the ground is lit out to about 7 yd, and nothing past 9.
+    pub const TORCH_RADIUS: f32 = 10.0;
+    /// Basin Battle's glowing objects (a planted arrow's 4 yd light, `go_glow`), the only lights
+    /// authored with a reach this short or shorter: a small find-me glow, not a torch, so they
+    /// keep [`GLOW_INTENSITY`] out to [`GLOW_RANGE_SCALE`] times their reach.
+    pub const GLOW_MAX_RANGE: f32 = 6.0;
+    pub const GLOW_RANGE_SCALE: f32 = 1.5;
+    pub const GLOW_INTENSITY: f32 = 0.7;
+    /// A flame's flicker: ±8 % at about one beat a second, slow and small.
+    pub const FLAME_FLICKER: f32 = 0.08;
+    pub const FLAME_FLICKER_HZ: f32 = 1.1;
+    /// A light is a flame when its red is at least this many times its blue (the stock torch's
+    /// is 3.5); a white or blue light burns steady.
+    pub const FLAME_RED_OVER_BLUE: f32 = 1.5;
+
+    /// The hour scaling of torches ([`super::night_weight`]): full from dusk's end to dawn's
+    /// start, [`DAY_FLOOR`] from dawn's end to dusk's start, smoothstepped between (game minutes).
+    pub const DUSK_START: f32 = 17.0 * 60.0;
+    pub const DUSK_END: f32 = 21.0 * 60.0;
+    pub const DAWN_START: f32 = 5.0 * 60.0;
+    pub const DAWN_END: f32 = 9.0 * 60.0;
+    /// What a torch keeps by day: near zero at noon.
+    pub const DAY_FLOOR: f32 = 0.06;
+    /// What a torch keeps by day with the camera inside a building, where the lamps burn all day
+    /// (times the 4 s interior crossfade, so walking in brings them up smoothly).
+    pub const INDOOR_FLOOR: f32 = 0.7;
+
+    /// A missile in flight (Fireball, Frostbolt, Shadow Bolt): it lights the ground under its path.
+    /// Three times the first films' 0.9, which only just showed on Goldshire's night fence.
+    pub const MISSILE_INTENSITY: f32 = 2.7;
+    pub const MISSILE_RADIUS: f32 = 9.0;
+    /// A fire missile's flicker, a touch quicker than a torch's.
+    pub const MISSILE_FLICKER: f32 = 0.1;
+    pub const MISSILE_FLICKER_HZ: f32 = 2.3;
+    /// A physical missile (an arrow) is lit only by Basin Battle's glowing trail colour, at this
+    /// share of a spell's strength.
+    pub const TRAIL_ONLY_SCALE: f32 = 0.6;
+
+    /// An impact: a brighter, shorter light, 0.5 s in all.
+    pub const IMPACT_INTENSITY: f32 = 3.0;
+    pub const IMPACT_RADIUS: f32 = 11.0;
+    pub const IMPACT_RISE: f32 = 0.04;
+    pub const IMPACT_HOLD: f32 = 0.06;
+    pub const IMPACT_FALL: f32 = 0.4;
+
+    /// A heal landing (Holy Light, Flash Heal, Healing Touch): a softer, longer glow on the hero.
+    pub const HEAL_INTENSITY: f32 = 1.6;
+    pub const HEAL_RADIUS: f32 = 5.5;
+    pub const HEAL_RISE: f32 = 0.15;
+    pub const HEAL_HOLD: f32 = 0.35;
+    pub const HEAL_FALL: f32 = 0.9;
+
+    /// A cast being drawn up (the precast and a channel): a glow on the caster that grows in.
+    pub const CAST_INTENSITY: f32 = 1.0;
+    pub const CAST_RADIUS: f32 = 4.5;
+    pub const CAST_RISE: f32 = 0.3;
+    /// The longest a cast's glow stays without its reap (a lost cast-end packet), and how fast it
+    /// then goes.
+    pub const CAST_MAX_SECS: f32 = 20.0;
+    pub const CAST_FALL: f32 = 0.3;
+
+    /// An aura with a visual of its own (a shield, a ward): a faint, breathing glow on its unit.
+    pub const AURA_INTENSITY: f32 = 0.5;
+    pub const AURA_RADIUS: f32 = 4.0;
+    pub const AURA_RISE: f32 = 0.5;
+    pub const AURA_BREATH: f32 = 0.15;
+    pub const AURA_BREATH_HZ: f32 = 0.4;
+
+    /// A ground area (Flamestrike, Consecration, Blizzard): its whole circle glows softly.
+    pub const AREA_INTENSITY: f32 = 1.2;
+    /// The glow reaches this far past the area's own radius, within these bounds.
+    pub const AREA_PAD: f32 = 2.0;
+    pub const AREA_MIN_RADIUS: f32 = 4.0;
+    pub const AREA_MAX_RADIUS: f32 = 14.0;
+    /// Height of an area's light over its centre.
+    pub const AREA_HEIGHT: f32 = 0.6;
+
+    /// Where on a unit its light sits: about the chest of a human.
+    pub const UNIT_HEIGHT: f32 = 1.2;
+    /// Height of a ground impact's light over the point.
+    pub const GROUND_HEIGHT: f32 = 0.5;
+    /// The most impacts one cast lights (an area that hits a crowd lights the first few).
+    pub const MAX_FLASHES_PER_CAST: usize = 6;
+
+    /// Seconds a light takes to fade in on entering the ranked set, and out on leaving it.
+    pub const FADE_IN_SECS: f32 = 0.4;
+    pub const FADE_OUT_SECS: f32 = 0.4;
+    /// Seconds a light whose entity went (a missile that landed) takes to fade out where it was.
+    pub const GONE_FADE_SECS: f32 = 0.15;
+    /// No light farther than this from the camera is a candidate: past it a pool is small and
+    /// fogged.
+    pub const REACH: f32 = 100.0;
+
+    /// The wrap of a light's N·L, the painterly soft side: a surface turned 120° from the light
+    /// still takes a little. Mirrored by `LOOK_WRAP` in the three shaders.
+    pub const WRAP: f32 = 0.5;
+
+    /// The darkest a surface counts as under a look light, per channel: the light multiplies
+    /// `max(texture, this)`, so a near-black night texel (a dark bark, a shadowed path) still
+    /// takes the light's own hue, a warm pool rather than nothing, and a bright one is unchanged.
+    /// Mirrored by `LOOK_FLOOR` in the three shaders.
+    pub const ALBEDO_FLOOR: f32 = 0.15;
+
+    /// A cool spell light (blue its brightest channel: Frostbolt, a frost nova) on Elwynn's warm
+    /// green and brown ground: its other channels lean this far toward white, so it shows as a
+    /// pale ice light rather than vanishing into texels with little blue, and it burns this many
+    /// times brighter.
+    pub const COOL_LIFT: f32 = 0.3;
+    pub const COOL_GAIN: f32 = 1.5;
+
+    /// With the camera outdoors, a building's interior light (a candle in the inn) ranks at this
+    /// share of its brightness, so the street's lamps and the spells win the table's slots; it
+    /// still lights what the doorway shows when there is room.
+    pub const INTERIOR_RANK_OUTSIDE: f32 = 0.3;
+
+    /// The most `looklights` scales by, so a film can sweep 1, 3, 6 and 10.
+    pub const SCALE_MAX: f32 = 10.0;
+}
+
+/// The colour of a spell's light by its `Spell.dbc` school (1 holy, 2 fire, 3 nature, 4 frost,
+/// 5 shadow, 6 arcane), warm and soft; physical (0) and anything else casts none.
+pub fn school_color(school: u32) -> Option<[f32; 3]> {
+    match school {
+        1 => Some([1.0, 0.85, 0.5]), // holy: a warm gold
+        2 => Some([1.0, 0.55, 0.2]), // fire: orange
+        3 => Some([0.55, 1.0, 0.4]), // nature: green
+        4 => Some([0.45, 0.7, 1.0]), // frost: ice blue
+        5 => Some([0.6, 0.3, 1.0]),  // shadow: violet, the light shadow magic gives off
+        6 => Some([0.85, 0.5, 1.0]), // arcane: pink-violet
+        _ => None,
+    }
+}
+
+/// A spell light's colour as it is cast: its hue at a peak of 1 (a dim trail colour is not a dim
+/// light) and, for a cool light, leaned toward white by [`tune::COOL_LIFT`] with
+/// [`tune::COOL_GAIN`]; returns the colour and its strength's gain.
+pub fn spell_light_hue(rgb: [f32; 3]) -> ([f32; 3], f32) {
+    let peak = rgb[0].max(rgb[1]).max(rgb[2]);
+    if peak <= 0.0 {
+        return (rgb, 1.0);
+    }
+    let hue = rgb.map(|c| (c / peak).max(0.0));
+    if hue[2] >= 1.0 && hue[0] < 1.0 && hue[1] < 1.0 {
+        (
+            hue.map(|c| c + (1.0 - c) * tune::COOL_LIFT),
+            tune::COOL_GAIN,
+        )
+    } else {
+        (hue, 1.0)
+    }
+}
+
+/// The colour a look light multiplies on a surface: its texture colour, no darker than
+/// [`tune::ALBEDO_FLOOR`] a channel. The shaders' `max(color, vec3(LOOK_FLOOR))`.
+pub fn lit_albedo(texture: [f32; 3]) -> [f32; 3] {
+    texture.map(|c| c.max(tune::ALBEDO_FLOOR))
+}
+
+/// Whether a school's light is fire's, which flickers.
+pub fn school_flickers(school: u32) -> bool {
+    school == 2
+}
+
+/// A light the game hangs in the world under the new look: a spell's. It sits at its own
+/// transform, or at `anchor` (a unit), `offset` above its origin, and is gone with the anchor.
+#[derive(Component, Clone, Copy, Debug, PartialEq)]
+pub struct LookLight {
+    /// The light's colour, gamma 0..1.
+    pub color: [f32; 3],
+    /// How much of `color` a surface right at the light takes (see [`tune`]).
+    pub intensity: f32,
+    /// Yards; the light falls smoothly to nothing there ([`falloff`]).
+    pub radius: f32,
+    /// The flicker's depth (0 steady) and its base rate in Hz ([`flicker`]).
+    pub flicker: f32,
+    pub flicker_hz: f32,
+    /// The entity it rides, instead of its own transform.
+    pub anchor: Option<Entity>,
+    /// Where on its anchor (or its own transform) it sits.
+    pub offset: Vec3,
+}
+
+impl LookLight {
+    /// A steady light of `color` at `intensity`, out to `radius`, at the entity's own transform.
+    pub fn new(color: [f32; 3], intensity: f32, radius: f32) -> Self {
+        Self {
+            color,
+            intensity,
+            radius,
+            flicker: 0.0,
+            flicker_hz: 0.0,
+            anchor: None,
+            offset: Vec3::ZERO,
+        }
+    }
+
+    /// The same, flickering `depth` at `hz`.
+    pub fn flickering(mut self, depth: f32, hz: f32) -> Self {
+        self.flicker = depth;
+        self.flicker_hz = hz;
+        self
+    }
+
+    /// The same, riding `anchor` at `offset` above its origin.
+    pub fn on(mut self, anchor: Entity, offset: Vec3) -> Self {
+        self.anchor = Some(anchor);
+        self.offset = offset;
+        self
+    }
+}
+
+/// A [`LookLight`]'s shape in time: it rises over `rise`, holds for `hold` (infinite for a glow
+/// that lasts until its owner takes it away) and falls over `fall`, from `born` (seconds of the
+/// app clock). The owner despawns it once [`LookPulse::done`].
+#[derive(Component, Clone, Copy, Debug, PartialEq)]
+pub struct LookPulse {
+    pub born: f32,
+    pub rise: f32,
+    pub hold: f32,
+    pub fall: f32,
+}
+
+impl LookPulse {
+    /// A flash: up over `rise`, held, down over `fall`.
+    pub fn flash(born: f32, rise: f32, hold: f32, fall: f32) -> Self {
+        Self {
+            born,
+            rise,
+            hold,
+            fall,
+        }
+    }
+
+    /// A glow that grows in over `rise` and stays.
+    pub fn held(born: f32, rise: f32) -> Self {
+        Self {
+            born,
+            rise,
+            hold: f32::INFINITY,
+            fall: 0.0,
+        }
+    }
+
+    /// The gain at `now`: smoothstepped up, 1 through the hold, eased out `(1 − t)²` after.
+    pub fn gain(&self, now: f32) -> f32 {
+        let age = now - self.born;
+        if age < 0.0 {
+            return 0.0;
+        }
+        if age < self.rise {
+            return smoothstep(age / self.rise);
+        }
+        let after = age - self.rise - self.hold;
+        if after <= 0.0 {
+            return 1.0;
+        }
+        if after >= self.fall {
+            return 0.0;
+        }
+        let t = 1.0 - after / self.fall;
+        t * t
+    }
+
+    /// Whether it has fallen to nothing for good.
+    pub fn done(&self, now: f32) -> bool {
+        now - self.born >= self.rise + self.hold + self.fall
+    }
+}
+
+/// `looklights <scale>`: every look light's strength, times this (1 is the tuned look).
+#[derive(Resource, Clone, Copy, Debug, PartialEq)]
+pub struct LookLightTune {
+    pub scale: f32,
+}
+
+impl Default for LookLightTune {
+    fn default() -> Self {
+        Self { scale: 1.0 }
+    }
+}
+
+impl LookLightTune {
+    /// The console's argument: a scale from 0 to [`tune::SCALE_MAX`], or nothing (or `tuned`) for
+    /// the tuned look; `None` for anything else, which changes nothing.
+    pub fn parse(args: &str) -> Option<Self> {
+        let arg = args.trim();
+        if arg.is_empty() || arg.eq_ignore_ascii_case("tuned") {
+            return Some(Self::default());
+        }
+        arg.parse::<f32>()
+            .ok()
+            .filter(|v| (0.0..=tune::SCALE_MAX).contains(v))
+            .map(|scale| Self { scale })
+    }
+}
+
+fn smoothstep(t: f32) -> f32 {
+    let t = t.clamp(0.0, 1.0);
+    t * t * (3.0 - 2.0 * t)
+}
+
+/// How strongly torches burn at `minute` of the game day: 1 through the night, [`tune::DAY_FLOOR`]
+/// through the day, smoothstepped across dusk and dawn.
+pub fn night_weight(minute: f32) -> f32 {
+    let m = minute.rem_euclid(1440.0);
+    let night = if m >= tune::DUSK_END || m <= tune::DAWN_START {
+        1.0
+    } else if m < tune::DAWN_END {
+        1.0 - smoothstep((m - tune::DAWN_START) / (tune::DAWN_END - tune::DAWN_START))
+    } else if m <= tune::DUSK_START {
+        0.0
+    } else {
+        smoothstep((m - tune::DUSK_START) / (tune::DUSK_END - tune::DUSK_START))
+    };
+    tune::DAY_FLOOR + (1.0 - tune::DAY_FLOOR) * night
+}
+
+/// The flicker multiplier at `now` for a light seeded `seed`: three slow sines, so it never
+/// repeats visibly, within `1 ± depth`.
+pub fn flicker(depth: f32, hz: f32, now: f32, seed: f32) -> f32 {
+    if depth <= 0.0 || hz <= 0.0 {
+        return 1.0;
+    }
+    let tau = std::f32::consts::TAU;
+    let w = 0.55 * (tau * hz * now + seed).sin()
+        + 0.3 * (tau * hz * 2.37 * now + 1.9 * seed).sin()
+        + 0.15 * (tau * hz * 5.1 * now + 0.7 * seed).sin();
+    1.0 + depth * w
+}
+
+/// A stable phase for an entity's flicker, so two torches never beat together.
+fn seed_of(e: Entity) -> f32 {
+    let bits = e.to_bits().wrapping_mul(0x9e37_79b9_7f4a_7c15);
+    (bits >> 40) as f32 / (1u64 << 24) as f32 * std::f32::consts::TAU
+}
+
+/// The light's fall with distance: `(1 − (d/r)²)²`, full at the light, smooth to nothing at its
+/// radius and beyond. Mirrored by the shaders' `look_light_sum`.
+pub fn falloff(d: f32, radius: f32) -> f32 {
+    if radius <= 0.0 || d >= radius {
+        return 0.0;
+    }
+    let x2 = (d * d) / (radius * radius);
+    (1.0 - x2) * (1.0 - x2)
+}
+
+/// The wrapped N·L, `clamp((N·L + w)/(1 + w))`: a soft side, never a hard terminator.
+pub fn wrap(n_dot_l: f32) -> f32 {
+    ((n_dot_l + tune::WRAP) / (1.0 + tune::WRAP)).clamp(0.0, 1.0)
+}
+
+/// What one packed light adds to a surface at `p` facing `n` (unit): `rgb × falloff × wrap`, the
+/// shaders' `look_light_sum` term, which multiplies the surface's texture colour.
+pub fn light_at(p: Vec3, n: Vec3, light: Vec3, radius: f32, rgb: [f32; 3]) -> [f32; 3] {
+    let to = light - p;
+    let d = to.length();
+    let f = falloff(d, radius);
+    if f <= 0.0 {
+        return [0.0; 3];
+    }
+    let l = to / d.max(1e-3);
+    let k = f * wrap(n.dot(l));
+    rgb.map(|c| c * k)
+}
+
+/// How much a light matters to the camera: its brightest channel against its distance, as
+/// `peak × r²/(d² + r²)`, so a bright light far off can outrank a dim one nearby.
+pub fn score(peak: f32, radius: f32, distance: f32) -> f32 {
+    let r2 = radius * radius;
+    peak * r2 / (distance * distance + r2).max(1e-6)
+}
+
+/// The look's light for an authored point light at night (`night` from [`night_weight`]): its
+/// hue, at a strength set by its authored peak, out to [`tune::TORCH_RADIUS`]; a flame flickers.
+/// A light authored with a reach of [`tune::GLOW_MAX_RANGE`] or less is Basin Battle's glowing
+/// object, a small glow and not a torch. `None` for a light too dim to cast a pool.
+pub fn torch_light(pl: &WorldPointLight) -> Option<LookLight> {
+    // `intensity` is `4π ×` the authored scale (the `PointLight` convention).
+    let s = pl.intensity / (4.0 * std::f32::consts::PI);
+    let rgb = pl.color.map(|c| (c * s).max(0.0));
+    let peak = rgb[0].max(rgb[1]).max(rgb[2]);
+    if peak < tune::TORCH_PEAK_CUTOFF {
+        return None;
+    }
+    let hue = rgb.map(|c| c / peak);
+    let strength = (peak / tune::TORCH_REF_PEAK).clamp(tune::TORCH_PEAK_MIN, tune::TORCH_PEAK_MAX);
+    let (base, radius) = if pl.range <= tune::GLOW_MAX_RANGE {
+        (tune::GLOW_INTENSITY, pl.range * tune::GLOW_RANGE_SCALE)
+    } else {
+        (tune::TORCH_INTENSITY, tune::TORCH_RADIUS)
+    };
+    let light = LookLight::new(hue, base * strength, radius);
+    Some(if rgb[0] >= tune::FLAME_RED_OVER_BLUE * rgb[2] {
+        light.flickering(tune::FLAME_FLICKER, tune::FLAME_FLICKER_HZ)
+    } else {
+        light
+    })
+}
+
+/// One candidate for this frame's table.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct LookCandidate {
+    /// The entity it comes from: the ranking's identity across frames.
+    pub key: Entity,
+    pub pos: Vec3,
+    pub radius: f32,
+    /// The colour times every gain (intensity, pulse, flicker, hour, scale).
+    pub rgb: [f32; 3],
+    pub score: f32,
+    /// Seen for the first time this frame with its own rise ([`LookPulse`]): it comes in at full
+    /// fade, since its pulse already shapes the start.
+    pub fresh: bool,
+}
+
+/// One table slot: a light lit or fading, and where it last was.
+#[derive(Clone, Copy, Debug, PartialEq)]
+struct Slot {
+    key: Entity,
+    pos: Vec3,
+    radius: f32,
+    rgb: [f32; 3],
+    fade: f32,
+}
+
+/// The ranking's state across frames: which lights hold a slot and how far each has faded, plus
+/// the candidate list, kept to reuse its allocation.
+#[derive(Resource, Default)]
+pub struct LookLightSlots {
+    slots: [Option<Slot>; MAX_LOOK_LIGHTS],
+    /// The frame's candidates, cleared and refilled each frame (no allocation once warm).
+    pub(crate) scratch: Vec<LookCandidate>,
+}
+
+impl LookLightSlots {
+    /// Empty every slot: the classic look, or a switch back to it.
+    pub fn clear(&mut self) {
+        self.slots = [None; MAX_LOOK_LIGHTS];
+        self.scratch.clear();
+    }
+
+    /// One frame of `dt` seconds over `cands` (reordered in place): the [`ACTIVE_LOOK_LIGHTS`]
+    /// best by score are lit, a slot's light fades toward 1 while it's among them and toward 0
+    /// otherwise (faster once its entity has gone), and a newcomer takes a free slot, fading in
+    /// (or at once when `fresh`). A light with no free slot waits for one.
+    pub fn step(&mut self, cands: &mut [LookCandidate], dt: f32) {
+        let k = cands.len().min(ACTIVE_LOOK_LIGHTS);
+        let by_score = |a: &LookCandidate, b: &LookCandidate| {
+            b.score
+                .total_cmp(&a.score)
+                .then_with(|| a.key.to_bits().cmp(&b.key.to_bits()))
+        };
+        if cands.len() > k {
+            cands.select_nth_unstable_by(k, by_score);
+        }
+        let (active, rest) = cands.split_at(k);
+        let dt = dt.max(0.0);
+        for slot in self.slots.iter_mut() {
+            let Some(s) = slot.as_mut() else { continue };
+            let lit = active.iter().find(|c| c.key == s.key);
+            let ranked_out = lit.is_none().then(|| rest.iter().find(|c| c.key == s.key));
+            let (target, secs) = match (lit, ranked_out.flatten()) {
+                (Some(c), _) => {
+                    (s.pos, s.radius, s.rgb) = (c.pos, c.radius, c.rgb);
+                    (1.0, tune::FADE_IN_SECS)
+                }
+                (None, Some(c)) => {
+                    (s.pos, s.radius, s.rgb) = (c.pos, c.radius, c.rgb);
+                    (0.0, tune::FADE_OUT_SECS)
+                }
+                (None, None) => (0.0, tune::GONE_FADE_SECS),
+            };
+            let step = dt / secs;
+            s.fade = if s.fade < target {
+                (s.fade + step).min(target)
+            } else {
+                (s.fade - step).max(target)
+            };
+            if target == 0.0 && s.fade <= 0.0 {
+                *slot = None;
+            }
+        }
+        for c in active {
+            if self.slots.iter().flatten().any(|s| s.key == c.key) {
+                continue;
+            }
+            let Some(free) = self.slots.iter_mut().find(|s| s.is_none()) else {
+                break;
+            };
+            let fade = if c.fresh {
+                1.0
+            } else {
+                (dt / tune::FADE_IN_SECS).min(1.0)
+            };
+            *free = Some(Slot {
+                key: c.key,
+                pos: c.pos,
+                radius: c.radius,
+                rgb: c.rgb,
+                fade,
+            });
+        }
+    }
+
+    /// Writes the lit and fading slots into `rows` (two a light, the colour times its fade) and
+    /// returns how many; rows past the count keep stale values, which the count guards.
+    pub fn pack(&self, rows: &mut [[f32; 4]; LOOK_LIGHT_ROWS]) -> usize {
+        let mut n = 0;
+        for s in self.slots.iter().flatten() {
+            if s.fade <= 0.0 {
+                continue;
+            }
+            rows[2 * n] = [s.pos.x, s.pos.y, s.pos.z, s.radius];
+            rows[2 * n + 1] = [s.rgb[0] * s.fade, s.rgb[1] * s.fade, s.rgb[2] * s.fade, 0.0];
+            n += 1;
+        }
+        n
+    }
+
+    /// How far the light from `key` has faded in, `None` without a slot (for tests and the
+    /// debug dump).
+    pub fn fade_of(&self, key: Entity) -> Option<f32> {
+        self.slots
+            .iter()
+            .flatten()
+            .find(|s| s.key == key)
+            .map(|s| s.fade)
+    }
+}
+
+/// A spell light as the ranking reads it: its entity, the light (whether it is new this frame),
+/// its own transform and its pulse.
+type LookLightItem = (
+    Entity,
+    Ref<'static, LookLight>,
+    Option<&'static GlobalTransform>,
+    Option<&'static LookPulse>,
+);
+
+/// What the light packer reads to rank and pack the look's lights, as one system parameter.
+#[derive(SystemParam)]
+pub(crate) struct LookLightInputs<'w, 's> {
+    look: Res<'w, WorldLook>,
+    tune: Res<'w, LookLightTune>,
+    clock: Res<'w, GameClock>,
+    indoors: Res<'w, WmoCrossfade>,
+    slots: ResMut<'w, LookLightSlots>,
+    lights: Query<'w, 's, LookLightItem>,
+    anchors: Query<'w, 's, &'static GlobalTransform>,
+}
+
+impl LookLightInputs<'_, '_> {
+    /// One frame: ranks `torches` (each authored light, admitted by its rooms, at its world
+    /// position, and whether it is a building's interior light) and the [`LookLight`]s around
+    /// `cam`, steps the fades and packs the table into
+    /// `rows`, returning its count. Under the classic look the table is empty.
+    pub(crate) fn pack<'a>(
+        &mut self,
+        cam: Vec3,
+        now: f32,
+        dt: f32,
+        torches: impl Iterator<Item = (Entity, &'a WorldPointLight, Vec3, bool)>,
+        rows: &mut [[f32; 4]; LOOK_LIGHT_ROWS],
+    ) -> usize {
+        if !self.look.on {
+            if self.slots.slots.iter().any(Option::is_some) {
+                self.slots.clear();
+            }
+            return 0;
+        }
+        let scale = self.tune.scale.max(0.0);
+        let hour =
+            night_weight(self.clock.minute as f32).max(tune::INDOOR_FLOOR * self.indoors.t());
+        let slots = &mut *self.slots;
+        let mut cands = std::mem::take(&mut slots.scratch);
+        cands.clear();
+        // Outdoors (the interior crossfade at 0), a building's own lights rank lower.
+        let interior_rank = tune::INTERIOR_RANK_OUTSIDE
+            + (1.0 - tune::INTERIOR_RANK_OUTSIDE) * self.indoors.t().clamp(0.0, 1.0);
+        let mut push =
+            |key: Entity, pos: Vec3, light: &LookLight, gain: f32, fresh: bool, rank: f32| {
+                let d = pos.distance(cam);
+                if d > tune::REACH + light.radius || gain <= 0.0 {
+                    return;
+                }
+                let g = light.intensity
+                    * gain
+                    * flicker(light.flicker, light.flicker_hz, now, seed_of(key))
+                    * scale;
+                let rgb = light.color.map(|c| (c * g).max(0.0));
+                let peak = rgb[0].max(rgb[1]).max(rgb[2]);
+                if peak <= 0.0 {
+                    return;
+                }
+                cands.push(LookCandidate {
+                    key,
+                    pos,
+                    radius: light.radius,
+                    rgb,
+                    score: score(peak, light.radius, d) * rank,
+                    fresh,
+                });
+            };
+        for (key, pl, pos, interior) in torches {
+            if let Some(light) = torch_light(pl) {
+                let rank = if interior { interior_rank } else { 1.0 };
+                push(key, pos, &light, hour, false, rank);
+            }
+        }
+        for (key, light, own, pulse) in &self.lights {
+            let base = match light.anchor {
+                Some(a) => match self.anchors.get(a) {
+                    Ok(gt) => gt.translation(),
+                    Err(_) => continue, // its unit is gone; its owner despawns it
+                },
+                None => match own {
+                    Some(gt) => gt.translation(),
+                    None => continue,
+                },
+            };
+            let gain = pulse.map_or(1.0, |p| p.gain(now));
+            push(
+                key,
+                base + light.offset,
+                &light,
+                gain,
+                light.is_added() && pulse.is_some(),
+                1.0,
+            );
+        }
+        slots.step(&mut cands, dt);
+        let n = slots.pack(rows);
+        slots.scratch = cands;
+        n
+    }
+}
+
+/// The look's light resources, for the light packer.
+pub(crate) fn init_resources(app: &mut App) {
+    app.init_resource::<LookLightTune>()
+        .init_resource::<LookLightSlots>();
+}
