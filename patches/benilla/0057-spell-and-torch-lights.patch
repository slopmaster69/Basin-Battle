+    /// Full at the light, smooth to nothing at the radius and none past it, never rising.
+    #[test]
+    fn the_falloff_is_smooth_to_zero_at_the_radius() {
+        assert_eq!(falloff(0.0, 9.0), 1.0);
+        assert_eq!(falloff(9.0, 9.0), 0.0);
+        assert_eq!(falloff(12.0, 9.0), 0.0);
+        assert_eq!(
+            falloff(1.0, 0.0),
+            0.0,
+            "a light of no radius lights nothing"
+        );
+        let mut last = 1.0;
+        for i in 1..=90 {
+            let f = falloff(i as f32 * 0.1, 9.0);
+            assert!(f <= last, "falls monotonically");
+            last = f;
+        }
+        // Smooth at the edge: the slope there is zero, so no ring shows where the pool ends.
+        let edge = (falloff(8.99, 9.0) - falloff(8.98, 9.0)).abs();
+        assert!(edge < 1e-4, "flat at the radius: {edge}");
+        // A torch's readable pool: over half at 3 yd, a fifth at 6, nearly gone at 8.
+        assert!(falloff(3.0, 9.0) > 0.75);
+        assert!((falloff(6.0, 9.0) - 0.309).abs() < 0.01);
+        assert!(falloff(8.0, 9.0) < 0.05);
+    }
+
+    /// The wrap: full facing the light, a third side-on, and none only past 120°.
+    #[test]
+    fn the_wrap_is_soft() {
+        assert_eq!(wrap(1.0), 1.0);
+        assert!((wrap(0.0) - 1.0 / 3.0).abs() < 1e-6);
+        assert_eq!(wrap(-0.5), 0.0);
+        assert_eq!(wrap(-1.0), 0.0);
+        // The full term: a floor under a light 2 yd up, and the same floor past its radius.
+        let lit = light_at(
+            Vec3::ZERO,
+            Vec3::Y,
+            Vec3::new(0.0, 2.0, 0.0),
+            9.0,
+            [1.0, 0.5, 0.2],
+        );
+        let k = falloff(2.0, 9.0);
+        assert!((lit[0] - k).abs() < 1e-5 && (lit[1] - 0.5 * k).abs() < 1e-5);
+        let dark = light_at(
+            Vec3::ZERO,
+            Vec3::Y,
+            Vec3::new(0.0, 10.0, 0.0),
+            9.0,
+            [1.0; 3],
+        );
+        assert_eq!(dark, [0.0; 3]);
+    }
+
+    /// Brightness against distance: nearer wins at equal brightness, brighter at equal distance,
