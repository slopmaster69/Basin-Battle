+    /// A light fades in as it enters the set and out as it leaves it, never jumping, and one
+    /// whose entity went fades out quickly from where it was.
+    #[test]
+    fn a_light_fades_in_and_out_of_the_set_without_popping() {
+        let mut slots = LookLightSlots::default();
+        let dt = 0.1;
+        let mut rows = [[0.0; 4]; LOOK_LIGHT_ROWS];
+        // A fresh table: 16 strong lights and one weak one (index 99), which waits.
+        let strong: Vec<LookCandidate> = (0..16).map(|i| cand(i, 10.0)).collect();
+        let mut cands = strong.clone();
+        cands.push(cand(99, 1.0));
+        slots.step(&mut cands, dt);
+        assert_eq!(slots.fade_of(key(99)), None);
+        let first = slots.fade_of(key(0)).unwrap();
+        assert!(
+            (first - dt / tune::FADE_IN_SECS).abs() < 1e-6,
