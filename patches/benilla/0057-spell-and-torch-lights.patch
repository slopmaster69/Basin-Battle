+            .find(|i| rows[2 * i][0] == 0.0 && rows[2 * i][3] == 8.0)
+            .expect("light 0 packed");
+        assert!(
+            (rows[2 * row + 1][0] - 0.5).abs() < 1e-6,
+            "its red, at half fade"
+        );
+        // Light 0's entity goes: it fades out at the quicker gone rate, then frees its slot.
+        let mut c: Vec<LookCandidate> = (1..16).map(|i| cand(i, 10.0)).collect();
+        c.push(cand(99, 5.0));
