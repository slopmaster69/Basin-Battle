+                .resource_mut::<super::super::GameClock>()
+                .minute = minute;
+            app.world_mut()
+                .spawn((crate::view::WorldCamera, GlobalTransform::IDENTITY));
+            app.world_mut().spawn((
+                crate::terrain_stream::point_light([0.466_666_7, 0.290_196_1, 0.133_333_34], 3.0),
+                GlobalTransform::from_translation(Vec3::new(0.0, 1.5, 0.0)),
+            ));
+            // A frame's step, which the fades move by.
+            app.world_mut()
+                .resource_mut::<Time>()
+                .advance_by(std::time::Duration::from_secs_f32(0.1));
+            app
+        };
+        let mut classic = run(crate::look::WorldLook::CLASSIC, 0);
+        classic.update();
+        let mut new = run(crate::look::WorldLook::NEW, 0);
+        new.update();
+        let c = classic.world().resource::<WowLightData>().0;
+        let n = new.world().resource::<WowLightData>().0;
+        assert_eq!(c.points, n.points, "the reference's table is untouched");
+        assert_eq!(n.rows[20][1], 1.0, "one look light");
+        assert_eq!(n.look[0], [0.0, 1.5, 0.0, tune::TORCH_RADIUS]);
+        // Fading in from its first frame; its colour is the torch's hue, warm.
+        let rgb = n.look[1];
+        assert!(
+            rgb[0] > 0.0 && rgb[0] > rgb[1] && rgb[1] > rgb[2],
+            "{rgb:?}"
+        );
+
+        // Noon: the same torch packs a twentieth or so of midnight's.
+        let mut noon = run(crate::look::WorldLook::NEW, 720);
+        noon.update();
+        let day = noon.world().resource::<WowLightData>().0.look[1][0];
+        let ratio = day / rgb[0];
+        assert!(ratio < 0.1, "noon {day} against midnight {}", rgb[0]);
+
+        // A flash on a unit 20 yd off, fresh: full at once, at its anchor's height.
+        let unit = new
+            .world_mut()
+            .spawn(GlobalTransform::from_translation(Vec3::new(20.0, 0.0, 0.0)))
+            .id();
+        let now = new.world().resource::<Time>().elapsed_secs();
+        new.world_mut().spawn((
+            LookLight::new([1.0, 0.55, 0.2], 1.0, 10.0).on(unit, Vec3::Y),
+            LookPulse::flash(now - 0.1, 0.0, 1.0, 0.5),
+        ));
+        new.update();
+        let n = new.world().resource::<WowLightData>().0;
+        assert_eq!(n.rows[20][1], 2.0);
+        let flash = (0..2)
+            .find(|i| n.look[2 * i][0] == 20.0)
+            .expect("the flash is packed");
+        assert_eq!(n.look[2 * flash], [20.0, 1.0, 0.0, 10.0]);
+        assert_eq!(n.look[2 * flash + 1], [1.0, 0.55, 0.2, 0.0]);
+        // Its unit gone, it fades out quickly and leaves the table.
+        new.world_mut().entity_mut(unit).despawn();
+        new.update();
+        new.world_mut()
+            .resource_mut::<Time>()
+            .advance_by(std::time::Duration::from_secs_f32(0.5));
+        new.update();
+        assert_eq!(new.world().resource::<WowLightData>().0.rows[20][1], 1.0);
+        // Back to the classic look: the table empties at once.
+        *new.world_mut().resource_mut::<crate::look::WorldLook>() = crate::look::WorldLook::CLASSIC;
+        new.update();
+        assert_eq!(new.world().resource::<WowLightData>().0.rows[20][1], 0.0);
     }
 
