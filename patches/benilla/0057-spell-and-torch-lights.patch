+        // Light 0 drops below 99: it fades out over FADE_OUT_SECS while 99 fades in beside it.
+        let mut c: Vec<LookCandidate> = (1..16).map(|i| cand(i, 10.0)).collect();
+        c.push(cand(0, 0.5));
+        c.push(cand(99, 5.0));
+        slots.step(&mut c, dt);
+        let out = slots.fade_of(key(0)).unwrap();
