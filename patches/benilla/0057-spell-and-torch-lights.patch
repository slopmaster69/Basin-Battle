+        let mut lo: f32 = 2.0;
+        let mut hi: f32 = 0.0;
+        for i in 0..2000 {
+            let t = i as f32 * 0.01;
+            let f = flicker(0.08, 1.1, t, 1.0);
+            lo = lo.min(f);
+            hi = hi.max(f);
+            assert_ne!(f, flicker(0.08, 1.1, t, 4.0), "another seed, another phase");
+        }
+        assert!(lo >= 0.92 - 1e-6 && hi <= 1.08 + 1e-6, "{lo}..{hi}");
+        assert!(hi - lo > 0.08, "it does move: {lo}..{hi}");
+        assert_eq!(flicker(0.0, 1.1, 3.0, 1.0), 1.0, "a steady light");
+    }
+
+    /// The stock torch is a warm, flickering pool of the tuned strength; a white glow is steady
+    /// and short; a dark light casts none.
+    #[test]
+    fn an_authored_light_becomes_a_pool() {
+        let torch =
+            crate::terrain_stream::point_light([0.466_666_7, 0.290_196_1, 0.133_333_34], 3.0);
+        let l = torch_light(&torch).expect("the torch casts a pool");
+        assert!((l.intensity - tune::TORCH_INTENSITY).abs() < 1e-4);
+        assert_eq!(l.color[0], 1.0);
+        assert!(l.color[2] < 0.3, "warm: {:?}", l.color);
+        assert_eq!(l.radius, tune::TORCH_RADIUS);
+        assert_eq!(l.flicker, tune::FLAME_FLICKER);
+        let glow = WorldPointLight {
+            range: 4.0,
+            ..crate::terrain_stream::point_light([1.0; 3], 1.0)
+        };
+        let g = torch_light(&glow).expect("a glowing object's light");
+        assert_eq!(g.flicker, 0.0, "white burns steady");
+        assert_eq!(g.radius, 6.0, "a planted arrow's glow stays small");
+        assert!(g.intensity <= tune::GLOW_INTENSITY * tune::TORCH_PEAK_MAX);
+        // A lamp post's or a lantern's light, however short or long its authored reach past a
+        // glow's, casts a full torch's pool.
+        for range in [8.0, 12.0, 48.0] {
+            let lamp = WorldPointLight {
+                range,
+                ..crate::terrain_stream::point_light([1.0, 0.8, 0.5], 1.0)
+            };
+            let l = torch_light(&lamp).unwrap();
+            assert_eq!(l.radius, tune::TORCH_RADIUS, "reach {range}");
+            assert!(l.intensity >= tune::TORCH_INTENSITY * tune::TORCH_PEAK_MIN);
+        }
+        let dark = crate::terrain_stream::point_light([0.01; 3], 1.0);
+        assert!(torch_light(&dark).is_none());
+    }
+
+    /// `looklights`: a scale from 0 to 10, nothing or `tuned` for 1, anything else refused.
+    #[test]
+    fn the_console_scale_parses() {
+        assert_eq!(
+            LookLightTune::parse("1.5"),
+            Some(LookLightTune { scale: 1.5 })
+        );
+        assert_eq!(
+            LookLightTune::parse(" 0 "),
+            Some(LookLightTune { scale: 0.0 })
+        );
+        assert_eq!(
+            LookLightTune::parse("4"),
+            Some(LookLightTune { scale: 4.0 })
+        );
+        assert_eq!(LookLightTune::parse(""), Some(LookLightTune::default()));
+        assert_eq!(
+            LookLightTune::parse("Tuned"),
+            Some(LookLightTune::default())
+        );
+        assert_eq!(
+            LookLightTune::parse("10"),
+            Some(LookLightTune { scale: 10.0 })
+        );
+        assert_eq!(LookLightTune::parse("10.5"), None);
+        assert_eq!(LookLightTune::parse("-1"), None);
+        assert_eq!(LookLightTune::parse("bright"), None);
+        assert_eq!(LookLightTune::parse("nan"), None);
+    }
+
+    /// A spell light's hue is at full peak whatever its trail's brightness; a cool light leans
+    /// toward white and burns brighter, a warm one is as it is.
+    #[test]
+    fn a_cool_spell_light_is_lifted() {
+        let (fire, g) = spell_light_hue(school_color(2).unwrap());
+        assert_eq!((fire, g), (school_color(2).unwrap(), 1.0));
+        let (dim, g) = spell_light_hue([0.5, 0.2, 0.1]);
+        assert_eq!((dim, g), ([1.0, 0.4, 0.2], 1.0));
+        let (frost, g) = spell_light_hue(school_color(4).unwrap());
+        assert_eq!(g, tune::COOL_GAIN);
+        assert_eq!(frost[2], 1.0);
+        assert!(
+            frost[0] > 0.45 && frost[1] > 0.7 && frost[0] < frost[1],
+            "{frost:?}"
+        );
+        assert_eq!(spell_light_hue([0.0; 3]), ([0.0; 3], 1.0));
+        // A light on a dark texel takes the floor; a bright one is its own.
+        assert_eq!(lit_albedo([0.02, 0.3, 0.9]), [tune::ALBEDO_FLOOR, 0.3, 0.9]);
+    }
+
+    /// Outdoors a building's interior light ranks below a street lamp of the same brightness
+    /// further off, so the street's lamps take the slots.
+    #[test]
+    fn an_interior_light_ranks_lower_outdoors() {
+        let mut app = App::new();
+        app.insert_resource(WorldLook::NEW)
+            .init_resource::<GameClock>()
+            .init_resource::<WmoCrossfade>();
+        init_resources(&mut app);
+        let lamp =
+            crate::terrain_stream::point_light([0.466_666_7, 0.290_196_1, 0.133_333_34], 3.0);
+        let keys: Vec<Entity> = (0..2).map(|_| app.world_mut().spawn_empty().id()).collect();
+        let mut state = bevy::ecs::system::SystemState::<LookLightInputs>::new(app.world_mut());
+        let mut inputs = state.get_mut(app.world_mut());
+        let mut rows = [[0.0; 4]; LOOK_LIGHT_ROWS];
+        // The candle 8 yd off inside, the lamp 12 yd off outside.
+        let torches = [
+            (keys[0], &lamp, Vec3::new(8.0, 0.0, 0.0), true),
+            (keys[1], &lamp, Vec3::new(-12.0, 0.0, 0.0), false),
+        ];
+        inputs.pack(Vec3::ZERO, 0.0, 0.1, torches.into_iter(), &mut rows);
+        let cands = &inputs.slots.scratch;
+        let score_of = |k| cands.iter().find(|c| c.key == k).unwrap().score;
+        assert!(score_of(keys[1]) > score_of(keys[0]));
+    }
+
+    /// The school colours: fire flickers, physical casts no light.
+    #[test]
+    fn every_magic_school_has_a_colour() {
+        for school in 1..=6 {
+            assert!(school_color(school).is_some(), "school {school}");
+        }
+        assert!(school_color(0).is_none());
+        assert!(school_color(7).is_none());
+        assert!(school_flickers(2) && !school_flickers(4));
+    }
+}
