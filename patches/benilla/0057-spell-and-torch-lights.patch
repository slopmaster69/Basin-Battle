+            (out - (1.0 - dt / tune::FADE_OUT_SECS)).abs() < 1e-6,
+            "fading out: {out}"
+        );
+        assert!(
+            slots.fade_of(key(99)).unwrap() > 0.0,
+            "the newcomer took a spare slot"
+        );
+        assert_eq!(slots.pack(&mut rows), 17, "both in the table while 0 fades");
+        // Its colour rides the fade.
+        let mut c: Vec<LookCandidate> = (1..16).map(|i| cand(i, 10.0)).collect();
+        c.push(cand(0, 0.5));
