+//! The new look's light from spells, benilla's own (no reference behaviour): the game hangs a
+//! [`LookLight`] on what a spell shows, and `benilla_world::look::lights` ranks and packs them with
+//! the torches for the per-pixel pass. Only under the new look (`worldLook 1`); the classic look
+//! hangs none.
+//!
+//! - A missile in flight (Fireball, Frostbolt, Shadow Bolt) carries a light of its spell's colour,
+//!   so it lights the ground under its path; an arrow carries one only when Basin Battle's missile
+//!   look gives it a glowing trail, in the trail's colour.
+//! - An impact flashes a brighter, shorter light on the unit hit or at the point it burst: a
+//!   missile's arrival, or a spell with no missile landing on each unit it hit (the first
+//!   [`tune::MAX_FLASHES_PER_CAST`]). A heal (Holy Light, Flash Heal) glows softer and longer on
+//!   the hero instead.
+//! - A cast being drawn up (the precast kit, a channel) glows on the caster until the cast ends,
+//!   and an aura with a visual of its own breathes faintly on its unit until it goes.
+//! - A ground area (a DynamicObject: Flamestrike, Consecration, Blizzard) glows over its circle
+//!   while it lasts.
+//!
+//! A spell's colour is its trail's, if it has one, else its school's ([`school_color`]); a
+//! physical spell with no trail casts no light. Every number is in [`tune`].
+
+use bevy::ecs::system::SystemParam;
+use bevy::prelude::*;
+
+use benilla_formats::SpellDisplay;
+use benilla_protocol::EntityKind;
+use benilla_ui::action_combat;
+use benilla_world::look::lights::{school_color, school_flickers, spell_light_hue, tune};
+use benilla_world::look::{LookLight, LookPulse, WorldLook};
+
+use crate::creature_anim::{CastEvent, CastEventKind, FxClass, SpellGoTargets, SpellKitFx};
+use crate::entities::{Missile, MissileSpell};
+use crate::net::{NetEntity, ObjectStore};
+
+/// `SPELL_EFFECT_HEAL`, the effect that makes a landing a heal's glow rather than a flash.
+const EFFECT_HEAL: u32 = 10;
+
+/// A missile or DynamicObject already given its light (or found to have none).
+#[derive(Component)]
+struct SpellLit;
+
+/// A light entity of this module's own, which it despawns when its pulse ends or its unit goes.
+#[derive(Component)]
+struct SpellLightEntity;
+
+/// A cast's or an aura's glow on a unit, until the kit's reap: `(unit, spell, class)` is the key
+/// `SpellKitFx` reaps by.
+#[derive(Component, Clone, Copy, PartialEq, Debug)]
+struct KitGlow {
+    owner: Entity,
+    spell: u32,
+    class: FxClass,
+}
+
+/// A spell's light colour, its strength's share and whether it flickers: Basin Battle's trail
+/// colour first (a physical spell lit only by it at [`tune::TRAIL_ONLY_SCALE`]), else its school's.
+fn spell_hue(
+    display: Option<&SpellDisplay>,
+    trail: Option<[f32; 3]>,
+) -> Option<([f32; 3], f32, bool)> {
+    let school = display.map_or(0, |d| d.school);
+    let flame = school_flickers(school);
+    let (rgb, share, flame) = match (trail, school_color(school)) {
+        (Some(rgb), Some(_)) => (rgb, 1.0, flame),
+        (Some(rgb), None) => (rgb, tune::TRAIL_ONLY_SCALE, false),
+        (None, Some(rgb)) => (rgb, 1.0, flame),
+        (None, None) => return None,
+    };
+    // At full peak, and a cool light lifted to show on warm ground.
+    let (rgb, gain) = spell_light_hue(rgb);
+    Some((rgb, share * gain, flame))
+}
+
+/// The glowing trail Basin Battle's missile look gives a spell, if any.
+fn trail_of(spell: u32) -> Option<[f32; 3]> {
+    action_combat::missile_look(spell)
+        .filter(|l| l.width > 0.0 && l.secs > 0.0)
+        .and_then(|l| l.trail)
+}
+
+/// Whether a spell heals (an effect is `SPELL_EFFECT_HEAL`).
+fn is_heal(display: Option<&SpellDisplay>) -> bool {
+    display.is_some_and(|d| d.effects.contains(&EFFECT_HEAL))
+}
+
+/// A missile's light, carried on the missile itself.
+fn missile_light(display: Option<&SpellDisplay>, trail: Option<[f32; 3]>) -> Option<LookLight> {
+    let (rgb, share, flame) = spell_hue(display, trail)?;
+    let light = LookLight::new(rgb, tune::MISSILE_INTENSITY * share, tune::MISSILE_RADIUS);
+    Some(if flame {
+        light.flickering(tune::MISSILE_FLICKER, tune::MISSILE_FLICKER_HZ)
+    } else {
+        light
+    })
+}
+
+/// A landing's light and its pulse, born `now`: a heal's soft glow, or an impact's flash.
+fn landing_light(
+    display: Option<&SpellDisplay>,
+    trail: Option<[f32; 3]>,
+    now: f32,
+) -> Option<(LookLight, LookPulse)> {
+    let (rgb, share, _) = spell_hue(display, trail)?;
+    Some(if is_heal(display) {
+        (
+            LookLight::new(rgb, tune::HEAL_INTENSITY * share, tune::HEAL_RADIUS),
+            LookPulse::flash(now, tune::HEAL_RISE, tune::HEAL_HOLD, tune::HEAL_FALL),
+        )
+    } else {
+        (
+            LookLight::new(rgb, tune::IMPACT_INTENSITY * share, tune::IMPACT_RADIUS),
+            LookPulse::flash(now, tune::IMPACT_RISE, tune::IMPACT_HOLD, tune::IMPACT_FALL),
+        )
+    })
+}
+
+/// A cast's glow (`FxClass::Hold`) or an aura's (`FxClass::AuraState`) on `owner`, born `now`.
+fn kit_glow(
+    display: Option<&SpellDisplay>,
+    class: FxClass,
+    owner: Entity,
+    now: f32,
+) -> Option<(LookLight, LookPulse)> {
+    let (rgb, share, flame) = spell_hue(display, None)?;
+    let at = Vec3::Y * tune::UNIT_HEIGHT;
+    Some(match class {
+        FxClass::Hold => {
+            let light = LookLight::new(rgb, tune::CAST_INTENSITY * share, tune::CAST_RADIUS);
+            let light = if flame {
+                light.flickering(tune::MISSILE_FLICKER, tune::MISSILE_FLICKER_HZ)
+            } else {
+                light
+            };
+            (
+                light.on(owner, at),
+                LookPulse::flash(now, tune::CAST_RISE, tune::CAST_MAX_SECS, tune::CAST_FALL),
+            )
+        }
+        FxClass::AuraState => (
+            LookLight::new(rgb, tune::AURA_INTENSITY * share, tune::AURA_RADIUS)
+                .flickering(tune::AURA_BREATH, tune::AURA_BREATH_HZ)
+                .on(owner, at),
+            LookPulse::held(now, tune::AURA_RISE),
+        ),
+    })
+}
+
+/// A ground area's glow over its circle of `radius` yards, riding its DynamicObject.
+fn area_glow(display: Option<&SpellDisplay>, radius: f32, area: Entity) -> Option<LookLight> {
+    let (rgb, share, flame) = spell_hue(display, None)?;
+    let reach = (radius + tune::AREA_PAD).clamp(tune::AREA_MIN_RADIUS, tune::AREA_MAX_RADIUS);
+    let light = LookLight::new(rgb, tune::AREA_INTENSITY * share, reach)
+        .on(area, Vec3::Y * tune::AREA_HEIGHT);
+    Some(if flame {
+        light.flickering(tune::FLAME_FLICKER, tune::FLAME_FLICKER_HZ)
+    } else {
+        light
+    })
+}
+
+/// A missile not yet given its light.
+type UnlitMissiles = (With<Missile>, Without<SpellLit>);
+
+/// What [`hang_spell_lights`] reads, as one system parameter.
+#[derive(SystemParam)]
+struct SpellLightInputs<'w, 's> {
+    look: Res<'w, WorldLook>,
+    time: Res<'w, Time>,
+    spells: Option<Res<'w, crate::ui_action::Spells>>,
+    casts: MessageReader<'w, 's, CastEvent>,
+    gos: MessageReader<'w, 's, SpellGoTargets>,
+    kits: MessageReader<'w, 's, SpellKitFx>,
+    missiles: Query<'w, 's, (Entity, &'static MissileSpell), UnlitMissiles>,
+    areas: Query<'w, 's, (Entity, &'static NetEntity, &'static ObjectStore), Added<ObjectStore>>,
+    glows: Query<'w, 's, (Entity, &'static KitGlow)>,
+}
+
+/// Hangs this frame's spell lights: on new missiles and ground areas, on each impact and landing,
+/// and on each cast and aura kit, and takes a kit's glow away at its reap.
+fn hang_spell_lights(
+    mut commands: Commands,
+    mut i: SpellLightInputs,
+    // This run's new kit glows, so a second `Begin` in the same frame adds no second one and a
+    // `Reap` in the same frame still finds it.
+    mut fresh: Local<Vec<(KitGlow, Entity)>>,
+) {
+    if !i.look.on {
+        i.casts.clear();
+        i.gos.clear();
+        i.kits.clear();
+        return;
+    }
+    let now = i.time.elapsed_secs();
+    let spells = i.spells.as_deref();
+    let display = |spell: u32| spells.and_then(|s| s.catalog.get(spell));
+    let flash = |commands: &mut Commands, spell: u32, at: Result<Entity, Vec3>| {
+        let Some((light, pulse)) = landing_light(display(spell), trail_of(spell), now) else {
+            return;
+        };
+        match at {
+            Ok(unit) => {
+                commands.spawn((
+                    light.on(unit, Vec3::Y * tune::UNIT_HEIGHT),
+                    pulse,
+                    SpellLightEntity,
+                ));
+            }
+            Err(pos) => {
+                let pos = pos + Vec3::Y * tune::GROUND_HEIGHT;
+                commands.spawn((
+                    light,
+                    pulse,
+                    SpellLightEntity,
+                    Transform::from_translation(pos),
+                    GlobalTransform::from_translation(pos),
+                ));
+            }
+        }
+    };
+    for (entity, spell) in &i.missiles {
+        let mut e = commands.entity(entity);
+        if let Some(light) = missile_light(display(spell.spell), trail_of(spell.spell)) {
+            e.try_insert(light);
+        }
+        e.try_insert(SpellLit);
+    }
+    for ev in i.casts.read() {
+        match ev.kind {
+            CastEventKind::Impact { .. } => flash(&mut commands, ev.spell_id, Ok(ev.entity)),
+            CastEventKind::GroundImpact { pos } => flash(&mut commands, ev.spell_id, Err(pos)),
+            _ => {}
+        }
+    }
+    for go in i.gos.read() {
+        // A missile's landing is its arrival's (above); a spell with none lands now.
+        if display(go.spell_id).is_none_or(|d| d.speed > 0.0) {
+            continue;
+        }
+        for &unit in go.hits.iter().take(tune::MAX_FLASHES_PER_CAST) {
+            flash(&mut commands, go.spell_id, Ok(unit));
+        }
+        if let (Some(dest), false) = (go.dest, is_heal(display(go.spell_id))) {
+            flash(&mut commands, go.spell_id, Err(dest));
+        }
+    }
+    fresh.clear();
+    for kit in i.kits.read() {
+        match *kit {
+            SpellKitFx::Begin {
+                entity,
+                spell_id,
+                persistent: true,
+                class,
+                ref effects,
+                ..
+            } if !effects.is_empty() => {
+                let key = KitGlow {
+                    owner: entity,
+                    spell: spell_id,
+                    class,
+                };
+                if fresh.iter().any(|(g, _)| *g == key) || i.glows.iter().any(|(_, g)| *g == key) {
+                    continue;
+                }
+                if let Some((light, pulse)) = kit_glow(display(spell_id), class, entity, now) {
+                    let glow = commands.spawn((light, pulse, key, SpellLightEntity)).id();
+                    fresh.push((key, glow));
+                }
+            }
+            SpellKitFx::Reap {
+                entity,
+                spell_id,
+                class,
+                ..
+            } => {
+                for (glow, g) in &i.glows {
+                    if g.owner == entity && g.spell == spell_id && g.class == class {
+                        commands.entity(glow).try_despawn();
+                    }
+                }
+                fresh.retain(|(g, glow)| {
+                    let reaped = g.owner == entity && g.spell == spell_id && g.class == class;
+                    if reaped {
+                        commands.entity(*glow).try_despawn();
+                    }
+                    !reaped
+                });
+            }
+            _ => {}
+        }
+    }
+    for (area, net, store) in &i.areas {
+        if net.kind != EntityKind::DynamicObject {
+            continue;
+        }
+        commands.entity(area).try_insert(SpellLit);
+        let Some(spell) = store.0.dynamicobject_spell_id() else {
+            continue;
+        };
+        let radius = store.0.dynamicobject_radius().unwrap_or(0.0);
+        if let Some(light) = area_glow(display(spell), radius, area) {
+            commands.spawn((light, SpellLightEntity));
+        }
+    }
+}
+
+/// Despawns this module's light entities whose pulse has ended or whose unit has gone, and every
+/// one of them under the classic look.
+fn retire_spell_lights(
+    mut commands: Commands,
+    look: Res<WorldLook>,
+    time: Res<Time>,
+    lights: Query<(Entity, &LookLight, Option<&LookPulse>), With<SpellLightEntity>>,
+    alive: Query<()>,
+) {
+    let now = time.elapsed_secs();
+    for (entity, light, pulse) in &lights {
+        let ended = pulse.is_some_and(|p| p.done(now));
+        let orphaned = light.anchor.is_some_and(|a| !alive.contains(a));
+        if !look.on || ended || orphaned {
+            commands.entity(entity).try_despawn();
+        }
+    }
+}
+
+/// Registers the spell lights. Both systems run in `PostUpdate`, after every writer of the
+/// messages they read (all in `Update`), and touch the world only through commands.
+pub(crate) struct LookLightsPlugin;
+
+impl Plugin for LookLightsPlugin {
+    fn build(&self, app: &mut App) {
+        app.add_systems(PostUpdate, (hang_spell_lights, retire_spell_lights));
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn spell(school: u32, effects: [u32; 3]) -> SpellDisplay {
+        SpellDisplay {
+            school,
+            effects,
+            ..SpellDisplay::default()
+        }
+    }
+
+    /// Fire is orange and flickers, frost is blue and steady, a physical spell has no light
+    /// unless its trail gives it one, and a trail colours any spell.
+    #[test]
+    fn a_spell_takes_its_trail_or_its_school_colour() {
+        let fire = spell(2, [2, 0, 0]);
+        let (rgb, share, flame) = spell_hue(Some(&fire), None).unwrap();
+        assert_eq!((rgb, share, flame), (school_color(2).unwrap(), 1.0, true));
+        let frost = spell(4, [2, 0, 0]);
+        assert!(!spell_hue(Some(&frost), None).unwrap().2);
+        let arrow = spell(0, [2, 0, 0]);
+        assert!(spell_hue(Some(&arrow), None).is_none());
+        let (rgb, share, _) = spell_hue(Some(&arrow), Some([1.0, 0.4, 0.1])).unwrap();
+        assert_eq!((rgb, share), ([1.0, 0.4, 0.1], tune::TRAIL_ONLY_SCALE));
+        let (rgb, share, _) = spell_hue(Some(&frost), Some([0.2, 1.0, 0.2])).unwrap();
+        assert_eq!((rgb, share), ([0.2, 1.0, 0.2], 1.0));
+        // Frost's own blue is lifted toward white and brighter, to show on the night's ground.
+        let (rgb, share, _) = spell_hue(Some(&frost), None).unwrap();
+        assert_eq!((rgb, share), spell_light_hue(school_color(4).unwrap()));
+        assert!(share > 1.0 && rgb[0] > school_color(4).unwrap()[0]);
+        assert!(
+            spell_hue(None, None).is_none(),
+            "an unknown spell casts nothing"
+        );
+    }
+
+    /// A Fireball's missile light, its impact's brighter, shorter flash, and Holy Light's softer,
+    /// longer glow.
+    #[test]
+    fn missiles_carry_light_and_landings_flash_or_glow() {
+        let fireball = spell(2, [2, 0, 0]);
+        let m = missile_light(Some(&fireball), None).unwrap();
+        assert_eq!(m.radius, tune::MISSILE_RADIUS);
+        assert!(m.flicker > 0.0);
+        let (impact, pulse) = landing_light(Some(&fireball), None, 5.0).unwrap();
+        assert!(
+            impact.intensity > m.intensity,
+            "the burst outshines the flight"
+        );
+        let secs = pulse.rise + pulse.hold + pulse.fall;
+        assert!((0.3..=0.6).contains(&secs), "an impact lasts {secs} s");
+        assert!(pulse.done(5.0 + secs) && !pulse.done(5.0 + secs - 0.01));
+        let holy_light = spell(1, [10, 0, 0]);
+        let (glow, gp) = landing_light(Some(&holy_light), None, 0.0).unwrap();
+        assert!(glow.intensity < impact.intensity && glow.radius < impact.radius);
+        assert!(gp.rise + gp.hold + gp.fall > secs, "a heal glows longer");
+        assert!(missile_light(Some(&spell(0, [2, 0, 0])), None).is_none());
+    }
+
+    /// A cast glows on its caster until reaped; an aura breathes; a ground area spans its circle.
+    #[test]
+    fn casts_auras_and_areas_glow() {
+        let owner = Entity::from_raw_u32(7).unwrap();
+        let fire = spell(2, [2, 0, 0]);
+        let (cast, cp) = kit_glow(Some(&fire), FxClass::Hold, owner, 1.0).unwrap();
+        assert_eq!(cast.anchor, Some(owner));
+        assert_eq!(cp.gain(10.0), 1.0, "held until the reap");
+        assert!(cp.done(1.0 + tune::CAST_RISE + tune::CAST_MAX_SECS + tune::CAST_FALL));
+        let shield = spell(1, [6, 0, 0]);
+        let (aura, _) = kit_glow(Some(&shield), FxClass::AuraState, owner, 1.0).unwrap();
+        assert!(aura.flicker > 0.0 && aura.intensity < cast.intensity);
+        assert!(kit_glow(Some(&spell(0, [6, 0, 0])), FxClass::AuraState, owner, 1.0).is_none());
+        let flamestrike = area_glow(Some(&fire), 8.0, owner).unwrap();
+        assert_eq!(flamestrike.radius, 8.0 + tune::AREA_PAD);
+        assert_eq!(
+            area_glow(Some(&fire), 40.0, owner).unwrap().radius,
+            tune::AREA_MAX_RADIUS
+        );
