+    /// A strip from `feet` along the WoW facing `yaw`, `len` long and `width` wide: the frame is
+    /// the strip itself (its x along the facing, z across), the texture's u its length.
+    fn place_line(&mut self, decals: &WorldDecal, feet: Vec3, yaw: f32, len: f32, width: f32) {
+        let key = (feet, yaw, len, decals.receiver_count());
+        if !self.verts.is_empty()
+            && key.0.distance_squared(self.key.0) < 1.0e-4
+            && (key.1 - self.key.1).abs() < 1.0e-3
+            && (key.2 - self.key.2).abs() < 1.0e-3
+            && (width - self.width).abs() < 1.0e-3
+            && key.3 == self.key.3
+        {
+            return;
+        }
+        self.key = key;
+        self.width = width;
+        self.verts.clear();
+        let half = (width / 2.0).max(0.1);
+        let frame = DecalFrame {
+            center: feet,
+            sin: yaw.cos(),
+            cos: -yaw.sin(),
+            min_x: -0.2,
+            max_x: len.max(0.3),
+            min_z: -half,
+            max_z: half,
+            min_y: -VERT,
+            max_y: VERT,
+        };
+        decals.project(
+            &mut self.verts,
+            &frame,
+            |p| ((VERT - p.y.abs()) / VERT).clamp(0.0, 1.0),
+            |x, z| frame.rect_uv(x, z),
+        );
+    }
 }
 
