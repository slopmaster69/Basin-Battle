+/// A strip's texture: its area with softened sides, brighter toward its far end when `filled`.
+fn line_image(filled: bool) -> Image {
+    let mut data = vec![0u8; (TEX * TEX * 4) as usize];
+    for j in 0..TEX {
+        for i in 0..TEX {
+            // u (i) along the strip, v (j) across it.
+            let u = (i as f32 + 0.5) / TEX as f32;
+            let v = (j as f32 + 0.5) / TEX as f32;
+            let edge = (u.min(1.0 - u) / 0.02).min(v.min(1.0 - v) / 0.08).clamp(0.0, 1.0);
+            if u < 0.01 || u > 0.99 || v < 0.02 || v > 0.98 {
+                continue;
+            }
+            let a = if filled { (40.0 + 90.0 * u * u) * edge } else { (40.0 + 30.0 * u) * edge };
+            let k = ((j * TEX + i) * 4) as usize;
+            data[k..k + 4].copy_from_slice(&[255, 255, 255, a as u8]);
+        }
+    }
+    Image::new(
+        Extent3d {
+            width: TEX,
+            height: TEX,
+            depth_or_array_layers: 1,
+        },
+        TextureDimension::D2,
+        data,
+        TextureFormat::Rgba8UnormSrgb,
+        RenderAssetUsages::default(),
+    )
 }
 
