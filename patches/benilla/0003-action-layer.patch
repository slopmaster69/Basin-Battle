+    fn new(clip: &benilla_assets::AnimClip, body: ActionBody) -> Self {
+        Self {
+            id: clip.anim_id,
+            full: clip.blend_node.unwrap_or(clip.node),
+            upper: clip.upper_node,
+            body,
+            on_upper: body == ActionBody::Upper,
+            t: 0.0,
+            len: clip.duration.max(0.05),
+            key: impact_time(clip),
+            windup: 0.0,
+            recovery: 0.0,
+            hold: 0.0,
+            held: 0.0,
+            looping: clip.looping,
+            lambda: 0.0,
+            stopping: None,
+            last_pos: None,
+            moving_for: 0.0,
+        }
+    }
+
+    /// This instant's clip speed.
+    fn rate(&self) -> f32 {
+        let r = if self.key > 0.0 {
+            if self.t < self.key {
+                if self.windup > 0.0 {
+                    self.key / self.windup
+                } else {
+                    1.0
+                }
+            } else if self.recovery > 0.0 {
+                (self.len - self.key) / self.recovery
+            } else {
+                1.0
+            }
+        } else if self.windup > 0.0 {
+            self.len / self.windup
+        } else {
+            1.0
+        };
+        r.clamp(RATE_RANGE.0, RATE_RANGE.1)
+    }
+
+    /// Advance the clip clock by `dt` real seconds: to the impact at the wind-up's pace, then the
+    /// recovery's; past the end it loops (a held looping clip) or holds the last pose.
+    fn advance(&mut self, dt: f32) {
+        let mut left = dt;
+        for _ in 0..2 {
+            let rate = self.rate();
+            let to_key = if self.key > 0.0 && self.t < self.key {
+                (self.key - self.t) / rate
+            } else {
+                f32::INFINITY
+            };
+            let step = left.min(to_key);
+            self.t += step * rate;
+            left -= step;
+            if left <= 0.0 {
+                break;
+            }
+        }
+        if self.looping {
+            // A looping clip plays for its hold (one pass without one), then lets go.
+            self.t %= self.len;
+            self.held += dt;
+            let total = if self.hold > 0.0 { self.hold } else { self.len };
+            if self.held >= total && self.stopping.is_none() {
+                self.stopping = Some(FADE_OUT);
+            }
+        } else if self.t >= self.len - 2.0e-3 {
+            // A one-shot holds its last pose for its hold, then lets go.
+            self.t = self.t.min(self.len - 1.0e-3);
+            self.held += dt;
+            if self.held >= self.hold && self.stopping.is_none() {
+                self.stopping = Some(FADE_OUT);
+            }
+        }
+    }
+
+    fn nodes(&self) -> impl Iterator<Item = AnimationNodeIndex> {
+        std::iter::once(self.full).chain(self.upper)
+    }
