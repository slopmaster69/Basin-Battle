+/// A bone's tilted pose, given back part by part: whatever still holds what the tilt wrote returns
+/// to the pose under it.
+fn restore(cur: &mut Transform, base: &Transform, last: &Transform) -> bool {
+    let mut changed = false;
+    if cur.translation == last.translation && cur.translation != base.translation {
+        cur.translation = base.translation;
+        changed = true;
+    }
+    if cur.rotation == last.rotation && cur.rotation != base.rotation {
+        cur.rotation = base.rotation;
+        changed = true;
+    }
+    if cur.scale == last.scale && cur.scale != base.scale {
+        cur.scale = base.scale;
+        changed = true;
+    }
+    changed
