+/// How fast the body turns to a locked-on unit, radians a second.
+const LOCK_TURN_RATE: f32 = 9.0;
+
+/// Basin Battle's action dash ([`benilla_ui::action_combat::take_dashes`]): the new ones queued, a
+/// due one started (with the keys held now when it named none, a step back with none held), and
+/// while one runs, its keys in place of the player's.
+fn action_dash(player: &mut Player, axes: &mut input::MoveAxes, now: f32, may_translate: bool) {
+    for d in benilla_ui::action_combat::take_dashes() {
+        let (fwd, side) = d.keys.unwrap_or((0, 0));
+        let dash = super::state::ActionDash {
+            fwd,
+            side,
+            speed: d.speed,
+            until: 0.0,
+            secs: d.secs,
+            keys_now: d.keys.is_none(),
+        };
+        player.pending_dashes.push((now + d.delay, dash));
+    }
+    let mut i = 0;
+    while i < player.pending_dashes.len() {
+        if player.pending_dashes[i].0 > now {
+            i += 1;
+            continue;
+        }
+        let (_, mut d) = player.pending_dashes.remove(i);
+        if d.keys_now {
+            let (f, s) = (axes.fwd.signum(), axes.side.signum());
+            (d.fwd, d.side) = if f == 0 && s == 0 { (-1, 0) } else { (f, s) };
+        }
+        d.until = now + d.secs;
+        player.action_dash = Some(d);
+    }
+    let Some(d) = player.action_dash else { return };
+    if now >= d.until || !may_translate || player.swimming {
+        player.action_dash = None;
+        return;
+    }
+    axes.fwd = d.fwd;
+    axes.side = d.side;
+    axes.translating = d.fwd != 0 || d.side != 0;
+    axes.strafe_left = d.side < 0;
+    axes.strafe_right = d.side > 0;
+    axes.turning = false;
+    axes.turn_left = false;
+    axes.turn_right = false;
+}
