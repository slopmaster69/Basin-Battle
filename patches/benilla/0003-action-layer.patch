+fn start_clip(
+    commands: &mut Commands,
+    clips: &mut Query<&mut ActionClip>,
+    entity: Entity,
+    clip: ActionClip,
+) {
+    if let Ok(mut old) = clips.get_mut(entity) {
+        let lambda = if old.stopping.is_some() {
+            0.0
+        } else {
+            old.lambda
+        };
+        let stale: Vec<AnimationNodeIndex> = old
+            .nodes()
+            .filter(|n| *n != clip.full && Some(*n) != clip.upper)
+            .collect();
+        *old = ActionClip { lambda, ..clip };
+        if !stale.is_empty() {
+            commands.entity(entity).try_insert(ReleaseNodes(stale));
+        }
+    } else {
+        commands.entity(entity).try_insert(clip);
+    }
 }
 
