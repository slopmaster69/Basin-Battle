+/// The `variation`th take of the clip a requested id resolves to on this model (the first when
+/// it has fewer).
+fn take_of<'a>(
+    anims: &'a ModelAnimations,
+    anim: u16,
+    variation: Option<usize>,
+    catalog: Option<&benilla_formats::AnimDataCatalog>,
+) -> Option<&'a benilla_assets::AnimClip> {
+    let head = find_resolved(anims, anim, catalog)?;
+    let n = variation.unwrap_or(0);
+    anims
+        .clips
+        .iter()
+        .filter(|c| c.anim_id == head.anim_id)
+        .nth(n)
+        .or(Some(head))
+}
