+fn rebase(base: &mut Transform, cur: &Transform, last: &Transform) {
+    if cur.translation != last.translation {
+        base.translation = cur.translation;
+    }
+    if cur.rotation != last.rotation {
+        base.rotation = cur.rotation;
+    }
+    if cur.scale != last.scale {
+        base.scale = cur.scale;
+    }
