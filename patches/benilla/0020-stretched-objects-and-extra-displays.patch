index 0000000..94b8d45
--- /dev/null
+++ b/crates/benilla-app/src/entities/stretch.rs
@@ -0,0 +1,99 @@
+//! Stretched game objects, benilla's own (no reference behaviour): a GameObject whose
+//! `GAMEOBJECT_FLAGS` carry [`STRETCH_X`] or [`STRETCH_Y`] is drawn longer along that axis of its
+//! model (WoW's model axes: X forward, Y left) by the factor `GAMEOBJECT_LEVEL` holds as an `f32`'s
+//! bits, on top of `OBJECT_FIELD_SCALE_X` on every axis. So one rope piece spans any length at the
+//! thickness its scale gives it (Elwynn Survival's tripwire: the rope between two arrows). The
+//! reference scales a model evenly; `GAMEOBJECT_LEVEL` only means something to a lockable object
+//! (`target::lock`), which a stretched one never is.
+
+use benilla_protocol::EntityKind;
+use bevy::prelude::*;
+
+use crate::net::{NetEntity, ObjectStore};
+
+/// `GAMEOBJECT_FLAGS` bit: longer along the model's X axis by the factor in `GAMEOBJECT_LEVEL`.
+pub(crate) const STRETCH_X: u32 = 0x4000_0000;
+/// `GAMEOBJECT_FLAGS` bit: longer along the model's Y axis by the factor in `GAMEOBJECT_LEVEL`.
+pub(crate) const STRETCH_Y: u32 = 0x8000_0000;
+/// The longest stretch drawn: past it, a wire value is taken as a mistake and ignored.
+const MOST: f32 = 100.0;
+
+/// A model's render scale: `scale` on every axis, the stretch factor more along the flagged axis.
+/// Bevy's local axes from the model's (`wow_to_bevy`): X → −Z, Y → −X, Z → Y; a scale has no sign.
+pub(crate) fn render_scale(kind: EntityKind, flags: u32, level: u32, scale: f32) -> Vec3 {
+    let mut v = Vec3::splat(scale);
+    if kind != EntityKind::GameObject || flags & (STRETCH_X | STRETCH_Y) == 0 {
+        return v;
+    }
+    let k = f32::from_bits(level);
+    if !(k.is_finite() && k > 0.0 && k <= MOST) {
+        return v;
+    }
+    if flags & STRETCH_X != 0 {
+        v.z *= k;
+    }
+    if flags & STRETCH_Y != 0 {
+        v.x *= k;
+    }
+    v
+}
+
+/// [`render_scale`] of a streamed entity, from its stored fields.
+pub(crate) fn entity_render_scale(
+    net: &NetEntity,
+    store: Option<&ObjectStore>,
+    scale: f32,
+) -> Vec3 {
+    match store {
+        Some(s) => render_scale(
+            net.kind,
+            s.0.gameobject_flags(),
+            s.0.gameobject_level(),
+            scale,
+        ),
+        None => Vec3::splat(scale),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn only_a_flagged_game_object_stretches_and_along_its_axis() {
+        let two = 2.0f32.to_bits();
+        assert_eq!(
+            render_scale(EntityKind::GameObject, 0, two, 0.5),
+            Vec3::splat(0.5)
+        );
+        assert_eq!(
+            render_scale(EntityKind::GameObject, STRETCH_X, two, 0.5),
+            Vec3::new(0.5, 0.5, 1.0)
+        );
+        assert_eq!(
+            render_scale(EntityKind::GameObject, STRETCH_Y, two, 0.5),
+            Vec3::new(1.0, 0.5, 0.5)
+        );
+        // A unit's field 9 is not GameObject flags.
+        assert_eq!(
+            render_scale(EntityKind::Unit, STRETCH_X, two, 0.5),
+            Vec3::splat(0.5)
+        );
+    }
+
+    #[test]
+    fn a_nonsense_factor_draws_the_model_unstretched() {
+        for bad in [
+            0u32,
+            (-1.0f32).to_bits(),
+            f32::NAN.to_bits(),
+            f32::INFINITY.to_bits(),
+            1000.0f32.to_bits(),
+        ] {
+            assert_eq!(
+                render_scale(EntityKind::GameObject, STRETCH_X, bad, 1.5),
+                Vec3::splat(1.5)
+            );
+        }
+    }
+}
