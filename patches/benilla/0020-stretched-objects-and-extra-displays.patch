+    // A dwarven dig site's rope, straight between two stakes: the tripwire's wire.
+    (
+        60001,
+        "World\\Generic\\Dwarf\\Passive Doodads\\ExcavationRopeStake\\ExcavationRope.mdx",
+    ),
+];
+
