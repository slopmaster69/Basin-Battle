+    /// A body between the camera and one of the two hides them; one beside the line, behind the
+    /// camera or past the one filmed doesn't.
+    #[test]
+    fn a_body_on_the_line_hides_what_is_past_it() {
+        let (eye, to) = (Vec3::new(0.0, 1.5, 0.0), Vec3::new(0.0, 1.5, 10.0));
+        let at = |x: f32, z: f32| [body(x, z)];
+        assert!(hidden_by(&at(0.0, 5.0), eye, to));
+        assert!(hidden_by(&at(0.4, 3.0), eye, to), "its girth");
+        assert!(!hidden_by(&at(1.5, 5.0), eye, to), "beside the line");
+        assert!(!hidden_by(&at(0.0, -2.0), eye, to), "behind the camera");
+        assert!(!hidden_by(&at(0.0, 12.0), eye, to), "past the one filmed");
+        assert!(!hidden_by(&[], eye, to));
+    }
