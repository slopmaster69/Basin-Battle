+        assert_eq!((s.subject.as_str(), s.hero.as_str(), s.shot), ("Captain Greenskin", "Vcwarrior", Shot::Low));
+        assert_eq!(Spectate::parse("Rhahk'Zor,Vcwarrior").unwrap().shot, Shot::Duel);
+        assert_eq!(Spectate::parse(",Vcwarrior,high").unwrap().subject, "");
+        assert!(Spectate::parse("Rhahk'Zor").is_none(), "no hero");
+        assert!(Spectate::parse("Rhahk'Zor,").is_none(), "an empty hero");
+        assert!(Spectate::parse("Rhahk'Zor,Vcwarrior,sideways").is_none(), "an unknown shot");
+        assert!(Spectate::parse("a,b,duel,more").is_none());
+    }
+
+    /// A duel's first position: three-quarter, from the hero's side, 10 to 14 yd out, a little up.
+    #[test]
+    fn a_duel_is_three_quarter_from_the_heros_side_10_to_14_yd_out() {
+        let (subject, hero) = (body(0.0, 0.0), body(0.0, 3.0));
+        let axis = 0.0; // subject to hero is +z
+        let p = pose(Shot::Duel, subject, hero, axis, 0);
+        assert!((10.0..=14.0).contains(&p.dist), "{}", p.dist);
+        let eye = p.look + p.out * p.dist;
+        assert!(eye.z > hero.at.z, "on the hero's side: {eye}");
+        let flat = p.out.with_y(0.0).normalize();
+        let off_axis = flat.z.acos().to_degrees();
+        assert!((40.0..=60.0).contains(&off_axis), "three-quarter: {off_axis}");
+        assert!(p.out.y > 0.1 && p.out.y < 0.5, "a little above them: {}", p.out.y);
+        // Far apart, it stands back past 14 yd rather than lose either.
+        let wide = pose(Shot::Duel, subject, body(0.0, 30.0), axis, 0);
+        assert!(wide.dist > 14.0);
+    }
+
+    #[test]
+    fn low_is_20_yd_and_high_is_45_to_60_degrees_up() {
+        let (subject, hero) = (body(0.0, 0.0), body(4.0, 0.0));
+        let low = pose(Shot::Low, subject, hero, 0.0, 0);
+        assert_eq!(low.dist, 20.0);
+        assert!(low.out.y.asin().to_degrees() < 10.0);
+        let high = pose(Shot::High, subject, hero, 0.0, 0);
+        let up = high.out.y.asin().to_degrees();
+        assert!((45.0..=60.0).contains(&up), "{up}");
+        assert!(high.look.y < subject.at.y, "it looks at the ground between them");
+    }
+
+    /// The positions go round: the other side next, and the second round higher.
+    #[test]
+    fn the_next_position_is_the_other_side_then_higher() {
+        let (subject, hero) = (body(0.0, 0.0), body(0.0, 3.0));
+        let a = pose(Shot::Duel, subject, hero, 0.0, 0);
+        let b = pose(Shot::Duel, subject, hero, 0.0, 1);
+        assert!(a.out.x * b.out.x < 0.0, "the other side");
+        let n = Shot::Duel.rule().sides.len();
+        assert_eq!(positions(&Shot::Duel.rule()), n * 2);
+        assert!(pose(Shot::Duel, subject, hero, 0.0, n).out.y > a.out.y);
+    }
