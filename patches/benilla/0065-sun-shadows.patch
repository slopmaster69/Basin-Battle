diff --git a/crates/benilla-world/src/look/shadow_pass.rs b/crates/benilla-world/src/look/shadow_pass.rs
new file mode 100644
index 0000000..bdeb415
--- /dev/null
+++ b/crates/benilla-world/src/look/shadow_pass.rs
@@ -0,0 +1,917 @@
+//! The sun shadows' pass (`look::shadows`), the render half: before the main pass, one depth-only
+//! render pass per slice into its layer of [`SHADOW_MAP`], drawing
+//! - the retained static world (`static_gx`: ADT doodads, WMO exteriors, WMO props), from the
+//!   static pass's own regions and buffers, culled per region, its leaves cut by their texture;
+//! - every `WowModelMaterial` mesh drawn in the world (creatures, heroes, objects, doodads still
+//!   on the entity path), skinned from the shared palette, an alpha-tested batch cut;
+//! - the terrain's cells, so a hill shades the valley behind it under a low sun.
+//!
+//! Casters are culled per slice by their bounds against the slice's box, small ones dropped from
+//! the far slices ([`tune::SMALL_CASTER_RADIUS`]). An entity caster is gated on Bevy's
+//! `InheritedVisibility`, so a body the exterior-scene election hides (off screen) casts none; the
+//! static world and the terrain are culled here alone, so a tree behind the camera still shades
+//! the road in front of it. Translucent, additive, depth-less and interior batches never cast, nor
+//! ground clutter.
+//!
+//! `WOW_SHADOW_STATS=1` prints each slice's draw counts once a second.
+
+use bevy::camera::primitives::Aabb;
+use bevy::camera::visibility::RenderLayers;
+use bevy::core_pipeline::core_3d::graph::{Core3d, Node3d};
+use bevy::ecs::query::QueryItem;
+use bevy::mesh::{MeshTag, MeshVertexBufferLayoutRef};
+use bevy::pbr::MeshMaterial3d;
+use bevy::platform::collections::HashMap;
+use bevy::prelude::*;
+use bevy::render::diagnostic::RecordDiagnostics;
+use bevy::render::extract_resource::ExtractResourcePlugin;
+use bevy::render::mesh::allocator::MeshAllocator;
+use bevy::render::mesh::{RenderMesh, RenderMeshBufferInfo};
+use bevy::render::render_asset::RenderAssets;
+use bevy::render::render_graph::{
+    NodeRunError, RenderGraphContext, RenderGraphExt, RenderLabel, ViewNode, ViewNodeRunner,
+};
+use bevy::render::render_resource::binding_types::{
+    sampler, storage_buffer_read_only_sized, texture_2d, uniform_buffer_sized,
+};
+use bevy::render::render_resource::*;
+use bevy::render::renderer::{RenderContext, RenderDevice, RenderQueue};
+use bevy::render::texture::GpuImage;
+use bevy::render::{Extract, ExtractSchedule, Render, RenderApp, RenderStartup, RenderSystems};
+use bevy::shader::ShaderDefVal;
+
+use benilla_assets::materials::{shadow_map_image, TerrainMaterial, WowModelMaterial, SHADOW_MAP};
+
+use super::pass::LookView;
+use super::shadows::{tune, ShadowFrame};
+
+/// Every shader-def set the caster pipelines specialise `world_shadow.wgsl` with: the static
+/// world's two, and an entity's solid, cut, skinned and skinned-cut.
+pub fn shader_def_sets() -> Vec<Vec<ShaderDefVal>> {
+    let d = |names: &[&'static str]| names.iter().map(|n| ShaderDefVal::from(*n)).collect();
+    vec![
+        d(&["SHADOW_STATIC"]),
+        d(&["SHADOW_STATIC", "SHADOW_CUTOUT"]),
+        d(&[]),
+        d(&["SHADOW_CUTOUT"]),
+        d(&["SHADOW_SKIN"]),
+        d(&["SHADOW_CUTOUT", "SHADOW_SKIN"]),
+    ]
+}
+
+/// The map's depth format, as [`shadow_map_image`] makes it.
+const SHADOW_FORMAT: TextureFormat = TextureFormat::Depth16Unorm;
+
+/// One slice's uniform (`world_shadow.wgsl`'s `ShadowSlice`): five rows, at a 256-byte stride so
+/// each slice binds at its own dynamic offset.
+const SLICE_BYTES: u64 = 80;
+const SLICE_STRIDE: u64 = 256;
+
+/// Inserts [`SHADOW_MAP`]'s image, once, before any material is made (`shaders::plugin`).
+pub(crate) fn insert_shadow_map(images: Option<ResMut<Assets<Image>>>) {
+    let Some(mut images) = images else { return };
+    if images.get(SHADOW_MAP.id()).is_none() {
+        let _ = images.insert(
+            SHADOW_MAP.id(),
+            shadow_map_image(tune::MAP_SIZE, tune::MAP_LAYERS),
+        );
+    }
+}
+
+/// One entity caster, extracted: its mesh, its instance row (`world_shadow.wgsl`'s `ShadowInst`),
+/// its bounding sphere and, for an alpha-tested batch, the texture it is cut by.
+#[derive(Clone, Copy, Debug, PartialEq)]
+struct Caster {
+    mesh: AssetId<Mesh>,
+    inst: [[f32; 4]; 4],
+    center: Vec3,
+    radius: f32,
+    cut: Option<AssetId<Image>>,
+}
+
+#[derive(Resource, Default)]
+struct ShadowCasters(Vec<Caster>);
+
+/// `wow_model.wgsl`'s `clutter_fade.z` marker bits whose batch casts no shadow: no depth write
+/// (0), no depth test (1), additive (2), Mod (7), Mod2x (8), the depth-prime twin (9), the far
+/// side of a water straddle (11, the near copy casts), the sky shell (13).
+const NO_CAST_MARKERS: u32 = 1 | 2 | 4 | 0x80 | 0x100 | 0x200 | 0x800 | 0x2000;
+/// Marker bit 10: a fade twin whose source alpha-tests.
+const TWIN_CUTOUT_MARKER: u32 = 0x400;
+
+/// Whether a model material casts, and how: `None` not at all; `Some(None)` solid; `Some(Some(t))`
+/// cut by texture `t`'s alpha. Ground clutter, interiors, the authored-rig lane (glue scenes and
+/// portraits) and translucent batches cast none; a fading doodad's blend twin casts as its source.
+pub fn caster_kind(mat: &WowModelMaterial) -> Option<Option<AssetId<Image>>> {
+    let ext = &mat.extension;
+    caster_law(
+        mat.base.alpha_mode,
+        mat.base.base_color_texture.as_ref().map(|h| h.id()),
+        ext.clutter_fade,
+        ext.model_flags,
+        ext.sun_scale,
+    )
+}
+
+/// [`caster_kind`] on the material's lanes alone.
+fn caster_law(
+    alpha_mode: AlphaMode,
+    texture: Option<AssetId<Image>>,
+    clutter_fade: Vec4,
+    model_flags: Vec4,
+    sun_scale: Vec4,
+) -> Option<Option<AssetId<Image>>> {
+    let markers = clutter_fade.z as u32;
+    if clutter_fade.w > 0.5
+        || markers & NO_CAST_MARKERS != 0
+        || model_flags.z > 0.5
+        || sun_scale.x >= 1.5
+    {
+        return None;
+    }
+    match alpha_mode {
+        AlphaMode::Opaque => Some(None),
+        AlphaMode::Mask(_) => Some(texture),
+        AlphaMode::Blend if model_flags.y > 0.5 => {
+            Some(texture.filter(|_| markers & TWIN_CUTOUT_MARKER != 0))
+        }
+        _ => None,
+    }
+}
+
+/// A caster's instance row: its world matrix's linear part as three rows (w 0) and its translation
+/// apart, `w` the rig slot (a float: exact far past 2047, and never a denormal).
+fn inst_rows(gt: &GlobalTransform, rig: u32) -> [[f32; 4]; 4] {
+    let a = gt.affine();
+    let (x, y, z) = (a.matrix3.x_axis, a.matrix3.y_axis, a.matrix3.z_axis);
+    let t = a.translation;
+    [
+        [x.x, y.x, z.x, 0.0],
+        [x.y, y.y, z.y, 0.0],
+        [x.z, y.z, z.z, 0.0],
+        [t.x, t.y, t.z, rig as f32],
+    ]
+}
+
+/// A mesh's bounding sphere in the world: its box's centre and corner under the transform.
+fn bounding_sphere(gt: &GlobalTransform, aabb: &Aabb) -> (Vec3, f32) {
+    let center = gt.transform_point(Vec3::from(aabb.center));
+    let scale = gt.affine().matrix3.to_cols_array();
+    let s = Vec3::new(scale[0], scale[1], scale[2])
+        .length()
+        .max(Vec3::new(scale[3], scale[4], scale[5]).length())
+        .max(Vec3::new(scale[6], scale[7], scale[8]).length());
+    (center, Vec3::from(aabb.half_extents).length() * s)
+}
+
+type ModelCaster = (
+    &'static Mesh3d,
+    &'static MeshMaterial3d<WowModelMaterial>,
+    &'static GlobalTransform,
+    Option<&'static Aabb>,
+    &'static InheritedVisibility,
+    Option<&'static MeshTag>,
+    Option<&'static RenderLayers>,
+);
+
+type TerrainCaster = (
+    &'static Mesh3d,
+    &'static GlobalTransform,
+    Option<&'static Aabb>,
+);
+
+/// The frame's entity and terrain casters, those reaching any slice.
+fn extract_casters(
+    mut out: ResMut<ShadowCasters>,
+    frame: Extract<Res<ShadowFrame>>,
+    models: Extract<Query<ModelCaster>>,
+    terrain: Extract<Query<TerrainCaster, With<MeshMaterial3d<TerrainMaterial>>>>,
+    materials: Extract<Res<Assets<WowModelMaterial>>>,
+) {
+    out.0.clear();
+    if frame.cascades == 0 {
+        return;
+    }
+    let frame = **frame;
+    let admits = |c: Vec3, r: f32| {
+        frame.slices[..frame.cascades]
+            .iter()
+            .any(|s| s.admits_sphere(&frame, c, r))
+    };
+    let world_layer = RenderLayers::default();
+    for (mesh, mat, gt, aabb, vis, tag, layers) in &models {
+        if !vis.get() || layers.is_some_and(|l| !l.intersects(&world_layer)) {
+            continue;
+        }
+        let Some(aabb) = aabb else { continue };
+        let rig = tag.map_or(0, |t| (t.0 >> 19) & 0x7ff);
+        let (center, radius) = bounding_sphere(gt, aabb);
+        // A rig's box is its bind pose's: a swing reaches past it.
+        let radius = radius + if rig != 0 { tune::SKINNED_MARGIN } else { 0.0 };
+        if !admits(center, radius) {
+            continue;
+        }
+        let Some(cut) = materials.get(&mat.0).and_then(caster_kind) else {
+            continue;
+        };
+        out.0.push(Caster {
+            mesh: mesh.id(),
+            inst: inst_rows(gt, rig),
+            center,
+            radius,
+            cut,
+        });
+    }
+    // The terrain's cells, whatever the exterior cull hid: a hill off screen still shades.
+    for (mesh, gt, aabb) in &terrain {
+        let Some(aabb) = aabb else { continue };
+        let (center, radius) = bounding_sphere(gt, aabb);
+        if admits(center, radius) {
+            out.0.push(Caster {
+                mesh: mesh.id(),
+                inst: inst_rows(gt, 0),
+                center,
+                radius,
+                cut: None,
+            });
+        }
+    }
+}
+
+/// The pass's layouts, sampler and shader, and its pipelines as they are specialised: an entity
+/// pipeline per (mesh layout, skinned, cut), the static world's two (solid, cut).
+#[derive(Resource)]
+struct ShadowPipelines {
+    group0: BindGroupLayoutDescriptor,
+    cut_layout: BindGroupLayoutDescriptor,
+    sampler: Sampler,
+    shader: Handle<Shader>,
+    entity: HashMap<(MeshVertexBufferLayoutRef, bool, bool), CachedRenderPipelineId>,
+    statics: Option<[CachedRenderPipelineId; 2]>,
+}
+
+fn init_pipelines(mut commands: Commands, device: Res<RenderDevice>, assets: Res<AssetServer>) {
+    let group0 = BindGroupLayoutDescriptor::new(
+        "look_shadow_group0",
+        &BindGroupLayoutEntries::sequential(
+            ShaderStages::VERTEX_FRAGMENT,
+            (
+                uniform_buffer_sized(true, std::num::NonZero::new(SLICE_BYTES)),
+                // The shared light buffer, for the skin palettes.
+                storage_buffer_read_only_sized(false, None),
+                // The entity casters' instance rows.
+                storage_buffer_read_only_sized(false, None),
+            ),
+        ),
+    );
+    let cut_layout = BindGroupLayoutDescriptor::new(
+        "look_shadow_cut",
+        &BindGroupLayoutEntries::sequential(
+            ShaderStages::FRAGMENT,
+            (
+                texture_2d(TextureSampleType::Float { filterable: true }),
+                sampler(SamplerBindingType::Filtering),
+            ),
+        ),
+    );
+    commands.insert_resource(ShadowPipelines {
+        group0,
+        cut_layout,
+        sampler: device.create_sampler(&SamplerDescriptor {
+            label: Some("look_shadow_cut"),
+            address_mode_u: AddressMode::Repeat,
+            address_mode_v: AddressMode::Repeat,
+            mag_filter: FilterMode::Linear,
+            min_filter: FilterMode::Linear,
+            mipmap_filter: FilterMode::Linear,
+            ..Default::default()
+        }),
+        shader: assets.load("embedded://benilla_world/shaders/world_shadow.wgsl"),
+        entity: HashMap::default(),
+        statics: None,
+    });
+}
+
+/// A caster pipeline: depth only, both faces (a single-sided wall still blocks the sun from
+/// behind), a slope bias against acne, a fragment stage only to cut.
+fn caster_pipeline(
+    label: &'static str,
+    layout: Vec<BindGroupLayoutDescriptor>,
+    shader: &Handle<Shader>,
+    defs: Vec<ShaderDefVal>,
+    buffer: bevy::mesh::VertexBufferLayout,
+    cut: bool,
+) -> RenderPipelineDescriptor {
+    RenderPipelineDescriptor {
+        label: Some(label.into()),
+        layout,
+        vertex: VertexState {
+            shader: shader.clone(),
+            shader_defs: defs.clone(),
+            entry_point: Some("vs_main".into()),
+            buffers: vec![buffer],
+        },
+        fragment: cut.then(|| FragmentState {
+            shader: shader.clone(),
+            shader_defs: defs,
+            entry_point: Some("fs_cutout".into()),
+            targets: vec![],
+        }),
+        primitive: PrimitiveState {
+            cull_mode: None,
+            ..Default::default()
+        },
+        depth_stencil: Some(DepthStencilState {
+            format: SHADOW_FORMAT,
+            depth_write_enabled: true,
+            depth_compare: CompareFunction::LessEqual,
+            stencil: StencilState::default(),
+            bias: DepthBiasState {
+                constant: tune::RASTER_CONSTANT_BIAS,
+                slope_scale: tune::RASTER_SLOPE_BIAS,
+                clamp: 0.0,
+            },
+        }),
+        multisample: MultisampleState::default(),
+        ..default()
+    }
+}
+
+/// An entity caster's draw in one slice.
+#[derive(Clone, Copy)]
+struct EntityDraw {
+    pipeline: CachedRenderPipelineId,
+    mesh: AssetId<Mesh>,
+    inst: u32,
+    cut: Option<AssetId<Image>>,
+}
+
+/// The pass's GPU state, kept across frames.
+#[derive(Resource)]
+struct ShadowGpu {
+    slices: Buffer,
+    insts: RawBufferVec<[[f32; 4]; 4]>,
+    group0: Option<BindGroup>,
+    cut_groups: HashMap<AssetId<Image>, BindGroup>,
+    /// One view per layer of the map, and the texture they were made from.
+    layers: Vec<TextureView>,
+    layers_of: Option<TextureId>,
+    draws: [Vec<EntityDraw>; 4],
+    /// Frames since `cut_groups` was last emptied (it holds textures alive).
+    age: u32,
+}
+
+impl FromWorld for ShadowGpu {
+    fn from_world(world: &mut World) -> Self {
+        let device = world.resource::<RenderDevice>();
+        let mut insts = RawBufferVec::new(BufferUsages::STORAGE);
+        insts.set_label(Some("look_shadow_insts"));
+        Self {
+            slices: device.create_buffer(&BufferDescriptor {
+                label: Some("look_shadow_slices"),
+                size: SLICE_STRIDE * u64::from(tune::MAP_LAYERS),
+                usage: BufferUsages::UNIFORM | BufferUsages::COPY_DST,
+                mapped_at_creation: false,
+            }),
+            insts,
+            group0: None,
+            cut_groups: HashMap::default(),
+            layers: Vec::new(),
+            layers_of: None,
+            draws: Default::default(),
+            age: 0,
+        }
+    }
+}
+
+/// The slices' uniform rows, at their stride (`world_shadow.wgsl`'s `ShadowSlice`).
+fn slice_rows(frame: &ShadowFrame) -> Vec<f32> {
+    let stride = (SLICE_STRIDE / 4) as usize;
+    let mut out = vec![0.0f32; stride * tune::MAP_LAYERS as usize];
+    for (i, s) in frame.slices.iter().enumerate().take(frame.cascades) {
+        let row = &mut out[i * stride..i * stride + 20];
+        row[..4].copy_from_slice(&[s.center.x, s.center.y, s.center.z, 1.0 / s.half]);
+        row[4..8].copy_from_slice(&[s.near, 1.0 / s.range, 0.0, 0.0]);
+        row[8..11].copy_from_slice(&frame.right.to_array());
+        row[12..15].copy_from_slice(&frame.up.to_array());
+        row[16..19].copy_from_slice(&frame.travel.to_array());
+    }
+    out
+}
+
+/// Specialises what this frame needs, fills the instance table and each slice's entity draws.
+#[allow(clippy::too_many_arguments)]
+fn prepare_shadows(
+    frame: Res<ShadowFrame>,
+    casters: Res<ShadowCasters>,
+    mut pipes: ResMut<ShadowPipelines>,
+    mut gpu: ResMut<ShadowGpu>,
+    cache: Res<PipelineCache>,
+    meshes: Res<RenderAssets<RenderMesh>>,
+    images: Res<RenderAssets<GpuImage>>,
+    gx: Option<Res<crate::static_gx::GxPipelines>>,
+    device: Res<RenderDevice>,
+    queue: Res<RenderQueue>,
+) {
+    let gpu = &mut *gpu;
+    for d in gpu.draws.iter_mut() {
+        d.clear();
+    }
+    if frame.cascades == 0 {
+        return;
+    }
+    queue.write_buffer(&gpu.slices, 0, bytemuck::cast_slice(&slice_rows(&frame)));
+    let pipes = &mut *pipes;
+    if let (None, Some(gx)) = (pipes.statics, gx.as_deref()) {
+        let layout = vec![pipes.group0.clone(), gx.cell_layout.clone()];
+        let make = |cut: bool| {
+            let mut defs = vec![ShaderDefVal::from("SHADOW_STATIC")];
+            if cut {
+                defs.push("SHADOW_CUTOUT".into());
+            }
+            cache.queue_render_pipeline(caster_pipeline(
+                if cut {
+                    "look_shadow_static_cut"
+                } else {
+                    "look_shadow_static"
+                },
+                layout.clone(),
+                &pipes.shader,
+                defs,
+                crate::static_gx::shadow_vertex_layout(),
+                cut,
+            ))
+        };
+        pipes.statics = Some([make(false), make(true)]);
+    }
+    gpu.insts.clear();
+    for c in &casters.0 {
+        let Some(mesh) = meshes.get(c.mesh) else {
+            continue;
+        };
+        let skinned = mesh
+            .layout
+            .0
+            .contains(benilla_assets::ATTRIBUTE_WOW_JOINT_INDEX);
+        let cut = c
+            .cut
+            .filter(|t| images.get(*t).is_some() && mesh.layout.0.contains(Mesh::ATTRIBUTE_UV_0));
+        let key = (mesh.layout.clone(), skinned, cut.is_some());
+        let pipeline = match pipes.entity.get(&key) {
+            Some(id) => *id,
+            None => {
+                let mut attrs = vec![Mesh::ATTRIBUTE_POSITION.at_shader_location(0)];
+                let mut defs: Vec<ShaderDefVal> = Vec::new();
+                let mut layout = vec![pipes.group0.clone()];
+                if cut.is_some() {
+                    attrs.push(Mesh::ATTRIBUTE_UV_0.at_shader_location(2));
+                    defs.push("SHADOW_CUTOUT".into());
+                    layout.push(pipes.cut_layout.clone());
+                }
+                if skinned {
+                    attrs.push(benilla_assets::ATTRIBUTE_WOW_JOINT_INDEX.at_shader_location(10));
+                    attrs.push(benilla_assets::ATTRIBUTE_WOW_JOINT_WEIGHT.at_shader_location(11));
+                    defs.push("SHADOW_SKIN".into());
+                }
+                let Ok(buffer) = mesh.layout.0.get_layout(&attrs) else {
+                    continue;
+                };
+                let id = cache.queue_render_pipeline(caster_pipeline(
+                    "look_shadow_entity",
+                    layout,
+                    &pipes.shader,
+                    defs,
+                    buffer,
+                    cut.is_some(),
+                ));
+                pipes.entity.insert(key, id);
+                id
+            }
+        };
+        let inst = gpu.insts.push(c.inst) as u32;
+        for (i, slice) in frame.slices.iter().enumerate().take(frame.cascades) {
+            if i >= tune::SMALL_CASTER_SLICES && c.radius < tune::SMALL_CASTER_RADIUS {
+                continue;
+            }
+            if slice.admits_sphere(&frame, c.center, c.radius) {
+                gpu.draws[i].push(EntityDraw {
+                    pipeline,
+                    mesh: c.mesh,
+                    inst,
+                    cut,
+                });
+            }
+        }
+    }
+    for d in gpu.draws.iter_mut() {
+        d.sort_unstable_by_key(|d| (d.pipeline.id(), d.cut, d.mesh));
+    }
+    if gpu.insts.is_empty() {
+        // The table is bound whatever the draws: one zero row keeps the binding valid.
+        gpu.insts.push([[0.0; 4]; 4]);
+    }
+    gpu.insts.write_buffer(&device, &queue);
+}
+
+/// The pass's bind groups and the map's layer views.
+fn prepare_shadow_binds(
+    frame: Res<ShadowFrame>,
+    pipes: Res<ShadowPipelines>,
+    mut gpu: ResMut<ShadowGpu>,
+    cache: Res<PipelineCache>,
+    device: Res<RenderDevice>,
+    images: Res<RenderAssets<GpuImage>>,
+    light: Option<Res<crate::lighting::SharedLightBuffer>>,
+) {
+    let gpu = &mut *gpu;
+    gpu.age += 1;
+    if gpu.age > 600 {
+        // Every ten seconds or so: let go of textures no batch cuts by any more.
+        gpu.cut_groups.clear();
+        gpu.age = 0;
+    }
+    if frame.cascades == 0 {
+        gpu.group0 = None;
+        return;
+    }
+    let (Some(light), Some(map), Some(insts)) =
+        (light, images.get(SHADOW_MAP.id()), gpu.insts.buffer())
+    else {
+        gpu.group0 = None;
+        return;
+    };
+    if gpu.layers_of != Some(map.texture.id()) {
+        gpu.layers = (0..map.size.depth_or_array_layers)
+            .map(|layer| {
+                map.texture.create_view(&TextureViewDescriptor {
+                    label: Some("look_shadow_layer"),
+                    dimension: Some(TextureViewDimension::D2),
+                    base_array_layer: layer,
+                    array_layer_count: Some(1),
+                    ..Default::default()
+                })
+            })
+            .collect();
+        gpu.layers_of = Some(map.texture.id());
+    }
+    let layout = cache.get_bind_group_layout(&pipes.group0);
+    gpu.group0 = Some(device.create_bind_group(
+        "look_shadow_group0",
+        &layout,
+        &BindGroupEntries::sequential((
+            BufferBinding {
+                buffer: &gpu.slices,
+                offset: 0,
+                size: std::num::NonZero::new(SLICE_BYTES),
+            },
+            light.0.as_entire_binding(),
+            insts.as_entire_binding(),
+        )),
+    ));
+    let cut_layout = cache.get_bind_group_layout(&pipes.cut_layout);
+    for draws in &gpu.draws {
+        for d in draws {
+            let Some(tex) = d.cut else { continue };
+            if gpu.cut_groups.contains_key(&tex) {
+                continue;
+            }
+            let Some(image) = images.get(tex) else {
+                continue;
+            };
+            gpu.cut_groups.insert(
+                tex,
+                device.create_bind_group(
+                    "look_shadow_cut",
+                    &cut_layout,
+                    &BindGroupEntries::sequential((&image.texture_view, &pipes.sampler)),
+                ),
+            );
+        }
+    }
+}
+
+#[derive(Debug, Hash, PartialEq, Eq, Clone, RenderLabel)]
+pub struct LookShadowLabel;
+
+#[derive(Default)]
+struct LookShadowNode;
+
+/// The passes' GPU spans, one a slice (`render/look_shadow_N/elapsed_gpu`, the fps journal's
+/// "other" column; `WOW_GPU_PASSES=1` names them).
+const SPANS: [&str; 4] = [
+    "look_shadow_0",
+    "look_shadow_1",
+    "look_shadow_2",
+    "look_shadow_3",
+];
+
+impl ViewNode for LookShadowNode {
+    type ViewQuery = &'static LookView;
+
+    fn run<'w>(
+        &self,
+        _graph: &mut RenderGraphContext,
+        render_context: &mut RenderContext<'w>,
+        _view: QueryItem<'w, '_, Self::ViewQuery>,
+        world: &'w World,
+    ) -> Result<(), NodeRunError> {
+        let frame = world.resource::<ShadowFrame>();
+        if frame.cascades == 0 {
+            return Ok(());
+        }
+        let gpu = world.resource::<ShadowGpu>();
+        let pipes = world.resource::<ShadowPipelines>();
+        let cache = world.resource::<PipelineCache>();
+        let Some(group0) = gpu.group0.as_ref() else {
+            return Ok(());
+        };
+        if gpu.layers.len() < frame.cascades {
+            return Ok(());
+        }
+        let statics = pipes.statics.and_then(|[solid, cut]| {
+            Some((
+                cache.get_render_pipeline(solid)?,
+                cache.get_render_pipeline(cut)?,
+            ))
+        });
+        let meshes = world.resource::<RenderAssets<RenderMesh>>();
+        let allocator = world.resource::<MeshAllocator>();
+        let res = frame.res as f32;
+        let stats = stats_armed();
+        let mut counts = [(0u32, 0u32); 4];
+        let diagnostics = render_context.diagnostic_recorder();
+        for c in 0..frame.cascades {
+            let mut pass = render_context.begin_tracked_render_pass(RenderPassDescriptor {
+                label: Some("look_shadow"),
+                color_attachments: &[],
+                depth_stencil_attachment: Some(RenderPassDepthStencilAttachment {
+                    view: &gpu.layers[c],
+                    depth_ops: Some(Operations {
+                        load: LoadOp::Clear(1.0),
+                        store: StoreOp::Store,
+                    }),
+                    stencil_ops: None,
+                }),
+                timestamp_writes: None,
+                occlusion_query_set: None,
+            });
+            let span = diagnostics.pass_span(&mut pass, SPANS[c]);
+            pass.set_viewport(0.0, 0.0, res, res, 0.0, 1.0);
+            pass.set_bind_group(0, group0, &[(c as u64 * SLICE_STRIDE) as u32]);
+            let slice = frame.slices[c];
+            if let Some((solid, cut)) = statics {
+                let admits = |center: Vec3, half: Vec3| slice.admits_box(frame, center, half);
+                let far = c >= tune::SMALL_CASTER_SLICES;
+                counts[c].0 = crate::static_gx::draw_shadow_casters(
+                    &mut pass, world, &admits, far, solid, cut,
+                );
+            }
+            let mut bound: Option<CachedRenderPipelineId> = None;
+            for d in &gpu.draws[c] {
+                if bound != Some(d.pipeline) {
+                    let Some(p) = cache.get_render_pipeline(d.pipeline) else {
+                        continue;
+                    };
+                    pass.set_render_pipeline(p);
+                    bound = Some(d.pipeline);
+                }
+                if let Some(tex) = d.cut {
+                    let Some(bg) = gpu.cut_groups.get(&tex) else {
+                        continue;
+                    };
+                    pass.set_bind_group(1, bg, &[]);
+                }
+                let Some(mesh) = meshes.get(d.mesh) else {
+                    continue;
+                };
+                let Some(vslice) = allocator.mesh_vertex_slice(&d.mesh) else {
+                    continue;
+                };
+                pass.set_vertex_buffer(0, vslice.buffer.slice(..));
+                match &mesh.buffer_info {
+                    RenderMeshBufferInfo::Indexed {
+                        index_format,
+                        count,
+                    } => {
+                        let Some(islice) = allocator.mesh_index_slice(&d.mesh) else {
+                            continue;
+                        };
+                        pass.set_index_buffer(islice.buffer.slice(..), *index_format);
+                        pass.draw_indexed(
+                            islice.range.start..islice.range.start + count,
+                            i32::try_from(vslice.range.start).unwrap_or(0),
+                            d.inst..d.inst + 1,
+                        );
+                    }
+                    RenderMeshBufferInfo::NonIndexed => {
+                        pass.draw(vslice.range.clone(), d.inst..d.inst + 1);
+                    }
+                }
+                counts[c].1 += 1;
+            }
+            span.end(&mut pass);
+        }
+        if stats {
+            report_stats(frame, &counts);
+        }
+        Ok(())
+    }
+}
+
+fn stats_armed() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var_os("WOW_SHADOW_STATS").is_some())
+}
+
+/// `WOW_SHADOW_STATS=1`: each slice's reach, texel and draws (static runs, entity meshes), once a
+/// second.
+fn report_stats(frame: &ShadowFrame, counts: &[(u32, u32); 4]) {
+    static LAST: std::sync::Mutex<Option<std::time::Instant>> = std::sync::Mutex::new(None);
+    let mut last = LAST.lock().unwrap_or_else(|e| e.into_inner());
+    if last.is_some_and(|t| t.elapsed().as_secs_f32() < 1.0) {
+        return;
+    }
+    *last = Some(std::time::Instant::now());
+    let mut line = format!(
+        "[shadows] {} slices at {} texels, strength {:.2}:",
+        frame.cascades, frame.res, frame.strength
+    );
+    for (i, (statics, entities)) in counts.iter().enumerate().take(frame.cascades) {
+        line += &format!(
+            " [{i}: to {:.0} yd, texel {:.3} yd, {statics} static runs, {entities} meshes]",
+            frame.splits[i], frame.slices[i].texel
+        );
+    }
+    eprintln!("{line}");
+}
+
+/// The main-world half: the frame's extract; the render half in [`finish`].
+pub(super) fn build(app: &mut App) {
+    app.add_plugins(ExtractResourcePlugin::<ShadowFrame>::default());
+}
+
+/// The render half, once the render app exists: the pipelines, the casters' extract, the prepares
+/// and the node, before the main pass (the static pass draws first in it and reads the map).
+pub(super) fn finish(app: &mut App) {
+    let Some(render_app) = app.get_sub_app_mut(RenderApp) else {
+        return;
+    };
+    render_app
+        .init_resource::<ShadowCasters>()
+        .init_resource::<ShadowGpu>()
+        .add_systems(RenderStartup, init_pipelines)
+        .add_systems(ExtractSchedule, extract_casters)
+        .add_systems(
+            Render,
+            (
+                prepare_shadows.in_set(RenderSystems::PrepareResources),
+                prepare_shadow_binds.in_set(RenderSystems::PrepareBindGroups),
+            ),
+        )
+        .add_render_graph_node::<ViewNodeRunner<LookShadowNode>>(Core3d, LookShadowLabel)
+        .add_render_graph_edges(
+            Core3d,
+            (Node3d::EndPrepasses, LookShadowLabel, Node3d::StartMainPass),
+        );
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// Solid and alpha-tested batches cast (the latter cut), translucent, additive, depth-less,
+    /// interior, clutter, rig-lane and sky ones never; a fading doodad's twin casts as its source.
+    #[test]
+    fn which_batches_cast() {
+        let tex: AssetId<Image> = AssetId::default();
+        let lit = Vec4::new(1.0, 0.0, 0.0, 0.0);
+        let law = |mode, markers: u32, flags: Vec4, clutter: f32, sun: Vec4| {
+            caster_law(
+                mode,
+                Some(tex),
+                Vec4::new(0.0, 0.0, markers as f32, clutter),
+                flags,
+                sun,
+            )
+        };
+        assert_eq!(law(AlphaMode::Opaque, 8, Vec4::ZERO, 0.0, lit), Some(None));
+        assert_eq!(
+            law(AlphaMode::Mask(0.5), 0, Vec4::ZERO, 0.0, lit),
+            Some(Some(tex))
+        );
+        assert_eq!(
+            law(AlphaMode::Blend, 0, Vec4::ZERO, 0.0, lit),
+            None,
+            "translucent"
+        );
+        assert_eq!(
+            law(AlphaMode::Add, 4, Vec4::ZERO, 0.0, lit),
+            None,
+            "additive"
+        );
+        for m in [1u32, 2, 0x80, 0x100, 0x200, 0x800, 0x2000] {
+            assert_eq!(
+                law(AlphaMode::Opaque, m, Vec4::ZERO, 0.0, lit),
+                None,
+                "marker {m:#x}"
+            );
+        }
+        let interior = Vec4::new(1.0, 0.0, 1.0, 0.0);
+        assert_eq!(
+            law(AlphaMode::Opaque, 0, interior, 0.0, lit),
+            None,
+            "interior"
+        );
+        assert_eq!(
+            law(AlphaMode::Mask(0.5), 0, Vec4::ZERO, 1.0, lit),
+            None,
+            "clutter"
+        );
+        let rig = Vec4::new(2.0, 0.0, 0.0, 0.0);
+        assert_eq!(
+            law(AlphaMode::Opaque, 0, Vec4::ZERO, 0.0, rig),
+            None,
+            "glue rig lane"
+        );
+        let twin = Vec4::new(0.0, 1.0, 0.0, 0.0);
+        assert_eq!(law(AlphaMode::Blend, 0, twin, 0.0, lit), Some(None));
+        assert_eq!(
+            law(AlphaMode::Blend, 0x400, twin, 0.0, lit),
+            Some(Some(tex))
+        );
+    }
+
+    /// The no-cast markers are exactly the bits `model_render` packs for no depth write, no depth
+    /// test, additive, Mod, Mod2x, the depth-prime twin, the far straddle copy and the sky.
+    #[test]
+    fn caster_markers() {
+        assert_eq!(
+            NO_CAST_MARKERS,
+            1 | 2
+                | 4
+                | 0x80
+                | 0x100
+                | u32::from(crate::model_render::ZFILL_MARKER)
+                | 0x800
+                | 0x2000
+        );
+        assert_eq!(TWIN_CUTOUT_MARKER, 0x400);
+    }
+
+    /// The instance row: the linear part's rows and the translation apart, the rig slot a float.
+    #[test]
+    fn the_instance_row_splits_the_transform() {
+        let gt = GlobalTransform::from(
+            Transform::from_xyz(-9000.0, 50.0, 120.0)
+                .with_rotation(Quat::from_rotation_y(0.5))
+                .with_scale(Vec3::splat(2.0)),
+        );
+        let rows = inst_rows(&gt, 37);
+        assert_eq!(rows[3], [-9000.0, 50.0, 120.0, 37.0]);
+        let p = Vec3::new(1.0, 2.0, 3.0);
+        let lin = Vec3::new(
+            Vec4::from(rows[0]).dot(p.extend(1.0)),
+            Vec4::from(rows[1]).dot(p.extend(1.0)),
+            Vec4::from(rows[2]).dot(p.extend(1.0)),
+        );
+        let want = gt.transform_point(p);
+        assert!((lin + Vec3::new(-9000.0, 50.0, 120.0) - want).length() < 1e-3);
+        let (c, r) = bounding_sphere(
+            &gt,
+            &Aabb {
+                center: Vec3::new(0.0, 1.0, 0.0).into(),
+                half_extents: Vec3::ONE.into(),
+            },
+        );
+        assert!((c - gt.transform_point(Vec3::Y)).length() < 1e-3);
+        assert!((r - 2.0 * 3f32.sqrt()).abs() < 1e-4);
+    }
+
+    /// The slices' uniform: each slice's rows at its stride, its frame and depth mapping.
+    #[test]
+    fn the_slice_uniform_packs_each_slice_at_its_stride() {
+        let frame = super::super::shadows::fit(
+            Vec3::ZERO,
+            Vec3::Z,
+            std::f32::consts::FRAC_PI_4,
+            1.5,
+            super::super::shadows::ShadowLight {
+                travel: Vec3::new(0.3, -0.8, 0.3).normalize(),
+                strength: 0.8,
+                fill: [0.0; 3],
+            },
+            4,
+            2048,
+            180.0,
+        );
+        let rows = slice_rows(&frame);
+        let stride = (SLICE_STRIDE / 4) as usize;
+        assert_eq!(rows.len(), 4 * stride);
+        for i in 0..4 {
+            let r = &rows[i * stride..];
+            assert_eq!(r[3], 1.0 / frame.slices[i].half);
+            assert_eq!(r[4], frame.slices[i].near);
+            assert_eq!(&r[16..19], &frame.travel.to_array());
+        }
+    }
+}
