+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// A to-body direction at `deg` above the horizon on the lighting sun's 45° bearing.
+    fn body(deg: f32) -> Vec3 {
+        let e = deg.to_radians();
+        let h = std::f32::consts::FRAC_1_SQRT_2;
+        Vec3::new(-e.cos() * h, e.sin(), -e.cos() * h)
+    }
+
+    /// The sun's shadows come in as it rises, short at noon, long and cool low; the moon's are
+    /// faint and neutral; nothing while neither is up.
+    #[test]
+    fn the_light_follows_the_sun_and_then_the_moon() {
+        let below = body(-5.0);
+        assert!(shadow_light(below, below).is_none(), "neither up");
+        let dawn = shadow_light(body(4.0), below).unwrap();
+        assert!(dawn.strength > 0.0 && dawn.strength < tune::DAY_STRENGTH);
+        let noon = shadow_light(body(85.0), below).unwrap();
+        assert_eq!(noon.strength, tune::DAY_STRENGTH);
+        assert!(noon.travel.y < -0.99, "near straight down: short");
+        let golden = shadow_light(body(14.0), below).unwrap();
+        assert!(golden.fill[2] > noon.fill[2] && golden.fill[2] > golden.fill[0]);
+        // A low sun's light is held at the floor, on the sun's own bearing.
+        let low = shadow_light(body(3.0), below).unwrap();
+        let held = (-low.travel.y).asin().to_degrees();
+        assert!((held - tune::MIN_ELEVATION_DEG).abs() < 1e-3, "{held}");
+        let flat = Vec2::new(low.travel.x, low.travel.z).normalize();
+        let h = std::f32::consts::FRAC_1_SQRT_2;
+        assert!((flat - Vec2::new(h, h)).length() < 1e-3, "{flat}");
+        let night = shadow_light(below, body(55.0)).unwrap();
+        assert_eq!(night.strength, tune::NIGHT_STRENGTH);
+        assert_eq!(night.fill, [0.0; 3]);
+        // Strength never steps as the sun climbs.
+        let mut last = 0.0;
+        for i in 0..200 {
+            let s = shadow_light(body(-2.0 + i as f32 * 0.1), below).map_or(0.0, |l| l.strength);
+            assert!(s >= last && s - last < 0.05, "{last} to {s}");
+            last = s;
+        }
+    }
+
+    /// The splits run from small to the reach; the sphere holds the whole slice.
+    #[test]
+    fn the_slices_split_the_reach_and_their_spheres_hold_them() {
+        let s = splits(4, 180.0);
+        assert!(s[0] < s[1] && s[1] < s[2] && s[2] < s[3]);
+        assert_eq!(s[3], 180.0);
+        assert!(s[0] < 20.0, "a sharp near slice: {s:?}");
+        let s2 = splits(2, 120.0);
+        assert_eq!(s2[1], 120.0);
+        let k = 0.85;
+        for (n, f) in [(0.0, 14.0), (14.0, 33.0), (33.0, 180.0)] {
+            let (c, r) = slice_sphere(n, f, k);
+            for (z, w) in [(n, n * k), (f, f * k)] {
+                let d = ((z - c) * (z - c) + w * w).sqrt();
+                assert!(d <= r + 1e-3, "corner at {z} outside: {d} > {r}");
+            }
+        }
+    }
+
+    fn frame_at(pos: Vec3, fwd: Vec3) -> ShadowFrame {
+        fit(
+            pos,
+            fwd,
+            std::f32::consts::FRAC_PI_4,
+            16.0 / 9.0,
+            shadow_light(body(30.0), body(-10.0)).unwrap(),
+            4,
+            2048,
+            180.0,
+        )
+    }
+
+    /// The slices' sizes never change as the camera turns, and their centres sit on the texel
+    /// grid, so a camera moving half a texel moves no shadow edge.
+    #[test]
+    fn the_fit_is_stable_as_the_camera_turns_and_moves() {
+        let at = Vec3::new(-9000.0, 60.0, 300.0);
+        let a = frame_at(at, Vec3::X);
+        let b = frame_at(at, Vec3::new(0.3, -0.2, 0.9).normalize());
+        for i in 0..4 {
+            assert_eq!(a.slices[i].half, b.slices[i].half, "slice {i}");
+            assert_eq!(a.slices[i].texel, b.slices[i].texel);
+        }
+        let c = frame_at(at + Vec3::new(0.001, 0.0, 0.0), Vec3::X);
+        for i in 0..4 {
+            let d = c.slices[i].center - a.slices[i].center;
+            let (x, y) = (d.dot(a.right), d.dot(a.up));
+            let t = a.slices[i].texel;
+            for v in [x, y] {
+                let off = (v / t - (v / t).round()).abs();
+                // f32 centres 9 000 yd out round by up to a 25th of slice 0's texel.
+                assert!(
+                    off < 0.1,
+                    "slice {i}: {v} is not a whole number of texels ({t})"
+                );
+            }
+        }
+        // The light's frame: right level, up toward the sky, both across the light.
+        assert!(a.right.y.abs() < 1e-6);
+        assert!(a.up.y > 0.0);
+        assert!(a.right.dot(a.travel).abs() < 1e-5 && a.up.dot(a.travel).abs() < 1e-5);
+    }
+
+    /// Every point the camera sees within a slice's depths sits in its box, and a caster up to
+    /// the reach sunward of it too.
+    #[test]
+    fn a_slice_holds_what_it_sees_and_its_casters() {
+        let at = Vec3::new(100.0, 20.0, -40.0);
+        let f = frame_at(at, Vec3::Z);
+        for i in 0..4 {
+            let s = f.slices[i];
+            let z = 0.5 * (if i == 0 { 0.0 } else { f.splits[i - 1] } + f.splits[i]);
+            let p = at + Vec3::Z * z;
+            assert!(s.admits_sphere(&f, p, 0.0), "slice {i} misses its own view");
+            let caster = p - f.travel * (tune::CASTER_REACH * 0.9);
+            assert!(
+                s.admits_sphere(&f, caster, 0.0),
+                "slice {i} drops a sunward caster"
+            );
+            let behind = p - f.travel * (tune::CASTER_REACH + 3.0 * s.half);
+            assert!(!s.admits_sphere(&f, behind, 0.0));
+            assert!(s.admits_box(&f, p, Vec3::splat(0.5)));
+        }
+    }
+
+    /// The rows: none packs zero; a frame packs its slices, splits and frame.
+    #[test]
+    fn the_rows_pack_the_frame() {
+        assert_eq!(pack_rows(&ShadowFrame::default()), [[0.0; 4]; SHADOW_ROWS]);
+        let f = frame_at(Vec3::ZERO, Vec3::Z);
+        let rows = pack_rows(&f);
+        assert_eq!(rows[0][0], 4.0);
+        assert_eq!(rows[0][3], 180.0);
+        assert_eq!(rows[1], f.splits);
+        assert_eq!(rows[2][3], 2048.0);
+        assert_eq!(rows[3][3], 1.0, "high's filter");
+        assert_eq!(rows[6][3], 1.0 / f.slices[0].half);
+        assert_eq!(rows[7][2], f.slices[0].texel);
+        assert_eq!(rows[13][3], f32::MAX, "the last slice blends into nothing");
+        let none = ShadowFrame { strength: 0.0, ..f };
+        assert_eq!(pack_rows(&none), [[0.0; 4]; SHADOW_ROWS]);
+    }
+
+    /// `lookshadow`: a scale and an optional reach, `grade` or nothing to let go; anything out of
+    /// range is refused. `worldShadows` reads as a level.
+    #[test]
+    fn the_console_and_the_cvar_parse() {
+        assert_eq!(LookShadows::parse("1.5"), Some((Some(1.5), None)));
+        assert_eq!(LookShadows::parse("0 250"), Some((Some(0.0), Some(250.0))));
+        assert_eq!(LookShadows::parse(""), Some((None, None)));
+        assert_eq!(LookShadows::parse("Grade"), Some((None, None)));
+        assert_eq!(LookShadows::parse("3"), None);
+        assert_eq!(LookShadows::parse("1 10"), None);
+        assert_eq!(LookShadows::parse("1 200 x"), None);
+        assert_eq!(LookShadows::parse("dark"), None);
+        assert_eq!(LookShadows::level_of(0.0), 0);
+        assert_eq!(LookShadows::level_of(1.0), 1);
+        assert_eq!(LookShadows::level_of(2.0), 2);
+        assert_eq!(LookShadows::level_of(7.0), 2);
+        let low = LookShadows::default();
+        assert_eq!(low.layout(), Some((2, 1024)));
+        assert_eq!(low.distance(), tune::DISTANCE_LOW);
+        let high = LookShadows { level: 2, ..low };
+        assert_eq!(high.layout(), Some((4, 2048)));
+        assert_eq!(LookShadows { level: 0, ..low }.layout(), None);
+    }
+
+    /// The blob goes as the real shadow comes in, and stays whole with none.
+    #[test]
+    fn the_blob_gives_way_to_the_real_shadow() {
+        assert_eq!(ShadowFrame::default().blob_weight(), 1.0);
+        let f = frame_at(Vec3::ZERO, Vec3::Z);
+        assert_eq!(f.blob_weight(), 0.0);
+        let faint = ShadowFrame {
+            strength: tune::BLOB_GONE_AT * 0.5,
+            ..f
+        };
+        assert!((faint.blob_weight() - 0.5).abs() < 1e-6);
+    }
+}
