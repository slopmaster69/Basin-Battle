+// One texel's compare: 1 where the receiver depth `z` is at or before the stored caster.
+fn shadow_texel(c: vec2<i32>, layer: i32, z: f32, lim: i32) -> f32 {
+    let t = clamp(c, vec2<i32>(0), vec2<i32>(lim));
+    return select(0.0, 1.0, z <= textureLoad(shadow_map, t, layer, 0));
+}
