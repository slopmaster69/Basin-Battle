--- /dev/null
+++ b/crates/benilla-world/src/shaders/world_shadow.wgsl
@@ -0,0 +1,179 @@
+// The new look's sun-shadow casters (`look::shadow_pass`), benilla's own: depth only, into one
+// layer of the shadow map per slice, in the light's orthographic frame. Three kinds of draw, by
+// shader def:
+//   SHADOW_STATIC: the retained static world (`static_gx`): its baked vertex layout and per-cell
+//     bind group (origin, records, texture array), the same as `static_gx.wgsl`'s;
+//   otherwise an entity mesh (creatures, heroes, objects, fading doodads, terrain), its transform
+//     from the pass's instance table, SHADOW_SKIN skinning it from the shared palette as
+//     `wow_model.wgsl` does;
+//   SHADOW_CUTOUT: an alpha-tested batch (leaves), cut at 1.12's 224/255 by its texture.
+// The receivers read what this writes with `sun_shadow` (terrain.wgsl, wow_model.wgsl,
+// static_gx.wgsl), whose slice mapping this mirrors.
+
+// One slice's frame, at a dynamic offset per slice (`ShadowSliceUniform`).
+struct ShadowSlice {
+    centre: vec4<f32>, // xyz the snapped centre, w 1/half-size
+    depth: vec4<f32>,  // x near (light-axis offset of the near face), y 1/range
+    right: vec4<f32>,
+    up: vec4<f32>,
+    travel: vec4<f32>,
+}
+@group(0) @binding(0) var<uniform> slice: ShadowSlice;
+
+// The shared light buffer's layout up to the skin palettes, as `wow_model.wgsl` declares it; only
+// the rig regions are read here. Keep in sync with `lighting::global_light`.
+struct WowLight {
+    _head: array<vec4<f32>, 21>,
+    _points: array<vec4<f32>, 512>,
+    _look_lights: array<vec4<f32>, 48>,
+    _shadow: array<vec4<f32>, 14>,
+    _prop_probes: array<vec4<f32>, 57344>,
+    rig_table: array<u32, 2048>,
+    _rig_tint: array<u32, 2048>,
+    rig_origin: array<vec4<f32>, 2048>,
+    _matanim: array<vec4<f32>, 2048>,
+    _water_clip: array<vec2<f32>, 2048>,
+    palettes: array<vec4<f32>>,
+}
+@group(0) @binding(1) var<storage, read> wow_light: WowLight;
+
+// Per entity draw: the rows of its world matrix's linear part (w 0) and its translation, apart for
+// f32 precision at 9 000 yd; `origin.w` is the rig slot (bits), read under SHADOW_SKIN.
+struct ShadowInst {
+    row0: vec4<f32>,
+    row1: vec4<f32>,
+    row2: vec4<f32>,
+    origin: vec4<f32>,
+}
+@group(0) @binding(2) var<storage, read> insts: array<ShadowInst>;
+
+// The alpha-test reference, as wow_model.wgsl's VANILLA_ALPHA_KEY.
+const VANILLA_ALPHA_KEY: f32 = 0.8784314;
+
+#ifdef SHADOW_STATIC
+struct GxCell {
+    origin: vec4<f32>,
+}
+@group(1) @binding(0) var<uniform> cell: GxCell;
+@group(1) @binding(1) var<storage, read> recs: array<vec4<u32>>;
+@group(1) @binding(2) var tex_array: texture_2d_array<f32>;
+@group(1) @binding(3) var samp_repeat: sampler;
+@group(1) @binding(4) var samp_clamp: sampler;
+
+// static_gx/mod.rs WORD_* (keep in sync).
+const WORD_INTERIOR: u32 = 8388608u; // 1 << 23
+
+struct CasterVertex {
+    @location(0) position: vec3<f32>,
+    @location(2) uv: vec2<f32>,
+    @location(3) word: u32,
+}
+#else
+#ifdef SHADOW_CUTOUT
+@group(1) @binding(0) var cut_texture: texture_2d<f32>;
+@group(1) @binding(1) var cut_sampler: sampler;
+#endif
+
+struct CasterVertex {
+    @builtin(instance_index) instance_index: u32,
+    @location(0) position: vec3<f32>,
+#ifdef SHADOW_CUTOUT
+    @location(2) uv: vec2<f32>,
+#endif
+#ifdef SHADOW_SKIN
+    @location(10) joint_indices: vec4<u32>,
+    @location(11) joint_weights: vec4<f32>,
+#endif
+}
+#endif
+
+struct CasterOut {
+    @builtin(position) position: vec4<f32>,
+    @location(0) uv: vec2<f32>,
+    @location(1) @interpolate(flat) layer: i32,
+}
+
+// `d`, a point relative to the slice's centre, to the slice's clip space. A caster nearer the
+// light than the near face is flattened onto it (no near clip), so it still shades.
+fn slice_clip(d: vec3<f32>) -> vec4<f32> {
+    let x = dot(d, slice.right.xyz) * slice.centre.w;
+    let y = dot(d, slice.up.xyz) * slice.centre.w;
+    let z = (dot(d, slice.travel.xyz) - slice.depth.x) * slice.depth.y;
+    return vec4<f32>(x, y, max(z, 0.0), 1.0);
+}
+
+#ifdef SHADOW_SKIN
+// wow_model.wgsl's `wow_skin_model`: the four weighted bones' palette rows blended.
+fn skin_model(slot: u32, indices: vec4<u32>, weights: vec4<f32>) -> mat4x4<f32> {
+    let base = wow_light.rig_table[slot];
+    let b0 = 3u * (base + indices.x);
+    let b1 = 3u * (base + indices.y);
+    let b2 = 3u * (base + indices.z);
+    let b3 = 3u * (base + indices.w);
+    let r0 = weights.x * wow_light.palettes[b0] + weights.y * wow_light.palettes[b1]
+        + weights.z * wow_light.palettes[b2] + weights.w * wow_light.palettes[b3];
+    let r1 = weights.x * wow_light.palettes[b0 + 1u] + weights.y * wow_light.palettes[b1 + 1u]
+        + weights.z * wow_light.palettes[b2 + 1u] + weights.w * wow_light.palettes[b3 + 1u];
+    let r2 = weights.x * wow_light.palettes[b0 + 2u] + weights.y * wow_light.palettes[b1 + 2u]
+        + weights.z * wow_light.palettes[b2 + 2u] + weights.w * wow_light.palettes[b3 + 2u];
+    return mat4x4<f32>(
+        vec4<f32>(r0.x, r1.x, r2.x, 0.0),
+        vec4<f32>(r0.y, r1.y, r2.y, 0.0),
+        vec4<f32>(r0.z, r1.z, r2.z, 0.0),
+        vec4<f32>(r0.w, r1.w, r2.w, 1.0),
+    );
+}
+#endif
+
+@vertex
+fn vs_main(v: CasterVertex) -> CasterOut {
+    var out: CasterOut;
+    out.uv = vec2<f32>(0.0);
+    out.layer = 0;
+#ifdef SHADOW_STATIC
+    let rec = recs[v.word & 0xffffu];
+    // A killed item (exiled to the entity path, which casts it) and the inside of a building
+    // (interior WMO groups and their props: no sun reaches them) collapse to nothing.
+    if ((rec.w & 1u) != 0u || (v.word & WORD_INTERIOR) != 0u) {
+        out.position = vec4<f32>(0.0, 0.0, 2.0, 1.0);
+        return out;
+    }
+    out.position = slice_clip(v.position + (cell.origin.xyz - slice.centre.xyz));
+    out.uv = v.uv;
+    out.layer = i32(rec.x);
+#else
+    let inst = insts[v.instance_index];
+#ifdef SHADOW_SKIN
+    let slot = bitcast<u32>(inst.origin.w);
+    let m = skin_model(slot, v.joint_indices, v.joint_weights);
+    let p = (m * vec4<f32>(v.position, 1.0)).xyz + (wow_light.rig_origin[slot].xyz - slice.centre.xyz);
+#else
+    let p4 = vec4<f32>(v.position, 1.0);
+    let p = vec3<f32>(dot(inst.row0, p4), dot(inst.row1, p4), dot(inst.row2, p4))
+        + (inst.origin.xyz - slice.centre.xyz);
+#endif
+    out.position = slice_clip(p);
+#ifdef SHADOW_CUTOUT
+    out.uv = v.uv;
+#endif
+#endif
+    return out;
+}
+
+// Only an alpha-tested batch has a fragment stage; an opaque one writes depth alone. The texture's
+// level follows the shadow map's own texel, so a far slice's leaves thin as they do on screen.
+@fragment
+fn fs_cutout(in: CasterOut) {
+#ifdef SHADOW_STATIC
+    let a = textureSample(tex_array, samp_repeat, in.uv, in.layer).a;
+#else
+#ifdef SHADOW_CUTOUT
+    let a = textureSample(cut_texture, cut_sampler, in.uv).a;
+#else
+    let a = 1.0;
+#endif
+#endif
+    if (a < VANILLA_ALPHA_KEY) {
+        discard;
+    }
+}
