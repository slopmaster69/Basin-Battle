+/// The new look's sun-shadow map (`benilla_world::look::shadows`), one depth layer per slice, which
+/// the terrain and model materials bind at 112 and read with `textureLoad` alone, so it spends no
+/// sampler. A fixed handle, so every material names it without plumbing; the world inserts the
+/// image ([`shadow_map_image`]) at startup, and the shadow pass draws into it.
+pub const SHADOW_MAP: Handle<Image> =
+    bevy::asset::uuid_handle!("5ad0a0e1-0065-4c0a-9e5b-5ad0a0e10065");
+
+/// [`SHADOW_MAP`]'s image: `size` square, `layers` deep, 16-bit depth (a slice's depth range is a
+/// few hundred yards, so a step is under a centimetre), uninitialised (the pass clears what it
+/// draws, and no shader reads it until the pass has), render-world only.
+pub fn shadow_map_image(size: u32, layers: u32) -> Image {
+    use bevy::asset::RenderAssetUsages;
+    use bevy::render::render_resource::{
+        Extent3d, TextureDimension, TextureFormat, TextureUsages, TextureViewDescriptor,
+        TextureViewDimension,
+    };
+    let mut image = Image::new_uninit(
+        Extent3d {
+            width: size,
+            height: size,
+            depth_or_array_layers: layers,
+        },
+        TextureDimension::D2,
+        TextureFormat::Depth16Unorm,
+        RenderAssetUsages::RENDER_WORLD,
+    );
+    image.texture_descriptor.label = Some("look_shadow_map");
+    image.texture_descriptor.usage =
+        TextureUsages::TEXTURE_BINDING | TextureUsages::RENDER_ATTACHMENT;
+    image.texture_view_descriptor = Some(TextureViewDescriptor {
+        label: Some("look_shadow_map_array"),
+        dimension: Some(TextureViewDimension::D2Array),
+        ..Default::default()
+    });
+    image
+}
