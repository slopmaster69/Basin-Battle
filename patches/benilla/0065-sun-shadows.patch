+/// `lookshadow <strength> [distance]`, benilla's own (1.12 has no such command): holds the new
+/// look's sun shadows (`benilla_world::look::shadows`) at a multiple of the hour's strength, 0 to
+/// 2 (0 none, 1 the hour's own; a full shadow never takes more than all the sun), and optionally
+/// their reach in yards, for tuning on film; `lookshadow grade`, or no argument, lets the hour
+/// decide again. `worldShadows 0` and the classic look (`worldLook 0`) have none either way.
+fn look_shadow(world: &mut World, args: &str) -> Vec<String> {
+    use benilla_world::look::{LookShadows, WorldLook};
+    let Some((scale, distance)) = LookShadows::parse(args) else {
+        return vec!["Usage: lookshadow <strength 0-2> [distance 30-400] | grade".to_string()];
+    };
+    let level = {
+        let mut shadows = world.get_resource_or_init::<LookShadows>();
+        shadows.scale = scale;
+        shadows.distance = distance;
+        shadows.level
+    };
+    let mut lines = vec![match (scale, distance) {
+        (None, _) => "Sun shadows follow the hour.".to_string(),
+        (Some(s), None) => format!("Sun shadows held at {s} times the hour's."),
+        (Some(s), Some(d)) => format!("Sun shadows held at {s} times the hour's, out to {d} yd."),
+    }];
+    if level == 0 {
+        lines.push("worldShadows is 0: no sun shadows.".to_string());
+    }
+    if !world.get_resource::<WorldLook>().is_some_and(|l| l.on) {
+        lines.push("The classic look (worldLook 0) has no sun shadows.".to_string());
+    }
+    lines
+}
