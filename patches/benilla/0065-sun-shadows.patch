+//! Sun shadows, the new look's own (no reference behaviour): trees, buildings, fences, carts,
+//! creatures and heroes cast real shadows from the sun, and faintly from the moon at night, onto
+//! the ground, the buildings and each other. 1.12 has only the baked terrain shadow (MCSH) and a
+//! blob under a unit; WoW Forever's biggest step in depth after its light is this.
+//!
+//! Cascaded shadow maps, benilla's own pass, since Bevy's `DirectionalLight` shadows reach only
+//! its PBR shaders and draw only its own meshes, where most of the world here is the retained
+//! static pass (`static_gx`):
+//! 1. **the light** ([`shadow_light`]): the visible sun (`WowLighting::celestial_dir`, which rises
+//!    about 06:10 and sets about 20:20 on the lighting sun's own bearing), or the white moon by
+//!    night, its elevation held to at least [`tune::MIN_ELEVATION_DEG`] so a low sun's shadows
+//!    stay finite, and its strength faded in and out as the body crosses the horizon;
+//! 2. **the fit** ([`fit`]): the view out to [`LookShadows::distance`] cut into two (low) or four
+//!    (high) slices, each wrapped in a sphere so its size never changes as the camera turns, and
+//!    its centre snapped to the map's texel grid in the light's frame, so shadows never swim as the
+//!    camera moves;
+//! 3. **the pass** (`look::shadow_pass`): a depth-only draw of the casters into one layer of
+//!    [`benilla_assets::materials::SHADOW_MAP`] per slice, before the main pass: the static
+//!    world's doodads, WMO exteriors and props, every creature, hero and object model, and the
+//!    terrain, each culled per slice, with alpha-tested leaves cut by their texture;
+//! 4. **the receivers** (`terrain.wgsl`, `wow_model.wgsl`, `static_gx.wgsl`, `sun_shadow`): the
+//!    packed rows ([`pack_rows`], the shared light buffer's shadow block) pick a slice by eye
+//!    depth, filter the map by hand (`textureLoad`, no sampler: Metal's sixteen are spoken for),
+//!    soft and softer the further a shadow falls from its caster on high, and take away only the
+//!    sun's share of a pixel's light, never the ambient, with a little cool fill in its place at
+//!    golden hour. Interiors take none.
+//!
+//! Every tunable is in [`tune`]. `worldShadows` (0 off, 1 low, 2 high; [`LookShadows::level`])
+//! switches them on their own; `lookshadow <strength> [distance]` holds them for film.
+//! `worldLook 0` packs no shadow block, and every shader then runs 1.12's path untouched.
+
+use bevy::prelude::*;
+use bevy::render::extract_resource::ExtractResource;
+
+use super::WorldLook;
+
+/// Every tunable of the sun shadows, in one place. A first pass, to tune on film with
+/// `lookshadow`. Lengths are yards, angles degrees, strengths the share of the sun's light a full
+/// shadow takes away.
+pub mod tune {
+    /// How far from the camera shadows reach, by level: low keeps its two slices tighter.
+    pub const DISTANCE_LOW: f32 = 120.0;
+    pub const DISTANCE_HIGH: f32 = 180.0;
+    /// The reach `lookshadow` takes.
+    pub const DISTANCE_MIN: f32 = 30.0;
+    pub const DISTANCE_MAX: f32 = 400.0;
+    /// Slices and the texels a slice's side takes, by level (low, high). The map is always
+    /// [`MAP_SIZE`] square with [`MAP_LAYERS`] layers; low uses a corner of each.
+    pub const CASCADES_LOW: usize = 2;
+    pub const CASCADES_HIGH: usize = 4;
+    pub const RES_LOW: u32 = 1024;
+    pub const RES_HIGH: u32 = 2048;
+    pub const MAP_SIZE: u32 = 2048;
+    pub const MAP_LAYERS: u32 = 4;
+    /// Where the first slice starts, and the split law: this share logarithmic, the rest even, so
+    /// the near slice is small and sharp and the far ones cover the distance.
+    pub const NEAR: f32 = 1.0;
+    pub const SPLIT_LAMBDA: f32 = 0.75;
+    /// The last share of the reach over which shadows fade to none, and the share of each slice
+    /// over which it blends into the next, so neither edge shows as a line.
+    pub const FADE: f32 = 0.15;
+    pub const BLEND: f32 = 0.1;
+    /// How far toward the light a slice's box reaches past its sphere: a caster up to this far
+    /// sunward still shades what the slice sees (a tall tree's shadow under a low sun).
+    pub const CASTER_REACH: f32 = 150.0;
+
+    /// The lowest a shadow's light stands: below it the body's height is held here, so a rising
+    /// sun's first shadows are long, about six times a caster's height, never endless.
+    pub const MIN_ELEVATION_DEG: f32 = 10.0;
+    /// A body's shadows come in over this band of its true elevation as it rises, and go as it
+    /// sets: the sun's from about 06:15 to 06:45, the moon's after about 22:20.
+    pub const RISE_FROM_DEG: f32 = 1.0;
+    pub const RISE_TO_DEG: f32 = 8.0;
+    /// How much of the sun's light a full shadow takes away by day: not all, so a shadow stays
+    /// painterly and keeps a little of the day in it, never a black cut-out.
+    pub const DAY_STRENGTH: f32 = 0.85;
+    /// By night the moon's: faint.
+    pub const NIGHT_STRENGTH: f32 = 0.4;
+    /// The cool fill a shadow takes in place of the sun it loses, per unit of the light taken
+    /// (its luminance): the blue sky lighting the shade. Full at and below
+    /// [`COOL_FULL_DEG`] of the sun's elevation (golden hour, dawn), [`COOL_NOON`] of it from
+    /// [`COOL_NONE_DEG`] up; none by night.
+    pub const COOL: [f32; 3] = [0.06, 0.12, 0.30];
+    pub const COOL_FULL_DEG: f32 = 15.0;
+    pub const COOL_NONE_DEG: f32 = 45.0;
+    pub const COOL_NOON: f32 = 0.3;
+
+    /// The receiver's push off its surface along its normal, in texels of its slice, more as the
+    /// surface turns from the light, and its depth bias, so a lit surface never shades itself.
+    /// The pass adds a slope bias of its own ([`RASTER_SLOPE_BIAS`], [`RASTER_CONSTANT_BIAS`]).
+    pub const NORMAL_OFFSET_TEXELS: f32 = 1.5;
+    pub const DEPTH_BIAS_TEXELS: f32 = 1.0;
+    pub const RASTER_CONSTANT_BIAS: i32 = 4;
+    pub const RASTER_SLOPE_BIAS: f32 = 2.0;
+    /// Low's filter: a fixed disk this many texels wide (six bilinear taps).
+    pub const PCF_LOW_TEXELS: f32 = 1.5;
+    /// High's: a shadow softens with the distance from its caster, `PENUMBRA` yards for each yard
+    /// (a sun about two degrees wide, wider than the real one's half, for the painterly edge),
+    /// searched over [`BLOCKER_SEARCH`] yards, and filtered between these many texels (ten
+    /// bilinear taps).
+    pub const PENUMBRA: f32 = 0.035;
+    pub const BLOCKER_SEARCH: f32 = 0.6;
+    pub const PCF_MIN_TEXELS: f32 = 1.0;
+    pub const PCF_MAX_TEXELS: f32 = 10.0;
+
+    /// A caster smaller than this (its bounding radius) draws only in the first slices: a pebble
+    /// 100 yd off casts nothing anyone can see.
+    pub const SMALL_CASTER_RADIUS: f32 = 0.8;
+    pub const SMALL_CASTER_SLICES: usize = 2;
+    /// A skinned body's box is its bind pose's; this much more covers a swing or a stride.
+    pub const SKINNED_MARGIN: f32 = 1.5;
+    /// 1.12's blob under a unit fades out as the real shadow comes in: gone once a full shadow
+    /// takes this much of the sun.
+    pub const BLOB_GONE_AT: f32 = 0.5;
+    /// The most `lookshadow` scales the hour's strength by (the product never passes 1).
+    pub const SCALE_MAX: f32 = 2.0;
+}
+
+/// Rows the shadow block takes in the shared light buffer (`global_light::LightStd430::shadow`),
+/// mirrored as `shadow: array<vec4<f32>, 14>` in the three receiving shaders and
+/// `world_shadow.wgsl`; keep in sync:
+///   0 `[slices (0 none), strength, fade start, reach]` (eye depth, yd) ·
+///   1 each slice's far split (eye depth) ·
+///   2 `[right.xyz, texels a side]` · 3 `[up.xyz, filter: 0 low, 1 high]` ·
+///   4 `[travel.xyz, normal offset (texels)]` · 5 `[cool fill rgb, depth bias (texels)]` ·
+///   6.. two rows a slice: `[centre.xyz, 1/half-size]`, `[near, 1/depth range, texel (yd), blend
+///   start (eye depth)]`.
+pub const SHADOW_ROWS: usize = 6 + 2 * tune::MAP_LAYERS as usize;
+
+/// `worldShadows` and the film's hold: `level` 0 off, 1 low, 2 high (inert under the classic
+/// look); `scale` holds the strength at a multiple of the hour's (`lookshadow <strength>`),
+/// `distance` the reach.
+#[derive(Resource, Clone, Copy, Debug, PartialEq)]
+pub struct LookShadows {
+    pub level: u8,
+    pub scale: Option<f32>,
+    pub distance: Option<f32>,
+}
+
+impl Default for LookShadows {
+    /// Low, the `worldShadows` CVar's registered "1".
+    fn default() -> Self {
+        Self {
+            level: 1,
+            scale: None,
+            distance: None,
+        }
+    }
+}
+
+impl LookShadows {
+    /// `worldShadows`' value as a level: 0, 1 or 2, anything above high reading as high.
+    pub fn level_of(v: f32) -> u8 {
+        if v >= 1.5 {
+            2
+        } else if v >= 0.5 {
+            1
+        } else {
+            0
+        }
+    }
+
+    /// The reach this level uses, unless held.
+    pub fn distance(&self) -> f32 {
+        self.distance.unwrap_or(if self.level >= 2 {
+            tune::DISTANCE_HIGH
+        } else {
+            tune::DISTANCE_LOW
+        })
+    }
+
+    /// `(slices, texels a side)` at this level; `None` off.
+    pub fn layout(&self) -> Option<(usize, u32)> {
+        match self.level {
+            0 => None,
+            1 => Some((tune::CASCADES_LOW, tune::RES_LOW)),
+            _ => Some((tune::CASCADES_HIGH, tune::RES_HIGH)),
+        }
+    }
+
+    /// `lookshadow`'s arguments: a strength scale from 0 to [`tune::SCALE_MAX`] and an optional
+    /// reach from [`tune::DISTANCE_MIN`] to [`tune::DISTANCE_MAX`], or nothing (or `grade`) to
+    /// follow the hour again; `None` for anything else, which changes nothing.
+    pub fn parse(args: &str) -> Option<(Option<f32>, Option<f32>)> {
+        let mut words = args.split_whitespace();
+        let first = match words.next() {
+            None => return Some((None, None)),
+            Some(w) if w.eq_ignore_ascii_case("grade") => {
+                return words.next().is_none().then_some((None, None));
+            }
+            Some(w) => w,
+        };
+        let scale = first
+            .parse::<f32>()
+            .ok()
+            .filter(|v| (0.0..=tune::SCALE_MAX).contains(v))?;
+        let distance = match words.next() {
+            None => None,
+            Some(w) => Some(
+                w.parse::<f32>()
+                    .ok()
+                    .filter(|v| (tune::DISTANCE_MIN..=tune::DISTANCE_MAX).contains(v))?,
+            ),
+        };
+        words.next().is_none().then_some((Some(scale), distance))
+    }
+}
+
+/// The shadows' light this frame: the direction it travels (Bevy space, downward), how much of the
+/// sun's light a full shadow takes away, and the cool fill a shadow takes in its place.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct ShadowLight {
+    pub travel: Vec3,
+    pub strength: f32,
+    pub fill: [f32; 3],
+}
+
+fn smoothstep(e0: f32, e1: f32, x: f32) -> f32 {
+    let t = ((x - e0) / (e1 - e0)).clamp(0.0, 1.0);
+    t * t * (3.0 - 2.0 * t)
+}
+
+/// A body's elevation above the horizon in degrees, from its camera-to-body direction.
+fn elevation_deg(to_body: Vec3) -> f32 {
+    to_body
+        .normalize_or_zero()
+        .y
+        .clamp(-1.0, 1.0)
+        .asin()
+        .to_degrees()
+}
+
+/// The direction a body's light travels with its elevation held to at least
+/// [`tune::MIN_ELEVATION_DEG`], on its own bearing.
+fn held_travel(to_body: Vec3) -> Vec3 {
+    let flat = Vec2::new(to_body.x, to_body.z);
+    let flat = if flat.length_squared() > 1e-12 {
+        flat.normalize()
+    } else {
+        Vec2::X
+    };
+    let e = elevation_deg(to_body)
+        .clamp(tune::MIN_ELEVATION_DEG, 89.0)
+        .to_radians();
+    -Vec3::new(flat.x * e.cos(), e.sin(), flat.y * e.cos())
+}
+
+/// The shadows' light from the visible sun and the white moon (camera to body, Bevy space): the sun
+/// while it is up, else the moon, each fading in over [`tune::RISE_FROM_DEG`] to
+/// [`tune::RISE_TO_DEG`] of its true elevation; `None` while neither is up.
+pub fn shadow_light(sun: Vec3, moon: Vec3) -> Option<ShadowLight> {
+    let sun_e = elevation_deg(sun);
+    if sun_e > tune::RISE_FROM_DEG {
+        let rise = smoothstep(tune::RISE_FROM_DEG, tune::RISE_TO_DEG, sun_e);
+        let golden = 1.0 - smoothstep(tune::COOL_FULL_DEG, tune::COOL_NONE_DEG, sun_e);
+        let cool = tune::COOL_NOON + (1.0 - tune::COOL_NOON) * golden;
+        return Some(ShadowLight {
+            travel: held_travel(sun),
+            strength: tune::DAY_STRENGTH * rise,
+            fill: tune::COOL.map(|c| c * cool),
+        });
+    }
+    let moon_e = elevation_deg(moon);
+    (moon_e > tune::RISE_FROM_DEG).then(|| ShadowLight {
+        travel: held_travel(moon),
+        strength: tune::NIGHT_STRENGTH * smoothstep(tune::RISE_FROM_DEG, tune::RISE_TO_DEG, moon_e),
+        fill: [0.0; 3],
+    })
+}
+
+/// One slice's box in the light's frame: the snapped centre of its sphere, its half-size, the
+/// depth range along the light (from `near` to the sphere's far side) and its texel in yards.
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub struct Cascade {
+    pub center: Vec3,
+    pub half: f32,
+    /// Light-axis distance from the centre to the box's near face (negative: toward the light).
+    pub near: f32,
+    pub range: f32,
+    pub texel: f32,
+    /// The eye depth this slice starts blending into the next from.
+    pub blend_from: f32,
+}
+
+impl Cascade {
+    /// Whether a sphere at `center` of `radius` reaches this slice's box, along the light's axes.
+    pub fn admits_sphere(&self, frame: &ShadowFrame, center: Vec3, radius: f32) -> bool {
+        let d = center - self.center;
+        let x = d.dot(frame.right);
+        let y = d.dot(frame.up);
+        let z = d.dot(frame.travel);
+        x.abs() <= self.half + radius
+            && y.abs() <= self.half + radius
+            && z >= self.near - radius
+            && z <= self.half + radius
+    }
+
+    /// Whether a world box (`center`, `half_extents` along the world axes) reaches this slice's.
+    pub fn admits_box(&self, frame: &ShadowFrame, center: Vec3, half: Vec3) -> bool {
+        let ext = |axis: Vec3| axis.abs().dot(half);
+        let d = center - self.center;
+        let (x, y, z) = (d.dot(frame.right), d.dot(frame.up), d.dot(frame.travel));
+        let (ex, ey, ez) = (ext(frame.right), ext(frame.up), ext(frame.travel));
+        x.abs() <= self.half + ex
+            && y.abs() <= self.half + ey
+            && z + ez >= self.near
+            && z - ez <= self.half
+    }
+}
+
+/// This frame's shadows, from the light packer (`global_light::build_light_data`) to the pass
+/// (`look::shadow_pass`), which draws exactly what the receivers will read. `cascades == 0` is
+/// none: off, the classic look, no body up, or no camera.
+#[derive(Resource, Clone, Copy, Debug, Default, PartialEq, ExtractResource)]
+pub struct ShadowFrame {
+    pub cascades: usize,
+    /// Texels a slice's side takes in the map.
+    pub res: u32,
+    /// High's filter (soft with distance) or low's (fixed).
+    pub high: bool,
+    pub strength: f32,
+    pub fill: [f32; 3],
+    /// The light's frame: across, up and along the direction it travels.
+    pub right: Vec3,
+    pub up: Vec3,
+    pub travel: Vec3,
+    pub splits: [f32; 4],
+    pub distance: f32,
+    pub slices: [Cascade; 4],
+}
+
+impl ShadowFrame {
+    /// The blob weight under a unit: 1.12's whole blob with no real shadow, none once a full
+    /// shadow takes [`tune::BLOB_GONE_AT`] of the sun.
+    pub fn blob_weight(&self) -> f32 {
+        if self.cascades == 0 {
+            1.0
+        } else {
+            1.0 - (self.strength / tune::BLOB_GONE_AT).clamp(0.0, 1.0)
+        }
+    }
+}
+
+/// The far edge of each of `n` slices from [`tune::NEAR`] to `far`: the practical split, a
+/// [`tune::SPLIT_LAMBDA`] blend of the logarithmic and the even.
+pub fn splits(n: usize, far: f32) -> [f32; 4] {
+    let mut out = [far; 4];
+    let near = tune::NEAR.min(far * 0.5);
+    for (i, s) in out.iter_mut().enumerate().take(n) {
+        let t = (i + 1) as f32 / n as f32;
+        let log = near * (far / near).powf(t);
+        let lin = near + (far - near) * t;
+        *s = tune::SPLIT_LAMBDA * log + (1.0 - tune::SPLIT_LAMBDA) * lin;
+    }
+    out[n.saturating_sub(1).min(3)] = far;
+    out
+}
+
+/// The smallest sphere about the view axis holding the slice of the view from eye depth `n` to
+/// `f`, whose corners leave the axis at slope `k` (`k² = tan²(fov_x/2) + tan²(fov_y/2)`): its
+/// centre's depth and its radius. Only depths and the field of view enter, so a slice's sphere
+/// keeps its size as the camera turns.
+pub fn slice_sphere(n: f32, f: f32, k: f32) -> (f32, f32) {
+    let k2 = k * k;
+    let c = 0.5 * (f + n) * (1.0 + k2);
+    if c >= f {
+        (f, f * k)
+    } else {
+        (c, ((f - c) * (f - c) + f * f * k2).sqrt())
+    }
+}
+
+/// The light's frame for a light travelling along `travel` (unit, downward): `right` level, `up`
+/// toward the sky side of the light's view. Bodies keep one bearing all day, so `right` never
+/// turns; the frame only tilts as they climb.
+pub fn light_frame(travel: Vec3) -> (Vec3, Vec3) {
+    let right = travel.cross(Vec3::Y);
+    let right = if right.length_squared() > 1e-8 {
+        right.normalize()
+    } else {
+        Vec3::X
+    };
+    (right, right.cross(travel).normalize())
+}
+
+/// Snaps `v` to the nearest multiple of `step`, in f64 so a centre 9 000 yd out still lands on
+/// the same grid line frame after frame.
+fn snap(v: f64, step: f64) -> f64 {
+    (v / step).round() * step
+}
+
+/// The fit: the slices of the view from the camera at `cam_pos` looking along `cam_fwd` (unit),
+/// with vertical field of view `fov_y` and `aspect`, out to `distance`, under `light`.
+#[allow(clippy::too_many_arguments)]
+pub fn fit(
+    cam_pos: Vec3,
+    cam_fwd: Vec3,
+    fov_y: f32,
+    aspect: f32,
+    light: ShadowLight,
+    cascades: usize,
+    res: u32,
+    distance: f32,
+) -> ShadowFrame {
+    let cascades = cascades.clamp(1, 4);
+    let (right, up) = light_frame(light.travel);
+    let ty = (0.5 * fov_y).tan();
+    let tx = ty * aspect.max(0.1);
+    let k = (tx * tx + ty * ty).sqrt();
+    let splits = splits(cascades, distance);
+    let mut slices = [Cascade::default(); 4];
+    let mut near = 0.0;
+    for (i, slice) in slices.iter_mut().enumerate().take(cascades) {
+        let far = splits[i];
+        let (c_depth, radius) = slice_sphere(near, far, k);
+        // A whole number of texels across, so the snap below lands every edge on a texel.
+        let texel = 2.0 * radius / res as f32;
+        let centre = cam_pos + cam_fwd * c_depth;
+        let (cx, cy, cz) = (
+            centre.as_dvec3().dot(right.as_dvec3()),
+            centre.as_dvec3().dot(up.as_dvec3()),
+            centre.as_dvec3().dot(light.travel.as_dvec3()),
+        );
+        let step = f64::from(texel);
+        let snapped = right.as_dvec3() * snap(cx, step)
+            + up.as_dvec3() * snap(cy, step)
+            + light.travel.as_dvec3() * cz;
+        *slice = Cascade {
+            center: snapped.as_vec3(),
+            half: radius,
+            near: -(radius + tune::CASTER_REACH),
+            range: 2.0 * radius + tune::CASTER_REACH,
+            texel,
+            blend_from: if i + 1 < cascades {
+                far - (far - near) * tune::BLEND
+            } else {
+                f32::INFINITY
+            },
+        };
+        near = far;
+    }
+    ShadowFrame {
+        cascades,
+        res,
+        high: cascades > tune::CASCADES_LOW,
+        strength: light.strength.clamp(0.0, 1.0),
+        fill: light.fill,
+        right,
+        up,
+        travel: light.travel,
+        splits,
+        distance,
+        slices,
+    }
+}
+
+/// The shadow block's rows ([`SHADOW_ROWS`]); all zero, which every shader reads as none, for a
+/// frame with no shadows.
+pub fn pack_rows(f: &ShadowFrame) -> [[f32; 4]; SHADOW_ROWS] {
+    let mut rows = [[0.0; 4]; SHADOW_ROWS];
+    if f.cascades == 0 || f.strength <= 0.0 {
+        return rows;
+    }
+    rows[0] = [
+        f.cascades as f32,
+        f.strength,
+        f.distance * (1.0 - tune::FADE),
+        f.distance,
+    ];
+    rows[1] = f.splits;
+    rows[2] = [f.right.x, f.right.y, f.right.z, f.res as f32];
+    rows[3] = [f.up.x, f.up.y, f.up.z, if f.high { 1.0 } else { 0.0 }];
+    rows[4] = [
+        f.travel.x,
+        f.travel.y,
+        f.travel.z,
+        tune::NORMAL_OFFSET_TEXELS,
+    ];
+    rows[5] = [f.fill[0], f.fill[1], f.fill[2], tune::DEPTH_BIAS_TEXELS];
+    for (i, s) in f.slices.iter().enumerate().take(f.cascades) {
+        rows[6 + 2 * i] = [s.center.x, s.center.y, s.center.z, 1.0 / s.half];
+        rows[7 + 2 * i] = [
+            s.near,
+            1.0 / s.range,
+            s.texel,
+            if s.blend_from.is_finite() {
+                s.blend_from
+            } else {
+                f32::MAX
+            },
+        ];
+    }
+    rows
+}
+
+/// What the light packer reads to fit the shadows, as one system parameter.
+#[derive(bevy::ecs::system::SystemParam)]
+pub(crate) struct ShadowInputs<'w, 's> {
+    look: Res<'w, WorldLook>,
+    shadows: Res<'w, LookShadows>,
+    frame: ResMut<'w, ShadowFrame>,
+    proj: Query<'w, 's, &'static Projection, With<crate::view::WorldCamera>>,
+}
+
+impl ShadowInputs<'_, '_> {
+    /// One frame: fits the shadows to the world camera `cam` under the visible sun and white moon
+    /// (camera to body), publishes [`ShadowFrame`] and returns its rows.
+    pub(crate) fn pack(
+        &mut self,
+        cam: Option<&GlobalTransform>,
+        sun: Vec3,
+        moon: Vec3,
+    ) -> [[f32; 4]; SHADOW_ROWS] {
+        let frame = self.fit(cam, sun, moon);
+        if *self.frame != frame {
+            *self.frame = frame;
+        }
+        pack_rows(&frame)
+    }
+
+    fn fit(&self, cam: Option<&GlobalTransform>, sun: Vec3, moon: Vec3) -> ShadowFrame {
+        if !self.look.on {
+            return ShadowFrame::default();
+        }
+        let (Some((cascades, res)), Some(cam), Some(light)) =
+            (self.shadows.layout(), cam, shadow_light(sun, moon))
+        else {
+            return ShadowFrame::default();
+        };
+        let Some(Projection::Perspective(p)) = self.proj.iter().next() else {
+            return ShadowFrame::default();
+        };
+        let light = ShadowLight {
+            strength: (light.strength * self.shadows.scale.unwrap_or(1.0)).min(1.0),
+            ..light
+        };
+        if light.strength <= 0.0 {
+            return ShadowFrame::default();
+        }
+        fit(
+            cam.translation(),
+            cam.forward().as_vec3(),
+            p.fov,
+            p.aspect_ratio,
+            light,
+            cascades,
+            res,
+            self.shadows.distance(),
+        )
+    }
+}
+
+/// The shadows' resources, for the light packer.
+pub(crate) fn init_resources(app: &mut App) {
+    app.init_resource::<LookShadows>()
+        .init_resource::<ShadowFrame>();
+}
