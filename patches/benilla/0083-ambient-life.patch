+/// What the hour, the weather, the wind and the camera give the life this frame.
+#[derive(Clone, Copy, Debug)]
+pub struct LifeEnv {
+    pub cam: Vec3,
+    /// The camera's heading on the ground (x, z; unit, or zero looking straight down), which
+    /// fireflies and motes are mostly born toward ([`tune::AHEAD`]).
+    pub heading: Vec2,
+    pub dt: f32,
+    /// The minute of the game day the light is drawn at (the film's clock under `worldclock`).
+    pub minute: f32,
+    /// `looklife`'s density.
+    pub density: f32,
+    pub rain: f32,
+    pub wet: f32,
+    pub overcast: f32,
+    /// The grade's god rays this hour, at its zone weight.
+    pub rays: f32,
+    /// Camera to sun (unit), and how much of it the clouds leave.
+    pub sun: Vec3,
+    pub sun_clear: f32,
+    /// The sun's light (the resolved diffuse, gamma).
+    pub sun_rgb: [f32; 3],
+    /// The wind block (`look::wind::pack_rows`), all zero when still.
+    pub wind: [[f32; 4]; WIND_ROWS],
+}
+
+impl LifeEnv {
+    fn wind_dir(&self) -> Vec3 {
+        Vec3::new(self.wind[0][0], 0.0, self.wind[0][1])
+    }
+
+    fn wind_strength(&self) -> f32 {
+        if self.wind[0][3] > 0.5 {
+            self.wind[0][2]
+        } else {
+            0.0
+        }
+    }
+
+    fn gust(&self, p: Vec3) -> f32 {
+        wind::gust_at(&self.wind, Vec2::new(p.x, p.z))
+    }
+
+    /// The sun's height over the horizon, 0 to 1 by [`tune::MOTE_SUN_UP_DEG`].
+    fn sun_up(&self) -> f32 {
+        let deg = self
+            .sun
+            .normalize_or_zero()
+            .y
+            .clamp(-1.0, 1.0)
+            .asin()
+            .to_degrees();
+        smoothstep(tune::MOTE_SUN_UP_DEG.0, tune::MOTE_SUN_UP_DEG.1, deg)
+    }
+}
+
+#[derive(Clone, Copy, Debug)]
+struct Firefly {
+    home: Vec3,
+    age: f32,
+    life: f32,
+    phase: [f32; 3],
+    rate: [f32; 3],
+    period: f32,
+    offset: f32,
+}
+
+impl Firefly {
+    fn pos(&self) -> Vec3 {
+        let (a, up) = tune::FIREFLY_WANDER;
+        let t = self.age;
+        self.home
+            + Vec3::new(
+                a * (t * self.rate[0] + self.phase[0]).sin(),
+                up * (t * self.rate[2] * 1.7 + self.phase[2]).sin(),
+                a * (t * self.rate[1] + self.phase[1]).sin(),
+            )
+    }
+
+    /// Its glow this frame before the hour, the weather and the edge: blink and fade.
+    fn glow(&self) -> f32 {
+        let f = tune::FIREFLY_FADE_S;
+        let fade = smoothstep(0.0, f, self.age) * smoothstep(0.0, f, self.life - self.age);
+        blink(self.age, self.period, self.offset) * fade
+    }
+}
+
+#[derive(Clone, Copy, Debug)]
+struct Leaf {
+    pos: Vec3,
+    /// Its horizontal speed (yd/s, x and z).
+    vel: Vec2,
+    fall: f32,
+    ground: f32,
+    axis: Vec3,
+    angle: f32,
+    spin: f32,
+    swing_phase: f32,
+    swing_rate: f32,
+    size: f32,
+    color: [f32; 3],
+    age: f32,
+    /// Seconds since it landed, `None` while it falls.
+    landed: Option<f32>,
+}
+
+#[derive(Clone, Copy, Debug)]
+struct Mote {
+    pos: Vec3,
+    drift: Vec3,
+    age: f32,
+    life: f32,
+    twinkle_hz: f32,
+    twinkle_phase: f32,
+    /// How much of the sun reaches it, eased toward `lit_target`.
+    lit: f32,
+    lit_target: f32,
+    next_check: f32,
+}
+
+#[derive(Clone, Copy, Debug)]
+struct Butterfly {
+    pos: Vec3,
+    home: Vec3,
+    heading: f32,
+    aim: Vec3,
+    next_aim: f32,
+    flap_hz: f32,
+    flap_phase: f32,
+    color: [f32; 3],
+    age: f32,
+    life: f32,
+}
+
+/// The ambient life near the camera: its pools, the crowns it drops leaves from and its dice.
+#[derive(Resource)]
+pub struct Life {
+    flies: Vec<Firefly>,
+    leaves: Vec<Leaf>,
+    motes: Vec<Mote>,
+    butterflies: Vec<Butterfly>,
+    /// The tree crowns near the camera ([`scan_crowns`]).
+    pub crowns: Vec<Crown>,
+    /// The tree placements the last scan found within its reach, crowned or not.
+    trees_near: usize,
+    /// Where the crowns were last looked for, and how long ago.
+    scanned_at: Option<Vec3>,
+    scan_age: f32,
+    /// The fair-weather share, eased ([`tune::WEATHER_FADE_S`]).
+    gate: f32,
+    /// The hour and weather weights of this frame, for the draw.
+    fly_level: f32,
+    mote_level: f32,
+    butterfly_level: f32,
+    /// The sun on the motes this frame, colour times strength, and toward it (unit).
+    mote_rgb: [f32; 3],
+    mote_sun: Vec3,
+    /// Each kind's count at density 1 this frame (the hour and the weather), for `looklife`'s
+    /// reply ([`Life::wanted`]); and where the camera was and looked ([`Life::flies_ahead`]).
+    want_unit: [f32; 4],
+    last_cam: Vec3,
+    last_heading: Vec2,
+    clock: f32,
+    rng: u32,
+    /// What became of the leaves since `looklife` last asked ([`LeafTally`]).
+    leaf_tally: LeafTally,
+}
+
+/// The leaves' fates since `looklife` last asked: how many crowns' rolls came up, how many were
+/// born and how many spots were refused (no ground under them, or too near it), and how each
+/// leaf ended (lay its rest out, blew out of reach, fell too long) and how long it lived. Take
+/// 291 found 24 crowns at Crystal Lake keeping only 3 to 7 leaves out, where their rates want
+/// 20 to 40: these say which limit holds.
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub struct LeafTally {
+    pub rolls: u32,
+    pub born: u32,
+    pub no_ground: u32,
+    pub too_low: u32,
+    pub rested: u32,
+    pub out_of_reach: u32,
+    pub too_old: u32,
+    pub life_sum: f32,
+}
+
+impl LeafTally {
+    /// The mean life (s) of the leaves that ended.
+    pub fn mean_life(&self) -> f32 {
+        let ended = self.rested + self.out_of_reach + self.too_old;
+        if ended == 0 {
+            0.0
+        } else {
+            self.life_sum / ended as f32
+        }
+    }
+}
+
+impl Default for Life {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+/// Pool capacities: each count at [`tune::SCALE_MAX`], fixed at birth.
+fn cap(count: f32) -> usize {
+    (count * tune::SCALE_MAX).ceil() as usize
+}
+
+impl Life {
+    /// Empty pools, each with room for its count at [`tune::SCALE_MAX`]: nothing grows later.
+    pub fn new() -> Self {
+        Self {
+            flies: Vec::with_capacity(cap(tune::FIREFLIES)),
+            leaves: Vec::with_capacity(cap(tune::LEAVES)),
+            motes: Vec::with_capacity(cap(tune::MOTES)),
+            butterflies: Vec::with_capacity(cap(tune::BUTTERFLIES)),
+            crowns: Vec::with_capacity(tune::CROWNS_MAX),
+            trees_near: 0,
+            scanned_at: None,
+            scan_age: 0.0,
+            gate: 1.0,
+            fly_level: 0.0,
+            mote_level: 0.0,
+            butterfly_level: 0.0,
+            mote_rgb: [0.0; 3],
+            mote_sun: Vec3::Y,
+            want_unit: [0.0; 4],
+            last_cam: Vec3::ZERO,
+            last_heading: Vec2::ZERO,
+            clock: 0.0,
+            rng: 0x2545_F491,
+            leaf_tally: LeafTally::default(),
+        }
+    }
+
+    /// The leaves' fates since the last call, and a fresh tally from here (`looklife`).
+    pub fn take_leaf_tally(&mut self) -> LeafTally {
+        std::mem::take(&mut self.leaf_tally)
+    }
+
+    /// Everything gone (the look or the life switched off, indoors, under water).
+    pub fn clear(&mut self) {
+        self.flies.clear();
+        self.leaves.clear();
+        self.motes.clear();
+        self.butterflies.clear();
+        self.crowns.clear();
+        self.scanned_at = None;
+    }
+
+    /// The trees (swaying plants tall enough) placed near the camera at the last look, and the
+    /// crowns leaves fall from: `looklife` says both.
+    pub fn trees(&self) -> (usize, usize) {
+        (self.trees_near, self.crowns.len())
+    }
+
+    /// How many of each `density` asks for at this hour and in this weather: fireflies, leaves
+    /// (at most), motes, butterflies. `looklife` says these, since the pools fill or thin over a
+    /// few seconds after it changes (take 280: "held at 0" answered "60 fireflies out").
+    pub fn wanted(&self, density: f32) -> [usize; 4] {
+        let d = density.clamp(0.0, tune::SCALE_MAX);
+        let caps = self.capacities();
+        std::array::from_fn(|i| ((self.want_unit[i] * d).round() as usize).min(caps[i]))
+    }
+
+    /// How many fireflies are ahead of the camera (within [`tune::AHEAD_DEG`] of its heading, on
+    /// the ground), where a film can see them.
+    pub fn flies_ahead(&self) -> usize {
+        let cos = tune::AHEAD_DEG.to_radians().cos();
+        self.flies
+            .iter()
+            .filter(|f| {
+                let p = f.pos();
+                let to = Vec2::new(p.x - self.last_cam.x, p.z - self.last_cam.z);
+                to.try_normalize()
+                    .is_some_and(|t| t.dot(self.last_heading) >= cos)
+            })
+            .count()
+    }
+
+    /// How many motes the sun reaches now (half lit or more): `looklife` says it.
+    pub fn lit_motes(&self) -> usize {
+        self.motes.iter().filter(|m| m.lit >= 0.5).count()
+    }
+
+    /// How many of each are alive: fireflies, leaves, motes, butterflies.
+    pub fn counts(&self) -> [usize; 4] {
+        [
+            self.flies.len(),
+            self.leaves.len(),
+            self.motes.len(),
+            self.butterflies.len(),
+        ]
+    }
+
+    /// The pools' capacities, which never change.
+    pub fn capacities(&self) -> [usize; 4] {
+        [
+            self.flies.capacity(),
+            self.leaves.capacity(),
+            self.motes.capacity(),
+            self.butterflies.capacity(),
+        ]
+    }
+
+    /// Whether the crowns want looking for again: after [`tune::CROWN_SCAN_S`], or once the
+    /// camera has moved [`tune::CROWN_SCAN_MOVE`].
+    pub fn wants_scan(&self, cam: Vec3) -> bool {
+        match self.scanned_at {
+            None => true,
+            Some(at) => {
+                self.scan_age >= tune::CROWN_SCAN_S || at.distance(cam) >= tune::CROWN_SCAN_MOVE
+            }
+        }
+    }
+
+    /// Takes the crowns near `cam` from `trees`, the nearest [`tune::CROWNS_MAX`] within
+    /// [`tune::LEAF_RADIUS`].
+    pub fn set_crowns(&mut self, cam: Vec3, trees: impl Iterator<Item = Crown>) {
+        self.crowns.clear();
+        let reach = tune::LEAF_RADIUS;
+        for c in trees {
+            let d = Vec2::new(c.center.x - cam.x, c.center.z - cam.z).length() - c.radius;
+            if d > reach {
+                continue;
+            }
+            if self.crowns.len() < tune::CROWNS_MAX {
+                self.crowns.push(c);
+                continue;
+            }
+            // Full: this one replaces the farthest if nearer.
+            let far = |c: &Crown| c.center.distance_squared(cam);
+            if let Some((i, worst)) = self
+                .crowns
+                .iter()
+                .enumerate()
+                .map(|(i, k)| (i, far(k)))
+                .max_by(|a, b| a.1.total_cmp(&b.1))
+            {
+                if far(&c) < worst {
+                    self.crowns[i] = c;
+                }
+            }
+        }
+        self.scanned_at = Some(cam);
+        self.scan_age = 0.0;
+    }
+
+    fn rand(&mut self) -> f32 {
+        let mut x = self.rng;
+        x ^= x << 13;
+        x ^= x >> 17;
+        x ^= x << 5;
+        self.rng = x;
+        (x >> 8) as f32 / (1u32 << 24) as f32
+    }
+
+    fn range(&mut self, r: (f32, f32)) -> f32 {
+        r.0 + (r.1 - r.0) * self.rand()
+    }
+
+    /// A point on the disc of `radius` around `cam` (x, z), uniform over its area, at least
+    /// `inner` out.
+    fn disc(&mut self, cam: Vec3, inner: f32, radius: f32) -> (f32, f32) {
+        let r = (inner * inner + (radius * radius - inner * inner) * self.rand()).sqrt();
+        let a = self.rand() * std::f32::consts::TAU;
+        (cam.x + r * a.cos(), cam.z + r * a.sin())
+    }
+
+    /// [`Self::disc`], but [`tune::AHEAD`] of the time within [`tune::AHEAD_DEG`] of `heading`
+    /// (unit; zero for anywhere), so most of what is born is where the camera looks.
+    fn disc_ahead(&mut self, cam: Vec3, heading: Vec2, inner: f32, radius: f32) -> (f32, f32) {
+        let r = (inner * inner + (radius * radius - inner * inner) * self.rand()).sqrt();
+        let ahead = heading.length_squared() > 0.5 && self.rand() < tune::AHEAD;
+        let a = if ahead {
+            heading.y.atan2(heading.x) + (2.0 * self.rand() - 1.0) * tune::AHEAD_DEG.to_radians()
+        } else {
+            self.rand() * std::f32::consts::TAU
+        };
+        (cam.x + r * a.cos(), cam.z + r * a.sin())
+    }
+
+    /// Whether (x, z) is under or beside a crown, within `reach` of its edge.
+    fn near_crown(&self, x: f32, z: f32, reach: f32) -> bool {
+        self.crowns
+            .iter()
+            .any(|c| Vec2::new(c.center.x - x, c.center.z - z).length() < c.radius + reach)
+    }
+
+    /// One frame of life under `env`, asking `world` about places.
+    pub fn step(&mut self, env: &LifeEnv, world: &mut impl LifeWorld) {
+        let dt = env.dt.clamp(0.0, 0.1);
+        self.clock += dt;
+        self.scan_age += dt;
+        let density = env.density.clamp(0.0, tune::SCALE_MAX);
+        // The weather's gate, eased so they go and come back softly.
+        let fair = fair(env.rain);
+        let k = (dt / tune::WEATHER_FADE_S).min(1.0);
+        self.gate += (fair - self.gate) * k;
+        let gate = self.gate;
+
+        self.fly_level = firefly_hour(env.minute) * gate;
+        self.butterfly_level = butterfly_hour(env.minute)
+            * gate
+            * (1.0 - (1.0 - tune::BUTTERFLY_OVERCAST) * env.overcast.clamp(0.0, 1.0));
+        let sun = env.sun_up()
+            * env.sun_clear.clamp(0.0, 1.0)
+            * (1.0 - 0.9 * env.overcast.clamp(0.0, 1.0))
+            * (tune::MOTE_RAYS_FLOOR + env.rays.max(0.0));
+        self.mote_level = gate * sun;
+        self.mote_rgb =
+            std::array::from_fn(|i| env.sun_rgb[i] * tune::MOTE_WARM[i] * tune::MOTE_GAIN);
+        self.mote_sun = env.sun.normalize_or(Vec3::Y);
+
+        self.step_flies(env, world, density, dt);
+        self.step_leaves(env, world, density, dt);
+        let after_rain = 1.0 + tune::MOTES_AFTER_RAIN * env.wet.clamp(0.0, 1.0) * fair;
+        let mote_target = if env.sun_up() > 0.0 {
+            tune::MOTES * density * gate * after_rain
+        } else {
+            0.0
+        };
+        self.step_motes(env, world, mote_target, dt);
+        self.step_butterflies(env, world, density, dt);
+        let unit = density.max(1e-6);
+        self.want_unit = [
+            tune::FIREFLIES * firefly_hour(env.minute) * self.gate,
+            tune::LEAVES * leaf_hour(env.minute).min(1.0).ceil(),
+            mote_target / unit,
+            tune::BUTTERFLIES * self.butterfly_level,
+        ];
+        self.last_cam = env.cam;
+        self.last_heading = env.heading;
+    }
+
+    fn edge_alive(cam: Vec3, p: Vec3, radius: f32) -> bool {
+        Vec2::new(p.x - cam.x, p.z - cam.z).length() <= radius
+    }
+
+    fn step_flies(&mut self, env: &LifeEnv, world: &mut impl LifeWorld, density: f32, dt: f32) {
+        let r = tune::FIREFLY_RADIUS;
+        let cam = env.cam;
+        self.flies.retain_mut(|f| {
+            f.age += dt;
+            f.age < f.life && Self::edge_alive(cam, f.pos(), r)
+        });
+        let target = (tune::FIREFLIES * density * firefly_hour(env.minute) * self.gate).round();
+        if target <= 0.0 {
+            // None wanted: the last are all but faded (their glow carries the hour and the gate).
+            self.flies.clear();
+            return;
+        }
+        let room = self.flies.capacity();
+        for _ in 0..tune::SPAWN_PER_FRAME {
+            if self.flies.len() as f32 >= target || self.flies.len() >= room {
+                break;
+            }
+            // A few tries for a spot that keeps one: by the trees, over the water, or in the open
+            // at a lower chance.
+            for _ in 0..3 {
+                let (x, z) = self.disc_ahead(cam, env.heading, tune::NEAR_TO, r);
+                let Some(ground) = world.ground(x, z) else {
+                    continue;
+                };
+                let water = world.water(x, z, ground);
+                let keep = if water.is_some() {
+                    tune::FIREFLY_WATER
+                } else if self.near_crown(x, z, tune::FIREFLY_WOODS_REACH) {
+                    tune::FIREFLY_WOODS
+                } else {
+                    tune::FIREFLY_OPEN
+                };
+                if self.rand() >= keep {
+                    continue;
+                }
+                let base = water.unwrap_or(ground).max(ground);
+                let home = Vec3::new(x, base + self.range(tune::FIREFLY_HEIGHT), z);
+                let tau = std::f32::consts::TAU;
+                let fly = Firefly {
+                    home,
+                    age: 0.0,
+                    life: self.range(tune::FIREFLY_LIFE),
+                    phase: [self.rand() * tau, self.rand() * tau, self.rand() * tau],
+                    rate: [
+                        self.range(tune::FIREFLY_WANDER_RATE),
+                        self.range(tune::FIREFLY_WANDER_RATE),
+                        self.range(tune::FIREFLY_WANDER_RATE),
+                    ],
+                    period: self.range(tune::FIREFLY_BLINK_PERIOD),
+                    offset: self.rand(),
+                };
+                self.flies.push(fly);
+                break;
+            }
+        }
+    }
+
+    /// A leaf from `crown`, at the first of [`tune::LEAF_TRIES`] spots in it that has ground
+    /// [`tune::LEAF_MIN_DROP`] or more under it; whether one was born.
+    fn spawn_leaf(&mut self, crown: Crown, world: &mut impl LifeWorld, rain: f32) -> bool {
+        for _ in 0..tune::LEAF_TRIES {
+            // A point about the crown's middle, toward its rim.
+            let a = self.rand() * std::f32::consts::TAU;
+            let rr = crown.radius * (0.35 + 0.6 * self.rand().sqrt());
+            let (under, over) = tune::LEAF_BORN;
+            let y = crown.center.y + crown.half_height * (over - (under + over) * self.rand());
+            let (x, z) = (crown.center.x + rr * a.cos(), crown.center.z + rr * a.sin());
+            let Some(ground) = world.ground(x, z) else {
+                self.leaf_tally.no_ground += 1;
+                continue;
+            };
+            if y <= ground + tune::LEAF_MIN_DROP {
+                self.leaf_tally.too_low += 1;
+                continue;
+            }
+            self.push_leaf(Vec3::new(x, y, z), ground, world, rain);
+            return true;
+        }
+        false
+    }
+
+    fn push_leaf(&mut self, at: Vec3, ground: f32, world: &mut impl LifeWorld, rain: f32) {
+        let (x, y, z) = (at.x, at.y, at.z);
+        let axis = Vec3::new(self.rand() - 0.5, self.rand() - 0.5, self.rand() - 0.5)
+            .normalize_or(Vec3::X);
+        let color = tune::LEAF_COLORS
+            [(self.rand() * tune::LEAF_COLORS.len() as f32) as usize % tune::LEAF_COLORS.len()];
+        let leaf = Leaf {
+            pos: Vec3::new(x, y, z),
+            vel: Vec2::ZERO,
+            fall: self.range(tune::LEAF_FALL) * (1.0 + tune::LEAF_RAIN_FALL * rain),
+            ground: world.water(x, z, ground).unwrap_or(ground).max(ground),
+            axis,
+            angle: self.rand() * std::f32::consts::TAU,
+            spin: self.range(tune::LEAF_SPIN) * if self.rand() < 0.5 { -1.0 } else { 1.0 },
+            swing_phase: self.rand() * std::f32::consts::TAU,
+            swing_rate: std::f32::consts::TAU / self.range(tune::LEAF_SWING_PERIOD),
+            size: self.range(tune::LEAF_SIZE),
+            color,
+            age: 0.0,
+            landed: None,
+        };
+        self.leaf_tally.born += 1;
+        self.leaves.push(leaf);
+    }
+
+    fn step_leaves(&mut self, env: &LifeEnv, world: &mut impl LifeWorld, density: f32, dt: f32) {
+        let cam = env.cam;
+        let strength = env.wind_strength();
+        let dir = env.wind_dir();
+        let rain = env.rain.clamp(0.0, 1.0);
+        for leaf in &mut self.leaves {
+            leaf.age += dt;
+            if let Some(t) = leaf.landed.as_mut() {
+                *t += dt;
+                continue;
+            }
+            // The air downwind, the leaf taking it up over its drag.
+            let air =
+                dir * (tune::LEAF_DRIFT * strength + tune::LEAF_DRIFT_GUST * env.gust(leaf.pos));
+            let k = (dt / tune::LEAF_DRAG_S).min(1.0);
+            leaf.vel += (Vec2::new(air.x, air.z) - leaf.vel) * k;
+            // The swing side to side across its fall, slowing as it turns.
+            let s = (leaf.age * leaf.swing_rate + leaf.swing_phase).sin();
+            let c = (leaf.age * leaf.swing_rate + leaf.swing_phase).cos();
+            let across = Vec3::new(-dir.z, 0.0, dir.x);
+            let across = if across.length_squared() > 0.5 {
+                across
+            } else {
+                Vec3::X
+            };
+            let swing = across * (tune::LEAF_SWING * leaf.swing_rate * c);
+            let fall = leaf.fall * (0.6 + 0.4 * s.abs());
+            leaf.pos += (Vec3::new(leaf.vel.x, -fall, leaf.vel.y) + swing) * dt;
+            leaf.angle += leaf.spin * dt;
+            // The ground under it again as it comes near.
+            if leaf.pos.y - leaf.ground < 2.0 {
+                if let Some(g) = world.ground(leaf.pos.x, leaf.pos.z) {
+                    leaf.ground = world.water(leaf.pos.x, leaf.pos.z, g).unwrap_or(g).max(g);
+                }
+            }
+            if leaf.pos.y <= leaf.ground + tune::LEAF_LIFT {
+                leaf.pos.y = leaf.ground + tune::LEAF_LIFT;
+                leaf.landed = Some(0.0);
+            }
+        }
+        let tally = &mut self.leaf_tally;
+        self.leaves.retain(|l| {
+            let end = if l.landed.is_some_and(|t| t >= tune::LEAF_REST_S) {
+                &mut tally.rested
+            } else if l.age >= tune::LEAF_MAX_FALL_S {
+                &mut tally.too_old
+            } else if !Self::edge_alive(cam, l.pos, tune::LEAF_RADIUS + 5.0) {
+                &mut tally.out_of_reach
+            } else {
+                return true;
+            };
+            *end += 1;
+            tally.life_sum += l.age;
+            false
+        });
+        // New leaves from each crown, more in the wind, in a gust and in the rain.
+        let hour = leaf_hour(env.minute);
+        let cap = ((tune::LEAVES * density).round() as usize).min(self.leaves.capacity());
+        let rain_more = 1.0 + tune::LEAF_RAIN * rain;
+        let mut born = 0;
+        for i in 0..self.crowns.len() {
+            if self.leaves.len() >= cap || born >= tune::SPAWN_PER_FRAME {
+                break;
+            }
+            let crown = self.crowns[i];
+            let rate = (tune::LEAF_RATE_CALM
+                + tune::LEAF_RATE_WIND * strength
+                + tune::LEAF_RATE_GUST * env.gust(crown.center))
+                * density
+                * hour
+                * rain_more;
+            if self.rand() < rate * dt {
+                self.leaf_tally.rolls += 1;
+                if self.spawn_leaf(crown, world, rain) {
+                    born += 1;
+                }
+            }
+        }
+    }
+
+    fn step_motes(&mut self, env: &LifeEnv, world: &mut impl LifeWorld, target: f32, dt: f32) {
+        let r = tune::MOTE_RADIUS;
+        let cam = env.cam;
+        let wind = env.wind_dir() * (tune::MOTE_WIND * env.wind_strength());
+        let to_sun = env.sun.normalize_or(Vec3::Y);
+        let clock = self.clock;
+        let ease = (dt / tune::MOTE_LIT_EASE_S).min(1.0);
+        let mut motes = std::mem::take(&mut self.motes);
+        motes.retain_mut(|m| {
+            m.age += dt;
+            m.pos += (m.drift + wind) * dt;
+            if clock >= m.next_check {
+                m.next_check = clock + tune::MOTE_CHECK_S;
+                m.lit_target =
+                    if self.shaded_by_crowns(m.pos, to_sun) || !world.sunlit(m.pos, to_sun) {
+                        0.0
+                    } else {
+                        1.0
+                    };
+            }
+            m.lit += (m.lit_target - m.lit) * ease;
+            m.age < m.life && Self::edge_alive(cam, m.pos, r)
+        });
+        self.motes = motes;
+        let target = target.round().min(self.motes.capacity() as f32);
+        if target <= 0.0 {
+            // None wanted (night, rain): the last are all but faded with the gate.
+            self.motes.clear();
+            return;
+        }
+        for _ in 0..tune::SPAWN_PER_FRAME {
+            if self.motes.len() as f32 >= target {
+                break;
+            }
+            let (x, z) = self.disc_ahead(cam, env.heading, 0.0, r);
+            let Some(ground) = world.ground(x, z) else {
+                continue;
+            };
+            let base = world.water(x, z, ground).unwrap_or(ground).max(ground);
+            let pos = Vec3::new(x, base + self.range(tune::MOTE_HEIGHT), z);
+            let drift = Vec3::new(
+                self.rand() - 0.5,
+                0.3 * (self.rand() - 0.5),
+                self.rand() - 0.5,
+            )
+            .normalize_or_zero()
+                * tune::MOTE_DRIFT;
+            let mote = Mote {
+                pos,
+                drift,
+                age: 0.0,
+                life: self.range(tune::MOTE_LIFE),
+                twinkle_hz: self.range(tune::MOTE_TWINKLE_HZ),
+                twinkle_phase: self.rand() * std::f32::consts::TAU,
+                lit: 0.0,
+                lit_target: 0.0,
+                // Its first look for the sun this frame; then staggered by its own clock.
+                next_check: clock,
+            };
+            self.motes.push(mote);
+        }
+    }
+
+    /// Whether the crowns shade `p` from the sun, but for the gaps in their leaves: shafts across
+    /// the sun's direction, fixed in the world, so a drifting mote passes in and out of them.
+    fn shaded_by_crowns(&self, p: Vec3, to_sun: Vec3) -> bool {
+        let side = to_sun.cross(Vec3::Y).normalize_or(Vec3::X);
+        let up = side.cross(to_sun);
+        let cell = (
+            (p.dot(side) / tune::SHAFT_CELL).floor() as i32,
+            (p.dot(up) / tune::SHAFT_CELL).floor() as i32,
+        );
+        self.crowns.iter().enumerate().any(|(i, c)| {
+            c.blocks(p, to_sun) && shaft_hash(cell.0, cell.1, i as u32) < tune::CANOPY_SHUT
+        })
+    }
+
+    fn step_butterflies(
+        &mut self,
+        env: &LifeEnv,
+        world: &mut impl LifeWorld,
+        density: f32,
+        dt: f32,
+    ) {
+        let cam = env.cam;
+        let outer = tune::BUTTERFLY_RING.1 + 4.0;
+        let mut flock = std::mem::take(&mut self.butterflies);
+        flock.retain_mut(|b| {
+            b.age += dt;
+            if self.clock >= b.next_aim {
+                b.next_aim = self.clock + self.range(tune::BUTTERFLY_AIM_S);
+                let leaving = b.age > b.life;
+                // Wandering about its home; at the end of its life, away out of sight.
+                let (reach, centre) = if leaving {
+                    (outer * 2.0, b.pos)
+                } else {
+                    (tune::BUTTERFLY_WANDER, b.home)
+                };
+                let a = self.rand() * std::f32::consts::TAU;
+                let d = reach * self.rand().sqrt();
+                let (x, z) = (centre.x + d * a.cos(), centre.z + d * a.sin());
+                let ground = world.ground(x, z).unwrap_or(b.pos.y - 1.0);
+                b.aim = Vec3::new(x, ground + self.range(tune::BUTTERFLY_HEIGHT), z);
+            }
+            let to = b.aim - b.pos;
+            let want = to.z.atan2(to.x);
+            let mut turn = (want - b.heading + std::f32::consts::PI)
+                .rem_euclid(std::f32::consts::TAU)
+                - std::f32::consts::PI;
+            let max = tune::BUTTERFLY_TURN * dt;
+            turn = turn.clamp(-max, max);
+            b.heading += turn;
+            let flap = (b.age * b.flap_hz * std::f32::consts::TAU + b.flap_phase).sin();
+            let fwd = Vec3::new(b.heading.cos(), 0.0, b.heading.sin());
+            let climb = (to.y * 1.5).clamp(-0.8, 0.8) + 0.35 * flap;
+            b.pos += (fwd * tune::BUTTERFLY_SPEED + Vec3::Y * climb) * dt;
+            Self::edge_alive(cam, b.pos, outer)
+        });
+        self.butterflies = flock;
+        let target = (tune::BUTTERFLIES * density * self.butterfly_level).round();
+        if target <= 0.0 && self.butterfly_level < 0.02 {
+            self.butterflies.clear();
+            return;
+        }
+        if (self.butterflies.len() as f32) < target
+            && self.butterflies.len() < self.butterflies.capacity()
+        {
+            for _ in 0..3 {
+                let (x, z) = self.disc(cam, tune::BUTTERFLY_RING.0, tune::BUTTERFLY_RING.1);
+                if self.near_crown(x, z, tune::MEADOW_CLEAR) {
+                    continue;
+                }
+                let Some(ground) = world.ground(x, z) else {
+                    continue;
+                };
+                if world.water(x, z, ground).is_some() {
+                    continue;
+                }
+                let home = Vec3::new(x, ground + self.range(tune::BUTTERFLY_HEIGHT), z);
+                let color = tune::BUTTERFLY_COLORS[(self.rand()
+                    * tune::BUTTERFLY_COLORS.len() as f32)
+                    as usize
+                    % tune::BUTTERFLY_COLORS.len()];
+                let b = Butterfly {
+                    pos: home,
+                    home,
+                    heading: self.rand() * std::f32::consts::TAU,
+                    aim: home,
+                    next_aim: self.clock,
+                    flap_hz: self.range(tune::FLAP_HZ),
+                    flap_phase: self.rand() * std::f32::consts::TAU,
+                    color,
+                    age: 0.0,
+                    life: self.range(tune::BUTTERFLY_LIFE),
+                };
+                self.butterflies.push(b);
+                break;
+            }
+        }
+    }
+
+    /// The fireflies glowing brightest near `cam`, nearest first: their place and glow (0 to 1,
+    /// with the hour and the weather), at most `out.len()`; returns how many.
+    pub fn bright_flies(&self, cam: Vec3, out: &mut [(Vec3, f32)]) -> usize {
+        let mut n = 0;
+        for f in &self.flies {
+            let p = f.pos();
+            let d = p.distance(cam);
+            if d > tune::FIREFLY_LIGHT_REACH {
+                continue;
+            }
+            let g = f.glow() * self.fly_level;
+            if g < 0.3 {
+                continue;
+            }
+            if n < out.len() {
+                out[n] = (p, g);
+                n += 1;
+            } else if let Some(far) =
+                (0..n).max_by(|&a, &b| out[a].0.distance(cam).total_cmp(&out[b].0.distance(cam)))
+            {
+                if d < out[far].0.distance(cam) {
+                    out[far] = (p, g);
+                }
+            }
+        }
+        n
+    }
+}
+
+/// A fixed hash of a shaft cell and a crown, 0 to 1.
+fn shaft_hash(x: i32, y: i32, crown: u32) -> f32 {
+    let mut h = (x as u32).wrapping_mul(73_856_093)
+        ^ (y as u32).wrapping_mul(19_349_663)
+        ^ crown.wrapping_mul(83_492_791);
+    h = (h ^ (h >> 15)).wrapping_mul(2_246_822_519);
+    h ^= h >> 13;
+    (h >> 8) as f32 / 16_777_216.0
+}
+
+// ===== the atlas =====
+
+/// The atlas's side (texels), four cells of half that: the glow, the mote, the leaf, the wing.
+pub const ATLAS: u32 = 128;
+/// Mip levels: down to cells of 8 texels, so a cell never bleeds into its neighbour.
+pub const ATLAS_MIPS: u32 = 4;
+
+/// The four cells' UV corners: `[u0, v0]`, each half the atlas.
+const CELL_GLOW: [f32; 2] = [0.0, 0.0];
+const CELL_MOTE: [f32; 2] = [0.5, 0.0];
+const CELL_LEAF: [f32; 2] = [0.0, 0.5];
+const CELL_WING: [f32; 2] = [0.5, 0.5];
+
+/// One cell's texel at (u, v) in 0..1 across the cell: white-ish RGB (the vertex colour tints it)
+/// and the shape in alpha.
+fn cell_texel(cell: usize, u: f32, v: f32) -> [f32; 4] {
+    let (x, y) = (u * 2.0 - 1.0, v * 2.0 - 1.0);
+    let r2 = x * x + y * y;
+    match cell {
+        // The firefly: a hot core in a soft halo.
+        0 => {
+            let a = (-r2 / 0.012).exp() + 0.45 * (-r2 / 0.12).exp();
+            let edge = 1.0 - smoothstep(0.8, 1.0, r2.sqrt());
+            [1.0, 1.0, 1.0, (a * edge).min(1.0)]
+        }
+        // The mote: a small soft disc.
+        1 => {
+            let a = (-r2 / 0.08).exp() * (1.0 - smoothstep(0.75, 1.0, r2.sqrt()));
+            [1.0, 1.0, 1.0, a]
+        }
+        // The leaf: pointed at both ends along v, a darker midrib, a short stem.
+        2 => {
+            let t = v; // 0 tip .. 1 stem end
+            let along = (t - 0.08) / 0.8;
+            let half = if (0.0..=1.0).contains(&along) {
+                0.42 * (std::f32::consts::PI * along).sin().powf(0.8)
+            } else {
+                0.0
+            };
+            let inside = half - x.abs() * 0.5;
+            let blade = smoothstep(-0.02, 0.02, inside);
+            let stem = if t > 0.86 && t < 0.97 && x.abs() < 0.04 {
+                1.0
+            } else {
+                0.0
+            };
+            let rib = 1.0 - 0.25 * (1.0 - smoothstep(0.0, 0.05, x.abs()));
+            let vein = 0.85 + 0.15 * smoothstep(0.0, half.max(0.01), x.abs() * 0.5);
+            let shade = rib * vein;
+            [shade, shade, shade, blade.max(stem)]
+        }
+        // A wing, hinged along u = 0: a big forewing and a smaller hindwing, a dark rim and a
+        // spot.
+        _ => {
+            let fore = |px: f32, py: f32| {
+                let dx = (px - 0.5) / 0.48;
+                let dy = (py - 0.32) / 0.3;
+                dx * dx + dy * dy
+            };
+            let hind = |px: f32, py: f32| {
+                let dx = (px - 0.36) / 0.34;
+                let dy = (py - 0.72) / 0.24;
+                dx * dx + dy * dy
+            };
+            let f = fore(u, v);
+            let h = hind(u, v);
+            let d = f.min(h);
+            let a = 1.0 - smoothstep(0.85, 1.0, d);
+            let rim = smoothstep(0.55, 0.85, d);
+            let spot = {
+                let dx = (u - 0.62) / 0.08;
+                let dy = (v - 0.3) / 0.08;
+                1.0 - smoothstep(0.6, 1.0, dx * dx + dy * dy)
+            };
+            let shade = (1.0 - 0.6 * rim) * (1.0 - 0.55 * spot);
+            [shade, shade, shade, a]
+        }
+    }
+}
+
+/// The atlas's bytes, every mip level after the first, box-filtered.
+pub fn atlas_bytes() -> Vec<u8> {
+    let n = ATLAS as usize;
+    let cell = n / 2;
+    let mut level: Vec<[f32; 4]> = vec![[0.0; 4]; n * n];
+    for j in 0..n {
+        for i in 0..n {
+            let c = (i / cell) + 2 * (j / cell);
+            // Supersampled 2×2 within the texel, for clean edges.
+            let mut acc = [0.0f32; 4];
+            for sy in 0..2 {
+                for sx in 0..2 {
+                    let u = ((i % cell) as f32 + 0.25 + 0.5 * sx as f32) / cell as f32;
+                    let v = ((j % cell) as f32 + 0.25 + 0.5 * sy as f32) / cell as f32;
+                    let t = cell_texel(c, u, v);
+                    for (a, t) in acc.iter_mut().zip(t) {
+                        *a += 0.25 * t;
+                    }
+                }
+            }
+            level[j * n + i] = acc;
+        }
+    }
+    let mut bytes = Vec::new();
+    let mut side = n;
+    for mip in 0..ATLAS_MIPS {
+        if mip > 0 {
+            let half = side / 2;
+            let mut next = vec![[0.0f32; 4]; half * half];
+            for j in 0..half {
+                for i in 0..half {
+                    let mut acc = [0.0f32; 4];
+                    for (dy, dx) in [(0, 0), (0, 1), (1, 0), (1, 1)] {
+                        let t = level[(2 * j + dy) * side + 2 * i + dx];
+                        for (a, t) in acc.iter_mut().zip(t) {
+                            *a += 0.25 * t;
+                        }
+                    }
+                    next[j * half + i] = acc;
+                }
+            }
+            level = next;
+            side = half;
+        }
+        for t in &level {
+            bytes.extend(t.iter().map(|c| (c.clamp(0.0, 1.0) * 255.0).round() as u8));
+        }
+    }
+    bytes
+}
+
+/// The atlas as an image: gamma bytes (`Rgba8Unorm`, as the effect lane's sprites), its mips,
+/// linear filtering, clamped.
+pub fn atlas_image() -> Image {
+    let bytes = atlas_bytes();
+    let n = ATLAS as usize;
+    let mut image = Image::new(
+        Extent3d {
+            width: ATLAS,
+            height: ATLAS,
+            depth_or_array_layers: 1,
+        },
+        TextureDimension::D2,
+        bytes[..n * n * 4].to_vec(),
+        TextureFormat::Rgba8Unorm,
+        RenderAssetUsages::RENDER_WORLD,
+    );
+    image.texture_descriptor.mip_level_count = ATLAS_MIPS;
+    image.data = Some(bytes);
+    image.sampler = ImageSampler::Descriptor(ImageSamplerDescriptor::linear());
+    image
+}
