+/// Makes the atlas, the pools and the fireflies' lights.
+pub(crate) fn setup_life(mut commands: Commands, images: Option<ResMut<Assets<Image>>>) {
+    if let Some(mut images) = images {
+        commands.insert_resource(LifeAtlas(images.add(atlas_image())));
+    }
+    let lights = (0..tune::FIREFLY_LIGHTS)
+        .map(|_| {
+            commands
+                .spawn((
+                    Name::new("firefly light"),
+                    Transform::default(),
+                    LookLight::new(tune::FIREFLY_LIGHT_COLOR, 0.0, tune::FIREFLY_LIGHT_RADIUS),
+                ))
+                .id()
+        })
+        .collect();
+    commands.insert_resource(FireflyLights(lights));
+}
