+            // The pond's surface is 0.5 up; the wander lifts a little over the birth height.
+            let top = 0.5 + tune::FIREFLY_HEIGHT.1 + tune::FIREFLY_WANDER.1;
+            assert!(p.y > 0.0 && p.y <= top + 1e-3, "low over the grass: {p}");
+        }
+        // Three times the density, still within the pools.
+        e.density = tune::SCALE_MAX;
+        run(&mut life, &e, 20.0);
+        assert!(life.counts()[0] > flies);
+        assert_eq!(life.capacities(), caps);
+    }
+
+    /// By day: no fireflies, motes about, butterflies over the open ground away from the crowns.
+    #[test]
+    fn the_day_has_motes_and_butterflies() {
+        let mut life = Life::new();
+        life.crowns = vec![crown_at(8.0, 8.0)];
+        run(&mut life, &env(12.0 * 60.0), 20.0);
+        let [flies, _, motes, butterflies] = life.counts();
+        assert_eq!(flies, 0);
+        assert!(motes as f32 >= 0.8 * tune::MOTES, "{motes}");
+        assert!(
+            butterflies >= 1 && butterflies as f32 <= tune::BUTTERFLIES,
+            "{butterflies}"
+        );
+        for b in &life.butterflies {
+            assert!(b.pos.y > 0.0 && b.pos.y < 4.0, "{}", b.pos);
+        }
+    }
+
+    /// Leaves fall from the crowns, downwind, and land; a gusty, rainy wind brings more.
+    #[test]
+    fn leaves_fall_downwind_and_land() {
+        let mut life = Life::new();
+        life.crowns = (0..8)
+            .map(|i| crown_at(-15.0 + 4.0 * i as f32, 10.0))
+            .collect();
+        let mut e = env(12.0 * 60.0);
+        let mut landed = 0;
+        let mut downwind = 0.0f32;
+        let mut field = Field { asked: 0 };
+        for _ in 0..(60.0 / e.dt) as usize {
+            life.step(&e, &mut field);
+            for l in &life.leaves {
+                if l.landed == Some(0.0) {
+                    landed += 1;
+                    downwind += l.vel.x;
+                }
+            }
+        }
+        assert!(landed >= 3, "{landed} landed");
+        assert!(downwind > 0.0, "carried downwind (+x)");
+        for l in &life.leaves {
+            assert!(l.pos.y >= tune::LEAF_LIFT - 1e-4, "never under the ground");
+        }
+        assert!(life.counts()[1] as f32 <= tune::LEAVES);
+        // Rain: more of them.
+        let calm = {
+            let mut l = Life::new();
+            l.crowns = life.crowns.clone();
+            run(&mut l, &e, 30.0);
+            l.counts()[1]
+        };
+        e.rain = 1.0;
+        let wet = {
+            let mut l = Life::new();
+            l.crowns = life.crowns.clone();
+            run(&mut l, &e, 30.0);
+            l.counts()[1]
+        };
+        assert!(wet >= calm, "{wet} in rain, {calm} dry");
+    }
+
+    /// Rain sends the fireflies, the motes and the butterflies away (softly), and they come back
+    /// after it; the leaves keep falling.
+    #[test]
+    fn rain_stops_the_fliers() {
+        let mut life = Life::new();
+        life.crowns = vec![crown_at(8.0, 8.0)];
+        let mut e = env(12.0 * 60.0);
+        run(&mut life, &e, 15.0);
+        assert!(life.mote_level > 0.0 && life.counts()[2] > 0);
+        e.rain = 0.6;
+        run(&mut life, &e, 15.0);
+        assert!(life.mote_level < 0.01, "{}", life.mote_level);
+        assert!(life.butterfly_level < 0.01);
+        assert_eq!(life.counts()[2], 0, "the motes have gone");
+        e.rain = 0.0;
+        e.wet = 1.0;
+        run(&mut life, &e, 30.0);
+        assert!(
+            life.counts()[2] as f32 > tune::MOTES * 1.5,
+            "more motes in the sun after the rain: {}",
+            life.counts()[2]
+        );
+    }
+
+    /// The motes under a crown, toward the sun through it, are mostly in shade; out in the open
+    /// they are all lit.
+    #[test]
+    fn the_crowns_shade_the_motes_but_for_shafts() {
+        let mut life = Life::new();
+        let sun = Vec3::new(0.0, 1.0, 0.3).normalize();
+        life.crowns = vec![Crown {
+            center: Vec3::new(0.0, 10.0, 3.0),
+            radius: 12.0,
+            half_height: 4.0,
+        }];
+        let mut shut = 0;
+        let n = 400;
+        for i in 0..n {
+            let p = Vec3::new(
+                (i % 20) as f32 * 0.5 - 5.0,
+                2.0,
+                (i / 20) as f32 * 0.5 - 5.0,
+            );
+            shut += usize::from(life.shaded_by_crowns(p, sun));
+        }
+        let share = shut as f32 / n as f32;
+        assert!((0.6..0.95).contains(&share), "{share} shut");
+        assert!(!life.shaded_by_crowns(Vec3::new(60.0, 2.0, 0.0), sun));
+    }
+
+    /// Leaving moves nothing out at once: what is past its radius goes, and what is new comes in
+    /// at the edge where it is faded.
+    #[test]
+    fn the_camera_moving_keeps_things_near_it() {
+        let mut life = Life::new();
+        let mut e = env(23.0 * 60.0);
+        e.sun = Vec3::new(0.7, -0.4, 0.0).normalize();
+        run(&mut life, &e, 15.0);
+        e.cam = Vec3::new(200.0, 1.7, 0.0);
+        run(&mut life, &e, 15.0);
+        for f in &life.flies {
+            let p = f.pos();
+            assert!(Vec2::new(p.x - 200.0, p.z).length() <= tune::FIREFLY_RADIUS + 0.1);
+        }
+        assert!(life.counts()[0] > 0);
+    }
+
+    #[test]
+    fn the_atlas_has_its_mips_and_shapes() {
+        let bytes = atlas_bytes();
+        let n = ATLAS as usize;
+        let total: usize = (0..ATLAS_MIPS).map(|m| (n >> m) * (n >> m) * 4).sum();
+        assert_eq!(bytes.len(), total);
+        let alpha = |i: usize, j: usize| bytes[(j * n + i) * 4 + 3];
+        // Each cell's middle is solid or bright, its corners empty.
+        assert!(alpha(32, 32) > 200, "the glow's core");
+        assert!(alpha(96, 32) > 200, "the mote");
+        assert!(alpha(32, 96) > 200, "the leaf");
+        for (i, j) in [(0, 0), (63, 63), (64, 0), (127, 127), (0, 127)] {
+            assert!(alpha(i, j) < 8, "a corner at ({i}, {j})");
+        }
+        let img = atlas_image();
+        assert_eq!(img.texture_descriptor.mip_level_count, ATLAS_MIPS);
+        assert_eq!(img.texture_descriptor.format, TextureFormat::Rgba8Unorm);
+    }
+
+    #[test]
+    fn the_brightest_flies_are_the_nearest() {
+        let mut life = Life::new();
+        let mut e = env(23.0 * 60.0);
+        e.sun = Vec3::new(0.7, -0.4, 0.0).normalize();
+        e.density = 3.0;
+        run(&mut life, &e, 20.0);
+        let mut out = [(Vec3::ZERO, 0.0); tune::FIREFLY_LIGHTS];
+        let n = life.bright_flies(e.cam, &mut out);
+        assert!(n <= tune::FIREFLY_LIGHTS);
+        for (p, g) in &out[..n] {
+            assert!(*g >= 0.3 && p.distance(e.cam) <= tune::FIREFLY_LIGHT_REACH);
+        }
+    }
+
+    /// The fade by distance: nothing at the lens, nothing past the radius, all between.
+    #[test]
+    fn sprites_fade_at_the_lens_and_the_edge() {
+        let view = SpriteView {
+            eye: Vec3::ZERO,
+            forward: Vec3::NEG_Z,
+            right: Vec3::X,
+            up: Vec3::Y,
+            px: 0.001,
+        };
+        assert_eq!(view.fade(Vec3::new(0.0, 0.0, -0.3), 30.0), 0.0);
+        assert_eq!(view.fade(Vec3::new(0.0, 0.0, -10.0), 30.0), 1.0);
+        assert_eq!(view.fade(Vec3::new(0.0, 0.0, -30.0), 30.0), 0.0);
+        let mut out = Vec::new();
+        view.glow(
+            &mut out,
+            Vec3::new(0.0, 0.0, -10.0),
+            0.3,
+            [1.0; 3],
+            1.0,
+            CELL_GLOW,
+        );
+        assert_eq!(out.len(), 4);
+        view.glow(
+            &mut out,
+            Vec3::new(0.0, 0.0, 10.0),
+            0.3,
+            [1.0; 3],
+            1.0,
+            CELL_GLOW,
+        );
+        assert_eq!(out.len(), 4, "behind the eye: nothing");
+        // Far: grown to the pixel floor and dimmed to match.
+        out.clear();
+        view.glow(
+            &mut out,
+            Vec3::new(0.0, 0.0, -1000.0),
+            0.3,
+            [1.0; 3],
+            1.0,
+            CELL_GLOW,
+        );
+        let half = (Vec3::from(out[1].pos) - Vec3::from(out[0].pos)).length() * 0.5;
+        assert!((half - 0.5 * tune::GLOW_MIN_PX * 1000.0 * 0.001).abs() < 1e-3);
+        assert!(out[0].color[3] < 0.2);
+        // A mote a yard off is held to its pixel cap at full brightness; one far off is not.
+        out.clear();
+        let near = Vec3::new(0.0, 0.0, -1.0);
+        view.glow_capped(&mut out, near, tune::MOTE_SIZE, tune::MOTE_MAX_PX, [1.0; 3], 1.0, CELL_MOTE);
+        let half = (Vec3::from(out[1].pos) - Vec3::from(out[0].pos)).length() * 0.5;
+        assert!((half - 0.5 * tune::MOTE_MAX_PX * 0.001).abs() < 1e-5, "{half}");
+        assert_eq!(out[0].color[3], 1.0);
+        out.clear();
+        view.glow_capped(&mut out, Vec3::new(0.0, 0.0, -50.0), 0.22, 9.0, [1.0; 3], 1.0, CELL_MOTE);
+        let half = (Vec3::from(out[1].pos) - Vec3::from(out[0].pos)).length() * 0.5;
+        assert!((half - 0.11).abs() < 1e-4, "{half}");
+    }
+
+    /// Fireflies are amber: red well over green, green well over blue.
+    #[test]
+    fn fireflies_are_amber() {
+        let [r, g, b] = tune::FIREFLY_RGB;
+        assert!(g / r < 0.65 && b / g < 0.25, "{:?}", tune::FIREFLY_RGB);
+        let [r, g, b] = tune::FIREFLY_LIGHT_COLOR;
+        assert!(g / r < 0.7 && b / g < 0.35);
+    }
+}
