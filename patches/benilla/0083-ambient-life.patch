+/// The shaders' `wind_hash`, on the CPU.
+fn wind_hash(n: u32) -> f32 {
+    let mut h = n.wrapping_mul(2_654_435_761);
+    h = (h ^ (h >> 15)).wrapping_mul(2_246_822_519);
+    h ^= h >> 13;
+    (h >> 8) as f32 * (1.0 / 16_777_216.0)
+}
+
+/// How hard the gusts blow at `p` (world x, z) under the block `rows`: the shaders' `wind_gust`
+/// on the CPU, for what moves in the wind outside the vertex stage (`look::life`'s falling
+/// leaves), so a leaf lifts as the front that bends its tree passes. Zero when the block is off.
+pub fn gust_at(rows: &[[f32; 4]; WIND_ROWS], p: Vec2) -> f32 {
+    if rows[0][3] < 0.5 || rows[1][1] <= 0.0 || rows[2][3] <= 0.0 {
+        return 0.0;
+    }
+    let dir = Vec2::new(rows[0][0], rows[0][1]);
+    let q = p - Vec2::new(rows[2][0], rows[2][1]);
+    let along = q.dot(dir);
+    let across = q.dot(Vec2::new(-dir.y, dir.x));
+    let a = along + 18.0 * (across * 0.013 + 1.7).sin() + 9.0 * (across * 0.031).sin();
+    let x = (a - rows[1][2]) / rows[1][1];
+    let k = (x + 0.5).floor();
+    let f = x - k;
+    let n = (k as i32).wrapping_sub(rows[1][3] as i32);
+    let w = rows[2][3];
+    let patchy = 0.55 + 0.45 * (across * 0.009 + n as f32 * 2.1).sin();
+    rows[1][0] * (0.35 + 0.65 * wind_hash(n as u32)) * patchy * (-(f * f) / (w * w)).exp()
+}
