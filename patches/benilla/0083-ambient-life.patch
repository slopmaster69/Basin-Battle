+/// `looklife <density>`, benilla's own (1.12 has no such command): scales how much ambient life
+/// the new look puts about the camera (`benilla_world::look::life`: fireflies, falling leaves,
+/// motes in the sun, butterflies) from 0 (none) to 3, for tuning on film; `looklife grade`, or no
+/// argument, follows the hour again. Says what is out now. `worldLife 0` and the classic look
+/// (`worldLook 0`) have none.
+fn look_life(world: &mut World, args: &str) -> Vec<String> {
+    use benilla_world::look::life::Life;
+    use benilla_world::look::{LookLife, WorldLook};
+    let Some(density) = LookLife::parse(args) else {
+        return vec!["Usage: looklife <0-3> | grade".to_string()];
+    };
+    let (on, scale) = {
+        let mut life = world.get_resource_or_init::<LookLife>();
+        life.density = density;
+        (life.on, life.scale())
+    };
+    let mut lines = vec![match density {
+        None => "Life follows the hour.".to_string(),
+        Some(d) => format!("Life held at {d} times the hour's."),
+    }];
+    if let Some(life) = world.get_resource::<Life>() {
+        // What the new density asks for: the pools fill or thin to it over a few seconds, so the
+        // counts out now are still the old setting's (take 280: "held at 0" answered "60
+        // fireflies out").
+        let [flies, leaves, motes, butterflies] = life.wanted(scale);
+        lines.push(format!(
+            "Wanted at this hour: {flies} fireflies, up to {leaves} leaves, {motes} motes, \
+             {butterflies} butterflies (they come or go over a few seconds)."
+        ));
+        let [flies, leaves, motes, butterflies] = life.counts();
+        lines.push(format!(
+            "Out before this change: {flies} fireflies ({} ahead of the camera), {leaves} leaves, \
+             {motes} motes, {butterflies} butterflies.",
+            life.flies_ahead()
+        ));
+        let (trees, crowns) = life.trees();
+        lines.push(format!(
+            "Trees near: {trees}, {crowns} crowns dropping leaves; motes in the sun: {}.",
+            life.lit_motes()
+        ));
+    }
+    if let Some(mut life) = world.get_resource_mut::<Life>() {
+        // What became of the leaves since the last `looklife`: which limit keeps them few.
+        let t = life.take_leaf_tally();
+        lines.push(format!(
+            "Leaves since the last looklife: {} rolls, {} born, {} spots with no ground, {} too \
+             low; {} lay and went, {} blew out of reach, {} fell too long; {:.1} s a leaf.",
+            t.rolls,
+            t.born,
+            t.no_ground,
+            t.too_low,
+            t.rested,
+            t.out_of_reach,
+            t.too_old,
+            t.mean_life()
+        ));
+    }
+    if !on {
+        lines.push("worldLife is 0: no ambient life.".to_string());
+    }
+    if !world.get_resource::<WorldLook>().is_some_and(|l| l.on) {
+        lines.push("The classic look (worldLook 0) has no ambient life.".to_string());
+    }
+    lines
+}
