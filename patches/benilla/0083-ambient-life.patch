+/// A tree's crown near the camera: an upright ellipsoid.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Crown {
+    pub center: Vec3,
+    /// Across (yd) and half its height.
+    pub radius: f32,
+    pub half_height: f32,
+}
+
+impl Crown {
+    /// The crown of a tree placed at `tf` whose model's authored box (WoW model space, Z up) runs
+    /// from `min` to `max`: the box's upper part, a little inside its sides. `None` for a box too
+    /// small to be a tree.
+    pub fn of(tf: &Transform, min: [f32; 3], max: [f32; 3]) -> Option<Self> {
+        let s = tf.scale.x.abs().max(0.01);
+        let height = (max[2] - min[2]) * s;
+        if height < 2.5 {
+            return None;
+        }
+        let bottom = min[2] + 0.4 * (max[2] - min[2]);
+        let mid = [
+            0.5 * (min[0] + max[0]),
+            0.5 * (min[1] + max[1]),
+            0.5 * (bottom + max[2]),
+        ];
+        let center = tf.transform_point(benilla_assets::coords::wow_to_bevy(mid));
+        let radius = 0.4 * (max[0] - min[0]).max(max[1] - min[1]) * s;
+        Some(Self {
+            center,
+            radius: radius.max(1.0),
+            half_height: (0.5 * (max[2] - bottom) * s).max(1.0),
+        })
+    }
+
+    /// The crown of a tree placed at `tf` from its model: `leaves`, the box of its alpha-tested
+    /// batches' vertices (WoW model space), the crown itself, a little inside its sides; without
+    /// leaves the box `whole` (its vertices', else its header's) as [`Self::of`] reads it. `None`
+    /// for a model under [`tune::TREE_MIN_HEIGHT`] tall at its scale.
+    pub fn of_model(
+        tf: &Transform,
+        whole: ([f32; 3], [f32; 3]),
+        leaves: Option<([f32; 3], [f32; 3])>,
+    ) -> Option<Self> {
+        let s = tf.scale.x.abs().max(0.01);
+        let (min, max) = whole;
+        if (max[2] - min[2]) * s < tune::TREE_MIN_HEIGHT {
+            return None;
+        }
+        let Some((lo, hi)) = leaves.filter(|(lo, hi)| hi[2] > lo[2]) else {
+            return Self::of(tf, min, max);
+        };
+        let mid = [
+            0.5 * (lo[0] + hi[0]),
+            0.5 * (lo[1] + hi[1]),
+            0.5 * (lo[2] + hi[2]),
+        ];
+        let center = tf.transform_point(benilla_assets::coords::wow_to_bevy(mid));
+        Some(Self {
+            center,
+            radius: (0.45 * (hi[0] - lo[0]).max(hi[1] - lo[1]) * s).max(1.0),
+            half_height: (0.5 * (hi[2] - lo[2]) * s).max(1.0),
+        })
+    }
+
+    /// Whether a ray from `p` along `dir` (unit) passes through the crown.
+    pub fn blocks(&self, p: Vec3, dir: Vec3) -> bool {
+        let k = Vec3::new(self.radius, self.half_height, self.radius);
+        let o = (p - self.center) / k;
+        let d = dir / k;
+        let a = d.length_squared();
+        let b = o.dot(d);
+        let c = o.length_squared() - 1.0;
+        if c < 0.0 {
+            return true; // inside the crown
+        }
+        let disc = b * b - a * c;
+        disc >= 0.0 && b < 0.0
+    }
+}
+
+/// What the world answers the life about places: implemented over the terrain, the water and the
+/// collision world in the app, and over a flat field in the tests.
+pub trait LifeWorld {
+    /// The ground's height (Bevy y) under (x, z), `None` off the loaded world.
+    fn ground(&mut self, x: f32, z: f32) -> Option<f32>;
+    /// The water's surface (Bevy y) over (x, z) if water lies above `ground` there.
+    fn water(&mut self, x: f32, z: f32, ground: f32) -> Option<f32>;
+    /// Whether nothing solid (a hill, a building) stands between `p` and the sun along `to_sun`.
+    fn sunlit(&mut self, p: Vec3, to_sun: Vec3) -> bool;
+}
