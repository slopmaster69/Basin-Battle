+/// Whether the life is out this frame: the new look and `worldLife` on, the camera outdoors and
+/// above water.
+fn life_shown(
+    look: &WorldLook,
+    life: &LookLife,
+    claim: Option<&crate::wmo_portal::CameraInteriorClaim>,
+    underwater: Option<&crate::liquid::Underwater>,
+) -> bool {
+    look.on
+        && life.on
+        && !claim.is_some_and(|c| c.0.is_some_and(|c| !c.exterior_visible))
+        && !underwater.is_some_and(|u| u.0.any())
+}
