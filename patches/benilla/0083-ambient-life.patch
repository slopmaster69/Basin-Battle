+/// Every tunable of the ambient life, in one place. A first pass, to tune on film with
+/// `looklife`. Counts are at `looklife 1`, lengths in yards, times in seconds, minutes of the game
+/// day for the hours, colours the gamma frame's (an additive colour over 1 blooms).
+pub mod tune {
+    /// `looklife` scales every count by up to this; the pools hold this many times each count.
+    pub const SCALE_MAX: f32 = 3.0;
+    /// At most this many of a kind are born in one frame, so a scene fills over a few seconds.
+    pub const SPAWN_PER_FRAME: usize = 2;
+    /// Nothing nearer the camera than the first is drawn; it fades in by the second.
+    pub const NEAR_FROM: f32 = 0.6;
+    pub const NEAR_TO: f32 = 2.0;
+    /// A thing fades out over the outer share of its radius, and goes past it.
+    pub const EDGE_FADE: f32 = 0.25;
+    /// The smallest a glow is drawn on screen (pixels across): farther ones grow to this and dim
+    /// to match, so a far firefly is a faint point rather than a flickering sub-pixel.
+    pub const GLOW_MIN_PX: f32 = 3.0;
+    /// Where fireflies and motes are born: this share of them within [`AHEAD_DEG`] of the view's
+    /// heading (either side), the rest anywhere round the camera. Take 280 saw 2 to 6 fireflies a
+    /// frame of the 27 to 60 out: born evenly all round the camera, three in four were behind or
+    /// beside it, and of the rest the far quarter fades at the edge. Those born ahead stay where
+    /// they are when the camera turns, so nothing pops.
+    pub const AHEAD: f32 = 0.75;
+    pub const AHEAD_DEG: f32 = 50.0;
+
+    // ---- the weather ----
+    /// Rain from the first density to the second stops the fireflies, the butterflies and the
+    /// motes; they fade out (and back after the rain) over about this long.
+    pub const RAIN_STOP_FROM: f32 = 0.02;
+    pub const RAIN_STOP_TO: f32 = 0.2;
+    pub const WEATHER_FADE_S: f32 = 2.5;
+    /// While the ground is still wet after rain, this many more motes (a share, at soaked).
+    pub const MOTES_AFTER_RAIN: f32 = 1.5;
+
+    // ---- fireflies ----
+    /// How many around the camera at full night, and how far out.
+    pub const FIREFLIES: f32 = 30.0;
+    pub const FIREFLY_RADIUS: f32 = 30.0;
+    /// They come out over the first pair of minutes (19:45 to 21:00, after Elwynn's 19:30 dusk)
+    /// and go over the second (04:15 to 05:30, before first light).
+    pub const FIREFLY_IN: (f32, f32) = (1185.0, 1260.0);
+    pub const FIREFLY_OUT: (f32, f32) = (255.0, 330.0);
+    /// Where they are born: the chance a spot in the open keeps one, beside the trees (within the
+    /// reach of a crown's edge) and over the water.
+    pub const FIREFLY_OPEN: f32 = 0.3;
+    pub const FIREFLY_WOODS: f32 = 1.0;
+    pub const FIREFLY_WOODS_REACH: f32 = 8.0;
+    pub const FIREFLY_WATER: f32 = 1.0;
+    /// How high over the ground or the water (yards, from and to).
+    pub const FIREFLY_HEIGHT: (f32, f32) = (0.5, 2.4);
+    /// A life (from, to), and how long it fades in and out.
+    pub const FIREFLY_LIFE: (f32, f32) = (12.0, 30.0);
+    pub const FIREFLY_FADE_S: f32 = 1.5;
+    /// The drift: how far a firefly wanders from where it was born (across, up), and how slowly
+    /// (radians a second, from and to).
