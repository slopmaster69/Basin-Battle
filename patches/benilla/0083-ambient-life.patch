+/// `worldLife` and the film's hold: `on` (on by default, inert under the classic look) and
+/// `density`, a scale on every count from 0 to [`tune::SCALE_MAX`] (`looklife`).
+#[derive(Resource, Clone, Copy, Debug, PartialEq)]
+pub struct LookLife {
+    pub on: bool,
+    pub density: Option<f32>,
+}
+
+impl Default for LookLife {
+    /// On, the `worldLife` CVar's registered "1".
+    fn default() -> Self {
+        Self {
+            on: true,
+            density: None,
+        }
+    }
+}
+
+impl LookLife {
+    /// `looklife`'s argument: a density from 0 to [`tune::SCALE_MAX`], or nothing (or `grade`) to
+    /// follow the hour again; `None` for anything else, which changes nothing.
+    pub fn parse(args: &str) -> Option<Option<f32>> {
+        let mut words = args.split_whitespace();
+        let held = match words.next() {
+            None => None,
+            Some(w) if w.eq_ignore_ascii_case("grade") => None,
+            Some(w) => Some(
+                w.parse::<f32>()
+                    .ok()
+                    .filter(|v| (0.0..=tune::SCALE_MAX).contains(v))?,
+            ),
+        };
+        words.next().is_none().then_some(held)
+    }
+
+    /// The density this frame: the hold, else 1.
+    pub fn scale(&self) -> f32 {
+        self.density.unwrap_or(1.0)
+    }
+}
+
+/// Whether a doodad's model may be a tree a leaf falls from: a plant the wind sways
+/// ([`wind::sways`]) whose file is not a bush, a fern or the like (they sit in trees folders
+/// too). Its size decides the rest ([`Crown::of_model`]: [`tune::TREE_MIN_HEIGHT`]). The path no
+/// longer has to name a tree or a canopy: take 273 found almost no leaves at Crystal Lake (1 out
+/// at the grade's density, where 48 crowns give about 6), its oaks swaying in the wind but not
+/// taken for trees.
+pub fn is_tree(path: &str) -> bool {
+    const LOW: [&str; 12] = [
+        "bush", "shrub", "fern", "grass", "flower", "reed", "cattail", "weed", "wheat", "vine",
+        "ivy", "hedge",
+    ];
+    if !wind::sways(path) {
+        return false;
+    }
+    let p = path.to_ascii_lowercase();
+    let file = p.rsplit(['\\', '/']).next().unwrap_or(&p);
+    !LOW.iter().any(|w| file.contains(w))
+}
+
+fn smoothstep(e0: f32, e1: f32, x: f32) -> f32 {
+    let t = ((x - e0) / (e1 - e0)).clamp(0.0, 1.0);
+    t * t * (3.0 - 2.0 * t)
+}
+
+/// A span of the day that comes in over `inn` and goes over `out` (minutes; `inn` before `out`
+/// for a day span, after it for one across midnight): 0 to 1.
+pub fn hour_window(minute: f32, inn: (f32, f32), out: (f32, f32)) -> f32 {
+    let m = minute.rem_euclid(1440.0);
+    if inn.0 < out.0 {
+        smoothstep(inn.0, inn.1, m) * (1.0 - smoothstep(out.0, out.1, m))
+    } else {
+        // Across midnight: in after `inn`, or before `out` is done.
+        smoothstep(inn.0, inn.1, m).max(1.0 - smoothstep(out.0, out.1, m))
+    }
+}
+
+/// The fireflies' hour: out after dusk, gone before dawn.
+pub fn firefly_hour(minute: f32) -> f32 {
+    hour_window(minute, tune::FIREFLY_IN, tune::FIREFLY_OUT)
+}
+
+/// The leaves' hour: by day, a little at night.
+pub fn leaf_hour(minute: f32) -> f32 {
+    tune::LEAF_NIGHT
+        + (1.0 - tune::LEAF_NIGHT) * hour_window(minute, tune::LEAF_DAY_IN, tune::LEAF_DAY_OUT)
+}
+
+/// The butterflies' hour.
+pub fn butterfly_hour(minute: f32) -> f32 {
+    hour_window(minute, tune::BUTTERFLY_DAY_IN, tune::BUTTERFLY_DAY_OUT)
+}
+
+/// The fair-weather share: 1 dry, 0 once the rain is past [`tune::RAIN_STOP_TO`].
+pub fn fair(rain: f32) -> f32 {
+    1.0 - smoothstep(tune::RAIN_STOP_FROM, tune::RAIN_STOP_TO, rain)
+}
+
+/// A firefly's flash at `t` seconds of its life: one soft pulse a `period`, at `offset` in it,
+/// over a floor.
+pub fn blink(t: f32, period: f32, offset: f32) -> f32 {
+    let c = ((t / period.max(0.1)) + offset).rem_euclid(1.0) - 0.5;
+    let w = tune::FIREFLY_BLINK_WIDTH;
+    tune::FIREFLY_BLINK_FLOOR + (1.0 - tune::FIREFLY_BLINK_FLOOR) * (-(c * c) / (w * w)).exp()
+}
+
+/// How a mote is seen against the sun: dim looking away, bright looking into it. `view` runs from
+/// the camera to the mote, `to_sun` toward the sun, both unit.
+pub fn mote_phase(view: Vec3, to_sun: Vec3) -> f32 {
+    let c = view.dot(to_sun).max(0.0);
+    tune::MOTE_BACK + (1.0 - tune::MOTE_BACK) * c.powf(tune::MOTE_LOBE)
+}
