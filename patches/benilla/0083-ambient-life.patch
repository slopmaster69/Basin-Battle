+/// Looks for the tree crowns near the camera every so often.
+pub(crate) fn scan_crowns(
+    inputs: LifeInputs,
+    cam: Query<&GlobalTransform, With<WorldCamera>>,
+    placements: Option<Res<crate::terrain_stream::Placements>>,
+    models: Option<Res<Assets<benilla_assets::M2Model>>>,
+    mut life: ResMut<Life>,
+    // Each tree model's boxes, measured once (its vertices are resident on the CPU).
+    mut boxes: Local<bevy::platform::collections::HashMap<AssetId<benilla_assets::M2Model>, Option<TreeBoxes>>>,
+) {
+    let (Some(placements), Some(models)) = (placements, models) else {
+        return;
+    };
+    if !inputs.shown() {
+        return;
+    }
+    let Ok(cam) = cam.single() else { return };
+    let cam = cam.translation();
+    if !life.wants_scan(cam) {
+        return;
+    }
+    let reach = tune::LEAF_RADIUS + 30.0;
+    let mut seen = 0;
+    let trees = placements.trees().filter_map(|(tf, model)| {
+        if tf.translation.distance_squared(cam) > reach * reach {
+            return None;
+        }
+        seen += 1;
+        let boxes = *boxes
+            .entry(model)
+            .or_insert_with(|| models.get(model).and_then(tree_boxes));
+        let (whole, leaves) = boxes?;
+        Crown::of_model(tf, whole, leaves)
+    });
+    life.set_crowns(cam, trees);
+    life.trees_near = seen;
+}
+
+/// A tree model's boxes, WoW model space: the whole model's (its vertices', else its header's)
+/// and its leaves' (the alpha-tested batches' vertices), `None` without either.
+type TreeBoxes = (([f32; 3], [f32; 3]), Option<([f32; 3], [f32; 3])>);
+
+fn tree_boxes(m: &benilla_assets::M2Model) -> Option<TreeBoxes> {
+    let grow = |b: &mut Option<([f32; 3], [f32; 3])>, p: &[f32; 3]| {
+        let (lo, hi) = b.get_or_insert((*p, *p));
+        for i in 0..3 {
+            lo[i] = lo[i].min(p[i]);
+            hi[i] = hi[i].max(p[i]);
+        }
+    };
+    let (mut whole, mut leaves) = (None, None);
+    for sub in &m.submeshes {
+        let leaf = sub.blend == benilla_formats::ModelBlend::AlphaTest;
+        for p in &sub.geometry.positions {
+            grow(&mut whole, p);
+            if leaf {
+                grow(&mut leaves, p);
+            }
+        }
+    }
+    let whole = whole.or_else(|| m.bounds.as_ref().map(|b| (b.bbox_min, b.bbox_max)))?;
+    Some((whole, leaves))
+}
+
+/// One frame of the life.
+pub(crate) fn step_life(
+    inputs: LifeInputs,
+    cam: Query<&GlobalTransform, With<WorldCamera>>,
+    places: LifePlaces,
+    mut life: ResMut<Life>,
+) {
+    if !inputs.shown() {
+        if life.counts() != [0; 4] || !life.crowns.is_empty() {
+            life.clear();
+        }
+        return;
+    }
+    let Ok(cam) = cam.single() else { return };
+    let w = inputs.weather.as_deref().filter(|w| w.on);
+    let forward = cam.forward();
+    let env = LifeEnv {
+        cam: cam.translation(),
+        heading: Vec2::new(forward.x, forward.z).normalize_or_zero(),
+        dt: inputs.time.delta_secs(),
+        minute: inputs.clock.minute as f32,
+        density: inputs.switch.scale(),
+        rain: w.map_or(0.0, |w| w.rain),
+        wet: w.map_or(0.0, |w| w.wet),
+        overcast: w.map_or(0.0, |w| w.overcast),
+        rays: inputs.grade.post.rays * inputs.grade.strength,
+        sun: inputs.light.celestial_dir,
+        sun_clear: if inputs.sky.on {
+            inputs.sky.sun_clear
+        } else {
+            1.0
+        },
+        sun_rgb: inputs.light.diffuse,
+        wind: inputs.wind.rows,
+    };
+    let mut world = PlacesWorld {
+        places: &places,
+        filter: crate::collision::WorldCollision::body_filter(),
+    };
+    life.step(&env, &mut world);
+}
+
+/// Moves the fireflies' lights onto the nearest flashing ones, glowing as they glow; dark when
+/// there are none.
+pub(crate) fn light_fireflies(
+    life: Res<Life>,
+    lights: Res<FireflyLights>,
+    cam: Query<&GlobalTransform, With<WorldCamera>>,
+    mut q: Query<(&mut Transform, &mut LookLight)>,
+) {
+    let mut bright = [(Vec3::ZERO, 0.0f32); tune::FIREFLY_LIGHTS];
+    let n = cam
+        .single()
+        .map_or(0, |c| life.bright_flies(c.translation(), &mut bright));
+    for (i, &e) in lights.0.iter().enumerate() {
+        let Ok((mut tf, mut light)) = q.get_mut(e) else {
+            continue;
+        };
+        let (pos, glow) = if i < n {
+            bright[i]
+        } else {
+            (tf.translation, 0.0)
+        };
+        let intensity = tune::FIREFLY_LIGHT * glow;
+        if tf.translation != pos {
+            tf.translation = pos;
+        }
+        if light.intensity != intensity {
+            light.intensity = intensity;
+        }
+    }
+}
+
+/// The camera's terms for the sprites.
+struct SpriteView {
+    eye: Vec3,
+    forward: Vec3,
+    right: Vec3,
+    up: Vec3,
+    /// World size of a pixel per yard of view depth.
+    px: f32,
+}
+
+impl SpriteView {
+    /// The fade by distance: in from [`tune::NEAR_FROM`] and out over the last
+    /// [`tune::EDGE_FADE`] of `radius` (measured flat from the eye).
+    fn fade(&self, p: Vec3, radius: f32) -> f32 {
+        let d = p.distance(self.eye);
+        let flat = Vec2::new(p.x - self.eye.x, p.z - self.eye.z).length();
+        smoothstep(tune::NEAR_FROM, tune::NEAR_TO, d)
+            * (1.0 - smoothstep(radius * (1.0 - tune::EDGE_FADE), radius, flat))
+    }
+
+    /// [`Self::glow`], no bigger on screen than `max_px` pixels across however near: a near
+    /// glow shrinks to it, keeping its brightness at the core.
+    #[allow(clippy::too_many_arguments)]
+    fn glow_capped(
+        &self,
+        out: &mut Vec<EffectVertex>,
+        p: Vec3,
+        size: f32,
+        max_px: f32,
+        rgb: [f32; 3],
+        a: f32,
+        cell: [f32; 2],
+    ) {
+        let z = (p - self.eye).dot(self.forward);
+        self.glow(out, p, size.min(max_px * z.max(0.0) * self.px), rgb, a, cell);
+    }
+
+    /// A camera-facing glow of `size` yards across at `p`, grown to [`tune::GLOW_MIN_PX`] and
+    /// dimmed to match when far.
+    fn glow(
+        &self,
+        out: &mut Vec<EffectVertex>,
+        p: Vec3,
+        size: f32,
+        rgb: [f32; 3],
+        a: f32,
+        cell: [f32; 2],
+    ) {
+        let z = (p - self.eye).dot(self.forward);
+        if z <= 0.05 || a <= 0.002 {
+            return;
+        }
+        let half = 0.5 * size;
+        let min_half = 0.5 * tune::GLOW_MIN_PX * z * self.px;
+        let (half, a) = if half < min_half {
+            (min_half, a * (half / min_half).powi(2))
+        } else {
+            (half, a)
+        };
+        let r = self.right * half;
+        let u = self.up * half;
+        quad(
+            out,
+            [p - r - u, p + r - u, p + r + u, p - r + u],
+            cell,
+            [rgb[0], rgb[1], rgb[2], a.min(1.0)],
+        );
+    }
+}
+
+/// One quad of a cell, perimeter order (bl, br, tr, tl).
+fn quad(out: &mut Vec<EffectVertex>, corners: [Vec3; 4], cell: [f32; 2], color: [f32; 4]) {
+    let (u0, u1) = (cell[0], cell[0] + 0.5);
+    let (v0, v1) = (cell[1], cell[1] + 0.5);
+    for (pos, uv) in [
+        (corners[0], [u0, v1]),
+        (corners[1], [u1, v1]),
+        (corners[2], [u1, v0]),
+        (corners[3], [u0, v0]),
+    ] {
+        out.push(EffectVertex {
+            pos: pos.to_array(),
+            uv,
+            color,
+        });
+    }
+}
+
+impl Life {
+    /// The glows (fireflies and motes), additive, onto `out`.
+    fn push_glows(&self, out: &mut Vec<EffectVertex>, view: &SpriteView) {
+        if self.fly_level > 0.0 {
+            for f in &self.flies {
+                let p = f.pos();
+                let a = f.glow() * self.fly_level * view.fade(p, tune::FIREFLY_RADIUS);
+                view.glow(out, p, tune::FIREFLY_SIZE, tune::FIREFLY_RGB, a, CELL_GLOW);
+            }
+        }
+        if self.mote_level > 0.0 {
+            for m in &self.motes {
+                let to = m.pos - view.eye;
+                let Some(dir) = to.try_normalize() else {
+                    continue;
+                };
+                let f = tune::MOTE_FADE_S;
+                let life = smoothstep(0.0, f, m.age) * smoothstep(0.0, f, m.life - m.age);
+                let tw = 1.0 - tune::MOTE_TWINKLE
+                    + tune::MOTE_TWINKLE
+                        * (0.5
+                            + 0.5
+                                * (m.age * m.twinkle_hz * std::f32::consts::TAU + m.twinkle_phase)
+                                    .sin());
+                let a = self.mote_level
+                    * m.lit
+                    * life
+                    * tw
+                    * mote_phase(dir, self.mote_sun)
+                    * view.fade(m.pos, tune::MOTE_RADIUS);
+                view.glow_capped(
+                    out,
+                    m.pos,
+                    tune::MOTE_SIZE,
+                    tune::MOTE_MAX_PX,
+                    self.mote_rgb,
+                    a.min(1.0),
+                    CELL_MOTE,
+                );
+            }
+        }
+    }
+
+    /// The leaves and the butterflies, alpha-blended and lit by the hour, onto `out`.
+    fn push_sprites(&self, out: &mut Vec<EffectVertex>, view: &SpriteView) {
+        for l in &self.leaves {
+            let rest = l.landed.map_or(1.0, |t| {
+                1.0 - smoothstep(0.3 * tune::LEAF_REST_S, tune::LEAF_REST_S, t)
+            });
+            let a = rest * smoothstep(0.0, 0.6, l.age) * view.fade(l.pos, tune::LEAF_RADIUS);
+            if a <= 0.01 {
+                continue;
+            }
+            // Tumbling as it falls; lying flat once down.
+            let rot = if l.landed.is_some() {
+                Quat::from_rotation_y(l.angle)
+            } else {
+                Quat::from_axis_angle(l.axis, l.angle) * Quat::from_rotation_y(l.angle * 0.37)
+            };
+            let along = rot * Vec3::Z * (0.5 * l.size);
+            let across = rot * Vec3::X * (0.25 * l.size);
+            let p = l.pos;
+            let c = l.color;
+            quad(
+                out,
+                [
+                    p - across + along,
+                    p + across + along,
+                    p + across - along,
+                    p - across - along,
+                ],
+                CELL_LEAF,
+                [c[0], c[1], c[2], a],
+            );
+        }
+        if self.butterfly_level <= 0.0 {
+            return;
+        }
+        for b in &self.butterflies {
+            let a = self.butterfly_level
+                * smoothstep(0.0, 1.0, b.age)
+                * view.fade(b.pos, tune::BUTTERFLY_RING.1 + 4.0);
+            if a <= 0.01 {
+                continue;
+            }
+            let fwd = Vec3::new(b.heading.cos(), 0.0, b.heading.sin());
+            let side = Vec3::new(-fwd.z, 0.0, fwd.x);
+            let flap = tune::FLAP_LIFT
+                + tune::FLAP * (b.age * b.flap_hz * std::f32::consts::TAU + b.flap_phase).sin();
+            let half_len = fwd * (0.5 * tune::WING_LEN);
+            let c = b.color;
+            for dir in [1.0f32, -1.0] {
+                let out_dir = (side * dir * flap.cos() + Vec3::Y * flap.sin()) * tune::WING_SPAN;
+                let p = b.pos;
+                // The hinge along the body at u = 0, the wing's tip edge at u = 1; v runs head (0)
+                // to tail (1).
+                let corners = [
+                    p - half_len,
+                    p - half_len + out_dir,
+                    p + half_len + out_dir,
+                    p + half_len,
+                ];
+                // `quad`'s order is (bl, br, tr, tl) = (u0 v1, u1 v1, u1 v0, u0 v0): the tail at
+                // v1, the head at v0, either wing.
+                quad(out, corners, CELL_WING, [c[0], c[1], c[2], a]);
+            }
+        }
+    }
+}
+
+/// Pushes the frame's life onto the effect stream: the glows additive (fogged toward black, so
+/// the far ones fade into the dark), the leaves and the butterflies alpha-blended and lit by the
+/// scene's light.
+pub(crate) fn push_life(
+    life: Option<Res<Life>>,
+    atlas: Option<Res<LifeAtlas>>,
+    look: Res<WorldLook>,
+    switch: Res<LookLife>,
+    cam: Query<(Entity, &GlobalTransform, &Camera, &Projection), With<WorldCamera>>,
+    mut quads: ResMut<EffectQuads>,
+) {
+    let (Some(life), Some(atlas)) = (life, atlas) else {
+        return;
+    };
+    if !look.on || !switch.on || life.counts() == [0; 4] {
+        return;
+    }
+    let Ok((cam_entity, cam_tf, camera, proj)) = cam.single() else {
+        return;
+    };
+    let Some(vp) = camera.physical_viewport_size().filter(|v| v.y > 0) else {
+        return;
+    };
+    let fov = match proj {
+        Projection::Perspective(p) => p.fov,
+        _ => crate::view::CAM_FOVY,
+    };
+    let view = SpriteView {
+        eye: cam_tf.translation(),
+        forward: cam_tf.forward().as_vec3(),
+        right: cam_tf.right().as_vec3(),
+        up: cam_tf.up().as_vec3(),
+        px: 2.0 * (0.5 * fov).tan() / vp.y as f32,
+    };
+    let spec = |blend: EffectBlend, fog: EffectFog, lighting: EffectLighting| EffectDrawSpec {
+        cam: cam_entity,
+        texture: atlas.0.id(),
+        blend,
+        fog,
+        lighting,
+        anchor: view.eye,
+        bias: 0.0,
+        raster_bias: 0,
+        raster_slope: 0.0,
+        cam_relative: false,
+        no_depth_test: false,
+        main_entity: Entity::PLACEHOLDER,
+        light: None,
+        clip: None,
+    };
+    let start = quads.begin();
+    life.push_glows(&mut quads.verts, &view);
+    quads.commit_quads(
+        start,
+        spec(EffectBlend::Add, EffectFog::Black, EffectLighting::None),
+    );
+    let start = quads.begin();
+    life.push_sprites(&mut quads.verts, &view);
+    quads.commit_quads(
+        start,
+        spec(EffectBlend::Alpha, EffectFog::Scene, EffectLighting::Scene),
+    );
+}
+
+pub(crate) fn init_resources(app: &mut App) {
+    app.init_resource::<LookLife>()
+        .init_resource::<Life>()
+        .init_resource::<FireflyLights>();
+}
