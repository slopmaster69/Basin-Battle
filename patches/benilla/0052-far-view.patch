@@ -63,14 +63,51 @@ impl Viewer {
 
 /// View distance in yards. `farclip`, the `farclip` CVar, is the one view distance: the detailed
 /// world's far wall and the reach of terrain residency; its default, 350, is the reference's
-/// registered one.
+/// registered one. Under the new look ([`Self::look`]) the world reaches further than the CVar
+/// says, by [`look_reach`]; every consumer reads [`Self::reach`].
 /// `nearclip` shares the resource because `0x511bc0` stamps both onto the camera every frame, the
 /// `nearclip` record's float to `[cam+0x38]` (`0x511bd4`) and the `farclip` one's to `[cam+0x3c]`.
 #[derive(Resource, Clone, Copy)]
 pub struct ViewDistance {
+    /// The `farclip` CVar, in 1.12's range ([`FARCLIP_RANGE`]) under either look.
     pub farclip: f32,
     /// The camera near plane in yards, the `nearclip` CVar ([`stamp_near_clip`]).
     pub nearclip: f32,
+    /// The new look's longer view (benilla's own, `crate::look`), kept in step with
+    /// `look::WorldLook`; `false` is the reference's view distance exactly.
+    pub look: bool,
+}
+
+/// The new look's view distance at the default `farclip` (350): Elwynn's own fog ends near
+/// 500 yd by day, and the new look's grade pushes it out to meet this.
+pub const LOOK_REACH_DEFAULT: f32 = 1200.0;
+
+/// The new look's longest view, at `farclip` 777, the 1.12 slider's top.
+pub const LOOK_REACH_MAX: f32 = 2000.0;
+
+/// The new look's reach at three `farclip` stops: the slider's bottom, the registered default and
+/// the slider's top. Piecewise linear between them, so the 1.12 slider keeps working over its whole
+/// travel under either look, and the `farclip` CVar keeps the reference's range and refusal.
+const LOOK_REACH_STOPS: [(f32, f32); 3] = [
+    (177.0, 600.0),
+    (350.0, LOOK_REACH_DEFAULT),
+    (777.0, LOOK_REACH_MAX),
+];
+
+/// The new look's view distance for a `farclip` CVar value (benilla's own): 177 → 600 yd, 350 →
+/// 1200, 777 → 2000, linear between, held at the ends.
+pub fn look_reach(farclip: f32) -> f32 {
+    let [(x0, y0), (x1, y1), (x2, y2)] = LOOK_REACH_STOPS;
+    let seg = |a: f32, fa: f32, b: f32, fb: f32| fa + (fb - fa) * ((farclip - a) / (b - a));
+    if farclip <= x0 {
+        y0
+    } else if farclip <= x1 {
+        seg(x0, y0, x1, y1)
+    } else if farclip <= x2 {
+        seg(x1, y1, x2, y2)
+    } else {
+        y2
+    }
 }
 
