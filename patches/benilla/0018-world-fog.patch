diff --git a/crates/benilla-world/src/lighting/fog_override.rs b/crates/benilla-world/src/lighting/fog_override.rs
new file mode 100644
index 00000000..113c5fb6
--- /dev/null
+++ b/crates/benilla-world/src/lighting/fog_override.rs
@@ -0,0 +1,167 @@
+//! A scripted outdoor atmosphere, benilla's own (no reference behaviour): an add-on's
+//! `SetWorldFog` (benilla-ui `action_combat`) blends the sampled scene fog toward its own colour
+//! and distance, and can darken the light toward a Duskwood-like gloom, eased in and out over a
+//! given time. It acts on the outdoor sample only, so a WMO interior's MFOG crossfade still takes
+//! over indoors from the overridden scene fog, and the underwater param keeps its own fog.
+
+use benilla_formats::Atmosphere;
+use bevy::prelude::*;
+
+/// The look the override blends toward.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct FogLook {
+    /// sRGB 0..1, as the fog band's colour.
+    pub color: [f32; 3],
+    /// Fog end in yards (the consumer still takes `min(end, farclip)`).
+    pub end: f32,
+    /// Fog start as a fraction of the end (negative puts fog at the eye).
+    pub start_frac: f32,
+    /// 0..1: how much the ambient, the sun and the sky are dimmed at full weight.
+    pub darken: f32,
+}
+
+/// The scripted override and its ease: `weight` moves from `from` to `to` over `secs` from
+/// `started` (smoothstep). A weight of 0 leaves the atmosphere as sampled.
+#[derive(Resource, Clone, Debug, Default)]
+pub struct FogOverride {
+    look: Option<FogLook>,
+    from: f32,
+    to: f32,
+    started: f32,
+    secs: f32,
+}
+
+/// The dimmest a full `darken` takes the light to, as a share of the sample.
+const DARKEST: f32 = 0.35;
+/// How far the sky dome leans toward the fog colour at full weight.
+const SKY_LEAN: f32 = 0.6;
+
+impl FogOverride {
+    /// The weight at `now`.
+    pub fn weight(&self, now: f32) -> f32 {
+        let t = if self.secs > 0.0 {
+            ((now - self.started) / self.secs).clamp(0.0, 1.0)
+        } else {
+            1.0
+        };
+        let s = t * t * (3.0 - 2.0 * t);
+        self.from + (self.to - self.from) * s
+    }
+
+    /// Ease toward `look` at `weight` (0..1) over `secs` from `now`, from wherever it is.
+    pub fn set(&mut self, look: FogLook, weight: f32, secs: f32, now: f32) {
+        self.from = if self.look.is_some() {
+            self.weight(now)
+        } else {
+            0.0
+        };
+        self.look = Some(look);
+        self.to = weight.clamp(0.0, 1.0);
+        self.started = now;
+        self.secs = secs.max(0.0);
+    }
+
+    /// Ease back to the sampled atmosphere over `secs` (the look kept until it has).
+    pub fn clear(&mut self, secs: f32, now: f32) {
+        self.from = self.weight(now);
+        self.to = 0.0;
+        self.started = now;
+        self.secs = secs.max(0.0);
+    }
+
+    /// The sampled atmosphere with the override folded in at its weight at `now`.
+    pub fn apply(&self, atmo: Atmosphere, now: f32) -> Atmosphere {
+        let Some(look) = self.look else { return atmo };
+        let w = self.weight(now);
+        if w <= 0.0 {
+            return atmo;
+        }
+        let lerp = |a: f32, b: f32| a + (b - a) * w;
+        let mut out = atmo;
+        for k in 0..3 {
+            out.fog_color[k] = lerp(atmo.fog_color[k], look.color[k]);
+        }
+        out.fog_end = lerp(atmo.fog_end, look.end.max(1.0));
+        out.fog_start_frac = lerp(atmo.fog_start_frac, look.start_frac);
+        // The sky dome leans toward the fog, so the horizon meets it (not all the way: the
+        // zenith keeps some of the night).
+        let lean = SKY_LEAN * w;
+        let dim = 1.0 - look.darken.clamp(0.0, 1.0) * (1.0 - DARKEST) * w;
+        for (stop, sky) in out.sky.iter_mut().zip(atmo.sky) {
+            for k in 0..3 {
+                stop[k] = (sky[k] + (look.color[k] - sky[k]) * lean) * dim;
+            }
+        }
+        if dim < 1.0 {
+            let scale = |c: [f32; 3]| c.map(|v| v * dim);
+            out.ambient = scale(atmo.ambient);
+            out.sun_diffuse = scale(atmo.sun_diffuse);
+            out.sun_color = scale(atmo.sun_color);
+        }
+        out
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn look() -> FogLook {
+        FogLook {
+            color: [0.1, 0.15, 0.2],
+            end: 80.0,
+            start_frac: 0.0,
+            darken: 1.0,
+        }
+    }
+
+    #[test]
+    fn no_override_leaves_the_sample() {
+        let o = FogOverride::default();
+        let a = o.apply(Atmosphere::DEFAULT, 10.0);
+        assert_eq!(a.fog_end, Atmosphere::DEFAULT.fog_end);
+        assert_eq!(a.fog_color, Atmosphere::DEFAULT.fog_color);
+    }
+
+    #[test]
+    fn a_full_override_lands_on_its_look_after_its_ease() {
+        let mut o = FogOverride::default();
+        o.set(look(), 1.0, 4.0, 0.0);
+        let mid = o.apply(Atmosphere::DEFAULT, 2.0);
+        assert!(mid.fog_end < Atmosphere::DEFAULT.fog_end && mid.fog_end > 80.0);
+        let a = o.apply(Atmosphere::DEFAULT, 4.0);
+        assert!((a.fog_end - 80.0).abs() < 1e-3);
+        for (got, want) in a.fog_color.iter().zip([0.1, 0.15, 0.2]) {
+            assert!((got - want).abs() < 1e-5, "{:?}", a.fog_color);
+        }
+        assert!((a.ambient[0] - Atmosphere::DEFAULT.ambient[0] * DARKEST).abs() < 1e-4);
+    }
+
+    #[test]
+    fn a_clear_eases_back_from_where_it_is() {
+        let mut o = FogOverride::default();
+        o.set(look(), 1.0, 0.0, 0.0);
+        o.clear(2.0, 1.0);
+        assert!((o.weight(1.0) - 1.0).abs() < 1e-5);
+        assert!(o.weight(3.0).abs() < 1e-5);
+        let a = o.apply(Atmosphere::DEFAULT, 3.0);
+        assert_eq!(a.fog_end, Atmosphere::DEFAULT.fog_end);
+    }
+
+    #[test]
+    fn a_half_weight_lands_halfway() {
+        let mut o = FogOverride::default();
+        o.set(
+            FogLook {
+                darken: 0.0,
+                ..look()
+            },
+            0.5,
+            0.0,
+            0.0,
+        );
+        let a = o.apply(Atmosphere::DEFAULT, 0.0);
+        assert!((a.fog_end - (Atmosphere::DEFAULT.fog_end + 80.0) / 2.0).abs() < 1e-3);
+        assert_eq!(a.ambient, Atmosphere::DEFAULT.ambient, "no darken, no dim");
+    }
+}
