+/// A script's outdoor fog asked for, or taken away (`SetWorldFog`, `ClearWorldFog`).
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum WorldFogCall {
+    Set {
+        color: [f32; 3],
+        end: f32,
+        start_frac: f32,
+        weight: f32,
+        secs: f32,
+        darken: f32,
+    },
+    Clear {
+        secs: f32,
+    },
+}
+
+static WORLD_FOG: std::sync::Mutex<Vec<WorldFogCall>> = std::sync::Mutex::new(Vec::new());
+
+/// The outdoor fog calls since the last call, oldest first.
+pub fn take_world_fog() -> Vec<WorldFogCall> {
+    WORLD_FOG
+        .lock()
+        .map(|mut v| std::mem::take(&mut *v))
+        .unwrap_or_default()
+}
+
+fn push_fog(call: WorldFogCall) {
+    if let Ok(mut v) = WORLD_FOG.lock() {
+        // Only the last few matter: each eases from where the one before left it.
+        if v.len() >= 16 {
+            v.remove(0);
+        }
+        v.push(call);
+    }
+}
+
