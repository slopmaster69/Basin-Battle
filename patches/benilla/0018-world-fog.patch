@@ -0,0 +1,66 @@
+//! Basin Battle's outdoor atmosphere: the add-on's `SetWorldFog` and `ClearWorldFog`
+//! (`benilla_ui::action_combat`) onto the world's [`FogOverride`], which the time-of-day resolve
+//! folds over the sampled scene fog.
+
+use benilla_ui::action_combat::{self, WorldFogCall};
+use benilla_world::lighting::{FogLook, FogOverride};
+use bevy::prelude::*;
+
+/// Apply the frame's fog calls in the order they came.
+pub(super) fn apply_world_fog(time: Res<Time>, mut fog: ResMut<FogOverride>) {
+    apply_calls(
+        &mut fog,
+        action_combat::take_world_fog(),
+        time.elapsed_secs(),
+    );
+}
+
+fn apply_calls(fog: &mut FogOverride, calls: Vec<WorldFogCall>, now: f32) {
+    for call in calls {
+        match call {
+            WorldFogCall::Set {
+                color,
+                end,
+                start_frac,
+                weight,
+                secs,
+                darken,
+            } => {
+                fog.set(
+                    FogLook {
+                        color,
+                        end,
+                        start_frac,
+                        darken,
+                    },
+                    weight,
+                    secs,
+                    now,
+                );
+            }
+            WorldFogCall::Clear { secs } => fog.clear(secs, now),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_set_then_a_clear_eases_in_and_back_out() {
+        let mut fog = FogOverride::default();
+        let set = WorldFogCall::Set {
+            color: [0.1, 0.1, 0.1],
+            end: 60.0,
+            start_frac: 0.0,
+            weight: 1.0,
+            secs: 2.0,
+            darken: 0.0,
+        };
+        apply_calls(&mut fog, vec![set], 0.0);
+        assert!((fog.weight(2.0) - 1.0).abs() < 1e-5);
+        apply_calls(&mut fog, vec![WorldFogCall::Clear { secs: 0.0 }], 2.0);
+        assert!(fog.weight(2.0).abs() < 1e-5);
+    }
+}
