+
+/// Basin Battle: a borrowed clip's mark on the bones once this frame's clips have written. A
+/// property another model's clip wrote last that no clip writes now goes back to rest (the bind
+/// translation, no turn, unit scale: a vanilla M2's rest pose); what another model's clip wrote
+/// this frame is borrowed from now on, and what the unit's own clips wrote isn't.
+fn settle_borrowed(rig: &mut RigPose, written: &[u8], ext: &[u8]) {
+    let n = rig.locals.len();
+    if rig.borrowed.len() != n {
+        rig.borrowed.resize(n, 0);
+    }
+    let mut any = false;
+    for b in 0..n {
+        let stale = rig.borrowed[b] & !written.get(b).copied().unwrap_or(0);
+        if stale != 0 {
+            let bind = rig.binds.get(b).copied().unwrap_or(Vec3::ZERO);
+            let tf = &mut rig.locals[b];
+            if stale & BORROWED_T != 0 {
+                tf.translation = bind;
+            }
+            if stale & BORROWED_R != 0 {
+                tf.rotation = Quat::IDENTITY;
+            }
+            if stale & BORROWED_S != 0 {
+                tf.scale = Vec3::ONE;
+            }
+            rig.pose_dirty = true;
+        }
+        rig.borrowed[b] = ext.get(b).copied().unwrap_or(0);
+        any |= rig.borrowed[b] != 0;
+    }
+    // Nothing borrowed left: the rig is its own again, and the marks stop being kept.
+    if !any {
+        rig.borrowed.clear();
     }
 }
 
@@ -884,4 +976,46 @@ mod tests {
         step(&mut app, 0.1);
         assert_twins_equal(&mut app, &oj, ours);
     }
+
+    /// Basin Battle: a bone another model's clip turned, that the unit's own clips leave unkeyed,
+    /// goes back to rest once that clip is done; one the own clips write keeps their value.
+    #[test]
+    fn a_borrowed_clips_turn_goes_back_to_rest_once_no_clip_writes_it() {
+        let skeleton = ModelSkeleton {
+            joints: (0..3)
+                .map(|i| benilla_assets::ModelJoint {
+                    parent: i as i16 - 1,
+                    local_translation: Vec3::new(0.0, 0.0, i as f32),
+                    billboard: None,
+                    parent_arm: None,
+                })
+                .collect(),
+            spine_bone: None,
+            head_bone: None,
+        };
+        let mut rig = RigPose::new(Entity::PLACEHOLDER, &skeleton);
+        let turned = Quat::from_rotation_z(1.2);
+        // A borrowed swing turns bones 1 and 2, and moves bone 2.
+        for b in [1, 2] {
+            rig.locals[b].rotation = turned;
+        }
+        rig.locals[2].translation = Vec3::new(0.5, 0.0, 2.0);
+        settle_borrowed(&mut rig, &[0, BORROWED_R, BORROWED_R | BORROWED_T], &[0, BORROWED_R, BORROWED_R | BORROWED_T]);
+        assert_eq!(rig.borrowed, vec![0, BORROWED_R, BORROWED_R | BORROWED_T]);
+        // Its own stand next: it keys bone 1's turn (its value stands), not bone 2 at all.
+        let own = Quat::from_rotation_x(0.3);
+        rig.locals[1].rotation = own;
+        rig.pose_dirty = false;
+        settle_borrowed(&mut rig, &[0, BORROWED_R, 0], &[0, 0, 0]);
+        assert_eq!(rig.locals[1].rotation, own, "the own clip's turn stands");
+        assert_eq!(rig.locals[2].rotation, Quat::IDENTITY, "the left-behind turn is back to rest");
+        assert_eq!(rig.locals[2].translation, Vec3::new(0.0, 0.0, 2.0), "and its pivot to the bind");
+        assert!(rig.pose_dirty, "redrawn");
+        assert!(rig.borrowed.is_empty(), "nothing borrowed left: no more marks kept");
+        // A rig that never borrowed is left alone.
+        rig.locals[2].rotation = turned;
+        settle_borrowed(&mut rig, &[0, 0, 0], &[0, 0, 0]);
+        assert_eq!(rig.locals[2].rotation, turned);
+    }
+
 }
