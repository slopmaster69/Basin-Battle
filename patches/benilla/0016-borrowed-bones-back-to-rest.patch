index 75094ca5..b1388f84 100644
--- a/crates/benilla-world/src/rig_anim/pose.rs
+++ b/crates/benilla-world/src/rig_anim/pose.rs
@@ -37,8 +37,19 @@ pub struct RigPose {
     pub anchors: Vec<(u16, Entity)>,
     /// `locals` changed since the last world pass; starts raised so the bind pose is written.
     pub pose_dirty: bool,
+    /// Basin Battle: per bone, the properties ([`BORROWED_T`], [`BORROWED_R`], [`BORROWED_S`]) an
+    /// [`ExtraClips`] clip (another model's) wrote last. A model's own clips often leave a bone
+    /// unkeyed (a wrist, the shield's), and an unkeyed property keeps its value, so a borrowed
+    /// swing's last turn of it would stay for good (a shield left crooked after the swing): once
+    /// no clip writes such a property, it goes back to rest. Empty until a borrowed clip plays.
+    pub(crate) borrowed: Vec<u8>,
 }
 
+/// [`RigPose::borrowed`]'s bits: translation, rotation, scale.
+pub(crate) const BORROWED_T: u8 = 1;
+pub(crate) const BORROWED_R: u8 = 2;
+pub(crate) const BORROWED_S: u8 = 4;
+
 impl RigPose {
     /// The rig at bind pose, composed; anchors come from [`Self::anchor_for`].
     pub fn new(joints_root: Entity, skeleton: &ModelSkeleton) -> Self {
@@ -66,6 +77,7 @@ impl RigPose {
                 .any(|j| j.billboard.is_some() || j.parent_arm.is_some()),
             anchors: Vec::new(),
             pose_dirty: true,
+            borrowed: Vec::new(),
         };
         rig.compose();
         rig
@@ -253,6 +265,21 @@ fn evaluate_rig_poses(
                     });
                 }
                 active.sort_unstable_by_key(|a| a.node);
+                // Which properties a clip writes this frame (`written`), and of those, which another
+                // model's clip had a hand in (`ext`), for the borrowed bones' return to rest.
+                thread_local! {
+                    static MARKS: std::cell::RefCell<(Vec<u8>, Vec<u8>)> =
+                        const { std::cell::RefCell::new((Vec::new(), Vec::new())) };
+                }
+                let track = active.iter().any(|a| a.extra) || !rig.borrowed.is_empty();
+                MARKS.with(|marks| {
+                let (written, ext) = &mut *marks.borrow_mut();
+                written.clear();
+                ext.clear();
+                if track {
+                    written.resize(rig.locals.len(), 0);
+                    ext.resize(rig.locals.len(), 0);
+                }
                 match active.as_mut_slice() {
                     [] => {}
                     [one] => {
@@ -267,25 +294,40 @@ fn evaluate_rig_poses(
                             {
                                 continue;
                             }
-                            let Some(tf) = rig.locals.get_mut(pb.bone as usize) else {
+                            let b = pb.bone as usize;
+                            let Some(tf) = rig.locals.get_mut(b) else {
                                 continue;
                             };
+                            let mut bits = 0;
                             if let Some(v) = pb.translation.sample(one.seek) {
                                 tf.translation = v;
+                                bits |= BORROWED_T;
                             }
                             if let Some(v) = pb.rotation.sample(one.seek) {
