     let clip = |a: &Active| clip_in(src, extra, a.extra, a.clip).unwrap_or(&NO_CLIP);
@@ -325,6 +368,8 @@ fn blend_rig(
         let mut translation: Option<(Vec3, f32)> = None;
         let mut rotation: Option<(Quat, f32)> = None;
         let mut scale: Option<(Vec3, f32)> = None;
+        // The properties another model's clip contributes to here.
+        let mut from_extra = 0u8;
         for a in active.iter_mut() {
             let Some(pb) = clip(a).bones.get(a.cursor).filter(|b| b.bone == bone) else {
                 continue;
@@ -333,9 +378,13 @@ fn blend_rig(
             if bone_mask & a.mask != 0 {
                 continue; // masked out: no contribution, but the cursor advanced
             }
-            fold(&mut translation, pb.translation.sample(a.seek), a.weight);
-            fold(&mut rotation, pb.rotation.sample(a.seek), a.weight);
-            fold(&mut scale, pb.scale.sample(a.seek), a.weight);
+            let (t, r, sc) = (pb.translation.sample(a.seek), pb.rotation.sample(a.seek), pb.scale.sample(a.seek));
+            if a.extra {
+                from_extra |= if t.is_some() { BORROWED_T } else { 0 } | if r.is_some() { BORROWED_R } else { 0 } | if sc.is_some() { BORROWED_S } else { 0 };
+            }
+            fold(&mut translation, t, a.weight);
+            fold(&mut rotation, r, a.weight);
+            fold(&mut scale, sc, a.weight);
         }
         if translation.is_none() && rotation.is_none() && scale.is_none() {
             continue;
@@ -352,6 +401,49 @@ fn blend_rig(
         if let Some((v, _)) = scale {
             tf.scale = v;
         }
+        if let Some((written, ext)) = marks.as_mut() {
+            let b = bone as usize;
+            let bits = if translation.is_some() { BORROWED_T } else { 0 } | if rotation.is_some() { BORROWED_R } else { 0 } | if scale.is_some() { BORROWED_S } else { 0 };
+            if let (Some(w), Some(e)) = (written.get_mut(b), ext.get_mut(b)) {
+                *w |= bits;
+                *e |= from_extra & bits;
+            }
