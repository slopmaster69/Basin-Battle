+++ b/crates/benilla-ui/src/action_combat.rs
@@ -98,6 +98,10 @@
 //! on first use, and until it has, the unit's own clip plays. `PreloadAnimationSource(name)`
 //! starts that load early.
 //!
+//! The eleventh (`HasActionCombat() >= 11`): a bone another model's clip turned goes back to rest
+//! once no clip playing writes it, so a hand or a shield the unit's own stand leaves unkeyed
+//! doesn't stay where the borrowed swing left it.
+//!
 //! The seventh (`HasActionCombat() >= 7`), a creature's blow drawn under it:
 //!
 //! - `SetTelegraph(key, unit, shape, reach, arcDegrees, seconds, kind, parrySeconds, focus)`: a
@@ -668,7 +672,7 @@ pub(crate) fn install(lua: &Lua) -> mlua::Result<()> {
     )?;
     g.set(
         "HasActionCombat",
-        lua.create_function(|_, _: MultiValue| Ok(10))?,
+        lua.create_function(|_, _: MultiValue| Ok(11))?,
     )?;
     g.set(
         "SetCameraUnitCollision",
