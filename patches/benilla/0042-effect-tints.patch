 //! - `ClearTelegraph([key])`: take one away (all with no key).
 //!
+//! Recoloured spell looks (when `SetEffectTint` exists):
+//!
+//! - `SetEffectTint(model, colour)`: every effect drawn from that model (`"Spells\\CounterSpell_
+//!   Impact_Chest"`, with or without its extension) is multiplied by `colour` (`"RRGGBB"`), its
+//!   particles, ribbons and meshes: a white crackle made violet, a blue streak pink. `nil` puts it
+//!   back. For the effects spawned after the call.
+//!
 //! Rings on the ground (when `SetGroundRing` exists; Basin Battle's skill checks):
 //!
 //! - `SetGroundRing(key, x, y, z, radius, texture, r, g, b, a[, facing])`: an add-on texture
@@ -789,6 +796,23 @@ pub enum GroundRingCall {
 
 static RINGS: std::sync::Mutex<Vec<GroundRingCall>> = std::sync::Mutex::new(Vec::new());
 
+static EFFECT_TINTS: std::sync::Mutex<Option<std::collections::HashMap<String, [u8; 3]>>> = std::sync::Mutex::new(None);
+
+/// An effect model's path as the tints key it: lower case, back slashes, no extension.
+fn tint_key(path: &str) -> String {
+    let p = path.replace('/', "\\").to_ascii_lowercase();
+    match p.rfind('.') {
+        Some(i) if p[i..].len() <= 4 && !p[i..].contains('\\') => p[..i].to_string(),
+        _ => p,
+    }
+}
+
+/// The recolour asked for an effect model (`SetEffectTint`), if any.
+pub fn effect_tint(path: &str) -> Option<[u8; 3]> {
+    let k = tint_key(path);
+    EFFECT_TINTS.lock().ok().and_then(|m| m.as_ref().and_then(|m| m.get(&k).copied()))
+}
+
 /// The ground rings asked for since the last call.
 pub fn take_ground_rings() -> Vec<GroundRingCall> {
     RINGS
@@ -1377,6 +1401,27 @@ pub(crate) fn install(lua: &Lua) -> mlua::Result<()> {
             Ok(())
         })?,
     )?;
+    g.set(
+        "SetEffectTint",
+        lua.create_function(|_, args: MultiValue| {
+            let v: Vec<Value> = args.into_iter().collect();
+            if let Some(path) = text(v.first()) {
+                let c = colour(v.get(1));
+                if let Ok(mut m) = EFFECT_TINTS.lock() {
+                    let m = m.get_or_insert_with(Default::default);
+                    match c {
+                        Some(c) => {
+                            m.insert(tint_key(&path), [((c >> 16) & 0xFF) as u8, ((c >> 8) & 0xFF) as u8, (c & 0xFF) as u8]);
+                        }
+                        None => {
+                            m.remove(&tint_key(&path));
+                        }
+                    }
+                }
+            }
+            Ok(())
+        })?,
+    )?;
