+/// Basin Battle: a colour multiplied into an effect model's particles, ribbons and (through its
+/// rig slot's tint) meshes: a spell look recoloured by the add-on (`SetEffectTint`). On the effect
+/// instance's root, which its emitters and ribbons take their render alpha from.
+#[derive(Component, Clone, Copy, Debug, PartialEq)]
+pub struct EffectTint(pub [f32; 3]);
+
 impl ModelAlphas<'_, '_> {
+    /// Basin Battle: `instance`'s recolour, if it has one.
+    pub fn tint(&self, instance: Entity) -> Option<[f32; 3]> {
+        self.tints.get(instance).ok().map(|t| t.0)
+    }
+
     /// `instance`'s composed alpha; a despawned link (its effects freed with it) ends the walk.
     pub fn get(&self, instance: Entity) -> f32 {
         let mut alpha = 1.0;
