+/// Basin Battle: a recoloured effect's meshes take its colour through its rig slot's tint (the
+/// same table a unit's tint uses), once the slot is there.
+#[allow(clippy::type_complexity)]
+pub(crate) fn apply_effect_tints(
+    q: Query<
+        (&benilla_world::model_fade::EffectTint, &benilla_world::rig_palette::RigSkin),
+        Or<(Added<benilla_world::rig_palette::RigSkin>, Changed<benilla_world::model_fade::EffectTint>)>,
+    >,
+    mut tints: ResMut<benilla_world::instance_tint::InstanceTints>,
+) {
+    for (t, skin) in &q {
+        let c = |v: f32| (v.clamp(0.0, 1.0) * 255.0).round() as u8;
+        tints.set(skin.slot, benilla_world::instance_tint::pack([c(t.0[0]), c(t.0[1]), c(t.0[2])]));
+    }
+}
+
