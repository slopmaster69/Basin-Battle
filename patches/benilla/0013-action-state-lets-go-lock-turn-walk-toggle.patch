+/// Leaving the world (a logout, a disconnect): the add-on's action mouse, aim camera, lock-on and
+/// markers all let go, so the next screen has its cursor whatever the add-on managed to undo.
+pub(super) fn reset_action_on_world_exit(mut lock: ResMut<LockOn>) {
+    action_combat::reset();
+    lock.0 = None;
+}
+
+/// A new UI VM (a `ReloadUI`, an add-on turned off): what the old one's add-on held is let go, as
+/// nothing is left to undo it; an add-on that wants it again asks again.
+pub(super) fn reset_action_on_new_vm(
+    script: Option<NonSend<benilla_ui::script::UiScript>>,
+    mut seen: Local<u64>,
+    mut lock: ResMut<LockOn>,
+) {
+    let Some(script) = script else { return };
+    let now = script.session();
+    if *seen != 0 && now != *seen {
+        action_combat::reset();
+        lock.0 = None;
+    }
+    *seen = now;
+}
