@@ -0,0 +1,527 @@
+//! What switching the look costs, in the log (benilla's own). Take 280 found a 0.6 to 2 s hitch
+//! each time `worldLook` came back on, and one frame with the hero see-through (the oak behind him
+//! showing through his body) right after a settings change; neither shows without the real
+//! client. For [`WATCH_SECS`] after `worldLook` or one of the look's own switches changes, each
+//! frame slower than [`SLOW_MS`] is logged (`[look switch]`) with what the frames around it made
+//! again: the model materials, liquids, images and meshes added or changed (Bevy prepares each
+//! again, and skips its draws until it has), and, from the render world, the pipelines still
+//! compiling (a mesh whose pipeline is not ready is not drawn that frame, which would leave a
+//! hero see-through while the static world draws). The window closes with a summary line.
+//!
+//! Take 291 found one frame of 0.5 to 1.4 s each time `worldLook` came back to 1, with almost
+//! nothing made again in it (the 4,000 meshes and 115 images came in the frames after): a
+//! synchronous job no tally counted. Each slow frame's line now carries its timing spans
+//! ([`Spans`]): the main schedules, cut at their boundaries and between `Update`'s
+//! [`crate::schedule::WorldStage`]s (the stream, the net, the input), what is left for the render
+//! sub-app and the present, and the render world's last finished frame by its sets (extract and
+//! asset prepare, queue, sort, prepare, the graph). Stamps only: they order nothing new.
+
+use std::sync::Mutex;
+use std::time::Instant;
+
+use bevy::app::MainScheduleOrder;
+use bevy::ecs::schedule::ScheduleLabel;
+use bevy::prelude::*;
+use bevy::render::extract_resource::{ExtractResource, ExtractResourcePlugin};
+use bevy::render::render_resource::PipelineCache;
+use bevy::render::{Render, RenderApp, RenderSystems};
+
+use benilla_assets::materials::{LiquidMaterial, WowModelMaterial};
+
+use super::{LookAo, LookShadows, LookSky, LookWater, LookWind, WorldLook};
+
+/// How long after a switch the frames are watched (real seconds).
+pub const WATCH_SECS: f32 = 3.0;
+/// A frame this long (ms) or longer is logged while the window is open.
+pub const SLOW_MS: f32 = 50.0;
+
+/// The window, shared with the render world, whose pipeline count it opens and shuts.
+#[derive(Resource, Clone, Default, ExtractResource)]
+pub struct LookSwitchWatch {
+    /// Real seconds left in the window; 0 while it is shut.
+    pub left: f32,
+    /// What switched, for the log ("worldLook 1").
+    pub what: String,
+    /// Frames since the switch, the switch's own frame 0.
+    pub frame: u32,
+}
+
+/// The switches as last seen; a change of any opens the window.
+#[derive(Clone, Copy, PartialEq, Debug)]
+struct Switches {
+    look: bool,
+    ao: bool,
+    shadows: u8,
+    water: bool,
+    wind: bool,
+    sky: bool,
+}
+
+impl Switches {
+    /// What changed from `old` to `self`, as the CVars are written ("worldLook 1, worldSky 0").
+    fn describe(&self, old: &Switches) -> String {
+        let flag = |b: bool| if b { 1 } else { 0 };
+        let mut out = Vec::new();
+        if self.look != old.look {
+            out.push(format!("worldLook {}", flag(self.look)));
+        }
+        if self.ao != old.ao {
+            out.push(format!("worldAO {}", flag(self.ao)));
+        }
+        if self.shadows != old.shadows {
+            out.push(format!("worldShadows {}", self.shadows));
+        }
+        if self.water != old.water {
+            out.push(format!("worldWater {}", flag(self.water)));
+        }
+        if self.wind != old.wind {
+            out.push(format!("worldWind {}", flag(self.wind)));
+        }
+        if self.sky != old.sky {
+            out.push(format!("worldSky {}", flag(self.sky)));
+        }
+        out.join(", ")
+    }
+}
+
+/// The marker schedules spliced between the main ones ([`MAIN_MARKS`]).
+#[derive(ScheduleLabel, Clone, Copy, Debug, PartialEq, Eq, Hash)]
+struct SpanMark(u8);
+
+/// Each marker schedule and the span it closes; mark 0, before `First`, opens the frame.
+const MAIN_MARKS: [(u8, &str); 6] = [
+    (0, ""),
+    (1, "First"),
+    (2, "PreUpdate"),
+    (3, "Update/rest"),
+    (4, "PostUpdate"),
+    (5, "Last"),
+];
+
+/// The frame's timing spans: stamps at the main schedules' boundaries and after each of
+/// `Update`'s world stages, closed at the next frame's start, so the render sub-app's wait and
+/// the present fall in the last span. `last` is the previous frame's, as (name, ms).
+#[derive(Resource, Default)]
+struct Spans {
+    marks: Vec<(&'static str, Instant)>,
+    last: Vec<(&'static str, f32)>,
+}
+
+impl Spans {
+    /// Close the frame: its spans in the order they closed, the rest as `render+present`.
+    fn close(&mut self, now: Instant) {
+        self.last.clear();
+        for w in self.marks.windows(2) {
+            self.last
+                .push((w[1].0, (w[1].1 - w[0].1).as_secs_f32() * 1000.0));
+        }
+        if let Some((_, end)) = self.marks.last() {
+            self.last
+                .push(("render+present", (now - *end).as_secs_f32() * 1000.0));
+        }
+        self.marks.clear();
+    }
+
+    fn stamp(&mut self, name: &'static str) {
+        self.marks.push((name, Instant::now()));
+    }
+}
+
+/// Spans as a line: each over 0.5 ms, largest first, ("Update/Stream 912.0, Last 3.1").
+fn span_line(spans: &[(&'static str, f32)]) -> String {
+    let mut big: Vec<_> = spans.iter().filter(|(_, ms)| *ms >= 0.5).collect();
+    big.sort_by(|a, b| b.1.total_cmp(&a.1));
+    if big.is_empty() {
+        return "none over 0.5 ms".to_string();
+    }
+    big.iter()
+        .map(|(n, ms)| format!("{n} {ms:.1}"))
+        .collect::<Vec<_>>()
+        .join(", ")
+}
+
+/// The render world's stamps this frame and its last finished frame's spans (it runs on its own
+/// thread, a frame behind the main world).
+static RENDER_SPANS: Mutex<SpanTape> = Mutex::new((Vec::new(), Vec::new()));
+
+/// This frame's stamps and the last finished frame's spans (name, ms).
+type SpanTape = (Vec<(&'static str, Instant)>, Vec<(&'static str, f32)>);
+
+/// A render-world stamp; the first of a frame (`""`) closes the frame before.
+fn render_stamp(name: &'static str) -> impl FnMut() {
+    move || {
+        let mut r = RENDER_SPANS.lock().unwrap_or_else(|e| e.into_inner());
+        let now = Instant::now();
+        if name.is_empty() && !r.0.is_empty() {
+            let spans: Vec<_> = r
+                .0
+                .windows(2)
+                .map(|w| (w[1].0, (w[1].1 - w[0].1).as_secs_f32() * 1000.0))
+                .collect();
+            r.1 = spans;
+            r.0.clear();
+        }
+        r.0.push((name, now));
+    }
+}
+
+/// The render world's last finished frame, as a line.
+fn render_line() -> String {
+    let r = RENDER_SPANS.lock().unwrap_or_else(|e| e.into_inner());
+    let total: f32 = r.1.iter().map(|s| s.1).sum();
+    format!("{total:.1} ms: {}", span_line(&r.1))
+}
+
+/// What a frame made again: model materials, liquids, images and meshes added or changed.
+#[derive(Clone, Copy, Default, PartialEq, Debug)]
+struct Remade {
+    materials: u32,
+    liquids: u32,
+    images: u32,
+    meshes: u32,
+}
+
+impl Remade {
+    fn add(&mut self, o: &Remade) {
+        self.materials += o.materials;
+        self.liquids += o.liquids;
+        self.images += o.images;
+        self.meshes += o.meshes;
+    }
+
+    fn line(&self) -> String {
+        format!(
+            "{} model materials, {} liquids, {} images, {} meshes",
+            self.materials, self.liquids, self.images, self.meshes
+        )
+    }
+}
+
+/// The open window's running tally, for its summary.
+#[derive(Default)]
+struct Tally {
+    slow: u32,
+    worst_ms: f32,
+    worst_frame: u32,
+    worst_spans: String,
+    remade: Remade,
+    last: Remade,
+}
+
+/// How many of a store's events this frame made an asset again (added or changed).
+fn remade<A: Asset>(events: &mut MessageReader<AssetEvent<A>>) -> u32 {
+    events
+        .read()
+        .filter(|e| matches!(e, AssetEvent::Added { .. } | AssetEvent::Modified { .. }))
+        .count() as u32
+}
+
+/// The look's switches this frame (an app without one of them reads it as on).
+#[derive(bevy::ecs::system::SystemParam)]
+struct SwitchInputs<'w> {
+    look: Res<'w, WorldLook>,
+    ao: Option<Res<'w, LookAo>>,
+    shadows: Option<Res<'w, LookShadows>>,
+    water: Option<Res<'w, LookWater>>,
+    wind: Option<Res<'w, LookWind>>,
+    sky: Option<Res<'w, LookSky>>,
+}
+
+impl SwitchInputs<'_> {
+    fn now(&self) -> Switches {
+        Switches {
+            look: self.look.on,
+            ao: self.ao.as_deref().is_none_or(|a| a.on),
+            shadows: self.shadows.as_deref().map_or(1, |s| s.level),
+            water: self.water.as_deref().is_none_or(|w| w.on),
+            wind: self.wind.as_deref().is_none_or(|w| w.on),
+            sky: self.sky.as_deref().is_none_or(|s| s.on),
+        }
+    }
+}
+
+/// The asset stores' events, read every frame so the window counts only its own.
+#[derive(bevy::ecs::system::SystemParam)]
+struct RemadeInputs<'w, 's> {
+    materials: MessageReader<'w, 's, AssetEvent<WowModelMaterial>>,
+    liquids: MessageReader<'w, 's, AssetEvent<LiquidMaterial>>,
+    images: MessageReader<'w, 's, AssetEvent<Image>>,
+    meshes: MessageReader<'w, 's, AssetEvent<Mesh>>,
+}
+
+impl RemadeInputs<'_, '_> {
+    fn take(&mut self) -> Remade {
+        Remade {
+            materials: remade(&mut self.materials),
+            liquids: remade(&mut self.liquids),
+            images: remade(&mut self.images),
+            meshes: remade(&mut self.meshes),
+        }
+    }
+
+    fn skip(&mut self) {
+        self.materials.clear();
+        self.liquids.clear();
+        self.images.clear();
+        self.meshes.clear();
+    }
+}
+
+/// Opens the window on a switch, logs its slow frames, and closes it with a summary.
+fn watch_switches(
+    time: Res<Time<Real>>,
+    switches: SwitchInputs,
+    mut events: RemadeInputs,
+    mut watch: ResMut<LookSwitchWatch>,
+    spans: Option<Res<Spans>>,
+    mut last: Local<Option<Switches>>,
+    mut tally: Local<Tally>,
+) {
+    let now = switches.now();
+    if let Some(old) = last.filter(|old| *old != now) {
+        let what = now.describe(&old);
+        info!("[look switch] {what}: watching the next {WATCH_SECS:.0} s");
+        *watch = LookSwitchWatch {
+            left: WATCH_SECS,
+            what,
+            frame: 0,
+        };
+        *tally = Tally::default();
+    }
+    *last = Some(now);
+    if watch.left <= 0.0 {
+        events.skip();
+        return;
+    }
+    let this = events.take();
+    // The frame time measured now is the frame before this one: the switch's own frame shows
+    // in frame 1.
+    let ms = time.delta_secs() * 1000.0;
+    if watch.frame > 0 && ms >= SLOW_MS {
+        tally.slow += 1;
+        let main = spans
+            .as_deref()
+            .map_or_else(|| "not stamped".to_string(), |s| span_line(&s.last));
+        let render = render_line();
+        info!(
+            "[look switch] {}, frame {}: the frame before took {ms:.0} ms; made again then: {}; \
+             now: {}",
+            watch.what,
+            watch.frame,
+            tally.last.line(),
+            this.line()
+        );
+        info!(
+            "[look switch] {}, frame {}: its spans (ms): {main}; the render world's last frame \
+             {render}",
+            watch.what, watch.frame
+        );
+        if ms > tally.worst_ms {
+            tally.worst_ms = ms;
+            tally.worst_frame = watch.frame;
+            tally.worst_spans = main;
+        }
+    }
+    tally.remade.add(&this);
+    tally.last = this;
+    watch.frame += 1;
+    watch.left -= time.delta_secs();
+    if watch.left <= 0.0 {
+        info!(
+            "[look switch] {} done: {} frames, {} slower than {SLOW_MS:.0} ms (the slowest {:.0} \
+             ms at frame {}, spans {}); made again: {}",
+            watch.what,
+            watch.frame,
+            tally.slow,
+            tally.worst_ms,
+            tally.worst_frame,
+            if tally.worst_spans.is_empty() {
+                "-"
+            } else {
+                tally.worst_spans.as_str()
+            },
+            tally.remade.line()
+        );
+        watch.left = 0.0;
+    }
+}
+
+/// The render world's side: while the window is open, each change in how many pipelines are
+/// still compiling, and how many were made since the switch.
+fn watch_pipelines(
+    watch: Option<Res<LookSwitchWatch>>,
+    cache: Res<PipelineCache>,
+    mut base: Local<Option<usize>>,
+    mut waiting_was: Local<usize>,
+) {
+    let Some(watch) = watch.filter(|w| w.left > 0.0) else {
+        *base = None;
+        *waiting_was = 0;
+        return;
+    };
+    let total = cache.pipelines().count();
+    let base = *base.get_or_insert(total);
+    let waiting = cache.waiting_pipelines().count();
+    if waiting != *waiting_was {
+        info!(
+            "[look switch] {}, frame {}: {waiting} pipelines compiling (a mesh whose pipeline is \
+             not ready is not drawn this frame), {} new since the switch",
+            watch.what,
+            watch.frame,
+            total.saturating_sub(base)
+        );
+        *waiting_was = waiting;
+    }
+}
+
+pub(crate) fn build(app: &mut App) {
+    app.init_resource::<LookSwitchWatch>()
+        .add_plugins(ExtractResourcePlugin::<LookSwitchWatch>::default())
+        .add_systems(Last, watch_switches);
+    build_spans(app);
+    if let Some(render_app) = app.get_sub_app_mut(RenderApp) {
+        render_app.add_systems(Render, watch_pipelines.in_set(RenderSystems::Cleanup));
+    }
+}
+
+/// The timing stamps ([`Spans`]): marker schedules between the main ones, plain systems after
+/// each of `Update`'s world stages (a resource only they touch, so they order nothing new), and
+/// the render world's at its set boundaries. A stamp is one `Instant` pushed.
+fn build_spans(app: &mut App) {
+    use crate::schedule::WorldStage;
+    let Some(mut order) = app.world_mut().get_resource_mut::<MainScheduleOrder>() else {
+        return;
+    };
+    order.insert_before(First, SpanMark(0));
+    order.insert_after(First, SpanMark(1));
+    order.insert_after(PreUpdate, SpanMark(2));
+    order.insert_after(Update, SpanMark(3));
+    order.insert_after(PostUpdate, SpanMark(4));
+    order.insert_after(Last, SpanMark(5));
+    app.init_resource::<Spans>();
+    for (i, name) in MAIN_MARKS {
+        app.add_systems(SpanMark(i), move |mut s: ResMut<Spans>| {
+            if i == 0 {
+                s.close(Instant::now());
+            }
+            s.stamp(name);
+        });
+    }
+    let stage = |name: &'static str| move |mut s: ResMut<Spans>| s.stamp(name);
+    app.add_systems(
+        Update,
+        (
+            stage("Update/to-Net").before(WorldStage::Net),
+            stage("Update/Net")
+                .after(WorldStage::Net)
+                .before(WorldStage::Input),
+            stage("Update/Input")
+                .after(WorldStage::Input)
+                .before(WorldStage::Stream),
+            stage("Update/Stream")
+                .after(WorldStage::Stream)
+                .before(WorldStage::Present),
+            stage("Update/Present").after(WorldStage::Present),
+        ),
+    );
+    if let Some(render_app) = app.get_sub_app_mut(RenderApp) {
+        use RenderSystems as R;
+        render_app.add_systems(
+            Render,
+            (
+                render_stamp("").in_set(R::ExtractCommands),
+                render_stamp("extract+assets")
+                    .after(R::PrepareMeshes)
+                    .before(R::ManageViews),
+                render_stamp("views+queue")
+                    .after(R::Queue)
+                    .before(R::PhaseSort),
+                render_stamp("sort").after(R::PhaseSort).before(R::Prepare),
+                render_stamp("prepare").after(R::Prepare).before(R::Render),
+                render_stamp("graph").after(R::Render).before(R::Cleanup),
+            ),
+        );
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn all_on() -> Switches {
+        Switches {
+            look: true,
+            ao: true,
+            shadows: 1,
+            water: true,
+            wind: true,
+            sky: true,
+        }
+    }
+
+    /// A frame's spans close at the next frame's start, in the order they closed, the rest
+    /// named `render+present`; the line lists the big ones, largest first.
+    #[test]
+    fn the_spans_name_where_a_frame_went() {
+        let t0 = Instant::now();
+        let ms = |n: u64| t0 + std::time::Duration::from_millis(n);
+        let mut s = Spans {
+            marks: vec![
+                ("", ms(0)),
+                ("First", ms(1)),
+                ("Update/Stream", ms(901)),
+                ("Last", ms(903)),
+            ],
+            ..Default::default()
+        };
+        s.close(ms(913));
+        let names: Vec<_> = s.last.iter().map(|x| x.0).collect();
+        assert_eq!(names, ["First", "Update/Stream", "Last", "render+present"]);
+        assert!(s.marks.is_empty());
+        let line = span_line(&s.last);
+        assert!(line.starts_with("Update/Stream 900."), "{line}");
+        assert!(line.contains("render+present 10."), "{line}");
+        assert_eq!(span_line(&[("First", 0.1)]), "none over 0.5 ms");
+    }
+
+    #[test]
+    fn a_switch_is_named_as_its_cvar() {
+        let on = all_on();
+        let off = Switches { look: false, ..on };
+        assert_eq!(on.describe(&off), "worldLook 1");
+        assert_eq!(off.describe(&on), "worldLook 0");
+        let two = Switches {
+            sky: false,
+            shadows: 2,
+            ..on
+        };
+        assert_eq!(two.describe(&on), "worldShadows 2, worldSky 0");
+    }
+
+    /// The window opens on a switch, logs only while open, and shuts after its seconds.
+    #[test]
+    fn the_window_opens_on_a_switch_and_shuts() {
+        let mut app = App::new();
+        app.add_plugins(MinimalPlugins)
+            .add_plugins(bevy::asset::AssetPlugin::default())
+            .init_asset::<Image>()
+            .init_asset::<Mesh>()
+            .init_asset::<WowModelMaterial>()
+            .init_asset::<LiquidMaterial>()
+            .init_resource::<WorldLook>()
+            .init_resource::<LookSwitchWatch>()
+            .add_systems(Last, watch_switches);
+        app.update();
+        assert_eq!(app.world().resource::<LookSwitchWatch>().left, 0.0);
+        app.world_mut().resource_mut::<WorldLook>().on = true;
+        app.update();
+        let watch = app.world().resource::<LookSwitchWatch>();
+        assert!(watch.left > 0.0 && watch.left <= WATCH_SECS);
+        assert_eq!(watch.what, "worldLook 1");
+        // Ages out on real time; force it shut as a long frame would.
+        app.world_mut().resource_mut::<LookSwitchWatch>().left = 1e-6;
+        app.update();
+        app.update();
+        assert_eq!(app.world().resource::<LookSwitchWatch>().left, 0.0);
+    }
+}
