+fn look_glare(world: &mut World, args: &str) -> Vec<String> {
+    use benilla_world::look::{LookGlare, WorldLook};
+    let Some((classic, share)) = LookGlare::parse(args) else {
+        return vec!["Usage: lookglare <strength 0-4> | classic | grade".to_string()];
+    };
+    let env = {
+        let mut glare = world.get_resource_or_init::<LookGlare>();
+        glare.classic = classic;
+        glare.share = share;
+        glare.env
+    };
+    let mut lines = vec![if classic {
+        "Sun glare: 1.12's, drawn before the grade.".to_string()
+    } else {
+        format!("Sun glare: drawn after the grade, strength x{share}; now {env:.2} of full.")
+    }];
+    if !world.get_resource::<WorldLook>().is_some_and(|l| l.on) {
+        lines.push("The classic look (worldLook 0) has 1.12's sun glare.".to_string());
+    }
+    lines
+}
