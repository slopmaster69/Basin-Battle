-pub(super) fn aim_pitch(time: Res<Time>, mut me: Query<&mut BodyTwist, With<SelfPlayer>>) {
-    let Ok(mut twist) = me.single_mut() else {
+pub(super) fn aim_pitch(
+    time: Res<Time>,
+    mut me: Query<(Entity, &mut BodyTwist, Option<&RigPose>), With<SelfPlayer>>,
+    arrows: Query<(
+        &benilla_world::rig_rider::RiderAimAt,
+        Option<&benilla_world::rig_rider::RigRider>,
+        Option<&benilla_world::rig_rider::AimedChild>,
+    )>,
+    frames: Query<&GlobalTransform>,
+) {
+    let Ok((me, mut twist, pose)) = me.single_mut() else {
         return;
     };
+    // The drawn bow's line, from the string hand through the grip, steered onto the reticle: how
+    // far it is off now (last frame's pose), turned and leaned away a share at a time.
+    let off = action_combat::aim_camera()
+        .then(|| {
+            let pose = pose?;
+            let root = frames.get(pose.joints_root).ok()?.affine();
+            let mark = action_combat::reticle_point()
+                .map(|(p, _)| benilla_assets::coords::wow_to_bevy(p))?;
+            arrows.iter().find_map(|(aim, rider, child)| {
+                let (host, bone, local) = match (rider, child) {
+                    (Some(r), _) => (r.host, r.bone, r.local),
+                    (None, Some(c)) => (c.host, c.bone, c.local),
+                    (None, None) => return None,
+                };
+                if host != me {
+                    return None;
+                }
+                let at = |bone: u16, local: Vec3| {
+                    pose.model
+                        .get(bone as usize)
+                        .map(|m| root.transform_point3(m.transform_point3(local)))
+                };
+                bow_line_off(at(bone, local)?, at(aim.bone, aim.local)?, mark)
+            })
+        })
+        .flatten();
+    let k = 1.0 - (-BOW_LINE_RATE * time.delta_secs()).exp();
+    let (turn_fix, lean_fix) = match off {
+        // Off to the left: the shoulders turn left, a turn right taken back.
+        Some((left, up)) => (twist.turn_fix - left * k, twist.lean_fix + up * k),
+        None => (twist.turn_fix * (1.0 - k), twist.lean_fix * (1.0 - k)),
+    };
+    twist.turn_fix = turn_fix.clamp(-BOW_FIX_MOST, BOW_FIX_MOST);
+    twist.lean_fix = lean_fix.clamp(-BOW_FIX_MOST, BOW_FIX_MOST);
     let want = if action_combat::aim_camera() {
         (action_combat::view_elevation() * AIM_PITCH_SHARE).clamp(-AIM_PITCH_MAX, AIM_PITCH_MAX)
     } else {
@@ -1166,6 +1209,29 @@ pub(super) fn aim_pitch(time: Res<Time>, mut me: Query<&mut BodyTwist, With<Self
     };
