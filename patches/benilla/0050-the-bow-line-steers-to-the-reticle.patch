+/// A channel's new local rotation: the bone yawed `yaw` about the unit's up, then leaned `lean`
+/// about the aim's right (the unit's +X yawed by `lean_yaw`), both through the bone's pivot, so
+/// the bone's rotation up to the unit becomes `R(right, lean) · R(up, yaw) · g` (`inv` = `g⁻¹`).
+/// Leaning about the aim's right, not the turned shoulders' own, bows the upper body toward the
+/// aim: a squared side-on bow draw leaning about its own shoulders rolled the bow sideways.
+fn twisted_local(base: Quat, inv: Quat, yaw: f32, lean: f32, lean_yaw: f32) -> Quat {
+    let yawed = Quat::from_axis_angle(inv * Vec3::Y, yaw);
+    if lean == 0.0 {
+        return (base * yawed).normalize();
+    }
+    let right = Quat::from_rotation_y(lean_yaw) * Vec3::X;
+    (base * Quat::from_axis_angle(inv * right, lean) * yawed).normalize()
+}
