+/// How fast the drawn bow's line is steered onto the reticle (per second), and the most the
+/// shoulders turn or lean for it.
+const BOW_LINE_RATE: f32 = 12.0;
+const BOW_FIX_MOST: f32 = 1.2;
+
+/// How far the bow's line (the string hand `string` through the grip `grip`) is off the line from
+/// the string hand to `mark`, in world space (up +Y): `(left, up)` in radians, the turn left and
+/// the rise that would put the grip on the mark's line. None for a line straight up or down.
+fn bow_line_off(string: Vec3, grip: Vec3, mark: Vec3) -> Option<(f32, f32)> {
+    let (have, want) = (grip - string, mark - string);
+    let flat = |v: Vec3| Vec2::new(v.x, v.z).length();
+    if flat(have) < 1e-4 || flat(want) < 1e-4 {
+        return None;
+    }
+    // A yaw about up, left positive: `Quat::from_rotation_y(a)` sends −Z to this heading.
+    let heading = |v: Vec3| (-v.x).atan2(-v.z);
+    let rise = |v: Vec3| v.y.atan2(flat(v));
+    Some((
+        super::wrap_pi(heading(want) - heading(have)),
+        rise(want) - rise(have),
+    ))
+}
+
