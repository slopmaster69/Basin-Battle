@@ -1596,6 +1662,34 @@ pub(super) fn plugin(app: &mut App) {
 mod tests {
     use super::*;
 
+    /// The bow's line reads how far to turn and lean: a mark ahead, left and below reads a left
+    /// turn of an eighth and a fall; a mark on the line reads nothing.
+    #[test]
+    fn the_bow_line_reads_its_turn_and_lean_to_the_mark() {
+        let string = Vec3::new(3.0, 1.0, -2.0);
+        let (left, up) = bow_line_off(
+            string,
+            string + Vec3::NEG_Z,
+            string + Vec3::new(-1.0, -1.0, -1.0),
+        )
+        .unwrap();
+        assert!((left - std::f32::consts::FRAC_PI_4).abs() < 1e-5, "{left}");
+        assert!(up < -0.5, "{up}");
+        // The heading is the one a turn about up gives: −Z turned left by `a` reads `a`.
+        let a = 0.6;
+        let (left, _) = bow_line_off(
+            string,
+            string + Vec3::NEG_Z,
+            string + Quat::from_rotation_y(a) * Vec3::NEG_Z,
+        )
+        .unwrap();
+        assert!((left - a).abs() < 1e-5, "{left}");
+        let (left, up) =
+            bow_line_off(string, string + Vec3::NEG_Z * 0.5, string + Vec3::NEG_Z * 9.0).unwrap();
+        assert!(left.abs() < 1e-6 && up.abs() < 1e-6);
+        assert!(bow_line_off(string, string + Vec3::Y, string + Vec3::NEG_Z).is_none());
+    }
+
