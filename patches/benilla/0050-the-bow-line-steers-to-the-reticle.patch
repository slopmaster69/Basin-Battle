+        let g = Quat::from_euler(bevy::math::EulerRot::YXZ, 0.9, -0.3, 0.2);
+        let (turn, lean) = (-0.7, -0.6);
+        let local = twisted_local(g, g.inverse(), turn, lean, 0.0);
+        let want = Quat::from_axis_angle(Vec3::X, lean) * Quat::from_axis_angle(Vec3::Y, turn) * g;
+        assert!(local.angle_between(want) < 1e-4, "{local:?} vs {want:?}");
+        // The base pose's bow, upright and 0.7 left of forward, ends upright and on the aim.
+        let flat = twisted_local(Quat::IDENTITY, Quat::IDENTITY, turn, lean, 0.0);
+        let up = flat * Vec3::Y;
+        let along = flat * (Quat::from_rotation_y(-turn) * Vec3::NEG_Z);
+        assert!(up.x.abs() < 1e-5, "the bow rolls sideways: {up:?}");
+        assert!(
+            along.x.abs() < 1e-5 && along.y < 0.0,
+            "the bow points off the aim: {along:?}"
+        );
+    }
