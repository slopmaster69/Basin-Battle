 struct ImageRig;
 
+/// Basin Battle: a copy's rig whose tint is its own, set as it is made: the aura tint publish
+/// (`crate::aura_visual::apply_aura_tint`) rewrites every other rig's slot each frame, and a copy
+/// has no aura of its own, so it put the copy's colour back to none on the next frame. A Rogue's
+/// copies keep theirs: the perfect dodge's lit ghost (`light` above 0, the thirty-fourth round) and
+/// Afterimage's violet shade (a copy with a stand-in). A flurry's copies are as they were.
+#[derive(Component)]
+pub(crate) struct OwnTint;
+
+impl AfterimageDue {
+    /// Whether the copy keeps the colour it is made with ([`OwnTint`]).
+    fn keeps_tint(&self) -> bool {
+        self.tint.is_some() && (self.light > 0.0 || self.stand_in.is_some())
+    }
+}
+
 /// Make the copies that fell due: the unit's drawn parts (the body's and its held items') again
 /// under a root of their own, each rig's rows frozen into a slot of the copy's.
 #[allow(clippy::type_complexity)]
@@ -216,7 +231,10 @@ pub(crate) fn spawn_afterimages(
                     if let Some(t) = d.tint {
                         tints.set(slot, instance_tint::pack_lit(t, d.light));
                     }
-                    commands.spawn((copy, ImageRig, ChildOf(root)));
+                    let copy_rig = commands.spawn((copy, ImageRig, ChildOf(root))).id();
+                    if d.keeps_tint() {
+                        commands.entity(copy_rig).insert(OwnTint);
+                    }
                     copies.insert(rig.0, slot);
                     slot
                 }
