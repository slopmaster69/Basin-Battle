+/// Basin Battle: a Rogue's afterimage copy keeps the colour it was made with (its lit ghost, its
+/// violet shade): the publish skips its rig, where an untinted rig beside it is put back to none.
+/// Gone, its slot is clean again (`RigSkin`'s free hook), so no next owner inherits the light.
+#[test]
+fn an_afterimage_copy_keeps_its_own_tint() {
+    let mut app = app_with_tint_channel();
+    let mut skin = || {
+        benilla_world::rig_palette::RigSkin::allocate_bones(
+            app.world_mut()
+                .resource_mut::<benilla_world::rig_palette::RigPalettes>()
+                .as_mut(),
+            8,
+            Handle::default(),
+        )
+        .expect("a fresh palette has room")
+    };
+    let (copy, plain) = (skin(), skin());
+    let (copy_slot, plain_slot) = (copy.slot, plain.slot);
+    let copy_rig = app
+        .world_mut()
+        .spawn((copy, crate::creature_anim::OwnTint))
+        .id();
+    app.world_mut().spawn(plain);
+    let lit = benilla_world::instance_tint::pack_lit([0xE0, 0xEC, 0xFF], 0.7);
+    {
+        let mut tints = app
+            .world_mut()
+            .resource_mut::<benilla_world::instance_tint::InstanceTints>();
+        tints.set(copy_slot, lit);
+        tints.set(plain_slot, lit);
+    }
+    app.update();
+    app.update();
+    let tints = app
+        .world()
+        .resource::<benilla_world::instance_tint::InstanceTints>();
+    assert_eq!(tints.get(copy_slot), lit, "the copy's own light stays");
+    assert_eq!(
+        tints.get(plain_slot),
+        benilla_world::instance_tint::IDENTITY,
+        "any other rig with no aura is put back to none, as before"
+    );
+
+    // The copy's time up: its rig goes, and its slot with it, untinted.
+    app.world_mut().entity_mut(copy_rig).despawn();
+    app.update();
+    assert_eq!(
+        app.world()
+            .resource::<benilla_world::instance_tint::InstanceTints>()
+            .get(copy_slot),
+        benilla_world::instance_tint::IDENTITY,
+        "a gone copy's slot is clean before anyone can reallocate it"
+    );
+}
