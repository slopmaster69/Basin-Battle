+    pub fn striking_link(
+        &self,
+        clip: &benilla_assets::PoseClip,
+        t0: f32,
+        t1: f32,
+        shortest: f32,
+    ) -> Option<(u16, u16)> {
+        super::striking_link(clip, &self.parents, &self.binds, t0, t1, shortest)
+    }
+
+    /// A donor model's `clip` carried onto this skeleton: its bones paired with this rig's by
+    /// [`super::map_bones`] and its turns scaled by the ratio of the two skeletons' heights
+    /// ([`super::retarget`]). `keys` is this model's `KeyBoneID` per bone; the donor is its bones'
+    /// parents and rest links and its own `KeyBoneID` list.
+    pub fn retarget_from(
+        &self,
+        keys: &[i16],
+        clip: &benilla_assets::PoseClip,
+        donor_parents: &[i16],
+        donor_binds: &[Vec3],
+        donor_keys: &[i16],
+    ) -> benilla_assets::PoseClip {
+        let target = super::Bones {
+            parents: &self.parents,
+            binds: &self.binds,
+            keys,
+        };
+        let from = super::Bones {
+            parents: donor_parents,
+            binds: donor_binds,
+            keys: donor_keys,
+        };
+        let map = super::map_bones(&target, &from);
+        let scale = target.height() / from.height().max(0.1);
+        super::retarget(clip, &map, &self.parents, scale)
+    }
