 //!
 //! - `PlayGroundBurst(x, y, z, facing, shape, reach, arc, seconds, colour[, width])`: an ability's
@@ -758,6 +769,42 @@ pub struct GroundBurst {
 
 static BURSTS: std::sync::Mutex<Vec<GroundBurst>> = std::sync::Mutex::new(Vec::new());
 
+/// A textured ring on the ground (`SetGroundRing`, `SetGroundRingOnUnit`, `ClearGroundRing`).
+#[derive(Clone, Debug, PartialEq)]
+pub enum GroundRingCall {
+    Set {
+        key: String,
+        /// At a spot (WoW coordinates), or under a unit (`"player"`, a guid).
+        at: Option<[f32; 3]>,
+        unit: Option<String>,
+        radius: f32,
+        texture: String,
+        rgba: [f32; 4],
+        yaw: f32,
+    },
+    Clear {
+        key: Option<String>,
+    },
+}
+
+static RINGS: std::sync::Mutex<Vec<GroundRingCall>> = std::sync::Mutex::new(Vec::new());
+
+/// The ground rings asked for since the last call.
+pub fn take_ground_rings() -> Vec<GroundRingCall> {
+    RINGS
+        .lock()
+        .map(|mut v| std::mem::take(&mut *v))
+        .unwrap_or_default()
+}
+
+fn push_ring(c: GroundRingCall) {
+    if let Ok(mut v) = RINGS.lock() {
+        if v.len() < 512 {
+            v.push(c);
+        }
+    }
+}
+
 /// The ground bursts asked for since the last call.
 pub fn take_ground_bursts() -> Vec<GroundBurst> {
     BURSTS
@@ -1330,6 +1377,64 @@ pub(crate) fn install(lua: &Lua) -> mlua::Result<()> {
