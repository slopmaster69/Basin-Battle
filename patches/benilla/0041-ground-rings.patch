                         .run_if(resource_exists::<benilla_world::lighting::FogOverride>),
@@ -477,6 +480,7 @@ impl Plugin for TargetPlugin {
                     aim_marker::push_aim_marker,
                     telegraph::push_telegraphs,
                     ground_burst::push_ground_bursts,
+                    ground_ring::push_ground_rings,
                 )
                     .after(benilla_world::particles::buffer::begin_effect_frame),
             );
