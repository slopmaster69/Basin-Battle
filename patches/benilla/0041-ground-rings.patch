index 00000000..7f0598c7
--- /dev/null
+++ b/crates/benilla-app/src/target/ground_ring.rs
@@ -0,0 +1,168 @@
+//! Basin Battle's rings on the ground, not part of 1.12.1: an add-on texture laid flat on the
+//! ground over a circle (`SetGroundRing`, `SetGroundRingOnUnit`), for the Elwynn Survival add-on's
+//! skill checks: a school's ring under Meteor's circle, round the caster's feet for Arcane
+//! Explosion, and the ring of light closing on it. The add-on sets each ring every frame it wants
+//! it, moving, growing, turning and fading it, so the animation is the add-on's; one not set for
+//! half a second goes. Drawn as an effect over the ground (the telegraphs' projection), whatever
+//! the floor markers are set to, for the caster too.
+
+use std::collections::HashMap;
+
+use bevy::asset::RenderAssetUsages;
+use bevy::prelude::*;
+use bevy::render::render_resource::{Extent3d, TextureDimension, TextureFormat};
+
+use benilla_assets::coords::wow_to_bevy;
+use benilla_ui::action_combat::{self, GroundRingCall, TeleShape};
+use benilla_world::decal::WorldDecal;
+use benilla_world::view::WorldCamera;
+
+use super::telegraph::{self, Layer};
+
+/// The most rings kept at once.
+const MAX_RINGS: usize = 24;
+/// A ring not set again for this long goes.
+const STALE: f32 = 0.5;
+
+struct Ring {
+    at: Option<Vec3>,
+    unit: Option<String>,
+    radius: f32,
+    texture: String,
+    rgba: [f32; 4],
+    yaw: f32,
+    set_at: f32,
+    layer: Layer,
+}
+
+#[derive(Resource, Default)]
+pub(super) struct GroundRings {
+    rings: HashMap<String, Ring>,
+    /// The add-on's textures by path, loaded once (`None`: not found).
+    textures: HashMap<String, Option<Handle<Image>>>,
+}
+
+/// An add-on texture's pixels, from its `Interface\AddOns\...` path (no extension, as the add-on
+/// writes it): the AddOns folder's file, `.tga`.
+fn load_texture(path: &str) -> Option<Image> {
+    let norm = path.replace('/', "\\");
+    let lower = norm.to_ascii_lowercase();
+    let rest = lower.strip_prefix("interface\\addons\\").map(|_| &norm["interface\\addons\\".len()..])?;
+    let mut file = crate::ui_script::addons::root()?;
+    for part in rest.split('\\').filter(|p| !p.is_empty()) {
+        file.push(part);
+    }
+    let file = if file.extension().is_none() { file.with_extension("tga") } else { file };
+    let bytes = std::fs::read(&file).ok()?;
+    let (w, h, rgba) = benilla_formats::tga_to_rgba(&bytes).ok()?;
+    Some(Image::new(
+        Extent3d {
+            width: w,
+            height: h,
+            depth_or_array_layers: 1,
+        },
+        TextureDimension::D2,
+        rgba,
+        TextureFormat::Rgba8UnormSrgb,
+        RenderAssetUsages::default(),
+    ))
+}
+
+/// Take the add-on's calls, drop the stale, and lay each ring on the ground where it is now.
+#[allow(clippy::type_complexity)]
+pub(super) fn update_ground_rings(
+    time: Res<Time>,
+    decals: WorldDecal,
+    mut state: ResMut<GroundRings>,
+    me: Query<&GlobalTransform, With<crate::net::SelfPlayer>>,
+    units: Query<&GlobalTransform>,
+    index: Option<Res<crate::net::GuidIndex>>,
+) {
+    let now = time.elapsed_secs();
+    for call in action_combat::take_ground_rings() {
+        match call {
+            GroundRingCall::Set { key, at, unit, radius, texture, rgba, yaw } => {
+                if !state.rings.contains_key(&key) && state.rings.len() >= MAX_RINGS {
+                    continue;
+                }
+                let r = state.rings.entry(key).or_insert_with(|| Ring {
+                    at: None,
+                    unit: None,
+                    radius,
+                    texture: texture.clone(),
+                    rgba,
+                    yaw,
+                    set_at: now,
+                    layer: Layer::default(),
+                });
+                r.at = at.map(wow_to_bevy);
+                r.unit = unit;
+                r.radius = radius;
+                r.texture = texture;
+                r.rgba = rgba;
+                r.yaw = yaw;
+                r.set_at = now;
+            }
+            GroundRingCall::Clear { key: Some(key) } => {
+                state.rings.remove(&key);
+            }
+            GroundRingCall::Clear { key: None } => state.rings.clear(),
+        }
+    }
+    state.rings.retain(|_, r| now - r.set_at < STALE);
+    let mine = me.single().ok().map(|g| g.translation());
+    for r in state.rings.values_mut() {
+        let feet = match (&r.unit, r.at) {
+            (Some(u), _) if u.eq_ignore_ascii_case("player") => mine,
+            (Some(u), _) => {
+                let guid = u.strip_prefix("0x").or_else(|| u.strip_prefix("0X")).and_then(|h| u64::from_str_radix(h, 16).ok()).or_else(|| u.parse().ok());
+                guid.and_then(|g| index.as_ref().and_then(|i| i.0.get(&g).copied())).and_then(|e| units.get(e).ok()).map(|g| g.translation())
+            }
+            (None, at) => at,
+        };
+        let Some(feet) = feet else {
+            r.layer.verts.clear();
+            continue;
+        };
+        telegraph::place_shape(&mut r.layer, &decals, TeleShape::Ring, feet, r.yaw, r.radius, 0.0);
+    }
+}
+
+/// Draw them, each in its own texture, tinted and faded.
+pub(super) fn push_ground_rings(
+    mut images: ResMut<Assets<Image>>,
+    state: Option<ResMut<GroundRings>>,
+    cam: Query<Entity, With<WorldCamera>>,
+    mut draw: benilla_world::particles::buffer::WorldEffectDraw,
+) {
+    let (Some(mut state), Ok(cam)) = (state, cam.single()) else {
+        return;
+    };
+    let GroundRings { rings, textures } = &mut *state;
+    for r in rings.values() {
+        let tex = textures
+            .entry(r.texture.clone())
+            .or_insert_with(|| {
+                let img = load_texture(&r.texture);
+                if img.is_none() {
+                    warn!("ground ring: no texture at {}", r.texture);
+                }
+                img.map(|i| images.add(i))
+            })
+            .clone();
+        if let Some(tex) = tex {
+            telegraph::push_layer(&mut draw, cam, tex.id(), &r.layer, [r.rgba[0], r.rgba[1], r.rgba[2]], r.rgba[3]);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn an_add_on_path_outside_the_add_ons_is_refused() {
+        assert!(load_texture("Interface\\Icons\\Spell_Fire_Fireball").is_none());
+        assert!(load_texture("Textures\\whatever").is_none());
+    }
+}
