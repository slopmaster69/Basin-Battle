+/// The stand-ins hidden now, to show again once no copy hides them.
+#[derive(Resource, Default)]
+pub(crate) struct HiddenStandIns(Vec<Entity>);
+
+/// The unit's copies are to go (`PlayUnitAfterimage(unit, 0)`): [`expire_afterimages`] takes them.
+#[derive(Component)]
+pub(crate) struct ClearImages;
+
+/// One of the add-on's asks (`PlayUnitAfterimage`), on its unit: a copy due now, standing where
+/// it's asked to along the ground at the body's own height (`body_at`, the unit's place), or the
+/// unit's copies taken away. The action drain calls it, which reads the units' places already.
+pub(super) fn apply_call(
+    commands: &mut Commands,
+    call: AfterimageCall,
+    now: f32,
+    me: Option<Entity>,
+    index: &GuidIndex,
+    body_at: impl Fn(Entity) -> Option<Vec3>,
+) {
+    match call {
+        AfterimageCall::Leave {
+            unit,
+            secs,
+            alpha,
+            tint,
+            at,
+            stand_in,
+        } => {
+            let Some(entity) = super::resolve(&unit, me, index) else {
+                return;
+            };
+            let shift = match (at, body_at(entity)) {
+                (Some(p), Some(body)) => {
+                    let d = wow_to_bevy(p) - body;
+                    Vec3::new(d.x, 0.0, d.z)
+                }
+                _ => Vec3::ZERO,
+            };
+            commands.entity(entity).try_insert(AfterimageDue {
+                at: now,
+                secs,
+                alpha,
+                tint,
+                shift,
+                lingers: secs > LINGER_FROM,
+                stand_in: stand_in.as_deref().and_then(super::guid_of),
+            });
+        }
+        AfterimageCall::Clear { unit } => {
+            let Some(entity) = super::resolve(&unit, me, index) else {
+                return;
+            };
+            commands.entity(entity).try_remove::<AfterimageDue>();
+            commands.entity(entity).try_insert(ClearImages);
+        }
+    }
 }
 
