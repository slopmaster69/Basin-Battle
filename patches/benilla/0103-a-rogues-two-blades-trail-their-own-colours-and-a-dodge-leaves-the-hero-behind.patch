+
+    /// The shade's stand-in (the server's own body for it) is hidden while the copy stands and
+    /// shown again once it's gone.
+    #[test]
+    fn a_copy_hides_its_stand_in_while_it_stands() {
+        let (mut app, hero, shade) = stand_in_world();
+        let copy = copy_of(&mut app, hero);
+        app.update();
+        assert_eq!(app.world().get::<Visibility>(shade), Some(&Visibility::Hidden));
+        app.world_mut().entity_mut(copy).despawn();
+        app.update();
+        assert_eq!(app.world().get::<Visibility>(shade), Some(&Visibility::Inherited));
+        assert!(app.world().resource::<HiddenStandIns>().0.is_empty());
+    }
+
+    /// The stand-in struck down (or replaced) before the copy's time is up: the copy goes too.
+    #[test]
+    fn a_copy_goes_with_its_stand_in() {
+        let (mut app, hero, shade) = stand_in_world();
+        let copy = copy_of(&mut app, hero);
+        app.update();
+        assert!(app.world().get_entity(copy).is_ok());
+        app.world_mut().resource_mut::<GuidIndex>().0.clear();
+        app.world_mut().entity_mut(shade).despawn();
+        app.update();
+        assert!(app.world().get_entity(copy).is_err(), "gone with its stand-in");
+    }
+
+    /// The add-on's copy: due on its unit now, standing at the spot along the ground (the body's
+    /// own height kept), lingering when it's long; 0 seconds takes the unit's copies away.
+    #[test]
+    fn the_add_on_leaves_a_copy_at_a_spot_and_takes_it_away() {
+        let mut app = App::new();
+        app.insert_resource(Time::<()>::default());
+        // The body at WoW (10, 20, 5), Bevy (-20, 5, -10).
+        let hero = app
+            .world_mut()
+            .spawn(Transform::from_translation(Vec3::new(-20.0, 5.0, -10.0)))
+            .id();
+        let mut index = GuidIndex::default();
+        index.0.insert(0xF130_0000_0000_00AB, hero);
+        app.insert_resource(index);
+        // As the action drain takes them, the unit's place its `Transform`.
+        app.add_systems(
+            Update,
+            (
+                |mut commands: Commands, index: Res<GuidIndex>, q: Query<&Transform>| {
+                    for call in action_combat::take_afterimages() {
+                        apply_call(&mut commands, call, 0.0, None, &index, |e| {
+                            q.get(e).ok().map(|t| t.translation)
+                        });
+                    }
+                },
+                expire_afterimages,
+            )
+                .chain(),
+        );
+        action_combat::take_afterimages();
+        action_combat::push_afterimage(AfterimageCall::Leave {
+            unit: "0xF1300000000000AB".into(),
+            secs: 2.0,
+            alpha: 0.6,
+            tint: None,
+            at: Some([13.0, 24.0, 9.0]),
+            stand_in: Some("0xF130000000000123".into()),
+        });
+        app.update();
+        let due = app.world().get::<AfterimageDue>(hero).copied().expect("a copy due");
+        // WoW (13, 24) is Bevy (-24, _, -13): 4 yd along -X and 3 along -Z, the height not moved.
+        assert!((due.shift - Vec3::new(-4.0, 0.0, -3.0)).length() < 1.0e-4, "{:?}", due.shift);
+        assert!(due.lingers, "the shade's 2 sec stands");
+        assert_eq!(due.stand_in, Some(0xF130_0000_0000_0123));
+        let copy = app
+            .world_mut()
+            .spawn(Afterimage {
+                started: 0.0,
+                until: 2.0,
+                unit: hero,
+                stand_in: None,
+                seen: false,
+            })
+            .id();
+        action_combat::push_afterimage(AfterimageCall::Clear {
+            unit: "0xF1300000000000AB".into(),
+        });
+        app.update();
+        app.update();
+        assert!(app.world().get::<AfterimageDue>(hero).is_none());
+        assert!(app.world().get_entity(copy).is_err(), "taken away");
+        assert!(app.world().get::<ClearImages>(hero).is_none(), "and the ask with them");
+    }
