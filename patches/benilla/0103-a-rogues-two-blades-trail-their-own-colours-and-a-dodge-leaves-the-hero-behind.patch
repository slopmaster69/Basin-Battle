+    /// A decoy's copy (the shade's 2 sec) keeps most of its alpha until near its end.
+    #[test]
+    fn a_lingering_copy_stands_then_goes() {
+        let fade = RenderFade {
+            started: 0.0,
+            duration: 2.0,
+            from: 0.6,
