+        let shade = app.world_mut().spawn((Transform::IDENTITY, Visibility::Inherited)).id();
+        let mut index = GuidIndex::default();
+        index.0.insert(0xF130_0000_0000_0123, shade);
+        app.insert_resource(index);
+        app.add_systems(
+            Update,
+            |mut commands: Commands,
+             index: Res<GuidIndex>,
+             mut images: Query<(Entity, &mut Afterimage)>,
+             mut hidden: ResMut<HiddenStandIns>| {
+                keep_stand_ins(&mut commands, &index, &mut images, &mut hidden);
+            },
+        );
+        (app, hero, shade)
+    }
+
+    fn copy_of(app: &mut App, hero: Entity) -> Entity {
+        app.world_mut()
+            .spawn(Afterimage {
+                started: 0.0,
+                until: 2.0,
