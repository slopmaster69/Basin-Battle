@@ -171,6 +274,54 @@ pub(crate) fn clear_afterimages(mut commands: Commands, images: Query<Entity, Wi
     }
 }
 
+/// Each copy's stand-in hidden while the copy stands, shown again once none does; a copy whose
+/// stand-in was seen and is gone goes with it (the shade struck down, or replaced). Every frame,
+/// from the action drain (which reads the guids already).
+pub(super) fn keep_stand_ins(
+    commands: &mut Commands,
+    index: &GuidIndex,
+    images: &mut Query<(Entity, &mut Afterimage)>,
+    hidden: &mut HiddenStandIns,
+) {
+    if images.is_empty() && hidden.0.is_empty() {
+        return;
+    }
+    let mut hide = Vec::new();
+    for (e, mut a) in images.iter_mut() {
+        let Some(guid) = a.stand_in else {
+            continue;
+        };
+        match index.0.get(&guid).copied() {
+            Some(unit) => {
+                a.seen = true;
+                hide.push(unit);
+            }
+            None if a.seen => {
+                commands.entity(e).try_despawn();
+            }
+            None => {}
+        }
+    }
+    for &unit in &hide {
+        if !hidden.0.contains(&unit) {
+            commands.entity(unit).try_insert(Visibility::Hidden);
+        }
+    }
+    for &unit in &hidden.0 {
+        if !hide.contains(&unit) {
+            commands.entity(unit).try_insert(Visibility::Inherited);
+        }
+    }
+    hidden.0 = hide;
+}
+
+/// Leaving the world: nothing stays hidden.
+pub(crate) fn clear_stand_ins(mut commands: Commands, mut hidden: ResMut<HiddenStandIns>) {
+    for unit in hidden.0.drain(..) {
+        commands.entity(unit).try_insert(Visibility::Inherited);
+    }
+}
