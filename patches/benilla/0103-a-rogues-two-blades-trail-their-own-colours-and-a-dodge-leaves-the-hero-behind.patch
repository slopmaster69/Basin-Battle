+        assert!((at(0.0) - 0.6).abs() < 1.0e-4, "its alpha as it appears: {}", at(0.0));
+        assert!(at(1.0) > 0.5, "still standing half way: {}", at(1.0));
+        assert!(at(2.0) <= 1.0e-3, "gone at the end: {}", at(2.0));
+    }
