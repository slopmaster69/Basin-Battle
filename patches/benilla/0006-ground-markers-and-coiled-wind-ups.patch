@@ -0,0 +1,294 @@
+//! Basin Battle's ground markers, not part of 1.12.1: the aim's circle under the reticle while the
+//! Elwynn Survival add-on asks for one (`SetAimMarker`), and the timed circles it lays where a
+//! blow is coming down (`SetGroundMarker`). Both are terrain-projected decals through the same
+//! projector as the ground-targeting reticle ([`super::reticle`]), with its two textures: green
+//! for ours, red for what's coming at us.
+//!
+//! The aim's point is found as the Elwynn Survival server finds it, so the circle lies where the
+//! cast will land: the reticle's line from the hero's eye (1.9 yd up, the shoulder's 0.75 to the
+//! right while the aiming camera is up), along the view's facing and elevation, to the first
+//! ground or wall it meets within `range` + 3 yards; past `range` on the map it is pulled back to
+//! `range` and dropped to the ground there. The add-on can read it back (`GetAimPoint`).
+
+use bevy::prelude::*;
+
+use crate::net::SelfPlayer;
+use benilla_assets::coords::{bevy_to_wow, wow_to_bevy};
+use benilla_ui::action_combat::{self, GroundMarkerCall};
+use benilla_world::collision::PickOccluder;
+use benilla_world::decal::{DecalFrame, WorldDecal};
+use benilla_world::particles::buffer::EffectVertex;
+use benilla_world::view::WorldCamera;
+
+/// The reticle's line starts this high over the feet, and this far to the right while aiming
+/// over the shoulder (the server's `EYE` and `SHOULDER`).
+const EYE: f32 = 1.9;
+const SHOULDER: f32 = 0.75;
+/// The line runs this much past the range, as the server's does from the camera.
+const OVERSHOOT: f32 = 3.0;
+/// The decal box's vertical half-height, as the reticle's.
+const VERT: f32 = 2.0;
+/// The most ground markers kept at once.
+const MAX_MARKERS: usize = 48;
+
+#[derive(Resource)]
+pub(super) struct MarkerAssets {
+    ours: Handle<Image>,
+    theirs: Handle<Image>,
+}
+
+/// One projected circle: where, how wide, its triangles, and the surfaces they were cut from.
+#[derive(Default, Clone)]
+struct Circle {
+    center: Vec3,
+    radius: f32,
+    surfaces: usize,
+    verts: Vec<EffectVertex>,
+}
+
+impl Circle {
+    /// Project it afresh if it moved, changed size or the ground under it streamed in.
+    fn place(&mut self, decals: &WorldDecal, center: Vec3, radius: f32) {
+        let surfaces = decals.receiver_count();
+        if !self.verts.is_empty()
+            && self.center.distance_squared(center) < 1.0e-4
+            && (self.radius - radius).abs() < 1.0e-3
+            && self.surfaces == surfaces
+        {
+            return;
+        }
+        self.center = center;
+        self.radius = radius;
+        self.surfaces = surfaces;
+        self.verts.clear();
+        let frame = DecalFrame {
+            center,
+            sin: 0.0,
+            cos: 1.0,
+            min_x: -radius,
+            max_x: radius,
+            min_z: -radius,
+            max_z: radius,
+            min_y: -VERT,
+            max_y: VERT,
+        };
+        decals.project(
+            &mut self.verts,
+            &frame,
+            |p| ((VERT - p.y.abs()) / VERT).clamp(0.0, 1.0),
+            |x, z| frame.rect_uv(x, z),
+        );
+    }
+}
+
+/// The aim's circle, while one is asked for and the line meets somewhere.
+#[derive(Resource, Default)]
+pub(super) struct AimMarkerState {
+    circle: Circle,
+    shown: bool,
+}
+
+/// A timed marker: its key (the add-on's), until when (seconds of app time), and whose.
+struct Ground {
+    key: String,
+    until: f32,
+    hostile: bool,
+    circle: Circle,
+}
+
+#[derive(Resource, Default)]
+pub(super) struct GroundMarkers {
+    list: Vec<Ground>,
+}
+
+pub(super) fn setup_aim_marker(mut commands: Commands, asset_server: Res<AssetServer>) {
+    commands.insert_resource(MarkerAssets {
+        ours: asset_server.load::<Image>("mpq://interface/spellshadow/spell-shadow-acceptable.blp"),
+        theirs: asset_server
+            .load::<Image>("mpq://interface/spellshadow/spell-shadow-unacceptable.blp"),
+    });
+    commands.init_resource::<AimMarkerState>();
+    commands.init_resource::<GroundMarkers>();
+}
+
+/// The first ground or wall along `dir` from `from` within `max`, as a distance.
+fn first_hit(
+    spatial: &avian3d::prelude::SpatialQuery,
+    occluders: &Query<(), With<PickOccluder>>,
+    from: Vec3,
+    dir: Vec3,
+    max: f32,
+) -> Option<f32> {
+    let dir = Dir3::new(dir).ok()?;
+    spatial
+        .cast_ray_predicate(
+            from,
+            dir,
+            max,
+            true,
+            &benilla_world::collision::WorldCollision::body_filter(),
+            &|e| occluders.contains(e),
+        )
+        .map(|hit| hit.distance)
+}
+
+/// Where the reticle's line lands for an aim of `range` yards, in Bevy space.
+pub(crate) fn aim_point(
+    spatial: &avian3d::prelude::SpatialQuery,
+    occluders: &Query<(), With<PickOccluder>>,
+    feet: Vec3,
+    range: f32,
+) -> Vec3 {
+    let (yaw, pitch) = (
+        action_combat::view_facing(),
+        action_combat::view_elevation(),
+    );
+    let right = if action_combat::aim_camera() {
+        SHOULDER
+    } else {
+        0.0
+    };
+    let w = bevy_to_wow(feet);
+    // The server's right of a facing `yaw`: (sin, -cos) on the map.
+    let origin = wow_to_bevy([
+        w[0] + yaw.sin() * right,
+        w[1] - yaw.cos() * right,
+        w[2] + EYE,
+    ]);
+    let dir = wow_to_bevy([
+        yaw.cos() * pitch.cos(),
+        yaw.sin() * pitch.cos(),
+        pitch.sin(),
+    ]);
+    let reach = range + OVERSHOOT;
+    let mut at = origin + dir * first_hit(spatial, occluders, origin, dir, reach).unwrap_or(reach);
+    // No farther than the range on the map.
+    let flat = Vec2::new(at.x - feet.x, at.z - feet.z);
+    if flat.length() > range {
+        let k = range / flat.length().max(0.01);
+        at = Vec3::new(feet.x + flat.x * k, at.y, feet.z + flat.y * k);
+    }
+    // Down to the ground there (from a little above, as the server's ground search).
+    let top = at + Vec3::Y * 1.0;
+    match first_hit(spatial, occluders, top, Vec3::NEG_Y, 60.0) {
+        Some(d) => top - Vec3::Y * d,
+        None => at,
+    }
+}
+
+/// Place the aim's circle each frame while the add-on asks for one.
+#[allow(clippy::too_many_arguments)]
+pub(super) fn update_aim_marker(
+    spatial: avian3d::prelude::SpatialQuery,
+    occluders: Query<(), With<PickOccluder>>,
+    me: Query<&GlobalTransform, With<SelfPlayer>>,
+    decals: WorldDecal,
+    time: Res<Time>,
+    mut state: ResMut<AimMarkerState>,
+    mut grounds: ResMut<GroundMarkers>,
+) {
+    let feet = me.single().ok().map(|t| t.translation());
+    match (action_combat::aim_marker(), feet) {
+        (Some(m), Some(feet)) => {
+            let at = aim_point(&spatial, &occluders, feet, m.range);
+            state.circle.place(&decals, at, m.radius.max(0.3));
+            state.shown = !state.circle.verts.is_empty();
+            action_combat::set_aim_point(Some(bevy_to_wow(at)));
+        }
+        _ => {
+            state.shown = false;
+            action_combat::set_aim_point(None);
+        }
+    }
+    // The timed markers: new ones (or a key again: moved), cleared ones, the lapsed.
+    let now = time.elapsed_secs();
+    for call in action_combat::take_ground_markers() {
+        match call {
+            GroundMarkerCall::Set {
+                key,
+                pos,
+                radius,
+                secs,
+                hostile,
+            } => {
+                grounds.list.retain(|g| g.key != key);
+                if grounds.list.len() >= MAX_MARKERS {
+                    grounds.list.remove(0);
+                }
+                let mut g = Ground {
+                    key,
+                    until: now + secs,
+                    hostile,
+                    circle: Circle::default(),
+                };
+                g.circle.place(&decals, wow_to_bevy(pos), radius.max(0.2));
+                grounds.list.push(g);
+            }
+            GroundMarkerCall::Clear { key } => match key {
+                Some(k) => grounds.list.retain(|g| g.key != k),
+                None => grounds.list.clear(),
+            },
+        }
+    }
+    grounds.list.retain(|g| g.until > now);
+    // Ground that streamed in under one: projected again.
+    for g in &mut grounds.list {
+        let (c, r) = (g.circle.center, g.circle.radius);
+        g.circle.place(&decals, c, r);
+    }
+}
+
+fn push_circle(
+    draw: &mut benilla_world::particles::buffer::WorldEffectDraw,
+    cam: Entity,
+    texture: AssetId<Image>,
+    circle: &Circle,
+    alpha: f32,
+) {
+    if circle.verts.is_empty() {
+        return;
+    }
+    let mut batch = draw.batch(cam, texture).anchored(circle.center).rung(
+        benilla_world::sky_order::Rung::RETICLE,
+        benilla_world::sky_order::Rung::DECAL_RASTER,
+    );
+    batch.extend(circle.verts.iter().map(|v| EffectVertex {
+        pos: v.pos,
+        uv: v.uv,
+        color: [1.0, 1.0, 1.0, v.color[3] * alpha],
+    }));
+    batch.tris();
+}
+
+/// Draw them: the aim's green, a warning red (fading in over its last moments).
+pub(super) fn push_aim_marker(
+    assets: Option<Res<MarkerAssets>>,
+    state: Option<Res<AimMarkerState>>,
+    grounds: Option<Res<GroundMarkers>>,
+    time: Res<Time>,
+    cam: Query<Entity, With<WorldCamera>>,
+    mut draw: benilla_world::particles::buffer::WorldEffectDraw,
+) {
+    let (Some(assets), Ok(cam)) = (assets, cam.single()) else {
+        return;
+    };
+    if let Some(state) = state.as_deref() {
+        if state.shown {
+            push_circle(&mut draw, cam, assets.ours.id(), &state.circle, 1.0);
+        }
+    }
+    let now = time.elapsed_secs();
+    if let Some(grounds) = grounds.as_deref() {
+        for g in &grounds.list {
+            let texture = if g.hostile {
+                assets.theirs.id()
+            } else {
+                assets.ours.id()
+            };
+            // Brighter as it comes down.
+            let left = (g.until - now).max(0.0);
+            let alpha = if left < 0.4 { 1.0 } else { 0.75 };
+            push_circle(&mut draw, cam, texture, &g.circle, alpha);
+        }
+    }
+}
