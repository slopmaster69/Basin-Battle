+/// Basin Battle's heal green, the add-on's own (0.4, 1, 0.45): the number over a friend you mend
+/// matches the one over your own health bar.
+pub(crate) const COLOR_HEAL_GREEN: u32 = 0xFF66_FF73;
+
+/// `SMSG_SPELLHEALLOG`, our own leg (1.12 floats no heal anywhere): a heal I or my pet cast on
+/// someone else floats its number in green over them, as later WoW does; a crit pops like a damage
+/// crit. A heal on me floats nothing here (the add-on shows it at the health bar), nor does anyone
+/// else's heal. No spell record is needed: the server sends spell 0 for a mend with no 1.12 spell.
+pub(super) fn spell_heal_log(
+    s: SpellHealLog,
+    index: &GuidIndex,
+    self_guid: &SelfGuid,
+    stores: &Query<&mut ObjectStore>,
+    text: &mut MessageWriter<CombatTextSpawn>,
+) {
+    if s.amount == 0 || classify_source(s.healer, index, self_guid, stores).is_none() {
+        return;
+    }
+    if let Some(anchor) = gated_anchor(s.target, index, self_guid, stores) {
+        text.write(CombatTextSpawn {
+            anchor,
+            text: TextBody::Literal(s.amount.to_string()),
+            category: if s.critical { 2 } else { 0 },
+            color: Some(COLOR_HEAL_GREEN),
+        });
+    }
+}
+
 /// The colour a spell's miss words take, or `None` where `0x607140` draws nothing: the same
 /// source class and three CVars as the number emitter, `CombatDamage` (`0x60718f`),
 /// `PetSpellDamage` (`0x6071a6`) and `PetMeleeDamage` (`0x6071c5`), with the spell's record pushed,
@@ -496,6 +524,66 @@ mod tests {
         );
     }
 
+    /// My heal on a friend floats green over them (a crit pops); a heal on me, or someone else's
+    /// heal on the friend, floats nothing.
+    #[test]
+    fn my_heal_on_a_friend_floats_green_over_them() {
+        let mut app = App::new();
+        app.add_message::<CombatTextSpawn>()
+            .init_resource::<GuidIndex>()
+            .init_resource::<SelfGuid>();
+        let self_e = app.world_mut().spawn((Guid(10), SelfPlayer, unit())).id();
+        let friend_e = app.world_mut().spawn((Guid(20), unit())).id();
+        let other_e = app.world_mut().spawn((Guid(30), unit())).id();
+        {
+            let mut index = app.world_mut().resource_mut::<GuidIndex>();
+            index.0.insert(10, self_e);
+            index.0.insert(20, friend_e);
+            index.0.insert(30, other_e);
+        }
+        app.world_mut().resource_mut::<SelfGuid>().0 = Some(10);
+        let heal = |healer, target, amount, critical| SpellHealLog {
+            target,
+            healer,
+            spell_id: 0,
+            amount,
+            critical,
+        };
+        let sent = [
+            heal(10, 20, 18, false), // mine on the friend
+            heal(10, 20, 40, true),  // mine, a crit
+            heal(10, 10, 25, false), // mine on me
+            heal(30, 20, 12, false), // someone else's
+            heal(10, 20, 0, false),  // nothing mended
+        ];
+        app.world_mut()
+            .run_system_once(
+                move |index: Res<GuidIndex>,
+                      self_guid: Res<SelfGuid>,
+                      stores: Query<&mut ObjectStore>,
+                      mut text: MessageWriter<CombatTextSpawn>| {
+                    for s in sent {
+                        spell_heal_log(s, &index, &self_guid, &stores, &mut text);
+                    }
+                },
+            )
+            .unwrap();
+        let spawned: Vec<_> = app
+            .world_mut()
+            .resource_mut::<Messages<CombatTextSpawn>>()
+            .drain()
+            .map(|s| (s.text, s.category, s.color, s.anchor))
+            .collect();
+        assert_eq!(
+            spawned,
+            vec![
+                (TextBody::Literal("18".into()), 0, Some(COLOR_HEAL_GREEN), friend_e),
+                (TextBody::Literal("40".into()), 2, Some(COLOR_HEAL_GREEN), friend_e),
+            ],
+            "only my heals on the friend, green, the crit popping"
+        );
+    }
+
     const ME: u64 = 10;
     const MOB: u64 = 20;
     const FIREBALL: u32 = 133;
