 }
 
-fn on_spell_heal_log(In(ev): In<SessionEvent>, c: Ctx, l: Sinks) {
+fn on_spell_heal_log(In(ev): In<SessionEvent>, c: Ctx, mut l: Sinks) {
     if let SessionEvent::SpellHealLog(s) = ev {
