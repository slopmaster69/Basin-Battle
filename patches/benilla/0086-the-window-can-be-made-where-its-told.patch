+    /// `$WOW_WINDOW_AT` reads `x,y`, negative too (a monitor left of the primary); anything else
+    /// is no position.
+    #[test]
+    fn wow_window_at_parses_a_desktop_position() {
+        assert_eq!(parse_window_at("-1920,212"), Some(IVec2::new(-1920, 212)));
+        assert_eq!(parse_window_at(" 3440 , 0 "), Some(IVec2::new(3440, 0)));
+        assert_eq!(parse_window_at("100"), None);
+        assert_eq!(parse_window_at("100x200"), None);
+        assert_eq!(parse_window_at("a,b"), None);
+        assert_eq!(parse_window_at(""), None);
+    }
+
+    /// Only a placed window trades a fullscreen birth for a windowed one; unplaced, and windowed,
+    /// births are as they were.
+    #[test]
+    fn a_placed_window_is_born_windowed_where_it_was_asked() {
+        let full = WindowMode::BorderlessFullscreen(MonitorSelection::Primary);
+        let at = Some(IVec2::new(-1920, 212));
+        assert_eq!(born_at(full, at), WindowMode::Windowed);
+        assert_eq!(born_at(full, None), full);
+        assert_eq!(born_at(WindowMode::Windowed, at), WindowMode::Windowed);
+        assert_eq!(born_at(WindowMode::Windowed, None), WindowMode::Windowed);
+    }
+
