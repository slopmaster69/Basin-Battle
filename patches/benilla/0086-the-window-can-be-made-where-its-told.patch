+/// `$WOW_WINDOW_AT=<x>,<y>`: where the window is made, its outer top-left in physical pixels of the
+/// whole desktop (negative left of or above the primary monitor), so a harness filming on another
+/// monitor gets the window there from its first frame rather than moving it once it shows. Unset
+/// or unparsable: wherever the system puts it, as before.
+pub(crate) fn requested_window_position() -> Option<IVec2> {
+    parse_window_at(&std::env::var("WOW_WINDOW_AT").ok()?)
+}
+
+/// `"<x>,<y>"` (spaces allowed around either number) to a position.
+fn parse_window_at(value: &str) -> Option<IVec2> {
+    let (x, y) = value.split_once(',')?;
+    Some(IVec2::new(x.trim().parse().ok()?, y.trim().parse().ok()?))
+}
+
+/// The position the primary window is born at: [`requested_window_position`], or the system's.
+/// Physical pixels need no scale factor, so it holds on a monitor of another DPI than the primary;
+/// winit makes the window hidden, moves it there and only then is it shown.
+pub(crate) fn boot_window_position() -> WindowPosition {
+    requested_window_position().map_or(WindowPosition::Automatic, WindowPosition::At)
+}
+
+/// A window asked for at a position is born windowed even when the player's mode is fullscreen:
+/// `bevy_winit` places only a windowed window, and a fullscreen one is born on the `Primary`
+/// monitor. [`apply_window_mode`]'s first run then makes it fullscreen on the monitor it stands on
+/// (`Current`).
+fn born_at(mode: WindowMode, at: Option<IVec2>) -> WindowMode {
+    match (mode, at) {
+        (WindowMode::BorderlessFullscreen(_), Some(_)) => WindowMode::Windowed,
+        _ => mode,
+    }
+}
+
