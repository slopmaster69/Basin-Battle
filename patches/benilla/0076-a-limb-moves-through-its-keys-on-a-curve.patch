@@ -0,0 +1,21 @@
+//! Basin Battle: smooth curves through the clips' keys (not in 1.12.1). The evaluator samples each
+//! translation and rotation with [`benilla_assets::PoseTrack::sample_smooth`], a monotone curve
+//! through every key, in place of 1.12's straight lines between them, so a sparsely keyed limb
+//! moves without a kink at each key and never overshoots one. Inert unless an add-on drives the
+//! action layer ([`super::PoseInertia::live`]) and `actionCurves` is on: the stock client
+//! samples as 1.12 does.
+
+use bevy::prelude::*;
+
+/// The switch: `actionCurves` (benilla's own, registered "1"); it acts while the action layer is
+/// live, the flag [`super::PoseInertia`] carries.
+#[derive(Resource, Debug, Clone, Copy, PartialEq, Eq)]
+pub struct PoseCurves {
+    pub on: bool,
+}
+
+impl Default for PoseCurves {
+    fn default() -> Self {
+        Self { on: true }
+    }
+}
