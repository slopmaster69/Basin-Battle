+    /// Basin Battle: the smooth curve lands on every key, and before the first or past the last
+    /// it holds the end key as the linear sample does.
+    #[test]
+    fn the_smooth_curve_passes_through_every_key() {
+        let keys = [
+            (0.0, Vec3::ZERO),
+            (0.2, Vec3::new(1.0, 0.5, 0.0)),
+            (0.5, Vec3::new(1.5, -1.0, 2.0)),
+            (0.6, Vec3::new(0.0, 0.0, 1.0)),
+        ];
+        let track = PoseTrack::new(&keys);
+        for (t, v) in keys {
+            assert!(
+                (track.sample_smooth(t).unwrap() - v).length() < 1.0e-6,
+                "key at {t}"
+            );
+        }
+        for t in [-0.5, 0.9] {
+            assert_eq!(track.sample_smooth(t), track.sample(t));
+        }
+        assert!(PoseTrack::<Vec3>::new(&[]).sample_smooth(0.1).is_none());
+        let single = PoseTrack::new(&[(0.3, Vec3::Y)]);
+        assert_eq!(single.sample_smooth(1.0), Some(Vec3::Y));
+    }
+
+    /// Keys evenly spaced along a line stay a line: the curve only rounds the corners there are.
+    #[test]
+    fn evenly_spaced_keys_on_a_line_stay_straight() {
+        let keys: Vec<(f32, Vec3)> = (0..5)
+            .map(|i| (i as f32 * 0.1, Vec3::X * i as f32))
+            .collect();
+        let track = PoseTrack::new(&keys);
+        for i in 0..=40 {
+            let t = i as f32 * 0.01;
+            let (a, b) = (track.sample_smooth(t).unwrap(), track.sample(t).unwrap());
+            assert!((a - b).length() < 1.0e-5, "t={t}: {a} vs {b}");
+        }
+    }
+
+    /// A held pose (two equal keys) stays exactly held, and the curve never goes past a key it
+    /// turns back at: no overshoot through an impact frame or a hold.
+    #[test]
+    fn a_held_pose_is_held_and_nothing_overshoots() {
+        let keys = [
+            (0.0, Vec3::ZERO),
+            (0.1, Vec3::X * 2.0),
+            (0.3, Vec3::X * 2.0),
+            (0.35, Vec3::ZERO),
+            (0.6, Vec3::X * -1.0),
+        ];
+        let track = PoseTrack::new(&keys);
+        for i in 0..=60 {
+            let t = i as f32 * 0.01;
+            let v = track.sample_smooth(t).unwrap();
+            assert!(
+                v.x <= 2.0 + 1.0e-5 && v.x >= -1.0 - 1.0e-5,
+                "t={t}: {v} left the keys' range"
+            );
+            if (0.1..=0.3).contains(&t) {
+                assert!((v.x - 2.0).abs() < 1.0e-5, "t={t}: the hold sags to {v}");
+            }
+        }
+    }
+
+    /// Across a key where the motion bends, the linear sample's speed jumps; the curve's doesn't.
+    #[test]
+    fn the_curve_has_no_kink_at_a_key() {
+        let keys = [
+            (0.0, Vec3::ZERO),
+            (0.2, Vec3::X),
+            (0.4, Vec3::X * 3.0),
+            (0.6, Vec3::X * 6.0),
+        ];
+        let track = PoseTrack::new(&keys);
+        let e = 1.0e-3;
+        let speed = |f: &dyn Fn(f32) -> Vec3, t: f32| (f(t + e) - f(t)).x / e;
+        let lin = |t: f32| track.sample(t).unwrap();
+        let smooth = |t: f32| track.sample_smooth(t).unwrap();
+        let k = 0.2;
+        let lin_jump = (speed(&lin, k + e) - speed(&lin, k - 2.0 * e)).abs();
+        let smooth_jump = (speed(&smooth, k + e) - speed(&smooth, k - 2.0 * e)).abs();
+        assert!(
+            lin_jump > 4.0,
+            "linear: speed 5 then 10 across the key ({lin_jump})"
+        );
+        assert!(
+            smooth_jump < 0.5,
+            "smooth: one speed across it ({smooth_jump})"
+        );
+    }
+
+    /// A turn's curve lands on its keys (the short way round), holds a held turn, and stays a
+    /// unit quaternion between them.
+    #[test]
+    fn a_turns_curve_lands_on_its_keys_and_holds() {
+        let keys = [
+            (0.0, Quat::from_rotation_y(0.2)),
+            (0.25, Quat::from_rotation_x(1.1)),
+            (0.4, Quat::from_rotation_x(1.1)),
+            (0.7, Quat::from_axis_angle(Vec3::new(0.6, 0.8, 0.0), 2.5)),
+        ];
+        let track = PoseTrack::new(&keys);
+        for (t, q) in keys {
+            assert!(
+                track.sample_smooth(t).unwrap().angle_between(q) < 1.0e-4,
+                "key at {t}"
+            );
+        }
+        for i in 0..=70 {
+            let t = i as f32 * 0.01;
+            let q = track.sample_smooth(t).unwrap();
+            assert!((q.length() - 1.0).abs() < 1.0e-4, "t={t}: not unit");
+            if (0.25..=0.4).contains(&t) {
+                assert!(
+                    q.angle_between(keys[1].1) < 1.0e-4,
+                    "t={t}: the held turn drifts"
+                );
+            }
+        }
+    }
 }
