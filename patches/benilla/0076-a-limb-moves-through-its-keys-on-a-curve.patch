@@ -77,6 +77,119 @@ impl<T: Animatable + Clone> PoseTrack<T> {
     pub fn keys(&self) -> impl Iterator<Item = (f32, &T)> {
         self.times.iter().copied().zip(self.values.iter())
     }
+
+    /// The segment `t` falls inside, between two distinct keys, and how far along it: `None` on a
+    /// key, before the first or past the last, where [`Self::sample`] already gives the key.
+    #[inline]
+    fn segment(&self, t: f32) -> Option<(usize, f32)> {
+        let times = &self.times;
+        if times.len() < 2 {
+            return None;
+        }
+        match times.binary_search_by(|pt| pt.partial_cmp(&t).unwrap()) {
+            Err(i) if i > 0 && i < times.len() => {
+                Some((i - 1, (t - times[i - 1]) / (times[i] - times[i - 1])))
+            }
+            _ => None,
+        }
+    }
+
+    /// The keys around segment `i`: the one before it (or its own start, at the first), its two
+    /// ends, and the one after it (or its own end, at the last), with their times.
+    #[inline]
+    fn around(&self, i: usize) -> ([f32; 4], [&T; 4]) {
+        let last = self.times.len() - 1;
+        let (a, d) = (i.saturating_sub(1), (i + 2).min(last));
+        (
+            [
+                self.times[a],
+                self.times[i],
+                self.times[i + 1],
+                self.times[d],
+            ],
+            [
+                &self.values[a],
+                &self.values[i],
+                &self.values[i + 1],
+                &self.values[d],
+            ],
+        )
+    }
+}
+
+/// Basin Battle: smooth sampling, a curve through the keys in place of straight lines between
+/// them. 1.12's character clips are keyed sparsely and played linearly, so a limb snaps from key
+/// to key with a kink in its motion at each; this curve passes through every key with no kink. Its
+/// tangents are monotone (the harmonic mean of the two slopes beside a key, nothing where the
+/// motion turns back), so it never overshoots a key or bulges through a held pose: an impact frame
+/// lands where it is keyed. The evaluator samples this way only while the action layer's curves are
+/// on; [`PoseTrack::sample`] stays Bevy's exact linear.
+impl PoseTrack<Vec3> {
+    pub fn sample_smooth(&self, t: f32) -> Option<Vec3> {
+        let Some((i, s)) = self.segment(t) else {
+            return self.sample(t);
+        };
+        let (times, [p0, p1, p2, p3]) = self.around(i);
+        Some(monotone_hermite(times, [*p0, *p1, *p2, *p3], s))
+    }
+}
+
+impl PoseTrack<Quat> {
+    /// The same curve for a turn, drawn in the turn's log space about the segment's first key
+    /// (every neighbour taken the short way round from it), so its ends are the keys exactly.
+    pub fn sample_smooth(&self, t: f32) -> Option<Quat> {
+        let Some((i, s)) = self.segment(t) else {
+            return self.sample(t);
+        };
+        let (times, [q0, q1, q2, q3]) = self.around(i);
+        let base = *q1;
+        let inv = base.inverse();
+        let log = |q: &Quat| {
+            let r = inv * *q;
+            let r = if r.w < 0.0 { -r } else { r };
+            r.to_scaled_axis()
+        };
+        let curve = monotone_hermite(times, [log(q0), Vec3::ZERO, log(q2), log(q3)], s);
+        Some((base * Quat::from_scaled_axis(curve)).normalize())
+    }
+}
+
+/// The cubic Hermite through `p1` and `p2` (at fraction `s` of the way), with monotone tangents
+/// from the slopes of the segments on either side (`p0` and `p3` the keys beyond; at an end the
+/// segment's own slope stands in). Per axis, a tangent is the harmonic mean of its two slopes when
+/// they agree in sign and zero when they don't, which keeps the curve inside its keys' range.
+fn monotone_hermite(times: [f32; 4], p: [Vec3; 4], s: f32) -> Vec3 {
+    let [t0, t1, t2, t3] = times;
+    let h = t2 - t1;
+    let mid = (p[2] - p[1]) / h;
+    let before = if t1 > t0 {
+        (p[1] - p[0]) / (t1 - t0)
+    } else {
+        mid
+    };
+    let after = if t3 > t2 {
+        (p[3] - p[2]) / (t3 - t2)
+    } else {
+        mid
+    };
+    let m1 = monotone_tangent(before, mid) * h;
+    let m2 = monotone_tangent(mid, after) * h;
+    let (s2, s3) = (s * s, s * s * s);
+    p[1] * (2.0 * s3 - 3.0 * s2 + 1.0)
+        + m1 * (s3 - 2.0 * s2 + s)
+        + p[2] * (-2.0 * s3 + 3.0 * s2)
+        + m2 * (s3 - s2)
+}
+
+fn monotone_tangent(a: Vec3, b: Vec3) -> Vec3 {
+    let axis = |a: f32, b: f32| {
+        if a * b <= 0.0 {
+            0.0
+        } else {
+            2.0 * a * b / (a + b)
+        }
+    };
+    Vec3::new(axis(a.x, b.x), axis(a.y, b.y), axis(a.z, b.z))
 }
 
