--- a/crates/benilla-assets/src/deadmines_aftermath.rs
+++ b/crates/benilla-assets/src/deadmines_aftermath.rs
@@ -19,6 +19,24 @@ pub const SHIP_ADT_DOODADS: &[u32] = &[
     333919,
 ];
 
+// Basin Battle patch 0091. Mirrored in htl-map/src/deadmines/aftermath.rs, whose server plans
+// what stands in each one's place.
+/// The mine's own doodads (MODD indices) the collapse knocked over or put out: the server sets
+/// its own toppled, tipped or crooked copies where they stood, so the WMO's are hidden.
+pub const MINE_DOODADS: &[u32] = &[
+    67, 88, 89, 92, 93, 98, 101, 103, 104, 105, 106, 108, 120, 141, 162, 184, 185, 186, 220, 221,
+    251, 252, 253, 254, 255, 256, 257, 259, 264, 283, 331, 332, 333, 342, 381, 386, 387, 502, 503,
+    513,
+];
+/// Of those, the lanterns whose light goes out with them.
+pub const DARK_LANTERNS: &[u32] = &[
+    98, 101, 106, 108, 120, 162, 184, 185, 220, 221, 283, 331, 332, 333, 381, 386, 387, 502, 503,
+    513,
+];
+/// A put-out lantern's own lights are the mine's (MOLT) within this of its pivot (yd): the mine's
+/// lanterns carry theirs 0.4 to 1 yd off it, and no two lanterns' lights are this close.
+pub const LANTERN_REACH: f32 = 1.6;
+
 pub fn is_ship_root(path: &str) -> bool {
     path.replace('\\', "/")
         .eq_ignore_ascii_case("world/wmo/dungeon/az_deadmines/az_deadmines_b.wmo")
@@ -112,11 +130,39 @@ pub(crate) fn variant(
     for d in m.doodads.iter_mut().take(SHIP_DOODADS) {
         d.model.clear();
     }
+    hide_mine_doodads(&mut m);
     (m.group_collision_bounds, m.collision_bounds) = collision_tri_bounds(&m.group_collision_tris);
     m.group_collision_grids = collision_tri_grids(&m.group_collision_tris);
     m
 }
 
+/// The collapse's own doodads gone (patch 0091): each one's model cleared, as the ship's are, so
+/// no prop, collider or interior-light slot is made for it; and a put-out lantern's lights dark.
+/// A light at zero is still spawned and still named by its rooms, so nothing becomes ungated.
+fn hide_mine_doodads(m: &mut WmoModel) {
+    let mut dark = Vec::new();
+    for &i in MINE_DOODADS {
+        let Some(d) = m.doodads.get_mut(i as usize) else {
+            continue;
+        };
+        if DARK_LANTERNS.contains(&i) {
+            dark.push(d.position);
+        }
+        d.model.clear();
+    }
+    for light in &mut m.lights {
+        let near = |at: &[f32; 3]| {
+            (0..3)
+                .map(|a| (light.position[a] - at[a]).powi(2))
+                .sum::<f32>()
+                < LANTERN_REACH * LANTERN_REACH
+        };
+        if dark.iter().any(near) {
+            light.intensity = 0.0;
+        }
+    }
+}
+
 #[cfg(test)]
 mod tests {
     use super::*;
@@ -264,4 +310,60 @@ mod tests {
         assert_eq!(intact.group_nav[17].area_table_id, 7);
         assert_eq!(intact.group_collision_tris[30], vec![tri]);
     }
+
+    #[test]
+    fn the_collapse_hides_its_doodads_and_puts_out_its_lanterns_in_the_variant_only() {
+        assert!(
+            MINE_DOODADS.windows(2).all(|w| w[0] < w[1]),
+            "sorted, each once"
+        );
+        assert!(MINE_DOODADS.iter().all(|&i| i as usize >= SHIP_DOODADS));
+        assert!(DARK_LANTERNS.iter().all(|i| MINE_DOODADS.contains(i)));
+        let last = *MINE_DOODADS.iter().max().unwrap() as usize + 2;
+        // One doodad every 4 yd along x, each with its own light 0.4 yd over its pivot.
+        let doodads: Vec<benilla_formats::WmoDoodad> = (0..last)
+            .map(|i| benilla_formats::WmoDoodad {
+                model: format!("doodad{i}.m2"),
+                position: [4.0 * i as f32, 0.0, 0.0],
+                orientation: [0., 0., 0., 1.],
+                scale: 1.,
+                color: [255; 4],
+            })
+            .collect();
+        let lights: Vec<benilla_formats::WmoLight> = (0..last)
+            .map(|i| benilla_formats::WmoLight {
+                light_type: 0,
+                use_atten: true,
+                color: [1.0, 0.8, 0.5],
+                position: [4.0 * i as f32, 0.0, 0.4],
+                intensity: 1.0,
+                attenuation_start: 1.0,
+                attenuation_end: 6.0,
+            })
+            .collect();
+        let intact = WmoModel {
+            doodads,
+            lights,
+            ..Default::default()
+        };
+        let after = variant(&intact, CollisionMesh::default(), CollisionMesh::default());
+        for i in SHIP_DOODADS..last {
+            let hidden = MINE_DOODADS.contains(&(i as u32));
+            let dark = DARK_LANTERNS.contains(&(i as u32));
+            assert_eq!(after.doodads[i].model.is_empty(), hidden, "doodad {i}");
+            assert_eq!(
+                after.lights[i].intensity,
+                if dark { 0.0 } else { 1.0 },
+                "light {i}"
+            );
+            // The intact model, which the marker's going brings back, is untouched.
+            assert_eq!(intact.doodads[i].model, format!("doodad{i}.m2"));
+            assert_eq!(intact.lights[i].intensity, 1.0);
+        }
+        assert_eq!(
+            after.lights.len(),
+            intact.lights.len(),
+            "a dark light keeps its place"
+        );
+    }
 }
