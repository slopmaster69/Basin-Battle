 use std::collections::HashMap;
 use std::sync::Mutex;
@@ -9,6 +12,12 @@ use std::sync::Mutex;
 use bevy::prelude::*;
 
 static TIPS: Mutex<Option<HashMap<Entity, Vec3>>> = Mutex::new(None);
+static DRAWN: Mutex<Option<std::collections::HashSet<Entity>>> = Mutex::new(None);
+
+/// Whether a unit keeps its weapon drawn through a stowing clip (it's flagged as a staff holder).
+pub(crate) fn keeps_drawn(unit: Entity) -> bool {
+    DRAWN.lock().ok().and_then(|d| d.as_ref().map(|d| d.contains(&unit))).unwrap_or(false)
+}
 
