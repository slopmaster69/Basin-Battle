             let local = is_self && !benilla_ui::action_combat::layer_live();
+            // Basin Battle: a staff holder (`SetUnitMissileOrigin(unit, "weapon")`) keeps the
+            // staff in hand through a spell clip's stow, unless mounted or put away by choice.
+            let keep = cur != 0 && !mounted && crate::entities::weapon_tip::keeps_drawn(entity);
             if let Some(forced) =
                 select::reconcile_sheath(cur, anim, flags, engaged, local, sheath_byte, mounted)
