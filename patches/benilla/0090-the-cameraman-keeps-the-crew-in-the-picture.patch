+/// How far out along `out` from `look` the eye has to stand for every one of `points` to be in
+/// the picture (inside the view's half-angles, with their margins).
+fn fit_all(look: Vec3, out: Vec3, points: &[Vec3]) -> f32 {
+    let ahead = -out;
+    let right = ahead.cross(Vec3::Y).normalize_or(Vec3::X);
+    let up = right.cross(ahead);
+    points
+        .iter()
+        .map(|&p| {
+            let v = p - look;
+            // Its depth from the eye is `d + v·ahead`; across and up it's `v·right`, `v·up`.
+            (v.dot(right).abs() / TAN_HALF_WIDE).max(v.dot(up).abs() / TAN_HALF_TALL) - v.dot(ahead)
+        })
+        .fold(0.0, f32::max)
+}
