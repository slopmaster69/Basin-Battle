+    /// Whether `p` is in the picture from the pose's eye.
+    fn in_frame(pose: &Pose, p: Vec3) -> bool {
+        let eye = pose.look + pose.out * pose.dist;
+        let ahead = -pose.out;
+        let right = ahead.cross(Vec3::Y).normalize();
+        let up = right.cross(ahead);
+        let v = p - eye;
+        let depth = v.dot(ahead);
+        depth > 0.0 && v.dot(right).abs() <= depth * TAN_HALF_WIDE + 1e-3 && v.dot(up).abs() <= depth * TAN_HALF_TALL + 1e-3
+    }
