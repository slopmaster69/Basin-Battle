+/// The thunder: the kit it plays (looked up once), the strike last heard, and the claps waiting
+/// for their delay (real seconds, loudness).
+#[derive(Resource, Default)]
+pub(super) struct Thunder {
+    kit: Option<Option<u32>>,
+    heard: Option<(u64, i64)>,
+    due: Vec<(f64, f32)>,
+}
+
+/// A thunder kit, looked up once: [`pick_thunder`] over the sound table, the pick logged, and
+/// nothing (a silent storm) if no kit fits.
+fn find_thunder(catalog: &benilla_formats::SoundKitCatalog) -> Option<u32> {
+    let kits: Vec<(u32, &str, Vec<&str>)> = catalog
+        .iter()
+        .map(|k| {
+            (
+                k.id,
+                k.name.as_str(),
+                k.files.iter().map(|(f, _)| f.as_str()).collect(),
+            )
+        })
+        .collect();
+    let found = pick_thunder(
+        kits.iter()
+            .map(|(id, name, files)| (*id, *name, files.as_slice())),
+    );
+    match found {
+        Some((id, name)) => {
+            info!("weather: thunder plays kit {id} ({name})");
+            Some(id)
+        }
+        None => {
+            info!("weather: no ambient thunder kit found; lightning is silent");
+            None
+        }
+    }
+}
+
+/// The thunder among `(id, name, files)` kits: a kit whose files or name say thunder and whose
+/// every file sits under the world's ambience or weather sounds (`Sound\Ambience\`, a path
+/// naming weather), never a creature's, a spell's, a character's or an item's. The first take
+/// played kit 8432 (`ThunderaanAttack`, a boss's attack, under `Sound\Creature\`). Names of
+/// creature and spell kits (`*Attack`, `*Wound`, `*Death`, `*Aggro`, a cast or an impact) are left
+/// out too, and Thunder Bluff, Thunder Clap, Thunderfury and music. The lowest id wins; `None`
+/// if nothing fits, and the storm is then silent.
+fn pick_thunder<'a>(
+    kits: impl Iterator<Item = (u32, &'a str, &'a [&'a str])>,
+) -> Option<(u32, String)> {
+    const NOT_WEATHER: [&str; 13] = [
+        "attack", "wound", "death", "aggro", "cast", "impact", "spell", "bluff", "clap", "fury",
+        "music", "lizard", "creature",
+    ];
+    let ambient_path = |f: &str| {
+        let f = f.to_ascii_lowercase().replace('/', "\\");
+        (f.contains("sound\\ambience\\") || f.contains("weather"))
+            && !["\\creature\\", "\\spells\\", "\\character\\", "\\item\\"]
+                .iter()
+                .any(|x| f.contains(x))
+    };
+    kits.filter(|(_, name, files)| {
+        let lname = name.to_ascii_lowercase();
+        let says_thunder = lname.contains("thunder")
+            || files
+                .iter()
+                .any(|f| f.to_ascii_lowercase().contains("thunder"));
+        let clean = |s: &str| {
+            let s = s.to_ascii_lowercase();
+            !NOT_WEATHER.iter().any(|x| s.contains(x))
+        };
+        says_thunder
+            && !files.is_empty()
+            && files.iter().all(|f| ambient_path(f) && clean(f))
+            && clean(&lname)
+    })
+    .map(|(id, name, _)| (id, name.to_string()))
+    .min_by_key(|(id, _)| *id)
+}
+
+/// Queues each new strike's thunder after its delay and plays what is due, 2D on the ambience.
+#[allow(clippy::too_many_arguments)]
+fn thunder(
+    real: Res<Time<bevy::time::Real>>,
+    look: Option<Res<WeatherLook>>,
+    kits: Option<ResMut<SoundKits>>,
+    assets: Option<Res<WorldAssets>>,
+    mut out: NonSendMut<SoundOutput>,
+    config: Res<SoundConfig>,
+    listener: Res<AudioListener>,
+    mut st: ResMut<Thunder>,
+) {
+    use benilla_world::look::weather::tune;
+    let now = real.elapsed_secs_f64();
+    if let Some(k) = look.as_ref().filter(|l| l.on).and_then(|l| l.strike) {
+        let key = (k.seed, k.id);
+        if st.heard != Some(key) {
+            st.heard = Some(key);
+            let since = look.as_ref().map_or(0.0, |l| l.since_cue);
+            let wait = k.at + f64::from(k.thunder_after) - since;
+            // A strike long past (a hero arriving mid-storm) has had its thunder.
+            if wait > -1.0 {
+                let far = (k.thunder_after - tune::THUNDER_AFTER_MIN_S)
+                    / (tune::THUNDER_AFTER_MAX_S - tune::THUNDER_AFTER_MIN_S);
+                st.due
+                    .push((now + wait.max(0.0), k.power * (1.0 - 0.6 * far)));
+            }
+        }
+    }
+    if st.due.iter().all(|(at, _)| *at > now) {
+        return;
+    }
+    let (Some(mut kits), Some(assets)) = (kits, assets) else {
+        return;
+    };
+    let kit = *st.kit.get_or_insert_with(|| find_thunder(kits.catalog()));
+    let due: Vec<f32> = st
+        .due
+        .iter()
+        .filter(|(at, _)| *at <= now)
+        .map(|(_, loud)| *loud)
+        .collect();
+    st.due.retain(|(at, _)| *at > now);
+    let Some(id) = kit else { return };
+    for loud in due {
+        if let Err(e) = play_kit_ext(
+            &mut kits,
+            &assets,
+            &mut out,
+            &config,
+            listener.pos,
+            KitRef::Id(id),
+            None,
+            SoundCategory::Ambience,
+            PlayExtras {
+                volume_mult: Volume(loud),
+                ..Default::default()
+            },
+        ) {
+            warn!("weather: thunder kit {id} — {e:#}");
         }
     }
 }
