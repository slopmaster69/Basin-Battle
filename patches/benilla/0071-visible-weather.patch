+            bloom: 0.1,
+            ..PostLook::NEUTRAL
+        };
+        let grey = apply_post(post, &look(1.0, 0.0));
+        assert!(grey.rays < 0.1 * post.rays + 1e-6 && grey.warmth < post.warmth);
+        assert_eq!(
+            apply_post(post, &look(0.0, 0.0)),
