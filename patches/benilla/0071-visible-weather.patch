+            .find_map(|s| strike_in(seed, s, 1.0))
+            .expect("a strike");
+        assert_eq!(strike_in(seed, k.id, 1.0), Some(k), "the same every time");
+        let (peak, latest) = flash_at(seed, k.at + 0.01, 1.0);
+        assert!(peak > 0.5 * k.power, "{peak}");
+        assert_eq!(latest.map(|s| s.id), Some(k.id));
+        let before = flash_at(seed, k.at - 0.01, 1.0);
+        assert!(before.0 < 1e-3 || before.1 != Some(k));
+        assert_eq!(
+            flash_at(seed, k.at + 0.7, 1.0).0,
+            0.0,
+            "over in well under a second"
+        );
+        let pattern = |seed| {
+            (0..40)
+                .map(|s| strike_in(seed, s, 1.0).is_some())
+                .collect::<Vec<_>>()
+        };
+        let next = cue_seed(20_400, 0.9995f32.to_bits());
+        assert_ne!(
+            pattern(seed),
+            pattern(next),
+            "the next cue strikes otherwise"
+        );
+        assert_ne!(pattern(seed), pattern(cue_seed(20_401, 1.0f32.to_bits())));
+        assert!((tune::THUNDER_AFTER_MIN_S..=tune::THUNDER_AFTER_MAX_S).contains(&k.thunder_after));
