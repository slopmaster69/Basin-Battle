 /// the day and the weather say notwithstanding, for tuning on film (the server sends no weather
 /// yet); `looksky grade`, or no argument, lets go. `worldSky 0` and the classic look (`worldLook
 /// 0`) have 1.12's sky either way.
+/// `lookweather <clear|overcast|rain|storm> [intensity]`, benilla's own (1.12 has no such
+/// command): holds a weather here for film, whatever the server says, at an intensity from 0 to 1
+/// (0.7 if none), through 1.12's own weather path, so `worldLook 0` shows 1.12's rain for it too;
+/// `lookweather server` (or `grade`) follows the server's weather again; no argument says what is
+/// on. `worldWeather 0` keeps 1.12's look of the weather.
+fn look_weather(world: &mut World, args: &str) -> Vec<String> {
+    use benilla_world::look::weather::WeatherCommand;
+    use benilla_world::look::{LookWeather, WeatherLook, WorldLook};
+    let usage = "Usage: lookweather <clear|overcast|rain|storm> [0-1] | server | grade";
+    let Some(cmd) = LookWeather::parse(args) else {
+        return vec![usage.to_string()];
+    };
+    let on = {
+        let mut weather = world.get_resource_or_init::<LookWeather>();
+        match cmd {
+            WeatherCommand::Hold(sky, i) => weather.force = Some((sky, i)),
+            WeatherCommand::Follow => weather.force = None,
+            WeatherCommand::Show => {}
+        }
+        weather.on
+    };
+    let mut lines = vec![match cmd {
+        WeatherCommand::Hold(sky, i) => format!("Weather held: {} at {i}.", sky.name()),
+        WeatherCommand::Follow => "Weather follows the server's.".to_string(),
+        WeatherCommand::Show => {
+            let held = world.get_resource::<LookWeather>().and_then(|w| w.force);
+            let f = world
+                .get_resource::<WeatherLook>()
+                .copied()
+                .unwrap_or_default();
+            format!(
+                "{}: overcast {:.2}, rain {:.2}, storm {:.2}, wet {:.2}.",
+                match held {
+                    Some((sky, i)) => format!("Held {} at {i}", sky.name()),
+                    None => "The server's weather".to_string(),
+                },
+                f.overcast,
+                f.rain,
+                f.storm,
+                f.wet
+            )
+        }
+    }];
+    if !on {
+        lines.push("worldWeather is 0: 1.12's look of the weather.".to_string());
+    }
+    if !world.get_resource::<WorldLook>().is_some_and(|l| l.on) {
+        lines.push("The classic look (worldLook 0) shows 1.12's weather.".to_string());
+    }
+    lines
+}
