+            "clear is the grade's"
+        );
+        assert!(apply_post(post, &look(0.0, 1.0)).bloom > post.bloom);
+        assert!(apply_post(PostLook::NEUTRAL, &look(1.0, 1.0)).is_neutral());
+        assert_eq!(shadow_scale(Some(&look(1.0, 0.0))), 1.0 - tune::SHADOW_FADE);
