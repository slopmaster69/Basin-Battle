+// ---- look wet: mirrored in terrain.wgsl and static_gx.wgsl (keep in sync; `look::weather`'s
+// tests compare them) ----
+// The new look's wet ground (`look::weather`, benilla's own, no reference behaviour): while it
+// rains and as it dries, `wet` = [how much darker, sheen, sharpness] (the shared light's row 19
+// `.z` and row 20 `.zw`), all zero when dry and under the classic look, when no caller runs this.
+// Ground, stone and roofs facing up take all of it, walls a share, undersides (eaves, a cart's
+// belly) none, in soft patches like puddles and drier ground. The sheen is the sun's (or the
+// moon's) highlight where it is not shadowed (`sun_vis`), the sky's at a grazing angle, and every
+// new-look light's reflection (a lamp's, a torch's, a building's window light): a streak on the
+// wet stone from under it toward the camera, brightest in the puddles. The shape constants are
+// `look::weather::tune`'s `WET_*`, mirrored here.
+const WET_WALL: f32 = 0.45;
+const WET_SKY: f32 = 0.35;
+const WET_TORCH: f32 = 1.2;
+const WET_TORCH_REACH: f32 = 2.5;
+const WET_LANE_ACROSS: f32 = 0.06;
+const WET_LANE_ALONG: f32 = 0.45;
+const WET_PUDDLE: f32 = 0.6;
+const WET_PATCH: f32 = 0.35;
+
+fn look_wet_hash(c: vec2<f32>) -> f32 {
+    let h = fract(sin(dot(c, vec2<f32>(127.1, 311.7))) * 43758.5453);
+    return h;
+}
+
+// Soft value noise, 0..1, about a cell a unit.
+fn look_wet_noise(p: vec2<f32>) -> f32 {
+    let c = floor(p);
+    let f = p - c;
+    let u = f * f * (3.0 - 2.0 * f);
+    let a = look_wet_hash(c);
+    let b = look_wet_hash(c + vec2<f32>(1.0, 0.0));
+    let d = look_wet_hash(c + vec2<f32>(0.0, 1.0));
+    let e = look_wet_hash(c + vec2<f32>(1.0, 1.0));
+    return mix(mix(a, b, u.x), mix(d, e, u.x), u.y);
+}
+
+fn look_wet(rgb: vec3<f32>, P: vec3<f32>, N: vec3<f32>, sun_vis: f32, wet: vec3<f32>) -> vec3<f32> {
+    let share = mix(WET_WALL, 1.0, smoothstep(0.0, 0.7, N.y)) * smoothstep(-0.6, -0.15, N.y);
+    if (share <= 0.0) {
+        return rgb;
+    }
+    let blot = (1.0 - WET_PATCH) + WET_PATCH * look_wet_noise(P.xz * 0.45);
+    let soak = share * blot;
+    let V = normalize(view.world_position.xyz - P);
+    let sharp = max(wet.z, 1.0);
+    // The sun (or the moon), where it reaches.
+    let L = -normalize(wow_light.light_sun.xyz);
+    let H = normalize(L + V);
+    var spec = wow_light.light_diffuse.rgb
+        * (pow(max(dot(N, H), 0.0), sharp) * max(dot(N, L), 0.0) * sun_vis);
+    // The sky, at a grazing angle.
+    let fres = pow(1.0 - clamp(dot(N, V), 0.0, 1.0), 5.0);
+    spec += wow_light.fog_color.rgb * (fres * WET_SKY);
+    // The lamps, torches and spells, mirrored: where the ray mirrored off the wet surface passes
+    // near a light, narrow across its bearing and long along its elevation, so each light lies on
+    // the ground as a streak from under it toward the camera, out past its own pool.
+    let R = reflect(-V, N);
+    let r_flat = vec2<f32>(R.x, R.z);
+    let r_len = max(length(r_flat), 1e-4);
+    let r_el = atan2(R.y, r_len);
+    let puddle = smoothstep(0.45, 0.7, look_wet_noise(P.xz * 0.9 + vec2<f32>(17.0, 5.0)));
+    let mirror = (1.0 - WET_PUDDLE) + WET_PUDDLE * puddle;
+    let count = u32(wow_light.point_count.y);
+    for (var i = 0u; i < count; i = i + 1u) {
+        let pos_radius = wow_light.look_lights[2u * i];
+        let to_light = pos_radius.xyz - P;
+        let d2 = dot(to_light, to_light);
+        let reach = pos_radius.w * WET_TORCH_REACH;
+        let r2 = reach * reach;
+        if (d2 >= r2) {
+            continue;
+        }
+        let x2 = d2 / r2;
+        let window = (1.0 - x2) * (1.0 - x2);
+        let l_flat = vec2<f32>(to_light.x, to_light.z);
+        let l_len = max(length(l_flat), 1e-4);
+        let across = (r_flat.x * l_flat.y - r_flat.y * l_flat.x) / (r_len * l_len * WET_LANE_ACROSS);
+        let along = (r_el - atan2(to_light.y, l_len)) / WET_LANE_ALONG;
+        let ahead = select(0.0, 1.0, dot(r_flat, l_flat) > 0.0);
+        spec += wow_light.look_lights[2u * i + 1u].rgb
+            * (window * WET_TORCH * mirror * ahead * exp(-(across * across) - along * along));
+    }
+    let res = rgb * (1.0 - wet.x * soak) + spec * (wet.y * soak);
+    return clamp(res, vec3<f32>(0.0), vec3<f32>(1.0));
+}
