+/// `GAMEOBJECT_FLAGS`, field 9.
+const GO_FLAGS_FIELD: u16 = 9;
+
+/// A building preview (benilla's own, `GAMEOBJECT_FLAGS` bit `0x1000_0000`) is the GameObject a
+/// re-create moves: the hero aims it, and the server re-creates it where it now stands.
+#[test]
+fn a_recreate_moves_a_building_preview_in_place() {
+    const GO: u64 = 0xF110_0000_0000_000A;
+    let mut app = client();
+    let (tx, _rx) = crossbeam_channel::unbounded();
+    app.insert_resource(NetCommands(tx));
+    let world = app.world_mut();
+    let preview = |position: [f32; 3]| {
+        let mut b = create(GO, EntityKind::GameObject, position);
+        if let SessionEvent::ObjectCreate { fields, scale, .. } = &mut b {
+            *fields = ObjectFields::from_pairs(&[(
+                GO_FLAGS_FIELD,
+                crate::entities::preview::PREVIEW_MOVE | crate::entities::preview::PREVIEW_GHOST,
+            )]);
+            *scale = 1.5;
+        }
+        b
+    };
+    super::super::handlers::dispatch(world, super::wire(vec![preview([1.0, 2.0, 3.0])]));
+    let e = world.resource::<GuidIndex>().0[&GO];
+    super::super::handlers::dispatch(world, super::wire(vec![preview([10.0, 20.0, 30.0])]));
+    assert_eq!(
+        world.resource::<GuidIndex>().0[&GO],
+        e,
+        "the same entity: nothing rebuilt"
+    );
+    let t = world.get::<Transform>(e).unwrap();
+    assert_eq!(
+        t.translation,
+        wow_to_bevy([10.0, 20.0, 30.0]),
+        "moved in place"
+    );
+    assert_eq!(t.scale, Vec3::splat(1.5), "sized as sent");
+}
+
+/// A destroyed building preview goes at once, with no fade-out model left standing.
+#[test]
+fn a_destroyed_building_preview_leaves_no_fading_model() {
+    const GO: u64 = 0xF110_0000_0000_000B;
+    let mut app = client();
+    let (tx, _rx) = crossbeam_channel::unbounded();
+    app.insert_resource(NetCommands(tx));
+    let world = app.world_mut();
+    let mut b = create(GO, EntityKind::GameObject, [1.0, 2.0, 3.0]);
+    if let SessionEvent::ObjectCreate { fields, .. } = &mut b {
+        *fields =
+            ObjectFields::from_pairs(&[(GO_FLAGS_FIELD, crate::entities::preview::PREVIEW_MOVE)]);
+    }
+    super::super::handlers::dispatch(world, super::wire(vec![b]));
+    let e = world.resource::<GuidIndex>().0[&GO];
+    super::super::handlers::dispatch(world, vec![SessionEvent::ObjectDestroyed(GO)]);
+    world.flush();
+    assert!(world.get_entity(e).is_err(), "despawned, not fading");
+}
