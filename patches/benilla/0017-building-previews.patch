@@ -0,0 +1,108 @@
+//! Live building previews, benilla's own (no reference behaviour): a GameObject whose
+//! `GAMEOBJECT_FLAGS` carry [`PREVIEW_MOVE`] is a placement preview the server moves as the hero
+//! turns and walks. A re-create of its guid moves it in place (`net::objects`), it builds no
+//! collision hull, and it neither fades in nor out. [`PREVIEW_GHOST`] also draws it as a ghost:
+//! translucent and tinted light blue, through the aura layer's alpha and tint nodes
+//! ([`crate::aura_visual::AuraNodes::preview_ghost`]). An unrigged model has no palette slot for
+//! the tint to read, so every unrigged ghost shares one slot of its own ([`PreviewTint`]),
+//! claimed once and never skinned.
+
+use benilla_protocol::EntityKind;
+use bevy::prelude::*;
+
+use crate::net::{NetEntity, ObjectStore};
+
+/// `GAMEOBJECT_FLAGS` bit: a placement preview that moves in place, with no hull and no fades.
+pub(crate) const PREVIEW_MOVE: u32 = 0x1000_0000;
+/// `GAMEOBJECT_FLAGS` bit: with [`PREVIEW_MOVE`], drawn as a translucent light-blue ghost.
+pub(crate) const PREVIEW_GHOST: u32 = 0x2000_0000;
+
+/// The ghost's render alpha.
+pub(crate) const GHOST_ALPHA: f32 = 0.5;
+/// The ghost's tint, a light blue (multiplies the lit colour).
+pub(crate) const GHOST_TINT: [u8; 3] = [150, 205, 255];
+
+/// The preview bits of a GameObject's flags; 0 for any other kind, whose field 9 is not flags.
+pub(crate) fn preview_bits(kind: EntityKind, flags: u32) -> u32 {
+    if kind != EntityKind::GameObject || flags & PREVIEW_MOVE == 0 {
+        return 0;
+    }
+    flags & (PREVIEW_MOVE | PREVIEW_GHOST)
+}
+
+/// The preview bits of a streamed entity, from its stored fields.
+pub(crate) fn entity_preview_bits(net: Option<&NetEntity>, store: Option<&ObjectStore>) -> u32 {
+    match (net, store) {
+        (Some(n), Some(s)) => preview_bits(n.kind, s.0.gameobject_flags()),
+        _ => 0,
+    }
+}
+
+/// The palette slot every unrigged ghost's parts carry, so the fragment stage's per-slot tint
+/// reads [`GHOST_TINT`] for them; `None` until claimed.
+#[derive(Resource, Default)]
+pub(crate) struct PreviewTint {
+    pub(crate) slot: Option<u16>,
+}
+
+/// Claim the ghosts' tint slot once (one bone of the palette, never posed: an unrigged part draws
+/// its static mesh) and paint it. A slot is only ever freed by `RigSkin`'s hook, which this one
+/// never has, and only rigs are repainted each frame (`aura_visual::apply_aura_tint`).
+pub(crate) fn claim_preview_tint(
+    mut res: ResMut<PreviewTint>,
+    mut palettes: ResMut<benilla_world::rig_palette::RigPalettes>,
+    mut tints: ResMut<benilla_world::instance_tint::InstanceTints>,
+) {
+    if res.slot.is_some() {
+        return;
+    }
+    if let Some(slot) = palettes.alloc_static_slot() {
+        tints.set(slot, benilla_world::instance_tint::pack(GHOST_TINT));
+        res.slot = Some(slot);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn only_a_game_object_with_the_move_bit_is_a_preview() {
+        assert_eq!(preview_bits(EntityKind::GameObject, 0x20), 0);
+        assert_eq!(
+            preview_bits(EntityKind::GameObject, PREVIEW_MOVE | 0x20),
+            PREVIEW_MOVE
+        );
+        assert_eq!(
+            preview_bits(EntityKind::GameObject, PREVIEW_MOVE | PREVIEW_GHOST),
+            PREVIEW_MOVE | PREVIEW_GHOST
+        );
+        // The ghost bit alone is no preview: it only qualifies a moving one.
+        assert_eq!(preview_bits(EntityKind::GameObject, PREVIEW_GHOST), 0);
+        // A unit's field 9 is not GameObject flags.
+        assert_eq!(
+            preview_bits(EntityKind::Unit, PREVIEW_MOVE | PREVIEW_GHOST),
+            0
+        );
+    }
+
+    #[test]
+    fn the_tint_slot_is_claimed_once_and_painted() {
+        let mut app = App::new();
+        app.init_resource::<PreviewTint>()
+            .init_resource::<benilla_world::rig_palette::RigPalettes>()
+            .init_resource::<benilla_world::instance_tint::InstanceTints>()
+            .add_systems(Update, claim_preview_tint);
+        app.update();
+        let slot = app.world().resource::<PreviewTint>().slot.expect("a slot");
+        assert_ne!(slot, 0, "slot 0 is the untinted sentinel");
+        assert_eq!(
+            app.world()
+                .resource::<benilla_world::instance_tint::InstanceTints>()
+                .get(slot),
+            benilla_world::instance_tint::pack(GHOST_TINT)
+        );
+        app.update();
+        assert_eq!(app.world().resource::<PreviewTint>().slot, Some(slot));
+    }
+}
