 fn tear_down(mut ent: EntityWorldMut) {
+    // A building preview (benilla's own, `entities::preview`) goes at once: it never fades.
+    let preview = crate::entities::preview::entity_preview_bits(
+        ent.get::<NetEntity>(),
+        ent.get::<ObjectStore>(),
+    );
     ent.remove::<Guid>();
+    if preview != 0 {
+        ent.despawn();
+        return;
+    }
     ent.insert(DespawnFade::default());
 }
 
