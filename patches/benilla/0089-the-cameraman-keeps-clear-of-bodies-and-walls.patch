+impl Body {
+    /// The point framed: its chest.
+    fn at(&self) -> Vec3 {
+        self.feet + Vec3::Y * self.tall * 0.6
+    }
+
+    /// Where it will be in `secs`, walking on as it is.
+    fn ahead(&self, secs: f32) -> Body {
+        Body { feet: self.feet + self.walk.with_y(0.0) * secs, ..*self }
+    }
+
+    /// How far `eye` is outside its bounds (yd); negative inside.
+    fn clearance(&self, eye: Vec3) -> f32 {
+        let flat = (eye - self.feet).with_y(0.0).length() - self.radius;
+        let vert = (eye.y - (self.feet.y + self.tall)).max(self.feet.y - eye.y);
+        if flat > 0.0 && vert > 0.0 {
+            flat.hypot(vert)
+        } else {
+            flat.max(vert)
+        }
+    }
+
+    /// Whether `eye` is in its bounds, with `gap` and four tenths of its radius round them (a big
+    /// body's arms and blades reach past its Stand box), now or within the next [`AHEAD`]
+    /// seconds of its walk.
+    fn covers(&self, eye: Vec3, gap: f32) -> bool {
+        let need = gap + self.radius * 0.4;
+        AHEAD.iter().any(|&s| self.ahead(s).clearance(eye) < need)
+    }
+
+    /// The points looked for from `eye`: low, chest and head on its middle, and either side of
+    /// its chest.
+    fn points(&self, eye: Vec3) -> [Vec3; 5] {
+        let at = self.at();
+        let side = (at - eye).with_y(0.0).normalize_or(Vec3::Z).cross(Vec3::Y) * (self.radius * 0.6).clamp(0.2, 1.5);
+        [self.feet + Vec3::Y * self.tall * 0.25, at, self.feet + Vec3::Y * self.tall * 0.9, at + side, at - side]
+    }
+
+    /// Whether the line from `eye` to `to` passes through it: its middle (six tenths of its
+    /// bounds, since limbs have gaps), between the two ends.
+    fn on_line(&self, eye: Vec3, to: Vec3) -> bool {
+        let line = to - eye;
+        let flat = line.with_y(0.0);
+        let len2 = flat.length_squared();
+        if len2 < 1e-4 || self.tall <= 0.0 {
+            return false;
+        }
+        let t = (self.feet - eye).with_y(0.0).dot(flat) / len2;
+        if !(0.02..0.95).contains(&t) {
+            return false;
+        }
+        let p = eye + line * t;
+        p.with_y(0.0).distance(self.feet.with_y(0.0)) < self.radius * 0.6 + 0.1 && p.y > self.feet.y && p.y < self.feet.y + self.tall * 0.95
+    }
