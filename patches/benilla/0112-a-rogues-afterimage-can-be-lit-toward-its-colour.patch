diff --git a/crates/benilla-world/src/instance_tint.rs b/crates/benilla-world/src/instance_tint.rs
index 32356a54..1e81e342 100644
--- a/crates/benilla-world/src/instance_tint.rs
+++ b/crates/benilla-world/src/instance_tint.rs
@@ -48,6 +48,15 @@ pub fn pack(rgb: [u8; 3]) -> u32 {
     0xff00_0000 | (u32::from(rgb[0]) << 16) | (u32::from(rgb[1]) << 8) | u32::from(rgb[2])
 }
 
+/// Basin Battle: a tint that also lights the body toward its colour by `light` (0 to 1), a ghost
+/// of light rather than a shade of the body. `wow_model.wgsl` mixes the lit colour toward the tint
+/// by `(255 - top byte) / 255`, so [`pack`]'s `0xff` top byte lights nothing, and the top byte stays
+/// at least 1 so the word is never [`IDENTITY`].
+pub fn pack_lit(rgb: [u8; 3], light: f32) -> u32 {
+    let lift = (light.clamp(0.0, 1.0) * 255.0).round().min(254.0) as u32;
+    (pack(rgb) & 0x00ff_ffff) | ((0xff - lift) << 24)
+}
+
 /// Off-world `wow_light`-layout buffers that also carry the tint region, by key; deliberately not
 /// [`crate::rig_palette::RigPaletteMirrors`]' list. Portraits stay off it: the reference bakes one
 /// from a fresh CM2 with colour (1,1,1) and alpha 1 (`0x524f60`, ctor `0x70ea60`, set again at
@@ -142,6 +151,16 @@ pub fn plugin(app: &mut App) {
 mod tests {
     use super::*;
 
+    /// A lit tint keeps its colour and carries its light in the top byte; none is [`pack`]'s word,
+    /// and a full light on black is still no identity.
+    #[test]
+    fn a_lit_tint_carries_its_light_in_the_top_byte() {
+        assert_eq!(pack_lit([0xE0, 0xEC, 0xFF], 0.0), pack([0xE0, 0xEC, 0xFF]));
+        assert_eq!(pack_lit([0xE0, 0xEC, 0xFF], 0.5), 0x7FE0_ECFF);
+        assert_eq!(pack_lit([0, 0, 0], 1.0), 0x0100_0000);
+        assert_ne!(pack_lit([0, 0, 0], 1.0), IDENTITY);
+    }
+
