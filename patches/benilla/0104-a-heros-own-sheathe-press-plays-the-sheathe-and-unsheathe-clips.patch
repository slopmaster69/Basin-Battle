+/// Basin Battle: the server puts a hero's weapons away for their own press (R) by changing the
+/// sheath byte with its press count (`UNIT_FIELD_BYTES_2` byte 1) moved too, and every client,
+/// the hero's and the onlookers', plays the stow and draw clips for it as for a Z press. A byte
+/// changed with the count left (a blow drawing, a meal) snaps as 1.12's `0x604c70` does, and ends
+/// a ceremony still playing; so does a swing of an add-on's that owns the body.
+#[test]
+fn a_sheath_byte_changed_with_the_press_count_plays_the_ceremony_on_any_unit() {
+    use bevy::animation::graph::{AnimationGraph, AnimationGraphHandle};
+    use bevy::animation::AnimationClip;
+
+    let mut app = app();
+    const DUR: f32 = 0.1;
+    let handles: Vec<_> = (0..5)
+        .map(|_| {
+            let mut c = AnimationClip::default();
+            c.set_duration(DUR);
+            app.world_mut()
+                .resource_mut::<Assets<AnimationClip>>()
+                .add(c)
+        })
+        .collect();
+    let (graph, nodes) = AnimationGraph::from_clips(handles);
+    let graph_handle = app
+        .world_mut()
+        .resource_mut::<Assets<AnimationGraph>>()
+        .add(graph);
+    let family = |id: u16, right: usize, left: usize| {
+        let mut c = clip(id, 0, false);
+        c.node = nodes[right];
+        c.duration = DUR;
+        c.blend_time = 0.0;
+        c.arm_nodes = Some((nodes[right], nodes[left]));
+        c
+    };
+    let mut stand = clip(0, 0, true);
+    stand.node = nodes[0];
+    stand.duration = DUR;
+    // `UNIT_FIELD_BYTES_2` (164): byte 0 the sheath state, byte 1 the press count.
+    let bytes =
+        |state: u32, count: u32| crate::net::ObjectStore(alive(&[(164, state | count << 8)]));
+    // Another hero seen from here (no `SelfPlayer`): a hip sword and a shield on the back.
+    let unit = app
+        .world_mut()
+        .spawn((
+            ModelAnimations {
+                graph: graph_handle.clone(),
+                clips: vec![stand, family(90, 1, 2), family(89, 3, 4)],
+                hand_close: [None, None],
+                playable_animation_lookup: Vec::new(),
+                animation_lookup: lookup(&[0, 90, 89]),
+                global_bones: Vec::new(),
+                first_seq: None,
+                pose: Default::default(),
+            },
+            AnimationPlayer::default(),
+            AnimationTransitions::new(),
+            AnimationGraphHandle(graph_handle),
+            AnimDriver::default(),
+            Wielded {
+                main: Some((2, 0x7)),
+                off: Some((4, 6)),
+                main_sheath: 3,
+                off_sheath: 4,
+                materials: [1, 6, 0],
+                ..Default::default()
+            },
+            bytes(1, 7),
+        ))
+        .id();
+    let visual = |app: &App| {
+        app.world()
+            .entity(unit)
+            .get::<crate::creature_anim::VisualSheath>()
+            .map(|v| v.0)
+    };
+    app.update();
+    assert_eq!(sheath_of(&app, unit), Some(1), "seeded drawn");
+    assert_eq!(visual(&app), None, "first seen: nothing plays");
+
+    // R: put away, the count moved with it. Both hands hold on until their clips' keys.
+    app.world_mut().entity_mut(unit).insert(bytes(0, 8));
+    app.update();
+    assert_eq!(sheath_of(&app, unit), Some(0));
+    assert_eq!(
+        visual(&app),
+        Some([1, 1]),
+        "the stow clips play, the weapons still in hand"
+    );
+    let mut seen = vec![[1u8, 1]];
+    for _ in 0..30 {
+        advance(&mut app, 20);
+        match visual(&app) {
+            Some(v) if seen.last() != Some(&v) => seen.push(v),
+            None => break,
+            _ => {}
+        }
+    }
+    assert_eq!(
+        seen.last(),
+        Some(&[0, 0]),
+        "each weapon put away at its key (saw {seen:?})"
+    );
+    assert_eq!(visual(&app), None, "and the ceremony done");
+
+    // A blow draws: the count left as it was, so a snap.
+    app.world_mut().entity_mut(unit).insert(bytes(1, 8));
+    app.update();
+    assert_eq!(sheath_of(&app, unit), Some(1), "drawn");
+    assert_eq!(visual(&app), None, "snapped, no clip");
+
+    // R again, then a blow before the clips are done: the snap ends the ceremony at once.
+    app.world_mut().entity_mut(unit).insert(bytes(0, 9));
+    app.update();
+    assert!(visual(&app).is_some(), "stowing");
+    app.world_mut().entity_mut(unit).insert(bytes(1, 9));
+    app.update();
+    app.update();
+    assert_eq!(sheath_of(&app, unit), Some(1));
+    assert_eq!(visual(&app), None, "the blow's draw ends the stow");
+
+    // R once more, and an add-on's swing takes the body: the ceremony gives way.
+    app.world_mut().entity_mut(unit).insert(bytes(0, 10));
+    app.update();
+    assert!(visual(&app).is_some(), "stowing");
+    let mut owns = super::super::action::ClipOwnsBody::default();
+    owns.0.insert(unit, f32::MAX);
+    app.insert_resource(owns);
+    app.update();
+    assert_eq!(visual(&app), None, "a swing owning the body ends it");
+    assert_eq!(sheath_of(&app, unit), Some(0), "the state stands");
+}
