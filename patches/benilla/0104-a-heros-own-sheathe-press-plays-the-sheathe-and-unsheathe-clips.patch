+/// End a ceremony at once: its legs stopped and [`VisualSheath`] dropped, so the weapons show the
+/// committed state. Nothing without one.
+pub(super) fn stop_sheath_ceremony(
+    commands: &mut Commands,
+    entity: Entity,
+    drv: &mut AnimDriver,
+    player: &mut AnimationPlayer,
+) {
+    let Some(swap) = drv.sheath_swap.take() else {
+        return;
+    };
+    for leg in swap.arms.into_iter().flatten() {
+        player.stop(leg.node);
+    }
+    commands.entity(entity).remove::<VisualSheath>();
+}
