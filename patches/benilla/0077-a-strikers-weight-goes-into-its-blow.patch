+    for (entity, mut clip, mut player, anims, t, stop, guid, mine, tilted) in &mut units {
         let clip = &mut *clip;
         let frozen = stop.is_some_and(|s| now < s.until);
         if !frozen && dt > 0.0 {
@@ -1037,6 +1066,34 @@ pub(super) fn apply_action_clips(
         // The blow lands in the clip: tell the script, which plays its weight.
         if !clip.told && clip.key > 0.0 && clip.t >= clip.key && !clip.shuffle {
             clip.told = true;
+            // The striker's own weight goes into it: tipped forward over its feet a moment, on a
+            // whole body (not an upper body swinging over running legs), and not over a roll or a
+            // struck lean already turning it.
+            let forward = t.rotation * Vec3::NEG_Z;
+            let flat = Vec3::new(forward.x, 0.0, forward.z);
+            if weighty
+                && !clip.reaction
+                && !clip.on_upper
+                && !tilted
+                && flat.length_squared() > 1.0e-6
+            {
+                let windup = if clip.windup > 0.0 {
+                    clip.windup
+                } else {
+                    clip.key
+                };
+                commands.entity(entity).try_insert(ActionTilt {
+                    kind: TiltKind::Lean {
+                        amount: impact_lean(windup),
+                    },
+                    asked: now,
+                    start: Some(now),
+                    secs: IMPACT_LEAN_SECS,
+                    from: t.translation,
+                    axis: Some(Vec3::Y.cross(flat.normalize())),
+                    bones: Vec::new(),
+                });
+            }
             let who = if mine {
                 "player".to_string()
             } else {
@@ -1503,6 +1560,23 @@ pub(crate) fn on_curves_cvar(
     }
 }
 
+/// `actionWeight` (benilla's own): a striker tipping into its blow, on or off.
+pub(crate) fn on_weight_cvar(
+    ev: On<crate::cvars::CvarChanged>,
+    weight: Option<ResMut<ImpactWeight>>,
+) {
+    if ev.key() != "actionweight" {
+        return;
+    }
+    if let Some(mut weight) = weight {
+        weight.on = ev.flag();
+        info!(
+            "action: a striker's weight into its blow {}",
+            if weight.on { "on" } else { "off" }
+        );
+    }
+}
