 /// A struck body's lean: out fast, back slow, over this long; pivoting this high.
 const LEAN_SECS: f32 = 0.45;
 const LEAN_PIVOT: f32 = 0.2;
+/// A blow landing in the striker's own clip tips the striker forward over its feet, its weight
+/// going into the blow: this far (radians) for a quick one, up to the heavy share for a wind-up of
+/// [`HEAVY_WINDUP`] seconds or more, settling over [`IMPACT_LEAN_SECS`] as a struck lean does.
+const IMPACT_LEAN: f32 = 0.06;
+const IMPACT_LEAN_HEAVY: f32 = 0.1;
+const QUICK_WINDUP: f32 = 0.2;
+const HEAVY_WINDUP: f32 = 0.6;
+const IMPACT_LEAN_SECS: f32 = 0.35;
 /// The upper body follows the aim this much, up to this far.
 const AIM_PITCH_SHARE: f32 = 0.8;
 const AIM_PITCH_MAX: f32 = 0.7;
@@ -588,6 +596,24 @@ fn replace_clip(old: &mut ActionClip, clip: ActionClip) {
     *old = next;
 }
 
+/// How far a striker tips into a blow whose wind-up took `windup` seconds: more the heavier.
+fn impact_lean(windup: f32) -> f32 {
+    let heavy = ((windup - QUICK_WINDUP) / (HEAVY_WINDUP - QUICK_WINDUP)).clamp(0.0, 1.0);
+    IMPACT_LEAN * (1.0 - heavy) + IMPACT_LEAN_HEAVY * heavy
+}
+
+/// `actionWeight` (benilla's own): the striker's weight going into a blow, on or off.
+#[derive(Resource, Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) struct ImpactWeight {
+    pub(crate) on: bool,
+}
+
+impl Default for ImpactWeight {
+    fn default() -> Self {
+        Self { on: true }
+    }
+}
