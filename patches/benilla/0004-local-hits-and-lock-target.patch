+/// Locked on and turned in place: the feet step round (the shuffle clips), as a turning key would
+/// make them.
+pub(super) fn shuffle_on_lock_turn(
+    mut commands: Commands,
+    time: Res<Time>,
+    lock: Res<LockOn>,
+    anim_data: Option<Res<AnimData>>,
+    mut me: Query<
+        (
+            Entity,
+            &Transform,
+            &ModelAnimations,
+            Option<&mut ActionClip>,
+        ),
+        With<SelfPlayer>,
+    >,
+    mut last: Local<Option<(f32, Vec3)>>,
+) {
+    let dt = time.delta_secs();
+    let Ok((entity, t, anims, clip)) = me.single_mut() else {
+        return;
+    };
+    let yaw = action_combat::hero_yaw();
+    let prev = last.replace((yaw, t.translation));
+    if lock.0.is_none() || dt <= 0.0 {
+        return;
+    }
+    let Some((prev_yaw, prev_pos)) = prev else {
+        return;
+    };
+    let rate = super::wrap_pi(yaw - prev_yaw) / dt;
+    let moved = Vec2::new(t.translation.x - prev_pos.x, t.translation.z - prev_pos.z).length() / dt;
+    if rate.abs() < SHUFFLE_ABOVE || moved > STILL_BELOW {
+        return;
+    }
+    // A turn left raises the yaw.
+    let anim = if rate > 0.0 {
+        SHUFFLE_LEFT
+    } else {
+        SHUFFLE_RIGHT
+    };
+    match clip {
+        // A script's clip owns the body; a step already under way keeps going.
+        Some(mut c) if c.shuffle && c.id == anim => {
+            c.held = 0.0;
+            c.hold = SHUFFLE_HOLD;
+            c.stopping = None;
+        }
+        Some(c) if !c.shuffle => {}
+        _ => {
+            let catalog = anim_data.as_deref().map(|d| &d.0);
+            if let Some(take) = take_of(anims, anim, None, catalog) {
+                let mut c = ActionClip::new(take, ActionBody::Full);
+                c.looping = true;
+                c.hold = SHUFFLE_HOLD;
+                c.shuffle = true;
+                commands.entity(entity).try_insert(c);
+            }
+        }
+    }
+}
