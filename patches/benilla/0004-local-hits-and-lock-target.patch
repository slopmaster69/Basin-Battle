+/// A voice a script asked a unit for: the unit, and which (`"exertion"`, `"injury"`, with
+/// `_crit`).
+static VOCALS: std::sync::Mutex<Vec<(String, String)>> = std::sync::Mutex::new(Vec::new());
+
+pub fn take_vocals() -> Vec<(String, String)> {
+    VOCALS
+        .lock()
+        .map(|mut v| std::mem::take(&mut *v))
+        .unwrap_or_default()
+}
+
+/// What the action layer saw happen, for the script to take.
+static MARKERS: std::sync::Mutex<Vec<String>> = std::sync::Mutex::new(Vec::new());
+
+pub fn push_marker(m: String) {
+    if let Ok(mut v) = MARKERS.lock() {
+        if v.len() < 64 {
+            v.push(m);
+        }
+    }
+}
+
+/// A lock-on asks for its unit to be the selection too: the guid, for the target's own path.
+static SELECT: std::sync::Mutex<Option<u64>> = std::sync::Mutex::new(None);
+
+pub fn ask_select(guid: u64) {
+    if let Ok(mut v) = SELECT.lock() {
+        *v = Some(guid);
+    }
+}
+
+pub fn take_select() -> Option<u64> {
+    SELECT.lock().ok().and_then(|mut v| v.take())
