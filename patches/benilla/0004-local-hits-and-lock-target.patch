+
+    #[test]
+    fn the_probe_finds_the_nearest_unit_in_front_and_not_behind_or_too_far() {
+        // Facing -Z (yaw 0): a unit 2 yards ahead, one behind, one ahead but far, a player.
+        set_nearby(Nearby {
+            hero: Some(([0.0, 0.0, 0.0], 0.0)),
+            units: vec![
+                (1, [0.0, 0.0, -2.0], false, true),
+                (2, [0.0, 0.0, 1.5], false, true),
+                (3, [0.0, 0.0, -9.0], false, true),
+                (4, [0.3, 0.0, -1.2], true, true),
+                (5, [0.0, 0.0, -1.0], false, false),
+            ],
+        });
+        assert_eq!(probe(3.0, 90.0, false), Some(1), "the creature ahead");
+        assert_eq!(
+            probe(3.0, 90.0, true),
+            Some(4),
+            "with friendly fire, the nearer hero"
+        );
+        assert_eq!(
+            probe(1.0, 90.0, false),
+            None,
+            "too short for any but the dead one"
+        );
+        // Turned round (yaw pi: facing +Z): the one that was behind.
+        set_nearby(Nearby {
+            hero: Some(([0.0, 0.0, 0.0], std::f32::consts::PI)),
+            units: vec![
+                (1, [0.0, 0.0, -2.0], false, true),
+                (2, [0.0, 0.0, 1.5], false, true),
+            ],
+        });
+        assert_eq!(probe(3.0, 90.0, false), Some(2));
+    }
