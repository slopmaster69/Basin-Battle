+/// Basin Battle's action script asks a unit for its voice (`PlayUnitVocal`, not part of 1.12.1):
+/// the same exertion and injury kits a swing plays, on the same buses, without the chance roll.
+#[allow(clippy::too_many_arguments)]
+fn script_vocals(
+    units: Query<(&Transform, &NetEntity)>,
+    me: Query<Entity, With<crate::net::SelfPlayer>>,
+    index: Option<Res<crate::net::GuidIndex>>,
+    voices: Option<Res<CreatureVoices>>,
+    kits: Option<ResMut<SoundKits>>,
+    assets: Option<Res<WorldAssets>>,
+    mut out: NonSendMut<SoundOutput>,
+    config: Res<SoundConfig>,
+    listener: Res<AudioListener>,
+) {
+    let asked = benilla_ui::action_combat::take_vocals();
+    if asked.is_empty() {
+        return;
+    }
+    let (Some(voices), Some(mut kits), Some(assets), Some(index)) = (voices, kits, assets, index)
+    else {
+        return;
+    };
+    let me = me.single().ok();
+    for (unit, kind) in asked {
+        let entity = if unit.eq_ignore_ascii_case("player") {
+            me
+        } else {
+            let hex = unit.trim_start_matches("0x").trim_start_matches("0X");
+            u64::from_str_radix(hex, 16)
+                .ok()
+                .and_then(|g| index.0.get(&g).copied())
+        };
+        let Some((t, net)) = entity.and_then(|e| units.get(e).ok()) else {
+            continue;
+        };
+        let Some(v) = net.display_id.and_then(|d| voices.0.for_display(d)) else {
+            continue;
+        };
+        let yours = Some(entity) == Some(me) && me.is_some();
+        let (kit, bus) = match kind.as_str() {
+            "exertion" => (v.exertion[0], Bus::EXERTION),
+            "exertion_crit" => (v.exertion[1], Bus::EXERTION),
+            "injury" => (
+                v.injury[0],
+                if yours { Bus::SELF_INJURY } else { Bus::INJURY },
+            ),
+            "injury_crit" => (
+                v.injury[1],
+                if yours { Bus::SELF_INJURY } else { Bus::INJURY },
+            ),
+            _ => continue,
+        };
+        if kit == 0 {
+            continue;
+        }
+        if let Err(e) = play_kit_ext(
+            &mut kits,
+            &assets,
+            &mut out,
+            &config,
+            listener.pos,
+            KitRef::Id(kit),
+            Some(t.translation),
+            SoundCategory::Sfx,
+            PlayExtras { bus, ..default() },
+        ) {
+            warn!("script vocal (kit {kit}): {e:#}");
+        }
+    }
+}
