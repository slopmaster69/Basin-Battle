+/// The units near us, for the script's own blow test ([`action_combat::probe`]).
+#[allow(clippy::type_complexity)]
+pub(super) fn collect_nearby(
+    me: Query<&Transform, With<SelfPlayer>>,
+    units: Query<
+        (
+            &Transform,
+            &NetEntity,
+            &crate::net::Guid,
+            Option<&crate::net::ObjectStore>,
+        ),
+        Without<SelfPlayer>,
+    >,
+) {
+    let Ok(here) = me.single() else {
+        action_combat::set_nearby(action_combat::Nearby::default());
+        return;
+    };
+    let mut out = Vec::new();
+    for (t, n, g, store) in &units {
+        let player = match n.kind {
+            benilla_protocol::EntityKind::Player => true,
+            benilla_protocol::EntityKind::Unit => false,
+            _ => continue,
+        };
+        if t.translation.distance_squared(here.translation) > NEARBY_RANGE * NEARBY_RANGE {
+            continue;
+        }
+        let alive = !store.is_some_and(|s| s.0.unit_is_dead());
+        out.push((g.0, t.translation.to_array(), player, alive));
+    }
+    action_combat::set_nearby(action_combat::Nearby {
+        hero: Some((here.translation.to_array(), action_combat::hero_yaw())),
+        units: out,
+    });
+}
