+    let n = NEARBY.lock().ok()?.clone()?;
+    let (feet, yaw) = n.hero?;
+    // Forward is -Z turned by the yaw about +Y.
+    let (fx, fz) = (-yaw.sin(), -yaw.cos());
+    let half = (arc * 0.5).to_radians();
+    let mut best: Option<(f32, u64)> = None;
+    for (guid, at, player, alive) in n.units {
+        if !alive || (player && !players) {
+            continue;
+        }
+        let (dx, dz) = (at[0] - feet[0], at[2] - feet[2]);
+        let d = (dx * dx + dz * dz).sqrt();
+        // Its body's width counts toward the reach.
+        if d > range + 0.5 || (at[1] - feet[1]).abs() > 3.0 {
+            continue;
+        }
+        let off = if d < 1.0e-3 {
+            0.0
+        } else {
+            ((dx * fx + dz * fz) / d).clamp(-1.0, 1.0).acos()
+        };
+        if off > half && !(d < 0.9 && off < std::f32::consts::FRAC_PI_2) {
+            continue;
+        }
+        if best.is_none_or(|(b, _)| d < b) {
+            best = Some((d, guid));
+        }
+    }
+    best.map(|(_, g)| g)
+}
