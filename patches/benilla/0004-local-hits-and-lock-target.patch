+/// Our body and the units near it this frame (Bevy space: `(x, z)` on the ground, `y` up), for
+/// [`probe`]: our feet and facing (the camera's yaw convention, forward `-Z` turned by it), then
+/// each unit's guid, feet, whether it's a player and whether it's alive.
+#[derive(Clone, Debug, Default)]
+pub struct Nearby {
+    pub hero: Option<([f32; 3], f32)>,
+    pub units: Vec<(u64, [f32; 3], bool, bool)>,
+}
+
+static NEARBY: std::sync::Mutex<Option<Nearby>> = std::sync::Mutex::new(None);
+/// Our facing as the mover holds it, written each frame.
+static HERO_YAW: AtomicU32 = AtomicU32::new(0);
+
+/// The movement keys held: forward (+1) or back (-1), and right (+1) or left (-1).
+static MOVE_KEYS: AtomicU32 = AtomicU32::new(0);
+
+pub fn set_move_keys(fwd: i32, side: i32) {
+    let pack = ((fwd.signum() + 1) as u32) | (((side.signum() + 1) as u32) << 2);
+    MOVE_KEYS.store(pack, Ordering::Relaxed);
+}
+
+pub fn move_keys() -> (i32, i32) {
+    let p = MOVE_KEYS.load(Ordering::Relaxed);
+    ((p & 3) as i32 - 1, ((p >> 2) & 3) as i32 - 1)
+}
+
+pub fn set_hero_yaw(yaw: f32) {
+    HERO_YAW.store(yaw.to_bits(), Ordering::Relaxed);
+}
+
+pub fn hero_yaw() -> f32 {
+    f32::from_bits(HERO_YAW.load(Ordering::Relaxed))
+}
+
+pub fn set_nearby(n: Nearby) {
+    if let Ok(mut v) = NEARBY.lock() {
+        *v = Some(n);
+    }
+}
