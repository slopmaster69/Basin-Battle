 use std::sync::atomic::{AtomicBool, AtomicU32, Ordering};
 
@@ -547,6 +556,49 @@ pub enum GroundMarkerCall {
 
 static GROUND_MARKERS: std::sync::Mutex<Vec<GroundMarkerCall>> = std::sync::Mutex::new(Vec::new());
 
+/// Where a rope from a unit's hand runs to (`SetUnitRope`).
+#[derive(Clone, Debug, PartialEq)]
+pub enum RopeEnd {
+    /// A spot in the world, WoW's `x, y, z`.
+    Point([f32; 3]),
+    /// Another unit, by its guid.
+    Unit(u64),
+}
+
+/// A rope asked for, or taken away (`SetUnitRope`, `ClearUnitRope`).
+#[derive(Clone, Debug, PartialEq)]
+pub enum RopeCall {
+    Set {
+        key: String,
+        /// `"player"` or a guid, as the other action calls name a unit.
+        unit: String,
+        to: RopeEnd,
+        secs: f32,
+        rgb: [f32; 3],
+    },
+    Clear {
+        key: Option<String>,
+    },
+}
+
+static ROPES: std::sync::Mutex<Vec<RopeCall>> = std::sync::Mutex::new(Vec::new());
+
+/// The rope calls since the last call, oldest first.
+pub fn take_ropes() -> Vec<RopeCall> {
+    ROPES
+        .lock()
+        .map(|mut v| std::mem::take(&mut *v))
+        .unwrap_or_default()
+}
+
+fn push_rope(call: RopeCall) {
+    if let Ok(mut v) = ROPES.lock() {
+        if v.len() < 256 {
+            v.push(call);
+        }
+    }
+}
+
