--- /dev/null
+++ b/crates/benilla-app/src/unit_rope.rs
@@ -0,0 +1,269 @@
+//! Basin Battle's ropes from a unit's hand, not part of 1.12.1 (`SetUnitRope`, `HasActionCombat()
+//! >= 21`): a taut line from the right hand to a spot or to another unit, drawn every frame from
+//! where the hand is now, so a grappling hook's line stays in the hunter's fist as it pulls them
+//! through the air, and a foe hauled in hangs on the end of it.
+//!
+//! The rope faces the camera: a strip [`ROPE_WIDTH`] wide, a darker rim either side of a lighter
+//! core, cut into [`SEGMENTS`] stretches so it keeps facing the view along its whole length. It's
+//! alpha-blended and depth-tested, and drawn a little brighter than the scene's light would make it,
+//! so it still reads at night.
+
+use benilla_assets::coords::wow_to_bevy;
+use benilla_ui::action_combat::{self, RopeCall, RopeEnd};
+use benilla_world::particles::buffer::{EffectVertex, WorldEffectDraw};
+use benilla_world::view::WorldCamera;
+use bevy::prelude::*;
+
+use crate::entities::{attach_world_pos, AttachPosQuery};
+use crate::net::{GuidIndex, SelfPlayer};
+
+/// How wide the rope is drawn, yards.
+const ROPE_WIDTH: f32 = 0.08;
+
+/// The stretches it's cut into.
+const SEGMENTS: usize = 12;
+
+/// The right hand's attachment, then the spell hand's.
+const HAND_TAGS: [u16; 2] = [1, 22];
+
+/// Where a rope meets a unit at its far end: the chest, else the base.
+const BODY_TAGS: [u16; 2] = [0xf, 0x13];
+
+/// A unit with no hand to hold it (its model still loading): this far up from its feet.
+const HAND_UP: f32 = 1.2;
+
+/// The most ropes at once.
+const MOST_ROPES: usize = 32;
+
+/// A rope's far end, resolved to the world.
+#[derive(Clone, Copy, Debug, PartialEq)]
+enum End {
+    Spot(Vec3),
+    Unit(Entity),
+}
+
+/// One rope up.
+#[derive(Clone, Debug)]
+struct Rope {
+    key: String,
+    from: Entity,
+    to: End,
+    until: f32,
+    rgb: [f32; 3],
+}
+
+#[derive(Resource, Default)]
+struct Ropes(Vec<Rope>);
+
+fn resolve(name: &str, me: Option<Entity>, index: &GuidIndex) -> Option<Entity> {
+    if name.eq_ignore_ascii_case("player") {
+        return me;
+    }
+    let guid = match name.strip_prefix("0x").or_else(|| name.strip_prefix("0X")) {
+        Some(hex) => u64::from_str_radix(hex, 16).ok()?,
+        None => name.parse::<u64>().ok()?,
+    };
+    index.0.get(&guid).copied()
+}
+
+/// The scripts' rope calls: put up, replaced by key, taken away.
+fn drain_ropes(
+    time: Res<Time>,
+    index: Option<Res<GuidIndex>>,
+    me: Query<Entity, With<SelfPlayer>>,
+    mut ropes: ResMut<Ropes>,
+) {
+    let calls = action_combat::take_ropes();
+    let now = time.elapsed_secs();
+    let me = me.single().ok();
+    let empty = GuidIndex::default();
+    let index = index.as_deref().unwrap_or(&empty);
+    for call in calls {
+        match call {
+            RopeCall::Set {
+                key,
+                unit,
+                to,
+                secs,
+                rgb,
+            } => {
+                ropes.0.retain(|r| r.key != key);
+                let Some(from) = resolve(&unit, me, index) else {
+                    continue;
+                };
+                let to = match to {
+                    RopeEnd::Point(p) => End::Spot(wow_to_bevy(p)),
+                    RopeEnd::Unit(g) => match index.0.get(&g) {
+                        Some(e) => End::Unit(*e),
+                        None => continue,
+                    },
+                };
+                if ropes.0.len() >= MOST_ROPES {
+                    ropes.0.remove(0);
+                }
+                ropes.0.push(Rope {
+                    key,
+                    from,
+                    to,
+                    until: now + secs,
+                    rgb,
+                });
+            }
+            RopeCall::Clear { key: Some(k) } => ropes.0.retain(|r| r.key != k),
+            RopeCall::Clear { key: None } => ropes.0.clear(),
+        }
+    }
+    ropes.0.retain(|r| r.until > now);
+}
+
+/// The strip for a rope from `a` to `b` seen from `eye`: for each stretch, two quads (rim to core,
+/// core to rim) in the lane's `[a0, a1, b1, b0]` order. Nothing for a rope with no length.
+fn rope_strip(a: Vec3, b: Vec3, eye: Vec3, width: f32, rgb: [f32; 3]) -> Vec<EffectVertex> {
+    let mut out = Vec::new();
+    let along = b - a;
+    if along.length_squared() < 1.0e-4 {
+        return out;
+    }
+    let rim = [rgb[0] * 0.55, rgb[1] * 0.55, rgb[2] * 0.55];
+    let vert = |pos: Vec3, c: [f32; 3]| EffectVertex {
+        pos: pos.to_array(),
+        uv: [0.0, 0.0],
+        color: [c[0], c[1], c[2], 1.0],
+    };
+    let point = |i: usize| a + along * (i as f32 / SEGMENTS as f32);
+    let side = |p: Vec3| along.cross(eye - p).normalize_or_zero() * (0.5 * width);
+    for i in 0..SEGMENTS {
+        let (p0, p1) = (point(i), point(i + 1));
+        let (s0, s1) = (side(p0), side(p1));
+        out.extend([
+            vert(p0 + s0, rim),
+            vert(p1 + s1, rim),
+            vert(p1, rgb),
+            vert(p0, rgb),
+        ]);
+        out.extend([
+            vert(p0, rgb),
+            vert(p1, rgb),
+            vert(p1 - s1, rim),
+            vert(p0 - s0, rim),
+        ]);
+    }
+    out
+}
+
+/// Every rope from where its hand is now to its end, after the rigs are posed this frame.
+fn draw_ropes(
+    mut draw: WorldEffectDraw,
+    white: Res<RopeWhite>,
+    ropes: Res<Ropes>,
+    world_cam: Query<(Entity, &GlobalTransform), With<WorldCamera>>,
+    units: AttachPosQuery,
+    joints: Query<&GlobalTransform>,
+    lighting: Option<Res<benilla_world::lighting::WowLighting>>,
+) {
+    let Ok((cam, eye)) = world_cam.single() else {
+        return;
+    };
+    let eye = eye.translation();
+    // A little brighter than the scene would light it, never darker than half its colour.
+    let ambient = lighting
+        .as_deref()
+        .map_or([1.0; 3], |l| l.ambient)
+        .map(|c| c.clamp(0.5, 1.0));
+    for rope in &ropes.0 {
+        let Some(base) = units.get(rope.from).ok().map(|(g, _, _)| g.translation()) else {
+            continue;
+        };
+        let hand = attach_world_pos(rope.from, HAND_TAGS, &units, &joints)
+            .filter(|p| p.distance(base) > 0.05)
+            .unwrap_or(base + Vec3::Y * HAND_UP);
+        let end = match rope.to {
+            End::Spot(p) => Some(p),
+            End::Unit(e) => attach_world_pos(e, BODY_TAGS, &units, &joints),
+        };
+        let Some(end) = end else { continue };
+        let rgb = [
+            rope.rgb[0] * ambient[0],
+            rope.rgb[1] * ambient[1],
+            rope.rgb[2] * ambient[2],
+        ];
+        let verts = rope_strip(hand, end, eye, ROPE_WIDTH, rgb);
+        if verts.is_empty() {
+            continue;
+        }
+        let mut batch = draw
+            .batch(cam, white.0.id())
+            .alpha()
+            .anchored((hand + end) * 0.5)
+            .owner(rope.from);
+        batch.extend(verts);
+        batch.quads();
+    }
+}
+
+/// The 1×1 white texel the rope samples: pure vertex colour.
+#[derive(Resource)]
+struct RopeWhite(Handle<Image>);
+
+fn init_rope_white(mut commands: Commands, mut images: ResMut<Assets<Image>>) {
+    commands.insert_resource(RopeWhite(images.add(Image::default())));
+}
+
+/// Registers the ropes.
+pub(crate) struct UnitRopePlugin;
+
+impl Plugin for UnitRopePlugin {
+    fn build(&self, app: &mut App) {
+        app.init_resource::<Ropes>()
+            .add_systems(Startup, init_rope_white)
+            .add_systems(Update, drain_ropes)
+            .add_systems(
+                PostUpdate,
+                draw_ropes
+                    .in_set(benilla_world::billboard::BillboardPlace)
+                    .after(benilla_world::rig_anim::finalize_rig_worlds)
+                    .after(bevy::transform::TransformSystems::Propagate)
+                    // A lane that writes before the frame's clear loses everything it pushed.
+                    .after(benilla_world::particles::buffer::begin_effect_frame),
+            );
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_rope_is_two_quads_a_stretch_across_the_view_its_core_lighter_than_its_rim() {
+        let v = rope_strip(
+            Vec3::ZERO,
+            Vec3::new(6.0, 0.0, 0.0),
+            Vec3::new(3.0, 0.0, 10.0),
+            0.08,
+            [0.8, 0.6, 0.4],
+        );
+        assert_eq!(v.len(), SEGMENTS * 2 * 4);
+        // Across the view (the eye looks down Z): it spreads along Y, half its width either side.
+        let spread = v.iter().map(|x| x.pos[1].abs()).fold(0.0, f32::max);
+        assert!((spread - 0.04).abs() < 1.0e-4, "{spread}");
+        // The rim darker than the core, and from one end to the other.
+        let core = v
+            .iter()
+            .filter(|x| x.pos[1].abs() < 1.0e-5)
+            .map(|x| x.color[0])
+            .fold(0.0, f32::max);
+        let rim = v
+            .iter()
+            .filter(|x| x.pos[1].abs() > 0.03)
+            .map(|x| x.color[0])
+            .fold(0.0, f32::max);
+        assert!(rim < core, "{rim} {core}");
+        let xs: Vec<f32> = v.iter().map(|x| x.pos[0]).collect();
+        assert!(xs.iter().any(|x| x.abs() < 1.0e-4) && xs.iter().any(|x| (x - 6.0).abs() < 1.0e-4));
+    }
+
+    #[test]
+    fn a_rope_with_no_length_draws_nothing() {
+        assert!(rope_strip(Vec3::ONE, Vec3::ONE, Vec3::ZERO, 0.08, [1.0; 3]).is_empty());
+    }
+}
