new file mode 100644
index 0000000..a82d16d
--- /dev/null
+++ b/crates/benilla-world/src/look/mod.rs
@@ -0,0 +1,325 @@
+//! The new look, benilla's own (no reference behaviour): WoW Forever's idea of keeping 1.12's
+//! models and textures and re-lighting the world, zone by zone. A zone's light is hand-tuned by
+//! time of day ([`grade`]) over the `Light.dbc` sample. One switch, [`WorldLook`] (the game's
+//! `worldLook` CVar), turns all of it off, and the classic look is then exactly the reference's.
+
+use bevy::ecs::system::SystemParam;
+use bevy::prelude::*;
+use std::collections::HashMap;
+
+use benilla_assets::{AssetSet, LockRecover, WorldAssets};
+use benilla_formats::{AreaTableCatalog, Atmosphere};
+
+pub mod grade;
+pub use grade::{GradeKey, PostLook, Tint};
+
+/// The new look or the classic one. Off by default, so the engine alone (the world viewer, every
+/// test) is the reference; the game turns it on from its `worldLook` CVar.
+#[derive(Resource, Clone, Copy, Debug, PartialEq, Eq, Default)]
+pub struct WorldLook {
+    pub on: bool,
+}
+
+impl WorldLook {
+    /// 1.12's look, exactly.
+    pub const CLASSIC: Self = Self { on: false };
+    /// The new look.
+    pub const NEW: Self = Self { on: true };
+}
+
+/// Elwynn Forest's `AreaTable.dbc` id, the top-level zone of Goldshire, Northshire Valley and the
+/// rest of its sub-zones.
+pub const ELWYNN_ZONE: u32 = 12;
+
+/// The grade table of a top-level zone; only Elwynn has one so far.
+pub fn zone_grade(zone: u32) -> Option<&'static [GradeKey]> {
+    match zone {
+        ELWYNN_ZONE => Some(&grade::ELWYNN),
+        _ => None,
+    }
+}
+
+/// Every `AreaTable.dbc` area's top-level zone, walked up the parent chain once at load, so the
+/// sub-zone under the player ([`crate::terrain_stream::CurrentArea`]) names its zone in a lookup.
+#[derive(Resource, Default, Debug)]
+pub struct LookAreas(HashMap<u32, u32>);
+
+impl LookAreas {
+    pub fn from_catalog(catalog: &AreaTableCatalog) -> Self {
+        Self(
+            catalog
+                .rows_in_order()
+                .filter_map(|(id, _)| catalog.top_zone(id).map(|zone| (id, zone)))
+                .collect(),
+        )
+    }
+
+    /// The top-level zone of `area`, or `None` for an area the table does not have.
+    pub fn zone(&self, area: u32) -> Option<u32> {
+        self.0.get(&area).copied()
+    }
+}
+
+fn load_look_areas(mut commands: Commands, assets: Option<Res<WorldAssets>>) {
+    let Some(assets) = assets else { return };
+    let loaded = {
+        let mut chain = assets.chain.lock_recover();
+        benilla_formats::load_area_table_catalog(&mut chain)
+    };
+    match loaded {
+        Ok(cat) => commands.insert_resource(LookAreas::from_catalog(&cat)),
+        Err(e) => warn!("look: AreaTable failed to load, no zone grades: {e:#}"),
+    }
+}
+
+/// Seconds a zone grade takes to come in on entering its zone, and to go on leaving, so the
+/// border never snaps.
+pub const ZONE_RAMP_SECS: f32 = 3.0;
+
+/// The zone weight: 0 to 1 over [`ZONE_RAMP_SECS`] while the player is in a graded zone, back to 0
+/// outside it; `zone` is the table it ramps (kept while it ramps out).
+#[derive(Resource, Default, Debug, Clone, Copy, PartialEq)]
+pub struct ZoneRamp {
+    pub weight: f32,
+    pub zone: Option<u32>,
+}
+
+impl ZoneRamp {
+    /// One frame of `dt` seconds with the player in `zone` (`None`: no zone known).
+    pub fn advance(&mut self, zone: Option<u32>, dt: f32) {
+        let graded = zone.filter(|z| zone_grade(*z).is_some());
+        let step = dt.max(0.0) / ZONE_RAMP_SECS;
+        match graded {
+            // Entering, or still in, a graded zone.
+            Some(z) if self.zone == Some(z) || self.weight <= 0.0 => {
+                self.zone = Some(z);
+                self.weight = (self.weight + step).min(1.0);
+            }
+            // Out of the zone (or into another graded one): the old grade ramps out first.
+            _ => {
+                self.weight = (self.weight - step).max(0.0);
+                if self.weight <= 0.0 {
+                    self.zone = graded;
+                }
+            }
+        }
+    }
+}
+
+/// The grade the lighting resolve applied this frame: its post-pass values (neutral outside a
+/// graded zone, under the classic look, under water or as a ghost) and the zone weight they carry.
+#[derive(Resource, Default, Debug, Clone, Copy, PartialEq)]
+pub struct LookGrade {
+    pub post: PostLook,
+    pub strength: f32,
+}
+
+/// What the lighting resolve needs to grade the atmosphere, as one system parameter.
+#[derive(SystemParam)]
+pub(crate) struct LookInputs<'w> {
+    look: Res<'w, WorldLook>,
+    areas: Option<Res<'w, LookAreas>>,
+    area: Option<Res<'w, crate::terrain_stream::CurrentArea>>,
+    ramp: ResMut<'w, ZoneRamp>,
+    grade: ResMut<'w, LookGrade>,
+}
+
+impl LookInputs<'_> {
+    /// The zone grade over `atmo` at `minute` (fractional), after advancing the zone ramp by `dt`;
+    /// `suppressed` (under water, a ghost) applies none. Publishes [`LookGrade`].
+    pub(crate) fn apply(
+        &mut self,
+        atmo: Atmosphere,
+        minute: f32,
+        dt: f32,
+        suppressed: bool,
+    ) -> Atmosphere {
+        let zone = self
+            .area
+            .as_ref()
+            .and_then(|a| a.0)
+            .and_then(|a| self.areas.as_ref()?.zone(a));
+        let (atmo, post, strength) = graded(
+            *self.look,
+            &mut self.ramp,
+            zone,
+            atmo,
+            minute,
+            dt,
+            suppressed,
+        );
+        let next = LookGrade { post, strength };
+        if *self.grade != next {
+            *self.grade = next;
+        }
+        atmo
+    }
+}
+
+/// [`LookInputs::apply`] without the ECS: the graded atmosphere, the post values and the strength.
+/// The classic look resets the ramp and returns the sample untouched.
+pub fn graded(
+    look: WorldLook,
+    ramp: &mut ZoneRamp,
+    zone: Option<u32>,
+    atmo: Atmosphere,
+    minute: f32,
+    dt: f32,
+    suppressed: bool,
+) -> (Atmosphere, PostLook, f32) {
+    if !look.on {
+        *ramp = ZoneRamp::default();
+        return (atmo, PostLook::NEUTRAL, 0.0);
+    }
+    ramp.advance(zone, dt);
+    let table = ramp.zone.and_then(zone_grade);
+    match table {
+        Some(keys) if !suppressed && ramp.weight > 0.0 => {
+            let key = grade::sample(keys, minute);
+            (
+                key.apply(atmo, ramp.weight),
+                key.post_at(ramp.weight),
+                ramp.weight,
+            )
+        }
+        _ => (atmo, PostLook::NEUTRAL, 0.0),
+    }
+}
+
+/// The look's resources, for the lighting plugin, whose resolve reads them.
+pub(crate) fn init_resources(app: &mut App) {
+    app.init_resource::<WorldLook>()
+        .init_resource::<ZoneRamp>()
+        .init_resource::<LookGrade>();
+}
+
+/// The new look's world side: its resources and the area table its zone lookup reads.
+pub(crate) struct LookPlugin;
+
+impl Plugin for LookPlugin {
+    fn build(&self, app: &mut App) {
+        init_resources(app);
+        app.add_systems(Startup, load_look_areas.after(AssetSet::Open));
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use benilla_formats::AreaTableRow;
+
+    fn row(zone_id: u32, name: &str) -> AreaTableRow {
+        AreaTableRow {
+            map_id: 0,
+            zone_id,
+            explore_flag: 0,
+            flags: 0,
+            faction_group_mask: 0,
+            exploration_level: 0,
+            name: name.into(),
+        }
+    }
+
+    /// Goldshire (87) and Northshire Valley (9) are Elwynn's sub-zones; the Northshire Abbey row
+    /// (24) sits two hops down. Westfall (40) is its own zone.
+    #[test]
+    fn an_elwynn_sub_zone_resolves_to_zone_12() {
+        let areas = LookAreas::from_catalog(&AreaTableCatalog::from_rows(vec![
+            (12, row(0, "Elwynn Forest")),
+            (87, row(12, "Goldshire")),
+            (9, row(12, "Northshire Valley")),
+            (24, row(9, "Northshire Abbey")),
+            (40, row(0, "Westfall")),
+        ]));
+        assert_eq!(areas.zone(87), Some(ELWYNN_ZONE));
+        assert_eq!(areas.zone(9), Some(ELWYNN_ZONE));
+        assert_eq!(areas.zone(24), Some(ELWYNN_ZONE));
+        assert_eq!(areas.zone(12), Some(ELWYNN_ZONE));
+        assert_eq!(areas.zone(40), Some(40));
+        assert_eq!(areas.zone(999), None);
+        assert!(zone_grade(ELWYNN_ZONE).is_some());
+        assert!(zone_grade(40).is_none());
+    }
+
+    /// 0 to 1 over three seconds in Elwynn, and back out over three on leaving.
+    #[test]
+    fn the_zone_weight_ramps_in_and_out() {
+        let mut ramp = ZoneRamp::default();
+        ramp.advance(Some(ELWYNN_ZONE), 1.5);
+        assert!((ramp.weight - 0.5).abs() < 1e-6);
+        ramp.advance(Some(ELWYNN_ZONE), 1.5);
+        assert_eq!(ramp.weight, 1.0);
+        ramp.advance(Some(ELWYNN_ZONE), 10.0);
+        assert_eq!(ramp.weight, 1.0, "held at one");
+        // Into Westfall: Elwynn's grade ramps out, still Elwynn's while it does.
+        ramp.advance(Some(40), 1.0);
+        assert!((ramp.weight - 2.0 / 3.0).abs() < 1e-6);
+        assert_eq!(ramp.zone, Some(ELWYNN_ZONE));
+        ramp.advance(Some(40), 2.0);
+        assert_eq!(ramp.weight, 0.0);
+        assert_eq!(ramp.zone, None, "Westfall has no grade");
+        // No area known (no avatar) is outside every zone.
+        ramp.advance(Some(ELWYNN_ZONE), 3.0);
+        ramp.advance(None, 1.5);
+        assert!((ramp.weight - 0.5).abs() < 1e-6);
+    }
+
+    /// `worldLook 0`: the sample comes back untouched, with no post values, at full zone weight.
+    #[test]
+    fn the_classic_look_returns_the_sample_untouched() {
+        let atmo = Atmosphere::DEFAULT;
+        let mut ramp = ZoneRamp {
+            weight: 1.0,
+            zone: Some(ELWYNN_ZONE),
+        };
+        let (out, post, strength) = graded(
+            WorldLook::CLASSIC,
+            &mut ramp,
+            Some(ELWYNN_ZONE),
+            atmo,
+            1050.0,
+            0.016,
+            false,
+        );
+        assert_eq!(out.sun_diffuse, atmo.sun_diffuse);
+        assert_eq!(out.ambient, atmo.ambient);
+        assert_eq!(out.fog_color, atmo.fog_color);
+        assert_eq!(out.fog_end, atmo.fog_end);
+        assert_eq!(out.sky, atmo.sky);
+        assert!(post.is_neutral());
+        assert_eq!(strength, 0.0);
+        assert_eq!(
+            ramp,
+            ZoneRamp::default(),
+            "the ramp starts over on switching back"
+        );
+    }
+
+    #[test]
+    fn the_new_look_grades_elwynn_and_nothing_else() {
+        let atmo = Atmosphere::DEFAULT;
+        let mut ramp = ZoneRamp::default();
+        let mut run = |zone, suppressed| {
+            graded(
+                WorldLook::NEW,
+                &mut ramp,
+                zone,
+                atmo,
+                1050.0,
+                5.0,
+                suppressed,
+            )
+        };
+        let (out, post, strength) = run(Some(ELWYNN_ZONE), false);
+        assert_eq!(strength, 1.0);
+        assert!(out.fog_end > atmo.fog_end, "golden hour sees further");
+        assert!(post.rays > 0.0 && post.warmth > 0.0);
+        // Under water or as a ghost, none (the ramp keeps running underneath).
+        let (out, post, strength) = run(Some(ELWYNN_ZONE), true);
+        assert_eq!(out.fog_end, atmo.fog_end);
+        assert!(post.is_neutral());
+        assert_eq!(strength, 0.0);
+        let (out, _, _) = run(Some(40), false);
+        assert_eq!(out.fog_end, atmo.fog_end, "out of Elwynn after the ramp");
+    }
+}
