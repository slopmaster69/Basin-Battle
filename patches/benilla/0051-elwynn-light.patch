+    ),
+];
+
+/// The grade at `minute` (fractional, wrapped into `0..1440`): exact at each key, smoothstepped
+/// between neighbours so the light never kinks at a key, and wrapping from the last key to the
+/// first across midnight. `keys` must be in minute order.
+pub fn sample(keys: &[GradeKey], minute: f32) -> GradeKey {
+    let Some(first) = keys.first() else {
+        return GradeKey::NEUTRAL;
+    };
+    let m = minute.rem_euclid(1440.0);
+    // The last key at or before `m`, else (before the first key) the last key of the day.
+    let i = keys
+        .iter()
+        .rposition(|k| k.minute <= m)
+        .unwrap_or(keys.len() - 1);
+    let a = &keys[i];
+    let b = keys.get(i + 1).unwrap_or(first);
+    let span = (b.minute - a.minute).rem_euclid(1440.0);
+    if span <= 0.0 {
+        return *a;
+    }
+    let t = ((m - a.minute).rem_euclid(1440.0) / span).clamp(0.0, 1.0);
+    let s = t * t * (3.0 - 2.0 * t);
+    GradeKey {
+        minute: m,
+        ..a.lerp(b, s)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn close(a: f32, b: f32) -> bool {
+        (a - b).abs() < 1e-5
+    }
+
+    #[test]
+    fn the_keys_are_in_minute_order_inside_the_day() {
+        assert!(ELWYNN.windows(2).all(|w| w[0].minute < w[1].minute));
+        assert!(ELWYNN.iter().all(|k| (0.0..1440.0).contains(&k.minute)));
+        assert_eq!(ELWYNN[3].minute, 720.0, "noon");
+    }
+
+    #[test]
+    fn exact_at_every_key() {
+        for k in &ELWYNN {
+            let s = sample(&ELWYNN, k.minute);
+            assert_eq!(
+                GradeKey { minute: 0.0, ..s },
+                GradeKey { minute: 0.0, ..*k }
+            );
+        }
+    }
+
+    /// Smoothstep is ½ at the middle, so midway between two keys is their average.
+    #[test]
+    fn midway_between_two_keys_is_their_average() {
+        let (morning, noon) = (&ELWYNN[2], &ELWYNN[3]);
+        let mid = sample(&ELWYNN, (morning.minute + noon.minute) / 2.0);
+        assert!(close(
+            mid.fog_end_scale,
+            (morning.fog_end_scale + noon.fog_end_scale) / 2.0
+        ));
+        assert!(close(
+            mid.sun.weight,
+            (morning.sun.weight + noon.sun.weight) / 2.0
+        ));
+        assert!(close(
+            mid.post.height_fog,
+            (morning.post.height_fog + noon.post.height_fog) / 2.0
+        ));
+        // Not linear off the middle: a quarter of the way in is under a quarter of the change.
+        let q = sample(
+            &ELWYNN,
+            morning.minute + (noon.minute - morning.minute) / 4.0,
+        );
+        let lin = morning.fog_end_scale + (noon.fog_end_scale - morning.fog_end_scale) / 4.0;
+        assert!(q.fog_end_scale < lin);
+    }
+
+    /// From 21:30 to 05:30 the grade runs across midnight: night held to 00:00, then toward first
+    /// light, with no jump at 1439 → 0.
+    #[test]
+    fn it_wraps_across_midnight() {
+        let night = &ELWYNN[0];
+        let before = sample(&ELWYNN, 1439.9);
+        let after = sample(&ELWYNN, 0.1);
+        assert!(close(before.fog_end_scale, night.fog_end_scale));
+        assert!((before.sun.weight - after.sun.weight).abs() < 1e-3);
+        // A minute past 24:00 is a minute past midnight.
+        assert_eq!(sample(&ELWYNN, 1440.0 + 60.0), sample(&ELWYNN, 60.0));
+        assert_eq!(sample(&ELWYNN, -60.0), sample(&ELWYNN, 1380.0));
+        // Before the first key of a table that starts after midnight, the last key leads.
+        let late = [
+            GradeKey {
+                minute: 600.0,
+                fog_end_scale: 2.0,
+                ..GradeKey::NEUTRAL
+            },
+            GradeKey {
+                minute: 1200.0,
+                fog_end_scale: 4.0,
+                ..GradeKey::NEUTRAL
+            },
+        ];
+        // 20:00 → 10:00 spans 840 minutes: 00:00 is 240 in, under half way; 03:00 is the middle.
+        let s = sample(&late, 0.0);
+        assert!(
+            s.fog_end_scale < 4.0 && s.fog_end_scale > 3.0,
+            "{}",
+            s.fog_end_scale
+        );
+        assert!(close(sample(&late, 180.0).fog_end_scale, 3.0));
+    }
+
+    #[test]
+    fn strength_zero_returns_the_sample_untouched() {
+        let atmo = Atmosphere::DEFAULT;
+        let out = ELWYNN[4].apply(atmo, 0.0);
+        assert_eq!(out.sun_diffuse, atmo.sun_diffuse);
+        assert_eq!(out.fog_end, atmo.fog_end);
+        assert_eq!(out.sky, atmo.sky);
+        assert!(ELWYNN[4].post_at(0.0).is_neutral());
+    }
+
+    /// A tint blends toward its colour by its weight; the fog end scales.
+    #[test]
+    fn a_key_nudges_the_sample() {
+        let atmo = Atmosphere::DEFAULT;
+        let golden = &ELWYNN[4];
+        let out = golden.apply(atmo, 1.0);
+        let w = golden.sun.weight;
+        for i in 0..3 {
+            let want = atmo.sun_diffuse[i] + (golden.sun.color[i] - atmo.sun_diffuse[i]) * w;
+            assert!(close(out.sun_diffuse[i], want));
+        }
+        assert!(close(out.fog_end, atmo.fog_end * golden.fog_end_scale));
+        // Golden hour warms the sun: more red than blue gained.
+        assert!(
+            out.sun_diffuse[0] - out.sun_diffuse[2] > atmo.sun_diffuse[0] - atmo.sun_diffuse[2]
+        );
+        // Half strength is half way.
+        let half = golden.apply(atmo, 0.5);
+        assert!(close(
+            half.fog_end,
+            atmo.fog_end * (1.0 + (golden.fog_end_scale - 1.0) / 2.0)
+        ));
+        assert!(close(
+            golden.post_at(0.5).saturation,
+            1.0 + (golden.post.saturation - 1.0) / 2.0
+        ));
+    }
+}
