+        Tint::new(1.00, 0.97, 0.90, 0.15),
+        Tint::new(0.55, 0.68, 0.95, 0.30),
+        Tint::new(0.78, 0.86, 0.96, 0.20),
+        Tint::new(0.45, 0.65, 0.98, 0.20),
