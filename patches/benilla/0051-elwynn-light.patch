+//! A zone's hand-tuned light by time of day, benilla's own (no reference behaviour): keyframes over
+//! the game clock that nudge the `Light.dbc` sample rather than replace it, each key a tint blended
+//! into the sampled colour at its own weight, plus the post-pass values the `look` pass reads, so
+//! one table drives the whole look of a zone. Elwynn Forest's is [`ELWYNN`].
+
+use benilla_formats::Atmosphere;
+
+/// A tint and how much of it is blended into the sampled colour (`0` keeps the sample).
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Tint {
+    /// sRGB 0..1, as `Atmosphere`'s colours.
+    pub color: [f32; 3],
+    pub weight: f32,
+}
+
+impl Tint {
+    /// No tint: the sample passes through.
+    pub const NONE: Self = Self {
+        color: [0.0; 3],
+        weight: 0.0,
+    };
+
+    const fn new(r: f32, g: f32, b: f32, weight: f32) -> Self {
+        Self {
+            color: [r, g, b],
+            weight,
+        }
+    }
+
+    /// `sample` with this tint blended in at `weight × strength`.
+    fn over(&self, sample: [f32; 3], strength: f32) -> [f32; 3] {
+        let w = (self.weight * strength).clamp(0.0, 1.0);
+        std::array::from_fn(|i| sample[i] + (self.color[i] - sample[i]) * w)
+    }
+
+    fn lerp(&self, other: &Tint, t: f32) -> Tint {
+        Tint {
+            color: std::array::from_fn(|i| lerp(self.color[i], other.color[i], t)),
+            weight: lerp(self.weight, other.weight, t),
+        }
+    }
+}
+
+/// The values the new look's full-screen pass reads (its grade, bloom, rays and mist), at their
+/// neutral when the grade is off: the frame then passes through it unchanged.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct PostLook {
+    /// Saturation around luminance; 1 is the frame's own.
+    pub saturation: f32,
+    /// Contrast around mid-grey 0.18 in log space; 1 is the frame's own.
+    pub contrast: f32,
+    /// White balance: positive warms the highlights and cools the shadows.
+    pub warmth: f32,
+    /// Bloom intensity (Bevy's `Bloom`, additive).
+    pub bloom: f32,
+    /// Height-fog (mist) strength, 0..1.
+    pub height_fog: f32,
+    /// God-ray strength, 0..1.
+    pub rays: f32,
+}
+
+impl PostLook {
+    pub const NEUTRAL: Self = Self {
+        saturation: 1.0,
+        contrast: 1.0,
+        warmth: 0.0,
+        bloom: 0.0,
+        height_fog: 0.0,
+        rays: 0.0,
+    };
+
+    /// The frame passes through untouched.
+    pub fn is_neutral(&self) -> bool {
+        *self == Self::NEUTRAL
+    }
+
+    fn lerp(&self, other: &PostLook, t: f32) -> PostLook {
+        PostLook {
+            saturation: lerp(self.saturation, other.saturation, t),
+            contrast: lerp(self.contrast, other.contrast, t),
+            warmth: lerp(self.warmth, other.warmth, t),
+            bloom: lerp(self.bloom, other.bloom, t),
+            height_fog: lerp(self.height_fog, other.height_fog, t),
+            rays: lerp(self.rays, other.rays, t),
+        }
+    }
+}
+
+impl Default for PostLook {
+    fn default() -> Self {
+        Self::NEUTRAL
+    }
+}
+
+/// One keyframe of a zone grade, at a minute of the game day.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct GradeKey {
+    /// Minute of the game day, `0..1440`.
+    pub minute: f32,
+    /// The sun's direct light (`Light.dbc` diffuse).
+    pub sun: Tint,
+    /// The ambient light, which is what the shadows are lit by.
+    pub ambient: Tint,
+    pub fog: Tint,
+    /// All five sky-dome stops.
+    pub sky: Tint,
+    /// The fog end's multiplier: above 1 sees further (the consumer still takes `min(end, reach)`).
+    pub fog_end_scale: f32,
+    pub post: PostLook,
+}
+
+impl GradeKey {
+    /// The identity: the sample untouched, the post pass neutral.
+    pub const NEUTRAL: Self = Self {
+        minute: 0.0,
+        sun: Tint::NONE,
+        ambient: Tint::NONE,
+        fog: Tint::NONE,
+        sky: Tint::NONE,
+        fog_end_scale: 1.0,
+        post: PostLook::NEUTRAL,
+    };
+
+    /// Field-wise blend toward `other` (`t = 0` is `self`); the minute is not blended.
+    pub fn lerp(&self, other: &GradeKey, t: f32) -> GradeKey {
+        GradeKey {
+            minute: self.minute,
+            sun: self.sun.lerp(&other.sun, t),
+            ambient: self.ambient.lerp(&other.ambient, t),
+            fog: self.fog.lerp(&other.fog, t),
+            sky: self.sky.lerp(&other.sky, t),
+            fog_end_scale: lerp(self.fog_end_scale, other.fog_end_scale, t),
+            post: self.post.lerp(&other.post, t),
+        }
+    }
+
+    /// The sampled atmosphere with this key folded in at `strength` (the zone weight, 0..1): each
+    /// tint blended into its colour, the fog end scaled. `0` returns the sample unchanged.
+    pub fn apply(&self, atmo: Atmosphere, strength: f32) -> Atmosphere {
+        if strength <= 0.0 {
+            return atmo;
+        }
+        let s = strength.min(1.0);
+        let mut out = atmo;
+        out.sun_diffuse = self.sun.over(atmo.sun_diffuse, s);
+        out.ambient = self.ambient.over(atmo.ambient, s);
+        out.fog_color = self.fog.over(atmo.fog_color, s);
+        for stop in &mut out.sky {
+            *stop = self.sky.over(*stop, s);
+        }
+        out.fog_end = atmo.fog_end * lerp(1.0, self.fog_end_scale, s);
+        out
+    }
+
+    /// The post values at `strength`: neutral at 0, this key's at 1.
+    pub fn post_at(&self, strength: f32) -> PostLook {
+        PostLook::NEUTRAL.lerp(&self.post, strength.clamp(0.0, 1.0))
+    }
+}
+
+fn lerp(a: f32, b: f32, t: f32) -> f32 {
+    a + (b - a) * t
+}
+
+/// A key at `h:m` from the palette's columns: sun, ambient, fog and sky tints with their weights
+/// (as fractions), the fog-end multiplier, then saturation, contrast, warmth, bloom, height fog
+/// and rays.
+#[allow(clippy::too_many_arguments)]
+const fn key(
+    h: u32,
+    m: u32,
+    sun: Tint,
+    ambient: Tint,
+    fog: Tint,
+    sky: Tint,
+    fog_end_scale: f32,
+    [saturation, contrast, warmth, bloom, height_fog, rays]: [f32; 6],
+) -> GradeKey {
+    GradeKey {
+        minute: (h * 60 + m) as f32,
+        sun,
+        ambient,
+        fog,
+        sky,
+        fog_end_scale,
+        post: PostLook {
+            saturation,
+            contrast,
+            warmth,
+            bloom,
+            height_fog,
+            rays,
+        },
+    }
+}
+
+/// Elwynn's night, held from 21:30 across midnight.
