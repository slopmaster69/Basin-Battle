+    key(
+        19,
+        30,
+        Tint::new(0.95, 0.55, 0.55, 0.40),
+        Tint::new(0.55, 0.50, 0.85, 0.35),
+        Tint::new(0.65, 0.45, 0.60, 0.45),
+        Tint::new(0.75, 0.45, 0.70, 0.35),
+        1.5,
+        [1.05, 1.08, 0.05, 0.12, 0.35, 0.5],
+    ),
+    key(
+        21,
+        30,
+        ELWYNN_NIGHT.0,
+        ELWYNN_NIGHT.1,
+        ELWYNN_NIGHT.2,
+        ELWYNN_NIGHT.3,
