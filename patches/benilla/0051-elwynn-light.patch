+    Tint::new(0.55, 0.65, 0.95, 0.30),
+    Tint::new(0.45, 0.55, 0.90, 0.35),
+    Tint::new(0.20, 0.26, 0.42, 0.40),
+    Tint::new(0.18, 0.24, 0.45, 0.25),
+    1.3,
+    [0.95, 1.05, -0.10, 0.06, 0.25, 0.0],
+);
+
