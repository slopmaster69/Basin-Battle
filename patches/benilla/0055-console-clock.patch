+    /// `worldclock`: a minute holds the lighting's clock there, `server` or nothing lets it go,
+    /// and anything else leaves it as it was with the usage line.
+    #[test]
+    fn the_world_clock_holds_and_lets_go() {
+        use benilla_world::dev_state::DebugState;
+        let mut app = world_app();
+        let clock = |app: &mut App| {
+            let d = app.world_mut().get_resource_or_init::<DebugState>();
+            (d.lighting.follow_server_time, d.lighting.manual_minute)
+        };
+        assert_eq!(
+            run(&mut app, "worldclock 1050"),
+            ["World clock held at 17:30."]
+        );
+        assert_eq!(clock(&mut app), (false, 1050));
+        assert_eq!(
+            run(&mut app, "worldclock 0"),
+            ["World clock held at 00:00."]
+        );
+        assert_eq!(clock(&mut app), (false, 0));
+        assert_eq!(
+            run(&mut app, "worldclock 1440"),
+            ["Usage: worldclock <minute 0-1439> | server"]
+        );
+        assert_eq!(run(&mut app, "worldclock dusk").len(), 1);
+        assert_eq!(clock(&mut app), (false, 0), "a bad minute changes nothing");
+        assert_eq!(
+            run(&mut app, "worldclock server"),
+            ["World clock follows the server."]
+        );
+        assert!(clock(&mut app).0);
+        run(&mut app, "worldclock 330");
+        run(&mut app, "worldclock");
+        assert_eq!(
+            clock(&mut app),
+            (true, 330),
+            "no argument follows the server too"
+        );
+    }
+
+    /// `lookbloom`: a value holds the bloom, a second its threshold, `grade` or nothing lets go,
+    /// and anything out of range leaves it as it was with the usage line.
+    #[test]
+    fn the_look_bloom_holds_and_lets_go() {
+        use benilla_world::look::LookBloomTune;
+        let mut app = world_app();
+        let tune = |app: &mut App| *app.world_mut().get_resource_or_init::<LookBloomTune>();
+        assert_eq!(run(&mut app, "lookbloom 0.4"), ["Bloom held at 0.4."]);
+        assert_eq!(
+            tune(&mut app),
+            LookBloomTune {
+                intensity: Some(0.4),
+                threshold: None
+            }
+        );
+        assert_eq!(
+            run(&mut app, "lookbloom 1 0.5"),
+            ["Bloom held at 1 (threshold 0.5)."]
+        );
+        assert_eq!(
+            tune(&mut app),
+            LookBloomTune {
+                intensity: Some(1.0),
+                threshold: Some(0.5)
+            }
+        );
+        assert_eq!(
+            run(&mut app, "lookbloom 9"),
+            ["Usage: lookbloom <intensity> [threshold] | grade"]
+        );
+        assert_eq!(run(&mut app, "lookbloom 0.3 2").len(), 1);
+        assert_eq!(
+            tune(&mut app).intensity,
+            Some(1.0),
+            "a bad value changes nothing"
+        );
+        assert_eq!(
+            run(&mut app, "lookbloom grade"),
+            ["Bloom follows the grade."]
+        );
+        assert_eq!(tune(&mut app), LookBloomTune::default());
+        run(&mut app, "lookbloom 0.2");
+        run(&mut app, "lookbloom");
+        assert_eq!(
+            tune(&mut app),
+            LookBloomTune::default(),
+            "no argument lets go too"
+        );
+    }
+
+    /// `lookmist`: a scale holds the mist, `day` holds the day it rolls for, `grade` or nothing
+    /// lets go of both, and anything out of range leaves it as it was with the usage line.
+    #[test]
+    fn the_look_mist_holds_and_lets_go() {
+        use benilla_world::look::LookMistTune;
+        let mut app = world_app();
+        let tune = |app: &mut App| *app.world_mut().get_resource_or_init::<LookMistTune>();
+        let usage = ["Usage: lookmist <scale 0-6> | day <number> | why | grade"];
+        assert_eq!(
+            run(&mut app, "lookmist 2.5"),
+            ["Mist held at 2.5 times the hour's."]
+        );
+        assert_eq!(tune(&mut app).scale, Some(2.5));
+        assert_eq!(run(&mut app, "lookmist 7"), usage);
+        assert_eq!(run(&mut app, "lookmist thick"), usage);
+        assert_eq!(
+            tune(&mut app).scale,
+            Some(2.5),
+            "a bad value changes nothing"
+        );
+        assert_eq!(
+            run(&mut app, "lookmist grade"),
+            ["Mist follows the day, the weather and events."]
+        );
+        assert_eq!(tune(&mut app), LookMistTune::default());
+        run(&mut app, "lookmist 0");
+        assert_eq!(tune(&mut app).scale, Some(0.0));
+        run(&mut app, "lookmist");
+        assert_eq!(
+            tune(&mut app),
+            LookMistTune::default(),
+            "no argument lets go too"
+        );
+
+        let roll = benilla_world::look::mist::day_roll(20_765);
+        assert_eq!(
+            run(&mut app, "lookmist day 20765"),
+            [format!(
+                "Mist rolls day 20765 (2026-11-08): {:.2} times the hour's, a fog day.",
+                roll.scale
+            )]
+        );
+        assert_eq!(tune(&mut app).day, Some(20_765));
+        assert_eq!(run(&mut app, "lookmist day soon"), usage);
+        assert_eq!(run(&mut app, "lookmist day -3"), usage);
+        assert_eq!(tune(&mut app).day, Some(20_765));
+        run(&mut app, "lookmist 3");
+        assert_eq!(
+            run(&mut app, "lookmist day server"),
+            ["Mist rolls the server's day."]
+        );
+        assert_eq!(
+            tune(&mut app),
+            LookMistTune {
+                scale: Some(3.0),
+                day: None
+            },
+            "the day lets go alone"
+        );
+        run(&mut app, "lookmist day 4");
+        run(&mut app, "lookmist grade");
+        assert_eq!(tune(&mut app), LookMistTune::default());
+    }
+
+    /// `lookmist why` prints the strength the mist resolved to and what decided it.
+    #[test]
+    fn the_look_mist_says_why() {
+        use benilla_world::look::{LookMist, MistSource};
+        let mut app = world_app();
+        let mut mist = LookMist::default();
+        mist.scale = 3.5;
+        mist.source = MistSource::Event;
+        mist.day = 20_763;
+        mist.event = Some(3.5);
+        app.world_mut().insert_resource(mist);
+        let lines = run(&mut app, "lookmist why");
+        assert_eq!(lines[0], "Mist at 3.50 times the hour's, from an event.");
+        assert!(
+            lines[1].starts_with("Day 20763 (2026-11-06, the server's): ")
+                && lines[1].contains("Event: 3.50. Held: no."),
+            "{lines:?}"
+        );
+        assert_eq!(
+            lines.last().map(String::as_str),
+            Some("The classic look (worldLook 0) has no mist.")
+        );
+    }
+
     /// The six toggles flip their bit and print the state they leave (`ConsoleWrite` class 0):
     /// the five world-flag bits start set (`0x7100b73`, `0x66f6cb`), the simple-doodad word clear
     /// (`0x66f714`). None reads its arguments.
