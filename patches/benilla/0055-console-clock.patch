+/// `worldclock <minute>`, benilla's own (1.12 has no such command): holds the world's time of day
+/// at a minute of the game day (0 to 1439, 720 noon), as the debug panel's clock scrub does, so a
+/// scripted visual check (`ConsoleExec("worldclock 1050")`) can shoot a scene at a set hour.
+/// `worldclock server`, or no argument, follows the server's clock again. The light, the sky and
+/// the new look's grade all follow on the next frame; the server's clock is untouched.
+fn world_clock(world: &mut World, args: &str) -> Vec<String> {
+    let arg = args.trim();
+    let mut debug = world.get_resource_or_init::<benilla_world::dev_state::DebugState>();
+    if arg.is_empty() || arg.eq_ignore_ascii_case("server") {
+        debug.lighting.follow_server_time = true;
+        return vec!["World clock follows the server.".to_string()];
+    }
+    match arg.parse::<u32>() {
+        Ok(minute) if minute < 1440 => {
+            debug.lighting.follow_server_time = false;
+            debug.lighting.manual_minute = minute;
+            vec![format!(
+                "World clock held at {:02}:{:02}.",
+                minute / 60,
+                minute % 60
+            )]
+        }
+        _ => vec!["Usage: worldclock <minute 0-1439> | server".to_string()],
+    }
+}
+
+/// `lookbloom <intensity> [threshold]`, benilla's own (1.12 has no such command): holds the new
+/// look's bloom at an intensity (and its prefilter's threshold, 0..1 of the gamma frame) whatever
+/// the hour's grade asks, so one take can compare several; `lookbloom grade`, or no argument, lets
+/// the grade decide again. The classic look (`worldLook 0`) has no bloom either way.
+fn look_bloom(world: &mut World, args: &str) -> Vec<String> {
+    use benilla_world::look::LookBloomTune;
+    let mut words = args.split_whitespace();
+    let first = words.next();
+    if first.is_none() || first.is_some_and(|w| w.eq_ignore_ascii_case("grade")) {
+        *world.get_resource_or_init::<LookBloomTune>() = LookBloomTune::default();
+        return vec!["Bloom follows the grade.".to_string()];
+    }
+    let usage = || vec!["Usage: lookbloom <intensity> [threshold] | grade".to_string()];
+    let Some(intensity) = first
+        .and_then(|w| w.parse::<f32>().ok())
+        .filter(|v| (0.0..=4.0).contains(v))
+    else {
+        return usage();
+    };
+    let threshold = match words.next() {
+        None => None,
+        Some(w) => match w.parse::<f32>().ok().filter(|v| (0.0..=1.0).contains(v)) {
+            Some(t) => Some(t),
+            None => return usage(),
+        },
+    };
+    *world.get_resource_or_init::<LookBloomTune>() = LookBloomTune {
+        intensity: Some(intensity),
+        threshold,
+    };
+    vec![match threshold {
+        Some(t) => format!("Bloom held at {intensity} (threshold {t})."),
+        None => format!("Bloom held at {intensity}."),
+    }]
+}
+
+/// `lookmist`, benilla's own (1.12 has no such command), for filming the new look's mist:
+///
+/// - `lookmist <scale>` holds it at a multiple of the hour's own (0 to 6: 0 none, 1 the hour's,
+///   3 three times as thick) over the day, the weather and any event, so one take can run from
+///   subtle to the densest still playable.
+/// - `lookmist day <number>` rolls it for that day (a calendar day number, days from 1970-01-01:
+///   2026-11-06 is 20763) instead of the server's, at once, so one take can show several days;
+///   `lookmist day` or `lookmist day server` goes back to the server's.
+/// - `lookmist why` prints the strength and what decided it: the day's roll, a fog day, the
+///   weather, an event or the held tune.
+/// - `lookmist grade`, or no argument, lets go of both.
+///
+/// The classic look (`worldLook 0`) has no mist either way.
+fn look_mist(world: &mut World, args: &str) -> Vec<String> {
+    use benilla_world::look::LookMistTune;
+    let usage = || vec!["Usage: lookmist <scale 0-6> | day <number> | why | grade".to_string()];
+    let mut words = args.split_whitespace();
+    match words.next() {
+        None => {
+            *world.get_resource_or_init::<LookMistTune>() = LookMistTune::default();
+            vec!["Mist follows the day, the weather and events.".to_string()]
+        }
+        Some(w) if w.eq_ignore_ascii_case("grade") => {
+            *world.get_resource_or_init::<LookMistTune>() = LookMistTune::default();
+            vec!["Mist follows the day, the weather and events.".to_string()]
+        }
+        Some(w) if w.eq_ignore_ascii_case("why") => mist_why(world),
+        Some(w) if w.eq_ignore_ascii_case("day") => match words.next() {
+            None => {
+                world.get_resource_or_init::<LookMistTune>().day = None;
+                vec!["Mist rolls the server's day.".to_string()]
+            }
+            Some(w) if w.eq_ignore_ascii_case("server") => {
+                world.get_resource_or_init::<LookMistTune>().day = None;
+                vec!["Mist rolls the server's day.".to_string()]
+            }
+            Some(w) => match w
+                .parse::<i64>()
+                .ok()
+                .filter(|d| (0..=1_000_000).contains(d))
+            {
+                Some(day) => {
+                    world.get_resource_or_init::<LookMistTune>().day = Some(day);
+                    let roll = benilla_world::look::mist::day_roll(day);
+                    vec![format!(
+                        "Mist rolls day {day} ({}): {:.2} times the hour's{}.",
+                        date_of(day),
+                        roll.scale,
+                        if roll.fog_day { ", a fog day" } else { "" }
+                    )]
+                }
+                None => usage(),
+            },
+        },
+        Some(w) => match w.parse::<f32>().ok().filter(|v| (0.0..=6.0).contains(v)) {
+            Some(scale) => {
+                world.get_resource_or_init::<LookMistTune>().scale = Some(scale);
+                vec![format!("Mist held at {scale} times the hour's.")]
+            }
+            None => usage(),
+        },
+    }
+}
+
+/// A calendar day number (days from 1970-01-01) as `2026-11-06`.
+fn date_of(day: i64) -> String {
+    let c = benilla_ui::civil::from_unix(day.saturating_mul(86_400));
+    format!("{:04}-{:02}-{:02}", c.year, c.month, c.day)
+}
+
+/// `lookmist why`: the strength the mist resolved to on the last frame and what decided it, then
+/// each of its inputs.
+fn mist_why(world: &mut World) -> Vec<String> {
+    use benilla_world::look::{LookMist, LookMistTune};
+    let mist = *world.get_resource_or_init::<LookMist>();
+    let tune = *world.get_resource_or_init::<LookMistTune>();
+    let on = world
+        .get_resource::<benilla_world::look::WorldLook>()
+        .is_some_and(|l| l.on);
+    let event = mist.event.map_or("none".to_string(), |e| format!("{e:.2}"));
+    let held = tune.scale.map_or("no".to_string(), |s| format!("{s:.2}"));
+    let mut lines = vec![
+        format!(
+            "Mist at {:.2} times the hour's, from {}.",
+            mist.scale,
+            mist.source.describe()
+        ),
+        format!(
+            "Day {} ({}{}): {:.2}{}. Weather: {:.2}. Day and weather eased: {:.2}. Event: {event}. \
+             Held: {held}.",
+            mist.day,
+            date_of(mist.day),
+            if tune.day.is_some() { ", held" } else { ", the server's" },
+            mist.roll.scale,
+            if mist.roll.fog_day { ", a fog day" } else { "" },
+            mist.weather,
+            mist.ambient,
+        ),
+    ];
+    if !on {
+        lines.push("The classic look (worldLook 0) has no mist.".to_string());
+    }
+    lines
+}
+
 /// A world-flag toggle (`0x673050` and its siblings): the bit set is cleared with the first line,
 /// a clear one set with the second, each through `ConsoleWrite` in class 0.
 fn toggle(world: &mut World, bit: u32, off: &str, on: &str) -> Vec<String> {
