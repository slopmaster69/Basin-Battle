From 19e9ca1f449227d7b41ff503fd5434ff63879c06 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 6 Nov 2026 09:04:58 -0700
Subject: [PATCH] A console clock for the visual check: `worldclock <minute>`
 holds the time of day

`worldclock 1050` holds the world's light at 17:30 (any minute of the game day, 0 to 1439, 720
noon), as the debug panel's clock scrub does; `worldclock server`, or `worldclock` alone, follows
the server's clock again. It is for the scripted visual check, whose scenarios shoot Elwynn at a
set hour with `ConsoleExec("worldclock 1050")`: the light, the sky and the new look's grade follow
on the next frame, and the server's own clock is untouched. A minute out of range or a word that
is not one prints the usage line and changes nothing. benilla's own; 1.12 has no such command.
---
 crates/benilla-app/src/world_console.rs | 73 +++++++++++++++++++++++++
 1 file changed, 73 insertions(+)

diff --git a/crates/benilla-app/src/world_console.rs b/crates/benilla-app/src/world_console.rs
index 0fbf678..a390f05 100644
--- a/crates/benilla-app/src/world_console.rs
+++ b/crates/benilla-app/src/world_console.rs
@@ -74,6 +74,13 @@ impl Plugin for WorldConsolePlugin {
         }
         // Registered by `InitSky` at the first map load (`0x6d1d43`-`0x6d1d4d`).
         app.console_command("SkySunGlare", GRAPHICS, Some("0, 1"), sky_sun_glare);
+        // benilla's own, not a 1.12 command: the visual check's clock.
+        app.console_command(
+            "worldclock",
+            GRAPHICS,
+            Some("<minute 0-1439> | server"),
+            world_clock,
+        );
         // Every world entry loads the map, which re-runs `InitSky` and re-arms the glares; a
         // worldport's own load is `benilla_world::sun`'s.
         app.add_systems(
@@ -83,6 +90,32 @@ impl Plugin for WorldConsolePlugin {
     }
 }
 
+/// `worldclock <minute>`, benilla's own (1.12 has no such command): holds the world's time of day
+/// at a minute of the game day (0 to 1439, 720 noon), as the debug panel's clock scrub does, so a
+/// scripted visual check (`ConsoleExec("worldclock 1050")`) can shoot a scene at a set hour.
+/// `worldclock server`, or no argument, follows the server's clock again. The light, the sky and
+/// the new look's grade all follow on the next frame; the server's clock is untouched.
+fn world_clock(world: &mut World, args: &str) -> Vec<String> {
+    let arg = args.trim();
+    let mut debug = world.get_resource_or_init::<benilla_world::dev_state::DebugState>();
+    if arg.is_empty() || arg.eq_ignore_ascii_case("server") {
+        debug.lighting.follow_server_time = true;
+        return vec!["World clock follows the server.".to_string()];
+    }
+    match arg.parse::<u32>() {
+        Ok(minute) if minute < 1440 => {
+            debug.lighting.follow_server_time = false;
+            debug.lighting.manual_minute = minute;
+            vec![format!(
+                "World clock held at {:02}:{:02}.",
+                minute / 60,
+                minute % 60
+            )]
+        }
+        _ => vec!["Usage: worldclock <minute 0-1439> | server".to_string()],
+    }
+}
+
 /// A world-flag toggle (`0x673050` and its siblings): the bit set is cleared with the first line,
 /// a clear one set with the second, each through `ConsoleWrite` in class 0.
 fn toggle(world: &mut World, bit: u32, off: &str, on: &str) -> Vec<String> {
@@ -306,6 +339,46 @@ mod tests {
         *app.world().resource::<WorldLevels>()
     }
 
+    /// `worldclock`: a minute holds the lighting's clock there, `server` or nothing lets it go,
+    /// and anything else leaves it as it was with the usage line.
+    #[test]
+    fn the_world_clock_holds_and_lets_go() {
+        use benilla_world::dev_state::DebugState;
+        let mut app = world_app();
+        let clock = |app: &mut App| {
+            let d = app.world_mut().get_resource_or_init::<DebugState>();
+            (d.lighting.follow_server_time, d.lighting.manual_minute)
+        };
+        assert_eq!(
+            run(&mut app, "worldclock 1050"),
+            ["World clock held at 17:30."]
+        );
+        assert_eq!(clock(&mut app), (false, 1050));
+        assert_eq!(
+            run(&mut app, "worldclock 0"),
+            ["World clock held at 00:00."]
+        );
+        assert_eq!(clock(&mut app), (false, 0));
+        assert_eq!(
+            run(&mut app, "worldclock 1440"),
+            ["Usage: worldclock <minute 0-1439> | server"]
+        );
+        assert_eq!(run(&mut app, "worldclock dusk").len(), 1);
+        assert_eq!(clock(&mut app), (false, 0), "a bad minute changes nothing");
+        assert_eq!(
+            run(&mut app, "worldclock server"),
+            ["World clock follows the server."]
+        );
+        assert!(clock(&mut app).0);
+        run(&mut app, "worldclock 330");
+        run(&mut app, "worldclock");
+        assert_eq!(
+            clock(&mut app),
+            (true, 330),
+            "no argument follows the server too"
+        );
+    }
+
     /// The six toggles flip their bit and print the state they leave (`ConsoleWrite` class 0):
     /// the five world-flag bits start set (`0x7100b73`, `0x66f6cb`), the simple-doodad word clear
     /// (`0x66f714`). None reads its arguments.
