+++ b/crates/benilla-app/src/entities/weapon_tip.rs
@@ -0,0 +1,53 @@
+//! Basin Battle: a hero's missiles leaving a casting staff's tip (`SetUnitMissileOrigin(unit,
+//! "weapon")`, the add-on telling it which heroes hold one): each frame the flagged units' held
+//! weapon's blade tip (its trail's `$WTT` anchor) in the world, which the missile launch takes
+//! before its hand cascade. Anything not flagged launches from the hands as ever.
+
+use std::collections::HashMap;
+use std::sync::Mutex;
+
+use bevy::prelude::*;
+
+static TIPS: Mutex<Option<HashMap<Entity, Vec3>>> = Mutex::new(None);
+
+/// A flagged unit's weapon tip this frame, if it has one.
+pub(crate) fn tip_of(unit: Entity) -> Option<Vec3> {
+    TIPS.lock().ok()?.as_ref()?.get(&unit).copied()
+}
+
+/// The flagged units' weapon tips, found afresh each frame.
+pub(super) fn track_weapon_tips(
+    me: Query<Entity, With<crate::net::SelfPlayer>>,
+    index: Option<Res<crate::net::GuidIndex>>,
+    held: Query<&super::HeldAttached>,
+    props: Query<(&GlobalTransform, &crate::weapon_trail::WeaponTrail)>,
+) {
+    let units = benilla_ui::action_combat::missile_origins();
+    let mut out = HashMap::new();
+    if !units.is_empty() {
+        let mine = me.single().ok();
+        for u in units {
+            let e = if u.eq_ignore_ascii_case("player") {
+                mine
+            } else {
+                let guid = u
+                    .strip_prefix("0x")
+                    .or_else(|| u.strip_prefix("0X"))
+                    .and_then(|h| u64::from_str_radix(h, 16).ok())
+                    .or_else(|| u.parse().ok());
+                guid.and_then(|g| index.as_ref().and_then(|i| i.0.get(&g).copied()))
+            };
+            let Some(e) = e else { continue };
+            let Ok(h) = held.get(e) else { continue };
+            for slot in h.spawned_slots().iter().flatten() {
+                if let Ok((gt, trail)) = props.get(*slot) {
+                    out.insert(e, gt.transform_point(trail.top()));
+                    break;
+                }
+            }
+        }
+    }
+    if let Ok(mut t) = TIPS.lock() {
+        *t = Some(out);
+    }
+}
