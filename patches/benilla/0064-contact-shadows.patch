+        assert_eq!(u.shade[0], 0.8);
+        assert_eq!(u.kernel[0], 1.2);
+        // A 90° vertical field: one yard at one yard is half the screen's height.
+        assert!((u.kernel[1] - 540.0).abs() < 1e-2, "{:?}", u.kernel);
+        assert!((Vec3::from_slice(&u.light[..3]) - Vec3::Y).length() < 1e-6);
+        assert!((u.light[3] - 3.0).abs() < 1e-5);
+        // A point ten yards ahead comes back from clip space.
+        let p = Vec3::new(1.0, -2.0, -10.0);
+        let clip = proj * p.extend(1.0);
+        let back = Mat4::from_cols_array_2d(&u.view_from_clip) * (clip / clip.w);
+        assert!((back.truncate() / back.w - p).length() < 1e-3);
+        assert!(wanted(&frame));
+        assert!(!wanted(&LookFrame { on: false, ..frame }));
+    }
+}
