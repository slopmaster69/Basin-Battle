+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::look::PostLook;
+
+    /// A flat floor shades nothing: every tap lies in its plane.
+    #[test]
+    fn a_flat_floor_has_no_occlusion() {
+        let n = Vec3::Y;
+        let taps: Vec<f32> = (0..12)
+            .map(|i| {
+                let a = i as f32 * 0.6;
+                tap_occlusion(Vec3::new(a.cos(), 0.0, a.sin()) * 0.7, n, tune::RADIUS)
+            })
+            .collect();
+        assert_eq!(occlusion(&taps), 0.0);
+    }
+
+    /// The ground `d` yards in front of a wall that faces the camera, as the kernel's spiral sees
+    /// it: a tap above the pixel on screen lands on the wall (as high as it is far up the disk),
+    /// one below on the ground, three times further for the ground's foreshortening.
+    fn before_a_wall(d: f32) -> f32 {
+        let taps: Vec<f32> = (0..12)
+            .map(|i| {
+                let a = (i as f32 + 0.5) / 12.0;
+                let ang = a * 7.0 * std::f32::consts::TAU + 0.3;
+                let r = a * tune::RADIUS;
+                let (x, y) = (ang.cos() * r, ang.sin() * r);
+                let v = if y > 0.0 {
+                    Vec3::new(x, y, -d)
+                } else {
+                    Vec3::new(x, 0.0, -3.0 * y)
+                };
+                tap_occlusion(v, Vec3::Y, tune::RADIUS)
+            })
+            .collect();
+        occlusion(&taps)
+    }
+
+    /// A wall's foot is shaded deepest right at the wall and less a yard out, never past its
+    /// cap.
+    #[test]
+    fn a_walls_foot_is_shaded() {
+        let (at, near, out) = (before_a_wall(0.05), before_a_wall(0.5), before_a_wall(1.3));
+        assert!(at > 0.4, "{at}");
+        assert!(at > near && near > out, "{at} {near} {out}");
+        assert_eq!(out, 0.0, "past the radius: none");
+        assert!(darkening(1.0, at, 1.0, 1.0) <= tune::MAX_DARKEN);
+    }
+
+    /// A tap on something far in front (a post before a distant hill) counts for nothing: no
