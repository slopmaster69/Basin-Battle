+// The new look's ambient occlusion, benilla's own (`look::ao`): soft contact shadows from the
+// depth buffer alone, at half resolution, ahead of the look pass (`world_look.wgsl`), which
+// upsamples and applies them. Three entry points, each its own pipeline:
+//   fs_ao      = per half-resolution pixel, the full-resolution pixel at twice its coordinate:
+//                its view-space position and normal rebuilt from depth, then twelve taps on a
+//                turned spiral over a disk `radius` yards wide, each counting how far it rises
+//                over the surface (`look::ao::tap_occlusion`), faded to nothing at the radius so
+//                nothing far in front halos; the mean times the gain is the occlusion, which
+//                leaves as the darkening itself: × the strength × the ambient share
+//                (`look::ao::ambient_share`) × the distance fade, capped
+//   fs_blur_x  = a depth-aware 9-tap Gaussian along x, then
+//   fs_blur_y  = along y, so the shade stays on its surface
+// Each target is (darkening, planar eye depth, 0, 0); the sky is (0, 0). `MSAA` reads sample 0 of
+// a multisampled depth buffer. The kernel mirrors `look::ao`; keep the two in step.
+
+#import bevy_core_pipeline::fullscreen_vertex_shader::FullscreenVertexOutput
+
+struct Ao {
+    view_from_clip: mat4x4<f32>,
+    // x = radius (yd), y = full-resolution pixels per yard at 1 yd, z = bias, w = gain.
+    kernel: vec4<f32>,
+    // x = strength, y = the most a pixel darkens, z = the fade's start, w = its end (yd).
+    shade: vec4<f32>,
+    // xyz = toward the sun, view space; w = the sun's luminance over the ambient's.
+    light: vec4<f32>,
+    // x = the ambient share's floor, y = the most pixels the radius spans, zw unused.
+    misc: vec4<f32>,
+}
+
+#ifdef MSAA
+@group(0) @binding(0) var depth_tex: texture_depth_multisampled_2d;
+#else
+@group(0) @binding(0) var depth_tex: texture_depth_2d;
+#endif
+@group(0) @binding(1) var<uniform> ao: Ao;
+// The blur's source: the occlusion, then the first blur.
+@group(0) @binding(2) var src_tex: texture_2d<f32>;
+
+// Taps per pixel, and the spiral's turns across them (prime to the count, so no two line up).
+const SAMPLES: i32 = 12;
+const TURNS: f32 = 7.0;
+const TAU: f32 = 6.28318530718;
+// The blur: taps either side, their Gaussian's sigma (half-resolution pixels), and how fast a
+// neighbour's weight falls with its depth's difference relative to the centre's.
+const BLUR_RADIUS: i32 = 4;
+const BLUR_SIGMA: f32 = 2.5;
+const BLUR_SHARPNESS: f32 = 40.0;
+
+fn load_depth(px: vec2<i32>) -> f32 {
+#ifdef MSAA
+    return textureLoad(depth_tex, px, 0);
+#else
+    return textureLoad(depth_tex, px, 0);
+#endif
+}
+
+// The view-space position of full-resolution pixel `px` at reverse-Z depth `d` (> 0).
+fn view_pos(px: vec2<i32>, d: f32, dims: vec2<f32>) -> vec3<f32> {
+    let uv = (vec2<f32>(px) + vec2<f32>(0.5)) / dims;
+    let v = ao.view_from_clip * vec4<f32>(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, d, 1.0);
+    return v.xyz / v.w;
+}
+
+// A neighbour's position, the sky pushed far away so the nearer side wins the normal.
+fn neighbour(px: vec2<i32>, dims: vec2<f32>) -> vec3<f32> {
+    let top = vec2<i32>(dims) - vec2<i32>(1);
+    let q = clamp(px, vec2<i32>(0), top);
+    return view_pos(q, max(load_depth(q), 1e-7), dims);
+}
+
+// The surface normal at `c` from its four neighbours, each axis taking the side whose depth is
+// closer, so a silhouette's edge keeps its own surface's normal; facing the camera.
+fn normal_at(px: vec2<i32>, c: vec3<f32>, dims: vec2<f32>) -> vec3<f32> {
+    let r = neighbour(px + vec2<i32>(1, 0), dims);
+    let l = neighbour(px - vec2<i32>(1, 0), dims);
+    let d = neighbour(px + vec2<i32>(0, 1), dims);
+    let u = neighbour(px - vec2<i32>(0, 1), dims);
+    let dx = select(c - l, r - c, abs(r.z - c.z) < abs(c.z - l.z));
+    let dy = select(c - u, d - c, abs(d.z - c.z) < abs(c.z - u.z));
+    let n = normalize(cross(dy, dx));
+    return select(n, -n, dot(n, -c) < 0.0);
+}
+
+// Interleaved gradient noise (Jimenez 2014): each pixel's spiral turned its own way, which the
+// blur then evens out.
+fn ign(p: vec2<f32>) -> f32 {
+    return fract(52.9829189 * fract(dot(p, vec2<f32>(0.06711056, 0.00583715))));
+}
+
+@fragment
+fn fs_ao(in: FullscreenVertexOutput) -> @location(0) vec4<f32> {
+    let q = vec2<i32>(in.position.xy);
+    let px = q * 2;
+    let dims = vec2<f32>(textureDimensions(depth_tex));
+    if px.x >= i32(dims.x) || px.y >= i32(dims.y) {
+        return vec4<f32>(0.0);
+    }
+    let depth = load_depth(px);
+    // Reverse-Z: the sky (never depth-written) is still the clear 0.
+    if depth <= 0.0 {
+        return vec4<f32>(0.0);
+    }
+    let c = view_pos(px, depth, dims);
+    let z = -c.z;
+    let fade = 1.0 - smoothstep(ao.shade.z, ao.shade.w, z);
+    let radius = ao.kernel.x;
+    let r_px = min(radius * ao.kernel.y / max(z, 1e-3), ao.misc.y);
+    if fade <= 0.0 || r_px < 1.0 {
+        return vec4<f32>(0.0, z, 0.0, 0.0);
+    }
+    let n = normal_at(px, c, dims);
+    let phi = TAU * ign(vec2<f32>(q));
+    let r2 = radius * radius;
+    var sum = 0.0;
+    for (var i = 0; i < SAMPLES; i++) {
+        let a = (f32(i) + 0.5) / f32(SAMPLES);
+        let angle = a * TURNS * TAU + phi;
+        let sp = px + vec2<i32>(round(vec2<f32>(cos(angle), sin(angle)) * (a * r_px)));
+        if any(sp < vec2<i32>(0)) || any(sp >= vec2<i32>(dims)) {
+            continue;
+        }
+        let sd = load_depth(sp);
+        if sd <= 0.0 {
+            continue;
+        }
+        let v = view_pos(sp, sd, dims) - c;
+        let vv = dot(v, v);
+        let falloff = max(1.0 - vv / r2, 0.0);
+        sum += falloff * max(dot(v, n) * inverseSqrt(vv + 1e-6) - ao.kernel.z, 0.0);
+    }
+    let occlusion = clamp(sum / f32(SAMPLES) * ao.kernel.w, 0.0, 1.0);
+    // The share of the light that is ambient: 1.12 lights `ambient + diffuse × n·l`.
+    let share = 1.0 / (1.0 + ao.light.w * max(dot(n, ao.light.xyz), 0.0));
+    let ambient = mix(ao.misc.x, 1.0, share);
+    let dark = min(ao.shade.x * occlusion * ambient * fade, ao.shade.y);
+    return vec4<f32>(dark, z, 0.0, 0.0);
+}
+
+fn blur(q: vec2<i32>, step: vec2<i32>) -> vec4<f32> {
+    let top = vec2<i32>(textureDimensions(src_tex)) - vec2<i32>(1);
+    let c = textureLoad(src_tex, q, 0);
+    if c.y <= 0.0 {
+        return c;
+    }
+    var sum = c.x;
+    var weight = 1.0;
+    for (var i = -BLUR_RADIUS; i <= BLUR_RADIUS; i++) {
+        if i == 0 {
+            continue;
+        }
+        let s = textureLoad(src_tex, clamp(q + step * i, vec2<i32>(0), top), 0);
+        let fi = f32(i);
+        let w = exp(-fi * fi / (2.0 * BLUR_SIGMA * BLUR_SIGMA))
+            * exp(-abs(s.y - c.y) * BLUR_SHARPNESS / c.y)
+            * select(0.0, 1.0, s.y > 0.0);
+        sum += s.x * w;
+        weight += w;
+    }
+    return vec4<f32>(sum / weight, c.y, 0.0, 0.0);
+}
+
+@fragment
+fn fs_blur_x(in: FullscreenVertexOutput) -> @location(0) vec4<f32> {
+    return blur(vec2<i32>(in.position.xy), vec2<i32>(1, 0));
+}
+
+@fragment
+fn fs_blur_y(in: FullscreenVertexOutput) -> @location(0) vec4<f32> {
+    return blur(vec2<i32>(in.position.xy), vec2<i32>(0, 1));
+}
