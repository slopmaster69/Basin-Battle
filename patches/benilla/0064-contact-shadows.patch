@@ -0,0 +1,814 @@
+//! Ambient occlusion, the new look's own (no reference behaviour): soft contact shadows where
+//! things meet, at a wall's foot, under eaves, between roots, in a doorway, under a cart or a
+//! fence, and in the creases of the ground. WoW Forever has them, and they set every model on the
+//! ground it stands on.
+//!
+//! Bevy's `ScreenSpaceAmbientOcclusion` reads the depth and normal prepasses, which benilla's own
+//! terrain, model and static-world shaders do not write, so this is a compact depth-only kernel of
+//! the SAO kind, with the normal rebuilt from depth, run inside the look pass's node
+//! (`look::pass`), before it, on the depth buffer the rays and the mist already sample:
+//! 1. **occlusion** (`world_ao.wgsl`'s `fs_ao`, half resolution): for each pixel, twelve depth taps
+//!    on a spiral over a disk [`tune::RADIUS`] yards wide, each counting how far it rises over the
+//!    pixel's own surface, faded to nothing at the radius (so a post in front of a far hill never
+//!    shades the hill: no halo), turned per pixel and blurred out. The result is already the
+//!    darkening a pixel takes: times the hour's strength, times how much of that pixel is lit by
+//!    ambient rather than by the sun ([`ambient_share`]), faded out with distance;
+//! 2. **blur** (`fs_blur_x`, `fs_blur_y`): a depth-aware 9-tap Gaussian each way, so the shade
+//!    stays on its own surface and never bleeds over an edge;
+//! 3. **apply** (`world_look.wgsl`): each full-resolution pixel takes the four nearest half-
+//!    resolution values weighted by how close their depth is to its own, then darkens the lit part
+//!    of the frame under 1.12's fog ([`darken`]), slightly cool by day, neutral at night, and less
+//!    on what is already bright (a torch's pool, a spell, the sun's glare).
+//!
+//! Every tunable is in [`tune`] but the hour's strength and coolness, which are the grade's
+//! (`grade::PostLook::ao`, `ao_cool`). `worldAO 0` turns it off on its own ([`LookAo::on`]);
+//! `lookao <scale> [radius]` holds it at a multiple of the hour's for film.
+
+use bevy::core_pipeline::FullscreenShader;
+use bevy::prelude::*;
+use bevy::render::diagnostic::RecordDiagnostics;
+use bevy::render::render_resource::binding_types::{
+    texture_2d, texture_depth_2d, texture_depth_2d_multisampled, uniform_buffer_sized,
+};
+use bevy::render::render_resource::*;
+use bevy::render::renderer::{RenderContext, RenderDevice, RenderQueue};
+use bevy::render::texture::{CachedTexture, TextureCache};
+use bevy::render::view::{ExtractedView, Msaa, ViewDepthTexture, ViewTarget};
+
+use super::pass::{LookFrame, LookView};
+
+/// Every tunable of the ambient occlusion, in one place, but the hour's strength and coolness
+/// (the grade's `ao` and `ao_cool`). A first pass, to tune on film with `lookao`. Lengths are
+/// yards (Bevy units), shades fractions of the lit colour.
+pub mod tune {
+    /// How far from a crease the shade reaches: soft and wide at the hero's feet (a wall's foot
+    /// shades about a yard of the ground out from it), never an outline.
+    pub const RADIUS: f32 = 1.2;
+    /// The radii `lookao` takes.
+    pub const RADIUS_MIN: f32 = 0.25;
+    pub const RADIUS_MAX: f32 = 4.0;
+    /// A tap counts only past this cosine over the pixel's own surface, so the faceted terrain
+    /// and a flat wall never shade themselves.
+    pub const BIAS: f32 = 0.1;
+    /// The kernel's mean to an occlusion of 0..1: a right-angled crease (a wall's foot) averages
+    /// about 0.2 over the disk, which this lifts to about a half.
+    pub const GAIN: f32 = 2.5;
+    /// The most a pixel ever darkens, whatever the strength: a deep crease is shaded, never black.
+    pub const MAX_DARKEN: f32 = 0.55;
+    /// The shade fades out from this distance (planar eye depth) to the next, so far hills don't
+    /// grey out and the fog's own falloff takes over.
+    pub const FADE_NEAR: f32 = 40.0;
+    pub const FADE_FAR: f32 = 120.0;
+    /// The share of the shade a surface keeps when the sun lights it square on: the sun fills a
+    /// contact shadow (there are no sun shadows yet), but a wall's foot in the sun still sits on
+    /// the ground.
+    pub const DIRECT_FLOOR: f32 = 0.35;
+    /// The most full-resolution pixels the radius spans, with the camera right at a wall, so the
+    /// disk never covers the screen.
+    pub const MAX_PIXELS: f32 = 160.0;
+    /// Pixels brighter than this (gamma luma) lose their shade on the way to white: a torch's
+    /// pool, a spell's light and the sun's glare are direct light, not ambient.
+    pub const BRIGHT_KNEE: f32 = 0.7;
+    /// The shade's colour at full `ao_cool`: blue darkens least, so a day shadow reads cool; its
+    /// luminance is about 1, so coolness doesn't change how dark. `world_look.wgsl`'s `AO_COOL`
+    /// mirrors it.
+    pub const COOL: [f32; 3] = [1.05, 0.99, 0.80];
+    /// The most `lookao` scales the hour's strength by.
+    pub const SCALE_MAX: f32 = 4.0;
+    /// Below this ambient luminance the sun-to-ambient ratio stops growing (a black ambient).
+    pub const AMBIENT_FLOOR: f32 = 0.02;
+}
+
+/// The ambient occlusion's switch and the film's hold: `on` is `worldAO` (on by default, inert
+/// under the classic look), `scale` holds the strength at a multiple of the hour's
+/// (`lookao <scale>`), `radius` the kernel's reach in yards.
+#[derive(Resource, Clone, Copy, Debug, PartialEq)]
+pub struct LookAo {
+    pub on: bool,
+    pub scale: Option<f32>,
+    pub radius: Option<f32>,
+}
+
+impl Default for LookAo {
+    fn default() -> Self {
+        Self {
+            on: true,
+            scale: None,
+            radius: None,
+        }
+    }
+}
+
+impl LookAo {
+    /// The strength this frame from the hour's: none with `worldAO 0`, else the hour's times the
+    /// held scale.
+    pub fn strength(&self, hour: f32) -> f32 {
+        if self.on {
+            hour * self.scale.unwrap_or(1.0)
+        } else {
+            0.0
+        }
+    }
+
+    /// The kernel's reach, held or tuned.
+    pub fn radius(&self) -> f32 {
+        self.radius.unwrap_or(tune::RADIUS)
+    }
+
+    /// `lookao`'s arguments: a scale from 0 to [`tune::SCALE_MAX`] and an optional radius from
+    /// [`tune::RADIUS_MIN`] to [`tune::RADIUS_MAX`], or nothing (or `grade`) to follow the grade
+    /// again; `None` for anything else, which changes nothing.
+    pub fn parse(args: &str) -> Option<(Option<f32>, Option<f32>)> {
+        let mut words = args.split_whitespace();
+        let first = match words.next() {
+            None => return Some((None, None)),
+            Some(w) if w.eq_ignore_ascii_case("grade") => {
+                return words.next().is_none().then_some((None, None));
+            }
+            Some(w) => w,
+        };
+        let scale = first
+            .parse::<f32>()
+            .ok()
+            .filter(|v| (0.0..=tune::SCALE_MAX).contains(v))?;
+        let radius = match words.next() {
+            None => None,
+            Some(w) => Some(
+                w.parse::<f32>()
+                    .ok()
+                    .filter(|v| (tune::RADIUS_MIN..=tune::RADIUS_MAX).contains(v))?,
+            ),
+        };
+        words.next().is_none().then_some((Some(scale), radius))
+    }
+}
+
+/// What the occlusion needs of the frame's light besides the grade: the kernel's reach, the
+/// ambient's and the sun's luminance (the gamma `Light.dbc` colours the world is lit with), the
+/// direction the sun's light travels, and 1.12's fog pair.
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub struct AoLight {
+    pub radius: f32,
+    pub ambient_luma: f32,
+    pub diffuse_luma: f32,
+    /// The direction the sun's light travels (`WowLighting::sun_dir`), Bevy space.
+    pub light_dir: Vec3,
+    /// 1.12's linear fog on planar eye depth, yards.
+    pub fog_start: f32,
+    pub fog_end: f32,
+}
+
+/// Rec. 709 luminance of a colour.
+pub fn luma(c: [f32; 3]) -> f32 {
+    0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2]
+}
+
+/// The sun's light over the ambient's, the ratio [`ambient_share`] takes.
+pub fn sun_over_ambient(light: &AoLight) -> f32 {
+    light.diffuse_luma / light.ambient_luma.max(tune::AMBIENT_FLOOR)
+}
+
+/// How much of a surface's light is ambient, 0..1, the shade's weight: 1.12 lights a surface
+/// `albedo × (ambient + diffuse × n·l)`, so its ambient share is `1 / (1 + ratio × n·l)`
+/// (`ratio` = [`sun_over_ambient`]), lifted to at least [`tune::DIRECT_FLOOR`]. `world_ao.wgsl`
+/// mirrors it.
+pub fn ambient_share(ratio: f32, n_dot_l: f32) -> f32 {
+    let share = 1.0 / (1.0 + ratio * n_dot_l.max(0.0));
+    tune::DIRECT_FLOOR + (1.0 - tune::DIRECT_FLOOR) * share
+}
+
+fn smoothstep(e0: f32, e1: f32, x: f32) -> f32 {
+    let t = ((x - e0) / (e1 - e0)).clamp(0.0, 1.0);
+    t * t * (3.0 - 2.0 * t)
+}
+
+/// The shade's distance fade at planar eye depth `z`: 1 near, 0 from [`tune::FADE_FAR`] out.
+pub fn distance_fade(z: f32) -> f32 {
+    1.0 - smoothstep(tune::FADE_NEAR, tune::FADE_FAR, z)
+}
+
+/// One tap's occlusion: `v` from the pixel to the tap, `n` the pixel's normal (unit), `radius` the
+/// kernel's reach. How far the tap rises over the surface (the cosine past [`tune::BIAS`]), faded
+/// to 0 at the radius, so a tap on something far in front counts for nothing.
+/// `world_ao.wgsl`'s `fs_ao` sums the same; keep them in step.
+pub fn tap_occlusion(v: Vec3, n: Vec3, radius: f32) -> f32 {
+    let vv = v.length_squared();
+    let falloff = (1.0 - vv / (radius * radius)).max(0.0);
+    falloff * (v.dot(n) / (vv + 1e-6).sqrt() - tune::BIAS).max(0.0)
+}
+
+/// The kernel's taps to an occlusion of 0..1: their mean times [`tune::GAIN`].
+pub fn occlusion(taps: &[f32]) -> f32 {
+    if taps.is_empty() {
+        return 0.0;
+    }
+    (taps.iter().sum::<f32>() / taps.len() as f32 * tune::GAIN).clamp(0.0, 1.0)
+}
+
+/// How dark a pixel goes, 0..[`tune::MAX_DARKEN`]: `strength × occlusion × share × fade`.
+pub fn darkening(strength: f32, occlusion: f32, share: f32, fade: f32) -> f32 {
+    (strength * occlusion * share * fade).clamp(0.0, tune::MAX_DARKEN)
+}
+
+/// The shade applied to one gamma pixel `g` (`world_look.wgsl` runs the same; keep them in step):
+/// 1.12 fogged it `mix(lit, fog, f)` in gamma, so only the lit part `g − f·fog` is darkened, by
+/// `dark` in linear light (tinted by `cool`) and eased off the brightest pixels. A pixel under the
+/// fog's own colour (one the fog never reached: a WMO's interior fog, a particle) only darkens.
+pub fn darken(g: [f32; 3], dark: f32, cool: f32, fog: f32, fog_gamma: [f32; 3]) -> [f32; 3] {
+    let bright = 1.0 - smoothstep(tune::BRIGHT_KNEE, 1.0, luma(g));
+    std::array::from_fn(|i| {
+        let tint = 1.0 + (tune::COOL[i] - 1.0) * cool;
+        let keep = (1.0 - dark * bright * tint).clamp(0.0, 1.0).powf(1.0 / 2.2);
+        let lit = (g[i] - fog_gamma[i] * fog).max(0.0);
+        g[i] - lit * (1.0 - keep)
+    })
+}
+
+/// 1.12's fog amount at planar eye depth `z`: `GL_LINEAR` from `start` to `end`.
+pub fn fog_amount(z: f32, start: f32, end: f32) -> f32 {
+    1.0 - ((end - z) / (end - start).max(0.001)).clamp(0.0, 1.0)
+}
+
+// ---------------------------------------------------------------- render world
+
+/// The occlusion pass's uniform, `world_ao.wgsl`'s `Ao`, field for field.
+#[repr(C)]
+#[derive(Clone, Copy, Debug, Default, PartialEq, bytemuck::Pod, bytemuck::Zeroable)]
+pub struct AoUniform {
+    /// Clip space back to view space, for each tap's position.
+    pub view_from_clip: [[f32; 4]; 4],
+    /// The radius (yd), full-resolution pixels per yard at 1 yd, the bias, the gain.
+    pub kernel: [f32; 4],
+    /// The strength, the most a pixel darkens, the fade's start and end (yd).
+    pub shade: [f32; 4],
+    /// Toward the sun, view space (unit), and the sun over the ambient.
+    pub light: [f32; 4],
+    /// The floor of the ambient share, the most pixels the radius spans, 0, 0.
+    pub misc: [f32; 4],
+}
+
+impl AoUniform {
+    /// One view's uniform: `clip_from_view` its projection, `view_from_world` its inverse
+    /// transform, `height` the depth buffer's height in pixels.
+    pub fn new(
+        frame: &LookFrame,
+        clip_from_view: Mat4,
+        view_from_world: Mat4,
+        height: f32,
+    ) -> Self {
+        let light = &frame.ao;
+        let to_light = view_from_world
+            .transform_vector3(-light.light_dir)
+            .normalize_or_zero();
+        Self {
+            view_from_clip: clip_from_view.inverse().to_cols_array_2d(),
+            kernel: [
+                light.radius,
+                clip_from_view.y_axis.y * height * 0.5,
+                tune::BIAS,
+                tune::GAIN,
+            ],
+            shade: [
+                frame.post.ao,
+                tune::MAX_DARKEN,
+                tune::FADE_NEAR,
+                tune::FADE_FAR,
+            ],
+            light: to_light.extend(sun_over_ambient(light)).to_array(),
+            misc: [tune::DIRECT_FLOOR, tune::MAX_PIXELS, 0.0, 0.0],
+        }
+    }
+}
+
+const UNIFORM_BYTES: u64 = std::mem::size_of::<AoUniform>() as u64;
+
+/// The occlusion's half-resolution target: the shade in red, the pixel's planar eye depth in
+/// green, for the depth-aware blur and the upsample.
+pub(crate) const AO_FORMAT: TextureFormat = TextureFormat::Rg16Float;
+
+/// The three passes, each its own pipeline.
+#[derive(Clone, Copy, PartialEq, Eq, Hash, Debug)]
+pub(crate) enum AoStage {
+    Occlusion,
+    BlurX,
+    BlurY,
+}
+
+#[derive(Clone, Copy, PartialEq, Eq, Hash, Debug)]
+pub(crate) struct AoKey {
+    stage: AoStage,
+    /// The view's depth buffer is multisampled (`gxMultisample`): the occlusion reads sample 0.
+    msaa: bool,
+}
+
+fn shader_defs(msaa: bool) -> Vec<bevy::shader::ShaderDefVal> {
+    if msaa {
+        vec!["MSAA".into()]
+    } else {
+        vec![]
+    }
+}
+
+/// Every def set `world_ao.wgsl` is specialised on, for the app's shader translation test.
+pub fn shader_def_sets() -> Vec<Vec<bevy::shader::ShaderDefVal>> {
+    vec![shader_defs(false), shader_defs(true)]
+}
+
+#[derive(Resource)]
+pub(crate) struct AoPipeline {
+    occlusion: BindGroupLayoutDescriptor,
+    occlusion_msaa: BindGroupLayoutDescriptor,
+    blur: BindGroupLayoutDescriptor,
+    shader: Handle<Shader>,
+    fullscreen: FullscreenShader,
+    /// A 1×1 target of zeros (no shade, no depth) the look pass binds when there is no occlusion.
+    pub(crate) empty: TextureView,
+}
+
+impl AoPipeline {
+    fn layout(&self, key: AoKey) -> &BindGroupLayoutDescriptor {
+        match (key.stage, key.msaa) {
+            (AoStage::Occlusion, false) => &self.occlusion,
+            (AoStage::Occlusion, true) => &self.occlusion_msaa,
+            _ => &self.blur,
+        }
+    }
+}
+
+impl SpecializedRenderPipeline for AoPipeline {
+    type Key = AoKey;
+
+    fn specialize(&self, key: Self::Key) -> RenderPipelineDescriptor {
+        let (label, entry) = match key.stage {
+            AoStage::Occlusion => ("world_ao", "fs_ao"),
+            AoStage::BlurX => ("world_ao_blur_x", "fs_blur_x"),
+            AoStage::BlurY => ("world_ao_blur_y", "fs_blur_y"),
+        };
+        RenderPipelineDescriptor {
+            label: Some(label.into()),
+            layout: vec![self.layout(key).clone()],
+            vertex: self.fullscreen.to_vertex_state(),
+            fragment: Some(FragmentState {
+                shader: self.shader.clone(),
+                shader_defs: shader_defs(key.msaa && key.stage == AoStage::Occlusion),
+                entry_point: Some(entry.into()),
+                targets: vec![Some(ColorTargetState {
+                    format: AO_FORMAT,
+                    blend: None,
+                    write_mask: ColorWrites::ALL,
+                })],
+            }),
+            ..default()
+        }
+    }
+}
+
+pub(crate) fn init_pipeline(
+    mut commands: Commands,
+    device: Res<RenderDevice>,
+    fullscreen: Res<FullscreenShader>,
+    asset_server: Res<AssetServer>,
+) {
+    // Every read is a `textureLoad`: no sampler. The blur's source sits at binding 2, apart from
+    // the occlusion's depth and uniform, so one shader file holds all three entry points.
+    let occlusion = |label: &'static str, depth: BindGroupLayoutEntryBuilder| {
+        BindGroupLayoutDescriptor::new(
+            label,
+            &BindGroupLayoutEntries::sequential(
+                ShaderStages::FRAGMENT,
+                (
+                    depth,
+                    uniform_buffer_sized(false, std::num::NonZero::new(UNIFORM_BYTES)),
+                ),
+            ),
+        )
+    };
+    let blur = BindGroupLayoutDescriptor::new(
+        "world_ao_blur_layout",
+        &BindGroupLayoutEntries::with_indices(
+            ShaderStages::FRAGMENT,
+            ((
+                2,
+                texture_2d(TextureSampleType::Float { filterable: false }),
+            ),),
+        ),
+    );
+    // Created zeroed, never written: no shade.
+    let empty = device
+        .create_texture(&TextureDescriptor {
+            label: Some("world_ao_empty"),
+            size: Extent3d {
+                width: 1,
+                height: 1,
+                depth_or_array_layers: 1,
+            },
+            mip_level_count: 1,
+            sample_count: 1,
+            dimension: TextureDimension::D2,
+            format: AO_FORMAT,
+            usage: TextureUsages::TEXTURE_BINDING,
+            view_formats: &[],
+        })
+        .create_view(&TextureViewDescriptor::default());
+    commands.insert_resource(AoPipeline {
+        occlusion: occlusion("world_ao_layout", texture_depth_2d()),
+        occlusion_msaa: occlusion("world_ao_layout_msaa", texture_depth_2d_multisampled()),
+        blur,
+        shader: asset_server.load("embedded://benilla_world/shaders/world_ao.wgsl"),
+        fullscreen: fullscreen.clone(),
+        empty,
+    });
+}
+
+/// One look view's occlusion: its three pipelines, its uniform, and this frame's two
+/// half-resolution targets (none while the occlusion is off).
+#[derive(Component)]
+pub(crate) struct LookAoGpu {
+    pipelines: [CachedRenderPipelineId; 3],
+    msaa: bool,
+    uniform: Buffer,
+    targets: Option<[CachedTexture; 2]>,
+}
+
+/// Whether the occlusion runs this frame: the new look on, with some strength.
+pub(crate) fn wanted(frame: &LookFrame) -> bool {
+    frame.on && frame.post.ao > 0.0 && frame.ao.radius > 0.0
+}
+
+pub(crate) fn prepare_ao_views(
+    mut commands: Commands,
+    device: Res<RenderDevice>,
+    cache: Res<PipelineCache>,
+    pipeline: Res<AoPipeline>,
+    mut pipelines: ResMut<SpecializedRenderPipelines<AoPipeline>>,
+    mut textures: ResMut<TextureCache>,
+    frame: Res<LookFrame>,
+    views: Query<(Entity, &ViewTarget, &Msaa, Option<&LookAoGpu>), With<LookView>>,
+) {
+    let want = wanted(&frame);
+    for (entity, target, msaa, existing) in &views {
+        let msaa = msaa.samples() > 1;
+        let (pipeline_ids, uniform) = match existing {
+            Some(gpu) if gpu.msaa == msaa => (gpu.pipelines, gpu.uniform.clone()),
+            _ => {
+                let mut id = |stage| pipelines.specialize(&cache, &pipeline, AoKey { stage, msaa });
+                (
+                    [
+                        id(AoStage::Occlusion),
+                        id(AoStage::BlurX),
+                        id(AoStage::BlurY),
+                    ],
+                    device.create_buffer(&BufferDescriptor {
+                        label: Some("world_ao_uniform"),
+                        size: UNIFORM_BYTES,
+                        usage: BufferUsages::UNIFORM | BufferUsages::COPY_DST,
+                        mapped_at_creation: false,
+                    }),
+                )
+            }
+        };
+        let targets = want.then(|| {
+            let size = target.main_texture().size();
+            let half = Extent3d {
+                width: size.width.div_ceil(2).max(1),
+                height: size.height.div_ceil(2).max(1),
+                depth_or_array_layers: 1,
+            };
+            let mut get = |label| {
+                textures.get(
+                    &device,
+                    TextureDescriptor {
+                        label: Some(label),
+                        size: half,
+                        mip_level_count: 1,
+                        sample_count: 1,
+                        dimension: TextureDimension::D2,
+                        format: AO_FORMAT,
+                        usage: TextureUsages::RENDER_ATTACHMENT | TextureUsages::TEXTURE_BINDING,
+                        view_formats: &[],
+                    },
+                )
+            };
+            [get("world_ao_a"), get("world_ao_b")]
+        });
+        commands.entity(entity).insert(LookAoGpu {
+            pipelines: pipeline_ids,
+            msaa,
+            uniform,
+            targets,
+        });
+    }
+}
+
+/// One full-screen draw into `target` from `bind`.
+fn draw(
+    render_context: &mut RenderContext,
+    label: &'static str,
+    pipeline: &RenderPipeline,
+    bind: &BindGroup,
+    target: &TextureView,
+) {
+    let diagnostics = render_context.diagnostic_recorder();
+    let mut pass = render_context
+        .command_encoder()
+        .begin_render_pass(&RenderPassDescriptor {
+            label: Some(label),
+            color_attachments: &[Some(RenderPassColorAttachment {
+                view: target,
+                depth_slice: None,
+                resolve_target: None,
+                ops: Operations {
+                    load: LoadOp::Clear(Default::default()),
+                    store: StoreOp::Store,
+                },
+            })],
+            depth_stencil_attachment: None,
+            timestamp_writes: None,
+            occlusion_query_set: None,
+        });
+    let span = diagnostics.pass_span(&mut pass, label);
+    pass.set_pipeline(pipeline);
+    pass.set_bind_group(0, bind, &[]);
+    pass.draw(0..3, 0..1);
+    span.end(&mut pass);
+}
+
+/// Runs the occlusion and its blur for one view, ahead of the look pass, and returns the target
+/// the look pass reads; `None` (the look pass then binds [`AoPipeline::empty`] and applies none)
+/// while the occlusion is off or its pipelines still compile.
+pub(crate) fn encode(
+    render_context: &mut RenderContext,
+    world: &World,
+    frame: &LookFrame,
+    view: &ExtractedView,
+    depth: &ViewDepthTexture,
+    gpu: Option<&LookAoGpu>,
+) -> Option<TextureView> {
+    let gpu = gpu?;
+    let [a, b] = gpu.targets.as_ref()?;
+    if !wanted(frame) {
+        return None;
+    }
+    let cache = world.resource::<PipelineCache>();
+    let [occlusion, blur_x, blur_y] = gpu.pipelines.map(|id| cache.get_render_pipeline(id));
+    let (occlusion, blur_x, blur_y) = (occlusion?, blur_x?, blur_y?);
+    let ao_pipeline = world.resource::<AoPipeline>();
+    let height = depth.texture.size().height as f32;
+    let uniform = AoUniform::new(
+        frame,
+        view.clip_from_view,
+        Mat4::from(view.world_from_view.affine().inverse()),
+        height,
+    );
+    world
+        .resource::<RenderQueue>()
+        .write_buffer(&gpu.uniform, 0, bytemuck::bytes_of(&uniform));
+    let device = render_context.render_device().clone();
+    let occlusion_layout = cache.get_bind_group_layout(ao_pipeline.layout(AoKey {
+        stage: AoStage::Occlusion,
+        msaa: gpu.msaa,
+    }));
+    let blur_layout = cache.get_bind_group_layout(&ao_pipeline.blur);
+    let occlusion_bind = device.create_bind_group(
+        "world_ao",
+        &occlusion_layout,
+        &BindGroupEntries::sequential((depth.view(), gpu.uniform.as_entire_binding())),
+    );
+    let blur_bind = |label, source: &TextureView| {
+        device.create_bind_group(
+            label,
+            &blur_layout,
+            &BindGroupEntries::with_indices(((2, source),)),
+        )
+    };
+    let x_bind = blur_bind("world_ao_blur_x", &a.default_view);
+    let y_bind = blur_bind("world_ao_blur_y", &b.default_view);
+    draw(
+        render_context,
+        "world_ao",
+        occlusion,
+        &occlusion_bind,
+        &a.default_view,
+    );
+    draw(
+        render_context,
+        "world_ao_blur_x",
+        blur_x,
+        &x_bind,
+        &b.default_view,
+    );
+    draw(
+        render_context,
+        "world_ao_blur_y",
+        blur_y,
+        &y_bind,
+        &a.default_view,
+    );
+    Some(a.default_view.clone())
+}
