+/// `lookao <scale> [radius]`, benilla's own (1.12 has no such command): holds the new look's
+/// contact shadows (`benilla_world::look::ao`) at a multiple of the hour's strength, 0 to 4 (0 none,
+/// 1 the grade's own, 2 twice it), and optionally their reach in yards, for tuning on film;
+/// `lookao grade`, or no argument, lets the grade decide again. `worldAO 0` and the classic look
+/// (`worldLook 0`) have none either way.
+fn look_ao(world: &mut World, args: &str) -> Vec<String> {
+    use benilla_world::look::{LookAo, WorldLook};
+    let Some((scale, radius)) = LookAo::parse(args) else {
+        return vec!["Usage: lookao <scale 0-4> [radius 0.25-4] | grade".to_string()];
+    };
+    let on = {
+        let mut ao = world.get_resource_or_init::<LookAo>();
+        ao.scale = scale;
+        ao.radius = radius;
+        ao.on
+    };
+    let mut lines = vec![match (scale, radius) {
+        (None, _) => "Ambient occlusion follows the grade.".to_string(),
+        (Some(s), None) => format!("Ambient occlusion held at {s} times the hour's."),
+        (Some(s), Some(r)) => {
+            format!("Ambient occlusion held at {s} times the hour's, {r} yd wide.")
+        }
+    }];
+    if !on {
+        lines.push("worldAO is 0: no ambient occlusion.".to_string());
+    }
+    if !world.get_resource::<WorldLook>().is_some_and(|l| l.on) {
+        lines.push("The classic look (worldLook 0) has no ambient occlusion.".to_string());
+    }
+    lines
+}
