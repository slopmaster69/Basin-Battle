+/// The water block's rows the knobs take, four a row.
+pub const TUNE_ROWS: usize = KNOBS.len().div_ceil(4);
+
+/// The knobs' values, held by `lookwater tune` (`look::LookWakes::tune`); the defaults are the
+/// surface's tuning.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct SurfaceTune(pub [f32; KNOBS.len()]);
+
+impl Default for SurfaceTune {
+    fn default() -> Self {
+        Self::DEFAULT
+    }
+}
+
+impl SurfaceTune {
+    /// Every knob at its default.
+    pub const DEFAULT: Self = {
+        let mut v = [0.0; KNOBS.len()];
+        let mut i = 0;
+        while i < KNOBS.len() {
+            v[i] = KNOBS[i].default;
+            i += 1;
+        }
+        Self(v)
+    };
+
+    /// A knob's index by its name (any case).
+    pub fn index(name: &str) -> Option<usize> {
+        KNOBS.iter().position(|k| k.name.eq_ignore_ascii_case(name))
+    }
+
+    /// The knobs packed four a row for the water block.
+    pub fn rows(&self) -> [[f32; 4]; TUNE_ROWS] {
+        let mut rows = [[0.0; 4]; TUNE_ROWS];
+        for (i, v) in self.0.iter().enumerate() {
+            rows[i / 4][i % 4] = *v;
+        }
+        rows
+    }
+
+    /// The bake's four layers' weights, multiples of [`tune::WEIGHT`]: the swells' (`coarse`)
+    /// twice, `mid` and `fine`.
+    pub fn layer_scale(&self) -> [f32; 4] {
+        let c = self.0[k::COARSE];
+        [c, c, self.0[k::MID], self.0[k::FINE]]
+    }
+
+    /// Every knob as `name value`, the ones held off their default marked.
+    pub fn line(&self) -> String {
+        KNOBS
+            .iter()
+            .zip(self.0)
+            .map(|(k, v)| {
+                if v == k.default {
+                    format!("{} {}", k.name, v)
+                } else {
+                    format!("{} {} (default {})", k.name, v, k.default)
+                }
+            })
+            .collect::<Vec<_>>()
+            .join(", ")
+    }
+}
