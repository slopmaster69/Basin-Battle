+
+    /// A swimmer stopping sends a ring on ahead of him, which still moves the water a second on
+    /// (the reference's rings after a stop show about a second; the third filming's were faint
+    /// and brief).
+    #[test]
+    fn a_stop_sends_a_ring_on() {
+        let ahead = |f: &CpuField, o: Vec2, end: Vec2| -> f32 {
+            (4..16)
+                .map(|i| {
+                    f.texel_of(o, end + Vec2::new(i as f32 * TEXEL_YD, 0.0))
+                        .map_or(0.0, |t| t[0].abs())
+                })
+                .fold(0.0f32, f32::max)
+        };
+        let (f, o, end) = run(4.72, 2.0, 1.0, 1.0, 0.0);
+        let ring = ahead(&f, o, end);
+        assert!(ring > 0.006, "a ring ahead a second on: {ring} yd");
+        let (mut recent, mut settle) = (4.7f32, 0.0f32);
+        let (push, breath) = settle_step(&mut recent, &mut settle, 0.0, 1.0 / 60.0, true);
+        assert!(push > 0.2 && breath > 4.0, "{push} {breath}");
+        let (again, _) = settle_step(&mut recent, &mut settle, 0.0, 1.0 / 60.0, true);
+        assert_eq!(again, 0.0, "one ring a stop");
+        for _ in 0..120 {
+            settle_step(&mut recent, &mut settle, 0.0, 1.0 / 60.0, true);
+        }
+        assert_eq!(settle, 0.0, "settled after {} s", tune::SETTLE_S);
+    }
+
+    /// The foam is held back as the field fills, so nothing can whiten the lake.
