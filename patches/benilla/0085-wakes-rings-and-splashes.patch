+        );
+        let shin = body_source(0.2, 4.0, swim, 1.0).unwrap();
+        let waist = body_source(1.0, 4.0, swim, 1.0).unwrap();
+        assert!(shin.push < waist.push && shin.foam < waist.foam && shin.wake < waist.wake);
+        assert_eq!(waist.wake, 1.0, "a swimmer's full V");
+        assert_eq!(waist.vel, swim);
+        assert!((waist.arm - tune::ARM_SECS * 4.0).abs() < 1e-5);
+        let still = body_source(1.0, 4.0, Vec2::ZERO, 1.0).unwrap();
+        assert_eq!((still.push, still.foam, still.wake), (0.0, 0.0, 0.0));
+        assert!(still.idle > 0.0, "a still body breathes rings");
+    }
+
+    #[test]
+    fn the_params_carry_the_frame() {
+        let frame = WakeFrame {
+            on: true,
+            reset: true,
+            pairs: 2,
+            shift: IVec2::new(3, -1),
+            sources: vec![WakeSource {
+                from: Vec2::new(1.0, 2.0),
+                to: Vec2::new(3.0, 4.0),
+                radius: 0.4,
+                ..default()
+            }],
+            ..default()
+        };
+        let p = pack_params(&frame);
+        assert_eq!(p.len(), PARAM_ROWS);
+        assert_eq!(p[0][3], 4.0, "two pairs, four steps");
+        assert_eq!(p[4][2..], [3.0, -1.0]);
+        assert_eq!(p[6][..3], [1.0, 1.0, 1.0]);
+        assert!((p[7][0] - 0.354).abs() < 1e-3, "the arms' tan at 19.5°");
+        assert_eq!(p[PARAM_HEAD_ROWS], [1.0, 2.0, 3.0, 4.0]);
+        assert_eq!(p[PARAM_HEAD_ROWS + 1][0], 0.4);
+        assert_eq!(water_row(&WakeFrame::default()), [0.0; 4]);
+    }
+
+    /// `look_wakes.wgsl`'s uniform is the packer's rows.
+    #[test]
+    fn the_shader_takes_the_packed_rows() {
+        let src = include_str!("../shaders/look_wakes.wgsl");
+        assert!(src.contains(&format!("src: array<vec4<f32>, {}>", 4 * tune::MAX_SOURCES)));
+        let rows_before_src = src
+            .split("struct WakeParams {")
+            .nth(1)
+            .unwrap()
+            .split("src:")
+            .next()
+            .unwrap()
+            .matches("vec4<f32>,")
+            .count();
+        assert_eq!(rows_before_src, PARAM_HEAD_ROWS);
+    }
+
+    #[test]
+    fn lookwater_reads_the_wake_words() {
+        use WakesCommand::*;
+        assert_eq!(LookWakes::parse("wakes 0"), Some(Ok(Wakes(Some(false)))));
+        assert_eq!(LookWakes::parse("WAKES 1"), Some(Ok(Wakes(Some(true)))));
+        assert_eq!(LookWakes::parse("wakes"), Some(Ok(Wakes(None))));
+        assert_eq!(LookWakes::parse("wakes 2"), Some(Err(())));
+        assert_eq!(
+            LookWakes::parse("refract 1.5"),
+            Some(Ok(Refract(Some(1.5))))
+        );
+        assert_eq!(LookWakes::parse("refract grade"), Some(Ok(Refract(None))));
+        assert_eq!(
+            LookWakes::parse("caustics 0"),
+            Some(Ok(Caustics(Some(0.0))))
+        );
+        assert_eq!(LookWakes::parse("caustics 3"), Some(Err(())));
+        assert_eq!(LookWakes::parse("refract"), Some(Err(())));
+        assert_eq!(LookWakes::parse("wakes 1 1"), Some(Err(())));
+        assert_eq!(LookWakes::parse("1.5"), None);
+        assert_eq!(LookWakes::parse(""), None);
+    }
+}
diff --git a/crates/benilla-world/src/look/wakes_pass.rs b/crates/benilla-world/src/look/wakes_pass.rs
new file mode 100644
index 0000000..2190cc8
--- /dev/null
+++ b/crates/benilla-world/src/look/wakes_pass.rs
@@ -0,0 +1,212 @@
+//! The new look's wakes, their render half, benilla's own (no reference behaviour): the ripple
+//! field's steps (`look_wakes.wgsl`), once a frame before any camera draws, so every view's water
+//! reads this frame's field (`look::wakes`).
+//!
+//! A step reads one field image and writes the other; steps run in pairs, so the frame's field
+//! always ends in [`WAKE_FIELD`], which the liquid material binds. The compute pass is one span,
+//! `look_wakes`, in the fps journal's `gpu_look` column and named on its `GPU_PASSES` line.
+
+use bevy::prelude::*;
+use bevy::render::diagnostic::RecordDiagnostics;
+use bevy::render::extract_resource::ExtractResourcePlugin;
+use bevy::render::render_asset::RenderAssets;
+use bevy::render::render_graph::{
+    Node, NodeRunError, RenderGraph, RenderGraphContext, RenderLabel,
+};
+use bevy::render::render_resource::binding_types::{
+    storage_buffer_sized, texture_2d, texture_storage_2d, uniform_buffer_sized,
+};
+use bevy::render::render_resource::*;
+use bevy::render::renderer::{RenderContext, RenderDevice, RenderQueue};
+use bevy::render::storage::GpuShaderStorageBuffer;
+use bevy::render::texture::GpuImage;
+use bevy::render::{Render, RenderApp, RenderStartup, RenderSystems};
+
+use benilla_assets::materials::{WAKE_FIELD, WAKE_FIELD_B};
+
+use super::wakes::{pack_params, tune, WakeFrame, WakeStatsBuffer, PARAM_ROWS};
+
+#[derive(Debug, Hash, PartialEq, Eq, Clone, RenderLabel)]
+pub(crate) struct LookWakesLabel;
+
+/// The uniform's bytes: [`PARAM_ROWS`] rows of four floats.
+const PARAM_BYTES: u64 = (PARAM_ROWS * 16) as u64;
+/// The most steps a frame runs.
+const MOST_STEPS: usize = 2 * tune::MAX_PAIRS as usize;
+/// The stats buffer: four counters.
+const STATS_BYTES: u64 = 16;
+
+#[derive(Resource)]
+struct WakePipeline {
+    layout: BindGroupLayoutDescriptor,
+    pipeline: CachedComputePipelineId,
+}
+
+/// The pass's buffers: the frame's uniform and one tiny uniform a step holding its number.
+#[derive(Resource)]
+struct WakeGpu {
+    params: Buffer,
+    steps: Vec<Buffer>,
+}
+
+fn init_pipeline(
+    mut commands: Commands,
+    cache: Res<PipelineCache>,
+    asset_server: Res<AssetServer>,
+    device: Res<RenderDevice>,
+) {
+    let layout = BindGroupLayoutDescriptor::new(
+        "look_wakes_layout",
+        &BindGroupLayoutEntries::sequential(
+            ShaderStages::COMPUTE,
+            (
+                texture_2d(TextureSampleType::Float { filterable: false }),
+                texture_storage_2d(TextureFormat::Rgba16Float, StorageTextureAccess::WriteOnly),
+                uniform_buffer_sized(false, std::num::NonZero::new(PARAM_BYTES)),
+                uniform_buffer_sized(false, std::num::NonZero::new(16)),
+                storage_buffer_sized(false, std::num::NonZero::new(STATS_BYTES)),
+            ),
+        ),
+    );
+    let pipeline = cache.queue_compute_pipeline(ComputePipelineDescriptor {
+        label: Some("look_wakes".into()),
+        layout: vec![layout.clone()],
+        push_constant_ranges: vec![],
+        shader: asset_server.load("embedded://benilla_world/shaders/look_wakes.wgsl"),
+        shader_defs: vec![],
+        entry_point: Some("step_field".into()),
+        zero_initialize_workgroup_memory: false,
+    });
+    commands.insert_resource(WakePipeline { layout, pipeline });
+    let params = device.create_buffer(&BufferDescriptor {
+        label: Some("look_wakes_params"),
+        size: PARAM_BYTES,
+        usage: BufferUsages::UNIFORM | BufferUsages::COPY_DST,
+        mapped_at_creation: false,
+    });
+    let steps = (0..MOST_STEPS as u32)
+        .map(|k| {
+            device.create_buffer_with_data(&BufferInitDescriptor {
+                label: Some("look_wakes_step"),
+                contents: bytemuck::cast_slice(&[k, 0, 0, 0]),
+                usage: BufferUsages::UNIFORM,
+            })
+        })
+        .collect();
+    commands.insert_resource(WakeGpu { params, steps });
+}
+
+/// Render world, in `PrepareResources`: the frame's uniform, while the field steps.
+fn upload_params(
+    queue: Res<RenderQueue>,
+    gpu: Option<Res<WakeGpu>>,
+    frame: Option<Res<WakeFrame>>,
+) {
+    let (Some(gpu), Some(frame)) = (gpu, frame) else {
+        return;
+    };
+    if !frame.on || frame.pairs == 0 {
+        return;
+    }
+    queue.write_buffer(&gpu.params, 0, bytemuck::cast_slice(&pack_params(&frame)));
+}
+
+#[derive(Default)]
+struct LookWakesNode;
+
+impl Node for LookWakesNode {
+    fn run<'w>(
+        &self,
+        _graph: &mut RenderGraphContext,
+        render_context: &mut RenderContext<'w>,
+        world: &'w World,
+    ) -> Result<(), NodeRunError> {
+        let Some(frame) = world.get_resource::<WakeFrame>() else {
+            return Ok(());
+        };
+        if !frame.on || frame.pairs == 0 {
+            return Ok(());
+        }
+        let (Some(pipe), Some(gpu), Some(stats)) = (
+            world.get_resource::<WakePipeline>(),
+            world.get_resource::<WakeGpu>(),
+            world.get_resource::<WakeStatsBuffer>(),
+        ) else {
+            return Ok(());
+        };
+        let cache = world.resource::<PipelineCache>();
+        let Some(pipeline) = cache.get_compute_pipeline(pipe.pipeline) else {
+            return Ok(()); // still compiling
+        };
+        let images = world.resource::<RenderAssets<GpuImage>>();
+        let (Some(a), Some(b)) = (images.get(&WAKE_FIELD), images.get(&WAKE_FIELD_B)) else {
+            return Ok(());
+        };
+        let Some(stats) = world
+            .resource::<RenderAssets<GpuShaderStorageBuffer>>()
+            .get(&stats.0)
+        else {
+            return Ok(());
+        };
+        let layout = cache.get_bind_group_layout(&pipe.layout);
+        let steps = (2 * frame.pairs as usize).min(MOST_STEPS);
+        let groups: Vec<BindGroup> = (0..steps)
+            .map(|k| {
+                let (from, to) = if k % 2 == 0 { (a, b) } else { (b, a) };
+                render_context.render_device().create_bind_group(
+                    "look_wakes",
+                    &layout,
+                    &BindGroupEntries::sequential((
+                        &from.texture_view,
+                        &to.texture_view,
+                        gpu.params.as_entire_binding(),
+                        gpu.steps[k].as_entire_binding(),
+                        stats.buffer.as_entire_binding(),
+                    )),
+                )
+            })
+            .collect();
+        let diagnostics = render_context.diagnostic_recorder();
+        let encoder = render_context.command_encoder();
+        encoder.clear_buffer(&stats.buffer, 0, None);
+        let mut pass = encoder.begin_compute_pass(&ComputePassDescriptor {
+            label: Some("look_wakes"),
+            timestamp_writes: None,
+        });
+        let span = diagnostics.pass_span(&mut pass, "look_wakes");
+        pass.set_pipeline(pipeline);
+        let groups_a_side = tune::GRID.div_ceil(8);
+        for group in &groups {
+            pass.set_bind_group(0, group, &[]);
+            pass.dispatch_workgroups(groups_a_side, groups_a_side, 1);
+        }
+        span.end(&mut pass);
+        Ok(())
+    }
+}
+
+/// The main-world half: the frame's and the stats buffer's extracts; the render half in
+/// [`finish`].
+pub(super) fn build(app: &mut App) {
+    app.add_plugins((
+        ExtractResourcePlugin::<WakeFrame>::default(),
+        ExtractResourcePlugin::<WakeStatsBuffer>::default(),
+    ));
+}
+
+/// The render half, once the render app exists: the pipeline, the upload, and the steps ahead of
+/// every camera.
+pub(super) fn finish(app: &mut App) {
+    let Some(render_app) = app.get_sub_app_mut(RenderApp) else {
+        return;
+    };
+    render_app
+        .add_systems(RenderStartup, init_pipeline)
+        .add_systems(
+            Render,
+            upload_params.in_set(RenderSystems::PrepareResources),
+        );
+    let mut graph = render_app.world_mut().resource_mut::<RenderGraph>();
+    graph.add_node(LookWakesLabel, LookWakesNode);
+    graph.add_node_edge(LookWakesLabel, bevy::render::graph::CameraDriverLabel);
+}
