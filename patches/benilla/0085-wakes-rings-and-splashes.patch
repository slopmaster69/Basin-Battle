+/// A fishing bobber (`GAMEOBJECT_TYPE_FISHINGNODE`, 17) as the world knows it
+/// ([`benilla_world::world_unit::Bobber`]), for the new look's wakes on the water round it.
+type BobberCandidate = (
+    Changed<crate::net::ObjectStore>,
+    Without<benilla_world::world_unit::Bobber>,
+);
+
+fn mark_bobbers(
+    mut commands: Commands,
+    objects: Query<(Entity, &NetEntity, &crate::net::ObjectStore), BobberCandidate>,
+) {
+    for (entity, net, store) in &objects {
+        if net.kind == EntityKind::GameObject
+            && store.0.gameobject_type_id() == crate::target::cursor_mode::GO_TYPE_FISHINGNODE
+        {
+            commands
+                .entity(entity)
+                .insert(benilla_world::world_unit::Bobber);
+        }
+    }
+}
