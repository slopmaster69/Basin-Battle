+        // Looking toward −Z: the centre is AHEAD of the span ahead, within a texel.
+        assert!((centre.x - 10.0).abs() <= TEXEL_YD);
+        assert!((centre.y - (10.0 - tune::AHEAD * tune::SPAN_YD)).abs() <= TEXEL_YD);
+        // With a body of our own, centred on it.
+        let own = field_cell(
+            Vec3::new(10.0, 50.0, 10.0),
+            fwd,
+            Some(Vec3::new(-3.0, 1.0, 4.0)),
