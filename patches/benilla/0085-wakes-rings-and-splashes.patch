+        assert_eq!(t.layer_scale(), [1.0, 1.0, 0.25, 1.0]);
+        assert_eq!(rows[k::MID / 4][k::MID % 4], 0.25);
+        // The rows a drift and the knobs give the block, and the knobs' weights the bake's.
+        let all = rows_of(&t);
