+        let lines = run(&mut app, "lookwater wakes 0");
+        assert_eq!(
+            lines,
+            ["Wakes off: 1.12's wade rings and the old froth instead."]
+        );
+        assert!(!held(&mut app).on);
+        let lines = run(&mut app, "lookwater wakes 1");
+        assert_eq!(
+            lines[0],
+            "Wakes on: the water answers what moves through it."
+        );
+        assert!(
+            lines[1].starts_with("Wakes: 0 pushing, field 256x256 over 64 yd"),
+            "{lines:?}"
+        );
+        assert!(held(&mut app).on);
+        assert_eq!(run(&mut app, "lookwater wakes")[0], "Wakes on.");
+        assert_eq!(
+            run(&mut app, "lookwater refract 0.5")[0],
+            "The bed's bend held at 0.5 times its own."
+        );
+        assert_eq!(held(&mut app).refract, Some(0.5));
+        assert_eq!(
+            run(&mut app, "lookwater caustics 2")[0],
+            "The light on the bed held at 2 times its own."
+        );
+        assert_eq!(
+            run(&mut app, "lookwater caustics 9"),
+            [format!("Usage: lookwater {LOOK_WATER_USAGE}")]
+        );
+        assert_eq!(
+            held(&mut app).caustics,
+            Some(2.0),
+            "a bad value changes nothing"
+        );
+        assert_eq!(
+            run(&mut app, "lookwater refract grade")[0],
+            "The bed's bend at its tuning."
+        );
+        assert_eq!(held(&mut app).refract, None);
