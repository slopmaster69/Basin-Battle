+/// `lookwater tune`'s words: `tune` alone (print them all), `tune grade` (all to their
+/// defaults), `tune <name>` (one's value and what it holds), `tune <name> <value|grade>`;
+/// `tune milk <value|grade>` sets the three milk strengths ([`k::MILK_ALL`]) together, as the
+/// eighth round's one `milk` did, and `tune milk` alone prints them all.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum TuneCommand {
+    Show,
+    Reset,
+    Read(usize),
+    Set(usize, Option<f32>),
+    SetMilk(Option<f32>),
+}
+
+impl TuneCommand {
+    /// The words after `tune`; `Err` names what is wrong.
+    pub fn parse(words: &[&str]) -> Result<Self, String> {
+        match words {
+            [] => Ok(Self::Show),
+            [w] if w.eq_ignore_ascii_case("grade") => Ok(Self::Reset),
+            [w, rest @ ..] if w.eq_ignore_ascii_case("milk") => match rest {
+                [] => Ok(Self::Show),
+                [v] if v.eq_ignore_ascii_case("grade") => Ok(Self::SetMilk(None)),
+                [v] => v
+                    .parse::<f32>()
+                    .ok()
+                    .filter(|x| (0.0..=1.0).contains(x))
+                    .map(|x| Self::SetMilk(Some(x)))
+                    .ok_or_else(|| "milk takes 0 to 1.".to_string()),
+                _ => Err("tune <name> <value>".to_string()),
+            },
+            [name, rest @ ..] => {
+                let i = SurfaceTune::index(name).ok_or_else(|| {
+                    let names: Vec<&str> = KNOBS.iter().map(|k| k.name).collect();
+                    format!("No knob {name}; the knobs: {}.", names.join(", "))
+                })?;
+                match rest {
+                    [] => Ok(Self::Read(i)),
+                    [v] if v.eq_ignore_ascii_case("grade") => Ok(Self::Set(i, None)),
+                    [v] => {
+                        let (lo, hi) = KNOBS[i].range;
+                        v.parse::<f32>()
+                            .ok()
+                            .filter(|x| (lo..=hi).contains(x))
+                            .map(|x| Self::Set(i, Some(x)))
+                            .ok_or_else(|| format!("{} takes {lo} to {hi}.", KNOBS[i].name))
+                    }
+                    _ => Err("tune <name> <value>".to_string()),
+                }
+            }
+        }
+    }
+}
