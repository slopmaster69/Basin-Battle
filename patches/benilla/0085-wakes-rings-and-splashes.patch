+    /// The wake fades: half a second after the swimmer stops the arms are still there, a second
+    /// and a half after little foam is left; and the field never grows.
+    #[test]
+    fn the_wake_fades_and_the_field_stays_calm() {
+        let count = |f: &CpuField| f.texels.iter().filter(|t| t[2] > 0.3).count();
+        let (moving, _, _) = run(4.72, 2.0, 0.0, 1.0, 0.0);
+        let (half, _, _) = run(4.72, 2.0, 0.5, 1.0, 0.0);
+        let (gone, _, _) = run(4.72, 2.0, 1.5, 1.0, 0.0);
+        let (had, mid, left) = (count(&moving), count(&half), count(&gone));
+        assert!(had > 100, "{had} foamy texels while he swims");
+        assert!(mid > had / 4 && mid < had, "fading: {had} then {mid}");
+        assert!(left < had / 20, "{left} foamy texels left of {had}");
+        let most = gone
+            .texels
+            .iter()
+            .map(|t| t[0].abs())
+            .fold(0.0f32, f32::max);
+        assert!(most < 0.2, "the field stays small: {most} yd");
+    }
