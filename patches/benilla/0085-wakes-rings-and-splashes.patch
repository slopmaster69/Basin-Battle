+/// The swim speed `probemove` runs at before the server has given ours (1.12's, 4.72 yd/s).
+const PROBE_SWIM_SPEED: f32 = 4.722_222;
+
+/// The visual check's held movement (`probemove`, [`super::state::ProbeMove`]): from its first
+/// frame it turns the body to its facing, if it names one, and holds its keys for its seconds, in
+/// the water too (unlike a dash); a root ends it.
+fn probe_move(player: &mut Player, axes: &mut input::MoveAxes, now: f32, may_translate: bool) {
+    let Some(mut m) = player.probe_move else { return };
+    if m.until.is_none() {
+        m.until = Some(now + m.secs);
+        if let Some(f) = m.facing {
+            player.face_yaw = crate::creature_anim::wrap_pi(f);
+        }
+        player.probe_move = Some(m);
+    }
+    if m.until.is_some_and(|u| now >= u) || !may_translate {
+        player.probe_move = None;
+        return;
+    }
+    axes.fwd = m.fwd;
+    axes.side = m.side;
+    axes.translating = true;
+    axes.strafe_left = m.side < 0;
+    axes.strafe_right = m.side > 0;
+    axes.turning = false;
+    axes.turn_left = false;
+    axes.turn_right = false;
+}
+
