+/// `liquid.wgsl`'s `surface_grain`: the fine grain's slope at `p` (the surface's XZ, yd) at `t`,
+/// a pixel spanning `fp` yd, wavelength `yd`, drifting `speed` yd/s (`grain_speed`): root mean
+/// square about 1 where it is not faded. Its drift is `t` times the speed, so a change of
+/// `grain_speed` moves the grain once, then it drifts on.
+pub fn grain_at(p: Vec2, t: f32, fp: f32, yd: f32, speed: f32) -> Vec2 {
+    let tile = tune::TILE_YD;
+    let q = p - tile * (p / tile).floor();
+    let mut g = Vec2::ZERO;
+    let mut w2 = 0.0;
+    for o in 0..2 {
+        let wl = yd * if o == 0 { 1.0 } else { tune::GRAIN_SECOND };
+        let cells = (tile / wl).round().max(1.0);
+        let fade = 1.0 - smooth(tune::GRAIN_FADE[0] * wl, tune::GRAIN_FADE[1] * wl, fp);
+        let w = tune::GRAIN_WEIGHT[o];
+        w2 += w * w;
+        if fade <= 0.0 {
+            continue;
+        }
+        let way = Vec2::from(tune::GRAIN_DIR[o]);
+        // The drift as a share of the tile, wrapped, so the pattern slides without a jump.
+        let pace = speed * tune::GRAIN_SPEED_SHARE[o];
+        let shift = ((way * (t * pace / tile)).fract_gl()) * cells;
+        let n = surface_noise(q / tile * cells - shift, cells as i32, 4 + o as u32);
+        g += Vec2::new(n.y, n.z) * (w * fade);
+    }
+    g / (tune::NOISE_RMS * std::f32::consts::SQRT_2 * w2.sqrt())
+}
+
+/// `liquid.wgsl`'s `surface_milk`: the milky veil's strength at `depth` yd under the knobs,
+/// `milk_shallow` to [`tune::MILK_AT_YD`]'s first depth, `milk_mid` at its second, `milk_deep`
+/// from its third, turning smoothly between (before `milk_depth`'s hold off the first yard).
+pub fn milk_at(depth: f32, knobs: &SurfaceTune) -> f32 {
+    let [a, b, c] = tune::MILK_AT_YD;
+    let v = &knobs.0;
+    let near = v[k::MILK_SHALLOW] + (v[k::MILK_MID] - v[k::MILK_SHALLOW]) * smooth(a, b, depth);
+    near + (v[k::MILK_DEEP] - near) * smooth(b, c, depth)
+}
+
+fn smooth(a: f32, b: f32, x: f32) -> f32 {
+    let t = ((x - a) / (b - a)).clamp(0.0, 1.0);
+    t * t * (3.0 - 2.0 * t)
+}
+
+/// The bake's uniform: two rows of the four layers' offsets (cells), one of
+/// `[texels a side, tile (yd), 0, 0]` and one of the layers' weights, multiples of
+/// [`tune::WEIGHT`] (`lookwater tune coarse|mid|fine`, [`SurfaceTune::layer_scale`]).
+const PARAM_BYTES: u64 = 4 * 16;
+
+/// The four layers' drift, in cells, each modulo its layer's cells across the tile.
+#[derive(Resource, Clone, Copy, Debug, PartialEq, Default)]
+pub struct SurfaceDrift {
+    pub offsets: [DVec2; 4],
+}
+
+/// How fast the drift runs for a wind of `strength` (`look::wind`'s row 0 `.z`).
+pub fn drift_pace(strength: f32) -> f32 {
+    let t = (strength / 1.5).clamp(0.0, 1.0);
+    tune::DRIFT_CALM + (tune::DRIFT_GUSTY - tune::DRIFT_CALM) * t
+}
+
+/// Steps the drift `dt` seconds along `downwind` (Bevy x, z; zero for no wind) at `pace`: each
+/// layer slides along its own turn off downwind at its own speed, kept in whole cells modulo its
+/// cells across the tile, so the bake's wrap never jumps.
+pub fn advance(drift: &mut SurfaceDrift, downwind: Vec2, pace: f32, dt: f32) {
+    let dir = if downwind.length_squared() > 1.0e-6 {
+        downwind.normalize()
+    } else {
+        Vec2::from(tune::STILL_DIR).normalize()
+    };
+    for (i, off) in drift.offsets.iter_mut().enumerate() {
+        let way = Vec2::from_angle(tune::TURN_DEG[i].to_radians()).rotate(dir);
+        let cells = f64::from(tune::CELLS[i]);
+        let step = way.as_dvec2()
+            * f64::from(tune::SPEED_YD[i] * pace * dt)
+            * (cells / f64::from(tune::TILE_YD));
+        // The pattern moves downwind: what stood at p stands at p + v·t, so the offset falls.
+        *off = DVec2::new(
+            (off.x - step.x).rem_euclid(cells),
+            (off.y - step.y).rem_euclid(cells),
+        );
+    }
+}
+
+/// The surface's rows of the water block (`look::water::SURFACE_ROW` on).
+pub const ROWS: usize = 3 + TUNE_ROWS;
+
+/// The water block's surface rows (`look::water::SURFACE_ROW` on): the four offsets, then
+/// `[on, tile (yd), texels a side, show]` (`show` the film's view of the water's inputs), then
+/// the knobs ([`SurfaceTune::rows`]).
+pub fn rows(drift: &SurfaceDrift, show: u8, knobs: &SurfaceTune) -> [[f32; 4]; ROWS] {
+    let o = drift.offsets.map(|v| v.as_vec2());
+    let mut rows = [[0.0; 4]; ROWS];
+    rows[0] = [o[0].x, o[0].y, o[1].x, o[1].y];
+    rows[1] = [o[2].x, o[2].y, o[3].x, o[3].y];
+    rows[2] = [1.0, tune::TILE_YD, tune::MAP as f32, f32::from(show)];
+    rows[3..].copy_from_slice(&knobs.rows());
+    rows
+}
+
+/// Steps the drift each frame while the wakes run, from the wind's block; a deterministic run's
+/// surface holds still.
+pub(crate) fn drift_surface(
+    time: Res<Time>,
+    wind: Option<Res<super::WindFrame>>,
+    frame: Option<Res<super::WakeFrame>>,
+    mut drift: ResMut<SurfaceDrift>,
+) {
+    if !frame.is_some_and(|f| f.on) || crate::dev_state::deterministic_run() {
+        return;
+    }
+    let (dir, strength) = match wind.as_deref() {
+        Some(w) if w.on => (Vec2::new(w.rows[0][0], w.rows[0][1]), w.rows[0][2]),
+        _ => (Vec2::ZERO, 0.0),
+    };
+    advance(&mut drift, dir, drift_pace(strength), time.delta_secs());
+}
+
+// ---- The bake and the read on the CPU (`look_water_surface.wgsl`, `liquid.wgsl`; keep in sync),
+// for the tests.
+
+/// `look_water_surface.wgsl`'s `surface_hash`: a lattice point of layer `layer`, wrapped to
+/// `period` cells, to a unit gradient's angle (0 to 1 of a turn).
+pub fn surface_hash(c: IVec2, period: i32, layer: u32) -> f32 {
+    let w = IVec2::new(c.x.rem_euclid(period), c.y.rem_euclid(period));
+    let mut h = (w.x as u32)
+        .wrapping_mul(374_761_393)
+        .wrapping_add((w.y as u32).wrapping_mul(668_265_263))
+        .wrapping_add(layer.wrapping_mul(2_246_822_519));
+    h = (h ^ (h >> 13)).wrapping_mul(1_274_126_177);
+    h ^= h >> 16;
+    h as f32 * (1.0 / 4_294_967_296.0)
+}
+
+fn lattice_grad(c: IVec2, period: i32, layer: u32) -> Vec2 {
+    Vec2::from_angle(std::f32::consts::TAU * surface_hash(c, period, layer))
+}
+
+/// `look_water_surface.wgsl`'s `surface_noise`: gradient noise at `p` (cells), periodic over
+/// `period` cells, and its slope per cell, `(value, d/dx, d/dy)`; quintic, so the slope is smooth.
+pub fn surface_noise(p: Vec2, period: i32, layer: u32) -> Vec3 {
+    let i = p.floor();
+    let f = p - i;
+    let c = i.as_ivec2();
+    let ga = lattice_grad(c, period, layer);
+    let gb = lattice_grad(c + IVec2::X, period, layer);
+    let gc = lattice_grad(c + IVec2::Y, period, layer);
+    let gd = lattice_grad(c + IVec2::ONE, period, layer);
+    let va = ga.dot(f);
+    let vb = gb.dot(f - Vec2::X);
+    let vc = gc.dot(f - Vec2::Y);
+    let vd = gd.dot(f - Vec2::ONE);
+    let u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
+    let du = 30.0 * f * f * (f * (f - 2.0) + 1.0);
+    let k = va - vb - vc + vd;
+    let value = va + u.x * (vb - va) + u.y * (vc - va) + u.x * u.y * k;
+    let d = ga
+        + u.x * (gb - ga)
+        + u.y * (gc - ga)
+        + u.x * u.y * (ga - gb - gc + gd)
+        + du * (Vec2::new(u.y, u.x) * k + Vec2::new(vb - va, vc - va));
+    Vec3::new(value, d.x, d.y)
+}
+
+/// The bake's scale: the four layers' slope together has a root mean square of 1.
+pub fn norm() -> f32 {
+    let w2: f32 = tune::WEIGHT.iter().map(|w| w * w).sum();
+    1.0 / (tune::NOISE_RMS * std::f32::consts::SQRT_2 * w2.sqrt())
+}
+
+/// One texel of the bake at `uv` (0 to 1 across the tile) under `drift`, at the knobs' default
+/// weights: the long pair's slope (x, z) and the short pair's, each per cell of its own layer,
+/// weighted and scaled by [`norm`].
+pub fn bake_at(uv: Vec2, drift: &SurfaceDrift) -> Vec4 {
+    bake_with(uv, drift, SurfaceTune::default().layer_scale())
+}
+
+/// [`bake_at`] with the layers' weights at `scale` times [`tune::WEIGHT`] ([`norm`] stays the
+/// tuned weights', so a knob turned down takes its layer's slope away).
+pub fn bake_with(uv: Vec2, drift: &SurfaceDrift, scale: [f32; 4]) -> Vec4 {
+    let mut out = [Vec2::ZERO; 2];
+    for i in 0..4 {
+        let cells = tune::CELLS[i] as f32;
+        let p = uv * cells + drift.offsets[i].as_vec2();
+        let n = surface_noise(p, tune::CELLS[i] as i32, i as u32);
+        out[i / 2] += Vec2::new(n.y, n.z) * (tune::WEIGHT[i] * scale[i]);
+    }
+    let k = norm();
+    Vec4::new(out[0].x, out[0].y, out[1].x, out[1].y) * k
+}
+
+/// `liquid.wgsl`'s `surface_fades`: how much of the long pair and of the short pair a pixel
+/// spanning `fp` yards keeps, and the slope's variance (as a share of the whole) that their fade
+/// leaves out, for the highlight's roughness.
+pub fn fades(fp: f32) -> (f32, f32, f32) {
+    let ss = |a: f32, b: f32, x: f32| {
+        let t = ((x - a) / (b - a)).clamp(0.0, 1.0);
+        t * t * (3.0 - 2.0 * t)
+    };
+    let coarse = 1.0 - ss(tune::COARSE_FADE_YD[0], tune::COARSE_FADE_YD[1], fp);
+    let fine = 1.0 - ss(tune::FINE_FADE_YD[0], tune::FINE_FADE_YD[1], fp);
+    let w2: f32 = tune::WEIGHT.iter().map(|w| w * w).sum();
+    let share_c = (tune::WEIGHT[0].powi(2) + tune::WEIGHT[1].powi(2)) / w2;
+    let lost = share_c * (1.0 - coarse * coarse) + (1.0 - share_c) * (1.0 - fine * fine);
+    (coarse, fine, lost)
+}
+
+/// `liquid.wgsl`'s highlight sharpness off the surface where the fades leave `lost` of a slope
+/// of root mean square `s`: a Blinn lobe of `n` widened by the unseen wavelets' tilt, and its peak
+/// dimmed in step, so the energy stays.
+pub fn rough_lobe(n: f32, s: f32, lost: f32) -> (f32, f32) {
+    let var = 0.5 * s * s * lost;
+    let wide = n / (1.0 + n * var);
+    (wide, (wide + 2.0) / (n + 2.0))
+}
+
+// ---- The bake on the GPU.
+
+/// Inserts the surface map before any liquid material is made, so none waits on it.
+pub(crate) fn insert_surface_map(images: Option<ResMut<Assets<Image>>>) {
+    let Some(mut images) = images else { return };
+    if images.get(SURFACE_MAP.id()).is_none() {
+        let _ = images.insert(SURFACE_MAP.id(), surface_map_image(tune::MAP));
+    }
+}
+
+#[derive(Debug, Hash, PartialEq, Eq, Clone, RenderLabel)]
+pub(crate) struct LookWaterSurfaceLabel;
+
+#[derive(Resource)]
+struct SurfacePipeline {
+    layout: BindGroupLayoutDescriptor,
+    pipeline: CachedComputePipelineId,
+    params: Buffer,
+}
+
+fn init_pipeline(
+    mut commands: Commands,
+    cache: Res<PipelineCache>,
+    asset_server: Res<AssetServer>,
+    device: Res<RenderDevice>,
+) {
+    let layout = BindGroupLayoutDescriptor::new(
+        "look_water_surface_layout",
+        &BindGroupLayoutEntries::sequential(
+            ShaderStages::COMPUTE,
+            (
+                texture_storage_2d(TextureFormat::Rgba16Float, StorageTextureAccess::WriteOnly),
+                uniform_buffer_sized(false, std::num::NonZero::new(PARAM_BYTES)),
+            ),
+        ),
+    );
+    let pipeline = cache.queue_compute_pipeline(ComputePipelineDescriptor {
+        label: Some("look_water_surface".into()),
+        layout: vec![layout.clone()],
+        push_constant_ranges: vec![],
+        shader: asset_server.load("embedded://benilla_world/shaders/look_water_surface.wgsl"),
+        shader_defs: vec![],
+        entry_point: Some("bake".into()),
+        zero_initialize_workgroup_memory: false,
+    });
+    let params = device.create_buffer(&BufferDescriptor {
+        label: Some("look_water_surface_params"),
+        size: PARAM_BYTES,
+        usage: BufferUsages::UNIFORM | BufferUsages::COPY_DST,
+        mapped_at_creation: false,
+    });
+    commands.insert_resource(SurfacePipeline {
+        layout,
+        pipeline,
+        params,
+    });
+}
+
+/// The surface's rows of this frame's water block, while they are on: the offsets, and the
+/// layers' weights from the knobs.
+fn surface_rows(frame: &WaterFrame) -> Option<[[f32; 4]; 3]> {
+    let rows = &frame.rows[SURFACE_ROW..SURFACE_ROW + ROWS];
+    let mut knobs = SurfaceTune::default();
+    for (i, v) in knobs.0.iter_mut().enumerate() {
+        *v = rows[3 + i / 4][i % 4];
+    }
+    (frame.on && rows[2][0] > 0.5).then(|| [rows[0], rows[1], knobs.layer_scale()])
+}
+
+/// Render world, in `PrepareResources`: the frame's offsets, while the surface is on.
+fn upload_params(
+    queue: Res<RenderQueue>,
+    pipe: Option<Res<SurfacePipeline>>,
+    frame: Option<Res<WaterFrame>>,
+) {
+    let (Some(pipe), Some(frame)) = (pipe, frame) else {
+        return;
+    };
+    let Some(rows) = surface_rows(&frame) else {
+        return;
+    };
+    let params = [
+        rows[0],
+        rows[1],
+        [tune::MAP as f32, tune::TILE_YD, 0.0, 0.0],
+        rows[2],
+    ];
+    queue.write_buffer(&pipe.params, 0, bytemuck::cast_slice(&params));
+}
+
+#[derive(Default)]
+struct LookWaterSurfaceNode;
+
+impl Node for LookWaterSurfaceNode {
+    fn run<'w>(
+        &self,
+        _graph: &mut RenderGraphContext,
+        render_context: &mut RenderContext<'w>,
+        world: &'w World,
+    ) -> Result<(), NodeRunError> {
+        let Some(frame) = world.get_resource::<WaterFrame>() else {
+            return Ok(());
+        };
+        if surface_rows(frame).is_none() {
+            return Ok(());
+        }
+        let Some(pipe) = world.get_resource::<SurfacePipeline>() else {
+            return Ok(());
+        };
+        let cache = world.resource::<PipelineCache>();
+        let Some(pipeline) = cache.get_compute_pipeline(pipe.pipeline) else {
+            return Ok(()); // still compiling
+        };
+        let Some(map) = world.resource::<RenderAssets<GpuImage>>().get(&SURFACE_MAP) else {
+            return Ok(());
+        };
+        let layout = cache.get_bind_group_layout(&pipe.layout);
+        let group = render_context.render_device().create_bind_group(
+            "look_water_surface",
+            &layout,
+            &BindGroupEntries::sequential((&map.texture_view, pipe.params.as_entire_binding())),
+        );
+        let diagnostics = render_context.diagnostic_recorder();
+        let encoder = render_context.command_encoder();
+        let mut pass = encoder.begin_compute_pass(&ComputePassDescriptor {
+            label: Some("look_water_surface"),
+            timestamp_writes: None,
+        });
+        let span = diagnostics.pass_span(&mut pass, "look_water_surface");
+        pass.set_pipeline(pipeline);
+        pass.set_bind_group(0, &group, &[]);
+        let groups = tune::MAP.div_ceil(8);
+        pass.dispatch_workgroups(groups, groups, 1);
+        span.end(&mut pass);
+        Ok(())
+    }
+}
+
+pub(crate) fn init_resources(app: &mut App) {
+    app.init_resource::<SurfaceDrift>();
+}
+
+/// The render half, once the render app exists: the pipeline, the upload, and the bake ahead of
+/// every camera.
+pub(super) fn finish(app: &mut App) {
+    let Some(render_app) = app.get_sub_app_mut(RenderApp) else {
+        return;
+    };
+    render_app
+        .add_systems(RenderStartup, init_pipeline)
+        .add_systems(
+            Render,
+            upload_params.in_set(RenderSystems::PrepareResources),
+        );
+    let mut graph = render_app.world_mut().resource_mut::<RenderGraph>();
+    graph.add_node(LookWaterSurfaceLabel, LookWaterSurfaceNode);
+    graph.add_node_edge(
+        LookWaterSurfaceLabel,
+        bevy::render::graph::CameraDriverLabel,
+    );
+}
