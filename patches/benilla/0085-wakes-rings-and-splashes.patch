diff --git a/crates/benilla-world/src/look/wakes.rs b/crates/benilla-world/src/look/wakes.rs
new file mode 100644
index 0000000..0e3bdcd
--- /dev/null
+++ b/crates/benilla-world/src/look/wakes.rs
@@ -0,0 +1,1789 @@
+//! Wakes, the new look's own (no reference behaviour): water that answers what moves through it,
+//! as WoW Forever's lakes do. A swimmer leaves a crisp white wake fanning out behind him in a V,
+//! a hero wading in sends rings out and splashes where he steps in, a bobber sits in a small
+//! disturbance, and rain dimples the surface.
+//!
+//! 1. **The ripple field**: a square of [`tune::GRID`]² texels over [`tune::SPAN_YD`] yards round
+//!    our own body (or, with none, a little ahead of the camera, where the view falls), snapped to
+//!    whole texels so it never swims, and stepped each frame on the GPU (`look::wakes_pass`, `look_wakes.wgsl`) as a
+//!    linear shallow-water wave at fixed steps of [`tune::STEP_S`]: [`cpu_step`] is the same step
+//!    in Rust, for the tests.
+//! 2. **What pushes it** ([`publish_wakes`]): every unit whose feet are in the water (wading or
+//!    swimming, by its speed; a still one only breathes gentle rings, a stopping one sends a ring
+//!    on), a splash where one comes in (harder landing from a hop), kept in from the field's edge,
+//!    a fishing bobber ([`crate::world_unit::Bobber`]), and raindrops while it rains
+//!    (`look::weather`); the nearest [`tune::MAX_SOURCES`] to the field.
+//! 3. **The V and its foam**: behind a moving body two arms trail from its sides at
+//!    [`tune::ARM_DEG`] either side of its track (a Kelvin wake, as a boat's or a duck's), pushing
+//!    on the water and laying foam along them; the arms' foam is carried outward as fast as the
+//!    arms move, so it stays on them as streaks, and fades over [`tune::FOAM_LIFE_S`]. Foam is
+//!    born only there, at the body's sides and as a splash's few droplets: a still body, a ring
+//!    or a raindrop never foams, and the share of the field under foam is held under
+//!    [`tune::FOAM_COVER_MOST`]; a wader's shins foam not at all. `liquid.wgsl` draws it as thin
+//!    white lines along its ridges with a faint halo, and the rings as faint pale crest lines.
+//! 4. The field's slopes add to the water's own ripples, so the mirror, the glint and the
+//!    refracted bed (`liquid.wgsl`) all move with it.
+//!
+//! While the wakes are on they take the place of 0081's wading froth and of 1.12's own wade wake
+//! and rings (`water_fx`), which would draw a second, older ring over them. `lookwater wakes 0`
+//! brings both back; `worldWater 0` and `worldLook 0` run 1.12's water and foam untouched.
+
+use bevy::ecs::entity::EntityHashMap;
+use bevy::prelude::*;
+use bevy::render::extract_resource::ExtractResource;
+
+use benilla_assets::coords::bevy_to_wow;
+
+use super::{LookWater, WorldLook};
+use crate::liquid::{FoamPatch, WaterChunkInfo, WaterIndex};
+use crate::view::{Viewer, WorldCamera};
+use crate::world_unit::{Bobber, ViewerUnit, WorldUnit};
+
+/// Every tunable of the wakes, in one place. Lengths are yards, times seconds. A first pass from
+/// the reference video (a swimmer's wake in a retail pond, seen from above), to tune on film.
+pub mod tune {
+    /// The field's texels a side and the yards it spans: a quarter of a yard a texel. 320 over
+    /// 80 yd, was 256 over 64: the third filming's lake showed a straight tone edge about 28 yd
+    /// out (a world-fixed one, which shows with `lookwater wakes 0` too, so not the field's), and
+    /// a bigger field keeps its own edge further out of the view for about 0.01 ms more.
+    pub const GRID: u32 = 320;
+    pub const SPAN_YD: f32 = 80.0;
+    /// With no body of our own, the field's centre lies this far ahead of the camera along its
+    /// view on the ground, as a share of its span (16 yd). With one, it is centred on him, so
+    /// his wake is always well inside it.
+    pub const AHEAD: f32 = 0.2;
+    /// The field's edge: within [`EDGE_MARGIN_YD`] of it nothing pushes the water (the sponge
+    /// there soaks it up), and a body's push and foam grow in over the next [`EDGE_FADE_YD`];
+    /// `liquid.wgsl` fades the field's look in over the same yards (`WAKE_EDGE_MARGIN_YD`,
+    /// `WAKE_EDGE_FADE_YD`; the test compares them).
+    pub const EDGE_MARGIN_YD: f32 = 3.0;
+    pub const EDGE_FADE_YD: f32 = 4.0;
+    /// One step, fixed whatever the frame rate; steps run in pairs (the field ends each frame in
+    /// the texture the water reads), at most [`MAX_PAIRS`] a frame, so a slow frame drops time
+    /// rather than stall.
+    pub const STEP_S: f32 = 1.0 / 120.0;
+    pub const MAX_PAIRS: u32 = 3;
+    /// How fast a ring travels (yd/s). A swimmer at 4.7 yd/s outruns it, so his rings pile up
+    /// into a V about 25° either side of his track, as a boat's does.
+    pub const WAVE_SPEED: f32 = 2.0;
+    /// A ring fades to a third over [`WAVE_LIFE_S`] (2, was 1.4: the third filming's rings after
+    /// a stop were faint and brief; the reference's show about a second), and the foam over
+    /// [`FOAM_LIFE_S`]. 1.6, was 0.65 (and 0.55 before it): the second filming's wake was gone
+    /// in under a second; the reference's crisp V fades over about a second and a half.
+    pub const WAVE_LIFE_S: f32 = 2.0;
+    pub const FOAM_LIFE_S: f32 = 1.6;
+    /// The pressure a body pushes with for each yd/s it moves at (up to [`PUSH_SPEED_MOST`]),
+    /// and the gentle breathing push of one standing still, at [`IDLE_HZ`].
+    pub const PUSH: f32 = 0.15;
+    pub const PUSH_SPEED_MOST: f32 = 8.0;
+    pub const IDLE_PUSH: f32 = 0.03;
+    pub const IDLE_HZ: f32 = 1.3;
+    /// A body's radius at the waterline at model scale 1.
+    pub const RADIUS: f32 = 0.35;
+    /// A body's speed is smoothed over this long, so a position that lands in lumps (a server's
+    /// steps, a frame that skips) still reads as the steady speed it swims at.
+    pub const SPEED_SMOOTH_S: f32 = 0.12;
+    /// The foam a body churns at its sides (per second, at 4 yd/s, at most 1.5 times it). 2, was
+    /// 8: the V's arms ([`ARM_FOAM`]) carry the wake's white now, this is the churn round him.
+    pub const BODY_FOAM: f32 = 2.0;
+    /// The foam a crest makes per yd/s it rises faster than [`CREST_FROM`], on the arms only
+    /// (was everywhere, at 80: the first filming's rain whitened 91% of the lake with it).
+    pub const CREST_FOAM: f32 = 10.0;
+    /// Above a still body's breathing (its crests rise at most about 0.06 yd/s).
+    pub const CREST_FROM: f32 = 0.07;
+    /// The most foam a texel holds (2.5, was 1.5): the water draws a streak along the ridge of
+    /// the foam (`liquid.wgsl`), so it must keep a ridge rather than flatten into a plateau.
+    pub const FOAM_MOST: f32 = 2.5;
+    /// The most foam a texel takes a second, whatever pushes it.
+    pub const FOAM_IN_MOST: f32 = 12.0;
+    /// The most of the field under foam: new foam is held back from half of it and stops at it,
+    /// read back from the GPU ([`WakeStats`]), so nothing can whiten the lake.
+    pub const FOAM_COVER_MOST: f32 = 0.04;
+    /// How much faster than the water's own drift the foam is carried (was 6: it smeared the
+    /// streaks).
+    pub const DRIFT: f32 = 1.5;
+    /// The Kelvin wake (Corey's reference: a swimmer's crisp white V): behind a moving body two
+    /// arms trail from its sides at [`ARM_DEG`] either side of its track, as a boat's or a duck's
+    /// do at any speed. Each pushes on the water (a share [`ARM_PUSH`] of the body's push) and lays
+    /// foam ([`ARM_FOAM`] a second, falling off over [`ARM_FOAM_FALL`] yards back), and its foam
+    /// is carried outward as fast as the arm moves, so it stays on the arm as a streak.
+    pub const ARM_DEG: f32 = 19.5;
+    /// The arms reach back as far as the body goes in this long, at most [`ARM_MOST`] yards.
+    pub const ARM_SECS: f32 = 1.2;
+    pub const ARM_MOST: f32 = 7.0;
+    /// An arm's half-width (yd) at the body, and how much it widens a yard back. 0.1 and 0.02,
+    /// were 0.12 (0.16 before) and 0.03: the reference's streaks are narrow lines.
+    pub const ARM_WIDTH: f32 = 0.1;
+    pub const ARM_SPREAD: f32 = 0.02;
+    pub const ARM_PUSH: f32 = 0.6;
+    pub const ARM_FOAM: f32 = 20.0;
+    pub const ARM_FOAM_FALL: f32 = 3.0;
+    /// The arms' foam broken into streaks with gaps, as the reference's: a smooth noise along
+    /// the body's track over stretches of [`BREAK_YD`], cut at [`BREAK_CUT`], lays as little as
+    /// [`BREAK_LEAST`] of the foam in a gap. Foam carried outward keeps its place along the
+    /// track, so a gap stays one as the V opens.
+    pub const BREAK_YD: f32 = 0.6;
+    pub const BREAK_LEAST: f32 = 0.25;
+    pub const BREAK_CUT: f32 = 0.45;
+    /// The wake grows in from [`WAKE_FROM`] yd/s to full at [`WAKE_FULL`] (a swimmer goes 4.7): a
+    /// body drifting or turning on the spot leaves rings, not a V.
+    pub const WAKE_FROM: f32 = 0.8;
+    pub const WAKE_FULL: f32 = 3.0;
+    /// A body coming into the water: the splash's push (yd²/s, at once, per unit of the
+    /// splash's strength) sends a ring out, and it throws a few droplets about [`DROP_AT`] of its
+    /// radius from it, on [`DROP_SHARE`] of the texels there (was 0.45), each [`DROP_FOAM`] foam
+    /// per unit of strength (was 2.5). Walking in is a splash of strength about 1; one coming
+    /// down into the water (a hop's landing, a fall) splashes up to [`LAND_GAIN`] more, full at
+    /// [`LAND_SPEED`] yd/s down. The third filming's hop made only faint rings. The first
+    /// filming's splash was an opaque white disc as big as the hero.
+    pub const SPLASH: f32 = 0.12;
+    pub const DROP_SHARE: f32 = 0.22;
+    pub const DROP_AT: f32 = 2.0;
+    pub const DROP_FOAM: f32 = 1.6;
+    pub const LAND_GAIN: f32 = 1.5;
+    pub const LAND_SPEED: f32 = 6.0;
+    /// A wader's foam: the V's arms and the churn at a body's sides foam only from
+    /// [`FOAM_DEEP_FROM`] yd deep, fully from [`FOAM_DEEP_FULL`] (its rings and ripples from
+    /// [`WET_FROM`]). The third filming's walk-in drew two opaque white bars beside his shins.
+    pub const FOAM_DEEP_FROM: f32 = 0.4;
+    pub const FOAM_DEEP_FULL: f32 = 0.9;
+    /// A swimmer stopping: his bow wave runs on as a ring (a push of [`STOP_RING`] at a full
+    /// swim), and he breathes [`SETTLE`] times harder for a moment, easing off over
+    /// [`SETTLE_S`], so rings go out from where he stopped for about a second, as the
+    /// reference's. The third filming's rings after a stop were faint and brief.
+    pub const STOP_RING: f32 = 0.25;
+    pub const SETTLE: f32 = 4.0;
+    pub const SETTLE_S: f32 = 1.2;
+    /// Raindrops while it rains (a drop on this many texels a second at full rain, about two a
+    /// square yard), each this hard: rings only, never foam.
+    pub const RAIN_RATE: f32 = 0.125;
+    pub const RAIN_DROP: f32 = 0.03;
+    /// A fishing bobber: a small body nodding at this push and rate.
+    pub const BOBBER_RADIUS: f32 = 0.15;
+    pub const BOBBER_PUSH: f32 = 0.015;
+    pub const BOBBER_HZ: f32 = 0.7;
+    /// How far under the surface a bobber's origin may sit, or over it.
+    pub const BOBBER_REACH: f32 = 0.6;
+    /// The texels round the edge that soak up what reaches them.
+    pub const EDGE_TEXELS: f32 = 8.0;
+    /// The most bodies pushing at once: the nearest to the field.
+    pub const MAX_SOURCES: usize = 32;
+    /// A body counts as in the water from this deep (yd) to its gate, `max(2·height, 1)`, as 1.12's
+    /// foam; it pushes harder as it goes in, fully from [`FULL_DEPTH`].
+    pub const WET_FROM: f32 = 0.02;
+    pub const FULL_DEPTH: f32 = 0.6;
+    /// A body that jumps further than this in a frame (a teleport, a zone-in), or more than a yard
+    /// at over [`JUMP_SPEED`] yd/s (a teleport the mover spreads over a few frames), leaves no
+    /// streak, and for [`JUMP_QUIET_S`] after it pushes nothing, lays no foam and comes into the
+    /// water without a splash: the sixth filming's large white patches sat by the hero for about
+    /// 4 s after each `.es goto` (was 6 yd, and only the jump's own frame).
+    pub const JUMP_YD: f32 = 3.0;
+    pub const JUMP_SPEED: f32 = 25.0;
+    pub const JUMP_QUIET_S: f32 = 0.5;
+    /// In `liquid.wgsl`: how much the field's slopes tilt the water's normal, how much of the
+    /// water a streak hides at most ([`FOAM_SHOW`]), and where the foam shows (its value against
+    /// the streak noise, a crisp edge over [`FOAM_EDGE`]). A streak is drawn only along the
+    /// ridge of the field's foam, [`LINE_HALF`] texels either side of it (to [`LINE_HALF`] +
+    /// [`LINE_WIDE`] where the foam is thick and fresh), softening over [`LINE_SOFT`] texels, so
+    /// it is a thin line a hand's width across however far the foam has spread. Round it a faint
+    /// soft halo, at most [`FOAM_VEIL`]. The third filming's streaks were thick opaque slabs
+    /// (the foam's spread as it is carried, all drawn white, hiding all the water); now 0.7 at
+    /// most (was 1) and a fainter halo (0.12, was a veil of 0.25). The foam is near-white
+    /// ([`FOAM_WHITE`], dimmed only by how bright the light is).
+    pub const NORMAL_GAIN: f32 = 1.0;
+    pub const FOAM_SHOW: f32 = 0.7;
+    pub const FOAM_FROM: f32 = 0.5;
+    pub const FOAM_EDGE: f32 = 0.08;
+    pub const FOAM_VEIL: f32 = 0.12;
+    pub const FOAM_WHITE: [f32; 3] = [0.94, 0.96, 0.97];
+    pub const LINE_HALF: f32 = 0.35;
+    pub const LINE_WIDE: f32 = 0.3;
+    pub const LINE_SOFT: f32 = 0.5;
+    /// In `liquid.wgsl`: the rings seen from above, a faint pale line along each crest of the
+    /// field (where its height curves down by more than [`RING_FROM`] a yard per square yard,
+    /// fully by [`RING_FULL`]), at most [`RING_SHEEN`] (`WAKE_RING_*`; the test compares them),
+    /// a quarter of it in full rain. From above the mirror is all but clear, so the third
+    /// filming's rings barely showed.
+    pub const RING_SHEEN: f32 = 0.22;
+    pub const RING_FROM: f32 = 0.12;
+    pub const RING_FULL: f32 = 0.6;
+    /// Log the counts this often while something moves the water (was 10 s); each line, and each
+    /// `lookwater wakes`, also gives the most since the one before.
+    pub const LOG_EVERY_S: f32 = 5.0;
+}
+
+/// The yards a texel spans.
+pub const TEXEL_YD: f32 = tune::SPAN_YD / tune::GRID as f32;
+
+/// `lookwater wakes`: the wakes on or off under the new water (on by default); the console's
+/// holds of the refraction and the light on the bed live with them (`lookwater refract`,
+/// `lookwater caustics`).
+#[derive(Resource, Clone, Copy, Debug, PartialEq)]
+pub struct LookWakes {
+    pub on: bool,
+    pub refract: Option<f32>,
+    pub caustics: Option<f32>,
+    /// `lookwater show`: the film's view of what the water is drawn from, in place of the water
+    /// (0 the water; [`SHOW_WORDS`] in order from 1), under the wakes only.
+    pub show: u8,
+    /// `lookwater tune`: the open water's surface's knobs (`look::water_surface::KNOBS`), at
+    /// their defaults until a film or a tester holds them.
+    pub tune: super::water_surface::SurfaceTune,
+}
+
+impl Default for LookWakes {
+    fn default() -> Self {
+        Self {
+            on: true,
+            refract: None,
+            caustics: None,
+            show: 0,
+            tune: Default::default(),
+        }
+    }
+}
+
+/// `lookwater show`'s words, from 1 (`off` is 0): how deep the water stands over the bed (white 4
+/// yd, a line each half yard, red where the shading's smoothed depth differs), the sun's share at
+/// the surface (white lit), how much of the bed's light comes through (by colour) and the bed as
+/// the water's scene copy holds it.
+pub const SHOW_WORDS: [&str; 4] = ["depth", "shadow", "clear", "bed"];
+
+/// One of `lookwater`'s words for the wakes and the bed under the water.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum WakesCommand {
+    /// `wakes <0|1>`, or `wakes` alone to read the counts.
+    Wakes(Option<bool>),
+    /// `refract <0-2>` (a multiple of the tuned), or `refract grade`.
+    Refract(Option<f32>),
+    /// `caustics <0-2>`, or `caustics grade`.
+    Caustics(Option<f32>),
+    /// `show <off|depth|shadow|clear|bed>`.
+    Show(u8),
+}
+
+impl LookWakes {
+    /// `lookwater wakes|refract|caustics ...`; `None` when the words are not one of these, which
+    /// `lookwater`'s own mirror and clarity then read.
+    pub fn parse(args: &str) -> Option<Result<WakesCommand, ()>> {
+        let mut words = args.split_whitespace();
+        let head = words.next()?.to_ascii_lowercase();
+        let value = words.next();
+        if words.next().is_some() {
+            return matches!(head.as_str(), "wakes" | "refract" | "caustics" | "show")
+                .then_some(Err(()));
+        }
+        let scale = |w: Option<&str>| -> Result<Option<f32>, ()> {
+            match w {
+                Some(w) if w.eq_ignore_ascii_case("grade") => Ok(None),
+                Some(w) => w
+                    .parse::<f32>()
+                    .ok()
+                    .filter(|v| (0.0..=2.0).contains(v))
+                    .map(Some)
+                    .ok_or(()),
+                None => Err(()),
+            }
+        };
+        Some(match head.as_str() {
+            "wakes" => match value {
+                None => Ok(WakesCommand::Wakes(None)),
+                Some("0") => Ok(WakesCommand::Wakes(Some(false))),
+                Some("1") => Ok(WakesCommand::Wakes(Some(true))),
+                Some(_) => Err(()),
+            },
+            "refract" => scale(value).map(WakesCommand::Refract),
+            "caustics" => scale(value).map(WakesCommand::Caustics),
+            "show" => match value.map(str::to_ascii_lowercase) {
+                Some(w) if w == "off" || w == "0" => Ok(WakesCommand::Show(0)),
+                Some(w) => SHOW_WORDS
+                    .iter()
+                    .position(|s| *s == w)
+                    .map(|i| WakesCommand::Show(i as u8 + 1))
+                    .ok_or(()),
+                None => Err(()),
+            },
+            _ => return None,
+        })
+    }
+}
+
+/// One body pushing on the field this frame: its path since the field last stepped (Bevy XZ), its
+/// radius, its steady push and foam, a ring's push at once (`splash`: it came in, landed or
+/// stopped) and the droplets it throws, its idle breathing, and its wake: how strong (0 to 1), its
+/// smoothed velocity (Bevy XZ, yd/s), how far back its arms reach, and how much they foam (0 to
+/// 1, by how deep it is).
+#[derive(Clone, Copy, Debug, PartialEq, Default)]
+pub struct WakeSource {
+    pub from: Vec2,
+    pub to: Vec2,
+    pub radius: f32,
+    pub push: f32,
+    pub foam: f32,
+    pub splash: f32,
+    pub drops: f32,
+    pub idle: f32,
+    pub idle_hz: f32,
+    pub phase: f32,
+    pub wake: f32,
+    pub vel: Vec2,
+    pub arm: f32,
+    pub arm_foam: f32,
+}
+
+/// This frame's wakes, from [`publish_wakes`] to the render world (`look::wakes_pass`) and the
+/// water block: whether they run, the field's place after this frame's steps, how far it moved,
+/// how many step pairs to run and what pushes.
+#[derive(Resource, Clone, Debug, PartialEq, ExtractResource)]
+pub struct WakeFrame {
+    pub on: bool,
+    /// The field starts over from calm water (just switched on, or the camera jumped).
+    pub reset: bool,
+    /// The field's lowest corner (Bevy X, Z) in whole texels, and in yards.
+    pub cell: IVec2,
+    pub origin: Vec2,
+    /// Texels the field moved since it last stepped.
+    pub shift: IVec2,
+    pub pairs: u32,
+    /// The field's clock at this frame's first step, and that step's number (wrapped).
+    pub clock: f32,
+    pub first_step: u32,
+    /// The rain, 0 to 1.
+    pub rain: f32,
+    /// How much of the foam born this frame is kept: 1, less as the field nears
+    /// [`tune::FOAM_COVER_MOST`] under foam.
+    pub foam_gain: f32,
+    pub sources: Vec<WakeSource>,
+}
+
+impl Default for WakeFrame {
+    fn default() -> Self {
+        Self {
+            on: false,
+            reset: true,
+            cell: IVec2::ZERO,
+            origin: Vec2::ZERO,
+            shift: IVec2::ZERO,
+            pairs: 0,
+            clock: 0.0,
+            first_step: 0,
+            rain: 0.0,
+            foam_gain: 1.0,
+            sources: Vec::new(),
+        }
+    }
+}
+
+/// The counts `lookwater wakes` and the log report: the bodies pushing, the fastest of them (its
+/// smoothed speed and how deep its feet are), our own body's speed as the wakes measure it (and as
+/// the mover says it goes) and how deep its feet are, from the GPU the foam and moving texels on
+/// the last frame it read back, and the most of each since the last report ([`Self::report`]):
+/// a film's `lookwater wakes` lands while the hero stands, after the wake it should count.
+#[derive(Resource, Clone, Copy, Debug, Default, PartialEq)]
+pub struct WakeStats {
+    pub sources: usize,
+    pub fastest: f32,
+    pub fastest_depth: f32,
+    pub foam_texels: u32,
+    pub moving_texels: u32,
+    pub read: bool,
+    /// Our own body: its smoothed speed (yd/s, measured as every wake source's is), the speed the
+    /// mover gives it, and how deep its feet are (`None` with no water under it).
+    pub own_speed: f32,
+    pub own_said: f32,
+    pub own_depth: Option<f32>,
+    /// The most since the last report: our speed, the fastest body's, and the foam texels.
+    pub peak_own: f32,
+    pub peak_fastest: f32,
+    pub peak_foam_texels: u32,
+}
+
+impl WakeStats {
+    /// The share of the field under foam.
+    pub fn foam_share(&self) -> f32 {
+        self.foam_texels as f32 / (tune::GRID * tune::GRID) as f32
+    }
+
+    /// How much of the foam born now is kept: all of it under half of
+    /// [`tune::FOAM_COVER_MOST`], none at it.
+    pub fn foam_gain(&self) -> f32 {
+        if !self.read {
+            return 1.0;
+        }
+        1.0 - smoothstep(
+            0.5 * tune::FOAM_COVER_MOST,
+            tune::FOAM_COVER_MOST,
+            self.foam_share(),
+        )
+    }
+
+    /// The GPU's counts for a frame, read back.
+    pub fn note_read(&mut self, foam_texels: u32, moving_texels: u32) {
+        self.foam_texels = foam_texels;
+        self.moving_texels = moving_texels;
+        self.read = true;
+        self.peak_foam_texels = self.peak_foam_texels.max(foam_texels);
+    }
+
+    /// Our own body this frame, and the fastest body's.
+    pub fn note_bodies(&mut self, own: f32, said: f32, depth: Option<f32>, fastest: f32, at: f32) {
+        self.own_speed = own;
+        self.own_said = said;
+        self.own_depth = depth;
+        self.fastest = fastest;
+        self.fastest_depth = at;
+        self.peak_own = self.peak_own.max(own);
+        self.peak_fastest = self.peak_fastest.max(fastest);
+    }
+
+    /// The counts in one line, for the console and the log: now, and the most since the last
+    /// report.
+    pub fn line(&self) -> String {
+        let share = |t: u32| 100.0 * t as f32 / (tune::GRID * tune::GRID) as f32;
+        let feet = match self.own_depth {
+            Some(d) => format!("feet {d:.1} yd deep"),
+            None => "no water under it".to_string(),
+        };
+        format!(
+            "{} pushing, field {}x{} over {} yd, foam on {:.2}% ({} texels; most {:.2}% since the \
+             last report), moving {} texels{}; you {:.1} yd/s (the mover says {:.1}; most {:.1}), \
+             {feet}; fastest {:.1} yd/s (most {:.1}) with its feet {:.1} yd deep",
+            self.sources,
+            tune::GRID,
+            tune::GRID,
+            tune::SPAN_YD,
+            share(self.foam_texels),
+            self.foam_texels,
+            share(self.peak_foam_texels),
+            self.moving_texels,
+            if self.read {
+                ""
+            } else {
+                " (not read back yet)"
+            },
+            self.own_speed,
+            self.own_said,
+            self.peak_own,
+            self.fastest,
+            self.peak_fastest,
+            self.fastest_depth,
+        )
+    }
+
+    /// [`Self::line`], and the most-since counts start over from now.
+    pub fn report(&mut self) -> String {
+        let line = self.line();
+        self.peak_own = self.own_speed;
+        self.peak_fastest = self.fastest;
+        self.peak_foam_texels = self.foam_texels;
+        line
+    }
+}
+
+/// A body's place the field last stepped to, its smoothed velocity, whether it was in the water,
+/// how fast it came down while out of it, its speed over the last half second, how much it is
+/// still settling after a stop, and how long it is still held quiet after a jump.
+#[derive(Clone, Copy, Debug)]
+struct Body {
+    stepped: Vec2,
+    last: Vec3,
+    vel: Vec2,
+    wet: bool,
+    seen: bool,
+    fall: f32,
+    recent: f32,
+    settle: f32,
+    quiet: f32,
+}
+
+/// Whether a body that moved `moved` (Bevy, yd) over a frame of `dt` seconds jumped there (a
+/// teleport) rather than went: further than [`tune::JUMP_YD`], or over a yard across at more than
+/// [`tune::JUMP_SPEED`].
+pub fn jumped(moved: Vec3, dt: f32) -> bool {
+    let across = Vec2::new(moved.x, moved.z).length();
+    moved.length() > tune::JUMP_YD || (across > 1.0 && across / dt.max(1.0e-4) > tune::JUMP_SPEED)
+}
+
+/// The wakes' memory across frames: the time not yet stepped, the field's place, its clock, and
+/// the bodies.
+#[derive(Resource, Default)]
+pub(crate) struct WakeTrack {
+    owed: f32,
+    cell: Option<IVec2>,
+    clock: f32,
+    steps: u32,
+    was_on: bool,
+    bodies: EntityHashMap<Body>,
+    since_log: f32,
+}
+
+/// The step pairs a frame of `dt` seconds pays for, out of what is `owed`: whole pairs, at most
+/// [`tune::MAX_PAIRS`]; a slow frame forgets the rest rather than catching up.
+pub fn pairs_for(owed: &mut f32, dt: f32) -> u32 {
+    let pair = 2.0 * tune::STEP_S;
+    *owed += dt.clamp(0.0, 0.25);
+    let pairs = ((*owed / pair).floor() as u32).min(tune::MAX_PAIRS);
+    *owed -= pairs as f32 * pair;
+    if pairs == tune::MAX_PAIRS {
+        *owed = owed.min(pair);
+    }
+    pairs
+}
+
+/// The field's lowest corner, in whole texels, for a camera at `eye` (Bevy) looking along `fwd`:
+/// centred on our own body at `own` (Bevy) when there is one, else [`tune::AHEAD`] of the span
+/// ahead of the camera on the ground.
+pub fn field_cell(eye: Vec3, fwd: Vec3, own: Option<Vec3>) -> IVec2 {
+    let centre = match own {
+        Some(at) => Vec2::new(at.x, at.z),
+        None => {
+            let flat = Vec2::new(fwd.x, fwd.z).normalize_or_zero();
+            Vec2::new(eye.x, eye.z) + flat * (tune::AHEAD * tune::SPAN_YD)
+        }
+    };
+    (centre / TEXEL_YD).floor().as_ivec2() - IVec2::splat(tune::GRID as i32 / 2)
+}
+
+/// How much a body `inside` yards in from the field's nearest edge pushes: none within
+/// [`tune::EDGE_MARGIN_YD`], all of it [`tune::EDGE_FADE_YD`] further in.
+pub fn edge_share(inside: f32) -> f32 {
+    smoothstep(
+        tune::EDGE_MARGIN_YD,
+        tune::EDGE_MARGIN_YD + tune::EDGE_FADE_YD,
+        inside,
+    )
+}
+
+/// A body's stop, frame by frame: `recent` its speed over the last half second and `settle` how
+/// much it is still settling, both kept across frames. On the frame a swimmer stops (and the
+/// field steps, `stepping`) its bow wave runs on as a ring: the push returned (else 0); and while
+/// it settles it breathes harder, by the factor returned.
+pub fn settle_step(
+    recent: &mut f32,
+    settle: &mut f32,
+    speed: f32,
+    dt: f32,
+    stepping: bool,
+) -> (f32, f32) {
+    let mut ring = 0.0;
+    if stepping && speed < tune::WAKE_FROM && *recent > 2.0 && *settle <= 0.0 {
+        ring = tune::STOP_RING * (*recent / 4.7).min(1.0);
+        *settle = 1.0;
+    }
+    *recent += (speed - *recent) * (1.0 - (-dt / 0.5).exp());
+    *settle = if speed < tune::WAKE_FROM {
+        (*settle - dt / tune::SETTLE_S).max(0.0)
+    } else {
+        0.0
+    };
+    (ring, 1.0 + tune::SETTLE * *settle)
+}
+
+/// The strength of a body's splash coming into the water at `speed` yd/s across it, having come
+/// down at `fall` yd/s: about 1 walking in, up to [`tune::LAND_GAIN`] more landing from a hop.
+pub fn entry_strength(speed: f32, fall: f32) -> f32 {
+    0.6 + 0.4 * (speed / 4.7).min(1.0) + tune::LAND_GAIN * (fall / tune::LAND_SPEED).clamp(0.0, 1.0)
+}
+
+fn smoothstep(e0: f32, e1: f32, x: f32) -> f32 {
+    let t = ((x - e0) / (e1 - e0)).clamp(0.0, 1.0);
+    t * t * (3.0 - 2.0 * t)
+}
+
+/// A body's push for this frame: `depth` its feet under the surface (yd), `vel` its smoothed
+/// planar velocity (Bevy XZ, yd/s), `scale` its model's; `None` out of the water or too deep to
+/// reach the surface (`gate`).
+pub fn body_source(depth: f32, gate: f32, vel: Vec2, scale: f32) -> Option<WakeSource> {
+    if depth < tune::WET_FROM || depth > gate {
+        return None;
+    }
+    let wet = smoothstep(tune::WET_FROM, tune::FULL_DEPTH, depth);
+    let deep = smoothstep(tune::FOAM_DEEP_FROM, tune::FOAM_DEEP_FULL, depth);
+    let speed = vel.length().clamp(0.0, tune::PUSH_SPEED_MOST);
+    Some(WakeSource {
+        radius: tune::RADIUS * scale.clamp(0.5, 3.0),
+        push: tune::PUSH * speed * wet,
+        foam: tune::BODY_FOAM * (speed / 4.0).min(1.5) * wet * deep,
+        idle: tune::IDLE_PUSH * wet,
+        idle_hz: tune::IDLE_HZ,
+        wake: smoothstep(tune::WAKE_FROM, tune::WAKE_FULL, speed) * wet,
+        vel,
+        arm: (tune::ARM_SECS * speed).min(tune::ARM_MOST),
+        arm_foam: deep,
+        ..default()
+    })
+}
+
+/// The compute pass's uniform (`look_wakes.wgsl`'s `WakeParams`): ten rows and
+/// [`SOURCE_ROWS`] a source, [`tune::MAX_SOURCES`] of them.
+pub const PARAM_HEAD_ROWS: usize = 10;
+pub const SOURCE_ROWS: usize = 5;
+pub const PARAM_ROWS: usize = PARAM_HEAD_ROWS + SOURCE_ROWS * tune::MAX_SOURCES;
+
+/// [`PARAM_ROWS`] for this frame.
+pub fn pack_params(frame: &WakeFrame) -> Vec<[f32; 4]> {
+    let mut rows = vec![[0.0; 4]; PARAM_ROWS];
+    let steps = 2 * frame.pairs;
+    rows[0] = [tune::GRID as f32, TEXEL_YD, tune::STEP_S, steps as f32];
+    rows[1] = [
+        tune::WAVE_SPEED * tune::WAVE_SPEED,
+        (-tune::STEP_S / tune::WAVE_LIFE_S).exp(),
+        (-tune::STEP_S / tune::FOAM_LIFE_S).exp(),
+        tune::DRIFT,
+    ];
+    // The bodies' foam comes in their own rows ([`body_source`]); 1 here takes it as it is.
+    rows[2] = [1.0, tune::CREST_FOAM, tune::CREST_FROM, tune::FOAM_MOST];
+    let rain = tune::RAIN_RATE * frame.rain.clamp(0.0, 1.0) * tune::STEP_S;
+    rows[3] = [rain, tune::RAIN_DROP, tune::DROP_FOAM, tune::EDGE_TEXELS];
+    rows[4] = [
+        frame.clock,
+        frame.first_step as f32,
+        frame.shift.x as f32,
+        frame.shift.y as f32,
+    ];
+    rows[5] = [
+        frame.origin.x,
+        frame.origin.y,
+        frame.cell.x as f32,
+        frame.cell.y as f32,
+    ];
+    let n = frame.sources.len().min(tune::MAX_SOURCES);
+    rows[6] = [
+        if frame.reset { 1.0 } else { 0.0 },
+        n as f32,
+        frame.foam_gain.clamp(0.0, 1.0),
+        tune::FOAM_IN_MOST,
+    ];
+    let arm = tune::ARM_DEG.to_radians();
+    rows[7] = [arm.tan(), arm.cos(), tune::ARM_WIDTH, tune::ARM_SPREAD];
+    rows[8] = [
+        tune::ARM_PUSH,
+        tune::ARM_FOAM,
+        tune::ARM_FOAM_FALL,
+        tune::DROP_SHARE,
+    ];
+    rows[9] = [
+        tune::BREAK_YD,
+        tune::BREAK_LEAST,
+        tune::BREAK_CUT,
+        tune::DROP_AT,
+    ];
+    for (i, s) in frame.sources.iter().take(n).enumerate() {
+        let r = PARAM_HEAD_ROWS + SOURCE_ROWS * i;
+        rows[r] = [s.from.x, s.from.y, s.to.x, s.to.y];
+        rows[r + 1] = [s.radius, s.push, s.foam, s.splash];
+        rows[r + 2] = [s.idle, s.idle_hz, s.phase, s.wake];
+        rows[r + 3] = [s.vel.x, s.vel.y, s.arm, s.arm_foam];
+        rows[r + 4] = [s.drops, 0.0, 0.0, 0.0];
+    }
+    rows
+}
+
+/// The water block's wake rows (`look::water::pack_rows`, rows 23 to 25), all zero with the wakes
+/// off: `[on, origin x, origin z, span]`.
+pub fn water_row(frame: &WakeFrame) -> [f32; 4] {
+    if !frame.on {
+        return [0.0; 4];
+    }
+    [1.0, frame.origin.x, frame.origin.y, tune::SPAN_YD]
+}
+
+/// The surface over a WoW-space point, from the water chunks under it.
+fn surface_at(
+    index: &WaterIndex,
+    water: &Query<&WaterChunkInfo, With<FoamPatch>>,
+    wow: [f32; 3],
+) -> Option<f32> {
+    index
+        .over(wow[0], wow[1])
+        .iter()
+        .find_map(|&e| water.get(e).ok()?.surface_z_at(wow[0], wow[1]))
+}
+
+fn phase_of(e: Entity) -> f32 {
+    let h = (e.to_bits() as u32).wrapping_mul(2_654_435_761);
+    (h >> 8) as f32 / 16_777_216.0 * std::f32::consts::TAU
+}
+
+/// Publishes this frame's [`WakeFrame`]: the field's place, the steps owed and every body pushing
+/// on it.
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn publish_wakes(
+    time: Res<Time>,
+    look: Res<WorldLook>,
+    water_on: Res<LookWater>,
+    wakes: Res<LookWakes>,
+    viewer: Res<Viewer>,
+    weather: Option<Res<super::WeatherLook>>,
+    cams: Query<&Transform, With<WorldCamera>>,
+    self_unit: Query<&WorldUnit, With<ViewerUnit>>,
+    units: Query<(Entity, &Transform, &WorldUnit), Without<ViewerUnit>>,
+    bobbers: Query<(Entity, &GlobalTransform), With<Bobber>>,
+    water: Query<&WaterChunkInfo, With<FoamPatch>>,
+    index: Option<Res<WaterIndex>>,
+    mut track: ResMut<WakeTrack>,
+    mut frame: ResMut<WakeFrame>,
+    mut stats: ResMut<WakeStats>,
+) {
+    let on = look.on && water_on.on && wakes.on;
+    let cam = cams.iter().next();
+    let (Some(cam), Some(index), true) = (cam, index, on) else {
+        if frame.on {
+            *frame = WakeFrame::default();
+        }
+        track.was_on = false;
+        track.bodies.clear();
+        stats.sources = 0;
+        return;
+    };
+    let dt = time.delta_secs();
+    let reset = !track.was_on;
+    track.was_on = true;
+    if reset {
+        track.owed = 0.0;
+        track.cell = None;
+        track.bodies.clear();
+    }
+    let pairs = pairs_for(&mut track.owed, dt).max(u32::from(reset));
+    let cell = field_cell(cam.translation, cam.forward().as_vec3(), viewer.at);
+    let mut next = WakeFrame {
+        on: true,
+        reset,
+        cell: track.cell.unwrap_or(cell),
+        origin: track.cell.unwrap_or(cell).as_vec2() * TEXEL_YD,
+        shift: IVec2::ZERO,
+        pairs,
+        clock: track.clock,
+        first_step: track.steps,
+        rain: weather.map_or(0.0, |w| w.rings()),
+        foam_gain: stats.foam_gain(),
+        sources: Vec::new(),
+    };
+    if pairs > 0 {
+        let shift = cell - track.cell.unwrap_or(cell);
+        next.reset |= shift.abs().max_element() >= tune::GRID as i32;
+        next.shift = shift;
+        next.cell = cell;
+        next.origin = cell.as_vec2() * TEXEL_YD;
+        track.cell = Some(cell);
+        let steps = 2 * pairs;
+        track.clock = (track.clock + steps as f32 * tune::STEP_S) % 3600.0;
+        track.steps = (track.steps + steps) % (1 << 24);
+    }
+
+    // The bodies: the viewer's own and every other that wades, then the bobbers.
+    for b in track.bodies.values_mut() {
+        b.seen = false;
+    }
+    let mut found: Vec<(Entity, Vec3, f32, f32, bool)> = Vec::new();
+    if let Some(at) = viewer.at {
+        let scale = self_unit.single().map(|u| u.scale).unwrap_or(1.0);
+        found.push((Entity::PLACEHOLDER, at, viewer.height, scale, false));
+    }
+    for (e, t, u) in &units {
+        if u.wades {
+            found.push((e, t.translation, u.height, u.scale, false));
+        }
+    }
+    for (e, t) in &bobbers {
+        found.push((e, t.translation(), 0.0, 1.0, true));
+    }
+    let centre = next.origin + Vec2::splat(0.5 * tune::SPAN_YD);
+    let mut sources: Vec<(f32, WakeSource)> = Vec::new();
+    let dt = dt.max(1.0e-4);
+    let smooth_k = 1.0 - (-dt / tune::SPEED_SMOOTH_S).exp();
+    let (mut fastest, mut fastest_depth) = (0.0f32, 0.0f32);
+    let (mut own, mut own_depth) = (0.0f32, None);
+    for (e, pos, height, scale, bobber) in found {
+        let mine = e == Entity::PLACEHOLDER;
+        let flat = Vec2::new(pos.x, pos.z);
+        // Kept in from the field's edge, so nothing is pushed where the sponge soaks it up.
+        let share = edge_share(0.5 * tune::SPAN_YD - (flat - centre).abs().max_element());
+        if share <= 0.0 {
+            continue;
+        }
+        // A body first seen is taken as already in the water if it is: no splash for one
+        // that comes into the field, logs in or arrives.
+        let body = track.bodies.entry(e).or_insert(Body {
+            stepped: flat,
+            last: pos,
+            vel: Vec2::ZERO,
+            wet: true,
+            seen: true,
+            fall: 0.0,
+            recent: 0.0,
+            settle: 0.0,
+            quiet: 0.0,
+        });
+        body.seen = true;
+        let moved = pos - body.last;
+        body.last = pos;
+        let mut down = 0.0;
+        if jumped(moved, dt) && !reset {
+            body.quiet = tune::JUMP_QUIET_S;
+        }
+        if body.quiet > 0.0 || reset {
+            // Jumped (or still settling where it landed): it starts afresh, with no streak.
+            body.quiet = (body.quiet - dt).max(0.0);
+            body.stepped = flat;
+            body.vel = Vec2::ZERO;
+            body.recent = 0.0;
+            body.settle = 0.0;
+            body.fall = 0.0;
+            if !reset {
+                // Taken as already in the water if it is, so it comes in without a splash.
+                let wow = bevy_to_wow(pos);
+                body.wet = surface_at(&index, &water, wow)
+                    .is_some_and(|surface| surface - wow[2] >= tune::WET_FROM);
+                continue;
+            }
+        } else {
+            let raw = Vec2::new(moved.x, moved.z) / dt;
+            body.vel += (raw - body.vel) * smooth_k;
+            down = (-moved.y / dt).max(0.0);
+        }
+        let vel = body.vel;
+        if mine {
+            own = vel.length();
+        }
+        let wow = bevy_to_wow(pos);
+        let Some(surface) = surface_at(&index, &water, wow) else {
+            body.wet = false;
+            body.fall = 0.0;
+            body.stepped = flat;
+            continue;
+        };
+        let depth = surface - wow[2];
+        if mine {
+            own_depth = Some(depth);
+        }
+        let source = if bobber {
+            (depth.abs() <= tune::BOBBER_REACH).then_some(WakeSource {
+                radius: tune::BOBBER_RADIUS,
+                idle: tune::BOBBER_PUSH,
+                idle_hz: tune::BOBBER_HZ,
+                ..default()
+            })
+        } else {
+            let gate = (2.0 * height).max(1.0);
+            body_source(depth, gate, vel, scale)
+        };
+        let Some(mut s) = source else {
+            // Out of the water: how fast it comes down, for the splash it lands with.
+            body.fall = if body.wet { down } else { body.fall.max(down) };
+            body.wet = false;
+            body.recent = 0.0;
+            body.settle = 0.0;
+            body.stepped = flat;
+            continue;
+        };
+        let speed = vel.length();
+        let entered = !body.wet;
+        if entered {
+            let strength = if bobber {
+                0.4
+            } else {
+                entry_strength(speed, body.fall.max(down)) * scale.clamp(0.5, 2.0)
+            };
+            s.splash = tune::SPLASH * strength;
+            s.drops = if bobber { 0.0 } else { strength };
+            body.wet = true;
+        }
+        // A stop: the bow wave runs on as a ring, and the body settles for a moment.
+        if !bobber {
+            let (ring, breath) =
+                settle_step(&mut body.recent, &mut body.settle, speed, dt, pairs > 0);
+            s.splash += ring;
+            s.idle *= breath;
+        }
+        s.push *= share;
+        s.foam *= share;
+        s.splash *= share;
+        s.drops *= share;
+        s.idle *= share;
+        s.wake *= share;
+        s.from = body.stepped;
+        s.to = flat;
+        s.phase = phase_of(e);
+        if !bobber && vel.length() >= fastest {
+            fastest = vel.length();
+            fastest_depth = depth;
+        }
+        if pairs > 0 {
+            body.stepped = flat;
+            body.fall = 0.0;
+        } else if entered {
+            // Nothing steps this frame: the splash waits for the next that does.
+            body.wet = false;
+        }
+        sources.push(((flat - centre).length_squared(), s));
+    }
+    track.bodies.retain(|_, b| b.seen);
+    sources.sort_by(|a, b| a.0.total_cmp(&b.0));
+    next.sources = sources
+        .into_iter()
+        .take(tune::MAX_SOURCES)
+        .map(|(_, s)| s)
+        .collect();
+    stats.sources = next.sources.len();
+    stats.note_bodies(own, viewer.planar_speed, own_depth, fastest, fastest_depth);
+
+    track.since_log += dt;
+    if track.since_log >= tune::LOG_EVERY_S
+        && (stats.sources > 0 || stats.peak_foam_texels > 0 || stats.peak_own > 0.0)
+    {
+        track.since_log = 0.0;
+        info!("[look wakes] {}", stats.report());
+    }
+    if *frame != next {
+        *frame = next;
+    }
+}
+
+/// The wakes' stats buffer, a few counters the pass adds to and the main world reads back.
+#[derive(Resource, Clone, ExtractResource)]
+pub struct WakeStatsBuffer(pub Handle<bevy::render::storage::ShaderStorageBuffer>);
+
+/// The entity that reads the stats back while the wakes are on.
+#[derive(Component)]
+struct WakeReadback;
+
+fn setup_stats(
+    mut commands: Commands,
+    buffers: Option<ResMut<Assets<bevy::render::storage::ShaderStorageBuffer>>>,
+) {
+    use bevy::render::render_resource::BufferUsages;
+    let Some(mut buffers) = buffers else { return };
+    let mut buf = bevy::render::storage::ShaderStorageBuffer::from([0u32; 4]);
+    buf.buffer_description.label = Some("look_wake_stats");
+    buf.buffer_description.usage =
+        BufferUsages::STORAGE | BufferUsages::COPY_SRC | BufferUsages::COPY_DST;
+    commands.insert_resource(WakeStatsBuffer(buffers.add(buf)));
+}
+
+/// Reads the counters back while the wakes run, and stops when they do.
+fn read_stats(
+    mut commands: Commands,
+    frame: Res<WakeFrame>,
+    buffer: Option<Res<WakeStatsBuffer>>,
+    readers: Query<Entity, With<WakeReadback>>,
+    mut stats: ResMut<WakeStats>,
+) {
+    let Some(buffer) = buffer else { return };
+    match (frame.on, readers.iter().next()) {
+        (true, None) => {
+            commands
+                .spawn((
+                    WakeReadback,
+                    bevy::render::gpu_readback::Readback::buffer(buffer.0.clone()),
+                ))
+                .observe(
+                    |ev: On<bevy::render::gpu_readback::ReadbackComplete>,
+                     mut stats: ResMut<WakeStats>| {
+                        let words: Vec<u32> = ev
+                            .data
+                            .as_chunks::<4>()
+                            .0
+                            .iter()
+                            .map(|c| u32::from_le_bytes(*c))
+                            .collect();
+                        if words.len() >= 2 {
+                            stats.note_read(words[0], words[1]);
+                        }
+                    },
+                );
+        }
+        (false, Some(e)) => {
+            commands.entity(e).despawn();
+            *stats = WakeStats::default();
+        }
+        _ => {}
+    }
+}
+
+/// Inserts the two field images before any liquid material is made, so none waits on them.
+pub(crate) fn insert_wake_field(images: Option<ResMut<Assets<Image>>>) {
+    use benilla_assets::materials::{wake_field_image, WAKE_FIELD, WAKE_FIELD_B};
+    let Some(mut images) = images else { return };
+    for handle in [WAKE_FIELD, WAKE_FIELD_B] {
+        if images.get(handle.id()).is_none() {
+            let _ = images.insert(handle.id(), wake_field_image(tune::GRID));
+        }
+    }
+}
+
+pub(crate) fn init_resources(app: &mut App) {
+    app.init_resource::<LookWakes>()
+        .init_resource::<WakeFrame>()
+        .init_resource::<WakeStats>()
+        .init_resource::<WakeTrack>();
+}
+
+pub(super) fn build(app: &mut App) {
+    app.add_systems(Startup, setup_stats)
+        .add_systems(PostUpdate, read_stats);
+}
