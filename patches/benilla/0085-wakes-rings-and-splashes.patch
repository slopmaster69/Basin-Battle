+/// The field on the CPU: `look_wakes.wgsl`'s step in Rust, for the tests (keep in sync). `n`
+/// texels a side, each `[h, φ, foam, 0]`.
+#[derive(Clone)]
+pub struct CpuField {
+    pub n: usize,
+    pub texels: Vec<[f32; 4]>,
+}
+
+impl CpuField {
+    pub fn new(n: usize) -> Self {
+        Self {
+            n,
+            texels: vec![[0.0; 4]; n * n],
+        }
+    }
+
+    fn at(&self, x: i32, z: i32) -> [f32; 4] {
+        let n = self.n as i32;
+        if x < 0 || z < 0 || x >= n || z >= n {
+            return [0.0; 4];
+        }
+        self.texels[(z * n + x) as usize]
+    }
+
+    fn foam_at(&self, t: Vec2) -> f32 {
+        let f = t - Vec2::splat(0.5);
+        let i = f.floor();
+        let w = f - i;
+        let (x, z) = (i.x as i32, i.y as i32);
+        let a = self.at(x, z)[2];
+        let b = self.at(x + 1, z)[2];
+        let d = self.at(x, z + 1)[2];
+        let e = self.at(x + 1, z + 1)[2];
+        let lerp = |p: f32, q: f32, s: f32| p + (q - p) * s;
+        lerp(lerp(a, b, w.x), lerp(d, e, w.x), w.y)
+    }
+
+    /// The texel holding Bevy XZ `p` when the field's corner is at `origin`.
+    pub fn texel_of(&self, origin: Vec2, p: Vec2) -> Option<[f32; 4]> {
+        let t = ((p - origin) / TEXEL_YD).floor();
+        let n = self.n as f32;
+        (t.x >= 0.0 && t.y >= 0.0 && t.x < n && t.y < n).then(|| self.at(t.x as i32, t.y as i32))
+    }
+}
+
+/// `look_wakes.wgsl`'s `wake_hash`: 0 to 1 for a world texel and a step's number.
+pub fn wake_hash(cell: IVec2, n: u32) -> f32 {
+    let mut h = (cell.x as u32)
+        .wrapping_mul(374_761_393)
+        .wrapping_add((cell.y as u32).wrapping_mul(668_265_263))
+        .wrapping_add(n.wrapping_mul(2_246_822_519));
+    h = (h ^ (h >> 13)).wrapping_mul(1_274_126_177);
+    h ^= h >> 16;
+    h as f32 * (1.0 / 4_294_967_296.0)
+}
+
+/// `look_wakes.wgsl`'s `wake_break`: the share of the arms' foam born `s` yards along a track.
+pub fn wake_break(s: f32, brk: [f32; 4]) -> f32 {
+    let q = s / brk[0].max(0.05);
+    let i = q.floor();
+    let f = q - i;
+    let f = f * f * (3.0 - 2.0 * f);
+    let a = wake_hash(IVec2::new(i as i32, 0), 7);
+    let b = wake_hash(IVec2::new(i as i32 + 1, 0), 7);
+    let n = a + (b - a) * f;
+    brk[1] + (1.0 - brk[1]) * smoothstep(brk[2] - 0.15, brk[2] + 0.15, n)
+}
+
+/// One step `k` of `steps` of the field on the CPU, as `look_wakes.wgsl`'s `step_field`: the
+/// params are [`pack_params`]'s (the grid's size is the field's own here). No shift.
+pub fn cpu_step(field: &CpuField, params: &[[f32; 4]], k: u32) -> CpuField {
+    let n = field.n as i32;
+    let [_, dx, dt, steps] = params[0];
+    let steps = steps.max(1.0);
+    let wave = params[1];
+    let foam_p = params[2];
+    let more = params[3];
+    let clock = params[4];
+    let place = params[5];
+    let misc = params[6];
+    let arm_p = params[7];
+    let arm2 = params[8];
+    let brk = params[9];
+    let count = misc[1] as usize;
+    let kf = k as f32;
+    let smooth = |e0: f32, e1: f32, x: f32| smoothstep(e0, e1, x);
+    let mut out = CpuField::new(field.n);
+    for z in 0..n {
+        for x in 0..n {
+            let s = field.at(x, z);
+            let xl = field.at(x - 1, z);
+            let xr = field.at(x + 1, z);
+            let zl = field.at(x, z - 1);
+            let zr = field.at(x, z + 1);
+            let cell = IVec2::new(x + place[2] as i32, z + place[3] as i32);
+            let pos = Vec2::new(place[0], place[1]) + (Vec2::new(x as f32, z as f32) + 0.5) * dx;
+            let t = clock[0] + kf * dt;
+            let (mut press, mut churn, mut arms) = (0.0f32, 0.0f32, 0.0f32);
+            let (mut splash, mut drops) = (0.0f32, 0.0f32);
+            let mut carry = Vec2::ZERO;
+            for i in 0..count {
+                let r = PARAM_HEAD_ROWS + SOURCE_ROWS * i;
+                let (s0, s1, s2, s3) = (params[r], params[r + 1], params[r + 2], params[r + 3]);
+                let s4 = params[r + 4];
+                let r2 = (s1[0] * s1[0]).max(1e-4);
+                let from = Vec2::new(s0[0], s0[1]);
+                let to = Vec2::new(s0[2], s0[3]);
+                let a = from.lerp(to, kf / steps);
+                let b = from.lerp(to, (kf + 1.0) / steps);
+
+                let v = Vec2::new(s3[0], s3[1]);
+                let sp = v.length();
+                if s2[3] > 0.0 && sp > 0.3 {
+                    let d = v / sp;
+                    let across = Vec2::new(-d.y, d.x);
+                    let rel = pos - b;
+                    let along = -rel.dot(d);
+                    let side = rel.dot(across);
+                    let reach = s3[2];
+                    let line = s1[0] + along.max(0.0) * arm_p[0];
+                    if along > -1.0 && along < reach + 1.5 && side.abs() < line + 1.2 {
+                        let off = (side.abs() - line).abs() * arm_p[1];
+                        let wid = arm_p[2] + arm_p[3] * along.max(0.0);
+                        let on_len =
+                            smooth(-s1[0], 0.3, along) * (1.0 - smooth(0.7 * reach, reach, along));
+                        let g_arm = (-off * off / (wid * wid)).exp() * on_len * s2[3];
+                        press += s1[1] * arm2[0] * g_arm;
+                        let g_foam = g_arm * wake_break(pos.dot(d), brk) * s3[3];
+                        churn += arm2[1] * g_foam * (-along.max(0.0) / arm2[2]).exp();
+                        arms += g_foam;
+                        let m = smooth(-1.0, 0.0, along)
+                            * (1.0 - smooth(reach, reach + 1.5, along))
+                            * (1.0 - smooth(line + 0.4, line + 1.2, side.abs()))
+                            * s2[3];
+                        let sign = if side > 0.0 {
+                            1.0
+                        } else if side < 0.0 {
+                            -1.0
+                        } else {
+                            0.0
+                        };
+                        carry += across * (m * sp * arm_p[0] * sign);
+                    }
+                }
+
+                let seg = b - a;
+                let l2 = seg.length_squared().max(1e-8);
+                let sv = ((pos - a).dot(seg) / l2).clamp(0.0, 1.0);
+                let d2 = (pos - a - sv * seg).length_squared();
+                if d2 > 9.0 * r2 {
+                    continue;
+                }
+                let g = (-d2 / r2).exp();
+                press += (s1[1] + s2[0] * (std::f32::consts::TAU * s2[1] * t + s2[2]).sin()) * g;
+                churn += s1[2] * (-d2 / (1.69 * r2)).exp() * (d2 / r2).clamp(0.0, 1.0);
+                if k == 0 && s1[3] > 0.0 {
+                    splash += s1[3] * (-d2 / (2.25 * r2)).exp();
+                }
+                if k == 0 && s4[0] > 0.0 {
+                    let ring = d2.sqrt() - brk[3] * s1[0];
+                    if wake_hash(cell, (clock[1] as u32).wrapping_add(7919)) < arm2[3] {
+                        drops += s4[0] * (-ring * ring / (0.36 * r2)).exp();
+                    }
+                }
+            }
+            let lap = (xl[1] + xr[1] + zl[1] + zr[1] - 4.0 * s[1]) / (dx * dx);
+            let mut h = s[0] - dt * lap;
+            let mut phi = s[1] - dt * (wave[0] * h + press) - splash;
+            if more[0] > 0.0 && wake_hash(cell, (clock[1] as u32).wrapping_add(k)) < more[0] {
+                phi -= more[1];
+            }
+            let edge = x.min(n - 1 - x).min(z.min(n - 1 - z)) as f32;
+            let e = (edge / more[3].max(1.0)).clamp(0.0, 1.0);
+            let keep = wave[1] * (1.0 - 0.2 * (1.0 - e) * (1.0 - e));
+            h *= keep;
+            phi *= keep;
+            let drift = Vec2::new(xr[1] - xl[1], zr[1] - zl[1]) / (2.0 * dx);
+            let back = Vec2::new(x as f32, z as f32) + 0.5 - (drift * wave[3] + carry) * (dt / dx);
+            let rise = (h - s[0]) / dt;
+            let crest =
+                (rise - foam_p[2]).max(0.0) * if h > 0.0 { 1.0 } else { 0.0 } * arms.min(1.0);
+            let born = ((churn * foam_p[0] + crest * foam_p[1]) * dt).min(misc[3] * dt) * misc[2];
+            let foam = ((field.foam_at(back) + born + drops * more[2]) * wave[2]).min(foam_p[3]);
+            out.texels[(z * n + x) as usize] = [h, phi, foam, 0.0];
+        }
+    }
+    out
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// A body crossing a CPU field at `speed` yd/s along +X for `secs`, then (optionally) stopping
+    /// for `rest` more, in `rain` (0 to 1): the field, its corner, and the body's end. Its speed is
+    /// smoothed as [`publish_wakes`] smooths it.
+    fn run(speed: f32, secs: f32, rest: f32, depth: f32, rain: f32) -> (CpuField, Vec2, Vec2) {
+        run_from(true, speed, secs, rest, depth, rain)
+    }
+
+    /// [`run`], the body coming into the water at the start (`enter`, a splash) or already in it.
+    fn run_from(
+        enter: bool,
+        speed: f32,
+        secs: f32,
+        rest: f32,
+        depth: f32,
+        rain: f32,
+    ) -> (CpuField, Vec2, Vec2) {
+        let n = 96;
+        let origin = Vec2::ZERO;
+        let mut field = CpuField::new(n);
+        let mut pos = Vec2::new(4.0, 12.0);
+        let mut vel = Vec2::ZERO;
+        let mut frame = WakeFrame {
+            on: true,
+            reset: false,
+            pairs: 1,
+            rain,
+            ..default()
+        };
+        let pair_s = 2.0 * tune::STEP_S;
+        let smooth_k = 1.0 - (-pair_s / tune::SPEED_SMOOTH_S).exp();
+        let moving = (secs / pair_s) as u32;
+        let total = moving + (rest / pair_s) as u32;
+        let mut wet = !enter;
+        let (mut recent, mut settle) = (0.0, 0.0);
+        for i in 0..total {
+            let target = if i < moving { speed } else { 0.0 };
+            vel += (Vec2::new(target, 0.0) - vel) * smooth_k;
+            let next = pos + vel * pair_s;
+            let mut s = body_source(depth, 4.0, vel, 1.0).expect("in the water");
+            if !wet {
+                let strength = entry_strength(vel.length(), 0.0);
+                s.splash = tune::SPLASH * strength;
+                s.drops = strength;
+                wet = true;
+            }
+            let (ring, breath) = settle_step(&mut recent, &mut settle, vel.length(), pair_s, true);
+            s.splash += ring;
+            s.idle *= breath;
+            s.from = pos;
+            s.to = next;
+            frame.sources = vec![s];
+            frame.clock = i as f32 * pair_s;
+            frame.first_step = 2 * i;
+            let mut params = pack_params(&frame);
+            params[0][0] = n as f32;
+            params[5] = [origin.x, origin.y, 0.0, 0.0];
+            field = cpu_step(&field, &params, 0);
+            field = cpu_step(&field, &params, 1);
+            pos = next;
+        }
+        (field, origin, pos)
+    }
+
+    fn foam(f: &CpuField, o: Vec2, p: Vec2) -> f32 {
+        f.texel_of(o, p).map_or(0.0, |t| t[2])
+    }
+
+    fn most_foam(f: &CpuField) -> f32 {
+        f.texels.iter().map(|t| t[2]).fold(0.0f32, f32::max)
+    }
+
+    /// A teleport, in one frame or spread by the mover over a few, is a jump; a run, a swim, a
+    /// mount's gallop, a hop and a frame's hitch are not (the sixth filming's white patches after
+    /// each `.es goto`).
+    #[test]
+    fn a_teleport_is_a_jump_and_a_run_is_not() {
+        let dt = 1.0 / 60.0;
+        assert!(jumped(Vec3::new(20.0, 0.0, -9.0), dt), "a goto");
+        assert!(
+            jumped(Vec3::new(3.5, 0.0, 0.0), 0.25),
+            "a goto's frame on a slow machine"
+        );
+        assert!(
+            jumped(Vec3::new(1.4, 0.0, 0.6), dt),
+            "a goto spread over frames"
+        );
+        assert!(!jumped(Vec3::new(7.0 * dt, 0.0, 0.0), dt), "a run");
+        assert!(!jumped(Vec3::new(14.0 * dt, 0.0, 0.0), dt), "a gallop");
+        assert!(!jumped(Vec3::new(0.0, 0.5, 0.0), dt), "a hop");
+        assert!(
+            !jumped(Vec3::new(1.8, 0.0, 0.0), 0.25),
+            "a run's frame on a hitch"
+        );
+        assert!(
+            !jumped(Vec3::new(0.3, 0.0, 0.2), dt),
+            "a snap back by the mover"
+        );
+    }
+
+    /// The reference's swimmer: at the swim speed (4.72 yd/s) the foam lies behind him in a V of
+    /// two arms, each trailing from his side at about 19.5° from his track, white along most of
+    /// the arm but broken into streaks with gaps, and clear between them; none ahead of him.
+    #[test]
+    fn a_swimmer_leaves_a_v_of_two_broken_foam_arms() {
+        let (f, o, end) = run(4.72, 2.5, 0.0, 1.0, 0.0);
+        assert!(
+            foam(&f, o, end + Vec2::new(1.5, 0.0)) < 0.05,
+            "calm ahead of him"
+        );
+        let tan = tune::ARM_DEG.to_radians().tan();
+        let (mut white, mut samples) = (0, 0);
+        let (mut weakest, mut whitest) = (f32::MAX, 0.0f32);
+        for i in 4..=20 {
+            let back = i as f32 * 0.25;
+            // Each side's whitest texel across the track, and where it lies.
+            for sign in [1.0f32, -1.0] {
+                let (mut best, mut at) = (0.0f32, 0.0f32);
+                for j in 0..16 {
+                    let off = j as f32 * TEXEL_YD;
+                    let v = foam(&f, o, end + Vec2::new(-back, sign * off));
+                    if v > best {
+                        (best, at) = (v, off);
+                    }
+                }
+                samples += 1;
+                weakest = weakest.min(best);
+                whitest = whitest.max(best);
+                if best > 0.6 {
+                    white += 1;
+                    let arm = tune::RADIUS + back * tan;
+                    assert!(
+                        (at - arm).abs() <= 0.6,
+                        "{back} yd back, side {sign}: the arm at {at} yd out, the V's at {arm}"
+                    );
+                }
+            }
+            // Clear between the arms.
+            let mid = foam(&f, o, end + Vec2::new(-back, 0.0));
+            assert!(mid < 0.3, "{back} yd back: clear between the arms ({mid})");
+        }
+        assert!(
+            white * 10 >= samples * 6,
+            "white along most of the arms: {white} of {samples}"
+        );
+        assert!(
+            whitest >= 1.2,
+            "thick, so the water draws it crisp: {whitest}"
+        );
+        assert!(
+            weakest < 0.6 * whitest,
+            "broken into streaks with gaps: {weakest} to {whitest}"
+        );
+        // It opens out: the arms lie further apart further back.
+        let foamy = |back: f32| -> f32 {
+            (0..16)
+                .map(|j| j as f32 * TEXEL_YD)
+                .filter(|&off| foam(&f, o, end + Vec2::new(-back, off)) > 0.5)
+                .fold(0.0f32, f32::max)
+        };
+        assert!(
+            foamy(4.0) > foamy(1.5) + 0.5,
+            "{} then {}",
+            foamy(1.5),
+            foamy(4.0)
+        );
+        // A V, not a flood.
+        let white = f.texels.iter().filter(|t| t[2] > 0.3).count();
+        assert!((100..900).contains(&white), "{white} foamy texels");
+    }
+
+    /// The arms' gaps: a smooth noise along the track, between its least and all of the foam.
+    #[test]
+    fn the_arms_break_into_streaks() {
+        let brk = [tune::BREAK_YD, tune::BREAK_LEAST, tune::BREAK_CUT, 0.0];
+        let along: Vec<f32> = (0..400).map(|i| wake_break(i as f32 * 0.05, brk)).collect();
+        assert!(along
+            .iter()
+            .all(|b| (tune::BREAK_LEAST - 1e-5..=1.0 + 1e-5).contains(b)));
+        let gaps = along.iter().filter(|b| **b < 0.4).count();
+        let full = along.iter().filter(|b| **b > 0.9).count();
+        assert!(
+            gaps > 40 && full > 100,
+            "{gaps} in gaps, {full} full of 400"
+        );
+        let jump = along
+            .windows(2)
+            .map(|w| (w[1] - w[0]).abs())
+            .fold(0.0f32, f32::max);
+        assert!(
+            jump < 0.5,
+            "gaps a few hand-widths long, not speckle: {jump}"
+        );
+        assert_eq!(wake_break(-1234.56, brk), wake_break(-1234.56, brk));
+    }
+
+    /// A hero standing still in the shallows breathes gentle rings and no foam.
+    #[test]
+    fn a_still_hero_makes_rings_not_foam() {
+        let (f, o, end) = run_from(false, 0.0, 0.0, 3.0, 0.8, 0.0);
+        let mut ring = 0.0f32;
+        for z in 0..f.n {
+            for x in 0..f.n {
+                let t = f.texels[z * f.n + x];
+                let p = o + (Vec2::new(x as f32, z as f32) + 0.5) * TEXEL_YD;
+                if (1.5..3.0).contains(&(p - end).length()) {
+                    ring = ring.max(t[0].abs());
+                }
+            }
+        }
+        assert!(
+            most_foam(&f) < 0.05,
+            "no foam, not even round him: {}",
+            most_foam(&f)
+        );
+        assert!(ring > 0.0005 && ring < 0.05, "gentle rings: {ring} yd");
+    }
+
+    /// Rain dimples the water with rings and never foams it (the first filming's rain whitened
+    /// 91% of the lake), with a hero standing in it.
+    #[test]
+    fn rain_makes_rings_not_foam() {
+        let (f, _, _) = run_from(false, 0.0, 0.0, 3.0, 0.8, 1.0);
+        let moving = f.texels.iter().filter(|t| t[0].abs() > 0.005).count();
+        assert!(moving > 500, "the drops' rings: {moving} moving texels");
+        assert!(most_foam(&f) < 0.05, "no foam: {}", most_foam(&f));
+    }
+
+    /// The wake fades over about a second and a half, as the reference's: a second after the
+    /// swimmer stops much of his V is still white, at a second and a half its last streaks
+    /// are thinning, by three seconds it is gone; and the field never grows.
+    #[test]
+    fn the_wake_fades_over_a_second_and_a_half() {
+        let count = |f: &CpuField, at: f32| f.texels.iter().filter(|t| t[2] > at).count();
+        let (moving, _, _) = run(4.72, 2.0, 0.0, 1.0, 0.0);
+        let (one, _, _) = run(4.72, 2.0, 1.0, 1.0, 0.0);
+        let (one_half, _, _) = run(4.72, 2.0, 1.5, 1.0, 0.0);
+        let (gone, _, _) = run(4.72, 2.0, 3.0, 1.0, 0.0);
+        let had = count(&moving, 0.3);
+        assert!(had > 100, "{had} foamy texels while he swims");
+        assert!(
+            count(&one, 0.3) > had / 3,
+            "a second on: {} of {had}",
+            count(&one, 0.3)
+        );
+        assert!(count(&one, 0.6) > 0, "still white streaks a second on");
+        let late = count(&one_half, 0.3);
+        assert!(late > 0 && late < had, "thinning at 1.5 s: {late} of {had}");
+        assert!(
+            count(&gone, 0.3) < had / 20,
+            "{} left at 3 s",
+            count(&gone, 0.3)
+        );
+        let most = gone
+            .texels
+            .iter()
+            .map(|t| t[0].abs())
+            .fold(0.0f32, f32::max);
+        assert!(most < 0.2, "the field stays small: {most} yd");
+    }
+
+    /// `lookwater wakes` and the log line say what happened since the last report, not only
+    /// this frame: a film's readout lands after the hero has stopped.
+    #[test]
+    fn the_readout_keeps_the_most_since_the_last_report() {
+        let mut s = WakeStats::default();
+        s.note_bodies(4.7, 4.72, Some(1.1), 4.7, 1.1);
+        s.note_read(300, 5000);
+        s.note_bodies(0.0, 0.0, Some(1.1), 0.0, 1.1);
+        s.note_read(0, 100);
+        let line = s.report();
+        assert!(
+            line.starts_with("0 pushing, field 320x320 over 80 yd"),
+            "{line}"
+        );
+        assert!(
+            line.contains("foam on 0.00% (0 texels; most 0.29% since"),
+            "{line}"
+        );
+        assert!(
+            line.contains("you 0.0 yd/s (the mover says 0.0; most 4.7)"),
+            "{line}"
+        );
+        assert!(line.contains("feet 1.1 yd deep"), "{line}");
+        assert!(line.contains("fastest 0.0 yd/s (most 4.7)"), "{line}");
+        let next = s.line();
+        assert!(next.contains("most 0.00% since"), "starts over: {next}");
+        assert!(next.contains("most 0.0)"), "starts over: {next}");
+        s.note_bodies(2.0, 4.72, None, 0.0, 0.0);
+        assert!(s.line().contains("no water under it"));
+    }
+
+    /// A body coming in throws a few droplets round it, each a speck of its own (the water draws
+    /// each as a small dot), and sends a ring out: no disc of foam over it, no bars beside it.
+    #[test]
+    fn a_splash_throws_droplets_not_a_disc() {
+        let (f, o, end) = run(0.0, 0.0, 2.0 * tune::STEP_S, 0.8, 0.0);
+        let (mut inside, mut drops, mut lone) = (0.0f32, 0, 0);
+        for z in 0..f.n {
+            for x in 0..f.n {
+                let t = f.texels[z * f.n + x];
+                let r = (o + (Vec2::new(x as f32, z as f32) + 0.5) * TEXEL_YD - end).length();
+                if r < tune::RADIUS {
+                    inside = inside.max(t[2]);
+                }
+                if t[2] > 0.3 {
+                    drops += 1;
+                    let (xi, zi) = (x as i32, z as i32);
+                    let near = [(1, 0), (-1, 0), (0, 1), (0, -1)]
+                        .iter()
+                        .filter(|(a, b)| f.at(xi + a, zi + b)[2] > 0.3)
+                        .count();
+                    if near <= 2 {
+                        lone += 1;
+                    }
+                }
+            }
+        }
+        assert!(inside < 0.05, "none over him: {inside}");
+        assert!((2..30).contains(&drops), "a few droplets: {drops}");
+        assert!(
+            lone * 10 >= drops * 7,
+            "specks, not a band: {lone} of {drops}"
+        );
+        let ring = f.texels.iter().map(|t| t[0].abs()).fold(0.0f32, f32::max);
+        assert!(ring > 0.005, "a ring goes out: {ring} yd");
+    }
+
+    /// Landing in the water from a hop splashes harder than walking in: a stronger ring and
+    /// more droplets.
+    #[test]
+    fn a_landing_splashes_harder_than_a_walk_in() {
+        let walk = entry_strength(4.7, 0.0);
+        let hop = entry_strength(0.0, 6.0);
+        assert!((0.9..=1.1).contains(&walk), "{walk}");
+        assert!(hop > 1.8 * walk.min(1.0), "{hop}");
+        assert!(entry_strength(0.0, 40.0) <= 0.6 + tune::LAND_GAIN + 1e-5);
+    }
+
+    /// A wader's shins push rings and ripples but no foam: the third filming's walk-in drew two
+    /// opaque white bars beside him.
+    #[test]
+    fn a_wader_makes_rings_not_foam() {
+        let run_in = Vec2::new(4.7, 0.0);
+        let shins = body_source(0.3, 4.0, run_in, 1.0).unwrap();
+        assert!(shins.push > 0.0 && shins.wake > 0.0, "it moves the water");
