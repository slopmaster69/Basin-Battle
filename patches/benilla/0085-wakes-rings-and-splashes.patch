+    pub(crate) fn parse(args: &str) -> Option<Self> {
+        let mut words = args.split_whitespace();
+        let secs = words.next()?.parse::<f32>().ok().filter(|s| *s > 0.0 && *s <= 60.0)?;
+        let way = words.next()?.to_ascii_lowercase();
+        let (mut fwd, mut side) = (0, 0);
+        for c in way.chars() {
+            match c {
+                'f' if fwd == 0 => fwd = 1,
+                'b' if fwd == 0 => fwd = -1,
+                'l' if side == 0 => side = -1,
+                'r' if side == 0 => side = 1,
+                _ => return None,
+            }
+        }
+        if fwd == 0 && side == 0 {
+            return None;
+        }
+        let facing = match words.next() {
+            Some(w) => Some(w.parse::<f32>().ok().filter(|d| d.is_finite())?.to_radians()),
+            None => None,
+        };
+        if words.next().is_some() {
+            return None;
+        }
+        Some(Self {
+            fwd,
+            side,
+            secs,
+            facing,
+            until: None,
+        })
+    }
+}
