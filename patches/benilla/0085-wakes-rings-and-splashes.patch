diff --git a/crates/benilla-world/src/shaders/look_wakes.wgsl b/crates/benilla-world/src/shaders/look_wakes.wgsl
new file mode 100644
index 0000000..0b2cec7
--- /dev/null
+++ b/crates/benilla-world/src/shaders/look_wakes.wgsl
@@ -0,0 +1,236 @@
+// The new look's wakes (`look::wakes`, benilla's own, no reference behaviour): one step of the
+// ripple field round the camera. Each texel holds the surface's height (yd), its velocity
+// potential (yd²/s, the water's drift is its gradient) and its foam:
+//   x = h, y = φ, z = foam, w unused.
+// A linear shallow-water wave, stepped symplectically so it stays stable at any frame rate:
+//   h' = h − dt·∇²φ        φ' = (φ − dt·(c²·h' + p))
+// both kept by the wave's life each step, where p is the pressure the bodies in the water push
+// with. A moving body also pushes along the two arms of a Kelvin wake (about 19.5° either side of
+// its track, trailing from its sides) and lays foam along them and at its sides (only as deep as a
+// swimmer, not a wader's shins); the foam on the arms is carried outward with them, so it stays a
+// V of streaks, and fades over its life. Only the arms and the bodies make foam: a still body's
+// breathing, a raindrop and a ring never do (a body coming in throws a few droplets). The arms'
+// foam is broken into streaks with gaps by a noise along the track, which a streak keeps as the
+// arm carries it outward. `liquid.wgsl` draws the foam as thin lines along its ridges.
+// `look::wakes::cpu_step` is this step in Rust for the tests (keep in sync).
+
+struct WakeParams {
+    // [grid texels, texel (yd), step (s), steps this frame]
+    head: vec4<f32>,
+    // [wave speed², wave kept a step, foam kept a step, drift]
+    wave: vec4<f32>,
+    // [body foam scale, crest foam, crest from (yd/s), foam most]
+    foam: vec4<f32>,
+    // [rain drops a texel a step, rain drop (yd²/s), droplet foam, edge texels]
+    more: vec4<f32>,
+    // [clock at the first step (s), first step's number, shift x, shift z (texels)]
+    clock: vec4<f32>,
+    // [origin x, origin z (yd), origin cell x, origin cell z]
+    place: vec4<f32>,
+    // [reset, sources, foam gain, foam a texel takes a second at most]
+    misc: vec4<f32>,
+    // The Kelvin arms: [tan of their angle, its cos, width (yd), widening a yard back]
+    arm: vec4<f32>,
+    // [arm push (a share of the body's), arm foam a second, arm foam falls over (yd), the share
+    // of texels a droplet lands on]
+    arm2: vec4<f32>,
+    // The arms' break-up: [its stretch along the track (yd), the least foam in a gap, the noise
+    // the gaps are cut at], and how far out the droplets land (radii).
+    brk: vec4<f32>,
+    // Five rows a source: [from x, from z, to x, to z] (yd, over the whole frame) ·
+    // [radius (yd), push, foam, a ring's push at once] · [idle push, idle Hz, phase, wake 0-1] ·
+    // [velocity x, z (yd/s), arm length (yd), arm foam 0-1] · [droplets, 0, 0, 0].
+    src: array<vec4<f32>, 160>,
+};
+
+@group(0) @binding(0) var field_in: texture_2d<f32>;
+@group(0) @binding(1) var field_out: texture_storage_2d<rgba16float, write>;
+@group(0) @binding(2) var<uniform> p: WakeParams;
+// x = this step's number within the frame.
+@group(0) @binding(3) var<uniform> step: vec4<u32>;
+// [foam texels over 0.3, moving texels (|h| over 0.005 yd), 0, 0], counted on the frame's last step.
+@group(0) @binding(4) var<storage, read_write> stats: array<atomic<u32>, 4>;
+
+// The texel the field held at `c` before this step: the first step reads through the shift (the
+// field follows the camera a whole texel at a time) and reads nothing after a reset; outside the
+// field is calm water.
+fn wake_load(c: vec2<i32>) -> vec4<f32> {
+    let n = i32(p.head.x);
+    var q = c;
+    if (step.x == 0u) {
+        if (p.misc.x > 0.5) {
+            return vec4<f32>(0.0);
+        }
+        q = c + vec2<i32>(i32(p.clock.z), i32(p.clock.w));
+    }
+    if (any(q < vec2<i32>(0)) || any(q >= vec2<i32>(n))) {
+        return vec4<f32>(0.0);
+    }
+    return textureLoad(field_in, q, 0);
+}
+
+// The foam at `t` (texel units, centres at +0.5), bilinear.
+fn wake_foam_at(t: vec2<f32>) -> f32 {
+    let f = t - vec2<f32>(0.5);
+    let i = floor(f);
+    let w = f - i;
+    let c = vec2<i32>(i);
+    let a = wake_load(c).z;
+    let b = wake_load(c + vec2<i32>(1, 0)).z;
+    let d = wake_load(c + vec2<i32>(0, 1)).z;
+    let e = wake_load(c + vec2<i32>(1, 1)).z;
+    return mix(mix(a, b, w.x), mix(d, e, w.x), w.y);
+}
+
+// The squared distance from `x` to the segment `a`–`b`.
+fn wake_seg_d2(x: vec2<f32>, a: vec2<f32>, b: vec2<f32>) -> f32 {
+    let v = b - a;
+    let l2 = max(dot(v, v), 1e-8);
+    let s = clamp(dot(x - a, v) / l2, 0.0, 1.0);
+    let d = x - a - s * v;
+    return dot(d, d);
+}
+
+fn wake_hash(c: vec2<i32>, n: u32) -> f32 {
+    var h = bitcast<u32>(c.x) * 374761393u + bitcast<u32>(c.y) * 668265263u + n * 2246822519u;
+    h = (h ^ (h >> 13u)) * 1274126177u;
+    h = h ^ (h >> 16u);
+    return f32(h) * (1.0 / 4294967296.0);
+}
+
+// How much of the arms' foam is born at `s` yards along a body's track: a smooth noise over
+// stretches of `p.brk.x`, cut into streaks and gaps. Foam carried outward from the track keeps its
+// place along it, so a gap stays a gap.
+fn wake_break(s: f32) -> f32 {
+    let q = s / max(p.brk.x, 0.05);
+    let i = floor(q);
+    var f = q - i;
+    f = f * f * (3.0 - 2.0 * f);
+    let n = mix(wake_hash(vec2<i32>(i32(i), 0), 7u), wake_hash(vec2<i32>(i32(i) + 1, 0), 7u), f);
+    return p.brk.y + (1.0 - p.brk.y) * smoothstep(p.brk.z - 0.15, p.brk.z + 0.15, n);
+}
+
+@compute @workgroup_size(8, 8, 1)
+fn step_field(@builtin(global_invocation_id) id: vec3<u32>) {
+    let n = i32(p.head.x);
+    let c = vec2<i32>(id.xy);
+    if (any(c >= vec2<i32>(n))) {
+        return;
+    }
+    let dx = p.head.y;
+    let dt = p.head.z;
+    let steps = max(p.head.w, 1.0);
+    let k = f32(step.x);
+
+    let s = wake_load(c);
+    let xl = wake_load(c - vec2<i32>(1, 0));
+    let xr = wake_load(c + vec2<i32>(1, 0));
+    let zl = wake_load(c - vec2<i32>(0, 1));
+    let zr = wake_load(c + vec2<i32>(0, 1));
+    // World-anchored, so raindrops and droplets do not slide with the field.
+    let cell = c + vec2<i32>(i32(p.place.z), i32(p.place.w));
+
+    // The bodies: the pressure each pushes with along its path through this step and along its
+    // wake's arms, the foam it lays at its sides and on the arms, the arms' outward carry, and the
+    // splash of one that came in this frame with its droplets.
+    let x = p.place.xy + (vec2<f32>(c) + vec2<f32>(0.5)) * dx;
+    let t = p.clock.x + k * dt;
+    var press = 0.0;
+    var churn = 0.0;
+    var arms = 0.0;
+    var carry = vec2<f32>(0.0);
+    var splash = 0.0;
+    var drops = 0.0;
+    let count = u32(p.misc.y);
+    for (var i = 0u; i < count; i = i + 1u) {
+        let s0 = p.src[5u * i];
+        let s1 = p.src[5u * i + 1u];
+        let s2 = p.src[5u * i + 2u];
+        let s3 = p.src[5u * i + 3u];
+        let s4 = p.src[5u * i + 4u];
+        let r2 = max(s1.x * s1.x, 1e-4);
+        let a = mix(s0.xy, s0.zw, k / steps);
+        let b = mix(s0.xy, s0.zw, (k + 1.0) / steps);
+
+        // The Kelvin arms, behind a moving body: `along` yards back from it, `side` across.
+        let sp = length(s3.xy);
+        if (s2.w > 0.0 && sp > 0.3) {
+            let d = s3.xy / sp;
+            let across = vec2<f32>(-d.y, d.x);
+            let rel = x - b;
+            let along = -dot(rel, d);
+            let side = dot(rel, across);
+            let reach = s3.z;
+            let line = s1.x + max(along, 0.0) * p.arm.x;
+            if (along > -1.0 && along < reach + 1.5 && abs(side) < line + 1.2) {
+                let off = abs(abs(side) - line) * p.arm.y;
+                let wid = p.arm.z + p.arm.w * max(along, 0.0);
+                let on_len = smoothstep(-s1.x, 0.3, along) * (1.0 - smoothstep(0.7 * reach, reach, along));
+                let g_arm = exp(-off * off / (wid * wid)) * on_len * s2.w;
+                press += s1.y * p.arm2.x * g_arm;
+                let g_foam = g_arm * wake_break(dot(x, d)) * s3.w;
+                churn += p.arm2.y * g_foam * exp(-max(along, 0.0) / p.arm2.z);
+                arms += g_foam;
+                // Outward from the track as fast as the arm moves, so its foam rides on it.
+                let m = smoothstep(-1.0, 0.0, along) * (1.0 - smoothstep(reach, reach + 1.5, along))
+                    * (1.0 - smoothstep(line + 0.4, line + 1.2, abs(side))) * s2.w;
+                carry += across * (m * sp * p.arm.x * sign(side));
+            }
+        }
+
+        let d2 = wake_seg_d2(x, a, b);
+        if (d2 > 9.0 * r2) {
+            continue;
+        }
+        let g = exp(-d2 / r2);
+        press += (s1.y + s2.x * sin(6.2831853 * s2.y * t + s2.z)) * g;
+        churn += s1.z * exp(-d2 / (1.69 * r2)) * clamp(d2 / r2, 0.0, 1.0);
+        if (step.x == 0u && s1.w > 0.0) {
+            splash += s1.w * exp(-d2 / (2.25 * r2));
+        }
+        // A few droplets round it, not a disc.
+        if (step.x == 0u && s4.x > 0.0) {
+            let ring = sqrt(d2) - p.brk.w * s1.x;
+            if (wake_hash(cell, u32(p.clock.y) + 7919u) < p.arm2.w) {
+                drops += s4.x * exp(-ring * ring / (0.36 * r2));
+            }
+        }
+    }
+
+    // The wave.
+    let lap = (xl.y + xr.y + zl.y + zr.y - 4.0 * s.y) / (dx * dx);
+    var h = s.x - dt * lap;
+    var phi = s.y - dt * (p.wave.x * h + press) - splash;
+    // Raindrops: rings only.
+    if (p.more.x > 0.0 && wake_hash(cell, u32(p.clock.y) + step.x) < p.more.x) {
+        phi -= p.more.y;
+    }
+    // A sponge round the edge, so nothing comes back off it.
+    let edge = f32(min(min(c.x, n - 1 - c.x), min(c.y, n - 1 - c.y)));
+    let e = clamp(edge / max(p.more.w, 1.0), 0.0, 1.0);
+    let keep = p.wave.y * (1.0 - 0.2 * (1.0 - e) * (1.0 - e));
+    h *= keep;
+    phi *= keep;
+
+    // The foam, carried back along the drift and out with the arms; born at the bodies' sides,
+    // on the arms and on the crests rising along them, never more than a texel takes a second,
+    // and less while the field is already foamy (`misc.z`).
+    let drift = vec2<f32>(xr.y - xl.y, zr.y - zl.y) / (2.0 * dx);
+    let back = vec2<f32>(c) + vec2<f32>(0.5) - (drift * p.wave.w + carry) * (dt / dx);
+    let rise = (h - s.x) / dt;
+    let crest = max(rise - p.foam.z, 0.0) * select(0.0, 1.0, h > 0.0) * min(arms, 1.0);
+    let born = min((churn * p.foam.x + crest * p.foam.y) * dt, p.misc.w * dt) * p.misc.z;
+    var foam = wake_foam_at(back) + born + drops * p.more.z;
+    foam = min(foam * p.wave.z, p.foam.w);
+
+    textureStore(field_out, c, vec4<f32>(h, phi, foam, 0.0));
+
+    if (step.x + 1u == u32(steps)) {
+        if (foam > 0.3) {
+            atomicAdd(&stats[0], 1u);
+        }
+        if (abs(h) > 0.005) {
+            atomicAdd(&stats[1], 1u);
+        }
+    }
+}
diff --git a/crates/benilla-world/src/shaders/look_water_surface.wgsl b/crates/benilla-world/src/shaders/look_water_surface.wgsl
new file mode 100644
index 0000000..96f8250
--- /dev/null
+++ b/crates/benilla-world/src/shaders/look_water_surface.wgsl
@@ -0,0 +1,82 @@
+// The open water's moving surface under the wakes (`look::water_surface`, benilla's own; no
+// reference behaviour): bakes one tile of four layers of drifting wavelets into the surface map
+// once a frame, the long pair's slope (x, z) in `xy` and the short pair's in `zw`, each per cell of
+// its own layer, weighted, the four together of root mean square 1. Every layer is periodic over
+// the tile; its drift (cells, wrapped) comes from the CPU. Keep in sync with
+// `look::water_surface`'s `surface_hash`, `surface_noise`, `bake_at` and `tune`.
+
+struct SurfaceParams {
+    // [layer 0 offset (cells), layer 1 offset] · [layer 2, layer 3] · [texels a side, tile (yd), 0, 0] ·
+    // [the four layers' weights, multiples of `weight_of` (`lookwater tune coarse|mid|fine`)]
+    rows: array<vec4<f32>, 4>,
+};
+
+@group(0) @binding(0) var surface_map: texture_storage_2d<rgba16float, write>;
+@group(0) @binding(1) var<uniform> sp: SurfaceParams;
+
+// `tune::NOISE_RMS`; `tune::CELLS` and `tune::WEIGHT` are `bake`'s first lines.
+const SURFACE_NOISE_RMS: f32 = 0.625;
+
+fn surface_hash(c: vec2<i32>, period: i32, layer: u32) -> f32 {
+    let w = ((c % vec2<i32>(period)) + vec2<i32>(period)) % vec2<i32>(period);
+    var h = bitcast<u32>(w.x) * 374761393u + bitcast<u32>(w.y) * 668265263u + layer * 2246822519u;
+    h = (h ^ (h >> 13u)) * 1274126177u;
+    h = h ^ (h >> 16u);
+    return f32(h) * (1.0 / 4294967296.0);
+}
+
+fn surface_grad(c: vec2<i32>, period: i32, layer: u32) -> vec2<f32> {
+    let a = 6.2831853 * surface_hash(c, period, layer);
+    return vec2<f32>(cos(a), sin(a));
+}
+
+// Gradient noise at `p` (cells), periodic over `period` cells: (value, d/dx, d/dy).
+fn surface_noise(p: vec2<f32>, period: i32, layer: u32) -> vec3<f32> {
+    let i = floor(p);
+    let f = p - i;
+    let c = vec2<i32>(i);
+    let ga = surface_grad(c, period, layer);
+    let gb = surface_grad(c + vec2<i32>(1, 0), period, layer);
+    let gc = surface_grad(c + vec2<i32>(0, 1), period, layer);
+    let gd = surface_grad(c + vec2<i32>(1, 1), period, layer);
+    let va = dot(ga, f);
+    let vb = dot(gb, f - vec2<f32>(1.0, 0.0));
+    let vc = dot(gc, f - vec2<f32>(0.0, 1.0));
+    let vd = dot(gd, f - vec2<f32>(1.0, 1.0));
+    let u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
+    let du = 30.0 * f * f * (f * (f - 2.0) + 1.0);
+    let k = va - vb - vc + vd;
+    let value = va + u.x * (vb - va) + u.y * (vc - va) + u.x * u.y * k;
+    let d = ga + u.x * (gb - ga) + u.y * (gc - ga) + u.x * u.y * (ga - gb - gc + gd)
+        + du * (vec2<f32>(u.y, u.x) * k + vec2<f32>(vb - va, vc - va));
+    return vec3<f32>(value, d);
+}
+
+@compute @workgroup_size(8, 8, 1)
+fn bake(@builtin(global_invocation_id) id: vec3<u32>) {
+    let n = u32(sp.rows[2].x);
+    if (id.x >= n || id.y >= n) {
+        return;
+    }
+    let uv = (vec2<f32>(id.xy) + vec2<f32>(0.5)) / f32(n);
+    var cells_of = array<i32, 4>(8, 20, 72, 128);
+    var weight_of = array<f32, 4>(0.5, 0.45, 0.6, 0.6);
+    var offs = array<vec2<f32>, 4>(sp.rows[0].xy, sp.rows[0].zw, sp.rows[1].xy, sp.rows[1].zw);
+    var swell = vec2<f32>(0.0);
+    var grain = vec2<f32>(0.0);
+    var w2 = 0.0;
+    for (var i = 0u; i < 4u; i = i + 1u) {
+        let cells = cells_of[i];
+        // The knobs scale a layer's weight; the scale below stays the tuned weights', so a layer
+        // turned down takes its slope away.
+        let g = surface_noise(uv * f32(cells) + offs[i], cells, i).yz * (weight_of[i] * sp.rows[3][i]);
+        if (i < 2u) {
+            swell += g;
+        } else {
+            grain += g;
+        }
+        w2 += weight_of[i] * weight_of[i];
+    }
+    let norm = 1.0 / (SURFACE_NOISE_RMS * 1.41421356 * sqrt(w2));
+    textureStore(surface_map, vec2<i32>(id.xy), vec4<f32>(swell, grain) * norm);
+}
