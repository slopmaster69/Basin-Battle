+    /// The knobs: unique names, defaults inside their ranges, packed four a row in order, and
+    /// `coarse`, `mid` and `fine` the bake's weights.
+    #[test]
+    fn the_knobs_pack_in_order() {
+        for (i, a) in KNOBS.iter().enumerate() {
+            assert!(
+                (a.range.0..=a.range.1).contains(&a.default),
+                "{} {}",
