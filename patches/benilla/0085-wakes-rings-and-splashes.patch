+
+    #[test]
+    fn a_body_pushes_only_in_the_water_and_harder_as_it_goes() {
+        let swim = Vec2::new(4.0, 0.0);
+        assert!(body_source(0.0, 4.0, swim, 1.0).is_none(), "dry");
+        assert!(
+            body_source(5.0, 4.0, swim, 1.0).is_none(),
+            "too deep to reach the top"
