@@ -0,0 +1,990 @@
+//! Wakes, the new look's own (no reference behaviour): water that answers what moves through it,
+//! as WoW Forever's lakes do. A swimmer leaves a crisp white wake fanning out behind him in a V,
+//! a hero wading in sends rings out and splashes where he steps in, a bobber sits in a small
+//! disturbance, and rain dimples the surface.
+//!
+//! 1. **The ripple field**: a square of [`tune::GRID`]² texels over [`tune::SPAN_YD`] yards round
+//!    the camera (a little ahead of it, where the view falls), snapped to whole texels so it never
+//!    swims, and stepped each frame on the GPU (`look::wakes_pass`, `look_wakes.wgsl`) as a
+//!    linear shallow-water wave at fixed steps of [`tune::STEP_S`]: [`cpu_step`] is the same step
+//!    in Rust, for the tests.
+//! 2. **What pushes it** ([`publish_wakes`]): every unit whose feet are in the water (wading or
+//!    swimming, by its speed; a still one only breathes gentle rings), a splash where one comes in,
+//!    a fishing bobber ([`crate::world_unit::Bobber`]), and raindrops while it rains
+//!    (`look::weather`); the nearest [`tune::MAX_SOURCES`] to the field.
+//! 3. **Foam**: born where a body churns the water and on the rising crests it sends out, carried
+//!    by the water's drift, fading over [`tune::FOAM_LIFE_S`]: the trailing V with its streaks.
+//!    `liquid.wgsl` draws it white, drawn out along the crests into curling streaks.
+//! 4. The field's slopes add to the water's own ripples, so the mirror, the glint and the
+//!    refracted bed (`liquid.wgsl`) all move with it.
+//!
+//! While the wakes are on they take the place of 0081's wading froth and of 1.12's own wade wake
+//! and rings (`water_fx`), which would draw a second, older ring over them. `lookwater wakes 0`
+//! brings both back; `worldWater 0` and `worldLook 0` run 1.12's water and foam untouched.
+
+use bevy::ecs::entity::EntityHashMap;
+use bevy::prelude::*;
+use bevy::render::extract_resource::ExtractResource;
+
+use benilla_assets::coords::bevy_to_wow;
+
+use super::{LookWater, WorldLook};
+use crate::liquid::{FoamPatch, WaterChunkInfo, WaterIndex};
+use crate::view::{Viewer, WorldCamera};
+use crate::world_unit::{Bobber, ViewerUnit, WorldUnit};
+
+/// Every tunable of the wakes, in one place. Lengths are yards, times seconds. A first pass from
+/// the reference video (a swimmer's wake in a retail pond, seen from above), to tune on film.
+pub mod tune {
+    /// The field's texels a side and the yards it spans: a quarter of a yard a texel.
+    pub const GRID: u32 = 256;
+    pub const SPAN_YD: f32 = 64.0;
+    /// How far ahead of the camera, along its view on the ground, the field's centre lies, as a
+    /// share of its span: a camera looking down on the hero from 15 yd has him about 10 yd ahead.
+    pub const AHEAD: f32 = 0.25;
+    /// One step, fixed whatever the frame rate; steps run in pairs (the field ends each frame in
+    /// the texture the water reads), at most [`MAX_PAIRS`] a frame, so a slow frame drops time
+    /// rather than stall.
+    pub const STEP_S: f32 = 1.0 / 120.0;
+    pub const MAX_PAIRS: u32 = 3;
+    /// How fast a ring travels (yd/s). A swimmer at 4.7 yd/s outruns it, so his rings pile up
+    /// into a V about 25° either side of his track, as a boat's does.
+    pub const WAVE_SPEED: f32 = 2.0;
+    /// A ring fades to a third over this long, and the foam does.
+    pub const WAVE_LIFE_S: f32 = 1.4;
+    pub const FOAM_LIFE_S: f32 = 0.55;
+    /// The pressure a body pushes with for each yd/s it moves at (up to [`PUSH_SPEED_MOST`]),
+    /// and the gentle breathing push of one standing still, at [`IDLE_HZ`].
+    pub const PUSH: f32 = 0.15;
+    pub const PUSH_SPEED_MOST: f32 = 8.0;
+    pub const IDLE_PUSH: f32 = 0.03;
+    pub const IDLE_HZ: f32 = 1.3;
+    /// A body's radius at the waterline at model scale 1.
+    pub const RADIUS: f32 = 0.35;
+    /// The foam a body churns at its sides (per second, at 4 yd/s, at most 1.5 times it), the
+    /// foam a rising crest makes per yd/s it rises faster than [`CREST_FROM`], and the most foam
+    /// a texel holds.
+    pub const BODY_FOAM: f32 = 8.0;
+    pub const CREST_FOAM: f32 = 80.0;
+    /// Above a still body's breathing (its crests rise at most about 0.06 yd/s), so a hero
+    /// standing in the water makes rings and no foam.
+    pub const CREST_FROM: f32 = 0.07;
+    pub const FOAM_MOST: f32 = 2.0;
+    /// How much faster than the water's own drift the foam is carried: the drift of a small
+    /// ripple is a few inches a second, the foam on a wake spreads at about half a yard.
+    pub const DRIFT: f32 = 6.0;
+    /// A body coming into the water: the splash's push (yd²/s, at once) and the foam it throws, a
+    /// share of the splash.
+    pub const SPLASH: f32 = 0.3;
+    pub const SPLASH_FOAM: f32 = 4.0;
+    /// Raindrops while it rains (a drop on this many texels a second at full rain, about two a
+    /// square yard), each this hard.
+    pub const RAIN_RATE: f32 = 0.125;
+    pub const RAIN_DROP: f32 = 0.03;
+    /// A fishing bobber: a small body nodding at this push and rate.
+    pub const BOBBER_RADIUS: f32 = 0.15;
+    pub const BOBBER_PUSH: f32 = 0.015;
+    pub const BOBBER_HZ: f32 = 0.7;
+    /// How far under the surface a bobber's origin may sit, or over it.
+    pub const BOBBER_REACH: f32 = 0.6;
+    /// The texels round the edge that soak up what reaches them.
+    pub const EDGE_TEXELS: f32 = 8.0;
+    /// The most bodies pushing at once: the nearest to the field.
+    pub const MAX_SOURCES: usize = 32;
+    /// A body counts as in the water from this deep (yd) to its gate, `max(2·height, 1)`, as 1.12's
+    /// foam; it pushes harder as it goes in, fully from [`FULL_DEPTH`].
+    pub const WET_FROM: f32 = 0.02;
+    pub const FULL_DEPTH: f32 = 0.6;
+    /// A body that jumps further than this in a frame (a teleport, a zone-in) leaves no streak.
+    pub const JUMP_YD: f32 = 6.0;
+    /// In `liquid.wgsl`: how much the field's slopes tilt the water's normal, the most a foam
+    /// streak hides of the water, and where the foam shows (its value against the streak noise, a
+    /// crisp edge over [`FOAM_EDGE`]).
+    pub const NORMAL_GAIN: f32 = 1.0;
+    pub const FOAM_SHOW: f32 = 0.9;
+    pub const FOAM_FROM: f32 = 0.5;
+    pub const FOAM_EDGE: f32 = 0.12;
+    /// Log the counts this often while something moves the water.
+    pub const LOG_EVERY_S: f32 = 10.0;
+}
+
+/// The yards a texel spans.
+pub const TEXEL_YD: f32 = tune::SPAN_YD / tune::GRID as f32;
+
+/// `lookwater wakes`: the wakes on or off under the new water (on by default); the console's
+/// holds of the refraction and the light on the bed live with them (`lookwater refract`,
+/// `lookwater caustics`).
+#[derive(Resource, Clone, Copy, Debug, PartialEq)]
+pub struct LookWakes {
+    pub on: bool,
+    pub refract: Option<f32>,
+    pub caustics: Option<f32>,
+}
+
+impl Default for LookWakes {
+    fn default() -> Self {
+        Self {
+            on: true,
+            refract: None,
+            caustics: None,
+        }
+    }
+}
+
+/// One of `lookwater`'s words for the wakes and the bed under the water.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum WakesCommand {
+    /// `wakes <0|1>`, or `wakes` alone to read the counts.
+    Wakes(Option<bool>),
+    /// `refract <0-2>` (a multiple of the tuned), or `refract grade`.
+    Refract(Option<f32>),
+    /// `caustics <0-2>`, or `caustics grade`.
+    Caustics(Option<f32>),
+}
+
+impl LookWakes {
+    /// `lookwater wakes|refract|caustics ...`; `None` when the words are not one of these, which
+    /// `lookwater`'s own mirror and clarity then read.
+    pub fn parse(args: &str) -> Option<Result<WakesCommand, ()>> {
+        let mut words = args.split_whitespace();
+        let head = words.next()?.to_ascii_lowercase();
+        let value = words.next();
+        if words.next().is_some() {
+            return matches!(head.as_str(), "wakes" | "refract" | "caustics").then_some(Err(()));
+        }
+        let scale = |w: Option<&str>| -> Result<Option<f32>, ()> {
+            match w {
+                Some(w) if w.eq_ignore_ascii_case("grade") => Ok(None),
+                Some(w) => w
+                    .parse::<f32>()
+                    .ok()
+                    .filter(|v| (0.0..=2.0).contains(v))
+                    .map(Some)
+                    .ok_or(()),
+                None => Err(()),
+            }
+        };
+        Some(match head.as_str() {
+            "wakes" => match value {
+                None => Ok(WakesCommand::Wakes(None)),
+                Some("0") => Ok(WakesCommand::Wakes(Some(false))),
+                Some("1") => Ok(WakesCommand::Wakes(Some(true))),
+                Some(_) => Err(()),
+            },
+            "refract" => scale(value).map(WakesCommand::Refract),
+            "caustics" => scale(value).map(WakesCommand::Caustics),
+            _ => return None,
+        })
+    }
+}
+
+/// One body pushing on the field this frame: its path since the field last stepped (Bevy XZ), its
+/// radius, its steady push and foam, a splash if it came in, and its idle breathing.
+#[derive(Clone, Copy, Debug, PartialEq, Default)]
+pub struct WakeSource {
+    pub from: Vec2,
+    pub to: Vec2,
+    pub radius: f32,
+    pub push: f32,
+    pub foam: f32,
+    pub splash: f32,
+    pub idle: f32,
+    pub idle_hz: f32,
+    pub phase: f32,
+}
+
+/// This frame's wakes, from [`publish_wakes`] to the render world (`look::wakes_pass`) and the
+/// water block: whether they run, the field's place after this frame's steps, how far it moved,
+/// how many step pairs to run and what pushes.
+#[derive(Resource, Clone, Debug, PartialEq, ExtractResource)]
+pub struct WakeFrame {
+    pub on: bool,
+    /// The field starts over from calm water (just switched on, or the camera jumped).
+    pub reset: bool,
+    /// The field's lowest corner (Bevy X, Z) in whole texels, and in yards.
+    pub cell: IVec2,
+    pub origin: Vec2,
+    /// Texels the field moved since it last stepped.
+    pub shift: IVec2,
+    pub pairs: u32,
+    /// The field's clock at this frame's first step, and that step's number (wrapped).
+    pub clock: f32,
+    pub first_step: u32,
+    /// The rain, 0 to 1.
+    pub rain: f32,
+    pub sources: Vec<WakeSource>,
+}
+
+impl Default for WakeFrame {
+    fn default() -> Self {
+        Self {
+            on: false,
+            reset: true,
+            cell: IVec2::ZERO,
+            origin: Vec2::ZERO,
+            shift: IVec2::ZERO,
+            pairs: 0,
+            clock: 0.0,
+            first_step: 0,
+            rain: 0.0,
+            sources: Vec::new(),
+        }
+    }
+}
+
+/// The counts `lookwater wakes` and the log report: the bodies pushing, and from the GPU the foam
+/// and moving texels on the last frame it read back.
+#[derive(Resource, Clone, Copy, Debug, Default, PartialEq)]
+pub struct WakeStats {
+    pub sources: usize,
+    pub foam_texels: u32,
+    pub moving_texels: u32,
+    pub read: bool,
+}
+
+impl WakeStats {
+    /// The share of the field under foam.
+    pub fn foam_share(&self) -> f32 {
+        self.foam_texels as f32 / (tune::GRID * tune::GRID) as f32
+    }
+
+    /// The counts in one line, for the console and the log.
+    pub fn line(&self) -> String {
+        format!(
+            "{} pushing, field {}x{} over {} yd, foam on {:.2}% ({} texels), moving {} texels{}",
+            self.sources,
+            tune::GRID,
+            tune::GRID,
+            tune::SPAN_YD,
+            100.0 * self.foam_share(),
+            self.foam_texels,
+            self.moving_texels,
+            if self.read {
+                ""
+            } else {
+                " (not read back yet)"
+            },
+        )
+    }
+}
+
+/// A body's place the field last stepped to, and whether it was in the water.
+#[derive(Clone, Copy, Debug)]
+struct Body {
+    stepped: Vec2,
+    last: Vec3,
+    wet: bool,
+    seen: bool,
+}
+
+/// The wakes' memory across frames: the time not yet stepped, the field's place, its clock, and
+/// the bodies.
+#[derive(Resource, Default)]
+pub(crate) struct WakeTrack {
+    owed: f32,
+    cell: Option<IVec2>,
+    clock: f32,
+    steps: u32,
+    was_on: bool,
+    bodies: EntityHashMap<Body>,
+    since_log: f32,
+}
+
+/// The step pairs a frame of `dt` seconds pays for, out of what is `owed`: whole pairs, at most
+/// [`tune::MAX_PAIRS`]; a slow frame forgets the rest rather than catching up.
+pub fn pairs_for(owed: &mut f32, dt: f32) -> u32 {
+    let pair = 2.0 * tune::STEP_S;
+    *owed += dt.clamp(0.0, 0.25);
+    let pairs = ((*owed / pair).floor() as u32).min(tune::MAX_PAIRS);
+    *owed -= pairs as f32 * pair;
+    if pairs == tune::MAX_PAIRS {
+        *owed = owed.min(pair);
+    }
+    pairs
+}
+
+/// The field's lowest corner, in whole texels, for a camera at `eye` (Bevy) looking along `fwd`:
+/// centred [`tune::AHEAD`] of the span ahead of it on the ground.
+pub fn field_cell(eye: Vec3, fwd: Vec3) -> IVec2 {
+    let flat = Vec2::new(fwd.x, fwd.z).normalize_or_zero();
+    let centre = Vec2::new(eye.x, eye.z) + flat * (tune::AHEAD * tune::SPAN_YD);
+    (centre / TEXEL_YD).floor().as_ivec2() - IVec2::splat(tune::GRID as i32 / 2)
+}
+
+fn smoothstep(e0: f32, e1: f32, x: f32) -> f32 {
+    let t = ((x - e0) / (e1 - e0)).clamp(0.0, 1.0);
+    t * t * (3.0 - 2.0 * t)
+}
+
+/// A body's push for this frame: `depth` its feet under the surface (yd), `speed` its planar
+/// speed (yd/s), `scale` its model's; `None` out of the water or too deep to reach the surface
+/// (`gate`).
+pub fn body_source(depth: f32, gate: f32, speed: f32, scale: f32) -> Option<WakeSource> {
+    if depth < tune::WET_FROM || depth > gate {
+        return None;
+    }
+    let wet = smoothstep(tune::WET_FROM, tune::FULL_DEPTH, depth);
+    let speed = speed.clamp(0.0, tune::PUSH_SPEED_MOST);
+    Some(WakeSource {
+        radius: tune::RADIUS * scale.clamp(0.5, 3.0),
+        push: tune::PUSH * speed * wet,
+        foam: tune::BODY_FOAM * (speed / 4.0).min(1.5) * wet,
+        idle: tune::IDLE_PUSH * wet,
+        idle_hz: tune::IDLE_HZ,
+        ..default()
+    })
+}
+
+/// The compute pass's uniform (`look_wakes.wgsl`'s `WakeParams`): seven rows and three a source,
+/// [`tune::MAX_SOURCES`] of them.
+pub const PARAM_ROWS: usize = 7 + 3 * tune::MAX_SOURCES;
+
+/// [`PARAM_ROWS`] for this frame.
+pub fn pack_params(frame: &WakeFrame) -> Vec<[f32; 4]> {
+    let mut rows = vec![[0.0; 4]; PARAM_ROWS];
+    let steps = 2 * frame.pairs;
+    rows[0] = [tune::GRID as f32, TEXEL_YD, tune::STEP_S, steps as f32];
+    rows[1] = [
+        tune::WAVE_SPEED * tune::WAVE_SPEED,
+        (-tune::STEP_S / tune::WAVE_LIFE_S).exp(),
+        (-tune::STEP_S / tune::FOAM_LIFE_S).exp(),
+        tune::DRIFT,
+    ];
+    // The bodies' foam comes in their own rows ([`body_source`]); 1 here takes it as it is.
+    rows[2] = [1.0, tune::CREST_FOAM, tune::CREST_FROM, tune::FOAM_MOST];
+    let rain = tune::RAIN_RATE * frame.rain.clamp(0.0, 1.0) * tune::STEP_S;
+    rows[3] = [rain, tune::RAIN_DROP, tune::SPLASH_FOAM, tune::EDGE_TEXELS];
+    rows[4] = [
+        frame.clock,
+        frame.first_step as f32,
+        frame.shift.x as f32,
+        frame.shift.y as f32,
+    ];
+    rows[5] = [
+        frame.origin.x,
+        frame.origin.y,
+        frame.cell.x as f32,
+        frame.cell.y as f32,
+    ];
+    let n = frame.sources.len().min(tune::MAX_SOURCES);
+    rows[6] = [if frame.reset { 1.0 } else { 0.0 }, n as f32, 0.0, 0.0];
+    for (i, s) in frame.sources.iter().take(n).enumerate() {
+        rows[7 + 3 * i] = [s.from.x, s.from.y, s.to.x, s.to.y];
+        rows[8 + 3 * i] = [s.radius, s.push, s.foam, s.splash];
+        rows[9 + 3 * i] = [s.idle, s.idle_hz, s.phase, 0.0];
+    }
+    rows
+}
+
+/// The water block's wake rows (`look::water::pack_rows`, rows 23 to 25), all zero with the wakes
+/// off: `[on, origin x, origin z, span]`.
+pub fn water_row(frame: &WakeFrame) -> [f32; 4] {
+    if !frame.on {
+        return [0.0; 4];
+    }
+    [1.0, frame.origin.x, frame.origin.y, tune::SPAN_YD]
+}
+
+/// The surface over a WoW-space point, from the water chunks under it.
+fn surface_at(
+    index: &WaterIndex,
+    water: &Query<&WaterChunkInfo, With<FoamPatch>>,
+    wow: [f32; 3],
+) -> Option<f32> {
+    index
+        .over(wow[0], wow[1])
+        .iter()
+        .find_map(|&e| water.get(e).ok()?.surface_z_at(wow[0], wow[1]))
+}
+
+fn phase_of(e: Entity) -> f32 {
+    let h = (e.to_bits() as u32).wrapping_mul(2_654_435_761);
+    (h >> 8) as f32 / 16_777_216.0 * std::f32::consts::TAU
+}
+
+/// Publishes this frame's [`WakeFrame`]: the field's place, the steps owed and every body pushing
+/// on it.
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn publish_wakes(
+    time: Res<Time>,
+    look: Res<WorldLook>,
+    water_on: Res<LookWater>,
+    wakes: Res<LookWakes>,
+    viewer: Res<Viewer>,
+    weather: Option<Res<super::WeatherLook>>,
+    cams: Query<&Transform, With<WorldCamera>>,
+    self_unit: Query<&WorldUnit, With<ViewerUnit>>,
+    units: Query<(Entity, &Transform, &WorldUnit), Without<ViewerUnit>>,
+    bobbers: Query<(Entity, &GlobalTransform), With<Bobber>>,
+    water: Query<&WaterChunkInfo, With<FoamPatch>>,
+    index: Option<Res<WaterIndex>>,
+    mut track: ResMut<WakeTrack>,
+    mut frame: ResMut<WakeFrame>,
+    mut stats: ResMut<WakeStats>,
+) {
+    let on = look.on && water_on.on && wakes.on;
+    let cam = cams.iter().next();
+    let (Some(cam), Some(index), true) = (cam, index, on) else {
+        if frame.on {
+            *frame = WakeFrame::default();
+        }
+        track.was_on = false;
+        track.bodies.clear();
+        stats.sources = 0;
+        return;
+    };
+    let dt = time.delta_secs();
+    let reset = !track.was_on;
+    track.was_on = true;
+    if reset {
+        track.owed = 0.0;
+        track.cell = None;
+        track.bodies.clear();
+    }
+    let pairs = pairs_for(&mut track.owed, dt).max(u32::from(reset));
+    let cell = field_cell(cam.translation, cam.forward().as_vec3());
+    let mut next = WakeFrame {
+        on: true,
+        reset,
+        cell: track.cell.unwrap_or(cell),
+        origin: track.cell.unwrap_or(cell).as_vec2() * TEXEL_YD,
+        shift: IVec2::ZERO,
+        pairs,
+        clock: track.clock,
+        first_step: track.steps,
+        rain: weather.map_or(0.0, |w| w.rings()),
+        sources: Vec::new(),
+    };
+    if pairs > 0 {
+        let shift = cell - track.cell.unwrap_or(cell);
+        next.reset |= shift.abs().max_element() >= tune::GRID as i32;
+        next.shift = shift;
+        next.cell = cell;
+        next.origin = cell.as_vec2() * TEXEL_YD;
+        track.cell = Some(cell);
+        let steps = 2 * pairs;
+        track.clock = (track.clock + steps as f32 * tune::STEP_S) % 3600.0;
+        track.steps = (track.steps + steps) % (1 << 24);
+    }
+
+    // The bodies: the viewer's own and every other that wades, then the bobbers.
+    for b in track.bodies.values_mut() {
+        b.seen = false;
+    }
+    let mut found: Vec<(Entity, Vec3, f32, f32, bool)> = Vec::new();
+    if let Some(at) = viewer.at {
+        let scale = self_unit.single().map(|u| u.scale).unwrap_or(1.0);
+        found.push((Entity::PLACEHOLDER, at, viewer.height, scale, false));
+    }
+    for (e, t, u) in &units {
+        if u.wades {
+            found.push((e, t.translation, u.height, u.scale, false));
+        }
+    }
+    for (e, t) in &bobbers {
+        found.push((e, t.translation(), 0.0, 1.0, true));
+    }
+    let centre = next.origin + Vec2::splat(0.5 * tune::SPAN_YD);
+    let reach = 0.5 * tune::SPAN_YD + 2.0;
+    let mut sources: Vec<(f32, WakeSource)> = Vec::new();
+    let dt = dt.max(1.0e-4);
+    for (e, pos, height, scale, bobber) in found {
+        let flat = Vec2::new(pos.x, pos.z);
+        if (flat - centre).abs().max_element() > reach {
+            continue;
+        }
+        let body = track.bodies.entry(e).or_insert(Body {
+            stepped: flat,
+            last: pos,
+            wet: false,
+            seen: true,
+        });
+        body.seen = true;
+        let moved = pos - body.last;
+        body.last = pos;
+        if moved.length() > tune::JUMP_YD || reset {
+            body.stepped = flat;
+        }
+        let speed = Vec2::new(moved.x, moved.z).length() / dt;
+        let wow = bevy_to_wow(pos);
+        let Some(surface) = surface_at(&index, &water, wow) else {
+            body.wet = false;
+            body.stepped = flat;
+            continue;
+        };
+        let depth = surface - wow[2];
+        let source = if bobber {
+            (depth.abs() <= tune::BOBBER_REACH).then_some(WakeSource {
+                radius: tune::BOBBER_RADIUS,
+                idle: tune::BOBBER_PUSH,
+                idle_hz: tune::BOBBER_HZ,
+                ..default()
+            })
+        } else {
+            let gate = (2.0 * height).max(1.0);
+            body_source(depth, gate, speed, scale)
+        };
+        let Some(mut s) = source else {
+            body.wet = false;
+            body.stepped = flat;
+            continue;
+        };
+        if !body.wet {
+            s.splash = tune::SPLASH * if bobber { 0.4 } else { scale.clamp(0.5, 2.0) };
+            body.wet = true;
+        }
+        s.from = body.stepped;
+        s.to = flat;
+        s.phase = phase_of(e);
+        if pairs > 0 {
+            body.stepped = flat;
+        } else {
+            // Nothing steps this frame: the splash waits for the next that does.
+            body.wet = s.splash == 0.0;
+        }
+        sources.push(((flat - centre).length_squared(), s));
+    }
+    track.bodies.retain(|_, b| b.seen);
+    sources.sort_by(|a, b| a.0.total_cmp(&b.0));
+    next.sources = sources
+        .into_iter()
+        .take(tune::MAX_SOURCES)
+        .map(|(_, s)| s)
+        .collect();
+    stats.sources = next.sources.len();
+
+    track.since_log += dt;
+    if track.since_log >= tune::LOG_EVERY_S && (stats.sources > 0 || stats.foam_texels > 0) {
+        track.since_log = 0.0;
+        info!("[look wakes] {}", stats.line());
+    }
+    if *frame != next {
+        *frame = next;
+    }
+}
+
+/// The wakes' stats buffer, a few counters the pass adds to and the main world reads back.
+#[derive(Resource, Clone, ExtractResource)]
+pub struct WakeStatsBuffer(pub Handle<bevy::render::storage::ShaderStorageBuffer>);
+
+/// The entity that reads the stats back while the wakes are on.
+#[derive(Component)]
+struct WakeReadback;
+
+fn setup_stats(
+    mut commands: Commands,
+    buffers: Option<ResMut<Assets<bevy::render::storage::ShaderStorageBuffer>>>,
+) {
+    use bevy::render::render_resource::BufferUsages;
+    let Some(mut buffers) = buffers else { return };
+    let mut buf = bevy::render::storage::ShaderStorageBuffer::from([0u32; 4]);
+    buf.buffer_description.label = Some("look_wake_stats");
+    buf.buffer_description.usage =
+        BufferUsages::STORAGE | BufferUsages::COPY_SRC | BufferUsages::COPY_DST;
+    commands.insert_resource(WakeStatsBuffer(buffers.add(buf)));
+}
+
+/// Reads the counters back while the wakes run, and stops when they do.
+fn read_stats(
+    mut commands: Commands,
+    frame: Res<WakeFrame>,
+    buffer: Option<Res<WakeStatsBuffer>>,
+    readers: Query<Entity, With<WakeReadback>>,
+    mut stats: ResMut<WakeStats>,
+) {
+    let Some(buffer) = buffer else { return };
+    match (frame.on, readers.iter().next()) {
+        (true, None) => {
+            commands
+                .spawn((
+                    WakeReadback,
+                    bevy::render::gpu_readback::Readback::buffer(buffer.0.clone()),
+                ))
+                .observe(
+                    |ev: On<bevy::render::gpu_readback::ReadbackComplete>,
+                     mut stats: ResMut<WakeStats>| {
+                        let words: Vec<u32> = ev
+                            .data
+                            .as_chunks::<4>()
+                            .0
+                            .iter()
+                            .map(|c| u32::from_le_bytes(*c))
+                            .collect();
+                        if words.len() >= 2 {
+                            stats.foam_texels = words[0];
+                            stats.moving_texels = words[1];
+                            stats.read = true;
+                        }
+                    },
+                );
+        }
+        (false, Some(e)) => {
+            commands.entity(e).despawn();
+            *stats = WakeStats::default();
+        }
+        _ => {}
+    }
+}
+
+/// Inserts the two field images before any liquid material is made, so none waits on them.
+pub(crate) fn insert_wake_field(images: Option<ResMut<Assets<Image>>>) {
+    use benilla_assets::materials::{wake_field_image, WAKE_FIELD, WAKE_FIELD_B};
+    let Some(mut images) = images else { return };
+    for handle in [WAKE_FIELD, WAKE_FIELD_B] {
+        if images.get(handle.id()).is_none() {
+            let _ = images.insert(handle.id(), wake_field_image(tune::GRID));
+        }
+    }
+}
+
+pub(crate) fn init_resources(app: &mut App) {
+    app.init_resource::<LookWakes>()
+        .init_resource::<WakeFrame>()
+        .init_resource::<WakeStats>()
+        .init_resource::<WakeTrack>();
+}
+
+pub(super) fn build(app: &mut App) {
+    app.add_systems(Startup, setup_stats)
+        .add_systems(PostUpdate, read_stats);
+}
+
+/// The field on the CPU: `look_wakes.wgsl`'s step in Rust, for the tests (keep in sync). `n`
+/// texels a side, each `[h, φ, foam, 0]`.
+#[derive(Clone)]
+pub struct CpuField {
+    pub n: usize,
+    pub texels: Vec<[f32; 4]>,
+}
+
+impl CpuField {
+    pub fn new(n: usize) -> Self {
+        Self {
+            n,
+            texels: vec![[0.0; 4]; n * n],
+        }
+    }
+
+    fn at(&self, x: i32, z: i32) -> [f32; 4] {
+        let n = self.n as i32;
+        if x < 0 || z < 0 || x >= n || z >= n {
+            return [0.0; 4];
+        }
+        self.texels[(z * n + x) as usize]
+    }
+
+    fn foam_at(&self, t: Vec2) -> f32 {
+        let f = t - Vec2::splat(0.5);
+        let i = f.floor();
+        let w = f - i;
+        let (x, z) = (i.x as i32, i.y as i32);
+        let a = self.at(x, z)[2];
+        let b = self.at(x + 1, z)[2];
+        let d = self.at(x, z + 1)[2];
+        let e = self.at(x + 1, z + 1)[2];
+        let lerp = |p: f32, q: f32, s: f32| p + (q - p) * s;
+        lerp(lerp(a, b, w.x), lerp(d, e, w.x), w.y)
+    }
+
+    /// The texel holding Bevy XZ `p` when the field's corner is at `origin`.
+    pub fn texel_of(&self, origin: Vec2, p: Vec2) -> Option<[f32; 4]> {
+        let t = ((p - origin) / TEXEL_YD).floor();
+        let n = self.n as f32;
+        (t.x >= 0.0 && t.y >= 0.0 && t.x < n && t.y < n).then(|| self.at(t.x as i32, t.y as i32))
+    }
+}
+
+/// One step `k` of `steps` of the field on the CPU, as `look_wakes.wgsl`'s `step_field`: the
+/// params are [`pack_params`]'s (the grid's size is the field's own here). No rain, no shift.
+pub fn cpu_step(field: &CpuField, params: &[[f32; 4]], k: u32) -> CpuField {
+    let n = field.n as i32;
+    let [_, dx, dt, steps] = params[0];
+    let steps = steps.max(1.0);
+    let wave = params[1];
+    let foam_p = params[2];
+    let more = params[3];
+    let clock = params[4];
+    let place = params[5];
+    let count = params[6][1] as usize;
+    let kf = k as f32;
+    let mut out = CpuField::new(field.n);
+    for z in 0..n {
+        for x in 0..n {
+            let s = field.at(x, z);
+            let xl = field.at(x - 1, z);
+            let xr = field.at(x + 1, z);
+            let zl = field.at(x, z - 1);
+            let zr = field.at(x, z + 1);
+            let pos = Vec2::new(place[0], place[1]) + (Vec2::new(x as f32, z as f32) + 0.5) * dx;
+            let t = clock[0] + kf * dt;
+            let (mut press, mut churn, mut splash) = (0.0, 0.0, 0.0);
+            for i in 0..count {
+                let s0 = params[7 + 3 * i];
+                let s1 = params[8 + 3 * i];
+                let s2 = params[9 + 3 * i];
+                let r2 = (s1[0] * s1[0]).max(1e-4);
+                let from = Vec2::new(s0[0], s0[1]);
+                let to = Vec2::new(s0[2], s0[3]);
+                let a = from.lerp(to, kf / steps);
+                let b = from.lerp(to, (kf + 1.0) / steps);
+                let v = b - a;
+                let l2 = v.length_squared().max(1e-8);
+                let sv = ((pos - a).dot(v) / l2).clamp(0.0, 1.0);
+                let d2 = (pos - a - sv * v).length_squared();
+                if d2 > 9.0 * r2 {
+                    continue;
+                }
+                let g = (-d2 / r2).exp();
+                press += (s1[1] + s2[0] * (std::f32::consts::TAU * s2[1] * t + s2[2]).sin()) * g;
+                churn += s1[2] * (-d2 / (1.69 * r2)).exp() * (d2 / r2).clamp(0.0, 1.0);
+                if k == 0 {
+                    splash += s1[3] * (-d2 / (2.25 * r2)).exp();
+                }
+            }
+            let lap = (xl[1] + xr[1] + zl[1] + zr[1] - 4.0 * s[1]) / (dx * dx);
+            let mut h = s[0] - dt * lap;
+            let mut phi = s[1] - dt * (wave[0] * h + press) - splash;
+            let edge = x.min(n - 1 - x).min(z.min(n - 1 - z)) as f32;
+            let e = (edge / more[3].max(1.0)).clamp(0.0, 1.0);
+            let keep = wave[1] * (1.0 - 0.2 * (1.0 - e) * (1.0 - e));
+            h *= keep;
+            phi *= keep;
+            let drift = Vec2::new(xr[1] - xl[1], zr[1] - zl[1]) / (2.0 * dx);
+            let back = Vec2::new(x as f32, z as f32) + 0.5 - drift * (wave[3] * dt / dx);
+            let rise = (h - s[0]) / dt;
+            let crest = (rise - foam_p[2]).max(0.0) * if h > 0.0 { 1.0 } else { 0.0 };
+            let foam = ((field.foam_at(back)
+                + (churn * foam_p[0] + crest * foam_p[1]) * dt
+                + splash * more[2])
+                * wave[2])
+                .min(foam_p[3]);
+            out.texels[(z * n + x) as usize] = [h, phi, foam, 0.0];
+        }
+    }
+    out
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// A body crossing a CPU field at `speed` yd/s along +X for `secs`, then (optionally) stopping
+    /// for `rest` more: the field, its corner, and the body's end.
+    fn run(speed: f32, secs: f32, rest: f32, depth: f32) -> (CpuField, Vec2, Vec2) {
+        let n = 96;
+        let origin = Vec2::ZERO;
+        let mut field = CpuField::new(n);
+        let mut pos = Vec2::new(4.0, 12.0);
+        let mut frame = WakeFrame {
+            on: true,
+            reset: false,
+            pairs: 1,
+            ..default()
+        };
+        let pair_s = 2.0 * tune::STEP_S;
+        let moving = (secs / pair_s) as u32;
+        let total = moving + (rest / pair_s) as u32;
+        let mut wet = false;
+        for i in 0..total {
+            let v = if i < moving { speed } else { 0.0 };
+            let next = pos + Vec2::new(v * pair_s, 0.0);
+            let mut s = body_source(depth, 4.0, v, 1.0).expect("in the water");
+            if !wet {
+                s.splash = tune::SPLASH;
+                wet = true;
+            }
+            s.from = pos;
+            s.to = next;
+            frame.sources = vec![s];
+            frame.clock = i as f32 * pair_s;
+            let mut params = pack_params(&frame);
+            params[0][0] = n as f32;
+            params[5] = [origin.x, origin.y, 0.0, 0.0];
+            field = cpu_step(&field, &params, 0);
+            field = cpu_step(&field, &params, 1);
+            pos = next;
+        }
+        (field, origin, pos)
+    }
+
+    fn foam(f: &CpuField, o: Vec2, p: Vec2) -> f32 {
+        f.texel_of(o, p).map_or(0.0, |t| t[2])
+    }
+
+    /// The reference's swimmer: at the swim speed (4.72 yd/s) the foam lies behind him in a V,
+    /// on both sides of his track and opening out the further back it lies; none ahead of him.
+    #[test]
+    fn a_swimmer_leaves_a_v_of_foam_behind_him() {
+        let (f, o, end) = run(4.72, 2.0, 0.0, 1.0);
+        // Ahead of him: calm, no foam.
+        assert_eq!(foam(&f, o, end + Vec2::new(2.0, 0.0)), 0.0);
+        // The V's half-width at 1.5 and 3 yd behind him: the widest foam either side.
+        let half_width = |back: f32| {
+            let mut w = [0.0f32; 2];
+            for (side, sign) in [(0, 1.0f32), (1, -1.0)] {
+                for j in 0..40 {
+                    let off = j as f32 * TEXEL_YD;
+                    if foam(&f, o, end + Vec2::new(-back, sign * off)) > 0.3 {
+                        w[side] = off;
+                    }
+                }
+            }
+            w
+        };
+        let near = half_width(1.5);
+        let far = half_width(3.0);
+        assert!(
+            near[0] > 0.0 && near[1] > 0.0,
+            "foam both sides near: {near:?}"
+        );
+        assert!(
+            far[0] > near[0] && far[1] > near[1],
+            "it opens out: {near:?} then {far:?}"
+        );
+        assert!(far[0] < 3.0, "a V, not a flood: {far:?}");
+    }
+
+    /// A hero standing still in the shallows breathes gentle rings and no foam.
+    #[test]
+    fn a_still_hero_makes_rings_not_foam() {
+        let (f, o, end) = run(0.0, 0.0, 3.0, 0.8);
+        let mut most_foam = 0.0f32;
+        let mut ring = 0.0f32;
+        for z in 0..f.n {
+            for x in 0..f.n {
+                let t = f.texels[z * f.n + x];
+                let p = o + (Vec2::new(x as f32, z as f32) + 0.5) * TEXEL_YD;
+                let r = (p - end).length();
+                most_foam = most_foam.max(t[2]);
+                if (1.5..3.0).contains(&r) {
+                    ring = ring.max(t[0].abs());
+                }
+            }
+        }
+        assert!(most_foam < 0.3, "no foam, not even round him: {most_foam}");
+        assert!(ring > 0.001 && ring < 0.05, "gentle rings: {ring} yd");
+    }
+
+    /// The wake fades: a second and a half after the swimmer stops, little foam is left, and the
+    /// field never grows.
+    #[test]
+    fn the_wake_fades_and_the_field_stays_calm() {
+        let (f, _, _) = run(4.72, 1.5, 2.0, 1.0);
+        let foam: usize = f.texels.iter().filter(|t| t[2] > 0.3).count();
+        let (moving, _, _) = run(4.72, 1.5, 0.0, 1.0);
+        let had: usize = moving.texels.iter().filter(|t| t[2] > 0.3).count();
+        assert!(had > 50, "{had} foamy texels while he swims");
+        let most = f.texels.iter().map(|t| t[0].abs()).fold(0.0f32, f32::max);
+        assert!(foam < 6, "{foam} foamy texels left");
+        assert!(most < 0.2, "the field stays small: {most} yd");
+    }
+
+    #[test]
+    fn steps_are_paid_in_pairs_and_slow_frames_forget() {
+        let mut owed = 0.0;
+        assert_eq!(pairs_for(&mut owed, 1.0 / 60.0), 1);
+        assert!(owed.abs() < 1e-5);
+        assert_eq!(pairs_for(&mut owed, 1.0 / 144.0), 0);
+        assert_eq!(pairs_for(&mut owed, 1.0 / 144.0), 0);
+        assert_eq!(
+            pairs_for(&mut owed, 1.0 / 144.0),
+            1,
+            "three short frames pay a pair"
+        );
+        let mut owed = 0.0;
+        assert_eq!(pairs_for(&mut owed, 0.5), tune::MAX_PAIRS);
+        assert!(owed <= 2.0 * tune::STEP_S + 1e-6, "{owed} owed");
+    }
+
+    #[test]
+    fn the_field_follows_the_camera_in_whole_texels_ahead_of_it() {
+        let a = field_cell(Vec3::new(10.0, 50.0, 10.0), Vec3::new(0.0, -0.7, -0.7));
+        let b = field_cell(Vec3::new(10.1, 50.0, 10.0), Vec3::new(0.0, -0.7, -0.7));
+        assert_eq!(a, b, "a tenth of a yard is under a texel");
+        let corner = a.as_vec2() * TEXEL_YD;
+        let centre = corner + Vec2::splat(0.5 * tune::SPAN_YD);
+        // Looking toward −Z: the centre is AHEAD of the span ahead, within a texel.
+        assert!((centre.x - 10.0).abs() <= TEXEL_YD);
+        assert!((centre.y - (10.0 - tune::AHEAD * tune::SPAN_YD)).abs() <= TEXEL_YD);
+    }
+
+    #[test]
+    fn a_body_pushes_only_in_the_water_and_harder_as_it_goes() {
+        assert!(body_source(0.0, 4.0, 4.0, 1.0).is_none(), "dry");
+        assert!(
+            body_source(5.0, 4.0, 4.0, 1.0).is_none(),
+            "too deep to reach the top"
+        );
+        let shin = body_source(0.2, 4.0, 4.0, 1.0).unwrap();
+        let waist = body_source(1.0, 4.0, 4.0, 1.0).unwrap();
+        assert!(shin.push < waist.push && shin.foam < waist.foam);
+        let still = body_source(1.0, 4.0, 0.0, 1.0).unwrap();
+        assert_eq!((still.push, still.foam), (0.0, 0.0));
+        assert!(still.idle > 0.0, "a still body breathes rings");
+    }
+
+    #[test]
+    fn the_params_carry_the_frame() {
+        let frame = WakeFrame {
+            on: true,
+            reset: true,
+            pairs: 2,
+            shift: IVec2::new(3, -1),
+            sources: vec![WakeSource {
+                from: Vec2::new(1.0, 2.0),
+                to: Vec2::new(3.0, 4.0),
+                radius: 0.4,
+                ..default()
+            }],
+            ..default()
+        };
+        let p = pack_params(&frame);
+        assert_eq!(p.len(), PARAM_ROWS);
+        assert_eq!(p[0][3], 4.0, "two pairs, four steps");
+        assert_eq!(p[4][2..], [3.0, -1.0]);
+        assert_eq!(p[6][..2], [1.0, 1.0]);
+        assert_eq!(p[7], [1.0, 2.0, 3.0, 4.0]);
+        assert_eq!(p[8][0], 0.4);
+        assert_eq!(water_row(&WakeFrame::default()), [0.0; 4]);
+    }
+
+    /// `look_wakes.wgsl`'s uniform is the packer's rows.
+    #[test]
+    fn the_shader_takes_the_packed_rows() {
+        let src = include_str!("../shaders/look_wakes.wgsl");
+        assert!(src.contains(&format!("src: array<vec4<f32>, {}>", 3 * tune::MAX_SOURCES)));
+        let rows_before_src = src
+            .split("struct WakeParams {")
+            .nth(1)
+            .unwrap()
+            .split("src:")
+            .next()
+            .unwrap()
+            .matches("vec4<f32>,")
+            .count();
+        assert_eq!(rows_before_src, 7);
+    }
+
+    #[test]
+    fn lookwater_reads_the_wake_words() {
+        use WakesCommand::*;
+        assert_eq!(LookWakes::parse("wakes 0"), Some(Ok(Wakes(Some(false)))));
+        assert_eq!(LookWakes::parse("WAKES 1"), Some(Ok(Wakes(Some(true)))));
+        assert_eq!(LookWakes::parse("wakes"), Some(Ok(Wakes(None))));
+        assert_eq!(LookWakes::parse("wakes 2"), Some(Err(())));
+        assert_eq!(
+            LookWakes::parse("refract 1.5"),
+            Some(Ok(Refract(Some(1.5))))
+        );
+        assert_eq!(LookWakes::parse("refract grade"), Some(Ok(Refract(None))));
+        assert_eq!(
+            LookWakes::parse("caustics 0"),
+            Some(Ok(Caustics(Some(0.0))))
+        );
+        assert_eq!(LookWakes::parse("caustics 3"), Some(Err(())));
+        assert_eq!(LookWakes::parse("refract"), Some(Err(())));
+        assert_eq!(LookWakes::parse("wakes 1 1"), Some(Err(())));
+        assert_eq!(LookWakes::parse("1.5"), None);
+        assert_eq!(LookWakes::parse(""), None);
+    }
+}
diff --git a/crates/benilla-world/src/look/wakes_pass.rs b/crates/benilla-world/src/look/wakes_pass.rs
new file mode 100644
index 0000000..d980557
--- /dev/null
+++ b/crates/benilla-world/src/look/wakes_pass.rs
@@ -0,0 +1,212 @@
+//! The new look's wakes, their render half, benilla's own (no reference behaviour): the ripple
+//! field's steps (`look_wakes.wgsl`), once a frame before any camera draws, so every view's water
+//! reads this frame's field (`look::wakes`).
+//!
+//! A step reads one field image and writes the other; steps run in pairs, so the frame's field
+//! always ends in [`WAKE_FIELD`], which the liquid material binds. The compute pass is one span,
+//! `look_wakes`, in the fps journal's `gpu_look` column.
+
+use bevy::prelude::*;
+use bevy::render::diagnostic::RecordDiagnostics;
+use bevy::render::extract_resource::ExtractResourcePlugin;
+use bevy::render::render_asset::RenderAssets;
+use bevy::render::render_graph::{
+    Node, NodeRunError, RenderGraph, RenderGraphContext, RenderLabel,
+};
+use bevy::render::render_resource::binding_types::{
+    storage_buffer_sized, texture_2d, texture_storage_2d, uniform_buffer_sized,
+};
+use bevy::render::render_resource::*;
+use bevy::render::renderer::{RenderContext, RenderDevice, RenderQueue};
+use bevy::render::storage::GpuShaderStorageBuffer;
+use bevy::render::texture::GpuImage;
+use bevy::render::{Render, RenderApp, RenderStartup, RenderSystems};
+
+use benilla_assets::materials::{WAKE_FIELD, WAKE_FIELD_B};
+
+use super::wakes::{pack_params, tune, WakeFrame, WakeStatsBuffer, PARAM_ROWS};
+
+#[derive(Debug, Hash, PartialEq, Eq, Clone, RenderLabel)]
+pub(crate) struct LookWakesLabel;
+
+/// The uniform's bytes: [`PARAM_ROWS`] rows of four floats.
+const PARAM_BYTES: u64 = (PARAM_ROWS * 16) as u64;
+/// The most steps a frame runs.
+const MOST_STEPS: usize = 2 * tune::MAX_PAIRS as usize;
+/// The stats buffer: four counters.
+const STATS_BYTES: u64 = 16;
+
+#[derive(Resource)]
+struct WakePipeline {
+    layout: BindGroupLayoutDescriptor,
+    pipeline: CachedComputePipelineId,
+}
+
+/// The pass's buffers: the frame's uniform and one tiny uniform a step holding its number.
+#[derive(Resource)]
+struct WakeGpu {
+    params: Buffer,
+    steps: Vec<Buffer>,
+}
+
+fn init_pipeline(
+    mut commands: Commands,
+    cache: Res<PipelineCache>,
+    asset_server: Res<AssetServer>,
+    device: Res<RenderDevice>,
+) {
+    let layout = BindGroupLayoutDescriptor::new(
+        "look_wakes_layout",
+        &BindGroupLayoutEntries::sequential(
+            ShaderStages::COMPUTE,
+            (
+                texture_2d(TextureSampleType::Float { filterable: false }),
+                texture_storage_2d(TextureFormat::Rgba16Float, StorageTextureAccess::WriteOnly),
+                uniform_buffer_sized(false, std::num::NonZero::new(PARAM_BYTES)),
+                uniform_buffer_sized(false, std::num::NonZero::new(16)),
+                storage_buffer_sized(false, std::num::NonZero::new(STATS_BYTES)),
+            ),
+        ),
+    );
+    let pipeline = cache.queue_compute_pipeline(ComputePipelineDescriptor {
+        label: Some("look_wakes".into()),
+        layout: vec![layout.clone()],
+        push_constant_ranges: vec![],
+        shader: asset_server.load("embedded://benilla_world/shaders/look_wakes.wgsl"),
+        shader_defs: vec![],
+        entry_point: Some("step_field".into()),
+        zero_initialize_workgroup_memory: false,
+    });
+    commands.insert_resource(WakePipeline { layout, pipeline });
+    let params = device.create_buffer(&BufferDescriptor {
+        label: Some("look_wakes_params"),
+        size: PARAM_BYTES,
+        usage: BufferUsages::UNIFORM | BufferUsages::COPY_DST,
+        mapped_at_creation: false,
+    });
+    let steps = (0..MOST_STEPS as u32)
+        .map(|k| {
+            device.create_buffer_with_data(&BufferInitDescriptor {
+                label: Some("look_wakes_step"),
+                contents: bytemuck::cast_slice(&[k, 0, 0, 0]),
+                usage: BufferUsages::UNIFORM,
+            })
+        })
+        .collect();
+    commands.insert_resource(WakeGpu { params, steps });
+}
+
+/// Render world, in `PrepareResources`: the frame's uniform, while the field steps.
+fn upload_params(
+    queue: Res<RenderQueue>,
+    gpu: Option<Res<WakeGpu>>,
+    frame: Option<Res<WakeFrame>>,
+) {
+    let (Some(gpu), Some(frame)) = (gpu, frame) else {
+        return;
+    };
+    if !frame.on || frame.pairs == 0 {
+        return;
+    }
+    queue.write_buffer(&gpu.params, 0, bytemuck::cast_slice(&pack_params(&frame)));
+}
+
+#[derive(Default)]
+struct LookWakesNode;
+
+impl Node for LookWakesNode {
+    fn run<'w>(
+        &self,
+        _graph: &mut RenderGraphContext,
+        render_context: &mut RenderContext<'w>,
+        world: &'w World,
+    ) -> Result<(), NodeRunError> {
+        let Some(frame) = world.get_resource::<WakeFrame>() else {
+            return Ok(());
+        };
+        if !frame.on || frame.pairs == 0 {
+            return Ok(());
+        }
+        let (Some(pipe), Some(gpu), Some(stats)) = (
+            world.get_resource::<WakePipeline>(),
+            world.get_resource::<WakeGpu>(),
+            world.get_resource::<WakeStatsBuffer>(),
+        ) else {
+            return Ok(());
+        };
+        let cache = world.resource::<PipelineCache>();
+        let Some(pipeline) = cache.get_compute_pipeline(pipe.pipeline) else {
+            return Ok(()); // still compiling
+        };
+        let images = world.resource::<RenderAssets<GpuImage>>();
+        let (Some(a), Some(b)) = (images.get(&WAKE_FIELD), images.get(&WAKE_FIELD_B)) else {
+            return Ok(());
+        };
+        let Some(stats) = world
+            .resource::<RenderAssets<GpuShaderStorageBuffer>>()
+            .get(&stats.0)
+        else {
+            return Ok(());
+        };
+        let layout = cache.get_bind_group_layout(&pipe.layout);
+        let steps = (2 * frame.pairs as usize).min(MOST_STEPS);
+        let groups: Vec<BindGroup> = (0..steps)
+            .map(|k| {
+                let (from, to) = if k % 2 == 0 { (a, b) } else { (b, a) };
+                render_context.render_device().create_bind_group(
+                    "look_wakes",
+                    &layout,
+                    &BindGroupEntries::sequential((
+                        &from.texture_view,
+                        &to.texture_view,
+                        gpu.params.as_entire_binding(),
+                        gpu.steps[k].as_entire_binding(),
+                        stats.buffer.as_entire_binding(),
+                    )),
+                )
+            })
+            .collect();
+        let diagnostics = render_context.diagnostic_recorder();
+        let encoder = render_context.command_encoder();
+        encoder.clear_buffer(&stats.buffer, 0, None);
+        let mut pass = encoder.begin_compute_pass(&ComputePassDescriptor {
+            label: Some("look_wakes"),
+            timestamp_writes: None,
+        });
+        let span = diagnostics.pass_span(&mut pass, "look_wakes");
+        pass.set_pipeline(pipeline);
+        let groups_a_side = tune::GRID.div_ceil(8);
+        for group in &groups {
+            pass.set_bind_group(0, group, &[]);
+            pass.dispatch_workgroups(groups_a_side, groups_a_side, 1);
+        }
+        span.end(&mut pass);
+        Ok(())
+    }
+}
+
+/// The main-world half: the frame's and the stats buffer's extracts; the render half in
+/// [`finish`].
+pub(super) fn build(app: &mut App) {
+    app.add_plugins((
+        ExtractResourcePlugin::<WakeFrame>::default(),
+        ExtractResourcePlugin::<WakeStatsBuffer>::default(),
+    ));
+}
+
+/// The render half, once the render app exists: the pipeline, the upload, and the steps ahead of
+/// every camera.
+pub(super) fn finish(app: &mut App) {
+    let Some(render_app) = app.get_sub_app_mut(RenderApp) else {
+        return;
+    };
+    render_app
+        .add_systems(RenderStartup, init_pipeline)
+        .add_systems(
+            Render,
+            upload_params.in_set(RenderSystems::PrepareResources),
+        );
+    let mut graph = render_app.world_mut().resource_mut::<RenderGraph>();
+    graph.add_node(LookWakesLabel, LookWakesNode);
+    graph.add_node_edge(LookWakesLabel, bevy::render::graph::CameraDriverLabel);
+}
