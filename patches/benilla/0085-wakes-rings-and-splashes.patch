+/// The new look's wakes (`benilla_world::look::wakes`): the ripple field round the camera, a
+/// square of `Rgba16Float` texels holding the surface's height, its velocity potential and its
+/// foam, which a compute pass steps each frame and the liquid material binds at 117 (sampled with
+/// the scene copy's sampler, 114). Two fixed handles, as [`WATER_SCENE`]: the pass reads one and
+/// writes the other, in pairs, so each frame's field ends in [`WAKE_FIELD`].
+pub const WAKE_FIELD: Handle<Image> =
+    bevy::asset::uuid_handle!("5ad0a0e1-0085-4c0a-9e5b-5ad0a0e10085");
+
+/// [`WAKE_FIELD`]'s partner: the field between a pair's two steps.
+pub const WAKE_FIELD_B: Handle<Image> =
+    bevy::asset::uuid_handle!("5ad0a0e1-0085-4c0a-9e5b-5ad0a0e1b085");
+
+/// One wake field image, `size` texels square: read by texel or sampled (linear, clamped) and
+/// written as a storage texture. wgpu clears a new texture to zero, a calm surface with no foam.
+pub fn wake_field_image(size: u32) -> Image {
+    use bevy::asset::RenderAssetUsages;
+    use bevy::image::{ImageAddressMode, ImageFilterMode, ImageSampler, ImageSamplerDescriptor};
+    use bevy::render::render_resource::{Extent3d, TextureDimension, TextureFormat, TextureUsages};
+    let mut image = Image::new_uninit(
+        Extent3d {
+            width: size.max(1),
+            height: size.max(1),
+            depth_or_array_layers: 1,
+        },
+        TextureDimension::D2,
+        TextureFormat::Rgba16Float,
+        RenderAssetUsages::RENDER_WORLD,
+    );
+    image.texture_descriptor.label = Some("look_wake_field");
+    image.texture_descriptor.usage = TextureUsages::TEXTURE_BINDING | TextureUsages::STORAGE_BINDING;
+    image.sampler = ImageSampler::Descriptor(ImageSamplerDescriptor {
+        label: Some("look_wake_field".into()),
+        address_mode_u: ImageAddressMode::ClampToEdge,
+        address_mode_v: ImageAddressMode::ClampToEdge,
+        mag_filter: ImageFilterMode::Linear,
+        min_filter: ImageFilterMode::Linear,
+        ..Default::default()
+    });
+    image
+}
