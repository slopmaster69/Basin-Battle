+    return vec4<f32>(slope * w, max(c.z, 0.0) * w, w);
+}
+
+// The wakes' foam drawn out into streaks along the crests: a fine noise averaged along each
+// crest's line (`slope` across it), so the streaks follow the wake's curling crests and are crisp
+// across them; where a pixel (`fp` yards) spans many streaks, their mean.
+fn wake_streaks(p: vec2<f32>, slope: vec2<f32>, t: f32, fp: f32) -> f32 {
+    let sl = length(slope);
+    var along = vec2<f32>(1.0, 0.0);
+    if (sl > 1e-4) {
+        along = vec2<f32>(-slope.y, slope.x) / sl;
+    }
+    let reach = 0.45 * clamp(sl / 0.15, 0.0, 1.0);
+    let k = 4.0;
+    let drift = t * vec2<f32>(0.05, -0.04);
+    var n = 0.0;
+    for (var i = 0u; i < 4u; i = i + 1u) {
+        let s = (f32(i) - 1.5) / 1.5 * reach;
+        n += water_noise((p + along * s) * k + drift).x;
+    }
+    n = clamp((0.25 * n - 0.5) * 1.8 + 0.5, 0.0, 1.0);
+    let grain = water_noise(p * (2.3 * k) + vec2<f32>(17.3, 5.1) - drift).x;
+    n = 0.75 * n + 0.25 * grain;
+    let fine = 1.0 - smoothstep(0.25 / k, 1.0 / k, fp);
+    return mix(0.5, n, fine);
+}
+
