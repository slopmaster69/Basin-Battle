-    let rgb = water_encode(c / max(a, 1e-4));
+    // `lookwater show`: what the water is drawn from, in its place, for film.
+    if (surface_on && water.rows[29].w > 0.5) {
+        let mode = u32(water.rows[29].w + 0.5);
+        var dbg = vec3<f32>(0.0);
+        if (mode == 1u) {
+            // How deep: black dry to white 4 yd, a blue line each half yard, red where the
+            // colour's smoothed depth differs from the pixel's own.
+            let d = min(depth_v, 20.0);
+            dbg = vec3<f32>(clamp(d / 4.0, 0.0, 1.0));
+            let line = 1.0 - smoothstep(0.0, 0.06, abs(fract(d * 2.0 + 0.5) - 0.5));
+            dbg = mix(dbg, vec3<f32>(0.1, 0.4, 1.0), 0.8 * line);
+            dbg = mix(dbg, vec3<f32>(1.0, 0.2, 0.1), 0.6 * smoothstep(0.15, 0.6, abs(min(depth_c, 20.0) - d)));
+        } else if (mode == 2u) {
+            dbg = vec3<f32>(vis);
+        } else if (mode == 3u) {
+            dbg = trans3;
+        } else {
+            dbg = textureSampleLevel(scene_tex, scene_samp, uv, 0.0).rgb;
+        }
+        return vec4<f32>(dbg, 1.0);
+    }
+    var rgb = water_encode(c / max(a, 1e-4));
+    // Under the drifting wavelets the pale water's broad, slow gradients are dithered by half a
+    // step of the eight-bit target, so they turn without bands.
+    if (surface_on) {
+        rgb += vec3<f32>((jitter - 0.5) / 255.0);
+    }
     return vec4<f32>(apply_fog(rgb, P, in.room_fog), a);
 }
 
