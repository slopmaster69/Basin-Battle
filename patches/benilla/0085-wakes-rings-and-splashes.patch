+/// `lookwater`'s words for the wakes and the bed (`benilla_world::look::wakes`).
+fn look_wakes(
+    world: &mut World,
+    command: Result<benilla_world::look::wakes::WakesCommand, ()>,
+) -> Vec<String> {
+    use benilla_world::look::wakes::WakesCommand;
+    use benilla_world::look::{LookWakes, LookWater, WakeStats, WorldLook};
+    let Ok(command) = command else {
+        return vec![format!("Usage: lookwater {LOOK_WATER_USAGE}")];
+    };
+    let mut lines = Vec::new();
+    {
+        let mut wakes = world.get_resource_or_init::<LookWakes>();
+        match command {
+            WakesCommand::Wakes(Some(on)) => {
+                wakes.on = on;
+                lines.push(if on {
+                    "Wakes on: the water answers what moves through it.".to_string()
+                } else {
+                    "Wakes off: 1.12's wade rings and the old froth instead.".to_string()
+                });
+            }
+            WakesCommand::Wakes(None) => {
+                lines.push(format!("Wakes {}.", if wakes.on { "on" } else { "off" }))
+            }
+            WakesCommand::Refract(r) => {
+                wakes.refract = r;
+                lines.push(match r {
+                    None => "The bed's bend at its tuning.".to_string(),
+                    Some(r) => format!("The bed's bend held at {r} times its own."),
+                });
+            }
+            WakesCommand::Caustics(c) => {
+                wakes.caustics = c;
+                lines.push(match c {
+                    None => "The light on the bed at its tuning.".to_string(),
+                    Some(c) => format!("The light on the bed held at {c} times its own."),
+                });
+            }
+        }
+    }
+    let stats = world
+        .get_resource::<WakeStats>()
+        .copied()
+        .unwrap_or_default();
+    let on = world.get_resource::<LookWakes>().is_some_and(|w| w.on);
+    if on {
+        lines.push(format!("Wakes: {}.", stats.line()));
+    }
+    if !world.get_resource::<LookWater>().is_some_and(|w| w.on) {
+        lines.push("worldWater is 0: 1.12's water.".to_string());
+    }
+    if !world.get_resource::<WorldLook>().is_some_and(|l| l.on) {
+        lines.push("The classic look (worldLook 0) has 1.12's water.".to_string());
+    }
+    for line in &lines {
+        info!("[look wakes] lookwater: {line}");
+    }
+    lines
+}
