+    /// The fine grain wraps over the tile without a seam, has a root mean square of about 1 where
+    /// a pixel is small, fades where it spans the grain, and drifts smoothly.
+    #[test]
+    fn the_fine_grain_wraps_fades_and_drifts() {
+        let yd = tune::GRAIN_YD;
+        let sp = tune::GRAIN_SPEED;
+        let mut sum = 0.0f32;
+        let n = 64;
+        for y in 0..n {
+            for x in 0..n {
+                let p = Vec2::new(x as f32 * 0.031 + 3.0, y as f32 * 0.029 - 7.0);
+                sum += grain_at(p, 0.0, 0.005, yd, sp).length_squared();
+                // Across the tile's edge, and a long way off, it reads the same.
+                let a = grain_at(p, 1.3, 0.005, yd, sp);
+                let b = grain_at(
+                    p + Vec2::new(tune::TILE_YD * 37.0, -tune::TILE_YD),
+                    1.3,
+                    0.005,
+                    yd,
+                    sp,
+                );
+                assert!((a - b).length() < 2.0e-2, "{a} against {b}");
+            }
+        }
+        let rms = (sum / (n * n) as f32).sqrt();
+        assert!((0.75..1.3).contains(&rms), "rms {rms}");
+        // Past 0.6 of each octave's wavelength a pixel has none of it.
+        assert_eq!(grain_at(Vec2::new(1.0, 2.0), 0.0, 0.07, yd, sp), Vec2::ZERO);
+        // A 30th of a second moves it a little, never a jump; its wrap of the drift (a whole
+        // tile) changes nothing.
+        let p = Vec2::new(0.37, 1.91);
+        let mut most = 0.0f32;
+        for f in 0..60 {
+            let a = grain_at(p, f as f32 / 30.0, 0.005, yd, 0.3);
+            let b = grain_at(p, (f + 1) as f32 / 30.0, 0.005, yd, 0.3);
+            most = most.max((a - b).length());
+        }
+        assert!(most > 0.0 && most < 1.5, "a frame's step {most}");
+    }
+
+    /// Why the seventh filming had no fine texture, and that the eighth round's surface has it:
+    /// on the films' screen (0.0135 yd a pixel) the brightness the wavelets shade, less its blur
+    /// over 5 px (the films' measure of fine texture), was a small share of it under the seventh
+    /// round's knobs (its finest wavelet lay at 15 px), and is several times more now, while its
+    /// coarse relief (what is left after that blur) is less.
+    #[test]
+    fn the_grain_lands_under_the_films_pixels() {
+        let bearing = Vec2::new(0.6, 0.8);
+        let drift = SurfaceDrift::default();
+        let n = 160usize;
+        let field = |knobs: &SurfaceTune| -> Vec<f32> {
+            (0..n * n)
+                .map(|i| {
+                    let p = Vec2::new((i % n) as f32, (i / n) as f32) * FILM_PX_YD
+                        + Vec2::new(2.0, 5.0);
+                    facet_at(p, &drift, 0.5, bearing, FILM_PX_YD, knobs)
+                })
+                .collect()
+        };
+        // The std of what a 5 px box takes away, and of the box itself.
+        let split = |f: &[f32]| -> (f32, f32) {
+            let (mut fine, mut coarse, mut m) = (0.0f64, 0.0f64, 0.0f64);
+            let mut boxes = Vec::new();
+            for y in 2..n - 2 {
+                for x in 2..n - 2 {
+                    let mut b = 0.0;
+                    for dy in 0..5 {
+                        for dx in 0..5 {
+                            b += f[(y + dy - 2) * n + x + dx - 2];
+                        }
+                    }
+                    let b = b / 25.0;
+                    fine += f64::from((f[y * n + x] - b).powi(2));
+                    boxes.push(b);
+                    m += f64::from(b);
+                }
+            }
+            let c = boxes.len() as f64;
+            m /= c;
+            for b in &boxes {
+                coarse += (f64::from(*b) - m).powi(2);
+            }
+            ((fine / c).sqrt() as f32, (coarse / c).sqrt() as f32)
+        };
+        let (old_fine, old_coarse) = split(&field(&seventh_round()));
+        let (new_fine, new_coarse) = split(&field(&SurfaceTune::default()));
+        assert!(
+            new_fine > 3.0 * old_fine,
+            "fine {new_fine} against the seventh round's {old_fine}"
+        );
+        assert!(
+            new_coarse < old_coarse,
+            "relief {new_coarse} against the seventh round's {old_coarse}"
+        );
+        assert!(
+            old_fine < 0.3 * old_coarse,
+            "the seventh round's shade was mostly relief: {old_fine} {old_coarse}"
+        );
+    }
+
+    /// The std of what a 5 px box takes away from `f` (`n` a side): the films' fine texture.
+    fn fine_of(f: &[f32], n: usize) -> f32 {
+        let (mut fine, mut c) = (0.0f64, 0.0f64);
+        for y in 2..n - 2 {
+            for x in 2..n - 2 {
+                let mut b = 0.0;
+                for dy in 0..5 {
+                    for dx in 0..5 {
+                        b += f[(y + dy - 2) * n + x + dx - 2];
+                    }
+                }
+                fine += f64::from((f[y * n + x] - b / 25.0).powi(2));
+                c += 1.0;
+            }
+        }
+        (fine / c).sqrt() as f32
+    }
+
+    /// Why the eighth filming's grain flickered, and that it no longer does: on the films' screen
+    /// the shade's change from one 30th of a second to the next (its mean, as the films measure
+    /// it) against its fine texture. The grain only ever slid, but at the eighth round's 0.3 yd/s
+    /// its octaves moved a tenth and a seventh of their wavelength a frame, so the change was
+    /// most of the texture; at `grain_speed`'s default it is a small share of it (the
+    /// reference's is about a quarter), at the higher `grain` too.
+    #[test]
+    fn the_grain_drifts_without_flicker() {
+        let bearing = Vec2::new(0.6, 0.8);
+        let n = 120usize;
+        let ratio = |grain: f32, speed: f32| -> (f32, f32) {
+            let mut knobs = SurfaceTune::default();
+            knobs.0[k::GRAIN] = grain;
+            knobs.0[k::GRAIN_SPEED] = speed;
+            let mut drift = SurfaceDrift::default();
+            let shot = |drift: &SurfaceDrift, secs: f32| -> Vec<f32> {
+                (0..n * n)
+                    .map(|i| {
+                        let p = Vec2::new((i % n) as f32, (i / n) as f32) * FILM_PX_YD
+                            + Vec2::new(2.0, 5.0);
+                        facet_at(p, drift, secs, bearing, FILM_PX_YD, &knobs)
+                    })
+                    .collect()
+            };
+            let (mut change, mut fine) = (0.0f32, 0.0f32);
+            let mut prev = shot(&drift, 3.0);
+            for f in 1..5 {
+                advance(&mut drift, Vec2::ZERO, 1.0, 1.0 / 30.0);
+                let now = shot(&drift, 3.0 + f as f32 / 30.0);
+                change += now
+                    .iter()
+                    .zip(&prev)
+                    .map(|(a, b)| (a - b).abs())
+                    .sum::<f32>()
+                    / now.len() as f32;
+                fine += fine_of(&now, n);
+                prev = now;
+            }
+            (change / fine, fine / 4.0)
+        };
+        let (old, old_fine) = ratio(0.35, 0.3);
+        let (new, new_fine) = ratio(tune::GRAIN, tune::GRAIN_SPEED);
+        let (high, _) = ratio(0.5, tune::GRAIN_SPEED);
+        assert!(old > 0.5, "the eighth round's change {old} of its texture");
+        // On this model 0.59 at 0.3 yd/s (the eighth filming: 2.1 against 3.4), 0.09 now.
+        assert!(new < 0.15 && high < 0.15, "now {new}, at grain 0.5 {high}");
+        assert!(new_fine > old_fine, "texture {new_fine} against {old_fine}");
+    }
+
+    /// The milky veil by depth: the shallows', the middle's and the deep's strengths each at its
+    /// depth, turning smoothly between, and `milk <v>` (all three at `v`) flat.
+    #[test]
+    fn the_milk_turns_with_depth() {
+        let d = SurfaceTune::default();
+        let [a, b, c] = tune::MILK_AT_YD;
+        assert_eq!(milk_at(0.3, &d), tune::MILK_SHALLOW);
+        assert_eq!(milk_at(a, &d), tune::MILK_SHALLOW);
+        assert!((milk_at(b, &d) - tune::MILK_MID).abs() < 1e-6);
+        assert!((milk_at(c, &d) - tune::MILK_DEEP).abs() < 1e-6);
+        assert!((milk_at(1.0e4, &d) - tune::MILK_DEEP).abs() < 1e-6);
+        let mut last = milk_at(0.0, &d);
+        for i in 1..120 {
+            let m = milk_at(i as f32 * 0.05, &d);
+            assert!((m - last).abs() < 0.03, "a jump at {} yd", i as f32 * 0.05);
+            last = m;
+        }
+        let mut flat = d;
+        for i in k::MILK_ALL {
+            flat.0[i] = 0.45;
+        }
+        for i in 0..60 {
+            assert!((milk_at(i as f32 * 0.1, &flat) - 0.45).abs() < 1e-6);
+        }
+    }
+
+    /// The bake takes the knobs' weights, and `liquid.wgsl`'s grain is the bake's noise.
+    #[test]
+    fn the_shaders_take_the_knobs() {
+        let bake = include_str!("../shaders/look_water_surface.wgsl");
+        assert!(bake.contains("rows: array<vec4<f32>, 4>,"));
+        assert!(bake.contains("(weight_of[i] * sp.rows[3][i])"));
+        assert_eq!(PARAM_BYTES, 64);
+        let liquid = include_str!("../../../benilla-assets/src/shaders/liquid.wgsl");
+        assert!(liquid.contains("fn grain_hash(c: vec2<i32>, period: i32, layer: u32) -> f32 {"));
+        assert!(liquid.contains(
+            "bitcast<u32>(w.x) * 374761393u + bitcast<u32>(w.y) * 668265263u + layer * 2246822519u"
+        ));
+        assert!(liquid.contains("grain_noise(q / tile * cells - shift, i32(cells), 4u + o)"));
+        assert!(liquid.contains("return g / (0.625 * 1.41421356 * length(SURFACE_GRAIN_WEIGHT));"));
+    }
+}
