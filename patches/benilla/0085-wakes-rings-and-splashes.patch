+        let centre = own.as_vec2() * TEXEL_YD + Vec2::splat(0.5 * tune::SPAN_YD);
+        assert!((centre - Vec2::new(-3.0, 4.0)).abs().max_element() <= TEXEL_YD);
+    }
+
+    /// Nothing pushes within the margin round the field's edge, where the sponge soaks it up, and
+    /// a body's push grows in over the yards inside it, so no wake is cut off at a straight line.
+    #[test]
+    fn bodies_are_kept_in_from_the_fields_edge() {
