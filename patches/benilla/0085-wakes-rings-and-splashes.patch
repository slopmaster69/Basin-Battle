+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// The wavelets drift smoothly: a 60th of a second moves every texel's slope by a small
+    /// share of the slope itself, never a jump (1.12's flipbook replaced a whole frame at 24 fps).
+    #[test]
+    fn the_surface_moves_smoothly() {
+        let mut drift = SurfaceDrift::default();
+        let wind = Vec2::new(0.6, -0.8);
+        let mut most = 0.0f32;
+        let mut sum = 0.0f32;
+        let mut count = 0;
+        for frame in 0..120 {
+            let before: Vec<Vec4> = (0..64)
+                .map(|k| {
+                    let uv =
+                        Vec2::new((k % 8) as f32 * 0.123 + 0.01, (k / 8) as f32 * 0.117 + 0.02);
+                    bake_at(uv, &drift)
+                })
+                .collect();
+            advance(&mut drift, wind, 1.0, 1.0 / 60.0);
+            for (k, b) in before.iter().enumerate() {
+                let uv = Vec2::new((k % 8) as f32 * 0.123 + 0.01, (k / 8) as f32 * 0.117 + 0.02);
+                let a = bake_at(uv, &drift);
+                most = most.max((a - *b).length());
+                sum += b.length();
+                count += 1;
+            }
+            let _ = frame;
+        }
+        let mean = sum / count as f32;
+        // A 0.2 yd wavelet drifting 0.55 yd/s turns its slope about 0.29 rad in a 60th of a
+        // second (seventh round: the grain carries most of the slope now), smoothly; a flipbook's
+        // frame or a pop is a whole slope.
+        assert!(
+            most < 0.35 * mean,
+            "a frame's step {most} against a mean slope of {mean}"
+        );
+        assert!(most > 0.0, "it moves");
+    }
+
+    /// The drift wraps in whole cells, and every layer is periodic over the tile: a texel reads
+    /// the same however many wraps its offset has made, so the tile never jumps.
+    #[test]
+    fn the_tile_wraps_without_a_seam() {
+        for i in 0..4 {
+            let cells = tune::CELLS[i] as i32;
+            for k in 0..20 {
+                let p = Vec2::new(k as f32 * 0.37 + 0.1, k as f32 * 0.21 + 0.3);
+                let a = surface_noise(p, cells, i as u32);
+                let b = surface_noise(
+                    p + Vec2::new(cells as f32, -(cells as f32)),
+                    cells,
+                    i as u32,
+                );
+                assert!((a - b).length() < 1.0e-3, "layer {i}: {a} against {b}");
+            }
+        }
+        // The edges of the tile meet: the bake at u = 0 and u = 1 agree.
+        let drift = SurfaceDrift::default();
+        for k in 0..10 {
+            let v = k as f32 * 0.1 + 0.03;
+            let a = bake_at(Vec2::new(0.0, v), &drift);
+            let b = bake_at(Vec2::new(1.0, v), &drift);
+            assert!((a - b).length() < 2.0e-3, "{a} against {b}");
+        }
+        // A long session's drift stays in range.
+        let mut drift = SurfaceDrift::default();
+        advance(&mut drift, Vec2::X, 1.3, 1.0e6);
+        for (i, o) in drift.offsets.iter().enumerate() {
+            let cells = f64::from(tune::CELLS[i]);
+            assert!((0.0..cells).contains(&o.x) && (0.0..cells).contains(&o.y));
+        }
+    }
+
+    /// The four layers' slope has a root mean square of about 1, so the hour's slope sets it.
+    #[test]
+    fn the_bake_is_normalised() {
+        let drift = SurfaceDrift::default();
+        let mut sum = 0.0f64;
+        let n = 96;
+        for y in 0..n {
+            for x in 0..n {
+                let uv = Vec2::new((x as f32 + 0.5) / n as f32, (y as f32 + 0.5) / n as f32);
+                let t = bake_at(uv, &drift);
+                let g = Vec2::new(t.x + t.z, t.y + t.w);
+                sum += f64::from(g.length_squared());
+            }
+        }
+        let rms = (sum / f64::from(n * n)).sqrt();
+        assert!((0.75..1.3).contains(&rms), "rms {rms}");
+    }
+
+    /// It drifts downwind, and holds a direction of its own with no wind.
+    #[test]
+    fn it_drifts_with_the_wind() {
+        let mut a = SurfaceDrift::default();
+        advance(&mut a, Vec2::new(1.0, 0.0), 1.0, 1.0);
+        // The long layer is on the wind: its offset fell along x only.
+        let cells = f64::from(tune::CELLS[0]);
+        let step = f64::from(tune::SPEED_YD[0]) * cells / f64::from(tune::TILE_YD);
+        assert!(
+            (a.offsets[0].x - (cells - step)).abs() < 1.0e-6,
+            "{:?}",
+            a.offsets[0]
+        );
+        assert!(a.offsets[0].y.abs() < 1.0e-9);
+        let mut b = SurfaceDrift::default();
+        advance(&mut b, Vec2::ZERO, tune::DRIFT_CALM, 1.0);
+        assert_ne!(b, SurfaceDrift::default());
+        assert!(drift_pace(0.0) < drift_pace(3.0));
+    }
+
+    /// `liquid.wgsl`'s sun highlight off the surface at `p` on the water (y 0) seen from `cam`
+    /// with the sun toward `sun`, a pixel spanning `fp` yd, by day's slope (linear luminance);
+    /// `old` is 0081's lobe (sharpness 900 at 6) on 0081's slope, for contrast.
+    fn glint_at(p: Vec2, cam: Vec3, sun: Vec3, fp: f32, old: bool) -> f32 {
+        use crate::look::water::tune as wt;
+        let uv = (p / tune::TILE_YD).fract_gl();
+        let t = bake_at(uv, &SurfaceDrift::default());
+        let (coarse, fine, lost) = fades(fp);
+        let s = wt::RIPPLE_BREEZE * if old { 1.0 } else { tune::GAIN };
+        let g = Vec2::new(t.x, t.y) * coarse + tune::GLINT_FINE * Vec2::new(t.z, t.w) * fine;
+        let n = Vec3::new(-g.x * s, 1.0, -g.y * s).normalize();
+        let v = (cam - Vec3::new(p.x, 0.0, p.y)).normalize();
+        let nh = n.dot((sun.normalize() + v).normalize()).clamp(0.0, 1.0);
+        if old {
+            return wt::SUN_GLINT * (nh.powf(wt::SUN_SHARPNESS) + wt::SHEEN * nh.powf(36.0));
+        }
+        let (wide, peak) = rough_lobe(tune::SHARPNESS, s, lost);
+        let spec = tune::GLINT * peak * nh.powf(wide) + wt::SHEEN * nh.powf(wide * 0.04);
+        (wt::SUN_GLINT * spec).min(tune::GLINT_MOST)
+    }
+
+    /// No specks, even with the sun's mirror point in the middle of the films' steep view: the
+    /// highlight is bounded, and nowhere much brighter than the quarter yard round it (0081's
+    /// lobe on the same water peaks near three times its surroundings, at four times the light).
+    #[test]
+    fn the_highlight_is_soft_not_specks() {
+        let cam = Vec3::new(0.0, 17.5, 4.0);
+        let v0 = cam.normalize();
+        let sun = Vec3::new(-v0.x, v0.y, -v0.z);
+        let n = 120usize;
+        let at = |i: usize| (i as f32 - n as f32 / 2.0 + 0.5) * 0.05;
+        let field = |old: bool| -> Vec<f32> {
+            (0..n * n)
+                .map(|k| glint_at(Vec2::new(at(k % n), at(k / n)), cam, sun, 0.02, old))
+                .collect()
+        };
+        let peakiness = |g: &[f32]| -> (f32, f32) {
+            let mut most = 0.0f32;
+            let mut ratio = 0.0f32;
+            for y in 2..n - 2 {
+                for x in 2..n - 2 {
+                    let c = g[y * n + x];
+                    most = most.max(c);
+                    if c < 0.2 {
+                        continue;
+                    }
+                    let mut sum = 0.0;
+                    for dy in 0..5 {
+                        for dx in 0..5 {
+                            sum += g[(y + dy - 2) * n + x + dx - 2];
+                        }
+                    }
+                    ratio = ratio.max(c / (sum / 25.0));
+                }
+            }
+            (most, ratio)
+        };
+        let (most, ratio) = peakiness(&field(false));
+        assert!(most <= tune::GLINT_MOST + 1.0e-4, "brightest {most}");
+        assert!(ratio < 1.6, "a speck {ratio} times its surroundings");
+        let (old_most, old_ratio) = peakiness(&field(true));
+        assert!(
+            old_most > 2.0 * most && old_ratio > 2.0,
+            "{old_most} {old_ratio}"
+        );
+    }
