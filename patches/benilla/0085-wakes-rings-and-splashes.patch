+        }
+        assert_eq!(TUNE_ROWS, 6);
+        let mut t = SurfaceTune::default();
+        t.0[k::RAIN_RATE] = 2.5;
+        t.0[k::MID] = 0.25;
+        let rows = t.rows();
+        assert_eq!(rows[0][0], tune::MILK_SHALLOW);
+        assert_eq!(rows[4][3], 2.5);
