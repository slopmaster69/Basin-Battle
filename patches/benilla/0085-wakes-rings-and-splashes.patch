diff --git a/crates/benilla-world/src/shaders/look_wakes.wgsl b/crates/benilla-world/src/shaders/look_wakes.wgsl
new file mode 100644
index 0000000..2ce2636
--- /dev/null
+++ b/crates/benilla-world/src/shaders/look_wakes.wgsl
@@ -0,0 +1,214 @@
+// The new look's wakes (`look::wakes`, benilla's own, no reference behaviour): one step of the
+// ripple field round the camera. Each texel holds the surface's height (yd), its velocity
+// potential (yd²/s, the water's drift is its gradient) and its foam:
+//   x = h, y = φ, z = foam, w unused.
+// A linear shallow-water wave, stepped symplectically so it stays stable at any frame rate:
+//   h' = h − dt·∇²φ        φ' = (φ − dt·(c²·h' + p))
+// both kept by the wave's life each step, where p is the pressure the bodies in the water push
+// with. A moving body also pushes along the two arms of a Kelvin wake (about 19.5° either side of
+// its track, trailing from its sides) and lays foam along them and at its sides; the foam on the
+// arms is carried outward with them, so it stays a crisp white V of streaks, and fades over its
+// life. Only the arms and the bodies make foam: a still body's breathing, a raindrop and a
+// splash's rings never do (a splash throws a few droplets). `look::wakes::cpu_step` is this step
+// in Rust for the tests (keep in sync).
+
+struct WakeParams {
+    // [grid texels, texel (yd), step (s), steps this frame]
+    head: vec4<f32>,
+    // [wave speed², wave kept a step, foam kept a step, drift]
+    wave: vec4<f32>,
+    // [body foam scale, crest foam, crest from (yd/s), foam most]
+    foam: vec4<f32>,
+    // [rain drops a texel a step, rain drop (yd²/s), droplet foam, edge texels]
+    more: vec4<f32>,
+    // [clock at the first step (s), first step's number, shift x, shift z (texels)]
+    clock: vec4<f32>,
+    // [origin x, origin z (yd), origin cell x, origin cell z]
+    place: vec4<f32>,
+    // [reset, sources, foam gain, foam a texel takes a second at most]
+    misc: vec4<f32>,
+    // The Kelvin arms: [tan of their angle, its cos, width (yd), widening a yard back]
+    arm: vec4<f32>,
+    // [arm push (a share of the body's), arm foam a second, arm foam falls over (yd), droplets]
+    arm2: vec4<f32>,
+    // Four rows a source: [from x, from z, to x, to z] (yd, over the whole frame) ·
+    // [radius (yd), push, foam, splash] · [idle push, idle Hz, phase, wake 0-1] ·
+    // [velocity x, z (yd/s), arm length (yd), 0].
+    src: array<vec4<f32>, 128>,
+};
+
+@group(0) @binding(0) var field_in: texture_2d<f32>;
+@group(0) @binding(1) var field_out: texture_storage_2d<rgba16float, write>;
+@group(0) @binding(2) var<uniform> p: WakeParams;
+// x = this step's number within the frame.
+@group(0) @binding(3) var<uniform> step: vec4<u32>;
+// [foam texels over 0.3, moving texels (|h| over 0.005 yd), 0, 0], counted on the frame's last step.
+@group(0) @binding(4) var<storage, read_write> stats: array<atomic<u32>, 4>;
+
+// The texel the field held at `c` before this step: the first step reads through the shift (the
+// field follows the camera a whole texel at a time) and reads nothing after a reset; outside the
+// field is calm water.
+fn wake_load(c: vec2<i32>) -> vec4<f32> {
+    let n = i32(p.head.x);
+    var q = c;
+    if (step.x == 0u) {
+        if (p.misc.x > 0.5) {
+            return vec4<f32>(0.0);
+        }
+        q = c + vec2<i32>(i32(p.clock.z), i32(p.clock.w));
+    }
+    if (any(q < vec2<i32>(0)) || any(q >= vec2<i32>(n))) {
+        return vec4<f32>(0.0);
+    }
+    return textureLoad(field_in, q, 0);
+}
+
+// The foam at `t` (texel units, centres at +0.5), bilinear.
+fn wake_foam_at(t: vec2<f32>) -> f32 {
+    let f = t - vec2<f32>(0.5);
+    let i = floor(f);
+    let w = f - i;
+    let c = vec2<i32>(i);
+    let a = wake_load(c).z;
+    let b = wake_load(c + vec2<i32>(1, 0)).z;
+    let d = wake_load(c + vec2<i32>(0, 1)).z;
+    let e = wake_load(c + vec2<i32>(1, 1)).z;
+    return mix(mix(a, b, w.x), mix(d, e, w.x), w.y);
+}
+
+// The squared distance from `x` to the segment `a`–`b`.
+fn wake_seg_d2(x: vec2<f32>, a: vec2<f32>, b: vec2<f32>) -> f32 {
+    let v = b - a;
+    let l2 = max(dot(v, v), 1e-8);
+    let s = clamp(dot(x - a, v) / l2, 0.0, 1.0);
+    let d = x - a - s * v;
+    return dot(d, d);
+}
+
+fn wake_hash(c: vec2<i32>, n: u32) -> f32 {
+    var h = bitcast<u32>(c.x) * 374761393u + bitcast<u32>(c.y) * 668265263u + n * 2246822519u;
+    h = (h ^ (h >> 13u)) * 1274126177u;
+    h = h ^ (h >> 16u);
+    return f32(h) * (1.0 / 4294967296.0);
+}
+
+@compute @workgroup_size(8, 8, 1)
+fn step_field(@builtin(global_invocation_id) id: vec3<u32>) {
+    let n = i32(p.head.x);
+    let c = vec2<i32>(id.xy);
+    if (any(c >= vec2<i32>(n))) {
+        return;
+    }
+    let dx = p.head.y;
+    let dt = p.head.z;
+    let steps = max(p.head.w, 1.0);
+    let k = f32(step.x);
+
+    let s = wake_load(c);
+    let xl = wake_load(c - vec2<i32>(1, 0));
+    let xr = wake_load(c + vec2<i32>(1, 0));
+    let zl = wake_load(c - vec2<i32>(0, 1));
+    let zr = wake_load(c + vec2<i32>(0, 1));
+    // World-anchored, so raindrops and droplets do not slide with the field.
+    let cell = c + vec2<i32>(i32(p.place.z), i32(p.place.w));
+
+    // The bodies: the pressure each pushes with along its path through this step and along its
+    // wake's arms, the foam it lays at its sides and on the arms, the arms' outward carry, and the
+    // splash of one that came in this frame with its droplets.
+    let x = p.place.xy + (vec2<f32>(c) + vec2<f32>(0.5)) * dx;
+    let t = p.clock.x + k * dt;
+    var press = 0.0;
+    var churn = 0.0;
+    var arms = 0.0;
+    var carry = vec2<f32>(0.0);
+    var splash = 0.0;
+    var drops = 0.0;
+    let count = u32(p.misc.y);
+    for (var i = 0u; i < count; i = i + 1u) {
+        let s0 = p.src[4u * i];
+        let s1 = p.src[4u * i + 1u];
+        let s2 = p.src[4u * i + 2u];
+        let s3 = p.src[4u * i + 3u];
+        let r2 = max(s1.x * s1.x, 1e-4);
+        let a = mix(s0.xy, s0.zw, k / steps);
+        let b = mix(s0.xy, s0.zw, (k + 1.0) / steps);
+
+        // The Kelvin arms, behind a moving body: `along` yards back from it, `side` across.
+        let sp = length(s3.xy);
+        if (s2.w > 0.0 && sp > 0.3) {
+            let d = s3.xy / sp;
+            let across = vec2<f32>(-d.y, d.x);
+            let rel = x - b;
+            let along = -dot(rel, d);
+            let side = dot(rel, across);
+            let reach = s3.z;
+            let line = s1.x + max(along, 0.0) * p.arm.x;
+            if (along > -1.0 && along < reach + 1.5 && abs(side) < line + 1.2) {
+                let off = abs(abs(side) - line) * p.arm.y;
+                let wid = p.arm.z + p.arm.w * max(along, 0.0);
+                let on_len = smoothstep(-s1.x, 0.3, along) * (1.0 - smoothstep(0.7 * reach, reach, along));
+                let g_arm = exp(-off * off / (wid * wid)) * on_len * s2.w;
+                press += s1.y * p.arm2.x * g_arm;
+                churn += p.arm2.y * g_arm * exp(-max(along, 0.0) / p.arm2.z);
+                arms += g_arm;
+                // Outward from the track as fast as the arm moves, so its foam rides on it.
+                let m = smoothstep(-1.0, 0.0, along) * (1.0 - smoothstep(reach, reach + 1.5, along))
+                    * (1.0 - smoothstep(line + 0.4, line + 1.2, abs(side))) * s2.w;
+                carry += across * (m * sp * p.arm.x * sign(side));
+            }
+        }
+
+        let d2 = wake_seg_d2(x, a, b);
+        if (d2 > 9.0 * r2) {
+            continue;
+        }
+        let g = exp(-d2 / r2);
+        press += (s1.y + s2.x * sin(6.2831853 * s2.y * t + s2.z)) * g;
+        churn += s1.z * exp(-d2 / (1.69 * r2)) * clamp(d2 / r2, 0.0, 1.0);
+        if (step.x == 0u && s1.w > 0.0) {
+            splash += s1.w * exp(-d2 / (2.25 * r2));
+            // A few droplets on a ring round it, not a disc.
+            let ring = sqrt(d2) - 2.2 * s1.x;
+            if (wake_hash(cell, u32(p.clock.y) + 7919u) < p.arm2.w) {
+                drops += s1.w * exp(-ring * ring / (0.36 * r2));
+            }
+        }
+    }
+
+    // The wave.
+    let lap = (xl.y + xr.y + zl.y + zr.y - 4.0 * s.y) / (dx * dx);
+    var h = s.x - dt * lap;
+    var phi = s.y - dt * (p.wave.x * h + press) - splash;
+    // Raindrops: rings only.
+    if (p.more.x > 0.0 && wake_hash(cell, u32(p.clock.y) + step.x) < p.more.x) {
+        phi -= p.more.y;
+    }
+    // A sponge round the edge, so nothing comes back off it.
+    let edge = f32(min(min(c.x, n - 1 - c.x), min(c.y, n - 1 - c.y)));
+    let e = clamp(edge / max(p.more.w, 1.0), 0.0, 1.0);
+    let keep = p.wave.y * (1.0 - 0.2 * (1.0 - e) * (1.0 - e));
+    h *= keep;
+    phi *= keep;
+
+    // The foam, carried back along the drift and out with the arms; born at the bodies' sides,
+    // on the arms and on the crests rising along them, never more than a texel takes a second,
+    // and less while the field is already foamy (`misc.z`).
+    let drift = vec2<f32>(xr.y - xl.y, zr.y - zl.y) / (2.0 * dx);
+    let back = vec2<f32>(c) + vec2<f32>(0.5) - (drift * p.wave.w + carry) * (dt / dx);
+    let rise = (h - s.x) / dt;
+    let crest = max(rise - p.foam.z, 0.0) * select(0.0, 1.0, h > 0.0) * min(arms, 1.0);
+    let born = min((churn * p.foam.x + crest * p.foam.y) * dt, p.misc.w * dt) * p.misc.z;
+    var foam = wake_foam_at(back) + born + drops * p.more.z;
+    foam = min(foam * p.wave.z, p.foam.w);
+
+    textureStore(field_out, c, vec4<f32>(h, phi, foam, 0.0));
+
+    if (step.x + 1u == u32(steps)) {
+        if (foam > 0.3) {
+            atomicAdd(&stats[0], 1u);
+        }
+        if (abs(h) > 0.005) {
+            atomicAdd(&stats[1], 1u);
+        }
+    }
+}
