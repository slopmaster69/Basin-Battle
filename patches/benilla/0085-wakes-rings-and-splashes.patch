+    /// A body coming in throws a few droplets on a ring round it, soft and thin: no disc of foam
+    /// over it.
+    #[test]
+    fn a_splash_throws_droplets_not_a_disc() {
+        let (f, o, end) = run(0.0, 0.0, 2.0 * tune::STEP_S, 0.8, 0.0);
+        let (mut inside, mut drops, mut most) = (0.0f32, 0, 0.0f32);
+        for z in 0..f.n {
+            for x in 0..f.n {
+                let t = f.texels[z * f.n + x];
+                let r = (o + (Vec2::new(x as f32, z as f32) + 0.5) * TEXEL_YD - end).length();
+                if r < tune::RADIUS {
+                    inside = inside.max(t[2]);
