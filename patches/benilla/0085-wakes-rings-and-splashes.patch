+    #[test]
+    fn the_field_follows_the_camera_in_whole_texels_ahead_of_it() {
+        let fwd = Vec3::new(0.0, -0.7, -0.7);
+        let a = field_cell(Vec3::new(10.0, 50.0, 10.0), fwd, None);
+        let b = field_cell(Vec3::new(10.1, 50.0, 10.0), fwd, None);
+        assert_eq!(a, b, "a tenth of a yard is under a texel");
+        let corner = a.as_vec2() * TEXEL_YD;
