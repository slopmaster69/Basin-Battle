+    /// Fresnel: looking steeply down on the moving surface the mirror stays faint, so the bed
+    /// shows; at a grazing look it is most of what is seen.
+    #[test]
+    fn the_mirror_is_faint_looking_down_and_strong_at_grazing() {
+        use crate::look::water::tune as wt;
+        let fresnel = |cam: Vec3, p: Vec2| {
+            let uv = (p / tune::TILE_YD).fract_gl();
+            let t = bake_at(uv, &SurfaceDrift::default());
+            let s = wt::RIPPLE_BREEZE * tune::GAIN;
+            let n = Vec3::new(-(t.x + t.z) * s, 1.0, -(t.y + t.w) * s).normalize();
+            let v = (cam - Vec3::new(p.x, 0.0, p.y)).normalize();
+            let c = n.dot(v).clamp(0.0, 1.0);
+            tune::F0 + (1.0 - tune::F0) * (1.0 - c).powi(5)
+        };
+        let steep = Vec3::new(0.0, 17.5, 4.0);
+        let mut most = 0.0f32;
+        for k in 0..400 {
+            let p = Vec2::new((k % 20) as f32 * 0.4 - 4.0, (k / 20) as f32 * 0.4 - 4.0);
+            most = most.max(fresnel(steep, p));
+        }
+        // Seventh round: 0.1 straight down (was 0.07), the sky's sheen on the pale water.
+        assert!(most < 0.12, "steep {most}");
+        let grazing = Vec3::new(0.0, 2.0, 30.0);
+        let mut least = 1.0f32;
+        for k in 0..20 {
+            least = least.min(fresnel(grazing, Vec2::new(k as f32 * 0.3, 0.0)));
+        }
+        assert!(least > 0.3, "grazing {least}");
+    }
+
+    /// `liquid.wgsl`'s `water_depth_smoothed` on the flat (no taps lost): the mean of the bed's
+    /// depth `bed` over the seam's taps round `p` turned by `spin`, none shallower than
+    /// `SEAM_FLOOR` of `p`'s own; `paired` the sixth round's opposite pairs, else the fifth's
+    /// eight taps of one spiral.
+    fn seam_mean(bed: &dyn Fn(Vec2) -> f32, p: Vec2, spin: f32, paired: bool) -> f32 {
+        use crate::look::water::tune as wt;
+        let d = bed(p);
+        let mut sum = 0.0;
+        for k in 0..wt::SEAM_TAPS {
+            let (ang, r) = if paired {
+                let j = k / 2;
+                (
+                    j as f32 * 2.399_963_2 + spin + std::f32::consts::PI * (k % 2) as f32,
+                    wt::SEAM_YD * ((j as f32 + 0.5) / (wt::SEAM_TAPS / 2) as f32).sqrt(),
+                )
+            } else {
+                (
+                    k as f32 * 2.399_963_2 + spin,
+                    wt::SEAM_YD * ((k as f32 + 0.5) / wt::SEAM_TAPS as f32).sqrt(),
+                )
+            };
+            sum += bed(p + Vec2::from_angle(ang) * r).max(wt::SEAM_FLOOR * d);
+        }
+        sum / wt::SEAM_TAPS as f32
+    }
+
+    /// `show clear`'s contours: on an even slope the fifth round's taps, whose centre lay off the
+    /// pixel, read a depth that wandered with their turn (which wanders over the surface), so
+    /// the clearness drew swirling contour lines; the opposite pairs read the pixel's own depth
+    /// whatever the turn.
+    #[test]
+    fn an_even_slope_draws_no_contours() {
+        // About a yard down every four across: no tap reads shallower than the floor.
+        let bed = |p: Vec2| 2.0 + 0.2 * p.x + 0.12 * p.y;
+        let p = Vec2::new(0.3, -0.7);
+        let (mut old, mut new) = (0.0f32, 0.0f32);
+        for s in 0..32 {
+            let spin = s as f32 * 0.196;
+            old = old.max((seam_mean(&bed, p, spin, false) - bed(p)).abs());
+            new = new.max((seam_mean(&bed, p, spin, true) - bed(p)).abs());
+        }
+        assert!(new < 1.0e-4, "paired taps: {new} yd off");
+        assert!(old > 0.02, "the fifth round's: {old} yd off");
+    }
+
+    /// The films' pixel: 1920x1080 (1280x720 at a scale of 1.5), a 45° view, about 18.5 yd
+    /// from the water.
+    const FILM_PX_YD: f32 = 0.0135;
+
+    /// `liquid.wgsl`'s brightness off the wavelets at `p` at `secs` (the drift `drift`), with the
+    /// sun's bearing `bearing`, lit, a pixel of `fp` yd, under the knobs `knobs`: the factor the
+    /// water's colour is shaded by (`facet`).
+    fn facet_at(
+        p: Vec2,
+        drift: &SurfaceDrift,
+        secs: f32,
+        bearing: Vec2,
+        fp: f32,
+        knobs: &SurfaceTune,
+    ) -> f32 {
+        let t = bake_with((p / tune::TILE_YD).fract_gl(), drift, knobs.layer_scale());
+        let (coarse, fine, _) = fades(fp);
+        let s = crate::look::water::tune::RIPPLE_BREEZE * tune::GAIN;
+        let w2: f32 = tune::WEIGHT.iter().map(|w| w * w).sum();
+        let share = (tune::WEIGHT[0].powi(2) + tune::WEIGHT[1].powi(2)) / w2;
+        let broad = Vec2::new(t.x, t.y) * s * coarse;
+        let grain = Vec2::new(t.z, t.w) * s * fine;
+        let long = -broad.dot(bearing) / (2.0 * s * share.sqrt());
+        let short = -grain.dot(bearing) / (2.0 * s * (1.0 - share).sqrt());
+        let mut fine_g = 0.0;
+        if knobs.0[k::GRAIN] > 0.0 {
+            let g = grain_at(p, secs, fp, knobs.0[k::GRAIN_YD], knobs.0[k::GRAIN_SPEED]);
+            fine_g = -g.dot(bearing) * std::f32::consts::FRAC_1_SQRT_2;
+        }
+        1.0 + knobs.0[k::RELIEF_LONG] * long.clamp(-1.0, 1.0)
+            + knobs.0[k::RELIEF] * short.clamp(-1.0, 1.0)
+            + knobs.0[k::GRAIN] * fine_g.clamp(-1.0, 1.0)
+    }
+
+    /// The seventh round's knobs: the 0.36 yd layer whole, its relief and the swells' at 0.5 and
+    /// 0.08, no fine grain.
+    fn seventh_round() -> SurfaceTune {
+        let mut t = SurfaceTune::default();
+        t.0[k::MID] = 1.0;
+        t.0[k::RELIEF] = 0.5;
+        t.0[k::RELIEF_LONG] = 0.08;
+        t.0[k::GRAIN] = 0.0;
+        t
+    }
+
+    /// The sheet's brightness visibly drifts and has a fine grain: over a patch of open water the
+    /// facet shading changes from one 30th of a second to the next by a few hundredths of the
+    /// water's light on the mean, its grain (the short pair) spreads it by about a tenth, and
+    /// nothing jumps (the fifth round's 0.12 on the body alone, at half the pace, moved the
+    /// brightness by well under a hundredth). The ninth round's near-still grain takes its share
+    /// of the change down to about a hundredth (`the_grain_drifts_without_flicker`).
+    #[test]
+    fn the_sheet_drifts_with_a_visible_grain() {
+        let bearing = Vec2::new(0.6, 0.8);
+        let knobs = SurfaceTune::default();
+        let mut drift = SurfaceDrift::default();
+        let n = 48;
+        let at = |k: usize| Vec2::new((k % n) as f32 * 0.05 + 1.0, (k / n) as f32 * 0.05 + 2.0);
+        let facets = |drift: &SurfaceDrift, secs: f32| -> Vec<f32> {
+            (0..n * n)
+                .map(|k| facet_at(at(k), drift, secs, bearing, FILM_PX_YD, &knobs))
+                .collect()
+        };
+        let mut prev = facets(&drift, 0.0);
+        let (mut step, mut most, mut steps) = (0.0f32, 0.0f32, 0);
+        let mut spread = 0.0f32;
+        for frame in 1..9 {
+            advance(&mut drift, Vec2::ZERO, 1.0, 1.0 / 30.0);
+            let now = facets(&drift, frame as f32 / 30.0);
+            for (a, b) in now.iter().zip(&prev) {
+                step += (a - b).abs();
+                most = most.max((a - b).abs());
+                steps += 1;
+            }
+            let mean = now.iter().sum::<f32>() / now.len() as f32;
+            spread +=
+                (now.iter().map(|x| (x - mean).powi(2)).sum::<f32>() / now.len() as f32).sqrt();
+            prev = now;
+        }
+        let step = step / steps as f32;
+        let spread = spread / 8.0;
+        assert!(
+            (0.006..0.06).contains(&step),
+            "a 30th of a second's change {step}"
+        );
+        assert!(most < 0.25, "a jump of {most}");
+        assert!(
+            (0.08..0.25).contains(&spread),
+            "the brightness spreads {spread}"
+        );
+    }
+
+    /// The seam: across a sharp step in the bed (a shelf from 1.3 to 4 yd, on the diagonal) the
+    /// water's colour turned within a yard; averaged over `SEAM_YD` it turns over several, and no
+    /// quarter yard of it changes much (`liquid.wgsl`'s `water_depth_smoothed`, flat on the CPU).
+    #[test]
+    fn a_step_in_the_bed_turns_over_yards() {
+        use crate::look::water::tune as wt;
+        let bed = |p: Vec2| -> f32 {
+            if p.x + p.y > 0.0 {
+                4.0
+            } else {
+                1.3
+            }
+        };
+        let smoothed = |p: Vec2, spin: f32| {
+            let d = bed(p);
+            let ds = seam_mean(&bed, p, spin, true);
+            let ss = |a: f32, b: f32, x: f32| {
+                let t = ((x - a) / (b - a)).clamp(0.0, 1.0);
+                t * t * (3.0 - 2.0 * t)
+            };
+            d + (ds - d) * ss(wt::SEAM_FROM, wt::SEAM_FULL, d)
+        };
+        let colour = |d: f32| {
+            let t = ((d - wt::DEEP_FROM) / (wt::DEEP_AT - wt::DEEP_FROM)).clamp(0.0, 1.0);
+            t * t * (3.0 - 2.0 * t)
+        };
+        let across = Vec2::new(1.0, 1.0).normalize();
+        let mut raw = 0.0f32;
+        let (mut most, mut sum) = (0.0f32, 0.0f32);
+        // The taps' turn wanders over the surface in the shader; here a few turns stand for it.
+        let spins = 16;
+        for s in 0..spins {
+            let spin = s as f32 * 0.39;
+            let mut smooth = 0.0f32;
+            for k in -40..40 {
+                let a = across * (k as f32 * 0.25);
+                let b = across * ((k + 1) as f32 * 0.25);
+                raw = raw.max((colour(bed(b)) - colour(bed(a))).abs());
+                smooth = smooth.max((colour(smoothed(b, spin)) - colour(smoothed(a, spin))).abs());
+            }
+            most = most.max(smooth);
+            sum += smooth;
+        }
+        let mean = sum / spins as f32;
+        assert!(raw > 0.5, "the raw step {raw}");
+        assert!(
+            mean < 0.35 * raw,
+            "smoothed {mean} on the mean against {raw}"
+        );
+        assert!(most < 0.5 * raw, "smoothed {most} at most against {raw}");
+    }
