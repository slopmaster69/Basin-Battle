+/// A blow's telegraph asked for or taken away.
+#[derive(Clone, Debug, PartialEq)]
+pub enum TelegraphCall {
+    Set {
+        key: String,
+        unit: u64,
+        ring: bool,
+        reach: f32,
+        arc: f32,
+        secs: f32,
+        unblockable: bool,
+        parry: f32,
+        focus: bool,
+    },
+    Clear {
+        key: Option<String>,
+    },
+}
+
+static TELEGRAPHS: std::sync::Mutex<Vec<TelegraphCall>> = std::sync::Mutex::new(Vec::new());
+
+/// The telegraphs asked for since the last call.
+pub fn take_telegraphs() -> Vec<TelegraphCall> {
+    TELEGRAPHS
+        .lock()
+        .map(|mut v| std::mem::take(&mut *v))
+        .unwrap_or_default()
+}
+
+fn push_telegraph(call: TelegraphCall) {
+    if let Ok(mut v) = TELEGRAPHS.lock() {
+        if v.len() < 256 {
+            v.push(call);
+        }
+    }
+}
+
+/// A unit named by its guid (`"0xF13..."` or decimal).
+fn unit_guid(v: Option<&Value>) -> Option<u64> {
+    let t = text(v)?;
+    match t.strip_prefix("0x").or_else(|| t.strip_prefix("0X")) {
+        Some(hex) => u64::from_str_radix(hex, 16).ok(),
+        None => t.parse().ok(),
+    }
+}
