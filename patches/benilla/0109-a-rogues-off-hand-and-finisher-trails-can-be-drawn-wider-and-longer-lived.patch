+impl WeaponTrail {
+    /// Patch 0109: draw the live swing `wide` times as wide (1 to 4) and longer-lived. Called right
+    /// after [`WeaponTrail::arm`]; a trail with no swing, or `wide` of 1, is left as it is.
+    pub(crate) fn widen(&mut self, wide: f32) {
+        if let Some(swing) = self.swing.as_mut() {
+            swing.wide = wide.clamp(1.0, 4.0);
+        }
+    }
+}
+
+/// How much longer a widened swing lives: 0.6 of its excess width.
+fn life_of(wide: f32) -> f32 {
+    1.0 + (wide - 1.0) * 0.6
+}
+
+/// A bold swing's edge pair: the blade's own edge, drawn `wide` times as far apart about its middle.
+fn widen_pair(bottom: Vec3, top: Vec3, wide: f32) -> (Vec3, Vec3) {
+    let (mid, half) = ((bottom + top) * 0.5, (top - bottom) * 0.5 * wide);
+    (mid - half, mid + half)
+}
