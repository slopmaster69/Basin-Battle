+
+/// Patch 0109: a bold swing draws twice-and-more as wide about the blade's middle and lives longer.
+#[test]
+fn a_bold_swing_is_wider_and_lives_longer() {
+    let (b, t) = (Vec3::ZERO, Vec3::Y);
+    let (wb, wt) = widen_pair(b, t, 2.4);
+    assert!(((wt - wb).length() - 2.4).abs() < 1e-5, "2.4 times the blade's length");
+    assert!(((wb + wt) * 0.5 - Vec3::Y * 0.5).length() < 1e-5, "about the blade's middle");
+    let frames = |wide: f32| {
+        let mut tr = armed(TrailProc { packed: 0xC83C_8CFF, duration_ms: 450 });
+        tr.widen(wide);
+        let mut n = 0u32;
+        loop {
+            n += 1;
+            let now = n * 1000 / 60;
+            let swing = tr.swing.as_mut().unwrap();
+            if let Step::Ended = swing.step(now, Vec3::X * n as f32, Vec3::X * n as f32 + Vec3::Y) {
+                break n;
+            }
+            assert!(n < 10_000);
+        }
+    };
+    assert!(frames(2.4) > frames(1.0) * 3 / 2, "a bold swing stays on screen longer");
+    // Re-arming puts it back to the blade's own width.
+    let mut tr = armed(kit_324());
+    tr.widen(3.0);
+    tr.arm(kit_324(), 10);
+    assert_eq!(tr.swing.as_ref().unwrap().wide, 1.0);
+}
