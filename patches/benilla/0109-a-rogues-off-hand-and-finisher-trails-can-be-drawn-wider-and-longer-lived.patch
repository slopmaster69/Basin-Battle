diff --git a/crates/benilla-app/src/weapon_trail/tests.rs b/crates/benilla-app/src/weapon_trail/tests.rs
index e5064d97..51fd407d 100644
--- a/crates/benilla-app/src/weapon_trail/tests.rs
+++ b/crates/benilla-app/src/weapon_trail/tests.rs
@@ -563,3 +563,32 @@ fn an_indoor_wearers_committed_ambient_wins_over_the_scenes() {
