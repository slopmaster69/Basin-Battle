diff --git a/crates/benilla-app/src/target/unit_sprite.rs b/crates/benilla-app/src/target/unit_sprite.rs
new file mode 100644
index 00000000..fe43a2ac
--- /dev/null
+++ b/crates/benilla-app/src/target/unit_sprite.rs
@@ -0,0 +1,170 @@
+//! Basin Battle's sprites on units, not part of 1.12.1: an add-on texture drawn as a disc facing
+//! the camera round a unit (`SetUnitSprite`), for the Elwynn Survival add-on's ward: a barrier
+//! round the warder that cracks as it drains and shatters when it breaks, seen by everyone. Like
+//! the ground rings, the add-on sets each sprite every frame it wants it (growing, turning,
+//! fading, swapping its texture), so the animation is the add-on's; one not set for half a second
+//! goes. It sits at `height` yards up the unit and a little toward the camera, so it reads as the
+//! front of a bubble over the body rather than a plate through it.
+
+use std::collections::HashMap;
+
+use bevy::prelude::*;
+
+use benilla_ui::action_combat::{self, UnitSpriteCall};
+use benilla_world::particles::buffer::EffectVertex;
+use benilla_world::view::WorldCamera;
+
+/// The most sprites kept at once.
+const MAX_SPRITES: usize = 32;
+/// A sprite not set again for this long goes.
+const STALE: f32 = 0.5;
+
+struct Sprite {
+    unit: String,
+    texture: String,
+    size: f32,
+    height: f32,
+    rgba: [f32; 4],
+    spin: f32,
+    aspect: f32,
+    set_at: f32,
+    /// This frame's quad (two triangles), and the point it sorts by.
+    verts: Vec<EffectVertex>,
+    at: Vec3,
+}
+
+#[derive(Resource, Default)]
+pub(super) struct UnitSprites {
+    sprites: HashMap<String, Sprite>,
+    textures: HashMap<String, Option<Handle<Image>>>,
+}
+
+/// The unit a sprite names: `"player"` (ours) or a guid (`0x...`, or decimal).
+fn unit_entity(unit: &str, mine: Option<Entity>, index: Option<&crate::net::GuidIndex>) -> Option<Entity> {
+    if unit.eq_ignore_ascii_case("player") {
+        return mine;
+    }
+    let guid = unit
+        .strip_prefix("0x")
+        .or_else(|| unit.strip_prefix("0X"))
+        .and_then(|h| u64::from_str_radix(h, 16).ok())
+        .or_else(|| unit.parse().ok())?;
+    index.and_then(|i| i.0.get(&guid).copied())
+}
+
+/// The quad of a camera-facing disc `size` across (`aspect` times that tall) at `centre`, its
+/// texture turned `spin` radians inside the oval (the oval itself stays upright).
+fn quad(centre: Vec3, right: Vec3, up: Vec3, size: f32, aspect: f32, spin: f32, rgba: [f32; 4]) -> Vec<EffectVertex> {
+    let half = size * 0.5;
+    let r = right * half;
+    let u = up * half * aspect;
+    let (s, c) = spin.sin_cos();
+    // The texture turns inside the upright oval: its coordinates, turned about the middle.
+    let turn = |x: f32, y: f32| [0.5 + (x * c - y * s) * 0.5, 0.5 + (x * s + y * c) * 0.5];
+    let corner = |a: f32, b: f32| EffectVertex { pos: (centre + r * a + u * b).to_array(), uv: turn(a, -b), color: rgba };
+    let (tl, tr, bl, br) = (corner(-1.0, 1.0), corner(1.0, 1.0), corner(-1.0, -1.0), corner(1.0, -1.0));
+    vec![tl, bl, tr, tr, bl, br]
+}
+
+/// Take the add-on's calls, drop the stale, and face each sprite to the camera where its unit is.
+pub(super) fn update_unit_sprites(
+    time: Res<Time>,
+    mut state: ResMut<UnitSprites>,
+    me: Query<Entity, With<crate::net::SelfPlayer>>,
+    units: Query<&GlobalTransform>,
+    cam: Query<&GlobalTransform, With<WorldCamera>>,
+    index: Option<Res<crate::net::GuidIndex>>,
+) {
+    let now = time.elapsed_secs();
+    for call in action_combat::take_unit_sprites() {
+        match call {
+            UnitSpriteCall::Set { key, unit, texture, size, height, rgba, spin, aspect } => {
+                if !state.sprites.contains_key(&key) && state.sprites.len() >= MAX_SPRITES {
+                    continue;
+                }
+                let s = state.sprites.entry(key).or_insert_with(|| Sprite {
+                    unit: unit.clone(),
+                    texture: texture.clone(),
+                    size,
+                    height,
+                    rgba,
+                    spin,
+                    aspect,
+                    set_at: now,
+                    verts: Vec::new(),
+                    at: Vec3::ZERO,
+                });
+                (s.unit, s.texture, s.size, s.height, s.rgba, s.spin, s.aspect, s.set_at) = (unit, texture, size, height, rgba, spin, aspect, now);
+            }
+            UnitSpriteCall::Clear { key: Some(key) } => {
+                state.sprites.remove(&key);
+            }
+            UnitSpriteCall::Clear { key: None } => state.sprites.clear(),
+        }
+    }
+    state.sprites.retain(|_, s| now - s.set_at < STALE);
+    let Ok(cam) = cam.single() else { return };
+    let (right, up, eye) = (cam.right().as_vec3(), cam.up().as_vec3(), cam.translation());
+    let mine = me.single().ok();
+    for s in state.sprites.values_mut() {
+        let Some(base) = unit_entity(&s.unit, mine, index.as_deref()).and_then(|e| units.get(e).ok()).map(|g| g.translation()) else {
+            s.verts.clear();
+            continue;
+        };
+        let body = base + Vec3::Y * s.height;
+        // A little toward the camera: the bubble's front over the body, not a plate through it;
+        // never more than half way to a camera zoomed in close.
+        let toward = (eye - body).normalize_or_zero() * (s.size * 0.35).min(0.5 * eye.distance(body));
+        let centre = body + toward;
+        s.at = centre;
+        s.verts = quad(centre, right, up, s.size, s.aspect, s.spin, s.rgba);
+    }
+}
+
+/// Draw them, each in its own texture, additive (a glow over whatever is behind).
+pub(super) fn push_unit_sprites(
+    mut images: ResMut<Assets<Image>>,
+    state: Option<ResMut<UnitSprites>>,
+    cam: Query<Entity, With<WorldCamera>>,
+    mut draw: benilla_world::particles::buffer::WorldEffectDraw,
+) {
+    let (Some(mut state), Ok(cam)) = (state, cam.single()) else {
+        return;
+    };
+    let UnitSprites { sprites, textures } = &mut *state;
+    for s in sprites.values() {
+        if s.verts.is_empty() || s.rgba[3] <= 0.0 {
+            continue;
+        }
+        let tex = textures
+            .entry(s.texture.clone())
+            .or_insert_with(|| {
+                let img = super::ground_ring::load_texture(&s.texture);
+                if img.is_none() {
+                    warn!("unit sprite: no texture at {}", s.texture);
+                }
+                img.map(|i| images.add(i))
+            })
+            .clone();
+        let Some(tex) = tex else { continue };
+        let mut batch = draw.batch(cam, tex.id()).additive().anchored(s.at);
+        batch.extend(s.verts.iter().copied());
+        batch.tris();
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_sprite_faces_the_camera_its_size_across() {
+        let v = quad(Vec3::ZERO, Vec3::X, Vec3::Y, 2.0, 1.0, 0.0, [1.0; 4]);
+        assert_eq!(v.len(), 6);
+        let xs: Vec<f32> = v.iter().map(|p| p.pos[0]).collect();
+        let ys: Vec<f32> = v.iter().map(|p| p.pos[1]).collect();
+        assert!((xs.iter().cloned().fold(f32::MIN, f32::max) - 1.0).abs() < 1e-5);
+        assert!((ys.iter().cloned().fold(f32::MIN, f32::max) - 1.0).abs() < 1e-5);
+        assert!(v.iter().all(|p| p.pos[2].abs() < 1e-6), "flat in the camera's plane");
+    }
+}
