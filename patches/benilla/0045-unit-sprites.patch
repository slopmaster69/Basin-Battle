+/// A textured disc facing the camera round a unit (`SetUnitSprite`, `ClearUnitSprite`).
+#[derive(Clone, Debug, PartialEq)]
+pub enum UnitSpriteCall {
+    Set {
+        key: String,
+        /// `"player"` or a guid.
+        unit: String,
+        texture: String,
+        /// Yards across, and how far up the unit its middle sits.
+        size: f32,
+        height: f32,
+        rgba: [f32; 4],
+        /// Turned in the view, radians.
+        spin: f32,
+        /// Its height over its width (1: round; above 1 an upright oval round a body).
+        aspect: f32,
+    },
+    Clear {
+        key: Option<String>,
+    },
+}
+
+static SPRITES: std::sync::Mutex<Vec<UnitSpriteCall>> = std::sync::Mutex::new(Vec::new());
+
+/// The unit sprites asked for since the last call.
+pub fn take_unit_sprites() -> Vec<UnitSpriteCall> {
+    SPRITES.lock().map(|mut v| std::mem::take(&mut *v)).unwrap_or_default()
+}
+
+fn push_sprite(c: UnitSpriteCall) {
+    if let Ok(mut v) = SPRITES.lock() {
+        if v.len() < 512 {
+            v.push(c);
+        }
+    }
+}
