+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn noon() -> WowLighting {
+        WowLighting {
+            celestial_dir: Vec3::new(0.3, 0.9, 0.2).normalize(),
+            moon_dir_white: Vec3::new(0.0, -1.0, 0.0),
+            celestial_tint: [1.0, 0.9, 0.7],
+            sky: [[0.2, 0.4, 0.9]; 5],
+            fog_color: [0.7, 0.75, 0.8],
+            ..default()
+        }
+    }
+
+    #[test]
+    fn the_block_is_zero_when_off() {
+        let rows = pack_rows(false, &LookWater::default(), &noon());
+        assert_eq!(rows, [[0.0; 4]; WATER_ROWS]);
+    }
+
+    /// On, row 0 carries the switch, the mirror, the clarity and the foam; a hold scales the
+    /// mirror and the clarity, and lets go again.
+    #[test]
+    fn the_block_carries_the_tuning_and_the_hold() {
+        let rows = pack_rows(true, &LookWater::default(), &noon());
+        assert_eq!(rows[0], [1.0, tune::MIRROR, tune::CLEAR_YD, tune::FOAM]);
+        assert_eq!(rows[7][0], tune::SSR_REACH);
+        assert_eq!(rows[6][3], tune::DEEP_AT);
+        let held = LookWater {
+            reflect: Some(2.0),
+            clarity: Some(0.5),
+            ..default()
+        };
+        let rows = pack_rows(true, &held, &noon());
+        assert_eq!(rows[0][1], 2.0 * tune::MIRROR);
+        assert_eq!(rows[0][2], 0.5 * tune::CLEAR_YD);
+        assert_eq!(rows[9][2], 0.5 * tune::OCEAN_CLEAR_YD);
+    }
+
+    /// By day the glint is the sun's, sharp and in the disc's colour; by night the moon's, broad
+    /// and pale; with neither up, none.
+    #[test]
+    fn the_glint_follows_the_sun_then_the_moon() {
+        let day = noon();
+        let (dir, s, color, sharp) = glint(&day);
+        assert!((dir - day.celestial_dir).length() < 1e-6);
+        assert!((s - tune::SUN_GLINT).abs() < 1e-4, "{s}");
+        assert_eq!(sharp, tune::SUN_SHARPNESS);
+        assert!((color[0] - 1.0).abs() < 1e-5 && color[2] < color[1]);
+        let night = WowLighting {
+            celestial_dir: Vec3::new(0.0, -0.5, 1.0).normalize(),
+            moon_dir_white: Vec3::new(0.2, 0.6, -0.7).normalize(),
+            ..noon()
+        };
+        let (dir, s, color, sharp) = glint(&night);
+        assert!((dir - night.moon_dir_white).length() < 1e-6);
+        assert!((s - tune::MOON_GLINT).abs() < 1e-4);
+        assert_eq!((color, sharp), (tune::MOON_TINT, tune::MOON_SHARPNESS));
+        let dark = WowLighting {
+            moon_dir_white: Vec3::new(0.0, -0.3, 1.0).normalize(),
+            ..night
+        };
+        assert_eq!(glint(&dark).1, 0.0);
+        // Overcast keeps only a share.
+        let grey = WowLighting {
+            cloud_density: 1.0,
+            ..noon()
+        };
+        assert!((glint(&grey).1 - tune::SUN_GLINT * tune::GLINT_OVERCAST).abs() < 1e-4);
+    }
+
+    /// Glassy with the sun low, a breeze with it high, rougher in a storm.
+    #[test]
+    fn the_ripples_are_calm_at_dawn_and_a_breeze_by_day() {
+        let low = WowLighting {
+            celestial_dir: Vec3::new(1.0, 0.05, 0.0).normalize(),
+            ..noon()
+        };
+        assert!((ripple_slope(&low) - tune::RIPPLE_CALM).abs() < 1e-6);
+        assert!((ripple_slope(&noon()) - tune::RIPPLE_BREEZE).abs() < 1e-6);
+        let storm = WowLighting {
+            storm_bcc: 1.0,
+            ..noon()
+        };
+        assert!(ripple_slope(&storm) > ripple_slope(&noon()));
+    }
+
+    #[test]
+    fn lookwater_parses_its_arguments() {
