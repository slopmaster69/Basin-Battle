+        assert_eq!(LookWater::parse("0 2"), Some((Some(0.0), Some(2.0))));
+        assert_eq!(LookWater::parse("3"), None);
+        assert_eq!(LookWater::parse("1 -1"), None);
+        assert_eq!(LookWater::parse("1 1 1"), None);
