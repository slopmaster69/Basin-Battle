+// ── The new look's water ─────────────────────────────────────────────────────────────────────
+//
+// benilla's own (no reference behaviour; `look::water`). Every tunable comes from the water block
+// but the march's steps, `look::water::tune`'s mirror. Linear light inside; 1.12's gamma at the
+// edges (the scene copy, the zone's colours and light, the output and its fog).
+
+const WATER_SSR_STEPS: u32 = 24u;
+const WATER_SSR_REFINE: u32 = 5u;
+const WATER_SSR_START: f32 = 0.3;
+const WATER_LUMA: vec3<f32> = vec3<f32>(0.2126, 0.7152, 0.0722);
+// The low filter of the sun shadows (`look::shadows::tune`), mirrored from terrain.wgsl.
+const WATER_SHADOW_TAPS: u32 = 6u;
+const WATER_SHADOW_TEXELS: f32 = 1.5;
+
+fn water_decode(c: vec3<f32>) -> vec3<f32> {
+    let x = max(c, vec3<f32>(0.0));
+    return select(pow((x + vec3<f32>(0.055)) / 1.055, vec3<f32>(2.4)), x / 12.92, x <= vec3<f32>(0.04045));
+}
+
+fn water_encode(c: vec3<f32>) -> vec3<f32> {
+    let x = max(c, vec3<f32>(0.0));
+    return select(1.055 * pow(x, vec3<f32>(1.0 / 2.4)) - vec3<f32>(0.055), x * 12.92, x <= vec3<f32>(0.0031308));
+}
+
+fn water_hash(c: vec2<i32>) -> f32 {
+    var h = bitcast<u32>(c.x) * 374761393u + bitcast<u32>(c.y) * 668265263u;
+    h = (h ^ (h >> 13u)) * 1274126177u;
+    h = h ^ (h >> 16u);
+    return f32(h) * (1.0 / 4294967296.0);
+}
+
+// Value noise at p and its gradient: (value, d/dx, d/dy), quintic so the gradient is smooth.
+fn water_noise(p: vec2<f32>) -> vec3<f32> {
+    let i = floor(p);
+    let f = p - i;
+    let c = vec2<i32>(i);
+    let a = water_hash(c);
+    let b = water_hash(c + vec2<i32>(1, 0));
+    let d = water_hash(c + vec2<i32>(0, 1));
+    let e = water_hash(c + vec2<i32>(1, 1));
+    let u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
+    let du = 30.0 * f * f * (f * (f - 2.0) + 1.0);
+    let k = a - b - d + e;
+    return vec3<f32>(
+        a + (b - a) * u.x + (d - a) * u.y + k * u.x * u.y,
+        du.x * ((b - a) + k * u.y),
+        du.y * ((d - a) + k * u.x),
+    );
+}
+
+// The rippled normal at `p` (the surface's XZ) at time `t`: three octaves of scrolling noise, each
+// faded out as a pixel grows past a quarter of its wavelength (`fp`, yards a pixel), so far water
+// goes smooth instead of shimmering.
+fn water_normal(p: vec2<f32>, t: f32, slope: f32, wavelength: f32, fp: f32) -> vec3<f32> {
+    let k1 = 1.0 / max(wavelength, 0.1);
+    let k2 = k1 * 1.9;
+    let k3 = k1 * 3.1;
+    let n1 = water_noise(p * k1 + t * vec2<f32>(0.060, 0.035));
+    let n2 = water_noise(p * k2 + vec2<f32>(17.3, 5.1) - t * vec2<f32>(0.045, 0.070));
+    let n3 = water_noise(p * k3 + vec2<f32>(-3.7, 11.2) + t * vec2<f32>(-0.110, 0.090));
+    let f1 = 1.0 - smoothstep(0.12, 0.35, fp * k1);
+    let f2 = 1.0 - smoothstep(0.12, 0.35, fp * k2);
+    let f3 = 1.0 - smoothstep(0.12, 0.35, fp * k3);
+    // Each octave's gradient in its own units, weighted so the mean tilt is about `slope`.
+    let g = slope * 0.66 * (n1.yz * f1 + 1.14 * n2.yz * f2 + 1.08 * n3.yz * f3);
+    return normalize(vec3<f32>(-g.x, 1.0, -g.y));
+}
+
+// The copy's planar eye depth at `uv`; 0 where it holds the sky (reverse-Z clear) or past its
+// edge.
+fn water_scene_z(uv: vec2<f32>) -> f32 {
+    let dims = vec2<f32>(textureDimensions(scene_depth));
+    let px = vec2<i32>(clamp(uv * dims, vec2<f32>(0.0), dims - vec2<f32>(1.0)));
+    let d = textureLoad(scene_depth, px, 0).r;
+    if (d <= 0.0) {
+        return 0.0;
+    }
+    let v = view.view_from_clip * vec4<f32>(0.0, 0.0, d, 1.0);
+    return -v.z / v.w;
+}
+
+fn water_uv(clip: vec4<f32>) -> vec2<f32> {
+    return (clip.xy / clip.w) * vec2<f32>(0.5, -0.5) + vec2<f32>(0.5);
+}
+
+// The shore mirrored: a ray from P along R marched through the copied depth (screen-space
+// reflection), geometric steps out to `reach` yards, then halved in on the crossing. The hit's
+// colour (gamma) and its weight (faded at the screen's edge and toward the reach); weight 0 where
+// the ray leaves the screen or meets only sky.
+fn water_reflection(P: vec3<f32>, R: vec3<f32>, jitter: f32, reach: f32) -> vec4<f32> {
+    let grow = pow(reach / WATER_SSR_START, 1.0 / f32(WATER_SSR_STEPS));
+    var t_prev = 0.0;
+    var t = WATER_SSR_START * (1.0 + 0.5 * jitter);
+    for (var i = 0u; i < WATER_SSR_STEPS; i = i + 1u) {
+        let clip = view.clip_from_world * vec4<f32>(P + R * t, 1.0);
+        if (clip.w <= 0.05) {
+            break;
+        }
+        let uv = water_uv(clip);
+        if (any(uv < vec2<f32>(0.0)) || any(uv > vec2<f32>(1.0))) {
+            break;
+        }
+        let sz = water_scene_z(uv);
+        // Behind what the copy holds there, and not far behind it: the ray crossed its surface.
+        if (sz > 0.0 && clip.w > sz && clip.w - sz < max(0.6, 1.5 * (t - t_prev))) {
+            var lo = t_prev;
+            var hi = t;
+            for (var j = 0u; j < WATER_SSR_REFINE; j = j + 1u) {
+                let mid = 0.5 * (lo + hi);
+                let cm = view.clip_from_world * vec4<f32>(P + R * mid, 1.0);
+                let zm = water_scene_z(water_uv(cm));
+                if (zm > 0.0 && cm.w > zm) {
+                    hi = mid;
+                } else {
+                    lo = mid;
+                }
+            }
+            let uh = water_uv(view.clip_from_world * vec4<f32>(P + R * hi, 1.0));
+            let border = min(min(uh.x, 1.0 - uh.x), min(uh.y, 1.0 - uh.y));
+            let weight = smoothstep(0.0, 0.06, border) * (1.0 - smoothstep(0.6 * reach, reach, hi));
+            return vec4<f32>(textureSampleLevel(scene_tex, scene_samp, uh, 0.0).rgb, weight);
+        }
+        t_prev = t;
+        t = t * grow;
+    }
+    return vec4<f32>(0.0);
+}
+
+// The hour's sky in direction R (linear): horizon to middle to zenith.
+fn water_sky(R: vec3<f32>) -> vec3<f32> {
+    let up = clamp(R.y, 0.0, 1.0);
+    let low = mix(water.rows[4].rgb, water.rows[8].rgb, smoothstep(0.0, 0.25, up));
+    return mix(low, water.rows[3].rgb, smoothstep(0.2, 0.8, up));
+}
+
+// One texel's compare of the sun-shadow map, and a bilinear-weighted compare of the four around
+// `t` (texel units), as terrain.wgsl's.
+fn water_shadow_texel(c: vec2<i32>, layer: i32, z: f32, lim: i32) -> f32 {
+    let t = clamp(c, vec2<i32>(0), vec2<i32>(lim));
+    return select(0.0, 1.0, z <= textureLoad(shadow_map, t, layer, 0));
+}
+
+fn water_shadow_tap(t: vec2<f32>, layer: i32, z: f32, lim: i32) -> f32 {
+    let f = t - vec2<f32>(0.5);
+    let i = floor(f);
+    let w2 = f - i;
+    let c = vec2<i32>(i);
+    let s00 = water_shadow_texel(c, layer, z, lim);
+    let s10 = water_shadow_texel(c + vec2<i32>(1, 0), layer, z, lim);
+    let s01 = water_shadow_texel(c + vec2<i32>(0, 1), layer, z, lim);
+    let s11 = water_shadow_texel(c + vec2<i32>(1, 1), layer, z, lim);
+    return mix(mix(s00, s10, w2.x), mix(s01, s11, w2.x), w2.y);
+}
+
+// How much of the sun reaches the water surface at P (eye depth `eye_z`), 1 lit, at the hour's
+// strength: the sun shadows' low filter on the slice P falls in (`look::shadows`; the receivers'
+// `sun_shadow` in terrain.wgsl is the full one), faded out over the reach's last share.
+fn water_shadow(P: vec3<f32>, eye_z: f32, pix: vec2<f32>) -> f32 {
+    let head = wow_light.shadow[0];
+    if (head.x < 0.5 || eye_z >= head.w) {
+        return 1.0;
+    }
+    let count = u32(head.x);
+    var c = 0u;
+    for (var i = 0u; i + 1u < count; i = i + 1u) {
+        if (eye_z > wow_light.shadow[1][i]) {
+            c = i + 1u;
+        }
+    }
+    let centre = wow_light.shadow[6u + 2u * c];
+    let depth = wow_light.shadow[7u + 2u * c]; // near, 1/range, texel (yd), blend start
+    let res = wow_light.shadow[2].w;
+    let travel = wow_light.shadow[4].xyz;
+    // The surface faces up: pushed off it along its normal, more as the light grazes it.
+    let facing = clamp(-travel.y, 0.0, 1.0);
+    let push = depth.z * wow_light.shadow[4].w * (1.0 - 0.5 * facing);
+    let d = (P + vec3<f32>(0.0, push, 0.0)) - centre.xyz;
+    let uv = vec2<f32>(dot(d, wow_light.shadow[2].xyz), -dot(d, wow_light.shadow[3].xyz))
+        * (0.5 * centre.w) + vec2<f32>(0.5);
+    if (any(uv < vec2<f32>(0.0)) || any(uv > vec2<f32>(1.0))) {
+        return 1.0;
+    }
+    let z = (dot(d, travel) - depth.x) * depth.y - depth.z * wow_light.shadow[5].w * depth.y;
+    let t = uv * res;
+    let lim = i32(res) - 1;
+    let turn = 6.2831853 * fract(52.9829189 * fract(dot(pix, vec2<f32>(0.06711056, 0.00583715))));
+    var lit = 0.0;
+    for (var i = 0u; i < WATER_SHADOW_TAPS; i = i + 1u) {
+        let r = sqrt((f32(i) + 0.5) / f32(WATER_SHADOW_TAPS));
+        let a = f32(i) * 2.3999632 + turn;
+        lit += water_shadow_tap(t + vec2<f32>(cos(a), sin(a)) * r * WATER_SHADOW_TEXELS, i32(c), z, lim);
+    }
+    lit = lit / f32(WATER_SHADOW_TAPS);
+    lit = mix(lit, 1.0, smoothstep(head.z, head.w, eye_z));
+    return 1.0 - head.y * (1.0 - lit);
+}
+
+// The new look's water seen from above: `detail` is 1.12's ripple frame, `fp` the yards a pixel
+// spans, `shallow_g`/`deep_g` the zone's `Light.dbc` water colours (gamma). Composed over the bed
+// by the frame's own alpha blend: `a` is how much the water hides of what lies behind it, so the
+// bed, and anything drawn behind the water, shows through as much as it should.
+fn look_water(
+    in: LiquidVsOut,
+    detail: vec4<f32>,
+    fp2: vec2<f32>,
+    shallow_g: vec3<f32>,
+    deep_g: vec3<f32>,
+) -> vec4<f32> {
+    let P = in.world_position.xyz;
+    let cam = view.world_position.xyz;
+    let to_cam = cam - P;
+    let dist = length(to_cam);
+    let V = to_cam / max(dist, 1e-4);
+    let eye_z = max(-(view.view_from_world * vec4<f32>(P, 1.0)).z, 1e-3);
+    let t = anim_time();
+    let pix = in.clip_position.xy;
+    let fp = max(fp2.x, fp2.y);
+
+    // The bed under this pixel: how far the view ray runs through water to reach it, and how
+    // deep the water stands over it. The sky (no bed in reach) is deep.
+    let uv = (pix - view.viewport.xy) / view.viewport.zw;
+    let bed_z = water_scene_z(uv);
+    var path = 1.0e4;
+    var depth_v = 1.0e4;
+    if (bed_z > 0.0) {
+        let beyond = max(bed_z - eye_z, 0.0) / eye_z;
+        path = beyond * dist;
+        depth_v = max(cam.y - P.y, 0.0) * beyond;
+    }
+    let shore = smoothstep(0.0, water.rows[7].w, depth_v);
+
+    // Ripples, calmed into the shore.
+    let N = water_normal(P.xz, t, water.rows[3].w * (0.3 + 0.7 * shore), water.rows[4].w, fp);
+
+    // The sun's share at the surface, for the body, the glint and the mirror.
+    let vis = water_shadow(P, eye_z, pix);
+
+    // The water's own colour: shallow to deep, ours blended with the zone's, lit by its light.
+    let tint_w = water.rows[5].w;
+    let sh = mix(shallow_g, water.rows[5].rgb, tint_w);
+    let dp = mix(deep_g, water.rows[6].rgb, tint_w);
+    let to_light = -normalize(wow_light.light_sun.xyz);
+    let lit_g = clamp(
+        wow_light.light_ambient.rgb + wow_light.light_diffuse.rgb * max(to_light.y, 0.0) * vis,
+        vec3<f32>(0.0),
+        vec3<f32>(1.0),
+    );
+    var body = water_decode(mix(sh, dp, smoothstep(0.0, water.rows[6].w, depth_v)) * lit_g);
+    // 1.12's ripple flipbook, kept faintly over it (its `ocean0_s.bls` sheen term).
+    body += water_decode((in.secondary_vtx + vec3<f32>(0.25)) * detail.a) * water.rows[9].x * shore;
+
+    // How much of the bed's light comes through: e^(−path / clarity).
+    var clarity = water.rows[0].z;
+    if (w.kind.y > 0.5) {
+        clarity = water.rows[9].z;
+    }
+    let trans = exp(-path / max(clarity, 0.05));
+
+    // The mirror: Fresnel (Schlick), held by `lookwater`, in from the waterline.
+    let cos_v = clamp(dot(N, V), 0.0, 1.0);
+    let f0 = water.rows[7].y;
+    let fres = clamp((f0 + (1.0 - f0) * pow(1.0 - cos_v, 5.0)) * water.rows[0].y, 0.0, 1.0) * shore;
+    var R = reflect(-V, N);
+    // A ripple never mirrors into the water itself.
+    R.y = max(R.y, 0.01);
+    R = normalize(R);
+    let jitter = fract(52.9829189 * fract(dot(pix, vec2<f32>(0.06711056, 0.00583715))));
+    // The march only where the mirror shows: looking straight down it is all but clear.
+    var hit = vec4<f32>(0.0);
+    if (fres > 0.01) {
+        hit = water_reflection(P, R, jitter, water.rows[7].x);
+    }
+    var mirror = mix(water_sky(R), water_decode(hit.rgb), hit.a);
+    mirror *= 1.0 - water.rows[9].y * (1.0 - vis);
+
+    // The glint: the sun's (or the moon's) highlight on the ripples, sharp, with a soft sheen.
+    let body_dir = water.rows[1].xyz;
+    var glint = vec3<f32>(0.0);
+    if (water.rows[1].w > 0.0 && body_dir.y > -0.05) {
+        let H = normalize(normalize(body_dir) + V);
+        let nh = clamp(dot(N, H), 0.0, 1.0);
+        let sharp = water.rows[2].w;
+        let spec = pow(nh, sharp) + water.rows[8].w * pow(nh, sharp * 0.04);
+        glint = water.rows[2].rgb * (water.rows[1].w * spec * vis * shore);
+    }
+
+    // The foam: a soft line just off the waterline under the foam depth, broken up and lapping.
+    let fd = max(water.rows[7].z, 0.01);
+    let band = smoothstep(0.0, 0.04, depth_v) * (1.0 - smoothstep(0.15 * fd, fd, depth_v));
+    let na = water_noise(P.xz * 0.9 + vec2<f32>(0.05, -0.03) * t).x;
+    let nb = water_noise(P.xz * 2.7 + vec2<f32>(31.0, 7.0) - vec2<f32>(0.11, 0.07) * t).x;
+    let lap = 0.5 + 0.5 * sin(depth_v / fd * 9.0 - t * 1.4 + na * 4.0);
+    let foam = water.rows[0].w * band
+        * smoothstep(0.42, 0.78, 0.45 * na + 0.25 * nb + 0.35 * lap)
+        * (1.0 - smoothstep(60.0, 120.0, eye_z));
+    let foam_rgb = water_decode(lit_g) * 0.8;
+
+    // Over the bed: the mirror takes `fres`, the body the rest of what the bed loses; the glint
+    // adds; the foam lies on top.
+    let w_body = (1.0 - fres) * (1.0 - trans);
+    var a = fres + w_body;
+    var c = mirror * fres + body * w_body;
+    c += glint;
+    a = max(a, min(dot(glint, WATER_LUMA), 1.0));
+    c = c * (1.0 - foam) + foam_rgb * foam;
+    a = a * (1.0 - foam) + foam;
+    a = clamp(a, 0.0, 1.0);
+    let rgb = water_encode(c / max(a, 1e-4));
+    return vec4<f32>(apply_fog(rgb, P, in.room_fog), a);
+}
