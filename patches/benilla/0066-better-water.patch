+/// The new look's water (`benilla_world::look::water`): the world as it stands before any water or
+/// other blended draw, copied each frame between the opaque and the transparent passes, which the
+/// liquid material binds at 113 (with its sampler at 114) to mirror the shore in the water. Fixed
+/// handles, as [`SHADOW_MAP`]: the world inserts them at startup at a token size and resizes them
+/// to the view while the water is on.
+pub const WATER_SCENE: Handle<Image> =
+    bevy::asset::uuid_handle!("5ad0a0e1-0066-4c0a-9e5b-5ad0a0e10066");
+
+/// [`WATER_SCENE`]'s depth: the device depth (reverse-Z) of the same frame, one `R32Float` texel a
+/// pixel, which the liquid material binds at 115 and reads with `textureLoad`: how deep the water
+/// is under each of its pixels, and where a mirrored ray meets the shore.
+pub const WATER_DEPTH: Handle<Image> =
+    bevy::asset::uuid_handle!("5ad0a0e1-0066-4c0a-9e5b-5ad0a0e1d066");
+
+/// [`WATER_SCENE`]'s and [`WATER_DEPTH`]'s images at `width` × `height`: the colour in the world
+/// camera's own `Rgba16Float` (it holds 1.12's gamma bytes), sampled linear and clamped; the depth
+/// in `R32Float`, read by texel. Uninitialised (the copy writes every texel before the water reads
+/// any), render-world only.
+pub fn water_scene_images(width: u32, height: u32) -> (Image, Image) {
+    use bevy::asset::RenderAssetUsages;
+    use bevy::image::{ImageAddressMode, ImageFilterMode, ImageSampler, ImageSamplerDescriptor};
+    use bevy::render::render_resource::{Extent3d, TextureDimension, TextureFormat, TextureUsages};
+    let make = |label: &'static str, format: TextureFormat| {
+        let mut image = Image::new_uninit(
+            Extent3d {
+                width: width.max(1),
+                height: height.max(1),
+                depth_or_array_layers: 1,
+            },
+            TextureDimension::D2,
+            format,
+            RenderAssetUsages::RENDER_WORLD,
+        );
+        image.texture_descriptor.label = Some(label);
+        image.texture_descriptor.usage =
+            TextureUsages::TEXTURE_BINDING | TextureUsages::RENDER_ATTACHMENT;
+        image
+    };
+    let mut scene = make("look_water_scene", TextureFormat::Rgba16Float);
+    scene.sampler = ImageSampler::Descriptor(ImageSamplerDescriptor {
+        label: Some("look_water_scene".into()),
+        address_mode_u: ImageAddressMode::ClampToEdge,
+        address_mode_v: ImageAddressMode::ClampToEdge,
+        mag_filter: ImageFilterMode::Linear,
+        min_filter: ImageFilterMode::Linear,
+        ..Default::default()
+    });
+    let depth = make("look_water_depth", TextureFormat::R32Float);
+    (scene, depth)
+}
