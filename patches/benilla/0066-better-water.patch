+//! Better water, the new look's own (no reference behaviour): lakes, rivers and the sea that look
+//! alive, as WoW Forever's do. 1.12's water is a flat tinted sheet with a flipbook of ripples and a
+//! per-vertex sun sheen; under the new look it is shaded per pixel in `liquid.wgsl`'s `look_water`:
+//! 1. **the scene under it** (`look::water_pass`): between the opaque and the transparent passes
+//!    the world as it stands and its depth are copied ([`benilla_assets::materials::WATER_SCENE`],
+//!    [`benilla_assets::materials::WATER_DEPTH`]), so each water pixel knows the bed behind it;
+//! 2. **see-through shallows**: the water's own colour comes in with the length of water a ray
+//!    crosses to the bed (`1 − e^(−path / clarity)`), clear turquoise in the shallows going to deep
+//!    blue-green ([`tune::SHALLOW`], [`tune::DEEP`], blended with the zone's own `Light.dbc` water
+//!    colours and lit by its light), and the bed shows through near the shore; the frame's alpha
+//!    blend lays it over the bed, so anything drawn behind the water still shows;
+//! 3. **reflections**: a ray mirrored off the rippled surface is marched through the copied depth
+//!    (screen-space reflection) to the shore's trees, hills and buildings, falling back to the
+//!    hour's sky colours where it leaves the screen or meets the sky, weighted by Fresnel (a mirror
+//!    at grazing angles, see-through looking down), softened in at the shoreline;
+//! 4. **ripples**: two scrolling octaves of gradient noise bend the normal, calm and glassy at dawn,
+//!    dusk and night, a breeze by day, rougher in a storm, fading with distance; 1.12's own ripple
+//!    flipbook still shows, faintly;
+//! 5. **sun glint**: a sharp warm highlight on the ripples toward the visible sun (its colour the
+//!    disc's), which the bloom picks up, and by night the moon's broader, paler path; a sun shadow
+//!    on the water (`look::shadows`) dims the glint and a little of the mirror;
+//! 6. **shore foam**: a soft white line where the water is under [`tune::FOAM_DEPTH`] deep, broken
+//!    up and lapping, which also rings a hero's legs as they wade.
+//!
+//! Every tunable is in [`tune`]; [`pack_rows`] carries them to the shader each frame in the water
+//! block. `worldWater 0` (`LookWater::on`) turns it off on its own; `lookwater <reflect> [clarity]`
+//! holds the mirror and the clarity for film. `worldLook 0` packs an all-zero block, and
+//! `liquid.wgsl` then runs 1.12's water untouched; so does a camera under the water.
+
+use bevy::prelude::*;
+use bevy::render::extract_resource::ExtractResource;
+use bevy::render::render_resource::{Buffer, BufferDescriptor, BufferUsages};
+use bevy::render::renderer::RenderDevice;
+
+use super::WorldLook;
+use crate::lighting::WowLighting;
+
+/// Every tunable of the water, in one place; the shader reads them from the water block
+/// ([`pack_rows`]) but for the march's step count, mirrored in `liquid.wgsl` as `WATER_SSR_STEPS`.
+/// A first pass, to tune on film with `lookwater`. Lengths are yards, colours sRGB 0..1.
+pub mod tune {
+    /// The mirror looking straight down (Schlick's F0): water's 0.02, doubled for the painterly
+    /// look; at grazing angles it climbs to a full mirror.
+    pub const F0: f32 = 0.04;
+    /// How much of the Fresnel mirror shows at `lookwater 1`.
+    pub const MIRROR: f32 = 1.0;
+    /// The yards of water that let through about a third (1/e) of the bed's light at
+    /// `lookwater _ 1`: Elwynn's lakes are clear, the bed shows to about two yards deep.
+    pub const CLEAR_YD: f32 = 1.4;
+    /// The ocean is murkier.
+    pub const OCEAN_CLEAR_YD: f32 = 2.2;
+    /// The water's own colour in the shallows and in the deep, blended with the zone's `Light.dbc`
+    /// water colours at [`TINT_WEIGHT`] (1 ours only, 0 the zone's), then lit by its light.
+    pub const SHALLOW: [f32; 3] = [0.18, 0.60, 0.56];
+    pub const DEEP: [f32; 3] = [0.04, 0.20, 0.24];
+    pub const TINT_WEIGHT: f32 = 0.6;
+    /// Vertical yards from shallow to deep colour.
+    pub const DEEP_AT: f32 = 3.0;
+    /// Ripples: the normal's slope at the big octave's peak, and that octave's wavelength in yards
+    /// (the small one is a third of it). Calm (dawn, dusk, night: glassy) to breeze (day), and how
+    /// much rougher a full storm makes it.
+    pub const RIPPLE_CALM: f32 = 0.05;
+    pub const RIPPLE_BREEZE: f32 = 0.13;
+    pub const RIPPLE_STORM: f32 = 0.12;
+    pub const RIPPLE_YD: f32 = 2.6;
+    /// The sun's elevation (degrees) over which the breeze comes in: calm below, full above.
+    pub const BREEZE_FROM_DEG: f32 = 8.0;
+    pub const BREEZE_TO_DEG: f32 = 35.0;
+    /// 1.12's own ripple flipbook kept under the new shading, as a share of its 1.12 brightness.
+    pub const CLASSIC_RIPPLES: f32 = 0.35;
+    /// Sun glint: its strength (linear light; a few times white, so the bloom takes it), its
+    /// Blinn sharpness, and the moon's (broader, a path across the water, pale and faint).
+    pub const SUN_GLINT: f32 = 6.0;
+    pub const SUN_SHARPNESS: f32 = 900.0;
+    pub const MOON_GLINT: f32 = 1.2;
+    pub const MOON_SHARPNESS: f32 = 160.0;
+    pub const MOON_TINT: [f32; 3] = [0.78, 0.86, 1.0];
+    /// The glint fades in as its body rises over this band of elevation (degrees), and goes in
+    /// cloud: a full overcast keeps this share of it.
+    pub const GLINT_RISE_FROM_DEG: f32 = -1.0;
+    pub const GLINT_RISE_TO_DEG: f32 = 4.0;
+    pub const GLINT_OVERCAST: f32 = 0.25;
+    /// A soft sheen around the glint, as a share of it, and its sharpness.
+    pub const SHEEN: f32 = 0.06;
+    /// How much of the mirror a full sun shadow on the water takes (the glint goes whole).
+    pub const SHADOW_DIM: f32 = 0.3;
+    /// The reflection march: how far a mirrored ray is followed (yards).
+    pub const SSR_REACH: f32 = 160.0;
+    /// Shore foam: under this many yards deep, strongest just off the waterline, at this most.
+    pub const FOAM_DEPTH: f32 = 0.5;
+    pub const FOAM: f32 = 0.75;
+    /// The mirror and the ripples come in over this depth at the waterline, so the shore has no
+    /// hard edge.
+    pub const SHORE_SOFT: f32 = 0.15;
+    /// The sky's reflection goes toward the fog colour by this much under a full overcast.
+    pub const OVERCAST_SKY: f32 = 0.6;
+    /// The most `lookwater` scales the mirror and the clarity by.
+    pub const SCALE_MAX: f32 = 2.0;
+}
+
+/// Rows the water block takes in its own storage buffer ([`LookWaterBuffer`], the liquid
+/// material's binding 116), mirrored as `water: array<vec4<f32>, 10>` in `liquid.wgsl`; keep in
+/// sync:
+///   0 `[on, mirror, clarity (yd), foam]` · 1 `[glint body (camera to it, unit), glint]` ·
+///   2 `[glint colour (linear), sharpness]` · 3 `[sky zenith (linear), ripple slope]` ·
+///   4 `[sky horizon (linear), ripple wavelength (yd)]` · 5 `[shallow (sRGB), tint weight]` ·
+///   6 `[deep (sRGB), deep at (yd)]` · 7 `[march reach (yd), F0, foam depth (yd), shore soft (yd)]` ·
+///   8 `[sky middle (linear), sheen]` · 9 `[classic ripples, shadow dim, ocean clarity (yd), 0]`.
+pub const WATER_ROWS: usize = 10;
+
+/// `worldWater` and the film's hold: `on` (on by default, inert under the classic look); `reflect`
+/// holds the mirror at a multiple of the tuned one, `clarity` the clarity (`lookwater`).
+#[derive(Resource, Clone, Copy, Debug, PartialEq)]
+pub struct LookWater {
+    pub on: bool,
+    pub reflect: Option<f32>,
+    pub clarity: Option<f32>,
+}
+
+impl Default for LookWater {
+    /// On, the `worldWater` CVar's registered "1".
+    fn default() -> Self {
+        Self {
+            on: true,
+            reflect: None,
+            clarity: None,
+        }
+    }
+}
+
+impl LookWater {
+    /// `lookwater`'s arguments: a mirror scale from 0 to [`tune::SCALE_MAX`] and an optional
+    /// clarity scale over the same range, or nothing (or `grade`) to follow the tuning again;
+    /// `None` for anything else, which changes nothing.
+    pub fn parse(args: &str) -> Option<(Option<f32>, Option<f32>)> {
+        let in_range = |w: &str| {
+            w.parse::<f32>()
+                .ok()
+                .filter(|v| (0.0..=tune::SCALE_MAX).contains(v))
+        };
+        let mut words = args.split_whitespace();
+        let first = match words.next() {
+            None => return Some((None, None)),
+            Some(w) if w.eq_ignore_ascii_case("grade") => {
+                return words.next().is_none().then_some((None, None));
+            }
+            Some(w) => w,
+        };
+        let reflect = in_range(first)?;
+        let clarity = match words.next() {
+            None => None,
+            Some(w) => Some(in_range(w)?),
+        };
+        words.next().is_none().then_some((Some(reflect), clarity))
+    }
+}
+
+/// This frame's water, from [`publish_water`] to the scene copy (`look::water_pass`) and the
+/// block's upload: `on` runs the copy; `rows` are [`pack_rows`]'s, all zero when off.
+#[derive(Resource, Clone, Copy, Debug, PartialEq, ExtractResource)]
+pub struct WaterFrame {
+    pub on: bool,
+    pub rows: [[f32; 4]; WATER_ROWS],
+}
+
+impl Default for WaterFrame {
+    fn default() -> Self {
+        Self {
+            on: false,
+            rows: [[0.0; 4]; WATER_ROWS],
+        }
+    }
+}
+
+/// The water block's storage buffer, which every liquid material binds at 116 and the render
+/// world rewrites each frame from [`WaterFrame`]; a `Buffer` clone shares the GPU resource.
+#[derive(Resource, Clone, ExtractResource)]
+pub struct LookWaterBuffer(pub Buffer);
+
+/// The block's size in bytes.
+pub const WATER_BLOCK_BYTES: u64 = (WATER_ROWS * 16) as u64;
+
+/// Makes the water block's buffer from the main-world `RenderDevice`; the liquid setup
+/// (`liquid::surface::setup_liquid`) builds it with the materials that bind it.
+pub(crate) fn new_water_buffer(device: &RenderDevice) -> LookWaterBuffer {
+    LookWaterBuffer(device.create_buffer(&BufferDescriptor {
+        label: Some("look_water_block"),
+        size: WATER_BLOCK_BYTES,
+        usage: BufferUsages::STORAGE | BufferUsages::COPY_DST,
+        mapped_at_creation: false,
+    }))
+}
+
+fn smoothstep(e0: f32, e1: f32, x: f32) -> f32 {
+    let t = ((x - e0) / (e1 - e0)).clamp(0.0, 1.0);
+    t * t * (3.0 - 2.0 * t)
+}
+
+fn elevation_deg(to_body: Vec3) -> f32 {
+    to_body
+        .normalize_or_zero()
+        .y
+        .clamp(-1.0, 1.0)
+        .asin()
+        .to_degrees()
+}
+
+fn srgb_to_linear(c: [f32; 3]) -> [f32; 3] {
+    c.map(super::pass::srgb_to_linear)
+}
+
+/// The glint's body this frame: the visible sun while it is up, else the white moon, each fading
+/// in as it rises and dimmed by cloud: `(camera to body, strength, colour (linear), sharpness)`;
+/// strength 0 while neither is up.
+pub fn glint(light: &WowLighting) -> (Vec3, f32, [f32; 3], f32) {
+    let rise = |dir: Vec3| {
+        smoothstep(
+            tune::GLINT_RISE_FROM_DEG,
+            tune::GLINT_RISE_TO_DEG,
+            elevation_deg(dir),
+        )
+    };
+    let cloud = 1.0
+        - (1.0 - tune::GLINT_OVERCAST) * light.cloud_density.max(light.storm_bcc).clamp(0.0, 1.0);
+    let sun = light.celestial_dir.normalize_or_zero();
+    let sun_up = rise(sun);
+    if sun_up > 0.0 {
+        return (
+            sun,
+            tune::SUN_GLINT * sun_up * cloud,
+            srgb_to_linear(light.celestial_tint),
+            tune::SUN_SHARPNESS,
+        );
+    }
+    let moon = light.moon_dir_white.normalize_or_zero();
+    (
+        moon,
+        tune::MOON_GLINT * rise(moon) * cloud,
+        tune::MOON_TINT,
+        tune::MOON_SHARPNESS,
+    )
+}
+
+/// The ripples' slope this frame: calm with the sun low or down, a breeze by day, rougher in a
+/// storm.
+pub fn ripple_slope(light: &WowLighting) -> f32 {
+    let day = smoothstep(
+        tune::BREEZE_FROM_DEG,
+        tune::BREEZE_TO_DEG,
+        elevation_deg(light.celestial_dir),
+    );
+    tune::RIPPLE_CALM
+        + (tune::RIPPLE_BREEZE - tune::RIPPLE_CALM) * day
+        + tune::RIPPLE_STORM * light.storm_bcc.clamp(0.0, 1.0)
+}
+
+/// The water block for this frame ([`WATER_ROWS`]); all zero, which `liquid.wgsl` reads as 1.12's
+/// water, when `on` is false.
+pub fn pack_rows(on: bool, held: &LookWater, light: &WowLighting) -> [[f32; 4]; WATER_ROWS] {
+    let mut rows = [[0.0; 4]; WATER_ROWS];
+    if !on {
+        return rows;
+    }
+    let mirror = tune::MIRROR * held.reflect.unwrap_or(1.0);
+    let clarity = held.clarity.unwrap_or(1.0);
+    let (body, strength, color, sharpness) = glint(light);
+    // The sky's reflection: the hour's dome, toward the fog under cloud.
+    let overcast = tune::OVERCAST_SKY * light.cloud_density.max(light.storm_bcc).clamp(0.0, 1.0);
+    let sky = |i: usize| {
+        let s = light.sky[i];
+        srgb_to_linear(std::array::from_fn(|c| {
+            s[c] + (light.fog_color[c] - s[c]) * overcast
+        }))
+    };
+    let (zenith, middle, horizon) = (sky(0), sky(2), sky(4));
+    rows[0] = [1.0, mirror, tune::CLEAR_YD * clarity, tune::FOAM];
+    rows[1] = [body.x, body.y, body.z, strength];
+    rows[2] = [color[0], color[1], color[2], sharpness];
+    rows[3] = [zenith[0], zenith[1], zenith[2], ripple_slope(light)];
+    rows[4] = [horizon[0], horizon[1], horizon[2], tune::RIPPLE_YD];
+    rows[5] = [
+        tune::SHALLOW[0],
+        tune::SHALLOW[1],
+        tune::SHALLOW[2],
+        tune::TINT_WEIGHT,
+    ];
+    rows[6] = [tune::DEEP[0], tune::DEEP[1], tune::DEEP[2], tune::DEEP_AT];
+    rows[7] = [
+        tune::SSR_REACH,
+        tune::F0,
+        tune::FOAM_DEPTH,
+        tune::SHORE_SOFT,
+    ];
+    rows[8] = [middle[0], middle[1], middle[2], tune::SHEEN];
+    rows[9] = [
+        tune::CLASSIC_RIPPLES,
+        tune::SHADOW_DIM,
+        tune::OCEAN_CLEAR_YD * clarity,
+        0.0,
+    ];
+    rows
+}
+
+/// Publishes this frame's [`WaterFrame`] from the switch, the hold and the resolved light.
+pub(crate) fn publish_water(
+    look: Res<WorldLook>,
+    water: Res<LookWater>,
+    light: Res<WowLighting>,
+    mut frame: ResMut<WaterFrame>,
+) {
+    let on = look.on && water.on;
+    let next = WaterFrame {
+        on,
+        rows: pack_rows(on, &water, &light),
+    };
+    if *frame != next {
+        *frame = next;
+    }
+}
+
+/// The size the scene copy wants: the look camera's target while the water is on, else a token
+/// texel, so the classic look holds no copy at all.
+pub fn scene_size(on: bool, target: Option<UVec2>) -> UVec2 {
+    match (on, target) {
+        (true, Some(t)) if t.x > 0 && t.y > 0 => t,
+        _ => UVec2::ONE,
+    }
+}
+
+/// Keeps the scene copy's two images at the look camera's size (a token texel while off), and on a
+/// change re-makes every liquid material's bind group, which holds the old textures until it is
+/// prepared again.
+pub(crate) fn size_water_scene(
+    frame: Res<WaterFrame>,
+    cams: Query<&Camera, With<super::LookView>>,
+    mut images: ResMut<Assets<Image>>,
+    mut materials: ResMut<Assets<benilla_assets::materials::LiquidMaterial>>,
+) {
+    use benilla_assets::materials::{water_scene_images, WATER_DEPTH, WATER_SCENE};
+    let target = cams.iter().find_map(|c| c.physical_target_size());
+    let want = scene_size(frame.on, target);
+    let have = images.get(WATER_SCENE.id()).map(|i| i.size());
+    if have == Some(want) {
+        return;
+    }
+    let (scene, depth) = water_scene_images(want.x, want.y);
+    let _ = images.insert(WATER_SCENE.id(), scene);
+    let _ = images.insert(WATER_DEPTH.id(), depth);
+    // Touch every liquid material: `iter_mut` marks each modified, so each is prepared again
+    // against the new images.
+    for (_, _material) in materials.iter_mut() {}
+    debug!("look water: scene copy at {}x{}", want.x, want.y);
+}
+
+/// Inserts the scene copy's images at a token size before any liquid material is made, so none
+/// waits on them.
+pub(crate) fn insert_water_scene(images: Option<ResMut<Assets<Image>>>) {
+    use benilla_assets::materials::{water_scene_images, WATER_DEPTH, WATER_SCENE};
+    let Some(mut images) = images else { return };
+    if images.get(WATER_SCENE.id()).is_none() {
+        let (scene, depth) = water_scene_images(1, 1);
+        let _ = images.insert(WATER_SCENE.id(), scene);
+        let _ = images.insert(WATER_DEPTH.id(), depth);
+    }
+}
+
+pub(crate) fn init_resources(app: &mut App) {
+    app.init_resource::<LookWater>()
+        .init_resource::<WaterFrame>();
+}
