+/// `lookwater <reflect> [clarity]`, benilla's own (1.12 has no such command): holds the new look's
+/// water (`benilla_world::look::water`) for tuning on film: its mirror at a multiple of the tuned
+/// one, 0 to 2 (0 none, 1 the tuned, 2 twice it), and optionally its clarity, 0 to 2 (toward 0
+/// murky, 2 twice as clear); `lookwater grade`, or no argument, lets go. `worldWater 0` and the
+/// classic look (`worldLook 0`) have 1.12's water either way.
+fn look_water(world: &mut World, args: &str) -> Vec<String> {
+    use benilla_world::look::{LookWater, WorldLook};
+    let Some((reflect, clarity)) = LookWater::parse(args) else {
+        return vec!["Usage: lookwater <reflect 0-2> [clarity 0-2] | grade".to_string()];
+    };
+    let on = {
+        let mut water = world.get_resource_or_init::<LookWater>();
+        water.reflect = reflect;
+        water.clarity = clarity;
+        water.on
+    };
+    let mut lines = vec![match (reflect, clarity) {
+        (None, _) => "Water at its tuning.".to_string(),
+        (Some(r), None) => format!("Water's mirror held at {r} times its own."),
+        (Some(r), Some(c)) => {
+            format!("Water's mirror held at {r} times its own, its clarity at {c} times.")
+        }
+    }];
+    if !on {
+        lines.push("worldWater is 0: 1.12's water.".to_string());
+    }
+    if !world.get_resource::<WorldLook>().is_some_and(|l| l.on) {
+        lines.push("The classic look (worldLook 0) has 1.12's water.".to_string());
+    }
+    lines
+}
