diff --git a/crates/benilla-world/src/shaders/world_water.wgsl b/crates/benilla-world/src/shaders/world_water.wgsl
new file mode 100644
index 0000000..32dc8c7
--- /dev/null
+++ b/crates/benilla-world/src/shaders/world_water.wgsl
@@ -0,0 +1,37 @@
+// The new look's water, its scene copy (`look::water_pass`), benilla's own (no reference
+// behaviour): between the opaque and the transparent passes, the world as it stands (no sky yet,
+// no water, no blended draw) and its depth are copied for the liquid shader, which cannot read the
+// target it draws into: the colour to mirror the shore in the water, the depth to know how deep
+// the water is under each of its pixels and where a mirrored ray meets the shore.
+//
+// The colour is copied as it is (1.12's gamma bytes, in the camera's `Rgba16Float`); the depth is
+// the device depth (reverse-Z, 0 the sky), one `R32Float` texel a pixel. `MSAA` reads sample 0 of a
+// multisampled depth buffer; the colour is the opaque pass's resolve. The copy is drawn at its own
+// size and reads the source at the same place, so a frame where the two differ (a resize, before
+// the copy follows) is stretched, never torn.
+
+#import bevy_core_pipeline::fullscreen_vertex_shader::FullscreenVertexOutput
+
+@group(0) @binding(0) var scene_tex: texture_2d<f32>;
+#ifdef MSAA
+@group(0) @binding(1) var depth_tex: texture_depth_multisampled_2d;
+#else
+@group(0) @binding(1) var depth_tex: texture_depth_2d;
+#endif
+
+struct CopyOut {
+    @location(0) color: vec4<f32>,
+    @location(1) depth: vec4<f32>,
+}
+
+@fragment
+fn fs_copy(in: FullscreenVertexOutput) -> CopyOut {
+    let dims = vec2<f32>(textureDimensions(scene_tex));
+    let px = vec2<i32>(clamp(in.uv * dims, vec2<f32>(0.0), dims - vec2<f32>(1.0)));
+    let ddims = vec2<f32>(textureDimensions(depth_tex));
+    let dpx = vec2<i32>(clamp(in.uv * ddims, vec2<f32>(0.0), ddims - vec2<f32>(1.0)));
+    var out: CopyOut;
+    out.color = vec4<f32>(textureLoad(scene_tex, px, 0).rgb, 1.0);
+    out.depth = vec4<f32>(textureLoad(depth_tex, dpx, 0), 0.0, 0.0, 1.0);
+    return out;
+}
-- 
