+    }
+
+    /// The block's size is its rows'.
+    #[test]
+    fn the_block_is_ten_rows() {
+        assert_eq!(WATER_BLOCK_BYTES, 160);
+    }
+}
diff --git a/crates/benilla-world/src/look/water_pass.rs b/crates/benilla-world/src/look/water_pass.rs
new file mode 100644
index 0000000..18fc0fa
--- /dev/null
+++ b/crates/benilla-world/src/look/water_pass.rs
@@ -0,0 +1,287 @@
+//! The new look's water, its render half, benilla's own (no reference behaviour): the water
+//! block's upload into [`LookWaterBuffer`] each frame, and the scene copy (`world_water.wgsl`)
+//! between the opaque and the transparent passes, which the liquid shader reads (`look::water`).
+//!
+//! The copy runs on the look camera ([`super::LookView`]) only while the water is on
+//! ([`WaterFrame::on`]): one full-screen draw into [`WATER_SCENE`] (the colour) and [`WATER_DEPTH`]
+//! (the device depth), at the view's size. Everything opaque is in the frame by then (the static
+//! pass draws first in the main pass, the opaque pass after it); the sky, the water and every
+//! blended draw are not, which is what the water wants: the sky is the shader's own fallback.
+
+use bevy::core_pipeline::core_3d::graph::{Core3d, Node3d};
+use bevy::core_pipeline::FullscreenShader;
+use bevy::ecs::query::QueryItem;
+use bevy::prelude::*;
+use bevy::render::diagnostic::RecordDiagnostics;
+use bevy::render::extract_resource::ExtractResourcePlugin;
+use bevy::render::render_asset::RenderAssets;
+use bevy::render::render_graph::{
+    NodeRunError, RenderGraphContext, RenderGraphExt, RenderLabel, ViewNode, ViewNodeRunner,
+};
+use bevy::render::render_resource::binding_types::{
+    texture_2d, texture_depth_2d, texture_depth_2d_multisampled,
+};
+use bevy::render::render_resource::*;
+use bevy::render::renderer::{RenderContext, RenderQueue};
+use bevy::render::texture::GpuImage;
+use bevy::render::view::{Msaa, ViewDepthTexture, ViewTarget};
+use bevy::render::{Render, RenderApp, RenderStartup, RenderSystems};
+
+use benilla_assets::materials::{WATER_DEPTH, WATER_SCENE};
+
+use super::pass::LookView;
+use super::water::{LookWaterBuffer, WaterFrame};
+
+#[derive(Debug, Hash, PartialEq, Eq, Clone, RenderLabel)]
+pub(crate) struct LookWaterLabel;
+
+/// The copy's targets: the colour as the camera holds it, the depth as one float.
+const SCENE_FORMAT: TextureFormat = TextureFormat::Rgba16Float;
+const DEPTH_FORMAT: TextureFormat = TextureFormat::R32Float;
+
+/// The copy's shader defs: `MSAA` reads a multisampled depth buffer.
+fn shader_defs(msaa: bool) -> Vec<bevy::shader::ShaderDefVal> {
+    if msaa {
+        vec!["MSAA".into()]
+    } else {
+        vec![]
+    }
+}
+
+/// Every def set the copy specialises `world_water.wgsl` on, for the app's shader translation
+/// test (naga validates each).
+pub fn shader_def_sets() -> Vec<Vec<bevy::shader::ShaderDefVal>> {
+    vec![shader_defs(false), shader_defs(true)]
+}
+
+#[derive(Resource)]
+struct WaterCopyPipeline {
+    layout: BindGroupLayoutDescriptor,
+    layout_msaa: BindGroupLayoutDescriptor,
+    shader: Handle<Shader>,
+    fullscreen: FullscreenShader,
+}
+
+impl WaterCopyPipeline {
+    fn layout(&self, msaa: bool) -> &BindGroupLayoutDescriptor {
+        if msaa {
+            &self.layout_msaa
+        } else {
+            &self.layout
+        }
+    }
+}
+
+impl SpecializedRenderPipeline for WaterCopyPipeline {
+    /// Whether the view's depth buffer is multisampled.
+    type Key = bool;
+
+    fn specialize(&self, msaa: bool) -> RenderPipelineDescriptor {
+        let target = |format| {
+            Some(ColorTargetState {
+                format,
+                blend: None,
+                write_mask: ColorWrites::ALL,
+            })
+        };
+        RenderPipelineDescriptor {
+            label: Some("look_water_copy".into()),
+            layout: vec![self.layout(msaa).clone()],
+            vertex: self.fullscreen.to_vertex_state(),
+            fragment: Some(FragmentState {
+                shader: self.shader.clone(),
+                shader_defs: shader_defs(msaa),
+                entry_point: Some("fs_copy".into()),
+                targets: vec![target(SCENE_FORMAT), target(DEPTH_FORMAT)],
+            }),
+            ..default()
+        }
+    }
+}
+
+fn init_pipeline(
+    mut commands: Commands,
+    fullscreen: Res<FullscreenShader>,
+    asset_server: Res<AssetServer>,
+) {
+    // Both reads are a `textureLoad` at a pixel: no sampler.
+    let layout = |label: &'static str, depth: BindGroupLayoutEntryBuilder| {
+        BindGroupLayoutDescriptor::new(
+            label,
+            &BindGroupLayoutEntries::sequential(
+                ShaderStages::FRAGMENT,
+                (
+                    texture_2d(TextureSampleType::Float { filterable: false }),
+                    depth,
+                ),
+            ),
+        )
+    };
+    commands.insert_resource(WaterCopyPipeline {
+        layout: layout("look_water_copy_layout", texture_depth_2d()),
+        layout_msaa: layout(
+            "look_water_copy_layout_msaa",
+            texture_depth_2d_multisampled(),
+        ),
+        shader: asset_server.load("embedded://benilla_world/shaders/world_water.wgsl"),
+        fullscreen: fullscreen.clone(),
+    });
+}
+
+/// One look view's copy pipeline, kept across frames.
+#[derive(Component)]
+struct WaterCopyGpu {
+    pipeline: CachedRenderPipelineId,
+    msaa: bool,
+}
+
+fn prepare_water_views(
+    mut commands: Commands,
+    cache: Res<PipelineCache>,
+    pipeline: Res<WaterCopyPipeline>,
+    mut pipelines: ResMut<SpecializedRenderPipelines<WaterCopyPipeline>>,
+    views: Query<(Entity, &Msaa, Option<&WaterCopyGpu>), With<LookView>>,
+) {
+    for (entity, msaa, existing) in &views {
+        let msaa = msaa.samples() > 1;
+        if existing.is_some_and(|g| g.msaa == msaa) {
+            continue;
+        }
+        let id = pipelines.specialize(&cache, &pipeline, msaa);
+        commands
+            .entity(entity)
+            .insert(WaterCopyGpu { pipeline: id, msaa });
+    }
+}
+
+/// Render world, in `PrepareResources`: writes the water block into its buffer before any liquid
+/// draw reads it (all zero, 1.12's water, while off).
+fn upload_water(
+    queue: Res<RenderQueue>,
+    buffer: Option<Res<LookWaterBuffer>>,
+    frame: Option<Res<WaterFrame>>,
+) {
+    let (Some(buffer), Some(frame)) = (buffer, frame) else {
+        return;
+    };
+    queue.write_buffer(&buffer.0, 0, bytemuck::cast_slice(&frame.rows));
+}
+
+#[derive(Default)]
+struct LookWaterNode;
+
+impl ViewNode for LookWaterNode {
+    type ViewQuery = (
+        &'static ViewTarget,
+        &'static ViewDepthTexture,
+        &'static WaterCopyGpu,
+    );
+
+    fn run<'w>(
+        &self,
+        _graph: &mut RenderGraphContext,
+        render_context: &mut RenderContext<'w>,
+        (view_target, depth, gpu): QueryItem<'w, '_, Self::ViewQuery>,
+        world: &'w World,
+    ) -> Result<(), NodeRunError> {
+        if !world.resource::<WaterFrame>().on {
+            return Ok(());
+        }
+        // The frame the look asks for a sampleable depth buffer, it is not one yet.
+        if !depth
+            .texture
+            .usage()
+            .contains(TextureUsages::TEXTURE_BINDING)
+        {
+            return Ok(());
+        }
+        let cache = world.resource::<PipelineCache>();
+        let Some(pipeline) = cache.get_render_pipeline(gpu.pipeline) else {
+            return Ok(()); // still compiling: the water reads last frame's copy
+        };
+        let images = world.resource::<RenderAssets<GpuImage>>();
+        let (Some(scene), Some(scene_depth)) = (images.get(&WATER_SCENE), images.get(&WATER_DEPTH))
+        else {
+            return Ok(());
+        };
+        let layout =
+            cache.get_bind_group_layout(world.resource::<WaterCopyPipeline>().layout(gpu.msaa));
+        let bind = render_context.render_device().create_bind_group(
+            "look_water_copy",
+            &layout,
+            &BindGroupEntries::sequential((view_target.main_texture_view(), depth.view())),
+        );
+        let attachment = |view| {
+            Some(RenderPassColorAttachment {
+                view,
+                depth_slice: None,
+                resolve_target: None,
+                ops: Operations::default(),
+            })
+        };
+        let diagnostics = render_context.diagnostic_recorder();
+        let mut pass = render_context
+            .command_encoder()
+            .begin_render_pass(&RenderPassDescriptor {
+                label: Some("look_water_copy"),
+                color_attachments: &[
+                    attachment(&scene.texture_view),
+                    attachment(&scene_depth.texture_view),
+                ],
+                depth_stencil_attachment: None,
+                timestamp_writes: None,
+                occlusion_query_set: None,
+            });
+        let span = diagnostics.pass_span(&mut pass, "look_water_copy");
+        pass.set_pipeline(pipeline);
+        pass.set_bind_group(0, &bind, &[]);
+        pass.draw(0..3, 0..1);
+        span.end(&mut pass);
+        Ok(())
+    }
+}
+
+/// The main-world half: the frame's and the buffer's extracts; the render half in [`finish`].
+pub(super) fn build(app: &mut App) {
+    app.add_plugins((
+        ExtractResourcePlugin::<WaterFrame>::default(),
+        ExtractResourcePlugin::<LookWaterBuffer>::default(),
+    ));
+}
+
+/// The render half, once the render app exists: the pipeline, the upload, and the copy between
+/// the opaque (and transmissive) passes and the transparent one, where the water draws.
+pub(super) fn finish(app: &mut App) {
+    let Some(render_app) = app.get_sub_app_mut(RenderApp) else {
+        return;
+    };
+    render_app
+        .init_resource::<SpecializedRenderPipelines<WaterCopyPipeline>>()
+        .add_systems(RenderStartup, init_pipeline)
+        .add_systems(
+            Render,
+            (prepare_water_views, upload_water).in_set(RenderSystems::PrepareResources),
+        )
+        .add_render_graph_node::<ViewNodeRunner<LookWaterNode>>(Core3d, LookWaterLabel)
+        .add_render_graph_edges(
+            Core3d,
+            (
+                Node3d::MainTransmissivePass,
+                LookWaterLabel,
+                Node3d::MainTransparentPass,
+            ),
+        );
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_copy_is_specialised_with_and_without_msaa() {
+        let sets = shader_def_sets();
+        assert_eq!(sets.len(), 2);
+        assert!(sets[0].is_empty());
+        assert_eq!(sets[1].len(), 1);
+    }
+}
