+/// The inertial blending runs while an add-on drives the action layer, as everything here does.
+fn blend_while_layer_live(inertia: Option<ResMut<benilla_world::rig_anim::PoseInertia>>) {
+    let Some(mut inertia) = inertia else { return };
+    let live = action_combat::layer_live();
+    if inertia.live != live {
+        inertia.live = live;
+    }
+}
