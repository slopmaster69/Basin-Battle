+/// `actionBlend` (benilla's own): the inertial blending between animations on or off.
+pub(crate) fn on_blend_cvar(
+    ev: On<crate::cvars::CvarChanged>,
+    inertia: Option<ResMut<benilla_world::rig_anim::PoseInertia>>,
+) {
+    if ev.key() != "actionblend" {
+        return;
+    }
+    if let Some(mut inertia) = inertia {
+        inertia.on = ev.flag();
+        info!(
+            "action: blending between animations {}",
+            if inertia.on { "on" } else { "off" }
+        );
+    }
+}
