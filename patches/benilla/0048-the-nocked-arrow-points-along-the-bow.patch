+/// Our own hero's nocked arrow points where the reticle is while the aiming camera is up (the
+/// reticle's point, `aim_marker`); everyone else's, and ours otherwise, along the bow.
+pub(super) fn aim_own_arrow(
+    mut arrows: Query<(
+        &mut benilla_world::rig_rider::RiderAimAt,
+        Option<&benilla_world::rig_rider::RigRider>,
+        Option<&benilla_world::rig_rider::AimedChild>,
+    )>,
+    me: Query<(), With<SelfPlayer>>,
+) {
+    let point = action_combat::reticle_point().map(|(p, _)| benilla_assets::coords::wow_to_bevy(p));
+    for (mut aim, rider, child) in &mut arrows {
+        let host = rider.map(|r| r.host).or(child.map(|c| c.host));
+        let want = if host.is_some_and(|h| me.contains(h)) { point } else { None };
+        if aim.world != want {
+            aim.world = want;
+        }
+    }
+}
