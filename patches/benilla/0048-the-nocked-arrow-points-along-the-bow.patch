+
+    /// A rider with a mark faces it from its own seat: -Z along the line, up kept up.
+    #[test]
+    fn an_aimed_rider_faces_its_mark_from_its_own_seat() {
+        let bone = Affine3A::from_rotation_translation(Quat::from_rotation_y(1.0), Vec3::new(0.0, 1.0, 0.0));
+        let target = Affine3A::from_translation(Vec3::new(2.0, 1.0, -3.0));
+        let seat = aimed_seat(&bone, Vec3::ZERO, &target, Vec3::new(0.0, 0.0, 0.0)).unwrap();
+        let from = Vec3::from(seat.translation);
+        assert!((from - Vec3::new(0.0, 1.0, 0.0)).length() < 1e-5, "its own seat");
+        let fwd = seat.transform_vector3(-Vec3::Z);
+        let want = (Vec3::new(2.0, 1.0, -3.0) - from).normalize();
+        assert!((fwd - want).length() < 1e-5, "facing the mark: {fwd:?}");
+        assert!(seat.transform_vector3(Vec3::Y).y > 0.99, "up kept up");
+        assert!(aimed_seat(&target, Vec3::ZERO, &target, Vec3::ZERO).is_none(), "no line, no turn");
+    }
+}
