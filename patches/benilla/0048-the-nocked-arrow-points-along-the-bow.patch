+/// Basin Battle: a model hung off a bone and turned to point its own forward (local -Z, the
+/// model's +X, the way a missile flies) at another of its host's points, a bone and an offset
+/// from it, keeping its own seat. The nocked arrow points at the bow's grip: 1.12's hold pose sets
+/// the string hand's bone across the bow, and with the shoulders turned to the aim the arrow lay
+/// sideways along the old stance.
+#[derive(Component, Clone, Copy)]
+pub struct RiderAimAt {
+    pub bone: u16,
+    pub local: Vec3,
+    /// A world point (Bevy space) to face instead, while one is set: our own hero's nocked arrow
+    /// points where the reticle is.
+    pub world: Option<Vec3>,
+}
+
+impl RiderAimAt {
+    /// The mark in the host rig's model space: the world point brought in through the rig's own
+    /// frame, else the host's point.
+    fn mark(&self, root: &GlobalTransform, model: &[Affine3A]) -> Option<Vec3> {
+        match self.world {
+            Some(w) => Some(root.affine().inverse().transform_point3(w)),
+            None => model.get(self.bone as usize).map(|t| t.transform_point3(self.local)),
+        }
+    }
+}
+
+/// The turn that sends local -Z along `dir` (a unit vector) with local +Y as near up as the line
+/// allows, as a missile flies.
+pub fn facing_along(dir: Vec3) -> Quat {
+    let side = Vec3::Y.cross(dir);
+    if side.length_squared() < 1e-6 {
+        return Quat::from_rotation_arc(-Vec3::Z, dir);
+    }
+    let up = dir.cross(side.normalize()).normalize();
+    Quat::from_mat3(&Mat3::from_cols(dir.cross(up), up, -dir))
+}
+
+/// A seat at `bone`'s point `local`, turned toward `target`'s point `target_local`, all in the
+/// host rig's model space; none when the two points meet.
+pub fn aimed_seat(bone: &Affine3A, local: Vec3, target: &Affine3A, target_local: Vec3) -> Option<Affine3A> {
+    aimed_seat_to(bone, local, target.transform_point3(target_local))
+}
+
+/// [`aimed_seat`] toward a point already in model space.
+pub fn aimed_seat_to(bone: &Affine3A, local: Vec3, to: Vec3) -> Option<Affine3A> {
+    let from = bone.transform_point3(local);
+    let d = to - from;
+    (d.length_squared() > 1e-8).then(|| Affine3A::from_rotation_translation(facing_along(d.normalize()), from))
+}
+
+/// [`RiderAimAt`] for a model drawn as a plain child of its bone's anchor (no rider lane): its
+/// host and the bone and point it hangs from, so its own turn under the anchor can be set.
+#[derive(Component, Clone, Copy)]
+pub struct AimedChild {
+    pub host: Entity,
+    pub bone: u16,
+    pub local: Vec3,
+}
+
+/// Turns each [`AimedChild`] under its bone's anchor so it faces its mark: its local turn is the
+/// bone's posed turn undone, then the aimed one.
+pub fn aim_child_models(
+    mut children: Query<(&RiderAimAt, &AimedChild, &mut Transform), Without<RigRider>>,
+    poses: Query<&RigPose>,
+    frames: Query<&GlobalTransform>,
+) {
+    for (aim, child, mut t) in &mut children {
+        let Ok(pose) = poses.get(child.host) else { continue };
+        let Ok(root) = frames.get(pose.joints_root) else { continue };
+        let Some(bone) = pose.model.get(child.bone as usize) else { continue };
+        let Some(to) = aim.mark(root, &pose.model) else { continue };
+        let Some(seat) = aimed_seat_to(bone, child.local, to) else { continue };
+        let (_, bone_turn, _) = bone.to_scale_rotation_translation();
+        let (_, seat_turn, _) = seat.to_scale_rotation_translation();
+        let turn = (bone_turn.inverse() * seat_turn).normalize();
+        if t.rotation != turn {
+            t.rotation = turn;
+        }
+    }
+}
+
