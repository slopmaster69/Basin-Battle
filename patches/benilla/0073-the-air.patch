+
+    /// The defaults: fog on at medium, sharpen 0.4, windows at 1; none of it under the classic
+    /// look; a held sharpness wins over `worldSharpen` and lets go to it again.
+    #[test]
+    fn the_frame_follows_the_switches() {
+        let mut air = LookAir::default();
+        let f = AirFrame::new(true, &air);
+        assert_eq!(
+            f.fog,
+            Some(FogQuality {
