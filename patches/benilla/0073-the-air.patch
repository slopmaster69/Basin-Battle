+/// The air's switches and the film's holds: `fog` is `worldFog` and `fog_quality`
+/// `worldFogQuality`; `fog_density` holds the mist's density at a multiple of the day's
+/// (`lookfog <d>`); `sharpen` is `worldSharpen` and `sharpen_held` `looksharpen`'s hold; `windows`
+/// scales the far windows (`lookwindows`, 0 none). Inert under the classic look.
+#[derive(Resource, Clone, Copy, Debug, PartialEq)]
+pub struct LookAir {
+    pub fog: bool,
+    pub fog_quality: u8,
+    pub fog_density: Option<f32>,
+    pub sharpen: f32,
+    pub sharpen_held: Option<f32>,
+    pub windows: f32,
+}
+
+impl Default for LookAir {
+    fn default() -> Self {
+        Self {
+            fog: true,
+            fog_quality: tune::QUALITY_DEFAULT,
+            fog_density: None,
+            sharpen: tune::SHARPEN_DEFAULT,
+            sharpen_held: None,
+            windows: 1.0,
+        }
+    }
+}
