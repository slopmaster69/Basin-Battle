+/// A quality step's layout: full-resolution pixels per fog texel each way, and march steps.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub struct FogQuality {
+    pub scale: u32,
+    pub steps: u32,
+}
+
+/// Quality step `level` (1–3, held there).
+pub fn fog_quality(level: u8) -> FogQuality {
+    let (scale, steps) = tune::QUALITY[usize::from(level.clamp(1, 3)) - 1];
+    FogQuality { scale, steps }
+}
