+/// `lookfog <density>`, benilla's own (1.12 has no such command): holds the volumetric fog's mist
+/// at a multiple (0 to 3) of the day's (`benilla_world::look::air`), for tuning on film; `lookfog
+/// quality <1-3>` sets its quality step (as `worldFogQuality`); `lookfog grade`, or no argument,
+/// follows the day again. `worldFog 0` and the classic look (`worldLook 0`) have none.
+fn look_fog(world: &mut World, args: &str) -> Vec<String> {
+    use benilla_world::look::air::FogCommand;
+    use benilla_world::look::{LookAir, WorldLook};
+    let Some(cmd) = LookAir::parse_fog(args) else {
+        return vec!["Usage: lookfog <density 0-3> | quality <1-3> | grade".to_string()];
+    };
+    let on = {
+        let mut air = world.get_resource_or_init::<LookAir>();
+        match cmd {
+            FogCommand::Density(d) => air.fog_density = d,
+            FogCommand::Quality(q) => air.fog_quality = q,
+        }
+        air.fog
+    };
+    let mut lines = vec![match cmd {
+        FogCommand::Density(None) => "Fog follows the day's mist.".to_string(),
+        FogCommand::Density(Some(d)) => format!("Fog held at {d} times the day's mist."),
+        FogCommand::Quality(q) => {
+            let l = benilla_world::look::air::fog_quality(q);
+            format!(
+                "Fog quality {q}: one sample every {} pixels, {} steps a ray.",
+                l.scale, l.steps
+            )
+        }
+    }];
+    if !on {
+        lines.push("worldFog is 0: the plain mist, no shafts.".to_string());
+    }
+    if !world.get_resource::<WorldLook>().is_some_and(|l| l.on) {
+        lines.push("The classic look (worldLook 0) has no fog.".to_string());
+    }
+    lines
+}
+
+/// `looksharpen <0-1>`, benilla's own: holds the new look's sharpen (`worldSharpen`'s value is
+/// kept underneath), for comparing on film; `looksharpen grade`, or no argument, lets go.
+fn look_sharpen(world: &mut World, args: &str) -> Vec<String> {
+    use benilla_world::look::{LookAir, WorldLook};
+    let Some(held) = LookAir::parse_sharpen(args) else {
+        return vec!["Usage: looksharpen <0-1> | grade".to_string()];
+    };
+    let base = {
+        let mut air = world.get_resource_or_init::<LookAir>();
+        air.sharpen_held = held;
+        air.sharpen
+    };
+    let mut lines = vec![match held {
+        None => format!("Sharpen follows worldSharpen ({base})."),
+        Some(s) => format!("Sharpen held at {s}."),
+    }];
+    if !world.get_resource::<WorldLook>().is_some_and(|l| l.on) {
+        lines.push("The classic look (worldLook 0) is not sharpened.".to_string());
+    }
+    lines
+}
+
