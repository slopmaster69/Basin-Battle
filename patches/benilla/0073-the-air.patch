+/// What the look pass needs of the air this frame (`look::pass::LookFrame::air`).
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub struct AirFrame {
+    /// The volumetric fog's layout, `None` with it off (the analytic mist then).
+    pub fog: Option<FogQuality>,
+    /// The sharpness, 0 none.
+    pub sharpen: f32,
+}
+
+impl AirFrame {
+    /// This frame's air from the switches, under the look `on`.
+    pub fn new(on: bool, air: &LookAir) -> Self {
+        if !on {
+            return Self::default();
+        }
+        Self {
+            fog: air.fog.then(|| fog_quality(air.fog_quality)),
+            sharpen: air.sharpness(),
+        }
