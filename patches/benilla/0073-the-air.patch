+        assert_eq!(f.sharpen, 0.4);
+        assert_eq!(AirFrame::new(false, &air), AirFrame::default());
+        air.sharpen_held = Some(1.0);
+        assert_eq!(AirFrame::new(true, &air).sharpen, 1.0);
+        air.sharpen_held = None;
+        air.fog = false;
+        assert_eq!(AirFrame::new(true, &air).fog, None);
+        assert_eq!(fog_quality(1), FogQuality { scale: 4, steps: 6 });
+        assert_eq!(
+            fog_quality(3),
