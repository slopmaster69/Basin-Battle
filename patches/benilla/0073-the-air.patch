+//! The volumetric fog's render half (`look::air` holds the why and the tunables): two low-
+//! resolution full-screen passes run inside the look node, before its own pass, on the depth
+//! buffer it already samples, the shared light buffer (the look lights' table and the sun-shadow
+//! block) and the sun-shadow map:
+//! 1. **march** (`world_fog.wgsl`'s `fs_march`): per fog texel, the lit share of the mist along
+//!    its ray and the lamps' glow, with this frame's jitter;
+//! 2. **resolve** (`fs_resolve`): a depth-aware 3×3 of the march, blended with last frame's
+//!    resolve reprojected through last frame's camera and clamped to the neighbourhood.
+//!
+//! The two resolve targets swap each frame, and each view keeps its own, so the history is never
+//! another view's. The look pass reads this frame's resolve and upsamples it by depth.
+
+use bevy::core_pipeline::FullscreenShader;
+use bevy::prelude::*;
+use bevy::render::diagnostic::RecordDiagnostics;
+use bevy::render::render_asset::RenderAssets;
+use bevy::render::render_resource::binding_types::{
+    storage_buffer_read_only_sized, texture_2d, texture_2d_array, texture_depth_2d,
+    texture_depth_2d_multisampled, uniform_buffer_sized,
+};
+use bevy::render::render_resource::*;
+use bevy::render::renderer::{RenderContext, RenderDevice, RenderQueue};
+use bevy::render::texture::GpuImage;
+use bevy::render::view::{ExtractedView, Msaa, ViewDepthTexture, ViewTarget};
+
+use super::air::{tune, FogQuality};
+use super::pass::{LookFrame, LookView};
+
+/// The fog passes' uniform, `world_fog.wgsl`'s `Fog`, field for field.
+#[repr(C)]
+#[derive(Clone, Copy, Debug, Default, PartialEq, bytemuck::Pod, bytemuck::Zeroable)]
+pub struct FogUniform {
+    pub world_from_clip: [[f32; 4]; 4],
+    pub prev_clip_from_world: [[f32; 4]; 4],
+    /// The camera and this frame's jitter.
+    pub camera: [f32; 4],
+    /// The camera's forward and the full-resolution pixels per fog texel.
+    pub fwd: [f32; 4],
+    /// The mist's density at its base (per yd), its base, its falloff and the march's steps.
+    pub mist: [f32; 4],
+    /// The reach into the sky, the history's weight, the lamps' in-scattering, the halo's core.
+    pub reach: [f32; 4],
+    /// The least density a halo sees, the resolve's depth tolerance, 0, 0.
+    pub misc: [f32; 4],
+}
+
+impl FogUniform {
+    /// One view's uniform from this frame's look, its camera and last frame's (`prev`), the
+    /// layout `q`, the jitter and the history's weight (0 to start over).
+    #[allow(clippy::too_many_arguments)]
+    pub fn new(
+        frame: &LookFrame,
+        q: FogQuality,
+        clip_from_world: Mat4,
+        cam_pos: Vec3,
+        cam_fwd: Vec3,
+        prev: Mat4,
+        jitter: f32,
+        keep: f32,
+    ) -> Self {
+        use super::rays;
+        Self {
+            world_from_clip: clip_from_world.inverse().to_cols_array_2d(),
+            prev_clip_from_world: prev.to_cols_array_2d(),
+            camera: cam_pos.extend(jitter).to_array(),
+            fwd: cam_fwd.extend(q.scale as f32).to_array(),
+            mist: [
+                frame.post.height_fog * rays::MIST_DENSITY,
+                rays::mist_base(frame.feet_y, cam_pos.y),
+                rays::MIST_FALLOFF,
+                q.steps as f32,
+            ],
+            reach: [
+                tune::FOG_SKY_REACH,
+                keep,
+                tune::LIGHT_SCATTER,
+                tune::LIGHT_CORE,
+            ],
+            misc: [tune::LIGHT_AIR, tune::FOG_EDGE, 0.0, 0.0],
+        }
+    }
+}
+
+const UNIFORM_BYTES: u64 = std::mem::size_of::<FogUniform>() as u64;
+
+/// The fog targets: the lamps' glow (linear) in rgb, the mist's lit share in alpha.
+pub(crate) const FOG_FORMAT: TextureFormat = TextureFormat::Rgba16Float;
+
+#[derive(Clone, Copy, PartialEq, Eq, Hash, Debug)]
+pub(crate) enum FogStage {
+    March,
+    Resolve,
+}
+
+#[derive(Clone, Copy, PartialEq, Eq, Hash, Debug)]
+pub(crate) struct FogKey {
+    stage: FogStage,
+    /// The view's depth buffer is multisampled (`gxMultisample`): both read sample 0.
+    msaa: bool,
+}
+
+fn shader_defs(msaa: bool) -> Vec<bevy::shader::ShaderDefVal> {
+    if msaa {
+        vec!["MSAA".into()]
+    } else {
+        vec![]
+    }
+}
+
+/// Every def set `world_fog.wgsl` is specialised on, for the app's shader translation test.
+pub fn shader_def_sets() -> Vec<Vec<bevy::shader::ShaderDefVal>> {
+    vec![shader_defs(false), shader_defs(true)]
+}
+
+#[derive(Resource)]
+pub(crate) struct FogPipeline {
+    /// The march's and the resolve's layouts with a single-sampled and a multisampled depth.
+    layouts: [BindGroupLayoutDescriptor; 4],
+    shader: Handle<Shader>,
+    fullscreen: FullscreenShader,
+    /// A one-texel, one-layer depth array the march binds before the sun-shadow map exists (its
+    /// rows then say none, so it is never read).
+    empty_shadow: TextureView,
+    /// A one-texel fog target (all zero) the look pass binds with the fog off.
+    pub(crate) empty: TextureView,
+}
+
+impl FogPipeline {
+    fn layout(&self, key: FogKey) -> &BindGroupLayoutDescriptor {
+        let i = match key.stage {
+            FogStage::March => 0,
+            FogStage::Resolve => 2,
+        } + usize::from(key.msaa);
+        &self.layouts[i]
+    }
+}
+
+impl SpecializedRenderPipeline for FogPipeline {
+    type Key = FogKey;
+
+    fn specialize(&self, key: Self::Key) -> RenderPipelineDescriptor {
+        let (label, entry) = match key.stage {
+            FogStage::March => ("world_fog", "fs_march"),
+            FogStage::Resolve => ("world_fog_resolve", "fs_resolve"),
+        };
+        RenderPipelineDescriptor {
+            label: Some(label.into()),
+            layout: vec![self.layout(key).clone()],
+            vertex: self.fullscreen.to_vertex_state(),
+            fragment: Some(FragmentState {
+                shader: self.shader.clone(),
+                shader_defs: shader_defs(key.msaa),
+                entry_point: Some(entry.into()),
+                targets: vec![Some(ColorTargetState {
+                    format: FOG_FORMAT,
+                    blend: None,
+                    write_mask: ColorWrites::ALL,
+                })],
+            }),
+            ..default()
+        }
+    }
+}
+
+fn one_texel(
+    device: &RenderDevice,
+    label: &'static str,
+    format: TextureFormat,
+    dimension: Option<TextureViewDimension>,
+) -> TextureView {
+    // Created zeroed, never written.
+    device
+        .create_texture(&TextureDescriptor {
+            label: Some(label),
+            size: Extent3d {
+                width: 1,
+                height: 1,
+                depth_or_array_layers: 1,
+            },
+            mip_level_count: 1,
+            sample_count: 1,
+            dimension: TextureDimension::D2,
+            format,
+            usage: TextureUsages::TEXTURE_BINDING,
+            view_formats: &[],
+        })
+        .create_view(&TextureViewDescriptor {
+            dimension,
+            ..default()
+        })
+}
+
+pub(crate) fn init_pipeline(
+    mut commands: Commands,
+    device: Res<RenderDevice>,
+    fullscreen: Res<FullscreenShader>,
+    asset_server: Res<AssetServer>,
+) {
+    let uniform = || uniform_buffer_sized(false, std::num::NonZero::new(UNIFORM_BYTES));
+    let march = |label: &'static str, depth: BindGroupLayoutEntryBuilder| {
+        BindGroupLayoutDescriptor::new(
+            label,
+            &BindGroupLayoutEntries::sequential(
+                ShaderStages::FRAGMENT,
+                (
+                    depth,
+                    uniform(),
+                    storage_buffer_read_only_sized(false, None),
+                    texture_2d_array(TextureSampleType::Depth),
+                ),
+            ),
+        )
+    };
+    let resolve = |label: &'static str, depth: BindGroupLayoutEntryBuilder| {
+        BindGroupLayoutDescriptor::new(
+            label,
+            &BindGroupLayoutEntries::with_indices(
+                ShaderStages::FRAGMENT,
+                (
+                    (0, depth),
+                    (1, uniform()),
+                    (
+                        4,
+                        texture_2d(TextureSampleType::Float { filterable: false }),
+                    ),
+                    (
+                        5,
+                        texture_2d(TextureSampleType::Float { filterable: false }),
+                    ),
+                ),
+            ),
+        )
+    };
+    commands.insert_resource(FogPipeline {
+        layouts: [
+            march("world_fog_layout", texture_depth_2d()),
+            march("world_fog_layout_msaa", texture_depth_2d_multisampled()),
+            resolve("world_fog_resolve_layout", texture_depth_2d()),
+            resolve(
+                "world_fog_resolve_layout_msaa",
+                texture_depth_2d_multisampled(),
+            ),
+        ],
+        shader: asset_server.load("embedded://benilla_world/shaders/world_fog.wgsl"),
+        fullscreen: fullscreen.clone(),
+        empty_shadow: one_texel(
+            &device,
+            "world_fog_empty_shadow",
+            TextureFormat::Depth16Unorm,
+            Some(TextureViewDimension::D2Array),
+        ),
+        empty: one_texel(&device, "world_fog_empty", FOG_FORMAT, None),
+    });
+}
+
+/// One view's fog targets: this frame's march and the two resolves that swap.
+struct FogTargets {
+    size: Extent3d,
+    march: TextureView,
+    resolve: [TextureView; 2],
+}
+
+/// One look view's fog: its pipelines, its uniform, its targets (none while the fog is off), and
+/// what the next frame needs to reproject: this frame's camera and which resolve it wrote.
+#[derive(Component)]
+pub(crate) struct LookFogGpu {
+    pipelines: [CachedRenderPipelineId; 2],
+    msaa: bool,
+    uniform: Buffer,
+    targets: Option<FogTargets>,
+    /// The resolve this frame writes (the other is last frame's).
+    write: usize,
+    frame: u32,
+    /// Last frame's camera, `None` with no history to reproject.
+    prev: Option<(Mat4, Vec3)>,
+}
+
+/// Whether the fog runs this frame: the look grading, the fog on, and some mist.
+pub(crate) fn wanted(frame: &LookFrame) -> Option<FogQuality> {
+    frame
+        .air
+        .fog
+        .filter(|_| frame.grades() && frame.post.height_fog > 0.0)
+}
+
+/// The history's weight this frame: none with no history or after a jump of the camera.
+pub fn history_weight(prev_cam: Option<Vec3>, cam: Vec3) -> f32 {
+    match prev_cam {
+        Some(p) if p.distance(cam) <= tune::FOG_RESET_JUMP => tune::FOG_HISTORY,
+        _ => 0.0,
+    }
+}
+
+/// The golden-ratio sequence: each frame's jitter well apart from the last few.
+pub fn frame_jitter(frame: u32) -> f32 {
+    (frame as f32 * 0.618_034).fract()
+}
+
+/// The fog's size for a frame `width × height` at `scale` pixels a texel.
+pub fn fog_size(width: u32, height: u32, scale: u32) -> Extent3d {
+    Extent3d {
+        width: width.div_ceil(scale.max(1)).max(1),
+        height: height.div_ceil(scale.max(1)).max(1),
+        depth_or_array_layers: 1,
+    }
+}
+
+/// A look view as [`prepare_fog_views`] reads it.
+type FogViewItem = (
+    Entity,
+    &'static ExtractedView,
+    &'static ViewTarget,
+    &'static Msaa,
+    Option<&'static mut LookFogGpu>,
+);
+
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn prepare_fog_views(
+    mut commands: Commands,
+    device: Res<RenderDevice>,
+    queue: Res<RenderQueue>,
+    cache: Res<PipelineCache>,
+    pipeline: Res<FogPipeline>,
+    mut pipelines: ResMut<SpecializedRenderPipelines<FogPipeline>>,
+    frame: Res<LookFrame>,
+    mut views: Query<FogViewItem, With<LookView>>,
+) {
+    let want = wanted(&frame);
+    for (entity, view, target, msaa, existing) in &mut views {
+        let msaa = msaa.samples() > 1;
+        // A new view's (or a changed one's) state is built here and inserted below; an existing
+        // one is edited in place.
+        let mut fresh: Option<LookFogGpu> = None;
+        let gpu: &mut LookFogGpu = match existing {
+            Some(gpu) if gpu.msaa == msaa => gpu.into_inner(),
+            _ => {
+                let mut id =
+                    |stage| pipelines.specialize(&cache, &pipeline, FogKey { stage, msaa });
+                fresh.insert(LookFogGpu {
+                    pipelines: [id(FogStage::March), id(FogStage::Resolve)],
+                    msaa,
+                    uniform: device.create_buffer(&BufferDescriptor {
+                        label: Some("world_fog_uniform"),
+                        size: UNIFORM_BYTES,
+                        usage: BufferUsages::UNIFORM | BufferUsages::COPY_DST,
+                        mapped_at_creation: false,
+                    }),
+                    targets: None,
+                    write: 0,
+                    frame: 0,
+                    prev: None,
+                })
+            }
+        };
+        if let Some(q) = want {
+            step_view(gpu, &device, &queue, &frame, q, view, target);
+        } else {
+            // Off: free the targets, forget the history.
+            gpu.targets = None;
+            gpu.prev = None;
+        }
+        if let Some(fresh) = fresh {
+            commands.entity(entity).insert(fresh);
+        }
+    }
+}
+
+/// One frame of one view's fog with the fog on: its targets sized to the view, and this frame's
+/// uniform with last frame's camera to reproject through.
+fn step_view(
+    gpu: &mut LookFogGpu,
+    device: &RenderDevice,
+    queue: &RenderQueue,
+    frame: &LookFrame,
+    q: FogQuality,
+    view: &ExtractedView,
+    target: &ViewTarget,
+) {
+    let full = target.main_texture().size();
+    let size = fog_size(full.width, full.height, q.scale);
+    if gpu.targets.as_ref().is_none_or(|t| t.size != size) {
+        let make = |label: &'static str| {
+            device
+                .create_texture(&TextureDescriptor {
+                    label: Some(label),
+                    size,
+                    mip_level_count: 1,
+                    sample_count: 1,
+                    dimension: TextureDimension::D2,
+                    format: FOG_FORMAT,
+                    usage: TextureUsages::RENDER_ATTACHMENT | TextureUsages::TEXTURE_BINDING,
+                    view_formats: &[],
+                })
+                .create_view(&TextureViewDescriptor::default())
+        };
+        gpu.targets = Some(FogTargets {
+            size,
+            march: make("world_fog_march"),
+            resolve: [make("world_fog_resolve_a"), make("world_fog_resolve_b")],
+        });
+        gpu.prev = None;
+    }
+    let world_from_view = view.world_from_view;
+    let clip_from_world = view
+        .clip_from_world
+        .unwrap_or_else(|| view.clip_from_view * Mat4::from(world_from_view.affine().inverse()));
+    let cam = world_from_view.translation();
+    let keep = history_weight(gpu.prev.map(|p| p.1), cam);
+    let uniform = FogUniform::new(
+        frame,
+        q,
+        clip_from_world,
+        cam,
+        world_from_view.forward().into(),
+        gpu.prev.map_or(clip_from_world, |p| p.0),
+        frame_jitter(gpu.frame),
+        keep,
+    );
+    queue.write_buffer(&gpu.uniform, 0, bytemuck::bytes_of(&uniform));
+    gpu.prev = Some((clip_from_world, cam));
+    gpu.frame = gpu.frame.wrapping_add(1);
+    gpu.write ^= 1;
+}
+
+/// One full-screen draw into `target` from `bind`.
+fn draw(
+    render_context: &mut RenderContext,
+    label: &'static str,
+    pipeline: &RenderPipeline,
+    bind: &BindGroup,
+    target: &TextureView,
+) {
+    let diagnostics = render_context.diagnostic_recorder();
+    let mut pass = render_context
+        .command_encoder()
+        .begin_render_pass(&RenderPassDescriptor {
+            label: Some(label),
+            color_attachments: &[Some(RenderPassColorAttachment {
+                view: target,
+                depth_slice: None,
+                resolve_target: None,
+                ops: Operations {
+                    load: LoadOp::Clear(Default::default()),
+                    store: StoreOp::Store,
+                },
+            })],
+            depth_stencil_attachment: None,
+            timestamp_writes: None,
+            occlusion_query_set: None,
+        });
+    let span = diagnostics.pass_span(&mut pass, label);
+    pass.set_pipeline(pipeline);
+    pass.set_bind_group(0, bind, &[]);
+    pass.draw(0..3, 0..1);
+    span.end(&mut pass);
+}
+
+/// Runs the march and the resolve for one view, ahead of the look pass, and returns the resolve
+/// the look pass reads and its pixels per texel; `None` (the look pass then draws the analytic
+/// mist) while the fog is off, its pipelines still compile, or the shared light is not up.
+pub(crate) fn encode(
+    render_context: &mut RenderContext,
+    world: &World,
+    frame: &LookFrame,
+    depth: &ViewDepthTexture,
+    gpu: Option<&LookFogGpu>,
+) -> Option<(TextureView, u32)> {
+    let q = wanted(frame)?;
+    let gpu = gpu?;
+    let targets = gpu.targets.as_ref()?;
+    let cache = world.resource::<PipelineCache>();
+    let [march, resolve] = gpu.pipelines.map(|id| cache.get_render_pipeline(id));
+    let (march, resolve) = (march?, resolve?);
+    let light = world.get_resource::<crate::lighting::SharedLightBuffer>()?;
+    let fog_pipeline = world.resource::<FogPipeline>();
+    let images = world.resource::<RenderAssets<GpuImage>>();
+    let shadow = images
+        .get(benilla_assets::materials::SHADOW_MAP.id())
+        .map_or(&fog_pipeline.empty_shadow, |i| &i.texture_view);
+    let device = render_context.render_device().clone();
+    let layout = |stage| {
+        cache.get_bind_group_layout(fog_pipeline.layout(FogKey {
+            stage,
+            msaa: gpu.msaa,
+        }))
+    };
+    let march_bind = device.create_bind_group(
+        "world_fog",
+        &layout(FogStage::March),
+        &BindGroupEntries::sequential((
+            depth.view(),
+            gpu.uniform.as_entire_binding(),
+            light.0.as_entire_binding(),
+            shadow,
+        )),
+    );
+    let (write, read) = (&targets.resolve[gpu.write], &targets.resolve[gpu.write ^ 1]);
+    let resolve_bind = device.create_bind_group(
+        "world_fog_resolve",
+        &layout(FogStage::Resolve),
+        &BindGroupEntries::with_indices((
+            (0, depth.view()),
+            (1, gpu.uniform.as_entire_binding()),
+            (4, &targets.march),
+            (5, read),
+        )),
+    );
+    draw(
+        render_context,
+        "world_fog",
+        march,
+        &march_bind,
+        &targets.march,
+    );
+    draw(
+        render_context,
+        "world_fog_resolve",
+        resolve,
+        &resolve_bind,
+        write,
+    );
+    Some((write.clone(), q.scale))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::look::air::{fog_quality, AirFrame};
+    use crate::look::PostLook;
+
+    /// `world_fog.wgsl`'s `Fog`: two `mat4x4<f32>` then five `vec4<f32>` rows, 208 bytes.
+    #[test]
+    fn the_uniform_layout_matches_the_shader() {
+        assert_eq!(UNIFORM_BYTES, 2 * 64 + 5 * 16);
+        assert_eq!(std::mem::offset_of!(FogUniform, camera), 128);
+        assert_eq!(std::mem::offset_of!(FogUniform, misc), 192);
+    }
+
+    /// The shader's view of the shared light buffer: 21 header rows, the point table and the
+    /// look's lights, then the shadow block, as `global_light` packs them.
+    #[test]
+    fn the_light_prefix_matches_the_packer() {
+        use crate::lighting::{LIGHT_HEADER_ROWS, MAX_POINT_LIGHTS};
+        assert_eq!(LIGHT_HEADER_ROWS, 21);
+        assert_eq!(2 * MAX_POINT_LIGHTS, 512);
+        assert_eq!(crate::look::lights::LOOK_LIGHT_ROWS, 48);
+        assert_eq!(crate::look::shadows::SHADOW_ROWS, 14);
+    }
+
+    fn frame(height_fog: f32) -> LookFrame {
+        LookFrame {
+            on: true,
+            post: PostLook {
+                height_fog,
+                saturation: 1.1,
+                ..PostLook::NEUTRAL
+            },
+            feet_y: Some(40.0),
+            air: AirFrame {
+                fog: Some(fog_quality(2)),
+                sharpen: 0.0,
+            },
+            ..default()
+        }
+    }
+
+    /// The uniform carries the mist the look pass draws (the same density, base and falloff) and
+    /// the quality's layout; the fog runs only while there is mist to carve.
+    #[test]
+    fn a_view_uniform_carries_the_mist() {
+        let f = frame(0.7);
+        let q = fog_quality(2);
+        let proj =
+            Mat4::perspective_infinite_reverse_rh(std::f32::consts::FRAC_PI_4, 16.0 / 9.0, 0.1);
+        let cam = Vec3::new(0.0, 45.0, 0.0);
+        let clip_from_world = proj * Mat4::look_to_rh(cam, Vec3::NEG_Z, Vec3::Y);
+        let u = FogUniform::new(
+            &f,
+            q,
+            clip_from_world,
+            cam,
+            Vec3::NEG_Z,
+            clip_from_world,
+            0.3,
+            0.85,
+        );
+        assert!((u.mist[0] - 0.7 * super::super::rays::MIST_DENSITY).abs() < 1e-9);
+        assert_eq!(u.mist[1], 42.0, "two yards over the feet");
+        assert_eq!(u.mist[3], 12.0);
+        assert_eq!(u.fwd[3], 4.0);
+        assert_eq!(u.camera[3], 0.3);
+        assert_eq!(u.reach[1], 0.85);
+        assert_eq!(wanted(&f), Some(q));
+        assert_eq!(wanted(&frame(0.0)), None, "no mist: no fog pass");
+        assert_eq!(wanted(&LookFrame { on: false, ..f }), None);
+        let off = LookFrame {
+            air: AirFrame::default(),
+            ..f
+        };
+        assert_eq!(wanted(&off), None);
+    }
+
+    #[test]
+    fn the_history_starts_over_after_a_jump() {
+        let p = Vec3::new(10.0, 50.0, 10.0);
+        assert_eq!(history_weight(None, p), 0.0);
+        assert_eq!(history_weight(Some(p), p + Vec3::X), tune::FOG_HISTORY);
+        assert_eq!(history_weight(Some(p), p + Vec3::X * 50.0), 0.0);
+        // The jitter walks the unit interval without repeating soon.
+        let j: Vec<f32> = (0..8).map(frame_jitter).collect();
+        for a in 0..8 {
+            for b in (a + 1)..8 {
+                assert!((j[a] - j[b]).abs() > 0.05, "{j:?}");
+            }
+        }
+        let s = fog_size(1281, 720, 4);
+        assert_eq!((s.width, s.height), (321, 180));
+    }
+}
