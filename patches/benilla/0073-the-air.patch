+}
+
+fn smoothstep(e0: f32, e1: f32, x: f32) -> f32 {
+    let t = ((x - e0) / (e1 - e0)).clamp(0.0, 1.0);
+    t * t * (3.0 - 2.0 * t)
+}
+
+// ---------------------------------------------------------------- the fog, on the CPU
+
+/// The share of the mist's in-scattering along a ray that the sun reaches, as `world_fog.wgsl`'s
+/// `fs_march` takes it (keep the two in step): the ray's first `march` yards cut into `steps`
+/// segments spaced by the square, each weighted by the in-scattering it holds (`tr(t₀) − tr(t₁)`,
+/// `tr` the mist's transmittance from the camera), each asking `reaches` at a point `jitter` of
+/// the way along it; the rest of the ray, to `len`, all lit. 1 with no mist.
+pub fn lit_share(
+    tr: impl Fn(f32) -> f32,
+    reaches: impl Fn(f32) -> f32,
+    march: f32,
+    len: f32,
+    steps: u32,
+    jitter: f32,
+) -> f32 {
+    let total = 1.0 - tr(len);
+    if total < 1e-5 {
+        return 1.0;
+    }
+    let march = march.min(len);
+    let steps = steps.max(1);
+    let (mut lit, mut t_prev, mut tr_prev) = (0.0, 0.0, 1.0);
+    for i in 0..steps {
+        let f = (i + 1) as f32 / steps as f32;
+        let t_next = march * f * f;
+        let tr_next = tr(t_next);
+        let w = tr_prev - tr_next;
+        if w > 1e-6 {
+            lit += w * reaches(t_prev + (t_next - t_prev) * jitter);
+        }
+        t_prev = t_next;
+        tr_prev = tr_next;
+    }
+    lit += tr_prev - (1.0 - total);
+    (lit / total).clamp(0.0, 1.0)
+}
+
+/// A light's halo along a ray, the closed form `world_fog.wgsl`'s `halos` takes (keep them in
+/// step): `∫₀^len dt / (1 + ((t − t0)² + h²) / c²)` for a light whose foot on the ray is `t0`
+/// yards along it and `h` yards off it, `c` the halo's core.
+pub fn halo(t0: f32, h: f32, len: f32, c: f32) -> f32 {
+    let k = (c * c + h * h).sqrt();
+    c * c / k * (((len - t0) / k).atan() - (-t0 / k).atan())
+}
+
+/// The sun's light in the mist at cosine `mu` between the view ray and the sun (the look pass's
+/// `fog_phase`): Henyey–Greenstein over its own peak, over a floor every direction gets. 1
+/// straight at the sun.
+pub fn phase(mu: f32) -> f32 {
+    let g = tune::FOG_PHASE_G;
+    let hg = ((1.0 - g) * (1.0 - g) / (1.0 + g * g - 2.0 * g * mu.clamp(-1.0, 1.0))).powf(1.5);
+    tune::FOG_PHASE_ISO + (1.0 - tune::FOG_PHASE_ISO) * hg
+}
+
+// ---------------------------------------------------------------- the sharpen, on the CPU
+
+/// The contrast-adaptive sharpen of gamma pixel `c` from its four neighbours at sharpness `s`
+/// (`world_look.wgsl`'s `cas`; keep them in step): per channel, the lobe `−amp · s ·`
+/// [`tune::SHARPEN_LOBE`], `amp = √(min(lo, 1 − hi) / hi)` over the five, so a pixel whose
+/// neighbours already span the range (an edge) is pushed least.
+pub fn cas(c: [f32; 3], n: [[f32; 3]; 4], s: f32) -> [f32; 3] {
+    std::array::from_fn(|i| {
+        let lo = n.iter().fold(c[i], |m, p| m.min(p[i]));
+        let hi = n.iter().fold(c[i], |m, p| m.max(p[i]));
+        let amp = ((lo.min(1.0 - hi)) / hi.max(1e-4)).clamp(0.0, 1.0).sqrt();
+        let w = -amp * s * tune::SHARPEN_LOBE;
+        let sum: f32 = n.iter().map(|p| p[i]).sum();
+        ((c[i] + w * sum) / (1.0 + 4.0 * w)).clamp(0.0, 1.0)
+    })
+}
+
+/// The sharpness left at planar eye depth `z` of `s`: all of it near, [`tune::SHARPEN_FAR_KEEP`]
+/// of it far.
+pub fn sharpen_at(s: f32, z: f32) -> f32 {
+    let t = smoothstep(tune::SHARPEN_NEAR, tune::SHARPEN_FAR, z);
+    s * (1.0 + (tune::SHARPEN_FAR_KEEP - 1.0) * t)
+}
+
+// ---------------------------------------------------------------- the windows
+
+/// One lit window from afar: where it is (Bevy space) and its glow's colour (linear, its hue at
+/// a peak of 1, times its size's weight).
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct WindowPoint {
+    pub pos: Vec3,
+    pub color: [f32; 3],
+}
+
+fn srgb_to_linear(c: f32) -> f32 {
+    super::pass::srgb_to_linear(c)
+}
+
+/// A WMO window batch's points: its triangles (`positions` model-local, `transform` the
+/// placement's) pooled in [`tune::WINDOW_CELL`] cubes, each pool an area-weighted centre, in the
+/// batch's SIDN colour (`sidn`, gamma bytes) at a weight by its area. Pools under
+/// [`tune::WINDOW_MIN_AREA`] are dropped, the largest [`tune::WINDOW_PER_BATCH`] kept; a batch
+/// whose SIDN colour is near black has none.
+pub fn window_points(
+    positions: &[[f32; 3]],
+    indices: &[u32],
+    transform: &Transform,
+    sidn: [u8; 3],
+) -> Vec<WindowPoint> {
+    let peak = sidn.iter().copied().max().unwrap_or(0);
+    if peak < tune::WINDOW_MIN_SIDN {
+        return Vec::new();
+    }
+    let lin = sidn.map(|c| srgb_to_linear(f32::from(c) / 255.0));
+    let top = lin.iter().copied().fold(0.0f32, f32::max).max(1e-6);
+    let bright = f32::from(peak) / 255.0;
+    let hue = lin.map(|c| c / top * bright);
+    let mut pools: Vec<((i32, i32, i32), Vec3, f32)> = Vec::new();
+    let at = |i: u32| {
+        positions
+            .get(i as usize)
+            .map(|p| transform.transform_point(Vec3::from_array(*p)))
+    };
+    for &[i0, i1, i2] in indices.as_chunks::<3>().0 {
+        let (Some(a), Some(b), Some(c)) = (at(i0), at(i1), at(i2)) else {
+            continue;
+        };
+        let area = 0.5 * (b - a).cross(c - a).length();
+        // Also refuses a NaN from a degenerate vertex.
+        if area.is_nan() || area <= 0.0 {
+            continue;
+        }
+        let centre = (a + b + c) / 3.0;
+        let key = (centre / tune::WINDOW_CELL).floor().as_ivec3();
+        let key = (key.x, key.y, key.z);
+        match pools.iter_mut().find(|p| p.0 == key) {
+            Some(p) => {
+                p.1 += centre * area;
+                p.2 += area;
+            }
+            None => pools.push((key, centre * area, area)),
+        }
+    }
+    pools.retain(|p| p.2 >= tune::WINDOW_MIN_AREA);
+    pools.sort_by(|a, b| b.2.total_cmp(&a.2));
+    pools.truncate(tune::WINDOW_PER_BATCH);
+    pools
+        .into_iter()
+        .map(|(_, sum, area)| {
+            let w = (area / tune::WINDOW_REF_AREA).sqrt().clamp(0.5, 1.5);
+            WindowPoint {
+                pos: sum / area,
+                color: hue.map(|c| c * w),
+            }
+        })
+        .collect()
+}
+
+/// A window's glow at distance `d` from the camera, 0..1: in from [`tune::WINDOW_NEAR_START`] to
+/// [`tune::WINDOW_NEAR_FULL`], out from [`tune::WINDOW_FAR_START`] to [`tune::WINDOW_FAR_END`].
+pub fn window_band(d: f32) -> f32 {
+    smoothstep(tune::WINDOW_NEAR_START, tune::WINDOW_NEAR_FULL, d)
+        * (1.0 - smoothstep(tune::WINDOW_FAR_START, tune::WINDOW_FAR_END, d))
+}
+
+/// This frame's far windows, nearest first, at most [`tune::WINDOW_MAX`]: where each is and its
+/// glow's colour, already times the hour, the distance band and `lookwindows`. Empty by day,
+/// under the classic look and with `lookwindows 0`.
+#[derive(Resource, Clone, Debug, Default, PartialEq, ExtractResource)]
+pub struct WindowGlows {
+    pub glows: Vec<WindowPoint>,
+}
+
+/// Picks [`WindowGlows`] from every loaded building's window points: those in the band, in front
+/// of the camera and on screen, nearest first.
+pub fn pick_windows<'a>(
+    points: impl Iterator<Item = &'a WindowPoint>,
+    clip_from_world: Mat4,
+    cam: Vec3,
+    weight: f32,
+) -> Vec<WindowPoint> {
+    if weight <= 0.0 {
+        return Vec::new();
+    }
+    let mut out: Vec<(f32, WindowPoint)> = points
+        .filter_map(|p| {
+            let d = p.pos.distance(cam);
+            let band = window_band(d);
+            if band <= 0.0 {
+                return None;
+            }
+            let clip = clip_from_world * p.pos.extend(1.0);
+            if clip.w <= 1e-4 {
+                return None;
+            }
+            let ndc = clip.truncate() / clip.w;
+            if ndc.x.abs() > 1.05 || ndc.y.abs() > 1.05 {
+                return None;
+            }
+            let k = band * weight * tune::WINDOW_INTENSITY;
+            Some((
+                d,
+                WindowPoint {
+                    pos: p.pos,
+                    color: p.color.map(|c| c * k),
+                },
+            ))
+        })
+        .collect();
+    out.sort_by(|a, b| a.0.total_cmp(&b.0));
+    out.truncate(tune::WINDOW_MAX);
+    out.into_iter().map(|(_, p)| p).collect()
+}
+
+/// Publishes [`WindowGlows`] for this frame from the static world's window points, under the
+/// windows' own night track (`WowLighting::sidn_night`, 1.12's SIDN fraction).
+pub(crate) fn publish_windows(
+    look: Res<WorldLook>,
+    air: Option<Res<LookAir>>,
+    lighting: Res<crate::lighting::WowLighting>,
+    gx: Option<Res<crate::static_gx::StaticGx>>,
+    cam: Query<(&GlobalTransform, &Projection), With<crate::view::WorldCamera>>,
+    mut out: ResMut<WindowGlows>,
+) {
+    let scale = air.map_or(1.0, |a| a.windows);
+    let weight = if look.on {
+        lighting.sidn_night * scale
+    } else {
+        0.0
+    };
+    let next = match (gx, cam.iter().next()) {
+        (Some(gx), Some((t, proj))) if weight > 0.0 => {
+            let clip_from_world = proj.get_clip_from_view() * t.to_matrix().inverse();
+            pick_windows(gx.window_points(), clip_from_world, t.translation(), weight)
+        }
+        _ => Vec::new(),
+    };
+    if out.glows != next {
+        out.glows = next;
+    }
+}
+
+/// The glows' rows in the look pass's uniform (`world_look.wgsl`'s `glows`): per glow its screen
+/// UV, its core's and halo's sigma as a share of the screen's height, then its colour (dimmed by
+/// half the mist between, `mist` the mist's optical depth to a point) and the depth (reverse-Z)
+/// a nearer occluder must pass to hide it. Returns how many are written.
+pub fn glow_rows(
+    glows: &[WindowPoint],
+    clip_from_world: Mat4,
+    cam: Vec3,
+    up: Vec3,
+    mist: impl Fn(Vec3) -> f32,
+    rows: &mut [[f32; 4]],
+) -> usize {
+    let project = |p: Vec3| {
+        let c = clip_from_world * p.extend(1.0);
+        (c.w > 1e-4).then(|| (c.truncate() / c.w, c.w))
+    };
+    let mut n = 0;
+    for g in glows.iter().take(tune::WINDOW_MAX) {
+        if 2 * n + 1 >= rows.len() {
+            break;
+        }
+        let (Some((ndc, _)), Some((above, _))) = (project(g.pos), project(g.pos + up)) else {
+            continue;
+        };
+        let to = g.pos - cam;
+        let d = to.length();
+        let nearer = cam + to * ((d - tune::WINDOW_OCCLUDE_TOL).max(0.5) / d.max(1e-3));
+        let occl = project(nearer).map_or(1.0, |(c, _)| c.z);
+        // One yard up, as a share of the screen's height (NDC spans 2).
+        let yard = ((above.y - ndc.y) * 0.5).abs();
+        let keep = 1.0 - tune::WINDOW_MIST_KEEP * (1.0 - (-mist(g.pos)).exp());
+        rows[2 * n] = [
+            ndc.x * 0.5 + 0.5,
+            0.5 - ndc.y * 0.5,
+            tune::WINDOW_CORE_YD * yard,
+            tune::WINDOW_HALO_YD * yard,
+        ];
+        rows[2 * n + 1] = [
+            g.color[0] * keep,
+            g.color[1] * keep,
+            g.color[2] * keep,
+            occl,
+        ];
+        n += 1;
+    }
+    n
+}
+
+pub(crate) fn init_resources(app: &mut App) {
+    app.init_resource::<LookAir>()
+        .init_resource::<WindowGlows>();
+}
