+
+    fn mist_tr(density: f32) -> impl Fn(f32) -> f32 {
+        move |t: f32| (-density * t).exp()
+    }
+
+    /// With nothing in the sun's way the whole mist is lit; with all of it shadowed none is
+    /// within the march and all of it past; a shadow over the near half takes about the near
+    /// half's share of the in-scattering, whatever the step count.
+    #[test]
+    fn the_lit_share_weights_each_segment_by_its_mist() {
+        let tr = mist_tr(0.01);
+        assert!((lit_share(&tr, |_| 1.0, 100.0, 100.0, 12, 0.5) - 1.0).abs() < 1e-5);
+        assert!(lit_share(&tr, |_| 0.0, 100.0, 100.0, 12, 0.5) < 1e-5);
+        // Shadowed out to 100 yd of a 300 yd ray: the rest is lit.
+        let past = lit_share(&tr, |_| 0.0, 100.0, 300.0, 12, 0.5);
+        let want = (tr(100.0) - tr(300.0)) / (1.0 - tr(300.0));
+        assert!((past - want).abs() < 1e-4, "{past} vs {want}");
+        // A shadow over the first 50 yd: the near share, within a step's error.
+        let want = (1.0 - tr(50.0)) / (1.0 - tr(100.0));
+        for steps in [6, 12, 16] {
+            let mean: f32 = (0..64)
+                .map(|j| {
+                    let jit = (j as f32 + 0.5) / 64.0;
+                    lit_share(
+                        &tr,
+                        |t| if t < 50.0 { 0.0 } else { 1.0 },
+                        100.0,
+                        100.0,
+                        steps,
+                        jit,
+                    )
+                })
+                .sum::<f32>()
+                / 64.0;
+            assert!(
+                ((1.0 - mean) - want).abs() < 0.03,
+                "{steps} steps: {} vs {want}",
+                1.0 - mean
+            );
+        }
+        // No mist: lit.
+        assert_eq!(lit_share(|_| 1.0, |_| 0.0, 100.0, 100.0, 12, 0.5), 1.0);
+    }
+
+    /// The halo's closed form against a midpoint sum along the ray.
+    #[test]
+    fn the_halo_matches_a_numeric_one() {
+        for (t0, h, len) in [
+            (20.0, 0.5, 60.0),
+            (5.0, 3.0, 8.0),
+            (-2.0, 1.0, 40.0),
+            (50.0, 0.0, 30.0),
+        ] {
+            let c = tune::LIGHT_CORE;
+            let n = 20_000;
+            let dt = len / n as f32;
+            let numeric: f32 = (0..n)
+                .map(|i| {
+                    let t = (i as f32 + 0.5) * dt;
+                    dt / (1.0 + ((t - t0) * (t - t0) + h * h) / (c * c))
+                })
+                .sum();
+            let closed = halo(t0, h, len, c);
+            assert!(
+                (closed - numeric).abs() < 1e-3 * numeric.max(1.0),
+                "{t0} {h} {len}: {closed} vs {numeric}"
+            );
+        }
+        // Passing right by a light sees more of it than passing wide.
+        assert!(halo(20.0, 0.2, 60.0, 1.5) > 3.0 * halo(20.0, 4.0, 60.0, 1.5));
+    }
+
+    #[test]
+    fn the_phase_peaks_at_the_sun_and_never_drops_to_nothing() {
+        assert!((phase(1.0) - 1.0).abs() < 1e-6);
+        assert!(phase(0.9) < phase(0.99));
+        assert!(phase(-1.0) >= tune::FOG_PHASE_ISO);
+        assert!(phase(0.0) < 0.25);
+    }
+
+    /// A flat field is untouched; a dot on it is lifted (pushed from its neighbours), never past
+    /// 0..1; a pixel already at an edge is pushed less than one in a gentle ramp.
+    #[test]
+    fn the_sharpen_lifts_detail_without_halos() {
+        let flat = [0.4; 3];
+        assert!(cas(flat, [flat; 4], 1.0)
+            .iter()
+            .all(|c| (c - 0.4).abs() < 1e-6));
+        let dot = cas([0.5; 3], [[0.4; 3]; 4], 0.4);
+        assert!(dot[0] > 0.5, "{dot:?}");
+        let dark = cas([0.3; 3], [[0.4; 3]; 4], 0.4);
+        assert!(dark[0] < 0.3, "{dark:?}");
+        assert_eq!(cas([0.5; 3], [[0.4; 3]; 4], 0.0), [0.5; 3]);
+        let hard = cas([1.0; 3], [[0.0; 3]; 4], 1.0);
+        assert!(hard.iter().all(|c| (0.0..=1.0).contains(c)));
+        // The push is gentler where the neighbours already span the range.
+        let soft = cas([0.55; 3], [[0.45; 3]; 4], 1.0)[0] - 0.55;
+        let edge = cas([0.95; 3], [[0.05; 3]; 4], 1.0)[0] - 0.95;
+        assert!(soft > 0.0 && edge.abs() < soft * 2.0, "{soft} {edge}");
+        assert_eq!(sharpen_at(0.4, 10.0), 0.4);
+        assert!((sharpen_at(0.4, 500.0) - 0.4 * tune::SHARPEN_FAR_KEEP).abs() < 1e-6);
+    }
+
+    /// A building's window panes: two windows a wall apart become two points, each at its pane's
+    /// centre; a dark SIDN colour has none; the placement's transform moves them.
+    #[test]
+    fn window_batches_become_points() {
+        // Two 1×1.2 yd panes on the wall x = 0, ten yards apart along z, two triangles each.
+        let pane = |z: f32| {
+            [
+                [0.0, 1.0, z],
+                [0.0, 1.0, z + 1.0],
+                [0.0, 2.2, z + 1.0],
+                [0.0, 2.2, z],
+            ]
+        };
+        let mut positions = Vec::new();
+        let mut indices = Vec::new();
+        for z in [0.2, 10.2] {
+            let base = positions.len() as u32;
+            positions.extend(pane(z));
+            indices.extend([base, base + 1, base + 2, base, base + 2, base + 3]);
+        }
+        let t = Transform::from_xyz(100.0, 50.0, -20.0);
+        let pts = window_points(&positions, &indices, &t, [255, 200, 120]);
+        assert_eq!(pts.len(), 2, "{pts:?}");
+        let mut zs: Vec<f32> = pts.iter().map(|p| p.pos.z).collect();
+        zs.sort_by(f32::total_cmp);
+        assert!((zs[0] - (-20.0 + 0.7)).abs() < 1e-4, "{zs:?}");
+        assert!((zs[1] - (-20.0 + 10.7)).abs() < 1e-4, "{zs:?}");
+        assert!((pts[0].pos.x - 100.0).abs() < 1e-4 && (pts[0].pos.y - 51.6).abs() < 1e-4);
+        // Warm: red over blue, red at the size's weight.
+        assert!(pts[0].color[0] > pts[0].color[2]);
+        assert!(window_points(&positions, &indices, &t, [10, 10, 12]).is_empty());
+        // A stray index is skipped, not a panic.
+        assert!(window_points(&positions, &[0, 1, 99], &t, [255; 3]).is_empty());
+    }
+
+    /// The far windows: none near (the window itself shows), none behind the camera or off
+    /// screen, the nearest first, at most the cap, and none by day.
+    #[test]
+    fn the_far_windows_are_picked_by_distance_and_screen() {
+        let proj =
+            Mat4::perspective_infinite_reverse_rh(std::f32::consts::FRAC_PI_3, 16.0 / 9.0, 0.1);
+        let cam = Vec3::new(0.0, 60.0, 0.0);
+        let clip_from_world = proj * Mat4::look_to_rh(cam, Vec3::NEG_Z, Vec3::Y);
+        let at = |x: f32, z: f32| WindowPoint {
+            pos: Vec3::new(x, 55.0, z),
+            color: [1.0, 0.7, 0.4],
+        };
+        let mut pts = vec![at(0.0, -30.0), at(0.0, 300.0), at(900.0, -100.0)];
+        for i in 0..100 {
+            pts.push(at(i as f32 - 50.0, -300.0 - i as f32));
+        }
+        let picked = pick_windows(pts.iter(), clip_from_world, cam, 1.0);
+        assert_eq!(picked.len(), tune::WINDOW_MAX);
+        assert!(
+            picked.iter().all(|p| p.pos.z <= -300.0),
+            "near, behind and off screen out"
+        );
+        assert_eq!(picked[0].pos.z, -300.0, "nearest first");
+        assert!(pick_windows(pts.iter(), clip_from_world, cam, 0.0).is_empty());
+        assert_eq!(window_band(30.0), 0.0);
+        assert_eq!(window_band(400.0), 1.0);
+        assert_eq!(window_band(2000.0), 0.0);
+        // Their rows: on screen, a few pixels across at 300 yd, the occluder's depth nearer
+        // (larger, reverse-Z) than the window's own.
+        let mut rows = vec![[0.0; 4]; 2 * tune::WINDOW_MAX];
+        let n = glow_rows(&picked, clip_from_world, cam, Vec3::Y, |_| 0.0, &mut rows);
+        assert_eq!(n, tune::WINDOW_MAX);
+        let [u, v, core, halo] = rows[0];
+        assert!((0.0..=1.0).contains(&u) && (0.0..=1.0).contains(&v));
+        assert!(
+            core > 0.0 && halo > core && halo * 1080.0 < 20.0,
+            "{core} {halo}"
+        );
+        let own = clip_from_world * picked[0].pos.extend(1.0);
+        assert!(rows[1][3] > own.z / own.w);
+        assert_eq!(rows[1][0], picked[0].color[0], "no mist: undimmed");
+        let misty = glow_rows(&picked, clip_from_world, cam, Vec3::Y, |_| 1.0, &mut rows);
+        assert_eq!(misty, n);
+        assert!(rows[1][0] < picked[0].color[0] && rows[1][0] > 0.5 * picked[0].color[0]);
+    }
