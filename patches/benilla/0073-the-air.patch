+/// One `lookfog` command.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum FogCommand {
+    /// Hold the density at a multiple of the day's, or (`None`) follow the day again.
+    Density(Option<f32>),
+    /// The quality step, 1 to 3.
+    Quality(u8),
+}
+
+impl LookAir {
+    /// The quality step for a `worldFogQuality` value: rounded and held to 1–3.
+    pub fn quality_of(v: f32) -> u8 {
+        if v.is_finite() {
+            v.round().clamp(1.0, 3.0) as u8
+        } else {
+            tune::QUALITY_DEFAULT
+        }
+    }
+
+    /// The sharpness for a `worldSharpen` value: held to 0–1.
+    pub fn sharpen_of(v: f32) -> f32 {
+        if v.is_finite() {
+            v.clamp(0.0, 1.0)
+        } else {
+            tune::SHARPEN_DEFAULT
+        }
+    }
+
+    /// The mist's density scale under the volumetric fog: the held one, else 1.
+    pub fn density(&self) -> f32 {
+        self.fog_density.unwrap_or(1.0)
+    }
+
+    /// The sharpness this frame: the held one, else `worldSharpen`'s.
+    pub fn sharpness(&self) -> f32 {
+        Self::sharpen_of(self.sharpen_held.unwrap_or(self.sharpen))
+    }
+
+    /// `lookfog`'s arguments: a density from 0 to [`tune::DENSITY_MAX`], `quality <1-3>`, or
+    /// nothing (or `grade`) to follow the day again; `None` for anything else.
+    pub fn parse_fog(args: &str) -> Option<FogCommand> {
+        let words: Vec<&str> = args.split_whitespace().collect();
+        match words.as_slice() {
+            [] => Some(FogCommand::Density(None)),
+            [w] if w.eq_ignore_ascii_case("grade") => Some(FogCommand::Density(None)),
+            [w, q] if w.eq_ignore_ascii_case("quality") => q
+                .parse::<u8>()
+                .ok()
+                .filter(|q| (1..=3).contains(q))
+                .map(FogCommand::Quality),
+            [w] => w
+                .parse::<f32>()
+                .ok()
+                .filter(|v| (0.0..=tune::DENSITY_MAX).contains(v))
+                .map(|v| FogCommand::Density(Some(v))),
+            _ => None,
+        }
+    }
+
+    /// `looksharpen`'s argument: a sharpness from 0 to 1, or nothing (or `grade`) to follow
+    /// `worldSharpen` again; `None` for anything else.
+    pub fn parse_sharpen(args: &str) -> Option<Option<f32>> {
+        let words: Vec<&str> = args.split_whitespace().collect();
+        match words.as_slice() {
+            [] => Some(None),
+            [w] if w.eq_ignore_ascii_case("grade") => Some(None),
+            [w] => w
+                .parse::<f32>()
+                .ok()
+                .filter(|v| (0.0..=1.0).contains(v))
+                .map(Some),
+            _ => None,
+        }
+    }
+
+    /// `lookwindows`'s argument: a scale from 0 to [`tune::WINDOWS_MAX_SCALE`]; `None` for
+    /// anything else.
+    pub fn parse_windows(args: &str) -> Option<f32> {
+        let words: Vec<&str> = args.split_whitespace().collect();
+        match words.as_slice() {
+            [w] => w
+                .parse::<f32>()
+                .ok()
+                .filter(|v| (0.0..=tune::WINDOWS_MAX_SCALE).contains(v)),
+            _ => None,
+        }
+    }
+}
