@@ -0,0 +1,808 @@
+//! The air, the new look's own (no reference behaviour): volumetric fog with light shafts, a
+//! sharper picture, and lit windows glowing from afar. WoW Forever's last touches: a misty morning
+//! in the woods fills with shafts of sun between the trunks, the lamps glow in the night mist,
+//! 1.12's soft textures read crisper, and Goldshire seen from the hill at night is a cluster of
+//! warm windows.
+//!
+//! - **Fog** (`worldFog`, [`LookAir::fog`]): the mist of the day (0054's analytic height mist,
+//!   already scaled by the day's roll, a fog day, an event and the weather: `look::mist`) keeps its
+//!   closed form for how thick it is and what colour, and a low-resolution pass
+//!   (`look::fog_pass`, `world_fog.wgsl`) carves it: along each view ray it asks the sun-shadow
+//!   map (0065/0069) at a few jittered points how much of the mist's in-scattering the sun reaches
+//!   ([`lit_share`], each segment weighted by the exact share of the mist it holds), so trees and
+//!   buildings cut shafts out of it; and each of the look's lamps and torches (0057) glows in it, a
+//!   halo integrated along the ray in closed form ([`halo`]). The jitter settles over a few frames
+//!   in a depth-aware, reprojected resolve. The look pass lights the mist by the sun only where the
+//!   share says so ([`phase`] toward the sun). `worldFogQuality` 1–3 trades resolution and steps
+//!   for cost ([`fog_quality`]); with the fog off the analytic mist is drawn exactly as before.
+//! - **Sharpen** (`worldSharpen`, 0–1): a contrast-adaptive sharpen of the frame at the head of the
+//!   look pass ([`cas`], after AMD's CAS): a pixel is pushed away from its four neighbours, less
+//!   where they already differ a lot (no halos), and less with distance, where alpha-tested leaves
+//!   would crawl ([`sharpen_at`]).
+//! - **Windows** (`lookwindows <0-2>`): the WMO window batches 1.12 lights at night (MOMT SIDN,
+//!   `0x10`) are gathered into points as their buildings load ([`window_points`]); from about
+//!   [`tune::WINDOW_NEAR_START`] out, where the windows themselves shrink to a pixel and the fog
+//!   closes over them, each is drawn as a soft warm glow over the fog, faded in with the windows'
+//!   own night track (SIDN: 20:30 to 21:30, out 06:00 to 07:00) and out at great distance, and
+//!   hidden behind a hill or a nearer house ([`WindowGlows`]).
+//!
+//! Every tunable is in [`tune`]. `lookfog <density 0-3> | quality <1-3> | grade`, `looksharpen
+//! <0-1> | grade` and `lookwindows <0-2>` tune them live for film; `worldLook 0` has none of it.
+
+use bevy::prelude::*;
+use bevy::render::extract_resource::ExtractResource;
+
+use super::WorldLook;
+
+/// Every tunable of the air, in one place. A first pass, to tune on film. Lengths are yards.
+pub mod tune {
+    /// A sky pixel's ray reaches this far into the mist: shafts against the sky between the
+    /// trunks, and a fog day's veil over the horizon.
+    pub const FOG_SKY_REACH: f32 = 120.0;
+    /// How much of that veil the sky takes, so a fog day dims the sky without erasing it (the
+    /// analytic mist leaves the sky alone).
+    pub const FOG_SKY_SHARE: f32 = 0.5;
+    /// The sun's light in the mist toward it: Henyey–Greenstein's asymmetry (0.6 a forward glow
+    /// about as narrow as the analytic mist's `μ⁸`), and the share every direction gets, so a
+    /// shaft seen side-on still reads.
+    pub const FOG_PHASE_G: f32 = 0.6;
+    pub const FOG_PHASE_ISO: f32 = 0.15;
+    /// How much of last frame's lit share each frame keeps: the jitter settles in about five
+    /// frames.
+    pub const FOG_HISTORY: f32 = 0.85;
+    /// A camera that moves further than this in a frame (a goto, a cut) starts its history over.
+    pub const FOG_RESET_JUMP: f32 = 8.0;
+    /// The resolve's depth tolerance: a neighbour whose depth differs by this share counts half.
+    pub const FOG_EDGE: f32 = 20.0;
+    /// The lamps' and torches' glow in the mist: the in-scattering of a light's committed colour,
+    /// its halo's bright core (yd), and the least density a halo sees, so a lamp on a clear night
+    /// still has a faint one.
+    pub const LIGHT_SCATTER: f32 = 6.0;
+    pub const LIGHT_CORE: f32 = 1.5;
+    pub const LIGHT_AIR: f32 = 0.0015;
+    /// The most `lookfog` scales the mist's density by.
+    pub const DENSITY_MAX: f32 = 3.0;
+    /// The quality steps (`worldFogQuality`): full-resolution pixels per fog texel each way, and
+    /// march steps per ray. 1 low, 2 medium (the default), 3 high.
+    pub const QUALITY: [(u32, u32); 3] = [(4, 6), (4, 12), (2, 16)];
+    pub const QUALITY_DEFAULT: u8 = 2;
+
+    /// `worldSharpen`'s default: a gentle lift.
+    pub const SHARPEN_DEFAULT: f32 = 0.4;
+    /// The lobe weight at sharpness 1: AMD's CAS at its sharpest (−1/5).
+    pub const SHARPEN_LOBE: f32 = 0.2;
+    /// The sharpen fades with planar eye depth from the first to the second, down to the share
+    /// beyond: far foliage's alpha-tested edges are what would crawl.
+    pub const SHARPEN_NEAR: f32 = 25.0;
+    pub const SHARPEN_FAR: f32 = 120.0;
+    pub const SHARPEN_FAR_KEEP: f32 = 0.35;
+
+    /// Window points: a window batch's triangles are pooled in cubes this wide, and a pool
+    /// smaller than the area (yd²) is dropped; at most so many points a batch, the largest first.
+    pub const WINDOW_CELL: f32 = 2.5;
+    pub const WINDOW_MIN_AREA: f32 = 0.15;
+    pub const WINDOW_PER_BATCH: usize = 48;
+    /// A window whose SIDN colour is dimmer than this (peak byte) glows not at all.
+    pub const WINDOW_MIN_SIDN: u8 = 24;
+    /// A pool of this area (yd²) glows at full strength; others by the square root, within
+    /// half and one and a half.
+    pub const WINDOW_REF_AREA: f32 = 1.5;
+    /// The most glows drawn a frame, nearest first (`world_look.wgsl`'s `glows` holds two rows
+    /// each).
+    pub const WINDOW_MAX: usize = 64;
+    /// The glow fades in from the first distance to the second (where the window itself is a
+    /// pixel or two), and out from the third to the fourth.
+    pub const WINDOW_NEAR_START: f32 = 60.0;
+    pub const WINDOW_NEAR_FULL: f32 = 150.0;
+    pub const WINDOW_FAR_START: f32 = 1000.0;
+    pub const WINDOW_FAR_END: f32 = 1500.0;
+    /// A glow's bright core and its soft halo, yards across a sigma, and the fewest pixels each
+    /// is drawn at so a far window stays a point of light; the halo's share of the core's
+    /// brightness.
+    pub const WINDOW_CORE_YD: f32 = 0.9;
+    pub const WINDOW_HALO_YD: f32 = 3.0;
+    pub const WINDOW_CORE_MIN_PX: f32 = 0.9;
+    pub const WINDOW_HALO_MIN_PX: f32 = 2.5;
+    pub const WINDOW_HALO: f32 = 0.25;
+    /// A glow's brightness (linear, before the grade), enough to pass the bloom's prefilter.
+    pub const WINDOW_INTENSITY: f32 = 1.6;
+    /// A glow hides behind anything nearer than its window by this much (its own wall is not).
+    pub const WINDOW_OCCLUDE_TOL: f32 = 5.0;
+    /// How much of the mist's dimming a glow takes: lamps through fog stay visible.
+    pub const WINDOW_MIST_KEEP: f32 = 0.5;
+    /// The most `lookwindows` scales the glows by.
+    pub const WINDOWS_MAX_SCALE: f32 = 2.0;
+}
