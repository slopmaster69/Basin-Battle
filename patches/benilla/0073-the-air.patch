index 0000000..d66f69d
--- /dev/null
+++ b/crates/benilla-world/src/shaders/world_fog.wgsl
@@ -0,0 +1,274 @@
+// The new look's volumetric fog, benilla's own (`look::air`, `look::fog_pass`): how much of the
+// mist along each view ray the sun reaches, and the glow of the look's lamps and torches in it, at a
+// quarter or half of the frame's resolution. The look pass (`world_look.wgsl`) keeps the mist's own
+// closed form for how thick it is and what colour; this pass only carves it:
+//   fs_march   = the ray from the camera to the scene (or a fixed reach into the sky) cut into
+//                segments, each weighted by the exact share of the in-scattering it holds (the
+//                mist's transmittance at its ends, `look::air::segment_weights`), each asking the
+//                sun-shadow map (0065/0069) at a jittered point whether the sun reaches it; and each
+//                look light's halo integrated along the ray in closed form (`look::air::halo`).
+//                Writes (lamp glow rgb, the lit share of the mist).
+//   fs_resolve = a depth-aware 3×3 of this frame's march, blended with last frame's, reprojected
+//                through last frame's camera and clamped to the neighbourhood, so the jitter's
+//                noise settles over a few frames and never smears. Writes the same layout.
+// Every read is a `textureLoad`: no sampler. `MSAA` reads sample 0 of a multisampled depth buffer.
+
+#import bevy_core_pipeline::fullscreen_vertex_shader::FullscreenVertexOutput
+
+#ifdef MSAA
+@group(0) @binding(0) var depth_tex: texture_depth_multisampled_2d;
+#else
+@group(0) @binding(0) var depth_tex: texture_depth_2d;
+#endif
+
+struct Fog {
+    world_from_clip: mat4x4<f32>,
+    prev_clip_from_world: mat4x4<f32>,
+    // xyz = the camera, w = this frame's jitter (0..1).
+    camera: vec4<f32>,
+    // xyz = the camera's forward (unit), w = full-resolution pixels per fog texel.
+    fwd: vec4<f32>,
+    // x = the mist's density at its base (per yd), y = its base height, z = its falloff (yd),
+    // w = march steps.
+    mist: vec4<f32>,
+    // x = the reach into the sky (yd), y = the history's weight (0: start over), z = the lamps'
+    // in-scattering, w = the halo's core (yd).
+    reach: vec4<f32>,
+    // x = the least density a lamp's halo sees (per yd), y = the depth tolerance of the resolve's
+    // neighbourhood, zw unused.
+    misc: vec4<f32>,
+}
+@group(0) @binding(1) var<uniform> fog: Fog;
+
+// The shared light buffer's prefix (`lighting::global_light`): 21 header rows, the point table,
+// then the look's light table and its sun-shadow block. Only rows 1 (splits), the table and the
+// block are read; row 20 `.y` is the look light count.
+struct WowLight {
+    rows: array<vec4<f32>, 21>,
+    points: array<vec4<f32>, 512>,
+    look_lights: array<vec4<f32>, 48>,
+    shadow: array<vec4<f32>, 14>,
+}
+@group(0) @binding(2) var<storage, read> wow_light: WowLight;
+@group(0) @binding(3) var shadow_map: texture_depth_2d_array;
+
+// The resolve's inputs: this frame's march and last frame's resolve.
+@group(0) @binding(4) var cur_tex: texture_2d<f32>;
+@group(0) @binding(5) var hist_tex: texture_2d<f32>;
+
+// The density exponent's clamp (`look::rays::MIST_EXP_LIMIT`).
+const MIST_EXP_LIMIT: f32 = 30.0;
+
+fn load_depth(px: vec2<i32>) -> f32 {
+    let top = vec2<i32>(textureDimensions(depth_tex)) - vec2<i32>(1);
+    return textureLoad(depth_tex, clamp(px, vec2<i32>(0), top), 0);
+}
+
+// The full-resolution pixel a fog texel stands for: the middle of its block.
+fn source_px(k: vec2<i32>) -> vec2<i32> {
+    let s = i32(fog.fwd.w);
+    return k * s + vec2<i32>(s / 2);
+}
+
+// The view ray through full-resolution pixel `px` and its length to what the pixel shows; a sky
+// pixel (reverse-Z clear, depth 0) reaches `fog.reach.x` into it. `.xyz` the unit direction.
+fn view_ray(px: vec2<i32>, depth: f32) -> vec4<f32> {
+    let dims = vec2<f32>(textureDimensions(depth_tex));
+    let uv = (vec2<f32>(px) + vec2<f32>(0.5)) / dims;
+    let ndc_xy = vec2<f32>(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
+    let near4 = fog.world_from_clip * vec4<f32>(ndc_xy, 1.0, 1.0);
+    let dir = normalize(near4.xyz / near4.w - fog.camera.xyz);
+    if depth <= 0.0 {
+        return vec4<f32>(dir, fog.reach.x);
+    }
+    let w4 = fog.world_from_clip * vec4<f32>(ndc_xy, depth, 1.0);
+    return vec4<f32>(dir, length(w4.xyz / w4.w - fog.camera.xyz));
+}
+
+// The mist's optical depth from the camera `t` yards along unit `dir` (`look::rays`).
+fn optical_depth(dir: vec3<f32>, t: f32) -> f32 {
+    let y0 = fog.camera.y;
+    let k = fog.mist.x * exp(min(-(y0 - fog.mist.y) / fog.mist.z, MIST_EXP_LIMIT));
+    let a = dir.y * t / fog.mist.z;
+    if abs(a) < 1e-4 {
+        return k * t;
+    }
+    return k * t * (1.0 - exp(min(-a, MIST_EXP_LIMIT))) / a;
+}
+
+// Interleaved gradient noise (Jimenez 2014), shifted by the frame's jitter.
+fn jitter(px: vec2<i32>) -> f32 {
+    let p = vec2<f32>(px);
+    return fract(52.9829189 * fract(dot(p, vec2<f32>(0.06711056, 0.00583715))) + fog.camera.w);
+}
+
+// Whether the sun reaches world point `p`, eye depth `z`: 1 lit, down to 1 − strength in full
+// shadow; 1 with no shadows this frame or past their reach. One compare a step: the jitter and the
+// resolve soften it. `look::shadows::caster_texel`'s convention (0 at a slice's near face).
+fn sun_reaches(p: vec3<f32>, z: f32) -> f32 {
+    let head = wow_light.shadow[0];
+    if head.x < 0.5 || z >= head.w {
+        return 1.0;
+    }
+    let count = u32(head.x);
+    var c = 0u;
+    for (var i = 0u; i + 1u < count; i = i + 1u) {
+        if z > wow_light.shadow[1][i] {
+            c = i + 1u;
+        }
+    }
+    let res = wow_light.shadow[2].w;
+    for (var tries = 0u; tries < 2u; tries = tries + 1u) {
+        if c >= count {
+            break;
+        }
+        let centre = wow_light.shadow[6u + 2u * c];
+        let depth = wow_light.shadow[7u + 2u * c]; // near, 1/range, texel (yd), blend start
+        let d = p - centre.xyz;
+        let uv = vec2<f32>(dot(d, wow_light.shadow[2].xyz), -dot(d, wow_light.shadow[3].xyz))
+            * (0.5 * centre.w) + vec2<f32>(0.5);
+        if all(uv >= vec2<f32>(0.0)) && all(uv <= vec2<f32>(1.0)) {
+            let zr = (dot(d, wow_light.shadow[4].xyz) - depth.x) * depth.y
+                - depth.z * wow_light.shadow[5].w * depth.y;
+            let lim = i32(res) - 1;
+            let t = clamp(vec2<i32>(uv * res), vec2<i32>(0), vec2<i32>(lim));
+            var lit = select(0.0, 1.0, zr <= textureLoad(shadow_map, t, i32(c), 0));
+            lit = mix(lit, 1.0, smoothstep(head.z, head.w, z));
+            return 1.0 - head.y * (1.0 - lit);
+        }
+        c = c + 1u;
+    }
+    return 1.0;
+}
+
+// A look light's halo along the ray from the camera (unit `dir`, `len` yards): the closed form of
+// `∫ 1 / (1 + ((t − t0)² + h²) / c²) dt` over the ray, `t0` the light's foot on it and `h` its
+// distance off, times the light's window at `h` (none past its radius), the mist's density at the
+// light (at least the air's) and the transmittance to the light's foot (`look::air::halo`).
+fn halos(dir: vec3<f32>, len: f32) -> vec3<f32> {
+    let count = u32(wow_light.rows[20].y);
+    let c = fog.reach.w;
+    var sum = vec3<f32>(0.0);
+    for (var i = 0u; i < count; i = i + 1u) {
+        let pos_radius = wow_light.look_lights[2u * i];
+        let to = pos_radius.xyz - fog.camera.xyz;
+        let t0 = dot(to, dir);
+        let h2 = max(dot(to, to) - t0 * t0, 0.0);
+        let r2 = pos_radius.w * pos_radius.w;
+        if h2 >= r2 || t0 < -pos_radius.w || t0 - len > pos_radius.w {
+            continue;
+        }
+        let x2 = h2 / r2;
+        let window = (1.0 - x2) * (1.0 - x2);
+        let k = sqrt(c * c + h2);
+        let along = c * c / k * (atan((len - t0) / k) - atan(-t0 / k));
+        let rho = max(
+            fog.mist.x * exp(min(-(pos_radius.y - fog.mist.y) / fog.mist.z, MIST_EXP_LIMIT)),
+            fog.misc.x
+        );
+        let trans = exp(-optical_depth(dir, clamp(t0, 0.0, len)));
+        sum += wow_light.look_lights[2u * i + 1u].rgb * (window * along * rho * trans);
+    }
+    return sum * fog.reach.z;
+}
+
+@fragment
+fn fs_march(in: FullscreenVertexOutput) -> @location(0) vec4<f32> {
+    let k = vec2<i32>(in.position.xy);
+    let px = source_px(k);
+    let depth = load_depth(px);
+    let ray = view_ray(px, depth);
+    let dir = ray.xyz;
+    let len = ray.w;
+    let glow = halos(dir, len);
+
+    // The lit share: 1 with no mist or no shadows to carve it.
+    let head = wow_light.shadow[0];
+    let total = 1.0 - exp(-optical_depth(dir, len));
+    if fog.mist.x <= 0.0 || head.x < 0.5 || total < 1e-5 {
+        return vec4<f32>(glow, 1.0);
+    }
+    let march = min(len, head.w);
+    let steps = max(u32(fog.mist.w), 1u);
+    let cos_fwd = dot(dir, fog.fwd.xyz);
+    let j = jitter(k);
+    var lit = 0.0;
+    var t_prev = 0.0;
+    var tr_prev = 1.0;
+    for (var i = 0u; i < steps; i = i + 1u) {
+        // Segments grow with distance (squared spacing): fine near, where shafts are sharp.
+        let f = f32(i + 1u) / f32(steps);
+        let t_next = march * f * f;
+        let tr_next = exp(-optical_depth(dir, t_next));
+        let w = tr_prev - tr_next;
+        if w > 1e-6 {
+            let t = mix(t_prev, t_next, j);
+            lit += w * sun_reaches(fog.camera.xyz + dir * t, t * cos_fwd);
+        }
+        t_prev = t_next;
+        tr_prev = tr_next;
+    }
+    // Past the shadows' reach the sun reaches everything.
+    lit += tr_prev - (1.0 - total);
+    return vec4<f32>(glow, clamp(lit / total, 0.0, 1.0));
+}
+
+// Last frame's resolve at fog-texel position `p` (texel units, centres at +0.5), bilinear.
+fn history_at(p: vec2<f32>) -> vec4<f32> {
+    let top = vec2<i32>(textureDimensions(hist_tex)) - vec2<i32>(1);
+    let f = p - vec2<f32>(0.5);
+    let i = floor(f);
+    let w = f - i;
+    let c = vec2<i32>(i);
+    let a = textureLoad(hist_tex, clamp(c, vec2<i32>(0), top), 0);
+    let b = textureLoad(hist_tex, clamp(c + vec2<i32>(1, 0), vec2<i32>(0), top), 0);
+    let d = textureLoad(hist_tex, clamp(c + vec2<i32>(0, 1), vec2<i32>(0), top), 0);
+    let e = textureLoad(hist_tex, clamp(c + vec2<i32>(1, 1), vec2<i32>(0), top), 0);
+    return mix(mix(a, b, w.x), mix(d, e, w.x), w.y);
+}
+
+@fragment
+fn fs_resolve(in: FullscreenVertexOutput) -> @location(0) vec4<f32> {
+    let k = vec2<i32>(in.position.xy);
+    let top = vec2<i32>(textureDimensions(cur_tex)) - vec2<i32>(1);
+    let here = textureLoad(cur_tex, k, 0);
+    let d0 = load_depth(source_px(k));
+    // A depth-aware 3×3: neighbours across a silhouette (a trunk against the far wood) count for
+    // little, so a shaft's edge stays on its own side.
+    var sum = 0.0;
+    var weight = 0.0;
+    var lo = here.a;
+    var hi = here.a;
+    for (var y = -1; y <= 1; y++) {
+        for (var x = -1; x <= 1; x++) {
+            let q = clamp(k + vec2<i32>(x, y), vec2<i32>(0), top);
+            let s = textureLoad(cur_tex, q, 0).a;
+            let dq = load_depth(source_px(q));
+            let rel = abs(dq - d0) / max(max(dq, d0), 1e-7);
+            let w = 1.0 / (1.0 + rel * fog.misc.y);
+            sum += s * w;
+            weight += w;
+            lo = min(lo, s);
+            hi = max(hi, s);
+        }
+    }
+    let filtered = sum / weight;
+    // Where this texel's point was last frame.
+    let ray = view_ray(source_px(k), d0);
+    let p = fog.camera.xyz + ray.xyz * ray.w;
+    let clip = fog.prev_clip_from_world * vec4<f32>(p, 1.0);
+    var keep = fog.reach.y;
+    var prev = filtered;
+    if clip.w > 1e-4 && keep > 0.0 {
+        let ndc = clip.xy / clip.w;
+        let uv = vec2<f32>(ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5);
+        if all(uv >= vec2<f32>(0.0)) && all(uv <= vec2<f32>(1.0)) {
+            prev = clamp(history_at(uv * vec2<f32>(textureDimensions(hist_tex))).a, lo, hi);
+        } else {
+            keep = 0.0;
+        }
+    } else {
+        keep = 0.0;
+    }
+    return vec4<f32>(here.rgb, mix(filtered, prev, keep));
