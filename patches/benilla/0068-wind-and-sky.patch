@@ -34,6 +34,8 @@ struct WowLight {
     look_lights: array<vec4<f32>, 48>,
     // The new look's sun shadows (`look::shadows::pack_rows`, SHADOW_ROWS = 14).
     shadow: array<vec4<f32>, 14>,
+    // The new look's wind (`look::wind::pack_rows`, WIND_ROWS = 5), read in the vertex stage.
