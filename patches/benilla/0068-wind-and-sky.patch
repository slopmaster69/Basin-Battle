@@ -0,0 +1,622 @@
+//! One wind for the whole world, the new look's own (no reference behaviour): WoW Forever's world
+//! never stands still. 1.12 sways only the few models that author their own bone animation; under
+//! the new look the trees, bushes and grass all lean and sway in one wind:
+//! 1. **the wind** ([`velocity`]): a steady prevailing push plus three slowly turning parts, so its
+//!    direction and speed drift over hours, the same for every hero: it is a fixed function of the
+//!    server's clock ([`server_secs`]), never a local random. Each server day rolls how breezy it is
+//!    ([`day_roll`], a fixed hash of the day number, eased into the next over the last two hours);
+//!    it calms at night and rises in a storm;
+//! 2. **gusts** ([`gusts`]): soft fronts that cross the ground downwind every so often, so
+//!    neighbouring trees bend one after another; each front has its own strength and is patchy
+//!    across the wind;
+//! 3. **the sway** (`static_gx.wgsl`, `wow_model.wgsl`, `world_shadow.wgsl`, `wind_sway`): in the
+//!    vertex stage, a plant (a doodad whose model path names a tree, bush, fern and the like,
+//!    [`sways`]) leans downwind and sways with height above its base, little or none at the trunk,
+//!    each tree on its own phase; its leaves (alpha-tested batches) flutter a little more; the
+//!    ground clutter's tufts bend from the root (`wind_grass`). Models that animate their own bones
+//!    (1.12's own swaying trees) are skinned and left alone, so nothing sways twice;
+//! 4. **the clouds** drift with the same wind ([`drift`], the closed-form integral of
+//!    [`velocity`], so it too is the same on every client), in `look::sky`.
+//!
+//! Every tunable is in [`tune`]; [`pack_rows`] carries them to the shaders each frame in the shared
+//! light buffer's wind block. `worldWind 0` ([`LookWind::on`]) stills it on its own; `lookwind
+//! <strength> [gust]` holds it for film. `worldLook 0` packs an all-zero block, and every shader
+//! then draws 1.12's still geometry untouched.
+
+use bevy::math::DVec2;
+use bevy::prelude::*;
+
+use super::WorldLook;
+use crate::lighting::{WorldTime, WowLighting};
+use crate::view::WorldCamera;
+
+/// Every tunable of the wind, in one place. A first pass, to tune on film with `lookwind`. Speeds
+/// are in the wind's own units (about 1 on an ordinary breezy afternoon), lengths in yards, times
+/// in seconds.
+pub mod tune {
+    /// The steady prevailing wind (Bevy x, z): from the west-south-west, as Elwynn's clouds go.
+    pub const PREVAILING: [f32; 2] = [0.55, 0.2];
+    /// The turning parts: amplitude, period (hours, negative turns the other way) and phase
+    /// (radians). Their sum wanders the direction over hours and the speed between about 0.1 and 2.
+    pub const TURNING: [(f32, f32, f32); 3] =
+        [(0.55, 29.0, 0.7), (0.3, -11.3, 2.9), (0.15, 4.7, 5.1)];
+    /// A day's breeze, times the wind's speed: an ordinary day rolls between these...
+    pub const DAY_MIN: f32 = 0.55;
+    pub const DAY_MAX: f32 = 1.05;
+    /// ...and about one day in this many is a windy day, at this.
+    pub const WINDY_DAY_ONE_IN: u32 = 6;
+    pub const WINDY_DAY: f32 = 1.6;
+    /// The minute of the server's day from which the next day's roll eases in (to midnight).
+    pub const DAY_EASE_FROM_MIN: f32 = 1320.0;
+    /// The breeze at night, as a share of the day's; it rises with the sun between these
+    /// elevations (degrees).
+    pub const NIGHT_CALM: f32 = 0.55;
+    pub const CALM_FROM_DEG: f32 = -6.0;
+    pub const CALM_TO_DEG: f32 = 25.0;
+    /// How much a full storm adds to the strength.
+    pub const STORM: f32 = 1.2;
+    /// The strength the shaders take is this times the speed times the day's roll; the floor keeps
+    /// a little life in the stillest hour.
+    pub const STRENGTH_FLOOR: f32 = 0.2;
+    /// Gusts: their speed over the ground (yd/s), the spacing of the fronts downwind (yards, one
+    /// every spacing ÷ speed seconds at a point), a front's soft half-width as a share of the
+    /// spacing, and a front's strength at most (a day's roll scales it, 0.5 to 1).
+    pub const GUST_SPEED_YD: f32 = 9.0;
+    pub const GUST_SPACING_YD: f32 = 270.0;
+    pub const GUST_WIDTH: f32 = 0.09;
+    pub const GUST: f32 = 0.9;
+    /// The fronts are measured from a grid point near the camera, so the wind's slow turn does not
+    /// sweep them across the far world; the grid's size (yards).
+    pub const ORIGIN_GRID_YD: f32 = 1024.0;
+    /// A tree's lean: at height `h` above its base it moves `TREE_BEND × h² / (h + BEND_KNEE_YD)`
+    /// yards per unit of strength, so a 15 yd crown leans about 0.25 yd on a breezy day and a bush
+    /// barely moves but for its leaves.
+    pub const TREE_BEND: f32 = 0.021;
+    pub const BEND_KNEE_YD: f32 = 4.0;
+    /// The leaves' flutter (yards per unit of strength, full from 3 yd up), and the grass's bend
+    /// at a tuft's tip.
+    pub const LEAF_FLUTTER_YD: f32 = 0.035;
+    pub const GRASS_BEND_YD: f32 = 0.16;
+    /// The sway's clock wraps every this many seconds; the sway's angular speeds (radians a second)
+    /// are whole turns per wrap, so the wrap never shows: a crown's two sways, its sway across the
+    /// wind, and the leaves' flutter.
+    pub const CLOCK_WRAP_S: f64 = 120.0;
+    pub const SWAY_TURNS: [f32; 4] = [26.0, 41.0, 19.0, 170.0];
+    /// The cloud layer's speed over the ground per unit of wind (yd/s).
+    pub const CLOUD_SPEED_YD: f32 = 7.0;
+    /// The most `lookwind` scales the strength and the gusts by.
+    pub const SCALE_MAX: f32 = 3.0;
+}
+
+/// Rows the wind block takes at the end of the shared light buffer's prefix
+/// (`lighting::global_light`), mirrored as `wind: array<vec4<f32>, 5>` in `wow_model.wgsl`,
+/// `static_gx.wgsl` and `world_shadow.wgsl`; keep in sync:
+///   0 `[downwind x, downwind z (unit), strength, on]` ·
+///   1 `[gust strength, front spacing (yd), the train's travel mod spacing (yd), its front count
+///      mod 4096]` · 2 `[front origin x, z, sway clock (s, wrapped), front half-width (share)]` ·
+///   3 `[tree bend, bend knee (yd), leaf flutter (yd), grass bend (yd)]` ·
+///   4 the sway's four angular speeds (rad/s).
+pub const WIND_ROWS: usize = 5;
+
+/// `worldWind` and the film's hold: `on` (on by default, inert under the classic look); `strength`
+/// holds the strength at a multiple of the wind's own, `gust` the gusts (`lookwind`).
+#[derive(Resource, Clone, Copy, Debug, PartialEq)]
+pub struct LookWind {
+    pub on: bool,
+    pub strength: Option<f32>,
+    pub gust: Option<f32>,
+}
+
+impl Default for LookWind {
+    /// On, the `worldWind` CVar's registered "1".
+    fn default() -> Self {
+        Self {
+            on: true,
+            strength: None,
+            gust: None,
+        }
+    }
+}
+
+impl LookWind {
+    /// `lookwind`'s arguments: a strength scale from 0 to [`tune::SCALE_MAX`] and an optional gust
+    /// scale over the same range, or nothing (or `grade`) to follow the world's wind again; `None`
+    /// for anything else, which changes nothing.
+    pub fn parse(args: &str) -> Option<(Option<f32>, Option<f32>)> {
+        let in_range = |w: &str| {
+            w.parse::<f32>()
+                .ok()
+                .filter(|v| (0.0..=tune::SCALE_MAX).contains(v))
+        };
+        let mut words = args.split_whitespace();
+        let first = match words.next() {
+            None => return Some((None, None)),
+            Some(w) if w.eq_ignore_ascii_case("grade") => {
+                return words.next().is_none().then_some((None, None));
+            }
+            Some(w) => w,
+        };
+        let strength = in_range(first)?;
+        let gust = match words.next() {
+            None => None,
+            Some(w) => Some(in_range(w)?),
+        };
+        words.next().is_none().then_some((Some(strength), gust))
+    }
+}
+
+/// Whether a doodad's model sways in the wind: its path names a plant. Lower-case match on the
+/// whole path, so `World\Azeroth\Elwynn\PassiveDoodads\Trees\ElwynnTreeCanopy02.m2` and
+/// `ElwynnBush09.m2` sway, and a stump, a log, a lamppost or a treehouse don't.
+pub fn sways(path: &str) -> bool {
+    const PLANTS: [&str; 18] = [
+        "tree", "bush", "shrub", "fern", "grass", "plant", "flower", "reed", "cattail", "vine",
+        "ivy", "leaf", "leaves", "canopy", "hedge", "weed", "wheat", "sapling",
+    ];
+    // A vineyard's fence or post is not a vine.
+    const STILL: [&str; 13] = [
+        "stump",
+        "log",
+        "root",
+        "treehouse",
+        "trunk",
+        "dead",
+        "fallen",
+        "fence",
+        "post",
+        "pole",
+        "stake",
+        "sign",
+        "crate",
+    ];
+    let p = path.to_ascii_lowercase();
+    PLANTS.iter().any(|w| p.contains(w)) && !STILL.iter().any(|w| p.contains(w))
+}
+
+/// SplitMix64's finaliser, as `look::mist`'s: a fixed hash, the same on every machine.
+fn mix(x: u64) -> u64 {
+    let mut z = x.wrapping_add(0x9E37_79B9_7F4A_7C15);
+    z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
+    z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
+    z ^ (z >> 31)
+}
+
+fn unit(h: u64) -> f32 {
+    (h >> 40) as f32 / (1u64 << 24) as f32
+}
+
+/// Mixed into the day so the wind's dice are its own.
+const DAY_SALT: u64 = 0x7769_6E64_6461_7973; // "winddays"
+
+/// One server day's wind: how breezy (times the wind's speed) and how gusty (0.5 to 1).
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct WindDay {
+    pub breeze: f32,
+    pub gust: f32,
+}
+
+/// The day's roll: deterministic in `day` alone.
+pub fn day_roll(day: i64) -> WindDay {
+    let h = mix(day as u64 ^ DAY_SALT);
+    let windy = unit(h) < 1.0 / tune::WINDY_DAY_ONE_IN as f32;
+    let breeze = if windy {
+        tune::WINDY_DAY
+    } else {
+        tune::DAY_MIN + (tune::DAY_MAX - tune::DAY_MIN) * unit(mix(h))
+    };
+    WindDay {
+        breeze,
+        gust: 0.5 + 0.5 * unit(mix(h ^ 0x5555)),
+    }
+}
+
+/// The server's clock in seconds (its date and the fraction of its day), the same on every client
+/// and untouched by the film clock (`worldclock` moves the light only). Before a server clock
+/// lands, the local clock from noon, so the world viewer's wind still moves.
+pub fn server_secs(time: &WorldTime, local_secs: f64) -> f64 {
+    if time.live {
+        time.date as f64 * 86_400.0 + f64::from(time.minute_f) * 60.0
+    } else {
+        43_200.0 + local_secs
+    }
+}
+
+fn turning_omega(period_h: f32) -> f64 {
+    std::f64::consts::TAU / (f64::from(period_h) * 3600.0)
+}
+
+/// The world's wind at `secs` of the server's clock (Bevy x, z), in the wind's own units.
+pub fn velocity(secs: f64) -> Vec2 {
+    let mut v = DVec2::new(
+        f64::from(tune::PREVAILING[0]),
+        f64::from(tune::PREVAILING[1]),
+    );
+    for (a, period, phase) in tune::TURNING {
+        let ang = turning_omega(period) * secs + f64::from(phase);
+        v += f64::from(a) * DVec2::new(ang.cos(), ang.sin());
+    }
+    v.as_vec2()
+}
+
+/// How far the wind has carried the air by `secs` (the integral of [`velocity`], closed form, in
+/// wind-unit seconds), up to a constant: what the clouds drift by. f64 throughout; a caller wraps
+/// it to its own period before handing it to f32.
+pub fn drift(secs: f64) -> DVec2 {
+    let mut d = DVec2::new(
+        f64::from(tune::PREVAILING[0]),
+        f64::from(tune::PREVAILING[1]),
+    ) * secs;
+    for (a, period, phase) in tune::TURNING {
+        let w = turning_omega(period);
+        let ang = w * secs + f64::from(phase);
+        d += f64::from(a) / w * DVec2::new(ang.sin(), -ang.cos());
+    }
+    d
+}
+
+fn smoothstep(e0: f32, e1: f32, x: f32) -> f32 {
+    let t = ((x - e0) / (e1 - e0)).clamp(0.0, 1.0);
+    t * t * (3.0 - 2.0 * t)
+}
+
+/// The day's roll at `secs`, eased into the next day's over the last two hours of the server's
+/// day, so it never steps at midnight.
+pub fn day_at(secs: f64) -> WindDay {
+    let day = (secs / 86_400.0).floor();
+    let minute = ((secs - day * 86_400.0) / 60.0) as f32;
+    let (a, b) = (day_roll(day as i64), day_roll(day as i64 + 1));
+    let t = smoothstep(tune::DAY_EASE_FROM_MIN, 1440.0, minute);
+    WindDay {
+        breeze: a.breeze + (b.breeze - a.breeze) * t,
+        gust: a.gust + (b.gust - a.gust) * t,
+    }
+}
+
+/// The wind the world feels this frame: downwind (unit, Bevy x, z), the strength the sway takes
+/// and the gusts' strength, before any `lookwind` hold.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct WindState {
+    pub dir: Vec2,
+    pub strength: f32,
+    pub gust: f32,
+}
+
+/// The wind at `secs` of the server's clock under `light` (the sun's height calms the night, a
+/// storm raises it).
+pub fn wind_state(secs: f64, light: &WowLighting) -> WindState {
+    let v = velocity(secs);
+    let day = day_at(secs);
+    let elev = light
+        .celestial_dir
+        .normalize_or_zero()
+        .y
+        .clamp(-1.0, 1.0)
+        .asin()
+        .to_degrees();
+    let calm = tune::NIGHT_CALM
+        + (1.0 - tune::NIGHT_CALM) * smoothstep(tune::CALM_FROM_DEG, tune::CALM_TO_DEG, elev);
+    let storm = light.storm_bcc.clamp(0.0, 1.0);
+    let strength = (tune::STRENGTH_FLOOR + v.length() * day.breeze) * calm + tune::STORM * storm;
+    WindState {
+        dir: v.normalize_or(Vec2::X),
+        strength,
+        gust: tune::GUST * day.gust * (calm + storm).min(1.0),
+    }
+}
+
+/// The gust train at `secs`: how far its fronts have travelled modulo their spacing (yards), and
+/// how many whole spacings, modulo 4096 (each front's strength is a hash of its number).
+pub fn gusts(secs: f64) -> (f32, f32) {
+    let spacing = f64::from(tune::GUST_SPACING_YD);
+    let travelled = f64::from(tune::GUST_SPEED_YD) * secs;
+    let n = (travelled / spacing).floor();
+    (
+        (travelled - n * spacing) as f32,
+        n.rem_euclid(4096.0) as f32,
+    )
+}
+
+/// The fronts' origin: the camera snapped to the grid, so their lines stay put while it moves.
+pub fn front_origin(cam: Vec3) -> Vec2 {
+    let g = tune::ORIGIN_GRID_YD;
+    Vec2::new((cam.x / g).round() * g, (cam.z / g).round() * g)
+}
+
+/// The wind block for this frame ([`WIND_ROWS`]); all zero, which the shaders read as no wind, when
+/// `on` is false.
+pub fn pack_rows(
+    on: bool,
+    held: &LookWind,
+    state: WindState,
+    secs: f64,
+    cam: Vec3,
+) -> [[f32; 4]; WIND_ROWS] {
+    let mut rows = [[0.0; 4]; WIND_ROWS];
+    if !on {
+        return rows;
+    }
+    let strength = state.strength * held.strength.unwrap_or(1.0);
+    let gust = state.gust * held.gust.unwrap_or(1.0);
+    let (travel, count) = gusts(secs);
+    let origin = front_origin(cam);
+    let clock = secs.rem_euclid(tune::CLOCK_WRAP_S) as f32;
+    let turn = |turns: f32| turns * std::f32::consts::TAU / tune::CLOCK_WRAP_S as f32;
+    rows[0] = [state.dir.x, state.dir.y, strength, 1.0];
+    rows[1] = [gust, tune::GUST_SPACING_YD, travel, count];
+    rows[2] = [origin.x, origin.y, clock, tune::GUST_WIDTH];
+    rows[3] = [
+        tune::TREE_BEND,
+        tune::BEND_KNEE_YD,
+        tune::LEAF_FLUTTER_YD,
+        tune::GRASS_BEND_YD,
+    ];
+    rows[4] = tune::SWAY_TURNS.map(turn);
+    rows
+}
+
+/// This frame's wind, from [`publish_wind`] to the shared light's pack (`build_light_data`) and the
+/// clouds (`look::sky`): `rows` are [`pack_rows`]'s, all zero when off; `secs` the server's clock
+/// it was taken at.
+#[derive(Resource, Clone, Copy, Debug, PartialEq)]
+pub struct WindFrame {
+    pub on: bool,
+    pub rows: [[f32; 4]; WIND_ROWS],
+    pub secs: f64,
+}
+
+impl Default for WindFrame {
+    fn default() -> Self {
+        Self {
+            on: false,
+            rows: [[0.0; 4]; WIND_ROWS],
+            secs: 43_200.0,
+        }
+    }
+}
+
+/// Publishes this frame's [`WindFrame`] from the switch, the hold, the server's clock and the
+/// resolved light.
+pub(crate) fn publish_wind(
+    look: Res<WorldLook>,
+    wind: Res<LookWind>,
+    world_time: Res<WorldTime>,
+    time: Res<Time>,
+    light: Res<WowLighting>,
+    cam: Query<&GlobalTransform, With<WorldCamera>>,
+    mut frame: ResMut<WindFrame>,
+) {
+    let on = look.on && wind.on;
+    let secs = server_secs(&world_time, time.elapsed_secs_f64());
+    let cam = cam.iter().next().map_or(Vec3::ZERO, |g| g.translation());
+    *frame = WindFrame {
+        on,
+        rows: pack_rows(on, &wind, wind_state(secs, &light), secs, cam),
+        secs,
+    };
+}
+
+pub(crate) fn init_resources(app: &mut App) {
+    app.init_resource::<LookWind>().init_resource::<WindFrame>();
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn noon() -> WowLighting {
+        WowLighting {
+            celestial_dir: Vec3::new(0.3, 0.9, 0.2).normalize(),
+            ..default()
+        }
+    }
+
+    /// The wind's WGSL is one block mirrored in three shaders (naga_oil cannot import a function
+    /// that reads another module's binding): the copies must match to the letter.
+    #[test]
+    fn the_three_wind_blocks_match() {
+        fn block(src: &str) -> &str {
+            let start = src
+                .find("// ---- look wind:")
+                .expect("the wind block's start");
+            let end = src.find("// ---- end look wind ----").expect("its end");
+            &src[start..end]
+        }
+        let model = block(include_str!(
+            "../../../benilla-assets/src/shaders/wow_model.wgsl"
+        ));
+        assert_eq!(model, block(include_str!("../shaders/static_gx.wgsl")));
+        assert_eq!(model, block(include_str!("../shaders/world_shadow.wgsl")));
+        assert!(model.contains("fn wind_sway(") && model.contains("fn wind_grass("));
+    }
+
+    #[test]
+    fn plants_sway_and_the_rest_stands_still() {
+        for p in [
+            "World\\Azeroth\\Elwynn\\PassiveDoodads\\Trees\\ElwynnTreeCanopy02.m2",
+            "elwynnbush09.m2",
+            "World\\Generic\\PassiveDoodads\\Plants\\Fern01.m2",
+            "world/azeroth/elwynn/passivedoodads/detail/elwynngrass01.m2",
+        ] {
+            assert!(sways(p), "{p}");
+        }
+        for p in [
+            "world/azeroth/elwynn/passivedoodads/lamppost/lamppost.m2",
+            "World\\Generic\\PassiveDoodads\\Trees\\TreeStump01.m2",
+            "World\\Azeroth\\Elwynn\\PassiveDoodads\\Trees\\ElwynnLog01.m2",
+            "World\\Generic\\Human\\Passive Doodads\\Carts\\Cart01.m2",
+            "World\\Azeroth\\Elwynn\\PassiveDoodads\\Vineyard\\VineyardFencePost01.m2",
+        ] {
+            assert!(!sways(p), "{p}");
+        }
+    }
+
+    /// The day's roll is a fixed function of the day, ordinary days within their band, and about
+    /// one in six windy.
+    #[test]
+    fn each_day_rolls_its_own_breeze() {
+        assert_eq!(day_roll(20_400), day_roll(20_400));
+        let rolls: Vec<_> = (20_000..20_600).map(day_roll).collect();
+        let windy = rolls.iter().filter(|r| r.breeze == tune::WINDY_DAY).count();
+        assert!((60..=150).contains(&windy), "{windy} windy days in 600");
+        for r in &rolls {
+            assert!(
+                r.breeze == tune::WINDY_DAY || (tune::DAY_MIN..=tune::DAY_MAX).contains(&r.breeze)
+            );
+            assert!((0.5..=1.0).contains(&r.gust));
+        }
+    }
+
+    /// The roll never steps at midnight: the next day's eases in over the last two hours.
+    #[test]
+    fn the_day_eases_into_the_next() {
+        let midnight = 20_401.0 * 86_400.0;
+        let before = day_at(midnight - 0.5);
+        let after = day_at(midnight + 0.5);
+        assert!((before.breeze - after.breeze).abs() < 1e-3);
+        assert_eq!(day_at(midnight - 3.0 * 3600.0), day_roll(20_400));
+    }
+
+    /// The drift is the wind's integral: its change over a second is the wind's speed.
+    #[test]
+    fn the_drift_is_the_integral_of_the_wind() {
+        for secs in [0.0, 1.0e5, 1.76e9, 1.7612345e9] {
+            let d = drift(secs + 0.5) - drift(secs - 0.5);
+            let v = velocity(secs);
+            assert!((d.as_vec2() - v).length() < 1e-4, "{secs}: {d} vs {v}");
+        }
+    }
+
+    /// The wind turns and changes speed slowly: a minute apart it has barely moved, hours apart it
+    /// has.
+    #[test]
+    fn the_wind_drifts_slowly() {
+        let t = 1.76e9;
+        let a = velocity(t);
+        let b = velocity(t + 60.0);
+        assert!(a.angle_to(b).abs() < 0.05, "{a} {b}");
+        let spread: Vec<f32> = (0..48)
+            .map(|h| velocity(t + h as f64 * 3600.0).length())
+            .collect();
+        let lo = spread.iter().copied().fold(f32::MAX, f32::min);
+        let hi = spread.iter().copied().fold(0.0, f32::max);
+        assert!(hi - lo > 0.3, "the speed wanders over two days: {lo}..{hi}");
+        let turned = (0..48)
+            .map(|h| velocity(t).angle_to(velocity(t + h as f64 * 3600.0)).abs())
+            .fold(0.0, f32::max);
+        assert!(turned > 0.5, "the direction wanders: {turned}");
+    }
+
+    /// Calm at night, a breeze by day, more in a storm.
+    #[test]
+    fn the_night_is_calmer_and_a_storm_wilder() {
+        let t = 1.76e9;
+        let day = wind_state(t, &noon());
+        let night = wind_state(
+            t,
+            &WowLighting {
+                celestial_dir: Vec3::new(0.0, -0.6, 1.0).normalize(),
+                ..noon()
+            },
+        );
+        let storm = wind_state(
+            t,
+            &WowLighting {
+                storm_bcc: 1.0,
+                ..noon()
+            },
+        );
+        assert!(night.strength < day.strength && storm.strength > day.strength + 1.0);
+        assert!((day.dir.length() - 1.0).abs() < 1e-5);
+    }
+
+    #[test]
+    fn the_gust_train_travels_and_counts_its_fronts() {
+        let (a, n) = gusts(0.0);
+        assert_eq!((a, n), (0.0, 0.0));
+        let (a, n) = gusts(31.0);
+        assert!((a - (31.0 * tune::GUST_SPEED_YD - tune::GUST_SPACING_YD)).abs() < 1e-3);
+        assert_eq!(n, 1.0);
+        let (a, n) = gusts(1.76e9);
+        assert!((0.0..tune::GUST_SPACING_YD).contains(&a) && (0.0..4096.0).contains(&n));
+        assert_eq!(n.fract(), 0.0);
+    }
+
+    #[test]
+    fn the_block_is_zero_when_off_and_carries_the_hold() {
+        let state = wind_state(1.76e9, &noon());
+        assert_eq!(
+            pack_rows(false, &LookWind::default(), state, 1.76e9, Vec3::ZERO),
+            [[0.0; 4]; WIND_ROWS]
+        );
+        let rows = pack_rows(true, &LookWind::default(), state, 1.76e9, Vec3::ZERO);
+        assert_eq!(rows[0], [state.dir.x, state.dir.y, state.strength, 1.0]);
+        assert_eq!(rows[1][0], state.gust);
+        assert!((0.0..tune::CLOCK_WRAP_S as f32).contains(&rows[2][2]));
+        let held = LookWind {
+            strength: Some(2.0),
+            gust: Some(0.0),
+            ..default()
+        };
+        let rows = pack_rows(true, &held, state, 1.76e9, Vec3::ZERO);
+        assert_eq!(rows[0][2], 2.0 * state.strength);
+        assert_eq!(rows[1][0], 0.0);
+    }
+
+    /// The sway's speeds are whole turns per wrap of its clock, so the wrap never shows.
+    #[test]
+    fn the_sway_clock_wraps_seamlessly() {
+        let rows = pack_rows(
+            true,
+            &LookWind::default(),
+            wind_state(0.0, &noon()),
+            0.0,
+            Vec3::ZERO,
+        );
+        for w in rows[4] {
+            let turns = w * tune::CLOCK_WRAP_S as f32 / std::f32::consts::TAU;
+            assert!((turns - turns.round()).abs() < 1e-3, "{turns}");
+        }
+    }
+
+    #[test]
+    fn the_front_origin_snaps_to_its_grid() {
+        let o = front_origin(Vec3::new(9_100.0, 50.0, -300.0));
+        assert_eq!(o, Vec2::new(9_216.0, 0.0));
+    }
+
+    #[test]
+    fn lookwind_parses_its_arguments() {
+        assert_eq!(LookWind::parse(""), Some((None, None)));
+        assert_eq!(LookWind::parse("grade"), Some((None, None)));
+        assert_eq!(LookWind::parse("2"), Some((Some(2.0), None)));
+        assert_eq!(LookWind::parse("0 3"), Some((Some(0.0), Some(3.0))));
+        assert_eq!(LookWind::parse("4"), None);
+        assert_eq!(LookWind::parse("1 -1"), None);
+        assert_eq!(LookWind::parse("1 1 1"), None);
+        assert_eq!(LookWind::parse("grade 1"), None);
+        assert_eq!(LookWind::parse("gale"), None);
+    }
+
+    /// The wind follows `worldLook` and `worldWind` both.
+    #[test]
+    fn the_frame_follows_both_switches() {
+        let mut app = App::new();
+        app.insert_resource(WorldLook::NEW)
+            .init_resource::<LookWind>()
+            .init_resource::<WindFrame>()
+            .init_resource::<WorldTime>()
+            .init_resource::<Time>()
+            .insert_resource(noon())
+            .add_systems(Update, publish_wind);
+        app.update();
+        assert!(app.world().resource::<WindFrame>().on);
+        app.world_mut().resource_mut::<LookWind>().on = false;
+        app.update();
+        let f = *app.world().resource::<WindFrame>();
+        assert!(!f.on && f.rows == [[0.0; 4]; WIND_ROWS]);
+        app.world_mut().resource_mut::<LookWind>().on = true;
+        *app.world_mut().resource_mut::<WorldLook>() = WorldLook::CLASSIC;
+        app.update();
+        assert!(!app.world().resource::<WindFrame>().on);
+    }
+}
