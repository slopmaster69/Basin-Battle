+/// `lookwind <strength> [gust]`, benilla's own (1.12 has no such command): holds the new look's
+/// wind (`benilla_world::look::wind`) for tuning on film: its strength at a multiple of the
+/// world's own, 0 to 3 (0 still, 1 the world's, 3 three times it), and optionally its gusts, 0 to
+/// 3; `lookwind grade`, or no argument, lets go. `worldWind 0` and the classic look (`worldLook 0`)
+/// keep 1.12's still world either way.
+fn look_wind(world: &mut World, args: &str) -> Vec<String> {
+    use benilla_world::look::{LookWind, WorldLook};
+    let Some((strength, gust)) = LookWind::parse(args) else {
+        return vec!["Usage: lookwind <strength 0-3> [gust 0-3] | grade".to_string()];
+    };
+    let on = {
+        let mut wind = world.get_resource_or_init::<LookWind>();
+        wind.strength = strength;
+        wind.gust = gust;
+        wind.on
+    };
+    let mut lines = vec![match (strength, gust) {
+        (None, _) => "Wind follows the world's.".to_string(),
+        (Some(s), None) => format!("Wind held at {s} times the world's."),
+        (Some(s), Some(g)) => {
+            format!("Wind held at {s} times the world's, its gusts at {g} times.")
+        }
+    }];
+    if !on {
+        lines.push("worldWind is 0: the world stands still.".to_string());
+    }
+    if !world.get_resource::<WorldLook>().is_some_and(|l| l.on) {
+        lines.push("The classic look (worldLook 0) has no wind.".to_string());
+    }
+    lines
+}
+
+/// `looksky clouds <cover>`, benilla's own (1.12 has no such command): holds the new look's
+/// painted sky (`benilla_world::look::sky`) at a cloud cover from 0 (none) to 1 (overcast), what
+/// the day and the weather say notwithstanding, for tuning on film (the server sends no weather
+/// yet); `looksky grade`, or no argument, lets go. `worldSky 0` and the classic look (`worldLook
+/// 0`) have 1.12's sky either way.
+fn look_sky(world: &mut World, args: &str) -> Vec<String> {
+    use benilla_world::look::{LookSky, WorldLook};
+    let Some(clouds) = LookSky::parse(args) else {
+        return vec!["Usage: looksky clouds <0-1> | grade".to_string()];
+    };
+    let on = {
+        let mut sky = world.get_resource_or_init::<LookSky>();
+        sky.clouds = clouds;
+        sky.on
+    };
+    let mut lines = vec![match clouds {
+        None => "Sky follows the day and the weather.".to_string(),
+        Some(c) => format!("Cloud cover held at {c}."),
+    }];
+    if !on {
+        lines.push("worldSky is 0: 1.12's sky.".to_string());
+    }
+    if !world.get_resource::<WorldLook>().is_some_and(|l| l.on) {
+        lines.push("The classic look (worldLook 0) has 1.12's sky.".to_string());
+    }
+    lines
+}
