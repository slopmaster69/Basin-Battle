+    /// `worldWind` and `worldSky` (benilla's own) turn the new look's wind and its painted sky off
+    /// and on, each by itself, registered "1" to match `LookWind`'s and `LookSky`'s defaults.
+    #[test]
+    fn world_wind_and_world_sky_switch_alone() {
+        use benilla_world::look::{LookSky, LookWind, WorldLook};
+        let mut app = cvar_app();
+        assert!(
+            res::<LookWind>(&app).on && res::<LookSky>(&app).on,
+            "registered \"1\""
+        );
+        assert_eq!(apply(&mut app, "worldWind", "0"), SetOutcome::Changed);
+        assert!(!res::<LookWind>(&app).on);
+        assert!(res::<LookSky>(&app).on, "the sky stays");
+        assert_eq!(apply(&mut app, "worldSky", "0"), SetOutcome::Changed);
+        assert!(!res::<LookSky>(&app).on);
+        assert_eq!(
+            *res::<WorldLook>(&app),
+            WorldLook::NEW,
+            "the rest of the look stays"
+        );
+        apply(&mut app, "worldWind", "1");
+        apply(&mut app, "worldSky", "1");
+        assert!(res::<LookWind>(&app).on && res::<LookSky>(&app).on);
+    }
