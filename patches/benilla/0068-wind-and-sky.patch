diff --git a/crates/benilla-world/src/shaders/look_sky.wgsl b/crates/benilla-world/src/shaders/look_sky.wgsl
new file mode 100644
index 0000000..f1aae4f
--- /dev/null
+++ b/crates/benilla-world/src/shaders/look_sky.wgsl
@@ -0,0 +1,122 @@
+// The new look's painted sky (`look::sky`), benilla's own (no reference behaviour): one layer over
+// 1.12's dome, discs and stars, in its cloud dome's slot, blended premultiplied in gamma space as
+// every sky element is. The sun's and the moon's halos add under the clouds; the clouds cover
+// whatever 1.12 drew behind them. Depth is the far pin in `sky_vertex.wgsl`.
+
+#import bevy_pbr::{
+    forward_io::VertexOutput,
+    mesh_view_bindings::view,
+}
+
+// ---- look sky: mirrored in liquid.wgsl (keep in sync; `look::sky`'s tests compare the two) ----
+// The rows `look::sky::pack_rows` writes (SKY_ROWS = 13):
+//   0 [on, threshold, softness, opacity] · 1 [offset x, z (cells), plane (yd), cell (yd)] ·
+//   2 [lit (sRGB), silver power] · 3 [shade (sRGB), light step (cells)] ·
+//   4 [eye to sun, sun halo] · 5 [halo colour (sRGB), silver] · 6 [eye to moon, moon halo] ·
+//   7 [moon colour (sRGB), haze (yd)] · 8 [haze colour (sRGB), warp (cells)] ·
+//   9 [period (cells), shade contrast, horizon from, horizon to] ·
+//   10 [sun inner power, sun wide power, moon inner power, moon wide power] ·
+//   11 [sun inner, sun wide, moon inner, moon wide] · 12 [octaves, water octaves, pixel angle, 0].
+struct LookSkyRows {
+    r: array<vec4<f32>, 13>,
+}
+
+// A lattice point's hash, wrapped to `period`, as 24 bits (`look::sky::hash`).
+fn look_sky_hash(c: vec2<i32>, period: i32) -> f32 {
+    let p = vec2<i32>(period);
+    let w = ((c % p) + p) % p;
+    var h = u32(w.x) * 374761393u + u32(w.y) * 668265263u;
+    h = (h ^ (h >> 13u)) * 1274126177u;
+    h = h ^ (h >> 16u);
+    return f32(h >> 8u) * (1.0 / 16777216.0);
+}
+
+// Value noise, smoothstep-faded, tiling every `period` cells (`look::sky::noise`).
+fn look_sky_noise(p: vec2<f32>, period: i32) -> f32 {
+    let i = floor(p);
+    let f = p - i;
+    let c = vec2<i32>(i);
+    let a = look_sky_hash(c, period);
+    let b = look_sky_hash(c + vec2<i32>(1, 0), period);
+    let d = look_sky_hash(c + vec2<i32>(0, 1), period);
+    let e = look_sky_hash(c + vec2<i32>(1, 1), period);
+    let u = f * f * (vec2<f32>(3.0) - 2.0 * f);
+    return mix(mix(a, b, u.x), mix(d, e, u.x), u.y);
+}
+
+// The cloud field at `p` (cells): domain-warped fbm in 0..1, each octave faded to its mean as a
+// pixel (`lod` cells) grows past half its cell (`look::sky::density`).
+fn look_sky_density(p: vec2<f32>, period: i32, warp: f32, octaves: u32, lod: f32) -> f32 {
+    let half = period / 2;
+    let q = vec2<f32>(
+        look_sky_noise(p * 0.5 + vec2<f32>(5.2, 1.3), half),
+        look_sky_noise(p * 0.5 + vec2<f32>(1.7, 9.2), half),
+    );
+    let pw = p + warp * (q - vec2<f32>(0.5));
+    var sum = 0.0;
+    var norm = 0.0;
+    var amp = 1.0;
+    var freq = 1.0;
+    var per = period;
+    for (var i = 0u; i < octaves; i = i + 1u) {
+        let fade = clamp(2.0 - 2.0 * lod * freq, 0.0, 1.0);
+        let off = vec2<f32>(f32(i) * 7.31, f32(i) * 3.17);
+        let n = look_sky_noise(pw * freq + off, per);
+        sum += amp * (0.5 + (n - 0.5) * fade);
+        norm += amp;
+        amp *= 0.5;
+        freq *= 2.0;
+        per *= 2;
+    }
+    return sum / norm;
+}
+
+// The sky toward `dir` (unit, from the eye) over what is drawn behind it: premultiplied gamma
+// colour and coverage. The halos add under the clouds; `octaves` fewer for the water's mirror.
+fn look_sky_clouds(dir: vec3<f32>, s: LookSkyRows, octaves: u32) -> vec4<f32> {
+    let cs = max(dot(dir, s.r[4].xyz), 0.0);
+    let cm = max(dot(dir, s.r[6].xyz), 0.0);
+    var halo = s.r[5].rgb * (s.r[4].w * (s.r[11].x * pow(cs, s.r[10].x) + s.r[11].y * pow(cs, s.r[10].y)));
+    halo += s.r[7].rgb * (s.r[6].w * (s.r[11].z * pow(cm, s.r[10].z) + s.r[11].w * pow(cm, s.r[10].w)));
+    if (dir.y <= s.r[9].z) {
+        return vec4<f32>(halo, 0.0);
+    }
+    // The ray's crossing with the layer, in cells, and the cells a pixel spans there.
+    let dist = s.r[1].z / dir.y;
+    let cell = s.r[1].w;
+    let p = s.r[1].xy + dir.xz * (dist / cell);
+    let lod = dist * s.r[12].z / (dir.y * cell);
+    let period = i32(s.r[9].x);
+    let d = look_sky_density(p, period, s.r[8].w, octaves, lod);
+    let th = s.r[0].y;
+    let a = smoothstep(th, th + s.r[0].z, d) * smoothstep(s.r[9].z, s.r[9].w, dir.y) * s.r[0].w;
+    if (a <= 0.001) {
+        return vec4<f32>(halo, 0.0);
+    }
+    // The light: where the cloud thickens toward the sun it is in its own shade; thin edges glow;
+    // soft painted bands, not a smooth ramp.
+    let sun_xz = s.r[4].xz;
+    let toward = sun_xz / max(length(sun_xz), 1e-3);
+    let d2 = look_sky_density(p + toward * s.r[3].w, period, s.r[8].w, min(octaves, 3u), lod);
+    var light = clamp(0.5 + (d - d2) * s.r[9].y, 0.0, 1.0);
+    light = mix(light, 1.0, (1.0 - a) * 0.5);
+    light = smoothstep(0.15, 0.85, light);
+    var col = mix(s.r[3].rgb, s.r[2].rgb, light);
+    // A silver lining on the thin edges toward the sun.
+    col += s.r[5].rgb * (s.r[5].w * s.r[4].w * pow(cs, s.r[2].w) * (1.0 - a));
+    // Far clouds go into the haze.
+    col = mix(col, s.r[8].rgb, 1.0 - exp(-dist / s.r[7].w));
+    return vec4<f32>(halo * (1.0 - a) + col * a, a);
+}
+// ---- end look sky ----
+
+@group(#{MATERIAL_BIND_GROUP}) @binding(100) var<uniform> look_sky: LookSkyRows;
+
+@fragment
+fn fragment(in: VertexOutput) -> @location(0) vec4<f32> {
+    if (look_sky.r[0].x < 0.5) {
+        return vec4<f32>(0.0);
+    }
+    let dir = normalize(in.world_position.xyz - view.world_position.xyz);
+    return look_sky_clouds(dir, look_sky, u32(look_sky.r[12].x));
+}
