+//! A painted sky, the new look's own (no reference behaviour): WoW Forever's sky is painted, and
+//! its clouds drift. 1.12's sky dome (`crate::sky`), its sun and moon discs and its stars stay as
+//! they are; over them the new look draws one layer of its own (`look_sky.wgsl`), in the slot of
+//! 1.12's cloud dome ([`crate::sky_order::LOOK_CLOUDS_BIAS`], after the discs and the stars, before
+//! the glares), which it hides while it draws:
+//! 1. **clouds** ([`density`]): a soft, Wind Waker-ish layer on a plane [`tune::PLANE_YD`] over the
+//!    eye, domain-warped value noise that tiles every [`tune::PERIOD_CELLS`], drifting downwind with
+//!    the world's wind (`look::wind::drift`, the same on every client); thin on a clear day, thicker
+//!    as the day's roll ([`day_cover`]) or the zone's authored cloud says, near full in a storm, or
+//!    held by `looksky clouds`. Each cloud is lit by the hour ([`tune::KEYS`]): bright toward the
+//!    sun and shaded where the cloud thickens toward it, in soft painted bands, gold underneath at
+//!    golden hour, pink at dawn, dark blue-grey at night, with a silver lining on its thin edges
+//!    near the sun; far clouds go into the haze and thin out at the horizon;
+//! 2. **the sun**: a warm halo round 1.12's disc, on the god rays' own sun (`celestial_dir`), wider
+//!    and warmer as it sets; **the moon**: a pale halo round 1.12's;
+//! 3. **the stars**: 1.12's, which fade in after dusk and out before dawn; the clouds draw over
+//!    them, so a cloud hides them, and over the discs;
+//! 4. **the water** (`look::water`): the mirror's sky, where a reflected ray leaves the screen,
+//!    runs the same cloud function on fewer octaves, so the lakes mirror the clouds;
+//! 5. **the light**: the cloud over the sun (computed here on the CPU, [`cover_toward`]) dims the
+//!    glare, the god rays and the water's glint, as 1.12's own cloud field does for its glare.
+//!
+//! Every tunable is in [`tune`]; [`pack_rows`] carries them to the layer's material and the water
+//! block. `worldSky 0` ([`LookSky::on`]) brings back 1.12's clouds under the rest of the new look;
+//! `looksky clouds <0-1>` holds the cover for film and `looksky grade` lets it go. `worldLook 0`
+//! hides the layer and 1.12's sky draws untouched.
+
+use bevy::camera::Projection;
+use bevy::mesh::MeshVertexBufferLayoutRef;
+use bevy::pbr::{
+    ExtendedMaterial, MaterialExtension, MaterialExtensionKey, MaterialExtensionPipeline,
+};
+use bevy::prelude::*;
+use bevy::render::render_resource::{
+    AsBindGroup, RenderPipelineDescriptor, SpecializedMeshPipelineError,
+};
+use bevy::shader::ShaderRef;
+
+use super::wind;
+use super::WorldLook;
+use crate::lighting::{GameClock, WorldTime, WowLighting};
+use crate::sky_order::{sky_pipeline_state, SKY_VERTEX_SHADER};
+use crate::view::WorldCamera;
+
+/// Every tunable of the sky, in one place. A first pass, to tune on film with `looksky`. Lengths
+/// are yards, colours sRGB 0..1 (the sky blends raw gamma, as 1.12's does).
+pub mod tune {
+    /// The cloud layer's height over the eye, and the noise's big cell on it.
+    pub const PLANE_YD: f32 = 1400.0;
+    pub const CELL_YD: f32 = 650.0;
+    /// The noise tiles every this many cells (even), so the drift wraps without a seam.
+    pub const PERIOD_CELLS: i32 = 64;
+    /// Octaves on the sky, and on the water's mirror (cheaper).
+    pub const OCTAVES: u32 = 5;
+    pub const WATER_OCTAVES: u32 = 3;
+    /// The domain warp (cells): how far the shapes are pushed about, for a painted look.
+    pub const WARP: f32 = 0.7;
+    /// The yards a pixel spans per yard of distance (a 1080p view's), which fades each octave out
+    /// as it would shimmer: far clouds go smooth.
+    pub const PIXEL_ANGLE: f32 = 0.0012;
+    /// The cover (0 none, 1 overcast) sets the field's threshold, from clear to full; the edge's
+    /// softness; the layer's most opacity, and under full overcast.
+    pub const THRESHOLD_CLEAR: f32 = 0.78;
+    pub const THRESHOLD_FULL: f32 = 0.22;
+    pub const SOFTNESS: f32 = 0.13;
+    pub const OPACITY: f32 = 0.9;
+    pub const OPACITY_OVERCAST: f32 = 0.97;
+    /// An ordinary day's cover rolls between these; about one day in [`CLEAR_DAY_ONE_IN`] is
+    /// clear, at [`CLEAR_COVER`]. It wanders by [`COVER_WANDER`] over [`COVER_WANDER_H`] hours, and
+    /// a storm takes it to [`OVERCAST_COVER`].
+    pub const COVER_MIN: f32 = 0.22;
+    pub const COVER_MAX: f32 = 0.52;
+    pub const CLEAR_DAY_ONE_IN: u32 = 5;
+    pub const CLEAR_COVER: f32 = 0.1;
+    pub const COVER_WANDER: f32 = 0.07;
+    pub const COVER_WANDER_H: f32 = 3.7;
+    pub const OVERCAST_COVER: f32 = 0.95;
+    /// The self-shade: how far toward the sun (cells) a cloud looks for more of itself, and how
+    /// hard that shades it.
+    pub const LIGHT_STEP: f32 = 0.35;
+    pub const SHADE_CONTRAST: f32 = 3.0;
+    /// The layer thins out between these heights of the view ray (sine of elevation), and goes
+    /// into the haze (the fog colour) over about this many yards.
+    pub const HORIZON_FROM: f32 = 0.025;
+    pub const HORIZON_TO: f32 = 0.16;
+    pub const HAZE_YD: f32 = 18000.0;
+    /// The live sky's horizon colour blended into the keys' by this much, so another zone's sky
+    /// tints its clouds; and how much a full overcast greys them.
+    pub const SKY_BLEND: f32 = 0.2;
+    pub const OVERCAST_GREY: f32 = 0.6;
+    /// The silver lining on thin edges toward the sun: its strength and its tightness.
+    pub const SILVER: f32 = 0.5;
+    pub const SILVER_POWER: f32 = 8.0;
+    /// The sun's halo: a tight glow round the disc and a wide warm one, as power of the cosine to
+    /// the sun and share; scaled by the hour's `halo` and coloured by the disc's tint warmed by the
+    /// hour's `warm` toward [`HALO_WARM`].
+    pub const SUN_INNER_POWER: f32 = 600.0;
+    pub const SUN_WIDE_POWER: f32 = 14.0;
+    pub const SUN_INNER: f32 = 0.45;
+    pub const SUN_WIDE: f32 = 0.16;
+    pub const HALO_WARM: [f32; 3] = [1.0, 0.72, 0.42];
+    /// The moon's halo, pale and small, at night only.
+    pub const MOON_INNER_POWER: f32 = 900.0;
+    pub const MOON_WIDE_POWER: f32 = 60.0;
+    pub const MOON_INNER: f32 = 0.22;
+    pub const MOON_WIDE: f32 = 0.07;
+    pub const MOON_HALO: f32 = 1.0;
+    pub const MOON_TINT: [f32; 3] = [0.70, 0.80, 1.0];
+    /// A body's halo comes in as it rises over this band of elevation (degrees).
+    pub const RISE_FROM_DEG: f32 = -2.0;
+    pub const RISE_TO_DEG: f32 = 3.0;
+
+    /// The clouds' light by the hour (the lighting's clock, minutes), interpolated: `lit` the side
+    /// toward the light, `shade` the thick undersides, `halo` the sun halo's strength, `warm` how
+    /// far its colour goes toward [`HALO_WARM`].
+    #[derive(Clone, Copy, Debug)]
+    pub struct CloudKey {
+        pub minute: f32,
+        pub lit: [f32; 3],
+        pub shade: [f32; 3],
+        pub halo: f32,
+        pub warm: f32,
+    }
+
+    const fn key(minute: f32, lit: [f32; 3], shade: [f32; 3], halo: f32, warm: f32) -> CloudKey {
+        CloudKey {
+            minute,
+            lit,
+            shade,
+            halo,
+            warm,
+        }
+    }
+
+    /// Night blue-grey, pink dawn, white day, gold under the clouds at golden hour, a purple dusk.
+    pub const KEYS: [CloudKey; 12] = [
+        key(0.0, [0.30, 0.34, 0.46], [0.10, 0.12, 0.19], 0.0, 0.0),
+        key(300.0, [0.32, 0.34, 0.47], [0.12, 0.13, 0.21], 0.0, 0.0),
+        key(360.0, [1.00, 0.74, 0.74], [0.56, 0.42, 0.56], 1.0, 0.7),
+        key(420.0, [1.00, 0.88, 0.80], [0.68, 0.62, 0.70], 0.8, 0.45),
+        key(540.0, [1.00, 0.98, 0.95], [0.72, 0.76, 0.84], 0.6, 0.15),
+        key(720.0, [1.00, 1.00, 1.00], [0.74, 0.79, 0.88], 0.55, 0.05),
+        key(960.0, [1.00, 0.97, 0.91], [0.72, 0.74, 0.82], 0.6, 0.2),
+        key(1050.0, [1.00, 0.86, 0.58], [0.82, 0.60, 0.42], 0.95, 0.65),
+        key(1140.0, [1.00, 0.64, 0.42], [0.64, 0.41, 0.42], 1.1, 0.9),
+        key(1200.0, [0.72, 0.47, 0.56], [0.31, 0.25, 0.37], 0.7, 0.9),
+        key(1260.0, [0.38, 0.38, 0.52], [0.15, 0.16, 0.25], 0.0, 0.0),
+        key(1440.0, [0.30, 0.34, 0.46], [0.10, 0.12, 0.19], 0.0, 0.0),
+    ];
+}
+
+/// Rows the layer's uniform takes (`look_sky.wgsl`'s `LookSkyRows`), and which the water block
+/// carries after its own (`liquid.wgsl`); keep in sync:
+///   0 `[on, threshold, softness, opacity]` · 1 `[offset x, z (cells), plane (yd), cell (yd)]` ·
+///   2 `[lit (sRGB), silver power]` · 3 `[shade (sRGB), light step (cells)]` ·
+///   4 `[eye to sun (unit), sun halo]` · 5 `[halo colour (sRGB), silver]` ·
+///   6 `[eye to moon (unit), moon halo]` · 7 `[moon colour (sRGB), haze (yd)]` ·
+///   8 `[haze colour (sRGB), warp (cells)]` ·
+///   9 `[period (cells), shade contrast, horizon from, horizon to (sine of elevation)]` ·
+///   10 `[sun inner power, sun wide power, moon inner power, moon wide power]` ·
+///   11 `[sun inner, sun wide, moon inner, moon wide]` · 12 `[octaves, water octaves, pixel angle, 0]`.
+pub const SKY_ROWS: usize = 13;
+
+/// `worldSky` and the film's hold: `on` (on by default, inert under the classic look); `clouds`
+/// holds the cover (0 none to 1 overcast) whatever the day and the weather say (`looksky`).
+#[derive(Resource, Clone, Copy, Debug, PartialEq)]
+pub struct LookSky {
+    pub on: bool,
+    pub clouds: Option<f32>,
+}
+
+impl Default for LookSky {
+    /// On, the `worldSky` CVar's registered "1".
+    fn default() -> Self {
+        Self {
+            on: true,
+            clouds: None,
+        }
+    }
+}
+
+impl LookSky {
+    /// `looksky`'s arguments: `clouds <0-1>` holds the cover, `grade` (or nothing, or `clouds`
+    /// alone) lets it go: `Some(new hold)`; `None` for anything else, which changes nothing.
+    pub fn parse(args: &str) -> Option<Option<f32>> {
+        let mut words = args.split_whitespace();
+        let held = match words.next() {
+            None => None,
+            Some(w) if w.eq_ignore_ascii_case("grade") => None,
+            Some(w) if w.eq_ignore_ascii_case("clouds") => match words.next() {
+                None => None,
+                Some(v) => Some(v.parse::<f32>().ok().filter(|c| (0.0..=1.0).contains(c))?),
+            },
+            Some(_) => return None,
+        };
+        words.next().is_none().then_some(held)
+    }
+}
+
+fn mix64(x: u64) -> u64 {
+    let mut z = x.wrapping_add(0x9E37_79B9_7F4A_7C15);
+    z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
+    z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
+    z ^ (z >> 31)
+}
+
+fn unit64(h: u64) -> f32 {
+    (h >> 40) as f32 / (1u64 << 24) as f32
+}
+
+/// Mixed into the day so the sky's dice are its own.
+const DAY_SALT: u64 = 0x636C_6F75_6464_6179; // "cloudday"
+
+/// One server day's cover: a fixed hash of the day number, clear about one day in five.
+pub fn day_cover(day: i64) -> f32 {
+    let h = mix64(day as u64 ^ DAY_SALT);
+    if unit64(h) < 1.0 / tune::CLEAR_DAY_ONE_IN as f32 {
+        tune::CLEAR_COVER
+    } else {
+        tune::COVER_MIN + (tune::COVER_MAX - tune::COVER_MIN) * unit64(mix64(h))
+    }
+}
+
+fn smoothstep(e0: f32, e1: f32, x: f32) -> f32 {
+    let t = ((x - e0) / (e1 - e0)).clamp(0.0, 1.0);
+    t * t * (3.0 - 2.0 * t)
+}
+
+/// The cover at `secs` of the server's clock before the weather: the day's roll, eased into the
+/// next over the last two hours of the day, wandering a little through it.
+pub fn cover_at(secs: f64) -> f32 {
+    let day = (secs / 86_400.0).floor();
+    let minute = ((secs - day * 86_400.0) / 60.0) as f32;
+    let (a, b) = (day_cover(day as i64), day_cover(day as i64 + 1));
+    let t = smoothstep(wind::tune::DAY_EASE_FROM_MIN, 1440.0, minute);
+    let wander_w = std::f64::consts::TAU / (f64::from(tune::COVER_WANDER_H) * 3600.0);
+    let wander =
+        tune::COVER_WANDER * ((secs * wander_w).rem_euclid(std::f64::consts::TAU) as f32).sin();
+    (a + (b - a) * t + wander).clamp(0.0, 1.0)
+}
+
+/// The hour's cloud key at `minute` (0..1440), interpolated.
+pub fn key_at(minute: f32) -> tune::CloudKey {
+    let m = minute.rem_euclid(1440.0);
+    let keys = &tune::KEYS;
+    let i = keys
+        .windows(2)
+        .position(|w| m >= w[0].minute && m < w[1].minute)
+        .unwrap_or(keys.len() - 2);
+    let (a, b) = (keys[i], keys[i + 1]);
+    let t = ((m - a.minute) / (b.minute - a.minute)).clamp(0.0, 1.0);
+    let l = |x: [f32; 3], y: [f32; 3]| std::array::from_fn(|c| x[c] + (y[c] - x[c]) * t);
+    tune::CloudKey {
+        minute: m,
+        lit: l(a.lit, b.lit),
+        shade: l(a.shade, b.shade),
+        halo: a.halo + (b.halo - a.halo) * t,
+        warm: a.warm + (b.warm - a.warm) * t,
+    }
+}
+
+// ---------------------------------------------------------------- the field, mirrored on the GPU
+
+/// `look_sky_hash` (keep in sync): a fixed integer hash of a lattice point, wrapped to `period`,
+/// as 24 bits (exact in an `f32`, so the CPU and the GPU agree).
+fn hash(cx: i32, cy: i32, period: i32) -> f32 {
+    let wx = cx.rem_euclid(period) as u32;
+    let wy = cy.rem_euclid(period) as u32;
+    let mut h = wx
+        .wrapping_mul(374_761_393)
+        .wrapping_add(wy.wrapping_mul(668_265_263));
+    h = (h ^ (h >> 13)).wrapping_mul(1_274_126_177);
+    h ^= h >> 16;
+    (h >> 8) as f32 * (1.0 / 16_777_216.0)
+}
+
+/// `look_sky_noise` (keep in sync): value noise, smoothstep-faded, tiling every `period` cells.
+fn noise(p: Vec2, period: i32) -> f32 {
+    let i = p.floor();
+    let f = p - i;
+    let (cx, cy) = (i.x as i32, i.y as i32);
+    let a = hash(cx, cy, period);
+    let b = hash(cx + 1, cy, period);
+    let d = hash(cx, cy + 1, period);
+    let e = hash(cx + 1, cy + 1, period);
+    let u = f * f * (Vec2::splat(3.0) - 2.0 * f);
+    let lerp = |x: f32, y: f32, t: f32| x + (y - x) * t;
+    lerp(lerp(a, b, u.x), lerp(d, e, u.x), u.y)
+}
+
+/// `look_sky_density` (keep in sync): the cloud field at `p` (cells), domain-warped fbm in 0..1;
+/// `lod` the cells a pixel spans, which fades each octave to its mean as it would shimmer.
+pub fn density(p: Vec2, period: i32, warp: f32, octaves: u32, lod: f32) -> f32 {
+    let half = period / 2;
+    let q = Vec2::new(
+        noise(p * 0.5 + Vec2::new(5.2, 1.3), half),
+        noise(p * 0.5 + Vec2::new(1.7, 9.2), half),
+    );
+    let pw = p + warp * (q - Vec2::splat(0.5));
+    let mut sum = 0.0;
+    let mut norm = 0.0;
+    let mut amp = 1.0;
+    let mut freq = 1.0;
+    let mut per = period;
+    for i in 0..octaves {
+        let fade = (2.0 - 2.0 * lod * freq).clamp(0.0, 1.0);
+        let off = Vec2::new(i as f32 * 7.31, i as f32 * 3.17);
+        let n = noise(pw * freq + off, per);
+        sum += amp * (0.5 + (n - 0.5) * fade);
+        norm += amp;
+        amp *= 0.5;
+        freq *= 2.0;
+        per *= 2;
+    }
+    sum / norm
+}
+
+/// The layer's coverage (its alpha, 0..1) toward `dir` (unit, from the eye) under `rows`, as
+/// `look_sky_clouds` computes it: what [`SkyFrame::sun_clear`] reads at the sun.
+pub fn cover_toward(dir: Vec3, rows: &[[f32; 4]; SKY_ROWS]) -> f32 {
+    if rows[0][0] < 0.5 || dir.y <= rows[9][2] {
+        return 0.0;
+    }
+    let dist = rows[1][2] / dir.y;
+    let cell = rows[1][3];
+    let p = Vec2::new(rows[1][0], rows[1][1]) + Vec2::new(dir.x, dir.z) * (dist / cell);
+    let lod = dist * rows[12][2] / (dir.y * cell);
+    let d = density(p, rows[9][0] as i32, rows[8][3], rows[12][0] as u32, lod);
+    let th = rows[0][1];
+    smoothstep(th, th + rows[0][2], d) * smoothstep(rows[9][2], rows[9][3], dir.y) * rows[0][3]
+}
+
+// ---------------------------------------------------------------- this frame
+
+/// The inputs [`pack_rows`] takes besides the light: the server's clock, the lighting's minute,
+/// the eye and the hold.
+#[derive(Clone, Copy, Debug)]
+pub struct SkyInputs {
+    pub secs: f64,
+    pub minute: f32,
+    pub cam: Vec3,
+    pub held: Option<f32>,
+}
+
+fn elevation_deg(to_body: Vec3) -> f32 {
+    to_body
+        .normalize_or_zero()
+        .y
+        .clamp(-1.0, 1.0)
+        .asin()
+        .to_degrees()
+}
+
+/// The cover this frame: the hold, else the day's (or the zone's authored cloud, if more), taken
+/// toward overcast by a storm.
+pub fn cover(input: &SkyInputs, light: &WowLighting) -> f32 {
+    if let Some(c) = input.held {
+        return c.clamp(0.0, 1.0);
+    }
+    let base = cover_at(input.secs).max(light.cloud_density.clamp(0.0, 1.0));
+    let storm = light.storm_bcc.clamp(0.0, 1.0);
+    base + (tune::OVERCAST_COVER - base).max(0.0) * storm
+}
+
+/// The layer's rows for this frame ([`SKY_ROWS`]); all zero, no layer, when `on` is false.
+pub fn pack_rows(on: bool, input: &SkyInputs, light: &WowLighting) -> [[f32; 4]; SKY_ROWS] {
+    let mut rows = [[0.0; 4]; SKY_ROWS];
+    if !on {
+        return rows;
+    }
+    let cover = cover(input, light);
+    let overcast = ((cover - 0.6) / 0.35)
+        .clamp(0.0, 1.0)
+        .max(light.storm_bcc.clamp(0.0, 1.0));
+    let key = key_at(input.minute);
+    // The live horizon tints the keys; a full overcast greys them.
+    let horizon = light.sky[4];
+    let grey = |c: [f32; 3], dim: f32| -> [f32; 3] {
+        let l = 0.3 * c[0] + 0.59 * c[1] + 0.11 * c[2];
+        std::array::from_fn(|i| {
+            let tinted = c[i] + (horizon[i] - c[i]) * tune::SKY_BLEND;
+            (tinted + (l * dim - tinted) * tune::OVERCAST_GREY * overcast).clamp(0.0, 1.0)
+        })
+    };
+    let lit = grey(key.lit, 0.85);
+    let shade = grey(key.shade, 0.8);
+    // The drift: the eye's own place plus the wind's carry, in cells, wrapped to the period.
+    let period = f64::from(tune::PERIOD_CELLS);
+    let carry = wind::drift(input.secs) * f64::from(wind::tune::CLOUD_SPEED_YD);
+    let cell = f64::from(tune::CELL_YD);
+    let off_x = ((f64::from(input.cam.x) - carry.x) / cell).rem_euclid(period) as f32;
+    let off_z = ((f64::from(input.cam.z) - carry.y) / cell).rem_euclid(period) as f32;
+    let sun = light.celestial_dir.normalize_or_zero();
+    let moon = light.moon_dir_white.normalize_or_zero();
+    let rise = |d: Vec3| smoothstep(tune::RISE_FROM_DEG, tune::RISE_TO_DEG, elevation_deg(d));
+    let sun_up = rise(sun);
+    let clear = 1.0 - overcast;
+    let halo_col: [f32; 3] = std::array::from_fn(|i| {
+        let t = light.celestial_tint[i];
+        t + (tune::HALO_WARM[i] - t) * key.warm
+    });
+    rows[0] = [
+        1.0,
+        tune::THRESHOLD_CLEAR + (tune::THRESHOLD_FULL - tune::THRESHOLD_CLEAR) * cover,
+        tune::SOFTNESS,
+        tune::OPACITY + (tune::OPACITY_OVERCAST - tune::OPACITY) * overcast,
+    ];
+    rows[1] = [off_x, off_z, tune::PLANE_YD, tune::CELL_YD];
+    rows[2] = [lit[0], lit[1], lit[2], tune::SILVER_POWER];
+    rows[3] = [shade[0], shade[1], shade[2], tune::LIGHT_STEP];
+    rows[4] = [sun.x, sun.y, sun.z, key.halo * sun_up * clear];
+    rows[5] = [halo_col[0], halo_col[1], halo_col[2], tune::SILVER];
+    rows[6] = [
+        moon.x,
+        moon.y,
+        moon.z,
+        tune::MOON_HALO * rise(moon) * (1.0 - sun_up) * clear,
+    ];
+    let fog = light.fog_color;
+    rows[7] = [
+        tune::MOON_TINT[0],
+        tune::MOON_TINT[1],
+        tune::MOON_TINT[2],
+        tune::HAZE_YD,
+    ];
+    rows[8] = [fog[0], fog[1], fog[2], tune::WARP];
+    rows[9] = [
+        tune::PERIOD_CELLS as f32,
+        tune::SHADE_CONTRAST,
+        tune::HORIZON_FROM,
+        tune::HORIZON_TO,
+    ];
+    rows[10] = [
+        tune::SUN_INNER_POWER,
+        tune::SUN_WIDE_POWER,
+        tune::MOON_INNER_POWER,
+        tune::MOON_WIDE_POWER,
+    ];
+    rows[11] = [
+        tune::SUN_INNER,
+        tune::SUN_WIDE,
+        tune::MOON_INNER,
+        tune::MOON_WIDE,
+    ];
+    rows[12] = [
+        tune::OCTAVES as f32,
+        tune::WATER_OCTAVES as f32,
+        tune::PIXEL_ANGLE,
+        0.0,
+    ];
+    rows
+}
+
+/// This frame's sky, from [`publish_sky`] to the layer, the water block (`look::water`), the
+/// glares (`sun::follow`) and the god rays (`look::pass`): `on` draws the layer and hides 1.12's
+/// cloud dome; `sun_clear` and `moon_clear` are how much of each body the clouds let through (1
+/// when off).
+#[derive(Resource, Clone, Copy, Debug, PartialEq)]
+pub struct SkyFrame {
+    pub on: bool,
+    pub rows: [[f32; 4]; SKY_ROWS],
+    pub sun_clear: f32,
+    pub moon_clear: f32,
+}
+
+impl Default for SkyFrame {
+    fn default() -> Self {
+        Self {
+            on: false,
+            rows: [[0.0; 4]; SKY_ROWS],
+            sun_clear: 1.0,
+            moon_clear: 1.0,
+        }
+    }
+}
+
+impl SkyFrame {
+    /// The frame for `rows` (all zero: off).
+    pub fn new(rows: [[f32; 4]; SKY_ROWS]) -> Self {
+        if rows[0][0] < 0.5 {
+            return Self::default();
+        }
+        let sun = Vec3::new(rows[4][0], rows[4][1], rows[4][2]);
+        let moon = Vec3::new(rows[6][0], rows[6][1], rows[6][2]);
+        Self {
+            on: true,
+            rows,
+            sun_clear: 1.0 - cover_toward(sun, &rows),
+            moon_clear: 1.0 - cover_toward(moon, &rows),
+        }
+    }
+}
+
+/// Orders the sky's publish before its readers this frame (the water block, the look frame).
+#[derive(SystemSet, Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub struct SkyPublish;
+
+/// The layer: 1.12's own sky draws underneath; this blends premultiplied in gamma over it.
+pub type LookSkyMaterial = ExtendedMaterial<StandardMaterial, LookSkyExt>;
+
+/// The layer's rows ([`pack_rows`]) on one uniform, `look_sky.wgsl`'s `LookSkyRows`.
+#[derive(Asset, AsBindGroup, Clone, TypePath)]
+pub struct LookSkyExt {
+    #[uniform(100)]
+    pub(crate) rows: [Vec4; SKY_ROWS],
+}
+
+impl MaterialExtension for LookSkyExt {
+    /// The shared sky vertex stage, the far-depth pin ([`crate::sky_order`]).
+    fn vertex_shader() -> ShaderRef {
+        SKY_VERTEX_SHADER.into()
+    }
+
+    fn fragment_shader() -> ShaderRef {
+        "embedded://benilla_world/shaders/look_sky.wgsl".into()
+    }
+
+    fn specialize(
+        _pipeline: &MaterialExtensionPipeline,
+        descriptor: &mut RenderPipelineDescriptor,
+        _layout: &MeshVertexBufferLayoutRef,
+        _key: MaterialExtensionKey<Self>,
+    ) -> Result<(), SpecializedMeshPipelineError> {
+        if let Some(depth) = descriptor.depth_stencil.as_mut() {
+            depth.depth_write_enabled = false;
+        }
+        sky_pipeline_state(descriptor);
+        Ok(())
+    }
+}
+
+/// Marker for the layer's entity.
+#[derive(Component)]
+pub(crate) struct LookSkyLayer;
+
+/// Spawns the layer, hidden until the new look's sky is on.
+pub(crate) fn setup_look_sky(
+    mut commands: Commands,
+    mut meshes: ResMut<Assets<Mesh>>,
+    mut materials: ResMut<Assets<LookSkyMaterial>>,
+) {
+    let material = materials.add(LookSkyMaterial {
+        base: StandardMaterial {
+            unlit: true,
+            cull_mode: None, // viewed from inside
+            alpha_mode: AlphaMode::Premultiplied,
+            depth_bias: crate::sky_order::LOOK_CLOUDS_BIAS,
+            ..default()
+        },
+        extension: LookSkyExt {
+            rows: [Vec4::ZERO; SKY_ROWS],
+        },
+    });
+    commands.spawn((
+        Mesh3d(meshes.add(crate::sky::dome_mesh())),
+        MeshMaterial3d(material),
+        Transform::default(),
+        Visibility::Hidden,
+        LookSkyLayer,
+    ));
+}
+
+/// Publishes this frame's [`SkyFrame`] and writes its rows into the layer's material.
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn publish_sky(
+    look: Res<WorldLook>,
+    sky: Res<LookSky>,
+    world_time: Res<WorldTime>,
+    clock: Res<GameClock>,
+    time: Res<Time>,
+    light: Res<WowLighting>,
+    cam: Query<&GlobalTransform, With<WorldCamera>>,
+    layer: Query<&MeshMaterial3d<LookSkyMaterial>, With<LookSkyLayer>>,
+    mut materials: ResMut<Assets<LookSkyMaterial>>,
+    mut frame: ResMut<SkyFrame>,
+) {
+    let on = look.on && sky.on;
+    let input = SkyInputs {
+        secs: wind::server_secs(&world_time, time.elapsed_secs_f64()),
+        minute: clock.minute as f32,
+        cam: cam.iter().next().map_or(Vec3::ZERO, |g| g.translation()),
+        held: sky.clouds,
+    };
+    let next = SkyFrame::new(pack_rows(on, &input, &light));
+    if *frame != next {
+        *frame = next;
+    }
+    // Only while it draws: under the classic look the material is never touched.
+    if !on {
+        return;
+    }
+    let Ok(handle) = layer.single() else { return };
+    let rows = next.rows.map(Vec4::from_array);
+    if materials
+        .get(&handle.0)
+        .is_some_and(|m| m.extension.rows != rows)
+    {
+        if let Some(m) = materials.get_mut(&handle.0) {
+            m.extension.rows = rows;
+        }
+    }
+}
+
+/// Shows the layer while the new look's sky is on and 1.12's sky would draw: not under a WMO
+/// skybox, not while submerged, not with the debug sky off.
+pub(crate) fn apply_look_sky_visibility(
+    frame: Res<SkyFrame>,
+    debug: Res<crate::dev_state::DebugState>,
+    skybox: Res<crate::skybox::SkyboxWeight>,
+    underwater: Res<crate::liquid::Underwater>,
+    mut layer: Query<&mut Visibility, With<LookSkyLayer>>,
+) {
+    let Ok(mut vis) = layer.single_mut() else {
+        return;
+    };
+    let want = if frame.on
+        && !debug.lighting.disable_sky_dome
+        && !skybox.replaces_celestial()
+        && !underwater.0.any()
+    {
+        Visibility::Inherited
+    } else {
+        Visibility::Hidden
+    };
+    if *vis != want {
+        *vis = want;
+    }
+}
+
+/// Centres the layer on the camera inside the cloud dome's radius; occlusion is the far pin.
+#[allow(clippy::type_complexity)]
+pub(crate) fn follow_look_sky(
+    cam: Query<(&GlobalTransform, &Projection), With<WorldCamera>>,
+    mut layer: Query<
+        (&mut Transform, &mut GlobalTransform),
+        (With<LookSkyLayer>, Without<WorldCamera>),
+    >,
+) {
+    let Some((cam_gt, proj)) = cam.iter().next() else {
+        return;
+    };
+    let Ok((mut tf, mut gt)) = layer.single_mut() else {
+        return;
+    };
+    let far = match proj {
+        Projection::Perspective(p) => p.far,
+        _ => 3000.0,
+    };
+    tf.translation = cam_gt.translation();
+    tf.rotation = Quat::IDENTITY;
+    tf.scale = Vec3::splat(far * 0.86);
+    *gt = GlobalTransform::from(*tf);
+}
+
+pub(crate) fn init_resources(app: &mut App) {
+    app.init_resource::<LookSky>().init_resource::<SkyFrame>();
+}
