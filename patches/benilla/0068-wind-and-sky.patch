+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn noon() -> WowLighting {
+        WowLighting {
+            celestial_dir: Vec3::new(0.3, 0.9, 0.2).normalize(),
+            moon_dir_white: Vec3::new(0.0, -1.0, 0.0),
+            celestial_tint: [1.0, 0.9, 0.7],
+            sky: [[0.2, 0.4, 0.9]; 5],
+            fog_color: [0.7, 0.75, 0.8],
+            ..default()
+        }
+    }
+
+    fn input(minute: f32, held: Option<f32>) -> SkyInputs {
+        SkyInputs {
+            secs: 1.76e9,
+            minute,
+            cam: Vec3::new(9_000.0, 60.0, -300.0),
+            held,
+        }
+    }
+
+    /// The sky's cloud function is mirrored in the water's shader, so the lakes mirror the same
+    /// clouds: the copies must match to the letter (from the rows' struct to the block's end).
+    #[test]
+    fn the_water_mirrors_the_same_clouds() {
+        fn block(src: &str) -> &str {
+            let start = src
+                .find("struct LookSkyRows")
+                .expect("the sky block's start");
+            let end = src.find("// ---- end look sky ----").expect("its end");
+            &src[start..end]
+        }
+        let sky = block(include_str!("../shaders/look_sky.wgsl"));
+        let water = block(include_str!(
+            "../../../benilla-assets/src/shaders/liquid.wgsl"
+        ));
+        assert_eq!(sky, water);
+        assert!(sky.contains(&format!("array<vec4<f32>, {SKY_ROWS}>")));
+    }
+
+    #[test]
+    fn the_rows_are_zero_when_off() {
+        assert_eq!(
+            pack_rows(false, &input(720.0, None), &noon()),
+            [[0.0; 4]; SKY_ROWS]
+        );
+        assert_eq!(SkyFrame::new([[0.0; 4]; SKY_ROWS]), SkyFrame::default());
+    }
+
+    /// The field: in 0..1, the same at a point a whole period away (the drift's wrap is seamless),
+    /// and it varies.
+    #[test]
+    fn the_field_tiles_and_varies() {
+        let per = tune::PERIOD_CELLS;
+        let mut lo = f32::MAX;
+        let mut hi = f32::MIN;
+        for i in 0..200 {
+            let p = Vec2::new(i as f32 * 0.37, i as f32 * 0.21 - 3.0);
+            let d = density(p, per, tune::WARP, tune::OCTAVES, 0.0);
+            let w = density(
+                p + Vec2::new(per as f32, -per as f32),
+                per,
+                tune::WARP,
+                tune::OCTAVES,
+                0.0,
+            );
+            assert!((d - w).abs() < 1e-4, "{p}: {d} vs {w}");
+            assert!((0.0..=1.0).contains(&d));
+            lo = lo.min(d);
+            hi = hi.max(d);
+        }
+        assert!(hi - lo > 0.3, "{lo}..{hi}");
+    }
+
+    /// Far off, the fine octaves fade to their mean: the field goes smooth, not noisy.
+    #[test]
+    fn far_clouds_go_smooth() {
+        let p = Vec2::new(3.3, 7.9);
+        let far = density(p, tune::PERIOD_CELLS, tune::WARP, tune::OCTAVES, 10.0);
+        assert!((far - 0.5).abs() < 1e-6);
+    }
+
+    /// More cover, more cloud: the share of the sky the layer covers grows with the hold.
+    #[test]
+    fn the_cover_sets_how_much_sky_is_cloud() {
+        let share = |c: f32| {
+            let rows = pack_rows(true, &input(720.0, Some(c)), &noon());
+            let mut n = 0.0;
+            let mut covered = 0.0;
+            for i in 0..24 {
+                for j in 2..10 {
+                    let az = i as f32 / 24.0 * std::f32::consts::TAU;
+                    let el = (j as f32 * 9.0f32).to_radians();
+                    let dir = Vec3::new(el.cos() * az.cos(), el.sin(), el.cos() * az.sin());
+                    covered += cover_toward(dir, &rows);
+                    n += 1.0;
+                }
+            }
+            covered / n
+        };
+        let (none, fair, overcast) = (share(0.0), share(0.35), share(1.0));
+        assert!(none < 0.02, "{none}");
+        assert!(
+            fair > none + 0.05 && overcast > fair + 0.3,
+            "{none} {fair} {overcast}"
+        );
+        assert!(overcast > 0.8, "{overcast}");
+    }
+
+    /// The hours: pink at dawn, white at noon, gold underneath at golden hour, blue-grey at night;
+    /// no sun halo at night.
+    #[test]
+    fn the_clouds_take_the_hour() {
+        let dawn = key_at(360.0);
+        assert!(
+            dawn.lit[0] > dawn.lit[1] && dawn.shade[2] > dawn.shade[1],
+            "pink"
+        );
+        let noon_k = key_at(720.0);
+        assert_eq!(noon_k.lit, [1.0; 3]);
+        let golden = key_at(1050.0);
+        assert!(
+            golden.shade[0] > golden.shade[1] && golden.shade[1] > golden.shade[2],
+            "gold"
+        );
+        let night = key_at(60.0);
+        assert!(
+            night.shade[2] > night.shade[0] && night.halo == 0.0,
+            "blue-grey"
+        );
+        // Interpolated between keys, and wrapped.
+        let between = key_at(390.0);
+        assert!((between.lit[1] - 0.5 * (0.74 + 0.88)).abs() < 1e-5);
+        assert_eq!(key_at(1440.0 + 720.0).lit, noon_k.lit);
+    }
+
+    /// Each day rolls its own cover, about one in five clear, and the next eases in.
+    #[test]
+    fn each_day_rolls_its_cover() {
+        let covers: Vec<f32> = (20_000..20_500).map(day_cover).collect();
+        let clear = covers.iter().filter(|c| **c == tune::CLEAR_COVER).count();
+        assert!((60..=150).contains(&clear), "{clear}");
+        let midnight = 20_401.0 * 86_400.0;
+        assert!((cover_at(midnight - 0.5) - cover_at(midnight + 0.5)).abs() < 1e-3);
+    }
+
+    /// A storm takes the sky toward overcast; the hold wins over both.
+    #[test]
+    fn a_storm_covers_the_sky_and_the_hold_wins() {
+        let storm = WowLighting {
+            storm_bcc: 1.0,
+            ..noon()
+        };
+        assert!((cover(&input(720.0, None), &storm) - tune::OVERCAST_COVER).abs() < 1e-5);
+        assert_eq!(cover(&input(720.0, Some(0.8)), &storm), 0.8);
+        let rows = pack_rows(true, &input(720.0, Some(0.0)), &noon());
+        assert!((rows[0][1] - tune::THRESHOLD_CLEAR).abs() < 1e-6);
+    }
+
+    /// The sun's halo is up by day and gone by night; the moon's the other way.
+    #[test]
+    fn the_halos_follow_the_bodies() {
+        let day = pack_rows(true, &input(720.0, Some(0.0)), &noon());
+        assert!(day[4][3] > 0.0 && day[6][3] == 0.0);
+        let night_light = WowLighting {
+            celestial_dir: Vec3::new(0.0, -0.6, 1.0).normalize(),
+            moon_dir_white: Vec3::new(0.2, 0.6, -0.7).normalize(),
+            ..noon()
+        };
+        let night = pack_rows(true, &input(60.0, Some(0.0)), &night_light);
+        assert!(night[4][3] == 0.0 && night[6][3] > 0.0);
+    }
+
+    /// A clear sky lets the sun through whole; a held overcast hides most of it.
+    #[test]
+    fn the_cloud_over_the_sun_is_measured() {
+        let clear = SkyFrame::new(pack_rows(true, &input(720.0, Some(0.0)), &noon()));
+        assert_eq!(clear.sun_clear, 1.0);
+        let grey = SkyFrame::new(pack_rows(true, &input(720.0, Some(1.0)), &noon()));
+        assert!(grey.sun_clear < 0.3, "{}", grey.sun_clear);
+    }
+
+    /// The drift's offset stays inside one period, so the GPU's f32 keeps its precision.
+    #[test]
+    fn the_offset_is_wrapped() {
+        let rows = pack_rows(true, &input(720.0, None), &noon());
+        let per = tune::PERIOD_CELLS as f32;
+        assert!((0.0..per).contains(&rows[1][0]) && (0.0..per).contains(&rows[1][1]));
+    }
+
+    #[test]
+    fn looksky_parses_its_arguments() {
+        assert_eq!(LookSky::parse(""), Some(None));
+        assert_eq!(LookSky::parse("grade"), Some(None));
+        assert_eq!(LookSky::parse("clouds"), Some(None));
+        assert_eq!(LookSky::parse("clouds 0.8"), Some(Some(0.8)));
+        assert_eq!(LookSky::parse("CLOUDS 0"), Some(Some(0.0)));
+        assert_eq!(LookSky::parse("clouds 1.5"), None);
+        assert_eq!(LookSky::parse("clouds lots"), None);
+        assert_eq!(LookSky::parse("clouds 0.5 1"), None);
+        assert_eq!(LookSky::parse("rain"), None);
+    }
+}
