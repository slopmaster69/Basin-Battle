+/// Basin Battle: a model's legs, each its hip, knee and ankle bones, for the planted feet (the app's
+/// action layer). A character's knee attachment (7 right, 8 left) sits on a kneecap helper bone: the
+/// knee is the first bone at or above it with a child well below it (the shin's end, the ankle), and
+/// the hip the first bone above the knee a real link away. Empty for a model without knee
+/// attachments (a boar), whose legs are left as they are.
+pub(crate) fn leg_chains(
+    bones: &[benilla_formats::SkeletonBone],
+    attachments: &[ModelAttachment],
+) -> Vec<LegChain> {
+    [7u16, 8]
+        .iter()
+        .filter_map(|id| {
+            let start = attachments.iter().find(|a| a.id == *id)?.bone as usize;
+            leg_from(bones, start)
+        })
+        .collect()
+}
+
+/// Basin Battle: the pelvis the planted feet lower the body by: the nearest bone over both hips and
+/// the upper body (key-bone 4, SpineLow, else 6, Head), so the whole body drops with it and the legs
+/// stay on. `None` with fewer than two legs, without that key-bone, or when it would be a root (the
+/// tilts turn the roots, and two writers on one bone would take each other's for the animation's).
+pub(crate) fn pelvis_of(bones: &[benilla_formats::SkeletonBone], legs: &[LegChain]) -> Option<u16> {
+    let [right, left] = legs else { return None };
+    let parent = |i: usize| bones.get(i).and_then(|b| usize::try_from(b.parent).ok());
+    let ancestors = |from: usize| {
+        let mut out = vec![from];
+        let mut cur = from;
+        while let Some(p) = parent(cur) {
+            if out.len() > bones.len() {
+                break;
+            }
+            out.push(p);
+            cur = p;
+        }
+        out
+    };
+    let upper = bones
+        .iter()
+        .position(|b| b.key_bone == 4)
+        .or_else(|| bones.iter().position(|b| b.key_bone == 6))?;
+    let over_right = ancestors(right.hip as usize);
+    let mut common: Vec<usize> = ancestors(left.hip as usize)
+        .into_iter()
+        .filter(|b| over_right.contains(b))
+        .collect();
+    let over_upper = ancestors(upper);
+    common.retain(|b| over_upper.contains(b));
+    let pelvis = *common.first()?;
+    parent(pelvis).map(|_| pelvis as u16)
+}
+
+/// The shortest thigh or shin a leg is taken for (model units, yards).
+const LEG_LINK: f32 = 0.06;
+
+fn leg_from(bones: &[benilla_formats::SkeletonBone], start: usize) -> Option<LegChain> {
+    let pivot = |i: usize| bones.get(i).map(|b| Vec3::from(b.pivot));
+    let parent = |i: usize| bones.get(i).and_then(|b| usize::try_from(b.parent).ok());
+    let mut knee = start;
+    let mut ankle = None;
+    for _ in 0..4 {
+        let z = pivot(knee)?.z;
+        ankle = bones
+            .iter()
+            .enumerate()
+            .filter(|(_, b)| {
+                usize::try_from(b.parent).ok() == Some(knee) && b.pivot[2] < z - LEG_LINK
+            })
+            .min_by(|a, b| a.1.pivot[2].total_cmp(&b.1.pivot[2]))
+            .map(|(i, _)| i);
+        if ankle.is_some() {
+            break;
+        }
+        knee = parent(knee)?;
+    }
+    let ankle = ankle?;
+    let mut hip = parent(knee)?;
+    for _ in 0..4 {
+        if pivot(hip)?.distance(pivot(knee)?) >= LEG_LINK {
+            break;
+        }
+        hip = parent(hip)?;
+    }
+    let (h, k) = (pivot(hip)?, pivot(knee)?);
+    (h.distance(k) >= LEG_LINK && h.z > k.z).then_some(LegChain {
+        hip: hip as u16,
+        knee: knee as u16,
+        ankle: ankle as u16,
+    })
+}
