@@ -0,0 +1,380 @@
+//! Basin Battle: planted feet (not in 1.12.1). A body standing still on a slope keeps its clips'
+//! level feet, so the uphill foot sinks into the ground and the downhill one hangs in the air. While
+//! the action layer is live and `actionFeet` is on, each leg of a still body bends so its ankle sits
+//! as far above the ground under it as the clip put it above the ground under the body: the pelvis
+//! drops for the lower foot and the higher leg bends at the knee (a two-bone turn of the thigh and
+//! the shin, the knee kept bending the way it bent, the foot kept turned as the clip had it). It eases
+//! in and out over a fifth of a second, waits out a roll, and lets go wherever the body isn't on the
+//! terrain itself (a deck, a mine's floor, a building), since the heightfield is all it reads.
+//!
+//! Its parts go back to the animation's pose part by part, as a tilt's do, and it writes no root, so
+//! it never takes a tilt's turn for the animation's.
+
+use bevy::math::Affine3A;
+use bevy::prelude::*;
+
+use benilla_assets::{AdtTile, ModelAnimations};
+use benilla_world::rig_anim::{PoseInertia, RigPose};
+use benilla_world::terrain_stream::{terrain_height_under, TerrainStreamer};
+
+use super::{rebase, restore, ActionTilt, TiltKind};
+
+/// `actionFeet` (benilla's own, registered "0" until it has been seen in the client).
+#[derive(Resource, Debug, Clone, Copy, PartialEq, Eq, Default)]
+pub(crate) struct PlantedFeet {
+    pub(crate) on: bool,
+}
+
+/// Slower than this (yards a second, scaled) for this long is standing still.
+const STILL_SPEED: f32 = 0.25;
+const STILL_FOR: f32 = 0.15;
+/// The weight eases from none to all, or back, over this long.
+const EASE: f32 = 0.2;
+/// The most a foot is raised or lowered (yards, scaled).
+const MAX_STEP: f32 = 0.45;
+/// The body's feet within this of the terrain under it (yards, scaled) stand on the terrain.
+const ON_TERRAIN: f32 = 0.2;
+
+/// A unit's planted feet: the eased weight, the stillness clock and what it wrote, each bone with
+/// the animation's pose under it and what was written (`(bone, base, last)`, as a tilt keeps them).
+#[derive(Component, Default)]
+pub(crate) struct FootPlant {
+    weight: f32,
+    last_pos: Option<Vec3>,
+    still_for: f32,
+    parts: Vec<(usize, Transform, Transform)>,
+}
+
+/// Plant the feet of every still body with legs, in the pose post-pass after the tilts.
+#[allow(clippy::type_complexity)]
+pub(super) fn plant_feet(
+    mut commands: Commands,
+    time: Res<Time>,
+    feet: Option<Res<PlantedFeet>>,
+    inertia: Option<Res<PoseInertia>>,
+    streamer: Option<Res<TerrainStreamer>>,
+    tiles: Option<Res<Assets<AdtTile>>>,
+    mut units: Query<(
+        Entity,
+        &ModelAnimations,
+        &mut RigPose,
+        &Transform,
+        Option<&ActionTilt>,
+        Option<&mut FootPlant>,
+    )>,
+    globals: Query<&GlobalTransform>,
+) {
+    let on = feet.is_some_and(|f| f.on) && inertia.is_some_and(|i| i.live);
+    let dt = time.delta_secs();
+    let ground = |at: Vec3| match (&streamer, &tiles) {
+        (Some(s), Some(t)) => terrain_height_under(s, t, at),
+        _ => None,
+    };
+    for (entity, anims, mut rig, t, tilt, plant) in &mut units {
+        let src = &anims.pose;
+        if src.legs.is_empty() {
+            continue;
+        }
+        let Some(mut plant) = plant else {
+            if on {
+                commands.entity(entity).try_insert(FootPlant::default());
+            }
+            continue;
+        };
+        let rig = &mut *rig;
+        // What was written last frame goes back where nothing rewrote it: the pose below is the
+        // animation's (and the tilts').
+        for (b, base, last) in plant.parts.iter_mut() {
+            if let Some(cur) = rig.locals.get_mut(*b) {
+                rebase(base, cur, last);
+                if restore(cur, base, last) {
+                    rig.pose_dirty = true;
+                }
+            }
+        }
+        plant.parts.clear();
+        let Ok(frame) = globals.get(rig.joints_root) else {
+            continue;
+        };
+        let scale = frame.scale().y.abs().max(0.1);
+        if dt > 0.0 {
+            let moved = plant
+                .last_pos
+                .map_or(0.0, |p| (t.translation - p).length() / dt);
+            plant.still_for = if moved < STILL_SPEED * scale {
+                plant.still_for + dt
+            } else {
+                0.0
+            };
+        }
+        plant.last_pos = Some(t.translation);
+        let feet_at = frame.translation();
+        let under_body = ground(feet_at);
+        let on_terrain = under_body.is_some_and(|g| (g - feet_at.y).abs() < ON_TERRAIN * scale);
+        let rolling = tilt.is_some_and(|t| matches!(t.kind, TiltKind::Roll { .. }));
+        let want = on && plant.still_for >= STILL_FOR && on_terrain && !rolling;
+        let step = if dt > 0.0 { dt / EASE } else { 0.0 };
+        plant.weight = if want {
+            (plant.weight + step).min(1.0)
+        } else {
+            (plant.weight - step).max(0.0)
+        };
+        if plant.weight <= 0.0 {
+            if !on {
+                commands.entity(entity).try_remove::<FootPlant>();
+            }
+            continue;
+        }
+        let Some(body_ground) = under_body else {
+            continue;
+        };
+        let world = frame.affine();
+        let to_model = world.inverse();
+        // Each leg as the animation (and the tilts) posed it, read before anything here moves it:
+        // its three joints in the model frame, the turn of the hip's parent, and the ankle in the
+        // world.
+        let legs: Vec<Leg> = src
+            .legs
+            .iter()
+            .map(|leg| {
+                let (h, k, a) = (leg.hip as usize, leg.knee as usize, leg.ankle as usize);
+                let parent_rot = usize::try_from(rig.parents[h])
+                    .ok()
+                    .map_or(Affine3A::IDENTITY, |q| model_of(rig, q))
+                    .to_scale_rotation_translation()
+                    .1;
+                let (hip, knee, ankle) = (model_of(rig, h), model_of(rig, k), model_of(rig, a));
+                Leg {
+                    bones: (h, k, a),
+                    parent_rot,
+                    ankle_world: world.transform_point3(Vec3::from(ankle.translation)),
+                    hip,
+                    knee,
+                    ankle,
+                }
+            })
+            .collect();
+        // How much higher the ground is under each ankle than under the body, eased in.
+        let lift: Vec<Option<f32>> = legs
+            .iter()
+            .map(|leg| {
+                ground(leg.ankle_world).map(|g| {
+                    let most = MAX_STEP * scale;
+                    (g - body_ground).clamp(-most, most) * plant.weight
+                })
+            })
+            .collect();
+        // The pelvis drops for the lowest foot; without one to drop, a foot is only ever raised.
+        let pelvis = src.pelvis.map(|p| p as usize);
+        let drop = if pelvis.is_some() {
+            lift.iter().flatten().fold(0.0f32, |d, l| d.min(*l))
+        } else {
+            0.0
+        };
+        let down = to_model.transform_vector3(Vec3::Y * drop);
+        if let Some(p) = pelvis.filter(|_| drop < 0.0) {
+            let parent = usize::try_from(rig.parents[p]).ok();
+            let (s, r, _) = parent
+                .map_or(Affine3A::IDENTITY, |q| model_of(rig, q))
+                .to_scale_rotation_translation();
+            let base = rig.locals[p];
+            let mut out = base;
+            out.translation += r.inverse() * down / s.max(Vec3::splat(1.0e-4));
+            write(rig, &mut plant.parts, p, base, out);
+        }
+        let forward = to_model.transform_vector3(t.rotation * Vec3::NEG_Z);
+        for (leg, lift) in legs.iter().zip(&lift) {
+            let Some(lift) = *lift else { continue };
+            let lift = if pelvis.is_some() {
+                lift
+            } else {
+                lift.max(0.0)
+            };
+            let (h, k, a) = leg.bones;
+            let parent_rot = leg.parent_rot;
+            // The joints with the pelvis's drop, and the ankle's mark: its height over the ground
+            // under it, as the animation had it over the ground under the body.
+            let hip = Vec3::from(leg.hip.translation) + down;
+            let knee = Vec3::from(leg.knee.translation) + down;
+            let ankle = Vec3::from(leg.ankle.translation) + down;
+            let target = to_model.transform_point3(leg.ankle_world + Vec3::Y * lift);
+            let Some((thigh, shin)) = solve_leg(hip, knee, ankle, target, forward) else {
+                continue;
+            };
+            let hip_rot = leg.hip.to_scale_rotation_translation().1;
+            let knee_rot = leg.knee.to_scale_rotation_translation().1;
+            let ankle_rot = leg.ankle.to_scale_rotation_translation().1;
+            // The thigh turned in the model frame, read back into its parent's.
+            let hb = rig.locals[h];
+            let mut ho = hb;
+            ho.rotation = (parent_rot.inverse() * thigh * parent_rot * hb.rotation).normalize();
+            write(rig, &mut plant.parts, h, hb, ho);
+            // The shin, under the turned thigh.
+            let thigh_after = thigh * hip_rot;
+            let kb = rig.locals[k];
+            let mut ko = kb;
+            ko.rotation = (thigh_after.inverse() * shin * thigh_after * kb.rotation).normalize();
+            write(rig, &mut plant.parts, k, kb, ko);
+            // The foot keeps the turn the clip gave it in the model frame.
+            let knee_after = shin * thigh * knee_rot;
+            let ab = rig.locals[a];
+            let mut ao = ab;
+            ao.rotation = (knee_after.inverse() * ankle_rot).normalize();
+            write(rig, &mut plant.parts, a, ab, ao);
+        }
+    }
+}
+
+/// One leg as posed before the feet move it.
+struct Leg {
+    bones: (usize, usize, usize),
+    parent_rot: Quat,
+    ankle_world: Vec3,
+    hip: Affine3A,
+    knee: Affine3A,
+    ankle: Affine3A,
+}
+
+/// A bone's local written, kept with the pose under it.
+fn write(
+    rig: &mut RigPose,
+    parts: &mut Vec<(usize, Transform, Transform)>,
+    b: usize,
+    base: Transform,
+    out: Transform,
+) {
+    rig.locals[b] = out;
+    rig.pose_dirty = true;
+    parts.push((b, base, out));
+}
+
+/// A bone's model-frame affine from this frame's locals, its chain folded from the root (the legs
+/// and the pelvis carry no parent arm or billboard, which the compose pass would add).
+fn model_of(rig: &RigPose, b: usize) -> Affine3A {
+    let mut chain = Vec::with_capacity(12);
+    let mut cur = Some(b);
+    while let Some(i) = cur {
+        if i >= rig.locals.len() || chain.len() > rig.locals.len() {
+            break;
+        }
+        chain.push(i);
+        cur = usize::try_from(rig.parents[i]).ok().filter(|&p| p < i);
+    }
+    chain.iter().rev().fold(Affine3A::IDENTITY, |m, &i| {
+        m * rig.locals[i].compute_affine()
+    })
+}
+
+/// A two-bone leg in one frame: the hip, knee and ankle where the pose has them and where the ankle
+/// should go. The turns (in that frame) of the thigh and then of the shin that put the ankle there,
+/// as near as the leg reaches, its two lengths kept and the knee bending to the side it bent (or
+/// toward `forward` from a straight leg). `None` for a leg with no length.
+pub(super) fn solve_leg(
+    hip: Vec3,
+    knee: Vec3,
+    ankle: Vec3,
+    target: Vec3,
+    forward: Vec3,
+) -> Option<(Quat, Quat)> {
+    let (a, b) = (hip.distance(knee), knee.distance(ankle));
+    let to = target - hip;
+    let reach = to.length();
+    if a < 1.0e-4 || b < 1.0e-4 || reach < 1.0e-4 {
+        return None;
+    }
+    let dir = to / reach;
+    let c = reach.clamp((a - b).abs() + 1.0e-3, a + b - 1.0e-3);
+    let thigh_now = knee - hip;
+    let mut side = thigh_now - dir * thigh_now.dot(dir);
+    if side.length_squared() < 1.0e-8 {
+        side = forward - dir * forward.dot(dir);
+    }
+    if side.length_squared() < 1.0e-8 {
+        return None;
+    }
+    let side = side.normalize();
+    let cos = ((a * a + c * c - b * b) / (2.0 * a * c)).clamp(-1.0, 1.0);
+    let sin = (1.0 - cos * cos).max(0.0).sqrt();
+    let knee_new = hip + dir * (a * cos) + side * (a * sin);
+    let thigh = Quat::from_rotation_arc(thigh_now / a, (knee_new - hip) / a);
+    let ankle_moved = hip + thigh * (ankle - hip);
+    let shin = Quat::from_rotation_arc(
+        (ankle_moved - knee_new).normalize(),
+        (hip + dir * c - knee_new).normalize(),
+    );
+    Some((thigh, shin))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// Where the solved leg puts its knee and ankle.
+    fn after(hip: Vec3, knee: Vec3, ankle: Vec3, (thigh, shin): (Quat, Quat)) -> (Vec3, Vec3) {
+        let knee2 = hip + thigh * (knee - hip);
+        let ankle2 = knee2 + shin * (thigh * (ankle - knee));
+        (knee2, ankle2)
+    }
+
+    /// A leg standing slightly bent, its ankle lifted 0.2: the ankle lands there, the thigh and
+    /// shin keep their lengths, the knee comes further forward the way it bent, the hip stays.
+    #[test]
+    fn a_raised_foot_bends_the_knee_and_lands_on_its_mark() {
+        let (hip, knee, ankle) = (
+            Vec3::new(0.0, 1.0, 0.0),
+            Vec3::new(0.0, 0.52, -0.05),
+            Vec3::new(0.0, 0.05, 0.0),
+        );
+        let target = ankle + Vec3::Y * 0.2;
+        let solved = solve_leg(hip, knee, ankle, target, Vec3::NEG_Z).unwrap();
+        let (k2, a2) = after(hip, knee, ankle, solved);
+        assert!(a2.distance(target) < 1.0e-3, "the ankle on its mark: {a2}");
+        assert!(
+            (k2.distance(hip) - knee.distance(hip)).abs() < 1.0e-4,
+            "the thigh's length"
+        );
+        assert!(
+            (a2.distance(k2) - ankle.distance(knee)).abs() < 1.0e-4,
+            "the shin's length"
+        );
+        assert!(
+            k2.z < knee.z,
+            "the knee further forward (-z), as it bent: {k2}"
+        );
+    }
+
+    /// A straight leg bends toward `forward`, never backward or sideways.
+    #[test]
+    fn a_straight_leg_bends_forward() {
+        let (hip, knee, ankle) = (Vec3::Y, Vec3::Y * 0.5, Vec3::ZERO);
+        let target = Vec3::Y * 0.3;
+        let solved = solve_leg(hip, knee, ankle, target, Vec3::NEG_Z).unwrap();
+        let (k2, a2) = after(hip, knee, ankle, solved);
+        assert!(a2.distance(target) < 1.0e-3);
+        assert!(
+            k2.z < -0.1 && k2.x.abs() < 1.0e-4,
+            "forward, in the leg's plane: {k2}"
+        );
+    }
+
+    /// A mark past the leg's reach takes the leg as far as it goes along the line, no further and
+    /// no longer; a leg of no length is left alone.
+    #[test]
+    fn a_mark_out_of_reach_straightens_the_leg_toward_it() {
+        let (hip, knee, ankle) = (Vec3::Y, Vec3::new(0.0, 0.5, -0.1), Vec3::ZERO);
+        let target = Vec3::new(0.0, -1.0, 0.0);
+        let solved = solve_leg(hip, knee, ankle, target, Vec3::NEG_Z).unwrap();
+        let (k2, a2) = after(hip, knee, ankle, solved);
+        let len = knee.distance(hip) + ankle.distance(knee);
+        assert!(
+            (a2.distance(hip) - len).abs() < 2.0e-3,
+            "as long as it gets"
+        );
+        assert!(
+            a2.x.abs() < 1.0e-3 && a2.z.abs() < 2.0e-2,
+            "along the line to the mark: {a2}"
+        );
+        assert!((k2.distance(hip) - knee.distance(hip)).abs() < 1.0e-4);
+        assert!(solve_leg(hip, hip, ankle, target, Vec3::NEG_Z).is_none());
+    }
+}
