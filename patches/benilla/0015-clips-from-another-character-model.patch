diff --git a/crates/benilla-app/src/creature_anim/action/donor.rs b/crates/benilla-app/src/creature_anim/action/donor.rs
new file mode 100644
index 00000000..49023130
--- /dev/null
+++ b/crates/benilla-app/src/creature_anim/action/donor.rs
@@ -0,0 +1,181 @@
+//! Basin Battle: a clip from another character model, played on this one.
+//!
+//! `PlayUnitAnimation`'s `from` names a character model (`"ScourgeFemale"`, `"OrcMale"`…). Its
+//! take on the clip is retargeted onto the unit's own skeleton once per model, and played from
+//! the rig's [`ExtraClips`] like any of its own. A vanilla M2's rest pose is unrotated (each bone
+//! is a pivot), so a bone's turns carry over as they are once the bones are paired: by their
+//! `KeyBoneID` first (the arms, shoulders, spine, head, fingers…), then outward and inward from
+//! those along the hierarchy, child to child by the direction each points at rest. The hips'
+//! travel is scaled to the unit's height; every other bone keeps its own rest length, so the clip
+//! takes the unit's proportions. The pairing and the retargeting are
+//! `benilla_world::rig_anim::bones`.
+
+use std::collections::HashMap;
+use std::sync::{Arc, RwLock};
+
+use bevy::animation::graph::AnimationNodeIndex;
+use bevy::prelude::*;
+
+use benilla_assets::{AnimClip, M2Model, ModelAnimations, PoseNode};
+use benilla_world::rig_anim::{ExtraClips, PoseExtra, RigPose};
+
+/// Borrowed clips' graph nodes start here, clear of any model's own.
+const EXTRA_NODE_BASE: usize = 60_000;
+/// The races whose models can lend a clip, as their folders name them.
+const RACES: [&str; 9] = [
+    "Human", "Orc", "Dwarf", "NightElf", "Scourge", "Tauren", "Gnome", "Troll", "Goblin",
+];
+
+/// The models lending clips, and what's been built from them.
+#[derive(Resource, Default)]
+pub(crate) struct Donors {
+    handles: HashMap<String, Handle<M2Model>>,
+    /// Per unit model (its pose source's address), donor, clip and take: the take to play.
+    built: HashMap<(usize, String, u16, usize), AnimClip>,
+    /// Per unit model, its borrowed clips, shared by its instances.
+    extras: HashMap<usize, Arc<RwLock<ExtraClips>>>,
+}
+
+/// A character model's path from its name: `"ScourgeFemale"` is
+/// `Character\Scourge\Female\ScourgeFemale.m2`; a path is taken as it is.
+pub(crate) fn model_path(name: &str) -> Option<String> {
+    if name.contains('\\') || name.contains('/') || name.to_ascii_lowercase().ends_with(".m2") {
+        return Some(name.to_string());
+    }
+    let lower = name.to_ascii_lowercase();
+    let (race, gender) = if let Some(r) = lower.strip_suffix("female") {
+        (r, "Female")
+    } else if let Some(r) = lower.strip_suffix("male") {
+        (r, "Male")
+    } else {
+        return None;
+    };
+    let race = RACES.iter().find(|r| r.eq_ignore_ascii_case(race))?;
+    Some(format!("Character\\{race}\\{gender}\\{race}{gender}.m2"))
+}
+
+impl Donors {
+    /// Start loading a donor (`PreloadAnimationSource`, or a first use).
+    pub(crate) fn load(&mut self, assets: &AssetServer, name: &str) -> Option<Handle<M2Model>> {
+        if let Some(h) = self.handles.get(name) {
+            return Some(h.clone());
+        }
+        let path = model_path(name)?;
+        let h: Handle<M2Model> = assets.load(benilla_assets::m2_url(&path));
+        self.handles.insert(name.to_string(), h.clone());
+        Some(h)
+    }
+
+    /// The donor's take on `anim`, ready to play on the unit `entity` (its model `anims`, its rig
+    /// `rig`), or `None` while the donor loads or when it has no such clip (the unit's own plays).
+    #[allow(clippy::too_many_arguments)]
+    pub(crate) fn take(
+        &mut self,
+        assets: &AssetServer,
+        models: &Assets<M2Model>,
+        commands: &mut Commands,
+        name: &str,
+        anim: u16,
+        variation: Option<usize>,
+        entity: Entity,
+        anims: &ModelAnimations,
+        rig: &RigPose,
+        has: Option<&PoseExtra>,
+    ) -> Option<AnimClip> {
+        let handle = self.load(assets, name)?;
+        let model = Arc::as_ptr(&anims.pose) as usize;
+        let n = variation.unwrap_or(0);
+        let extra = self.extras.entry(model).or_default().clone();
+        // The unit carries this model's borrowed clips.
+        if has.is_none_or(|e| e.model != model || !Arc::ptr_eq(&e.clips, &extra)) {
+            commands.entity(entity).try_insert(PoseExtra {
+                model,
+                clips: extra.clone(),
+            });
+        }
+        let key = (model, name.to_string(), anim, n);
+        if let Some(c) = self.built.get(&key) {
+            return Some(c.clone());
+        }
+        let donor = models.get(&handle)?;
+        let danims = donor.animations.as_ref()?;
+        let mut takes = danims.clips.iter().filter(|c| c.anim_id == anim);
+        let first = takes.clone().next()?;
+        let dtake = takes.nth(n).unwrap_or(first);
+        let dclip = danims
+            .pose
+            .node(dtake.node)
+            .and_then(|p| danims.pose.clips.get(p.clip as usize))?;
+        let dparents: Vec<i16> = donor.skeleton.joints.iter().map(|j| j.parent).collect();
+        let dbinds: Vec<Vec3> = donor
+            .skeleton
+            .joints
+            .iter()
+            .map(|j| j.local_translation)
+            .collect();
+        let target = benilla_world::rig_anim::Bones {
+            parents: &rig.parents,
+            binds: rig.binds(),
+            keys: &anims.pose.key_bones,
+        };
+        let from = benilla_world::rig_anim::Bones {
+            parents: &dparents,
+            binds: &dbinds,
+            keys: &danims.pose.key_bones,
+        };
+        let map = benilla_world::rig_anim::map_bones(&target, &from);
+        let scale = target.height() / from.height().max(0.1);
+        let clip = benilla_world::rig_anim::retarget(dclip, &map, &rig.parents, scale);
+        // Into the model's borrowed clips: a whole-body node, and an upper-body one where the
+        // model has the mask for it.
+        let upper_mask = anims
+            .clips
+            .iter()
+            .find_map(|c| c.upper_node)
+            .and_then(|u| anims.pose.node(u))
+            .map(|p| p.mask);
+        let (full, upper) = {
+            let mut x = extra.write().ok()?;
+            let at = x.clips.len() as u32;
+            x.clips.push(clip);
+            let full = EXTRA_NODE_BASE + 2 * at as usize;
+            x.nodes.insert(full, PoseNode { clip: at, mask: 0 });
+            let upper = upper_mask.map(|mask| {
+                x.nodes.insert(full + 1, PoseNode { clip: at, mask });
+                full + 1
+            });
+            (full, upper)
+        };
+        let mut take = dtake.clone();
+        take.node = AnimationNodeIndex::new(full);
+        take.blend_node = None;
+        take.upper_node = upper.map(AnimationNodeIndex::new);
+        take.arm_nodes = None;
+        take.seq_index = usize::MAX;
+        info!("action: {name}'s clip {anim} (take {n}) borrowed for a unit's model");
+        self.built.insert(key, take.clone());
+        Some(take)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_character_models_name_is_its_path() {
+        assert_eq!(
+            model_path("ScourgeFemale").as_deref(),
+            Some("Character\\Scourge\\Female\\ScourgeFemale.m2")
+        );
+        assert_eq!(
+            model_path("nightelfmale").as_deref(),
+            Some("Character\\NightElf\\Male\\NightElfMale.m2")
+        );
+        assert_eq!(
+            model_path("Creature\\Bear\\Bear.m2").as_deref(),
+            Some("Creature\\Bear\\Bear.m2")
+        );
+        assert_eq!(model_path("Murloc"), None);
+    }
+}
