+use benilla_assets::{PoseBone, PoseClip, PoseTrack};
+
+/// Two children pair only if they point this much the same way at rest (cosine).
+const SAME_WAY: f32 = 0.6;
+/// A link shorter than this (yards) points nowhere in particular: such children pair in order.
+const NO_WAY: f32 = 0.01;
 
 /// The bone that strikes over `[t0, t1]` of `clip`: the one whose pivot moves farthest against
 /// its skeleton's root, with a link from its parent at least `shortest` yards long (a toe, a claw's tip are too
@@ -101,10 +107,184 @@ fn pivots(clip: &PoseClip, parents: &[i16], binds: &[Vec3], t: f32) -> Vec<Vec3>
     pos
 }
 
+/// A skeleton as the pairing reads it: each bone's parent, rest link from it and `KeyBoneID`.
+pub struct Bones<'a> {
+    pub parents: &'a [i16],
+    pub binds: &'a [Vec3],
+    pub keys: &'a [i16],
+}
+
+impl Bones<'_> {
+    fn len(&self) -> usize {
+        self.parents.len().min(self.binds.len())
+    }
+
+    fn parent(&self, i: usize) -> Option<usize> {
+        usize::try_from(*self.parents.get(i)?)
+            .ok()
+            .filter(|&p| p < self.len() && p != i)
+    }
+
+    fn children(&self) -> Vec<Vec<usize>> {
+        let mut c = vec![Vec::new(); self.len()];
+        for i in 0..self.len() {
+            if let Some(p) = self.parent(i) {
+                c[p].push(i);
+            }
+        }
+        c
+    }
+}
+
+impl Bones<'_> {
+    /// How tall a skeleton stands at rest: its highest pivot (Bevy Y is up).
+    pub fn height(&self) -> f32 {
+        height(self)
+    }
+}
+
+fn height(b: &Bones) -> f32 {
+    let n = b.len();
+    let mut pos: Vec<Option<Vec3>> = vec![None; n];
+    fn at(i: usize, b: &Bones, pos: &mut Vec<Option<Vec3>>, depth: u32) -> Vec3 {
+        if let Some(p) = pos[i] {
+            return p;
+        }
+        let up = match b.parent(i) {
+            Some(p) if depth < 256 => at(p, b, pos, depth + 1),
+            _ => Vec3::ZERO,
+        };
+        let p = up + b.binds[i];
+        pos[i] = Some(p);
+        p
+    }
+    (0..n).map(|i| at(i, b, &mut pos, 0).y).fold(0.0, f32::max)
+}
+
+/// For each of the unit's bones, the donor's bone that drives it.
+pub fn map_bones(unit: &Bones, donor: &Bones) -> Vec<Option<u16>> {
+    let (n, m) = (unit.len(), donor.len());
+    let mut map: Vec<Option<usize>> = vec![None; n];
+    let mut used = vec![false; m];
+    let pair = |map: &mut Vec<Option<usize>>, used: &mut Vec<bool>, u: usize, d: usize| {
+        if map[u].is_none() && !used[d] {
+            map[u] = Some(d);
+            used[d] = true;
+        }
+    };
+    // The key bones.
+    for u in 0..n {
+        let k = unit.keys.get(u).copied().unwrap_or(-1);
+        if k < 0 {
+            continue;
+        }
+        if let Some(d) = (0..m).find(|&d| donor.keys.get(d).copied() == Some(k)) {
+            pair(&mut map, &mut used, u, d);
+        }
+    }
+    // The roots, in order.
+    let uroots: Vec<usize> = (0..n).filter(|&u| unit.parent(u).is_none()).collect();
+    let droots: Vec<usize> = (0..m).filter(|&d| donor.parent(d).is_none()).collect();
+    for (&u, &d) in uroots.iter().zip(&droots) {
+        pair(&mut map, &mut used, u, d);
+    }
+    let (uc, dc) = (unit.children(), donor.children());
+    // Outward and inward from every pair until nothing more pairs.
+    loop {
+        let mut more = false;
+        for u in 0..n {
+            let Some(d) = map[u] else { continue };
+            // Inward: the parents.
+            if let (Some(up), Some(dp)) = (unit.parent(u), donor.parent(d)) {
+                if map[up].is_none() && !used[dp] {
+                    pair(&mut map, &mut used, up, dp);
+                    more = true;
+                }
+            }
+            // Outward: the children, by the way they point at rest.
+            let free_u: Vec<usize> = uc[u]
+                .iter()
+                .copied()
+                .filter(|&c| map[c].is_none())
+                .collect();
+            let mut free_d: Vec<usize> = dc[d].iter().copied().filter(|&c| !used[c]).collect();
+            for cu in free_u {
+                let bu = unit.binds[cu];
+                let best = free_d
+                    .iter()
+                    .enumerate()
+                    .map(|(k, &cd)| (k, cd, likeness(bu, donor.binds[cd])))
+                    .filter(|(_, _, s)| *s >= SAME_WAY)
+                    .max_by(|a, b| a.2.total_cmp(&b.2));
+                if let Some((k, cd, _)) = best {
+                    pair(&mut map, &mut used, cu, cd);
+                    free_d.remove(k);
+                    more = true;
+                }
+            }
+        }
+        if !more {
+            break;
+        }
+    }
+    map.into_iter().map(|d| d.map(|d| d as u16)).collect()
+}
+
+/// How much two rest links point the same way (1: exactly), short ones counting as alike.
+fn likeness(a: Vec3, b: Vec3) -> f32 {
+    if a.length() < NO_WAY && b.length() < NO_WAY {
+        return 1.0;
+    }
+    if a.length() < NO_WAY || b.length() < NO_WAY {
+        return 0.0;
+    }
+    a.normalize().dot(b.normalize())
+}
+
+/// The donor's clip on the unit's bones: each paired bone's turns as they are, and the travel of
+/// the bones at the top of the unit's tree (the root and the hips) scaled by `scale`.
+pub fn retarget(clip: &PoseClip, map: &[Option<u16>], parents: &[i16], scale: f32) -> PoseClip {
+    let depth = |mut i: usize| {
+        let mut d = 0;
+        while let Some(p) = parents.get(i).and_then(|&p| usize::try_from(p).ok()) {
+            if p == i || d > 256 {
+                break;
+            }
+            i = p;
+            d += 1;
+        }
+        d
+    };
+    let mut out = PoseClip::default();
+    for (u, d) in map.iter().enumerate() {
+        let Some(d) = d else { continue };
+        let Ok(at) = clip.bones.binary_search_by_key(d, |b| b.bone) else {
+            continue;
+        };
+        let src = &clip.bones[at];
+        let translation = if depth(u) <= 1 {
+            let keys: Vec<(f32, Vec3)> = src
+                .translation
+                .keys()
+                .map(|(t, v)| (t, *v * scale))
+                .collect();
+            PoseTrack::new(&keys)
+        } else {
+            PoseTrack::default()
+        };
+        out.push(PoseBone {
+            bone: u as u16,
+            translation,
+            rotation: src.rotation.clone(),
+            scale: PoseTrack::default(),
+        });
+    }
+    out
+}
