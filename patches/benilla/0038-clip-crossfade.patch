@@ -1016,16 +1037,49 @@ pub(super) fn apply_action_clips(
             }
         };
         let on = clip.on_node();
-        for off in clip.nodes().filter(|n| *n != on) {
-            if player.animation(off).is_some() {
-                player.stop(off);
+        // The node the body switch leaves fades out under the one it goes to.
+        let offs: Vec<AnimationNodeIndex> = clip.nodes().filter(|n| *n != on).collect();
+        for off in offs {
+            if let Some(w) = player.animation(off).map(|a| a.weight()) {
+                clip.fade_out(off, now, w);
+            }
+        }
+        // The outgoing nodes: each ramps from the weight it had to nothing, then stops. One the
+        // clip has come back to (the body switched twice in a moment) is its own again.
+        clip.fading.retain(|(n, ..)| *n != on);
+        let mut fading = Vec::with_capacity(clip.fading.len());
+        for (node, t0, w0) in std::mem::take(&mut clip.fading) {
+            let (t0, w0) = if t0 < 0.0 {
+                match player.animation(node) {
+                    Some(a) => (now, a.weight()),
+                    None => continue,
+                }
+            } else {
+                (t0, w0)
+            };
+            match fade_weight(w0, now - t0) {
+                Some(w) => {
+                    if let Some(a) = player.animation_mut(node) {
+                        a.set_weight(w);
+                    }
+                    fading.push((node, t0, w0));
+                }
+                None => {
+                    player.stop(node);
+                }
             }
         }
+        clip.fading = fading;
         // Its weight against everything else playing (the gait, the driver's one-shots), the
-        // hands' grip overlays apart, so the share it takes is `lambda`.
+        // hands' grip overlays and its own outgoing nodes apart, so the share it takes is
+        // `lambda`.
         let others: f32 = player
             .playing_animations()
-            .filter(|(n, _)| **n != on && !anims.hand_close.contains(&Some(**n)))
+            .filter(|(n, _)| {
+                **n != on
+                    && !anims.hand_close.contains(&Some(**n))
+                    && !clip.fading.iter().any(|(f, ..)| f == *n)
+            })
             .map(|(_, a)| a.weight())
             .sum();
         let others = if others > 1.0e-3 { others } else { 1.0 };
