+    #[test]
+    fn a_replaced_clips_nodes_fade_out_over_the_crossfade_instead_of_cutting() {
+        // The old clip, at full blend, on its whole-body node.
+        let mut c = clip(0.0, 0.0, 0.0);
+        c.lambda = 1.0;
+        c.upper = Some(AnimationNodeIndex::new(2));
+        // The new clip plays node 7 (and the same upper node 2, which it keeps as its own).
+        let mut next = clip(0.0, 0.0, 0.0);
+        next.full = AnimationNodeIndex::new(7);
+        next.upper = Some(AnimationNodeIndex::new(2));
+        replace_clip(&mut c, next);
+        assert_eq!(c.lambda, 1.0, "the blend carries over, so nothing flashes under it");
+        assert_eq!(c.full, AnimationNodeIndex::new(7));
+        let fading: Vec<_> = c.fading.iter().map(|f| f.0).collect();
+        assert_eq!(fading, [AnimationNodeIndex::new(1)], "only the node it doesn't play");
+        assert!(c.fading[0].1 < 0.0, "its weight is read as the fade begins");
+        // Asked again before the fade is seen: still one entry, not two.
+        let mut again = clip(0.0, 0.0, 0.0);
+        again.full = AnimationNodeIndex::new(9);
+        replace_clip(&mut c, again);
+        let mut fading: Vec<_> = c.fading.iter().map(|f| f.0.index()).collect();
+        fading.sort();
+        assert_eq!(fading, [1, 2, 7]);
+        // The ramp: the weight it had, down to nothing over CROSS_FADE, then stopped.
+        assert!((fade_weight(4.0, 0.0).unwrap() - 4.0).abs() < 1.0e-5);
+        assert!((fade_weight(4.0, CROSS_FADE * 0.5).unwrap() - 2.0).abs() < 1.0e-5);
+        assert_eq!(fade_weight(4.0, CROSS_FADE), None);
+        assert_eq!(fade_weight(4.0, 1.0), None);
+        // A node the clip plays is never its own outgoing one.
+        let mut d = clip(0.0, 0.0, 0.0);
+        d.fade_out(d.full, 0.0, 1.0);
+        assert!(d.fading.is_empty());
+    }
+
