 /// An action clip fades in and out over these.
 const FADE_IN: f32 = 0.08;
 const FADE_OUT: f32 = 0.16;
+/// A clip giving way to the next (a replacement, or the body switch between the whole body and
+/// the upper body) fades its outgoing node out over this, so the pose never cuts between them (a
+/// jump's last pose snapped into a landing's first: the legs popped).
+const CROSS_FADE: f32 = 0.12;
 /// Faster than this (yd/s) the legs are the gait's and the clip takes the upper body; slower than
 /// the second, the whole body again.
 const MOVING_ABOVE: f32 = 1.2;
