     coil: bool,
-    /// Nodes of the clips it replaced, to stop before it plays (gathered across replacements in
-    /// one frame, so none is left playing frozen).
-    release: Vec<AnimationNodeIndex>,
+    /// Nodes on their way out: a replaced clip's, and the node the body switch left, each as
+    /// `(node, when the fade began, its weight then)`, ramped to nothing over [`CROSS_FADE`] and
+    /// stopped. A fade not yet begun (gathered before the player was seen) has a negative time.
+    fading: Vec<(AnimationNodeIndex, f32, f32)>,
 }
 
 impl ActionClip {
@@ -358,10 +363,18 @@ impl ActionClip {
             shuffle: false,
             reaction: false,
             coil: false,
-            release: Vec::new(),
+            fading: Vec::new(),
         }
     }
 
+    /// A node on its way out, unless it's one this clip plays or is already fading.
+    fn fade_out(&mut self, node: AnimationNodeIndex, now: f32, weight: f32) {
+        if self.nodes().any(|n| n == node) || self.fading.iter().any(|(n, ..)| *n == node) {
+            return;
+        }
+        self.fading.push((node, now, weight));
+    }
+
     /// The coil's two marks on the clip clock and the snap's real seconds.
     fn coil_marks(&self) -> (f32, f32, f32) {
         let b = self.key * (COIL_AT + COIL_CREEP);
@@ -523,21 +536,32 @@ fn start_clip(
 }
 
 /// A clip in place of the one playing: it keeps the blend (unless that one was letting go), and
-/// the old one's nodes, with any still waiting to stop, are stopped before it plays.
+/// the old one's nodes, with any still fading from before, fade out under it ([`CROSS_FADE`])
+/// rather than cutting to it.
 fn replace_clip(old: &mut ActionClip, clip: ActionClip) {
     let lambda = if old.stopping.is_some() {
         0.0
     } else {
         old.lambda
     };
-    let mut release = std::mem::take(&mut old.release);
-    release.extend(old.nodes().filter(|n| !clip.nodes().any(|k| k == *n)));
-    release.retain(|n| !clip.nodes().any(|k| k == *n));
-    *old = ActionClip {
+    let mut fading = std::mem::take(&mut old.fading);
+    fading.retain(|(n, ..)| !clip.nodes().any(|k| k == *n));
+    let mut next = ActionClip {
         lambda,
-        release,
+        fading,
         ..clip
     };
+    for n in old.nodes() {
+        // Its weight is read from the player as the fade begins.
+        next.fade_out(n, -1.0, 0.0);
+    }
+    *old = next;
+}
+
+/// A fading node's weight `secs` after its fade began from `w0`; `None` once it's done.
+fn fade_weight(w0: f32, secs: f32) -> Option<f32> {
+    let u = secs / CROSS_FADE;
+    (u < 1.0).then(|| (w0 * (1.0 - u.max(0.0))).max(1.0e-4))
 }
 
