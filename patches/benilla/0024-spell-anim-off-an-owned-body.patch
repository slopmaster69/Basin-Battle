     ),
     // The variation roll's LCG, the reference's single CRT `_rand` stream shared by every play.
     mut rng: ResMut<benilla_assets::AnimRng>,
     // The last anim trace line per traced unit; the trace writes only on change.
     mut anim_trace_last: Local<std::collections::HashMap<Entity, String>>,
 ) {
-    let (emote_sounds, loot_kneel, time, names, mut recomputes, riders, interact, class_table) =
-        aux;
+    let (
+        emote_sounds,
+        loot_kneel,
+        time,
+        names,
+        mut recomputes,
+        riders,
+        interact,
+        class_table,
+        clip_owns,
+    ) = aux;
     let classes = class_table.as_deref().map(|t| &t.0);
     let dt = time.delta_secs();
     // This frame's one-shot plays per unit, replayed in the reference's call order (`PlaySeq`
@@ -377,6 +388,19 @@ pub(super) fn drive_animations(
         pending_slow.insert(s.0);
     }
     for e in emotes.read() {
+        // A spell look's own body animation (never a player's emote) on a unit whose body an
+        // add-on's clip owns: dropped, so the clip is the swing and the look its effects.
+        if !e.via_player
+            && clip_owns
+                .as_deref()
+                .is_some_and(|o| o.muted(e.entity, time.elapsed_secs()))
+        {
+            debug!(
+                "anim: kit anim {} on {:?} dropped under the add-on's clip",
+                e.anim_id, e.entity
+            );
+            continue;
+        }
         pending
             .entry(e.entity)
             .or_default()
