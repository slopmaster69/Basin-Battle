@@ -323,14 +323,25 @@ pub(super) fn drive_animations(
         Option<Res<crate::ui_session::InteractNpc>>,
         // `ChrClasses.dbc`, for the setter's class test on the ranged state.
         Option<Res<crate::chr_classes::ChrClassTable>>,
