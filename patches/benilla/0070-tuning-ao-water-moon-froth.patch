+    fn moon_lane(r: Vec3, l: Vec3, width: f32) -> f32 {
+        let flat = Vec2::new(l.x, l.z);
+        if flat.length() < 1e-3 {
+            return 0.0;
+        }
+        let toward = flat.normalize();
+        let side = Vec2::new(-toward.y, toward.x);
+        let rf = Vec2::new(r.x, r.z);
+        let ahead = rf.dot(toward);
+        if ahead <= 0.0 {
+            return 0.0;
+        }
+        let across = rf.dot(side) / width;
+        let el = r.y.atan2(ahead) - l.y.clamp(-1.0, 1.0).asin();
+        let along = el
+            / if el < 0.0 {
+                tune::MOON_LANE_FAR
+            } else {
+                tune::MOON_LANE_NEAR
+            };
+        (-(across * across) - along * along).exp()
+    }
