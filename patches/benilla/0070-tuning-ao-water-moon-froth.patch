+// The moon's lane (`look::water::tune::MOON_LANE`; its tests mirror this): how near the mirrored
+// ray `R` comes to the moon `L` (both unit), across its bearing (half-width `width`, radians) and
+// along its elevation (far toward the horizon, near toward the camera), as a soft weight 0 to 1.
+fn water_moon_lane(R: vec3<f32>, L: vec3<f32>, width: f32) -> f32 {
+    let flat = vec2<f32>(L.x, L.z);
+    let fl = length(flat);
+    if (fl < 1e-3) {
+        return 0.0;
+    }
+    let toward = flat / fl;
+    let side = vec2<f32>(-toward.y, toward.x);
+    let rf = vec2<f32>(R.x, R.z);
+    let ahead = dot(rf, toward);
+    if (ahead <= 0.0) {
+        return 0.0;
+    }
+    let across = dot(rf, side) / width;
+    let el = atan2(R.y, ahead) - asin(clamp(L.y, -1.0, 1.0));
+    let along = el / select(WATER_MOON_NEAR, WATER_MOON_FAR, el < 0.0);
+    // Dimmer at the mirror point itself, brightest a little beyond it toward the horizon, so the
+    // lane lies out across the water rather than pooling in front of the camera.
+    let out = WATER_MOON_CORE + (1.0 - WATER_MOON_CORE) * smoothstep(0.0, 0.4 * WATER_MOON_FAR, -el);
+    return exp(-(across * across) - along * along) * out;
+}
+
+// The moon lane's glints at `p` (the surface's XZ) at `t`: a sparkle whose tops alone shine, so
+// the lane is small glints, never one ribbon; where a sparkle cell is under a pixel (`fp`, yards a
+// pixel) it is its mean, so far water does not crawl.
+fn water_moon_glints(p: vec2<f32>, t: f32, fp: f32) -> f32 {
+    let k = WATER_MOON_GLINT_FREQ;
+    let a = water_noise(p * k + vec2<f32>(0.31, -0.23) * t).x;
+    let b = water_noise(p * (2.3 * k) + vec2<f32>(17.0, 3.0) - vec2<f32>(0.19, 0.27) * t).x;
+    let sparkle = smoothstep(WATER_MOON_GLINT_CUT, 1.0, 0.6 * a + 0.4 * b) * WATER_MOON_GLINT_GAIN;
+    let fine = 1.0 - smoothstep(0.25 / k, 1.0 / k, fp);
+    return mix(WATER_MOON_GLINT_MEAN, sparkle, fine);
+}
