-    let band = smoothstep(0.0, 0.04, depth_v) * (1.0 - smoothstep(0.15 * fd, fd, depth_v));
+    // Something standing in the water (a wading hero's legs, a post) is a step in the bed behind
+    // the surface, where the shore is a slope: a ring of points round P on the surface each read
+    // the bed under them. `stand` is the share whose bed is a step shallower than P's (P is
+    // beside the legs: froth), `on_step` whether P is itself on a step's shallow side (in front of
+    // the legs, where the shore's band would draw a crisp ring hugging their outline).
+    var stand = 0.0;
+    var on_step = 0.0;
+    if (eye_z < WATER_FROTH_REACH && water.rows[0].w > 0.0) {
+        for (var k = 0u; k < WATER_FROTH_TAPS; k = k + 1u) {
+            let ang = f32(k) * 2.3999632 + jitter * 6.2831853;
+            let r = WATER_FROTH_YD * sqrt((f32(k) + 0.5) / f32(WATER_FROTH_TAPS));
+            let Q = P + vec3<f32>(cos(ang) * r, 0.0, sin(ang) * r);
+            let cq = view.clip_from_world * vec4<f32>(Q, 1.0);
+            if (cq.w <= 0.05) {
+                continue;
+            }
+            let zq = water_scene_z(water_uv(cq));
+            if (zq <= 0.0) {
+                continue;
+            }
+            let dq = max(cam.y - Q.y, 0.0) * max(zq - cq.w, 0.0) / cq.w;
+            stand += (1.0 - smoothstep(0.1 * fd, fd, dq))
+                * smoothstep(0.5 * fd, 1.5 * fd, depth_v - dq);
+            on_step = max(on_step, smoothstep(0.5 * fd, 1.5 * fd, dq - depth_v));
+        }
+        stand = stand / f32(WATER_FROTH_TAPS);
+    }
+    let band = smoothstep(0.0, 0.06, depth_v) * (1.0 - smoothstep(0.1 * fd, fd, depth_v))
+        * (1.0 - on_step);
     let na = water_noise(P.xz * 0.9 + vec2<f32>(0.05, -0.03) * t).x;
     let nb = water_noise(P.xz * 2.7 + vec2<f32>(31.0, 7.0) - vec2<f32>(0.11, 0.07) * t).x;
     let lap = 0.5 + 0.5 * sin(depth_v / fd * 9.0 - t * 1.4 + na * 4.0);
-    let foam = water.rows[0].w * band
-        * smoothstep(0.42, 0.78, 0.45 * na + 0.25 * nb + 0.35 * lap)
+    // The shore's band, patchy with the noise and the ripples; the froth lumpier and finer.
+    let shore_mask = smoothstep(0.38, 0.86, 0.4 * na + 0.25 * nb + 0.3 * lap + 0.15 * rip);
+    let froth_mask = smoothstep(0.25, 0.75, 0.55 * nb + 0.3 * na + 0.25 * rip);
+    let foam = min(water.rows[0].w * band * shore_mask + WATER_FROTH * stand * froth_mask, 1.0)
         * (1.0 - smoothstep(60.0, 120.0, eye_z));
     let foam_rgb = water_decode(lit_g) * 0.8;
 
