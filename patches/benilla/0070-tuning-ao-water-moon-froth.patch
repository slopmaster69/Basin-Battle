+    /// The second night film's lake at 23:30, facing the moon (41° up), the camera 4 yd over calm
+    /// water and pitched 24° down, every pixel's mirrored ray tilted by the night's ripples: the
+    /// moon's glint is a narrow lane toward it, at most pale (under white before the mirror), a
+    /// small share of the water bright, none of it far off the moon's line, and dark water either
+    /// side. With 0070's lobe (strength 2.0, sharpness 64, the sun's sheen) the same frame was
+    /// bright over a wide pool round the mirror point and flecked on the ripples out to the edges.
+    #[test]
+    fn the_moon_lays_a_lane_not_a_pool() {
+        let night = WowLighting {
+            celestial_dir: Vec3::new(0.0, -0.5, 1.0).normalize(),
+            moon_dir_white: {
+                let e = 41f32.to_radians();
+                Vec3::new(e.cos(), e.sin(), 0.0)
+            },
+            ..noon()
+        };
+        let (l, strength, color, sharp) = glint(&night);
+        assert!(sharp < 0.0, "the moon packs a lane");
+        let slope = tune::RIPPLE_CALM;
+        let (w, h) = (160, 90);
+        let pitch = (-24f32).to_radians();
+        let ty = (std::f32::consts::FRAC_PI_4 * 0.5).tan();
+        let tx = ty * 16.0 / 9.0;
+        let (mut water, mut bright, mut far_off, mut peak) = (0, 0, 0, 0.0f32);
+        let (mut old_bright, mut old_far_off) = (0, 0);
+        for j in 0..h {
+            for i in 0..w {
+                let sx = ((i as f32 + 0.5) / w as f32 * 2.0 - 1.0) * tx;
+                let sy = (1.0 - (j as f32 + 0.5) / h as f32 * 2.0) * ty;
+                // Facing +x (the moon's bearing), pitched down.
+                let fwd = Vec3::new(pitch.cos(), pitch.sin(), 0.0);
+                let up = Vec3::new(-pitch.sin(), pitch.cos(), 0.0);
+                let d = (fwd + up * sy + Vec3::Z * sx).normalize();
+                if d.y >= -0.01 {
+                    continue;
+                }
+                water += 1;
+                // The ripples: a deterministic tilt of about the night's slope.
+                let k = (i * 7919 + j * 104_729) as f32;
+                let n =
+                    Vec3::new(slope * (k * 0.37).sin(), 1.0, slope * (k * 0.61).cos()).normalize();
+                let v = -d;
+                let mut r = d - 2.0 * d.dot(n) * n;
+                r.y = r.y.max(0.01);
+                let r = r.normalize();
+                let rf = Vec3::new(d.x, -d.y, d.z);
+                let spec = moon_lane(r, l, -sharp)
+                    + tune::MOON_SHEEN * moon_lane(rf, l, tune::MOON_SHEEN_LANE);
+                let g = strength * spec * color[2];
+                peak = peak.max(g);
+                let bearing = (d.z / Vec2::new(d.x, d.z).length()).asin().abs();
+                if g > 0.25 {
+                    bright += 1;
+                    if bearing > 0.3 {
+                        far_off += 1;
+                    }
+                }
+                // 0070 as filmed: a Blinn lobe of 64 at 2.0, with the sun's sheen.
+                let hv = (l + v).normalize();
+                let nh = n.dot(hv).clamp(0.0, 1.0);
+                let old = 2.0 * (nh.powf(64.0) + tune::SHEEN * nh.powf(64.0 * 0.04));
+                if old > 0.25 {
+                    old_bright += 1;
+                    if bearing > 0.3 {
+                        old_far_off += 1;
+                    }
+                }
+            }
+        }
+        let share = bright as f32 / water as f32;
+        let old_share = old_bright as f32 / water as f32;
+        assert!(peak < 0.95, "the lane stays pale: peak {peak}");
+        assert!(
+            share > 0.002 && share < 0.06,
+            "a narrow lane: {share} of the water"
+        );
+        assert_eq!(far_off, 0, "nothing bright far off the moon's line");
+        assert!(
+            old_share > 4.0 * share && old_far_off > 0,
+            "0070's lobe: {old_share} bright, {old_far_off} far off"
+        );
+    }
