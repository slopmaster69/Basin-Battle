+    /// `liquid.wgsl`'s mirrored constants are [`tune`]'s.
+    #[test]
+    fn the_shader_mirrors_the_tuned_numbers() {
+        let src = include_str!("../../../benilla-assets/src/shaders/liquid.wgsl");
+        let read = |name: &str, ty: &str| -> String {
+            let line = src
+                .lines()
+                .find(|l| l.starts_with(&format!("const {name}: {ty} = ")))
+                .unwrap_or_else(|| panic!("{name} missing"));
+            line.split('=')
+                .nth(1)
+                .unwrap()
+                .trim()
+                .trim_end_matches(';')
+                .to_string()
+        };
+        let f = |name: &str| read(name, "f32").parse::<f32>().unwrap();
+        assert_eq!(f("WATER_SSR_EDGE"), tune::SSR_EDGE);
+        assert_eq!(f("WATER_SSR_BREAK"), tune::SSR_BREAK);
+        assert_eq!(f("WATER_FROTH"), tune::FROTH);
+        assert_eq!(f("WATER_FROTH_YD"), tune::FROTH_YD);
+        assert_eq!(f("WATER_FROTH_REACH"), tune::FROTH_REACH);
+        assert_eq!(f("WATER_MOON_FAR"), tune::MOON_LANE_FAR);
+        assert_eq!(f("WATER_MOON_NEAR"), tune::MOON_LANE_NEAR);
+        assert_eq!(f("WATER_MOON_SHEEN_LANE"), tune::MOON_SHEEN_LANE);
+        let taps = read("WATER_FROTH_TAPS", "u32");
+        assert_eq!(
+            taps.trim_end_matches('u').parse::<u32>().unwrap(),
+            tune::FROTH_TAPS
+        );
+    }
