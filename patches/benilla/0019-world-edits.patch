index 00000000..a1e80288
--- /dev/null
+++ b/crates/benilla-formats/src/world_edits.rs
@@ -0,0 +1,114 @@
+//! Basin Battle's edits to the world as the ADTs author it, benilla's own (no reference
+//! behaviour): placements hidden and terrain holes filled, applied once where a tile is parsed
+//! ([`crate::adt_to_tile_mesh_on`]), so the terrain mesh, its collider, its ground clutter, every
+//! height query and the WMO and doodad streams all see the same edited world.
+//!
+//! The table mirrors htl-map's `WESTBROOK_EDITS` (`crates/htl-map/src/elwynn.rs` in the Hold the
+//! Line repository), which the Elwynn Survival server builds its land from: the two must change
+//! together, or the client draws (and collides with) a world the server does not walk.
+
+use crate::terrain::CHUNK_SIZE;
+
+/// One map's edits.
+#[derive(Debug, Clone, Copy)]
+pub struct MapEdits {
+    /// The map's directory under `World\Maps` (map 0 is `Azeroth`).
+    pub map: &'static str,
+    /// MODF `uniqueId`s of WMO placements that are not there: not drawn, no collision, no portal
+    /// or interior lighting from them.
+    pub hidden_wmos: &'static [u32],
+    /// MDDF `uniqueId`s of doodad placements that are not there: not drawn, no collision.
+    pub hidden_doodads: &'static [u32],
+    /// Circles (WoW `[x north, y west]`, radius in yards): every MCNK chunk whose area overlaps
+    /// one has its terrain holes cleared, so its own MCVT heights are drawn and walked there.
+    pub filled_ground: &'static [([f32; 2], f32)],
+}
+
+/// Westbrook Garrison (Elwynn), taken down for the Elwynn Survival camp: the barracks, the
+/// barrels, crates, jars and bucket round it, and the holes its floor stood in.
+pub const WESTBROOK_EDITS: MapEdits = MapEdits {
+    map: "Azeroth",
+    // world\wmo\azeroth\buildings\human_barracks\human_barracks.wmo at (-9656.0, 684.4, 40.6).
+    hidden_wmos: &[71670],
+    hidden_doodads: &[
+        71666, 71667, 71668, 71669, 17030, 17031, 17032, 17033, 17034, 17035, 17036, 17037,
+    ],
+    filled_ground: &[([-9620.0, 690.0], 45.0)],
+};
+
+/// Every map's edits.
+pub const WORLD_EDITS: &[MapEdits] = &[WESTBROOK_EDITS];
+
+/// The edits for the map with this directory name (case-insensitive), if any.
+pub fn edits_for(map: &str) -> Option<&'static MapEdits> {
+    WORLD_EDITS.iter().find(|e| e.map.eq_ignore_ascii_case(map))
+}
+
+/// The map directory an ADT path names (`World\Maps\Azeroth\Azeroth_32_48.adt`, either slash):
+/// its file stem without the `_<x>_<y>` tile suffix.
+pub fn map_of_adt_path(path: &str) -> Option<&str> {
+    let file = path.rsplit(['\\', '/']).next()?;
+    let stem = file
+        .strip_suffix(".adt")
+        .or_else(|| file.strip_suffix(".ADT"))?;
+    let mut parts = stem.rsplitn(3, '_');
+    let (y, x, map) = (parts.next()?, parts.next()?, parts.next()?);
+    (x.parse::<u32>().is_ok() && y.parse::<u32>().is_ok() && !map.is_empty()).then_some(map)
+}
+
+impl MapEdits {
+    pub fn hides_wmo(&self, unique_id: u32) -> bool {
+        self.hidden_wmos.contains(&unique_id)
+    }
+
+    pub fn hides_doodad(&self, unique_id: u32) -> bool {
+        self.hidden_doodads.contains(&unique_id)
+    }
+
+    /// Whether the chunk whose north-west corner is `corner` (its header position: it spans
+    /// `CHUNK_SIZE` south in x and east in y) has its holes filled.
+    pub fn fills_chunk(&self, corner: [f32; 2]) -> bool {
+        self.filled_ground.iter().any(|&([cx, cy], r)| {
+            let nx = cx.clamp(corner[0] - CHUNK_SIZE, corner[0]);
+            let ny = cy.clamp(corner[1] - CHUNK_SIZE, corner[1]);
+            (cx - nx).hypot(cy - ny) <= r
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_garrison_chunks_seen_with_holes_are_filled_and_far_ones_not() {
+        let e = edits_for("azeroth").expect("map 0's edits");
+        for corner in [
+            [-9566.7, 700.0],
+            [-9600.0, 700.0],
+            [-9600.0, 666.7],
+            [-9633.3, 700.0],
+            [-9633.3, 666.7],
+        ] {
+            assert!(e.fills_chunk(corner), "{corner:?}");
+        }
+        assert!(!e.fills_chunk([-9500.0, 700.0]));
+        assert!(!e.fills_chunk([-9620.0, 800.0]));
+        assert!(e.hides_wmo(71670) && !e.hides_wmo(71671));
+        assert!(e.hides_doodad(17037) && !e.hides_doodad(17038));
+        assert!(edits_for("Kalimdor").is_none());
+    }
+
+    #[test]
+    fn an_adt_path_names_its_map() {
+        assert_eq!(
+            map_of_adt_path("World\\Maps\\Azeroth\\Azeroth_32_48.adt"),
+            Some("Azeroth")
+        );
+        assert_eq!(
+            map_of_adt_path("world/maps/DeadminesInstance/DeadminesInstance_31_32.adt"),
+            Some("DeadminesInstance")
+        );
+        assert_eq!(map_of_adt_path("World\\Maps\\Azeroth\\Azeroth.wdt"), None);
+    }
+}
