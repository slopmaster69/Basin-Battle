+    /// One flat chunk with its north-west corner at `nw` and these hole bits.
+    fn holed_tile(nw: [f32; 2], holes: u16) -> Vec<u8> {
+        let mut t = flat_tile([0, 0, 127]);
+        // Past the MCNK magic and size: the header.
+        t[8 + 0x3C..8 + 0x3E].copy_from_slice(&holes.to_le_bytes());
+        t[8 + 0x68..8 + 0x6C].copy_from_slice(&nw[0].to_le_bytes());
+        t[8 + 0x6C..8 + 0x70].copy_from_slice(&nw[1].to_le_bytes());
+        t
+    }
+
+    /// Map 0's world edits fill the garrison's holes where the tile is parsed, so the mesh, the
+    /// collider and every height query built on the chunk see ground there; elsewhere, and on
+    /// another map, the holes stay.
+    #[test]
+    fn a_world_edit_fills_a_chunks_holes_on_its_own_map_only() {
+        let full = 8 * 8 * 12;
+        let garrison = holed_tile([-9600.0, 700.0], 0xfeee);
+        let authored = adt_to_tile_mesh(&garrison).unwrap();
+        assert!(authored.chunks[0].indices.len() < full);
+        let edited = adt_to_tile_mesh_on("Azeroth", &garrison).unwrap();
+        assert_eq!(edited.chunks[0].holes, 0);
+        assert_eq!(edited.chunks[0].indices.len(), full);
+        let elsewhere = adt_to_tile_mesh_on("Kalimdor", &garrison).unwrap();
+        assert_eq!(elsewhere.chunks[0].holes, 0xfeee);
+        let far = adt_to_tile_mesh_on("Azeroth", &holed_tile([-9000.0, 700.0], 0xfeee)).unwrap();
+        assert_eq!(far.chunks[0].holes, 0xfeee);
+    }
