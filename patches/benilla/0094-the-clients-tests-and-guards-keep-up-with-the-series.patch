+/// Which VM is up, [`benilla_ui::script::UiScript::session`], or 0 with none: how a system that
+/// holds nothing of the VM learns a new one has been seated (a `ReloadUI`, an add-on turned off)
+/// and lets go of what the old one's add-on held. Only the feed layer names the VM
+/// (`tests/ui_script_wall.rs`), so such a system reads this instead.
+#[derive(Resource, Default, Clone, Copy, PartialEq, Eq, Debug)]
+pub(crate) struct VmGeneration(pub(crate) u64);
+
+/// [`VmGeneration`] as the feed phase finds it, before the tick and so before anything that reads
+/// it this frame.
+pub(crate) fn publish_vm_generation(
+    script: Option<NonSend<benilla_ui::script::UiScript>>,
+    mut generation: ResMut<VmGeneration>,
+) {
+    let now = script.map_or(0, |s| s.session());
+    if generation.0 != now {
+        generation.0 = now;
+    }
+}
